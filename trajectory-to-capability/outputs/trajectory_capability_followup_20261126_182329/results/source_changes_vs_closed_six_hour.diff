+def evaluate_budget_stop(task, attempt, verifier_seconds):
+    """Grade the saved deadline patch without restarting the student."""
+    run=ROOT/'runs'/(attempt['run_name']+'_r1')
+    infer=run/'infer_logs'/task
+    meta=json.loads((infer/'rounds_meta.json').read_text())
+    if meta.get('aborted')!='student_timeout':
+        raise RuntimeError('Only a confirmed student deadline can use this recovery')
+    record_path=run/'budget_stop_evaluation.json'
+    if record_path.exists():raise FileExistsError('Inspect the existing deadline evaluation; never repeat it implicitly')
+    source=infer/'turn_1/patch.diff'
+    patch_dir=run/'deadline_patch_input'/task
+    patch_dir.mkdir(parents=True)
+    shutil.copy2(source,patch_dir/'patch.diff')
+    assert source.read_bytes()==(patch_dir/'patch.diff').read_bytes()
+    record={'status':'running','started_at':time.time(),'pid':os.getpid(),
+        'original_exit_code':attempt['exit_code'],'original_finished_at':attempt['finished_at'],
+        'student_stop_reason':'student_timeout','new_student_attempts':0,'model_calls':0,
+        'original_patch':str(source),'same_patch_direct_content':True,'verifier_seconds':verifier_seconds}
+    record_path.write_text(json.dumps(record,indent=2)+'\n')
+    from benchmark.deepswe.eval_deep_swe import evaluate_task
+    os.environ['HINT_VERIFIER_TIMEOUT_SEC']=str(verifier_seconds)
+    result=evaluate_task(DATA/'tasks'/task,task,patch_dir.parent,run/'eval_output')
+    reward=result.get('reward')
+    if isinstance(reward,dict):reward=reward.get('reward')
+    status='evaluation_timeout' if result.get('verifier_timed_out') else 'complete' if reward in (0,1) else 'technical_incomplete'
+    record.update(status=status,finished_at=time.time(),result=result)
+    record_path.write_text(json.dumps(record,indent=2)+'\n')
+    attempt.update(status=status,finished_at=record['finished_at'],budget_stop_evaluation=str(record_path))
+    return (0 if reward==1 else 1) if status in ('complete','evaluation_timeout') else 2
+
