+bpy.ops.object.text_add(location=(-1.46,1.061,1.42), rotation=(math.radians(78),0,0))
+clock=bpy.context.object; clock.name='range clock'; clock.data.body='12:01'; clock.data.align_x='CENTER'; clock.data.align_y='CENTER'; clock.data.size=.115; clock.data.extrude=.0005; clock.data.materials.append(black)
+# range oven face on visible right side
+cube('oven door',(-.765,.43,.51),(.035,1.10,.68),dark,.01)
+rod('oven handle',(-.71,-.02,.82),(-.71,.86,.82),.025,purple)
