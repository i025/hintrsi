+# individual pale plank floor with seams
+planks=[mat('oak tone '+str(i),(0.66+i*.018,0.60+i*.017,0.53+i*.016)) for i in range(4)]
+for m in planks:
+ nt=m.node_tree; n=nt.nodes; l=nt.links; p=n.get('Principled BSDF'); tc=n.new('ShaderNodeTexCoord'); mp=n.new('ShaderNodeMapping'); mp.inputs['Scale'].default_value=(4,1,2); l.new(tc.outputs['Generated'],mp.inputs[0]); no=n.new('ShaderNodeTexNoise'); no.inputs['Scale'].default_value=12; no.inputs['Detail'].default_value=4; no.inputs['Roughness'].default_value=.7; l.new(mp.outputs[0],no.inputs[0]); ramp=n.new('ShaderNodeValToRGB'); ramp.color_ramp.elements[0].color=(.42,.35,.30,1); ramp.color_ramp.elements[1].color=(.79,.72,.64,1); l.new(no.outputs['Fac'],ramp.inputs[0]); l.new(ramp.outputs[0],p.inputs['Base Color'])
+for i in range(14):
+ x=-2.1+i*.32
+ cube('floor plank',(x,1.4,.002),(.315,6.8,.012),planks[i%4])
+ for j in range(4):
+  y=-1.9+j*1.65+(i%2)*.82
+  cube('plank joint',(x,y,.010),(.315,.006,.002),wood)
+cube('back wall',(0,4.05,1.65),(4.5,.12,3.3),wall); cube('left wall',(-2.23,1.1,1.65),(.12,6,3.3),wall); cube('right wall',(2.23,1.1,1.65),(.12,6,3.3),wall)
+cube('back skirting',(0,3.96,.09),(4.4,.035,.16),white)
