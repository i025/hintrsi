+door=cube('open door',(.56,3.62,1.27),(.055,.80,2.54),white); door.rotation_euler[2]=math.radians(-4)
+rod('door handle',(.48,3.52,1.25),(.42,3.52,1.25),.018,steel)
+# Bright upper portion of the opening falls into darkness at floor level.
+opening=bpy.data.materials.new('doorway light to dark'); opening.use_nodes=True
+n=opening.node_tree.nodes; l=opening.node_tree.links; p=n.get('Principled BSDF'); t=n.new('ShaderNodeTexCoord'); sep=n.new('ShaderNodeSeparateXYZ'); r=n.new('ShaderNodeValToRGB'); r.color_ramp.elements[0].position=.05; r.color_ramp.elements[0].color=(.005,.005,.005,1); r.color_ramp.elements[1].position=.8; r.color_ramp.elements[1].color=(.8,.8,.76,1); l.new(t.outputs['Generated'],sep.inputs[0]); l.new(sep.outputs['Z'],r.inputs[0]); l.new(r.outputs[0],p.inputs['Base Color']); bpy.data.objects['doorway'].data.materials.clear(); bpy.data.objects['doorway'].data.materials.append(opening)
+# right cabinet run, countertop
+cube('right base cabinet',(1.73,.95,.48),(.95,4.1,.96),white)
+cube('right marble counter',(1.70,.95,1.01),(1.07,4.2,.12),marble,.012)
+# Flowing, low-contrast stone: elongated, distorted noise creates broad
+# cloudy streaks rather than discrete drawn lines.
+nt=marble.node_tree; nodes=nt.nodes; links=nt.links
+bs=nodes.get('Principled BSDF')
+tex=nodes.new('ShaderNodeTexCoord'); mapping=nodes.new('ShaderNodeMapping')
+mapping.inputs['Scale'].default_value=(2.0,.65,2.0)
+links.new(tex.outputs['Generated'],mapping.inputs['Vector'])
+noise=nodes.new('ShaderNodeTexNoise'); noise.inputs['Scale'].default_value=5.0; noise.inputs['Detail'].default_value=4.0; noise.inputs['Roughness'].default_value=.65; noise.inputs['Distortion'].default_value=2.7
+links.new(mapping.outputs['Vector'],noise.inputs['Vector'])
+ramp=nodes.new('ShaderNodeValToRGB'); ramp.color_ramp.elements[0].position=.25; ramp.color_ramp.elements[0].color=(.57,.59,.58,1); ramp.color_ramp.elements[1].position=.75; ramp.color_ramp.elements[1].color=(.91,.92,.91,1)
+# Broad, irregular bands run along the length of the slab.
+wave=nodes.new('ShaderNodeTexWave'); wave.wave_type='BANDS'; wave.bands_direction='X'; wave.inputs['Scale'].default_value=2.6; wave.inputs['Distortion'].default_value=7.0; wave.inputs['Detail'].default_value=4.0; wave.inputs['Detail Scale'].default_value=1.3; wave.inputs['Detail Roughness'].default_value=.7
+links.new(mapping.outputs['Vector'],wave.inputs['Vector'])
+ramp.color_ramp.elements[0].position=.12; ramp.color_ramp.elements[0].color=(.59,.61,.60,1); ramp.color_ramp.elements[1].position=.88; ramp.color_ramp.elements[1].color=(.94,.94,.93,1)
+# Use irregular, stretched noise for soft stone variation rather than repeated stripes.
+mapping.inputs['Scale'].default_value=(2.0,.35,2.0)
+noise.inputs['Scale'].default_value=2.2
+noise.inputs['Distortion'].default_value=3.5
+ramp.color_ramp.elements[0].position=.25; ramp.color_ramp.elements[0].color=(.64,.66,.65,1)
+ramp.color_ramp.elements[1].position=.75; ramp.color_ramp.elements[1].color=(.94,.94,.93,1)
+links.new(noise.outputs['Fac'],ramp.inputs[0]); links.new(ramp.outputs['Color'],bs.inputs['Base Color'])
+# faces on inward x side
+for j,y in enumerate([-.58,.22,1.02,1.82,2.62]):
+ for k,z in enumerate([.17,.47,.77]):
+  m= [black,wood,white,black,sage][(j*2+k)%5]
+  cube('cabinet drawer front',(1.242,y,z),(.025,.75,.27),m,.006)
+  cyl('drawer knob',(1.218,y,z),.022,.045,steel,(0,math.pi/2,0),20)
+# wall cabinets on right
+for y in [.25,1.3,2.35]:
+ cube('upper cabinet',(1.97,y,2.50),(.49,.99,.90),white,.01)
+ cube('upper green inset',(1.714,y,2.50),(.018,.83,.72),sage)
+ cyl('upper cabinet pull',(1.69,y,2.48),.02,.035,steel,(0,math.pi/2,0),16)
+# stove left foreground. inner side faces toward camera
+cube('range body',(-1.40,.45,.49),(1.25,1.32,.98),dark,.015)
+cube('range top rim',(-1.40,.45,1.01),(1.30,1.34,.10),steel,.01)
+cube('range cook surface',(-1.40,.45,1.07),(1.20,1.23,.035),cook)
+for x in [-1.73,-1.08]:
+ for y in [.06,.48,.88]: cyl('round electric burner',(x,y,1.092),.16,.006,burner,verts=64)
+# raised control panel at back
+panel=cube('raised range control panel',(-1.40,1.16,1.38),(1.30,.16,.55),steel,.012); panel.rotation_euler[0]=math.radians(-12)
+for x in [-1.83,-.98]:
