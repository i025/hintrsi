ordinates and depth.","status":"validated","module_functions_and_lines":"/evidence/A1/public_library/reconstruct.py:8-15","actual_validation_evidence":"/evidence/A1/validation/executions/blender_1795840495398782769/stdout.log:2","origin_evidence":"/evidence/A1/learning/research_evidence.json:10-11","uncertainty":"Synthetic camera only."},\n        {"canonical_label":"landmark_residual","definition":"Score projected landmarks against caller-supplied image targets.","status":"validated","module_functions_and_lines":"/evidence/A1/public_library/reconstruct.py:18-33","actual_validation_evidence":"/evidence/A1/validation/executions/blender_1795840495398782769/stdout.log:2","origin_evidence":"/evidence/A1/learning/research_evidence.json:10-11","uncertainty":"Not image similarity or occlusion."},\n        {"canonical_label":"directional_noise_material","definition":"Construct an editable anisotropically mapped procedural noise and color-ramp material.","status":"validated","module_functions_and_lines":"/evidence/A1/public_library/reconstruct.py:88-114","actual_validation_evidence":"/evidence/A1/validation/executions/blender_1795840495398782769/stdout.log:2","origin_evidence":"/evidence/A1/learning/research_evidence.json:12","uncertainty":"Node links validated, not visual quality."},\n        {"canonical_label":"aabb_support_screen","definition":"Screen horizontal overlap and vertical separation using world-axis bounding boxes.","status":"validated","module_functions_and_lines":"/evidence/A1/public_library/reconstruct.py:36-70","actual_validation_evidence":"/evidence/A1/validation/executions/blender_1795840495398782769/stdout.log:2","origin_evidence":"/evidence/A1/learning/research_evidence.json:13","uncertainty":"Not surface contact."},\n        {"canonical_label":"scene_graph_relations","definition":"Inspect explicit parent or constraint relations among supplied objects.","status":"validated","module_functions_and_lines":"/evidence/A1/public_library/reconstruct.py:73-85",