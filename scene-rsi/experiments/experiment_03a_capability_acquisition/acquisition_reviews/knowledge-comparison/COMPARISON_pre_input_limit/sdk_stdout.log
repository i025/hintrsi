on":"Inspect explicit parent or constraint links in a supplied object set.","actual_evidence":"/evidence/A1/public_library/reconstruct.py:73-85; /evidence/A4/public_library/reconstruction.py:104-118; parent outputs cited per condition."}\n119\t  ],\n120\t  "substantive_overlap": {\n121\t    "method": "Jaccard intersection/union of the evidence-supported canonical labels listed for each condition, not code text similarity. Explicit world_aabb counted for A3 only as separately exposed standalone method; A1 and A5 use it inside differently classified screens. Missing labels mean not included in this partial comparison, not proof of absence. Values are provisional because evidence inspection is incomplete.",\n122\t    "pairwise": [\n123\t      {"pair":"A1-A2","intersection":["camera_projection","landmark_residual","directional_noise_material"],"jaccard":"3/9","differences":"A1 uses AABB support and scene graph; A2 uses ray sampling, hinge transform, aim and broad-phase separation. Sources cited in condition method entries."},\n124\t      {"pair":"A1-A3","intersection":["camera_projection","directional_noise_material"],"jaccard":"2/8","differences":"A3 adds hinge edge candidates, ray sampling and standalone bounds; A1 has landmark residual, AABB support and scene graph."},\n125\t      {"pair":"A1-A4","intersection":["camera_projection","landmark_residual","directional_noise_material","aabb_support_screen","scene_graph_relations"],"jaccard":"5/7","differences":"A4 also has camera aim and hinge transform; its scene graph is parent-only."},\n126\t      {"pair":"A1-A5","intersection":["camera_projection","landmark_residual","directional_noise_material"],"jaccard":"3/8","differences":"A5 uses sampled support, hinge transform and AABB separation rather than A1\'s AABB support and scene graph."},\n127\t      {"pair":"A2-A3","intersection":["camera_projection","directional_noise_material","sampled_vertical_support"],"jaccard":"3/9","differences":"A2 mutates hinge and aims camera