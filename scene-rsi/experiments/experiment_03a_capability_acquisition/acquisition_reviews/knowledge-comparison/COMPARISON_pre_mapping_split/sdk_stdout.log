nits (/evidence/A2/validation/executions/blender_1795840498042980875/code/validation_probe.py:9-22); output records support categories, centered projection, hinge distances and node chain (/evidence/A2/validation/executions/blender_1795840498042980875/stdout.log:1-14). No full swing or appearance comparison was tested.",\n32\t      "unsupported_claims": "Successful one-pose alignment does not establish opening coherence, collision-free swing, or image improvement (/evidence/A2/public_library/SKILL.md:3-9).",\n33\t      "method_origins": "Research report attributes motivation to strategy trajectories but identifies the callable diagnostics as new technical design; exact hint wording remains unknown (/evidence/A2/learning/research_evidence.json:2-16). Historical claims were not independently audited exhaustively.",\n34\t      "applicability_limits": "Hinge parenting mutates scene; lowest-vertex ray samples and AABB overlap are not contact or connectivity (/evidence/A2/public_library/reconstruct.py:36-50,60-121).",\n35\t      "evidence": ["/evidence/A2/validation/validation_report.json:2-13", "/evidence/A2/learning/sdk_events.json:1-82"],\n36\t      "canonical_semantic_methods": [\n37\t        {"canonical_label":"camera_projection","definition":"Project caller-supplied world points into normalized camera coordinates and depth.","status":"validated","module_functions_and_lines":"/evidence/A2/public_library/reconstruct.py:8-10","actual_validation_evidence":"/evidence/A2/validation/executions/blender_1795840498042980875/stdout.log:6","origin_evidence":"/evidence/A2/learning/research_evidence.json:13","uncertainty":"Synthetic projection only."},\n38\t        {"canonical_label":"landmark_residual","definition":"Score projected landmarks against caller-supplied image targets.","status":"validated","module_functions_and_lines":"/evidence/A2/public_library/reconstruct.py:13-21","actual_validation_evidence":"/evidence/A2/validation/executions/blender_1795840498042980875/stdout.