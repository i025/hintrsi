f v.z <= zmin + tolerance]\n80\t    stride = max(1, math.ceil(len(lowest)/samples))\n81\t    rows = []\n82\t    for p in lowest[::stride][:samples]:\n83\t        origin = p + Vector((0,0,reach))\n84\t        best = None\n85\t        for support in support_objects:\n86\t            if support == obj or support.type != \'MESH\':\n87\t                continue\n88\t            se = support.evaluated_get(dg)\n89\t            inv = se.matrix_world.inverted_safe()\n90\t            direction = inv.to_3x3() @ Vector((0,0,-1))\n91\t            if direction.length < 1e-12:\n92\t                continue\n93\t            ok, loc, normal, face = se.ray_cast(inv @ origin, direction.normalized(), distance=reach*10000)\n94\t            if ok:\n95\t                hit = se.matrix_world @ loc\n96\t                gap = p.z - hit.z\n97\t                if -reach <= gap <= reach and (best is None or hit.z > best[1]):\n98\t                    best = (support.name, hit.z, gap)\n99\t        if best is None:\n100\t            rows.append({\'point\':tuple(p), \'status\':\'unknown support\'})\n101\t        else:\n102\t            gap=best[2]\n103\t            status = \'positive gap\' if gap > tolerance else (\'possible penetration\' if gap < -tolerance else \'near-zero\')\n104\t            rows.append({\'point\':tuple(p), \'support\':best[0], \'gap\':gap, \'status\':status})\n105\t    states = {r[\'status\'] for r in rows}\n106\t    return {\'status\': next(iter(states)) if len(states)==1 else \'mixed\', \'samples\':rows}\n107\t\n108\t\n109\tdef aabb_relation(a, b):\n110\t    """World evaluated AABB separation; overlap is only a broad-phase candidate."""\n111\t    dg = bpy.context.evaluated_depsgraph_get()\n112\t    def bounds(o):\n113\t        e=o.evaluated_get(dg); m=e.to_mesh()\n114\t        try: pts=[e.matrix_world @ v.co for v in m.vertices]\n115\t        finally: e.to_mesh_clear()\n116\t        if not pts: raise ValueError(\'empty mesh\')\n117\t        return [(min(p[i] for p in pts),m