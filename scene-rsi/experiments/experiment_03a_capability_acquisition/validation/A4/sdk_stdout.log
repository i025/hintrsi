\n46\tdef hinge_pose(door, hinge_world, angle_radians, local_hinge):\n47\t    """Rotate a door about a world vertical hinge; local_hinge is a point in door local space.\n48\t\n49\t    Keeps current scale and tilt; angle is an incremental world-Z rotation. Does not cut a wall.\n50\t    """\n51\t    from mathutils import Matrix\n52\t    H = Vector(hinge_world)\n53\t    before = door.matrix_world @ Vector(local_hinge)\n54\t    if (before-H).length > 1e-4:\n55\t        raise ValueError(\'local hinge is not at specified world hinge\')\n56\t    door.matrix_world = Matrix.Translation(H) @ Matrix.Rotation(angle_radians, 4, \'Z\') @ Matrix.Translation(-H) @ door.matrix_world\n57\t    bpy.context.view_layer.update()\n58\t\n59\t\n60\tdef make_directional_material(name, color_a, color_b, axis_scale=(1, 8, 8), noise_scale=4.0, roughness=0.7):\n61\t    """Create editable object-coordinate stretched-noise material; color inputs are linear RGBA.\n62\t\n63\t    Object coordinates are in object-local units. Apply scales or tune mapping per object.\n64\t    """\n65\t    if noise_scale <= 0 or any(v <= 0 for v in axis_scale):\n66\t        raise ValueError(\'scales must be positive\')\n67\t    mat = bpy.data.materials.new(name); mat.use_nodes = True\n68\t    nt = mat.node_tree; nt.nodes.clear()\n69\t    out = nt.nodes.new(\'ShaderNodeOutputMaterial\')\n70\t    bs = nt.nodes.new(\'ShaderNodeBsdfPrincipled\'); bs.inputs[\'Roughness\'].default_value = roughness\n71\t    tc = nt.nodes.new(\'ShaderNodeTexCoord\')\n72\t    mapping = nt.nodes.new(\'ShaderNodeMapping\'); mapping.inputs[\'Scale\'].default_value = axis_scale\n73\t    noise = nt.nodes.new(\'ShaderNodeTexNoise\'); noise.inputs[\'Scale\'].default_value = noise_scale\n74\t    ramp = nt.nodes.new(\'ShaderNodeValToRGB\')\n75\t    ramp.color_ramp.elements[0].color = color_a; ramp.color_ramp.elements[1].color = color_b\n76\t    for a, ao, b, bi in [(tc,\'Object\',mapping,\'Vector\'),(mapping,\'Vector\',noise,\'Vector\'),(noise,\'Fac\',ramp,\'Fac\'),(ramp,\'Color\',bs,\'Base Color\'),(bs,\'BSDF\',out,\'Surface\')]:\n77\t        nt.links.new(a.outputs[ao], b.inputs[bi])\n78\t    return mat\n79\t\n80\t\n81\tdef support_bounds(upper, lower, tolerance=0.01):\n82\t    """Conservative world-AABB screening only, not a physical contact test.\n83\t\n84\t    Returns vertical separation and status. Requires actual mesh objects; evaluated bounds\n85\t    include modifiers. Horizontal bounds must overlap; tilted and hollow shapes are uncertain.\n86\t    """\n87\t    if tolerance < 0: raise ValueError(\'negative tolerance\')\n88\t    if upper.type != \'MESH\' or lower.type != \'MESH\': return {\'status\':\'unknown support\',\'gap\':None}\n89\t    deps = bpy.context.evaluated_depsgraph_get()\n90\t    def bounds(o):\n91\t        o = o.evaluated_get(deps)\n92\t        if len(o.data.vertices) == 0: return None\n93\t        p = [o.matrix_world @ Vector(c) for c in o.bound_box]\n94\t        return [(min(v[i] for v in p), max(v[i] for v in p)) for i in range(3)]\n95\t    a,b = bounds(upper),bounds(lower)\n96\t    if a is None or b is None: return {\'status\':\'unknown support\',\'gap\':None}\n97\t    if any(min(a[i][1],b[i][1]) <= max(a[i][0],b[i][0]) for i in (0,1)):\n98\t        return {\'status\':\'unknown support\',\'gap\':None}\n99\t    gap = a[2][0]-b[2][1]\n100\t    status = \'positive gap\' if gap > tolerance else \'possible penetration\' if gap < -tolerance else \'near-zero\'\n101\t    return {\'status\':status,\'gap\':gap,\'warning\':\'AABB only; does not establish contact or support\'}\n102\t\n103\t\n104\tdef assembly_components(objects):\n105\t    """Connected components of parent relationships within supplied objects; not physical support."""\n106\t    objects = list(objects); members = set(objects); adj = {o:set() for o in objects}\n107\t    for o in objects:\n108\t        if o.parent in members:\n109\t            adj[o].add(o.parent); adj[o.parent].add(o)\n110\t    components=[]; unseen=set(objects)\n111\