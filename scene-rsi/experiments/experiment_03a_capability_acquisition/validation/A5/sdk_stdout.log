cal downward ray sample from evaluated vertices to evaluated support.\n42\t\n43\t    Returns sample distribution and states, not proof of contact. Assumes support surface\n44\t    is below points; misses and penetration yield unknown. No automatic scene changes.\n45\t    """\n46\t    if tolerance <= 0 or max_distance <= 0 or sample_limit < 1:\n47\t        raise ValueError(\'positive tolerances and sample_limit required\')\n48\t    dg = bpy.context.evaluated_depsgraph_get()\n49\t    a = obj.evaluated_get(dg); b = support.evaluated_get(dg)\n50\t    mesh = a.to_mesh()\n51\t    try:\n52\t        verts = [a.matrix_world @ v.co for v in mesh.vertices]\n53\t    finally:\n54\t        a.to_mesh_clear()\n55\t    if not verts:\n56\t        return {\'state\': \'unknown support\', \'samples\': 0}\n57\t    low = min(v.z for v in verts)\n58\t    bottom = [v for v in verts if v.z <= low + tolerance]\n59\t    step = max(1, math.ceil(len(bottom)/sample_limit))\n60\t    inv = b.matrix_world.inverted()\n61\t    direction = inv.to_3x3() @ Vector((0, 0, -1))\n62\t    gaps = []; misses = 0\n63\t    for v in bottom[::step]:\n64\t        # Start above vertex to detect shallow penetration without requiring a signed SDF.\n65\t        origin = v + Vector((0, 0, tolerance * 2))\n66\t        hit, loc, normal, face = b.ray_cast(inv @ origin, direction.normalized(), distance=max_distance * direction.length)\n67\t        if hit:\n68\t            world = b.matrix_world @ loc\n69\t            gap = v.z - world.z\n70\t            if gap <= max_distance: gaps.append(gap)\n71\t            else: misses += 1\n72\t        else: misses += 1\n73\t    if not gaps: state = \'unknown support\'\n74\t    elif min(gaps) < -tolerance: state = \'possible penetration\'\n75\t    elif misses: state = \'unknown support\'\n76\t    elif min(gaps) > tolerance: state = \'positive gap\'\n77\t    else: state = \'near-zero\'\n78\t    return {\'state\': state, \'minimum_gap\': min(gaps) if gaps else None,\n79\t            \'maximum_gap\': max(gaps) if gaps else None, \'samples\': len(gaps),\n80\t            \'misses\': misses, \'tolerance\': tolerance}\n81\t\n82\tdef world_bounds(obj):\n83\t    """Evaluated world AABB; broad-phase only, not connectivity/contact."""\n84\t    o = obj.evaluated_get(bpy.context.evaluated_depsgraph_get())\n85\t    m = o.to_mesh()\n86\t    try:\n87\t        v = [o.matrix_world @ x.co for x in m.vertices]\n88\t    finally:\n89\t        o.to_mesh_clear()\n90\t    if not v: return None\n91\t    return [[min(x[i] for x in v), max(x[i] for x in v)] for i in range(3)]\n92\t\n93\tdef bounds_separation(a, b):\n94\t    """AABB Euclidean separation; zero means only that boxes overlap."""\n95\t    a, b = world_bounds(a), world_bounds(b)\n96\t    if a is None or b is None: return None\n97\t    return math.sqrt(sum(max(a[i][0]-b[i][1], b[i][0]-a[i][1], 0)**2 for i in range(3)))\n98\t\n99\tdef directional_material(name, scale=(1.0, 5.0, 1.0), colors=((0.65,0.65,0.65,1),(0.85,0.85,0.85,1)), roughness=0.55, coordinate=\'Generated\'):\n100\t    """Create editable mapped procedural color. scale controls inverse feature size."""\n101\t    if coordinate not in (\'Generated\', \'Object\', \'UV\'):\n102\t        raise ValueError(\'coordinate must be Generated, Object or UV\')\n103\t    m = bpy.data.materials.new(name); m.use_nodes = True\n104\t    n = m.node_tree.nodes; links = m.node_tree.links\n105\t    bs = n.get(\'Principled BSDF\'); bs.inputs[\'Roughness\'].default_value = roughness\n106\t    tex = n.new(\'ShaderNodeTexCoord\'); mapping = n.new(\'ShaderNodeMapping\')\n107\t    mapping.inputs[\'Scale\'].default_value = scale\n108\t    noise = n.new(\'ShaderNodeTexNoise\'); noise.inputs[\'Scale\'].default_value = 3\n109\t    ramp = n.new(\'ShaderNodeValToRGB\')\n110\t    ramp.color_ramp.elements[0].color = colors[0]; ramp.color_ramp.elements[1].color = colors[1]\n111\t    links.new(tex.outputs[coordinate], mapping.inputs[\'Vector\'])\n112\t    links.new(mapping.outputs[\'Vector\'