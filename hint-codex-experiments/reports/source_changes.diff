+        lines = ["# Codex Hint 实验进度", "", f"状态：{self.state['status']}",
+                 f"模型：{MODEL}；思考强度：low。", "",
+                 scope_note, "",
+                 "| 组别 | 首轮通过 | 已尝试题数 | 累计通过 | 未完成尝试 |",
+                 "|---|---:|---:|---:|---:|"]
