+    def poll(self):
+        return self.code
+
+    def send_signal(self, signum):
+        self.signals.append(signum)
+        self.code = -signum
+        state = json.loads(self.path.read_text())
+        state["status"] = "stopped"
+        self.path.write_text(json.dumps(state))
+
+    def kill(self):
+        self.code = -9
+
+    def wait(self):
+        return self.code
