[
  "codex",
  "exec",
  "--ephemeral",
  "--json",
  "--skip-git-repo-check",
  "--ignore-user-config",
  "--ignore-rules",
  "--sandbox",
  "read-only",
  "--model",
  "gpt-6.1-terra",
  "-c",
  "model_reasoning_effort=\"low\"",
  "-c",
  "features.shell_tool=false",
  "-c",
  "features.view_image=false",
  "-c",
  "features.multi_agent=false",
  "-c",
  "features.plugins=false",
  "-c",
  "features.apps=false",
  "-c",
  "features.skill_search=false",
  "-c",
  "features.skill_mcp_dependency_install=false",
  "-c",
  "features.remote_plugin=false",
  "-c",
  "web_search=\"disabled\"",
  "-c",
  "project_doc_max_bytes=0",
  "-c",
  "mcp_servers={}",
  "-c",
  "skills.bundled.enabled=false",
  "-c",
  "model_provider=\"hint_context_probe\"",
  "-c",
  "model_providers.hint_context_probe.name=\"Offline context probe\"",
  "-c",
  "model_providers.hint_context_probe.base_url=\"http://127.0.0.1:35553/after_usage_error/v1\"",
  "-c",
  "model_providers.hint_context_probe.wire_api=\"responses\"",
  "-c",
  "model_providers.hint_context_probe.env_key=\"HINT_CONTEXT_PROBE_KEY\"",
  "-c",
  "model_providers.hint_context_probe.requires_openai_auth=false",
  "-c",
  "model_providers.hint_context_probe.request_max_retries=0",
  "-c",
  "model_providers.hint_context_probe.stream_max_retries=0",
  "-c",
  "model_providers.hint_context_probe.capabilities.remote_compaction=\"v2\"",
  "-c",
  "features.code_mode=true",
  "-c",
  "features.code_mode_only=true",
  "-c",
  "model_auto_compact_token_limit=1000"
]