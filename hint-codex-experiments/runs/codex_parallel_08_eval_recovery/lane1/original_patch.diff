@@ -0,0 +1,89 @@
+"""Selection and validation of raw model input features."""
+
+import pandas as pd
+
+
+class FeatureSchemaError(ValueError):
+    """A feature configuration or inference dataset violates the schema."""
+
+
+def _names(value, option):
+    if isinstance(value, str):
+        value = [value]
+    if not isinstance(value, list) or any(
+        not isinstance(name, str) or not name.strip() for name in value
+    ):
+        raise FeatureSchemaError(f"features.{option} must be a column name or a list of non-empty column names")
+    if len(value) != len(set(value)):
+        raise FeatureSchemaError(f"features.{option} contains duplicate column names")
+    return value
+
+
+def _equal_columns(first, second):
+    equal = first.eq(second) | (first.isna() & second.isna())
+    return equal.fillna(False).all()
+
+
+def fit_feature_schema(dataset, targets, options):
+    if options is None:
+        options = {}
+    if not isinstance(options, dict):
+        raise FeatureSchemaError("dataset.features must be an object")
+    unknown_options = set(options) - {"include", "exclude", "drop_constant", "drop_duplicate"}
+    if unknown_options:
+        raise FeatureSchemaError(f"Unknown feature options: {sorted(unknown_options)}")
+    for option in ("drop_constant", "drop_duplicate"):
+        if option in options and not isinstance(options[option], bool):
+            raise FeatureSchemaError(f"features.{option} must be a boolean")
+    targets = targets or []
+    raw_features = [name for name in dataset.columns if name not in targets]
+    if not dataset.columns.is_unique:
+        raise FeatureSchemaError("Dataset contains duplicate column names")
+    include = _names(options["include"], "include") if "include" in options else raw_features
+    exclude = _names(options["exclude"], "exclude") if "exclude" in options else []
+    for option, names in (("include", include), ("exclude", exclude)):
+        target_names = [name for name in names if name in targets]
+        if target_names:
+            raise FeatureSchemaError(f"features.{option} contains target columns: {target_names}")
+        unknown = [name for name in names if name not in raw_features]
+        if unknown:
+            raise FeatureSchemaError(f"Unknown features in {option}: {unknown}")
+    selected = [name for name in include if name not in exclude]
+    dropped = {"excluded": [name for name in include if name in exclude], "constant": [], "duplicate": []}
+    aliases = {}
+    if options.get("drop_constant", False):
+        dropped["constant"] = [name for name in selected if dataset[name].nunique(dropna=False) <= 1]
+        selected = [name for name in selected if name not in dropped["constant"]]
+    if options.get("drop_duplicate", False):
+        canonical = []
+        for name in selected:
+            match = next((first for first in canonical if _equal_columns(dataset[first], dataset[name])), None)
+            if match is None:
+                canonical.append(name)
+            else:
+                dropped["duplicate"].append(name)
+                aliases.setdefault(match, []).append(name)
+        selected = canonical
+    if not selected:
+        raise FeatureSchemaError("Feature configuration removes every feature")
+    return {"input_features": selected, "dropped_features": dropped, "duplicate_feature_aliases": aliases}
+
+
+def apply_feature_schema(dataset, schema):
+    if not dataset.columns.is_unique:
+        raise FeatureSchemaError("Dataset contains duplicate column names")
+    selected = {}
+    missing = []
+    for canonical in schema["input_features"]:
+        sources = [name for name in [canonical] + schema["duplicate_feature_aliases"].get(canonical, []) if name in dataset.columns]
+        if not sources:
+            missing.append(canonical)
+            continue
+        first = dataset[sources[0]]
+        for name in sources[1:]:
+            if not _equal_columns(first, dataset[name]):
+                raise FeatureSchemaError(f"Conflicting duplicate feature columns: {sources[0]} and {name}")
+        selected[canonical] = first
+    if missing:
+        raise FeatureSchemaError(f"Missing required features: {missing}")
+    return pd.DataFrame(selected, index=dataset.index)
